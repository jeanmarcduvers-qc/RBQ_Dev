          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{6D5CED20-A115-4100-8DD3-26A9B22112C1}"
              SQLTask:SqlStatementSource="-- Effacer les tables temporaires du Registre Publique&#xA;-----------------------------------------------------------------&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_TEMP_ASCG' AND xtype='U')&#xA; drop table GI2_TEMP_ASCG&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_TEMP_LIC' AND xtype='U')&#xA; drop table GI2_TEMP_LIC&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_TEMP_ADR' AND xtype='U')&#xA; drop table GI2_TEMP_ADR&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_TEMP_ADR_HABIL' AND xtype='U')&#xA; drop table GI2_TEMP_ADR_HABIL&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_TEMP_ADR_INTRL' AND xtype='U')&#xA; drop table GI2_TEMP_ADR_INTRL&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_TEMP_INTRELO_LIC' AND xtype='U')&#xA; drop table GI2_TEMP_INTRELO_LIC&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_TEMP_LIEN_INTERLO_CMPUTILPROD' AND xtype='U')&#xA; drop table GI2_TEMP_LIEN_INTERLO_CMPUTILPROD" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\end Task\set PARAM_END"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Tâche d'exécution de requêtes SQL"
          DTS:DTSID="{1AF33105-F59E-45DB-9517-4B47EBE64F4E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="set PARAM_END"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; Microsoft SQL Server v9; © 2004 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{6D5CED20-A115-4100-8DD3-26A9B22112C1}"
              SQLTask:SqlStatementSource="-- Mettre à jour le flag d'activation de la tâche : END&#xA;-----------------------------------------------------------------&#xA;DECLARE @gi_d_datejour DATETIME&#xA;SET @gi_d_datejour = GETDATE()&#xA;&#xA;&#xA;-- Update de la date selon le format yyyy-MM-dd hh:mm&#xA;-----------------------------------------------------------------&#xA;UPDATE GI2_PARAMETRES&#xA;SET gi_v_parm = CAST(YEAR(@gi_d_datejour) as varchar(4)) + '-' + &#xA;&#x9;&#x9;&#x9;&#x9;RIGHT('00' + CAST(MONTH(@gi_d_datejour) as varchar(2)),2) + '-' + &#xA;&#x9;&#x9;&#x9;&#x9;RIGHT('00' + CAST(DAY(@gi_d_datejour) as varchar(2)),2) + ' ' + &#xA;&#x9;&#x9;&#x9;&#x9;CAST(CAST(@gi_d_datejour as time) as varchar(5))&#xA;WHERE gi_n_ident = 'PARAM1'&#xA;&#xA;-- Update le paramètre pour dire si le site est accessible&#xA;-----------------------------------------------------------------&#xA;UPDATE GI2_PARAMETRES&#xA;set gi_v_parm = '0'&#xA;where gi_n_ident = 'PARAM2'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
