                    <component
                      refId="Package\loading Data\Intervenant\load GI2_INTERVENANT\S_ORG_EXT"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                      description="Source OLE DB"
                      name="S_ORG_EXT"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select distinct
	T1.ROW_ID gi_n_iden_intrv,
	T1.X_NEQ gi_n_neq,
	T1.NAME gi_nm_intrv,
	CASE T1.OU_TYPE_CD
		when 'Personne physique' then
			CASE 
				T2.X_GI_C_QUES
				when 'P002' THEN
					CASE T7.X_GI_C_REPN
						WHEN 'oui' THEN
							CASE
								WHEN T1.X_PHONE_EXTENSION IS NOT NULL
									THEN T1.MAIN_PH_NUM + ' Ext.: ' + CONVERT(VARCHAR, T1.X_PHONE_EXTENSION)
								ELSE T1.MAIN_PH_NUM
							END
						ELSE
							NULL
					END
			else
				NULL
			END
		ELSE 
			CASE 
				WHEN T1.X_PHONE_EXTENSION IS NOT NULL
					THEN T1.MAIN_PH_NUM + ' Ext.: ' + CONVERT(VARCHAR, T1.X_PHONE_EXTENSION)
				ELSE T1.MAIN_PH_NUM
				END 
	END gi_n_telp,

	CASE T1.OU_TYPE_CD
		when 'Personne physique' then
			CASE 
				T3.X_GI_C_QUES
				when 'P003' THEN
					CASE T9.X_GI_C_REPN
						WHEN 'oui'
							then T1.MAIN_EMAIL_ADDR 
						else
							NULL
					END
				else
					NULL
			END 
		ELSE T1.MAIN_EMAIL_ADDR 
	END gi_a_cour,

	CASE T1.OU_TYPE_CD
		when 'Personne physique' then
			CASE 
				T2.X_GI_C_QUES
				when 'P002' THEN
					CASE T7.X_GI_C_REPN
						WHEN 'oui'
							then T1.MAIN_FAX_PH_NUM
						else
							NULL
					END
				ELSE
					NULL
			END 
		ELSE T1.MAIN_FAX_PH_NUM 
	END gi_n_telc,

	CASE T1.OU_TYPE_CD
		when 'Personne physique' then
			CASE 
				T2.X_GI_C_QUES
				when 'P002' THEN
					CASE T7.X_GI_C_REPN
						WHEN 'oui'
							then T1.X_CELLULAIRE 
						else
							NULL
					END
				ELSE
					NULL
			END 
		ELSE T1.X_CELLULAIRE 
	END gi_n_cell

FROM S_ORG_EXT T1
      INNER JOIN CX_QUESTION T2
            ON T2.ROW_ID = (SELECT S2.ROW_ID FROM CX_QUESTION S2 WHERE S2.X_GI_C_QUES = 'P002')
      INNER JOIN CX_QUESTION T3
            ON T3.ROW_ID = (SELECT S3.ROW_ID FROM CX_QUESTION S3 WHERE S3.X_GI_C_QUES = 'P003')
      INNER JOIN CX_PREFERENCE T4
            ON T4.PAR_ROW_ID_CXQUESTION = T2.ROW_ID AND T4.PAR_ROW_ID_SORG_EXT = T1.ROW_ID
      INNER JOIN CX_PREFERENCE T5
            ON T5.PAR_ROW_ID_CXQUESTION = T3.ROW_ID AND T5.PAR_ROW_ID_SORG_EXT = T1.ROW_ID
      INNER JOIN CX_CHOIX_REP T6
            ON T6.ROW_ID = T4.PAR_ROW_ID_CXCHOIX_REP
      INNER JOIN CX_REPONSE T7
            ON T7.ROW_ID = T6.PAR_ROW_ID_CXREPONSE
      INNER JOIN CX_CHOIX_REP T8
            ON T8.ROW_ID = T5.PAR_ROW_ID_CXCHOIX_REP
      INNER JOIN CX_REPONSE T9
            ON T9.ROW_ID = T8.PAR_ROW_ID_CXREPONSE
	  INNER JOIN S_DOC_AGREE T10
			on T10.TARGET_OU_ID = T1.ROW_ID
			and T10.STAT_CD IN ('Inoperante', 'Active')
	  INNER JOIN S_ORG_EXT_XM T11
			on T11.PAR_ROW_ID = T1.ROW_ID

where T1.NAME &lt;&gt; 'Site générique'
	and T1.ACCNT_FLG = 'Y'
	and T11.ATTRIB_50 in ('Entrepreneur','Constructeur-proprietaire')
	and T1.OU_NUM NOT IN (
'5580-9560',
'5580-9651',
'5580-9503',
'5580-9529',
'5580-9610',
'5580-9545',
'5580-9636',
'5674-9161',
'5581-6920',
'5674-9153',
'5662-8928',
'5581-9908',
'5704-6708',
'5582-2464',
'5712-6112',
'5841-8443')</property>
                        <property
                          dataType="System.String"
                          description="Variable contenant la commande SQL à exécuter."
                          name="SqlCommandVariable"></property>
                        <property
                          dataType="System.Int32"
