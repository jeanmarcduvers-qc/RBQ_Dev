                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select distinct
	a.DREX_ID gi_n_iden_licn,
	a.CONTACT_ID gi_n_iden_intrl,
	a.PROD_ID gi_n_iden_sous_catg
 from 
	dbo.GI2_TEMP_LIEN_INTERLO_CMPUTILPROD a
where 
	exists (select 1 from dbo.GI2_INTERLOCUTEUR_LICENCE b  
				where a.DREX_ID = b.gi_n_iden_licn
				and a.CONTACT_ID = b.gi_n_iden_intrl
	)
and 
	(
