                    <component
                      refId="Package\loading Data\Intervenant\GI2_RECLAM_CAUTION\Reclamations"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="Reclamations"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- Liste des demandes de réclamation

SELECT
	 GI_NS_RECL_CAUT				GI_NS_RECL_CAUT
	,MAX(GI_N_IDEN_INTRV)			GI_N_IDEN_INTRV			
	,MIN(GI_D_DEBT_PERD_RECL_CAUT)	GI_D_DEBT_PERD_RECL_CAUT
	,MIN(GI_D_FIN_PERD_RECL_CAUT)	GI_D_FIN_PERD_RECL_CAUT	
	,SUM(GI_N_RECL_RECU_CAUT)		GI_N_RECL_RECU_CAUT
	,SUM(GI_N_RECL_VERS_CAUT)		GI_N_RECL_VERS_CAUT						
	,MIN(GI_C_STAT_RECL_CAUT)		GI_C_STAT_RECL_CAUT
FROM (
	SELECT 
		 sr.ROW_ID					GI_NS_RECL_CAUT
		,sr.CST_OU_ID				GI_N_IDEN_INTRV
		,act.TODO_ACTL_START_DT		GI_D_DEBT_PERD_RECL_CAUT
		,act.TODO_DUE_DT			GI_D_FIN_PERD_RECL_CAUT
		,CASE 
			WHEN rec.X_GI_M_RECL &gt; 0 THEN 1
			ELSE 0
		 END						GI_N_RECL_RECU_CAUT
		,CASE 
			WHEN rec.X_GI_M_VERS_CAUT &gt; 0 THEN 1
			ELSE 0
		 END						GI_N_RECL_VERS_CAUT
		,CASE
			WHEN FIRST_VALUE(rec.X_GI_C_DECS_INDM) OVER(PARTITION BY sr.ROW_ID ORDER BY rec.X_GI_M_VERS_CAUT ASC) LIKE '%Entente%entrepreneur%' 
				THEN 'Terminé'
			WHEN GETDATE() &lt; act.TODO_DUE_DT 
				THEN 'En cours'
			ELSE 'Terminé'
		END							GI_C_STAT_RECL_CAUT

	FROM S_SRV_REQ sr
	INNER JOIN S_EVT_ACT act ON act.SRA_SR_ID = sr.ROW_ID
	LEFT OUTER JOIN CX_RECLAMANTS rec ON rec.PAR_ROW_ID_SSRV_REQ = sr.ROW_ID
	INNER JOIN CX_WFM_ACTIONCD acd ON acd.ROW_ID = act.X_ACTION_CD_ID
	INNER JOIN S_DOC_AGREE lic ON lic.TARGET_OU_ID = sr.CST_OU_ID
	INNER JOIN CX_WFM_RESULTCD rc ON rc.ROW_ID = act.X_RESULT_CD_ID
	--INNER JOIN S_ENTLMNT ent ON ent.PAR_AGREE_ID = lic.ROW_ID

	WHERE 
		sr.SR_AREA = '75' -- Demande d'indemnité (type 75)
		AND act.TODO_ACTL_START_DT &gt;= DATEADD(yyyy, -5, GETDATE()) 
		AND lic.STAT_CD IN ('Inoperante', 'Active')
		AND acd.UNIQUE_CODE = 'Fin delai recl -01' 
		AND act.X_RESULT_CD_ID IS NOT NULL 
		AND (rec.X_GI_C_DECS_INDM LIKE '%Acceptée%' 
			 OR rec.X_GI_C_DECS_INDM LIKE '%En%cours%'
			 OR rec.X_GI_C_DECS_INDM LIKE '%Entente%entrepreneur%'
			 OR (GETDATE() &lt; act.TODO_DUE_DT AND rec.X_GI_C_DECS_INDM IS NULL)
		) -- Réclamations acceptées/partiellement/En cours)

) SUB1
GROUP BY GI_NS_RECL_CAUT -- Regroupement par demande 75</property>
                        <property
