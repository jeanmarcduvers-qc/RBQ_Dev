                      name="S_ADDR_PER"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select
	ROW_ID gi_n_iden_adrs,
	ADDR_LINE_2 gi_a_ligne1,
	ADDR_LINE_4 gi_a_ligne2,
	ADDR_LINE_5 gi_a_ligne3,
	ZIPCODE gi_a_code_post,
	LONGITUDE gi_v_long,
	LATITUDE gi_v_latt,

case when X_CODE_REGION_ADM IS NULL then 
		CASE adr.STATE
			WHEN 'AB' THEN '27'
			WHEN 'BC' THEN '28'
			WHEN 'MB' THEN '25'
			WHEN 'NB' THEN '23'
			WHEN 'NF' THEN '20'
			WHEN 'NS' THEN '21'
			WHEN 'NT' THEN '29'
			WHEN 'NU' THEN '34'
			WHEN 'ON' THEN '24'
			WHEN 'PE' THEN '22'
			WHEN 'SK' THEN '26'
			WHEN 'YK' THEN '30'
			ELSE 
				CASE WHEN adr.X_GI_C_NIVE_CONF = 'HC' THEN '31'
					ELSE NULL
				END
		END
else
	case X_CODE_REGION_ADM
		when '1' then '01'
		when '2' then '02'
		when '3' then '03'
		when '4' then '04'
		when '5' then '05'
		when '6' then '06'
		when '7' then '07'
		when '8' then '08'
		when '9' then '09'
		else X_CODE_REGION_ADM
	end
end gi_c_regn
	
	
from S_ADDR_PER adr
where END_DT is null
and ROW_ID in (
				select distinct ADDR_PER_ID from S_CON_ADDR s4

				inner join S_ORG_EXT s1
				on s4.ACCNT_ID = s1.ROW_ID

				inner join S_ORG_EXT_XM s2
					on s2.PAR_ROW_ID = s1.ROW_ID
				inner join S_DOC_AGREE s3
					on s3.TARGET_OU_ID = s1.ROW_ID
					and s3.STAT_CD IN ('Inoperante', 'Active')
				where s1.NAME &lt;&gt; 'Site générique'
					and s1.ACCNT_FLG = 'Y'
					and s2.ATTRIB_50 in ('Entrepreneur','Constructeur-proprietaire')
--AND s4.ACCNT_ID NOT IN ( '1-11052M','1-1AF-101985','1-1AF-103101','1-1AF-92045')
				)</property>
