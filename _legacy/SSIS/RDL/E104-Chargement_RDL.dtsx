                              codePage="1252"
                              dataType="str"
                              errorOrTruncationOperation="Conversion"
                              errorRowDisposition="FailComponent"
                              externalMetadataColumnId="Package\loading Data\Interlocuteur\load GI2_INTERLOCUTEUR_LIC\TEMP_TABLE.Outputs[Sortie de source OLE DB].ExternalColumns[gi_n_iden_licn]"
