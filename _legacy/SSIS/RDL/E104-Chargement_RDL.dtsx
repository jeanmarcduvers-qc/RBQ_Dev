                        <component
                          refId="Package\loading Data\Intervenant\LICENCE_INTERVENANT\load GI2_LICENCE_INTERVENANT\GI2_TEMP_LIC"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                          description="Source OLE DB"
                          name="GI2_TEMP_LIC"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="Commande SQL à exécuter."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- Chargement de LICENCE/INTERVENANT
-----------------------------------------------------------------
select distinct 
	sdoc.ROW_ID,
	sdoc.TARGET_OU_ID,
	sdoc.AGREE_NUM AGREE_NUM,
	sdoc.APPR_DT,
	sdoc.DUE_DT,
	sdoc.AGREE_CD,
	
	CASE 
		WHEN sdoc.DATE_DEBUT_CAUTION &lt;= GETDATE() AND (sdoc.DATE_ANNULATION_CAUTION IS NULL OR sdoc.DATE_ANNULATION_CAUTION &gt;= GETDATE()) THEN
			sdoc.MONTANT
		ELSE
			NULL
	END MONTANT,
	
	CASE 
		WHEN sdoc.DATE_DEBUT_CAUTION &lt;= GETDATE() AND (sdoc.DATE_ANNULATION_CAUTION IS NULL OR sdoc.DATE_ANNULATION_CAUTION &gt;= GETDATE()) THEN
			CASE 
				WHEN sdoc.MODE LIKE '%Collective%' AND (sdoc.ASSOCIATION IS NOT NULL) THEN
					sdoc.ASSOCIATION
				WHEN sdoc.MODE LIKE '%Cheque%vise%' OR sdoc.MODE LIKE '%Lettre%credit%' OR sdoc.MODE LIKE '%Traite%' THEN
					'Caution personnelle du détenteur de licence'
				ELSE
					sdoc.CAUTIONNEUR
			END
		ELSE
			NULL
	END CAUTIONNEUR,

	CASE 
		WHEN exists
			(
				select 1 from
					GI2_TEMP_ASCG w
				where w.ROW_ID = sdoc.ROW_ID
				and w.MODEL_CD = 'Administration'
			)
			THEN '1'
		ELSE
			'0'
	end gi_i_qual_admi,

	CASE 
		WHEN exists
			
			(
				select 1 from
					GI2_TEMP_ASCG x
	
				where x.ROW_ID = sdoc.ROW_ID
				and x.MODEL_CD = 'Sécurité'
			)
			THEN '1'
		ELSE
			'0'
	end gi_i_qual_secr,

	CASE 
		WHEN exists
			(
				select 1 from
					GI2_TEMP_ASCG y
				where y.ROW_ID = sdoc.ROW_ID 
				and y.MODEL_CD = 'Construction'
			)
			THEN '1'
		ELSE
			'0'
	end gi_i_qual_cons,
	CASE 
		WHEN exists
			(
				select 1 from
					GI2_TEMP_ASCG z
				where z.ROW_ID = sdoc.ROW_ID
				and z.MODEL_CD = 'Gestion'
			)
			THEN '1'
		ELSE
			'0'
	end gi_i_qual_gest,
	TXT_RESTRICT gi_v_txt_restrict,
	TXT_1 gi_v_texte1,
	TXT_2 gi_v_texte2,
	TXT_3 gi_v_texte3,
	SDREX_ID gi_n_iden_sdrex,
	X_RESTRICTION GI_DE_REST,
	X_GI_D_FIN_REST_SUIV GI_D_FIN_REST,
	GI_C_STAT_LICN GI_C_STAT_LICN

FROM GI2_TEMP_LIC sdoc
WHERE sdoc.TARGET_OU_ID IN (SELECT gi_n_iden_intrv FROM GI2_INTERVENANT)</property>
                            <property
