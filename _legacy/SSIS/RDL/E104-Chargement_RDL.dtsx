                      refId="Package\loading Data\Inspecteurs batiments habitation\Inspecteurs\Certificats"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="Certificats"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
	 p.ROW_ID									AS GI_NS_CERT_IBH
	,p.X_GI_NO_CERT_IBH							AS GI_NO_CERT_IBH
	,c1.LAST_NAME								AS GI_NM_IBH
	,c1.FST_NAME								AS GI_PR_IBH
	,CASE
		WHEN EXISTS (SELECT ROW_ID FROM S_CON_ADDR WHERE CONTACT_ID = c1.ROW_ID AND ADDR_TYPE_CD = 'Professionnelle' AND (END_DT IS NULL OR END_DT &gt; GETDATE())) THEN
			(SELECT ADDR_PER_ID FROM S_CON_ADDR WHERE CONTACT_ID = c1.ROW_ID AND ADDR_TYPE_CD = 'Professionnelle' AND (END_DT IS NULL OR END_DT &gt; GETDATE()))
		WHEN EXISTS (SELECT ROW_ID FROM S_CON_ADDR WHERE CONTACT_ID = c1.ROW_ID AND ADDR_TYPE_CD = 'Principale' AND (END_DT IS NULL OR END_DT &gt; GETDATE())) THEN
			(SELECT ADDR_PER_ID FROM S_CON_ADDR WHERE CONTACT_ID = c1.ROW_ID AND ADDR_TYPE_CD = 'Principale' AND (END_DT IS NULL OR END_DT &gt; GETDATE()))
		ELSE
			c1.PR_PER_ADDR_ID
	 END										AS GI_N_IDEN_ADRS
	,vp.X_GI_C_CATG_CERT_IBH					AS GI_DE_CATG_CERT_IBH
	,p.X_GI_C_STAT_CERT_IBH						AS GI_DE_STAT_CERT_IBH
	,vp.X_GI_C_RAIS_FIN_VERS_CIBH				AS GI_DE_RAIS_FIN_CERT_IBH
	,p.X_GI_D_DELV_INIT_PERM					AS GI_DT_DELV_CERT_IBH
	,DATEADD(day, 1, vp.X_GI_D_FIN_VALD_PERM)	AS GI_DT_RENV_CERT_IBH -- Telle que calculée dans GIC
	,vp.X_GI_D_FIN_VALD_PERM					AS GI_DT_FIN_CERT_IBH
	,c1.HOME_PH_NUM								AS GI_NO_TELP_IBH

FROM CX_PERMIS_RBQ p
INNER JOIN CX_VERS_PERM vp 
	ON p.PAR_ROW_ID_CXVER_PERM = vp.ROW_ID
INNER JOIN S_CONTACT c1
	ON p.PAR_ROW_ID_SCONTACT = c1.ROW_ID
INNER JOIN S_CONTACT_XM c2 
	ON c1.ROW_ID = c2.PAR_ROW_ID

WHERE 
	p.X_GI_C_TYPE_PERM = 'IBH'
	AND c2.ATTRIB_34 = '49'  -- No type 'Inspecteur bâtiment habitation'
	AND p.X_GI_C_STAT_CERT_IBH IN ('Actif', 'Inoperant', 'Suspendu')
	AND (vp.X_GI_D_FIN_VERS_PERM IS NULL OR vp.X_GI_D_FIN_VERS_PERM &gt;= DATEADD(year, -5, GETDATE()))</property>
