                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select distinct b.* from 
			GI2_TEMP_ADR_HABIL a
		inner join GI2_TEMP_ADR b
			on  a.ADR_ID = b.gi_n_iden_adrs
		where not exists
