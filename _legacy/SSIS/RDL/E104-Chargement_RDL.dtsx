                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select distinct a.ROW_ID, a.PROD_ID, a.CATEGORY_CD
from GI2_TEMP_ASCG a
where exists
	(
	select 1 from GI2_INTERVENANT b 
		inner join dbo.GI2_LICENCE_INTERVENANT c
			on b.gi_n_iden_intrv = c.gi_n_iden_intrv
		where b.gi_n_iden_intrv = a.TARGET_OU_ID
	)
and 
	MODEL_CD = 'Construction'</property>
