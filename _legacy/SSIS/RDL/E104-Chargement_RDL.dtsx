                      name="TEMP_TABLE"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select distinct b.gi_n_iden_licn, a.REL_PARTY_ID gi_n_iden_intrl, STAT_REMP gi_i_stat_remp,
	CASE 
		WHEN exists
			(
				select 1 from
					GI2_TEMP_LIEN_INTERLO_CMPUTILPROD w
				where w.DREX_ID = b.gi_n_iden_licn
				and w.CONTACT_ID = c.gi_n_iden_intrl
				and w.MODEL_CD = 'Administration'
			)
			THEN '1'
		ELSE
			'0'
	end gi_i_qual_admi,
	CASE 
		WHEN exists
			(
				select 1 from
					GI2_TEMP_LIEN_INTERLO_CMPUTILPROD w
				where w.DREX_ID = b.gi_n_iden_licn
				and w.CONTACT_ID = c.gi_n_iden_intrl
				and w.MODEL_CD = 'Securite'
			)
			THEN '1'
		ELSE
			'0'
	end gi_i_qual_secr,
	CASE 
		WHEN exists
			(
				select 1 from
					GI2_TEMP_LIEN_INTERLO_CMPUTILPROD w
				where w.DREX_ID = b.gi_n_iden_licn
				and w.CONTACT_ID = c.gi_n_iden_intrl
				and w.MODEL_CD = 'Construction'
			)
			THEN '1'
		ELSE
			'0'
	end gi_i_qual_cons,
	CASE 
		WHEN exists
			(
				select 1 from
					GI2_TEMP_LIEN_INTERLO_CMPUTILPROD w
				where w.DREX_ID = b.gi_n_iden_licn
				and w.CONTACT_ID = c.gi_n_iden_intrl
				and w.MODEL_CD = 'Gestion'
			)
			THEN '1'
		ELSE
			'0'
	end gi_i_qual_gest

from GI2_TEMP_INTRELO_LIC a
INNER JOIN 
	GI2_LICENCE_INTERVENANT b
		on
		a.PARTY_ID = b.gi_n_iden_intrv
INNER JOIN 
	GI2_INTERLOCUTEUR c
		on
		c.gi_n_iden_intrl = a.REL_PARTY_ID
INNER JOIN 
	GI2_TEMP_LIEN_INTERLO_CMPUTILPROD w
		on w.DREX_ID = b.gi_n_iden_licn
		and w.CONTACT_ID = c.gi_n_iden_intrl</property>
