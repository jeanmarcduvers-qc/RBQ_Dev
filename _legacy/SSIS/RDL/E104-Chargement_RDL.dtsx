                              description="Commande SQL à exécuter."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select distinct a.ROW_ID ADR_ID, c.HABIL_ACCORD_ID, s.CONTACT_ID, g.ROW_ID
	from CX_COMPET_UTIL c
		inner join S_PROD_CON s
			on c.COMPET_ID = s.ROW_ID
		inner join S_CONTACT sc
			on s.CONTACT_ID = sc.ROW_ID
		left outer join S_ADDR_PER a
			on sc.PR_PER_ADDR_ID = a.ROW_ID
		left outer join S_PARTY_REL e
			on e.REL_PARTY_ID = sc.ROW_ID
		left outer join S_ORG_EXT f
			on f.ROW_ID = e.PARTY_ID
		left outer join S_DOC_AGREE g
			on g.TARGET_OU_ID = f.ROW_ID
		where c.X_RESULTAT = '03'
		and g.STAT_CD IN ('Inoperante', 'Active')
		and e.REL_TYPE_CD in ('Repondant entrepreneur','Repondant COP')</property>
