                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select 
	S1.ROW_ID CONTACT_ID,
	S2.ROW_ID COMP_ID,
	S3.ROW_ID PROD_ID,
	S4.ROW_ID COMP_UTL_ID,
	S5.ROW_ID HABIL_ID,
	S6.ROW_ID SUIDREX_ID,
	S7.ROW_ID DREX_ID,
	CASE S3.PART_NUM
		WHEN  '1.4S' THEN NULL
		WHEN  '1.4G' THEN NULL
		WHEN  '1.5G' THEN NULL
		WHEN  '1.5S' THEN NULL
		WHEN  '1.6G' THEN NULL
		WHEN  '1.6S' THEN NULL
		WHEN  '1.7G' THEN NULL
		WHEN  '1.7S' THEN NULL
		ELSE
			S3.MODEL_CD
	END AS MODEL_CD,
	S3.PART_NUM

 from S_CONTACT S1
	inner join S_PROD_CON S2
		ON S2.CONTACT_ID = S1.ROW_ID
	inner join S_PROD_INT S3
		ON S3.ROW_ID = S2.PROD_ID
	INNER JOIN CX_COMPET_UTIL S4
		ON S4.COMPET_ID = S2.ROW_ID
		AND S4.X_RESULTAT = '03'
	INNER JOIN S_ENTLMNT_ITEM S5
		ON S4.HABIL_ACCORD_ID = S5.ROW_ID
	INNER JOIN S_ENTLMNT S6
		ON S6.ROW_ID = S5.DOC_AGREE_ID
	INNER JOIN S_DOC_AGREE S7
		ON S6.PAR_AGREE_ID =  S7.ROW_ID AND S7.X_PR_ENTLMNT_ID = S6.ROW_ID
where 
	S7. STAT_CD IN ('Inoperante', 'Active')</property>
                            <property
                              dataType="System.String"
                              description="Variable contenant la commande SQL à exécuter."
                              name="SqlCommandVariable"></property>
