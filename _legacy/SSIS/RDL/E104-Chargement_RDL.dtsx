                        <component
                          refId="Package\loading Data\Intervenant\LICENCE_INTERVENANT\load TEMP_ASCG &amp; TEMP_LIC\TEMP2"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                          description="Source OLE DB"
                          name="TEMP2"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="Commande SQL à exécuter."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- GI2_TEMP_LIC --
SELECT DISTINCT 
	sdoc.ROW_ID ROW_ID,
	sdoc.TARGET_OU_ID TARGET_OU_ID,
	sdoc.X_AGREE_NUM_RBQ AGREE_NUM,
	sdoc.APPR_DT,
	CASE sdoc.STAT_CD WHEN 'Active' THEN 
		sdoc.DUE_DT
	ELSE
		s2.EFF_END_DT
	END DUE_DT,
	S6.DESC_TEXT AS X_ASSOCIATION,
	--ctn.[X_GI_NM_ASSC_CAUT_LICN] AS X_ASSOCIATION,
	S5.DESC_TEXT AS X_CAUTIONNEUR,
	--ctn.[X_GI_NM_EMMT_CAUT_LICN] AS X_CAUTIONNEUR,
	ctn.X_GI_C_MODE_CAUT_LICN X_MODE,
	--sdoc.X_MODE,
	ctn.X_GI_MN_TOTL_CAUT_LICN X_MONTANT,
	--sdoc.X_MONTANT,
	ctn.X_GI_D_DEBT_CAUT_LICN X_CAUTION_DT,
	--sdoc.X_CAUTION_DT,
	ctn.X_GI_D_FIN_CAUT_LICN X_DATE_ANNULATION_CAUTION,
	--sdoc.X_DATE_ANNULATION_CAUTION,

	CASE sdoc.AGREE_CD
		WHEN 'Entrepreneur'
			THEN 'E'
		ELSE
			'C'
	END AGREE_CD,

	s2.X_TXT_1 TXT_1,
	s2.X_TXT_2 TXT_2,
	s2.X_TXT_3 TXT_3,
	s2.ROW_ID SDREX_ID,
	s2.X_RESTRICTION,
	s2.X_TXT_RESTRICT TXT_RESTRICT,
	s2.X_GI_D_FIN_REST_SUIV,
	CASE sdoc.STAT_CD
		WHEN 'Inoperante'
			THEN 'Non valide'
		ELSE
			CASE 
				WHEN (s2.X_RESTRICTION IS NOT NULL)
					THEN 'Valide avec restriction'
				ELSE
					CASE sdoc.STAT_CD
						WHEN 'Active'
							THEN 'Valide'
						ELSE
							NULL
					END
			END
	END STATUT

FROM S_DOC_AGREE sdoc
INNER JOIN 
	S_ENTLMNT s2 ON sdoc.X_PR_ENTLMNT_ID = s2.ROW_ID AND s2.X_STATUS NOT IN ('En traitement') AND s2.EFF_START_DT IS NOT NULL
INNER JOIN 
	S_ENTLMNT_ITEM s3 ON s3.DOC_AGREE_ID = s2.ROW_ID
INNER JOIN 
	S_PROD_INT s4 ON s4.ROW_ID = s3.PROD_INT_ID
LEFT OUTER JOIN
	CX_CAUTION_LICN ctn ON sdoc.PR_CAUTION_ID = ctn.ROW_ID

-- permet de choisir les licences associés aux intervenants 
-- qui sont chargés dans GI2_INTERVENANT.
--LEFT OUTER JOIN 	S_LST_OF_VAL S5 ON S5.NAME = sdoc.X_CAUTIONNEUR AND S5.TYPE = 'RBQ_CAUTION'
--LEFT OUTER JOIN 	S_LST_OF_VAL S6 ON S6.NAME = sdoc.X_ASSOCIATION AND S6.TYPE = 'RBQ_ASSOC'
LEFT OUTER JOIN 	S_LST_OF_VAL S6 ON S6.NAME = ctn.[X_GI_NM_ASSC_CAUT_LICN] AND S6.TYPE = 'RBQ_ASSOC'
LEFT OUTER JOIN 	S_LST_OF_VAL S5 ON S5.NAME = ctn.[X_GI_NM_EMMT_CAUT_LICN] AND S5.TYPE = 'RBQ_CAUTION'

		
WHERE
	sdoc.STAT_CD IN ('Inoperante', 'Active')
	AND (s2.EFF_END_DT IS NULL OR s2.EFF_END_DT &gt;= DATEADD(yyyy, -5, GETDATE())) 
	AND EXISTS 
	(
	select 1 from 	
		(
			select distinct
				s1.ROW_ID
			from S_ORG_EXT s1
			inner join S_ORG_EXT_XM s2
				on s2.PAR_ROW_ID = s1.ROW_ID
			where s1.NAME &lt;&gt; 'Site générique'
				and s1.ACCNT_FLG = 'Y'
				and s2.ATTRIB_50 in ('Entrepreneur','Constructeur-proprietaire')	
			--	and s2.ATTRIB_12 &gt; getdate()
		) a 
	where a.ROW_ID = sdoc.TARGET_OU_ID
	)</property>
