              SQLTask:SqlStatementSource="-- Effacer les tables du Registre Publique&#xA;-----------------------------------------------------------------&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_CERT_BATM_HABT' AND xtype='U')&#xA; delete GI2_CERT_BATM_HABT&#xA;go&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_RECLAM_CAUTION' AND xtype='U')&#xA; delete GI2_RECLAM_CAUTION&#xA;go&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_LIEUX_TRAVAUX' AND xtype='U')&#xA; delete GI2_LIEUX_TRAVAUX&#xA;go&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_SOUS_CATG_LICENCE_INTRV' AND xtype='U')&#xA;  delete GI2_SOUS_CATG_LICENCE_INTRV&#xA;go&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_SOUS_CATG_INTRL_LICENCE' AND xtype='U')&#xA;  delete GI2_SOUS_CATG_INTRL_LICENCE&#xA;go&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_SOUS_CATG' AND xtype='U')&#xA;  delete GI2_SOUS_CATG&#xA;go&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_INTERLOCUTEUR_LICENCE' AND xtype='U')&#xA;  delete GI2_INTERLOCUTEUR_LICENCE&#xA;go&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_LICENCE_INTERVENANT' AND xtype='U')&#xA;  delete GI2_LICENCE_INTERVENANT&#xA;go&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_AUTRE_NOM' AND xtype='U')&#xA;  delete GI2_AUTRE_NOM&#xA;go&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_INTERLOCUTEUR' AND xtype='U')&#xA;  delete GI2_INTERLOCUTEUR&#xA;go&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_ADRESSE_INTERVENANT' AND xtype='U')&#xA;  delete GI2_ADRESSE_INTERVENANT&#xA;go&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_ADRESSE' AND xtype='U')&#xA;  delete GI2_ADRESSE&#xA;go&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_INTERVENANT' AND xtype='U')&#xA;  delete GI2_INTERVENANT&#xA;go&#xA;IF EXISTS(SELECT name FROM sysobjects WHERE name = N'GI2_REGIONS_ADMINISTRATIVES' AND xtype='U')&#xA;  delete GI2_R