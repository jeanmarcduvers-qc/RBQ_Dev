                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">------------------------------------------------------
-- Selection de tous les licences ayant des compétences utilisées
-- par un interlocuteur.
-- Modification: 
--      Date: 2026-04-25 
--      Auteur: Chouaebou Mafera
--      Objet: afficher le courriel, telephone, cellulaire ou fax avec ou sans consentement
-----------------------------------------------------------------------------------------------
SELECT DISTINCT
    s2.X_OU_NUM_RBQ NO_INTERV,
    s2.X_NEQ NEQ,
    STAT_JUR.[VAL] STAT_JUR,
    s2.NAME NOM,
    s6.X_AUTRE_NOM ATR_NOM,
    s4.ADDR_LINE_2 ADR_LIGNE1,
    s4.ADDR_LINE_4 ADR_LIGNE2,
    s4.ADDR_LINE_5 ADR_LIGNE3,
    s4.ADDR_NUM NO_CIVIQ,
    s4.X_ARTERE TYP_ARTR,
    s4.ADDR RUE,
    s4.ADDR_LINE_3 APT,
    s4.ZIPCODE COD_POST,
    s4.STATE PROV,
    s4.X_CODE_MUNICIPALITE CPMUNIC,
    s4.CITY MUNIC,
    s4.X_CODE_REGION_ADM COD_REG_ADM,
    REG_ADM.DESC_TEXT X_REGION_ADMIN,
    s4.X_CODE_MRC COD_MRC,
    MRC.DESC_TEXT MRC,
    CASE OU_TYPE_CD
        WHEN 'Personne physique' THEN 
            CASE X_CONSENTEMENT_TEL_FLG
                WHEN 'Y' THEN s2.MAIN_PH_NUM
                ELSE s2.MAIN_PH_NUM /*retourner le numéro telephone sans consentement. Sinon NULL (état initial avant modification)*/
            END
        ELSE s2.MAIN_PH_NUM
    END NO_TEL,
    CASE OU_TYPE_CD
        WHEN 'Personne physique' THEN s2.MAIN_FAX_PH_NUM /*retourner le numéro de fax sans consentement. Sinon NULL (état initial avant modification)*/
        ELSE s2.MAIN_FAX_PH_NUM
    END NO_FAX,
    CASE OU_TYPE_CD
        WHEN 'Personne physique' THEN 
            CASE X_CONSENTEMENT_COURRIEL_FLG
                WHEN 'Y' THEN s2.MAIN_EMAIL_ADDR
                ELSE s2.MAIN_EMAIL_ADDR /*retourner le courriel sans consentement. Sinon NULL (état initial avant modification)*/
            END
        ELSE s2.MAIN_EMAIL_ADDR
    END COURRIEL,
    CASE s5.ATTRIB_50
        WHEN 'Entrepreneur' THEN 'E'
        WHEN 'Constructeur-proprietaire' THEN 'CP'
        ELSE NULL
    END TYPE_INTRVT,
    s1.X_AGREE_NUM_RBQ NO_LIC,
    CASE s1.X_CATEGORIE
        WHEN 'Generale et specialisee' THEN 'GS'
        WHEN 'Specialisee' THEN 'S'
        WHEN 'Generale' THEN 'G'
        ELSE NULL
    END CATG_LIC,
    CASE 
        WHEN s7.EFF_START_DT IS NOT NULL THEN s7.ENTLMNT_NUM
        ELSE NULL
    END ENTLMNT_NUM,
    s7.EFF_START_DT DT_ENTREE_VIG,
    s1.DUE_DT DT_FIN_ANN,
    s7.EFF_END_DT DT_FIN_LIC,
    s7.X_RESTRICTION,
    NULL CATG,
    0 NB_CATG,
    s12.PERSON_UID NO_INTRL,
    s12.LAST_NAME INOM,
    s12.FST_NAME IPRENOM,
    s12.BIRTH_DT DT_NAISSANCE,
    s14.ADDR_LINE_2 IADR_LIGNE1,
    s14.ADDR_LINE_4 IADR_LIGNE2,
    s14.ADDR_LINE_5 IADR_LIGNE3,
    s14.ADDR_NUM INO_CIVIQ,
    s14.X_ARTERE ITYP_ARTR,
    s14.ADDR IRUE,
    s14.ADDR_LINE_3 IAPT,
    s14.ZIPCODE ICOD_POST,
    s14.STATE IPROV,
    s14.X_CODE_MUNICIPALITE ICPMUNIC,
    s14.CITY IMUNIC,
    s14.X_CODE_REGION_ADM ICOD_REG_ADM,
    REG_ADM2.DESC_TEXT I_REGADMIN,
    s14.X_CODE_MRC ICOD_MRC,
    MRC2.DESC_TEXT IMRC,
    0 NB_SC_INTRL,
    'N' a,
    'N' s,
    'N' c,
    'N' g,
    '' LIST_CATG_INTRL,
    s2.ROW_ID id_intrvn,
    s1.ROW_ID id_drex,
    s12.ROW_ID id_intrl,
    s7.ROW_ID id_sdrex,
    CASE OU_TYPE_CD
        WHEN 'Personne physique' THEN 
            CASE X_CONSENTEMENT_TEL_FLG
                WHEN 'Y' THEN s2.X_CELLULAIRE
                ELSE s2.X_CELLULAIRE /*retourner le numéro cellulaire sans consentement. Sinon NULL (état initial avant modification)*/
            END
        ELSE s2.X_CELLULAIRE
    END cellullaire,
    s1.APPR_DT date_emis     
FROM    
    --DROITS EXERCICES
    S_DOC_AGREE AS s1

    --INTERVENANTS
    INNER JOIN S_ORG_EXT AS s2 
        ON s2.ROW_ID = s1.TARGET_OU_ID
        AND ACCNT_FLG = 'Y'

    --DOMAINES
    LEFT OUTER JOIN S_ORG_EXT_XM AS s5 
        ON s5.PAR_ROW_ID = s2.ROW_ID
        AND s5.TYPE = 'Type_Intervenant'

    --LIEN INTERVENANT-ADRESSES
    LEFT OUTER JOIN S_CON_ADDR AS s3 
        ON s3.ACCNT_ID = s2.ROW_ID
        AND s3.ADDR_TYPE_CD = 'Principale'
        AND ((GETDATE() &gt; s3.[START_DT]
              AND GETDATE() &lt; s3.[END_DT])
            OR (GETDATE() &gt; s3.[START_DT]
                AND s3.[END_DT] IS NULL))

    --ADRESSES INTERVENANTS
    LEFT OUTER JOIN S_ADDR_PER AS s4 
        ON s4.ROW_ID = s3.ADDR_PER_ID

    --AUTRES NOMS
    LEFT OUTER JOIN S_ORG_SYN AS s6 --	on s6.OU_ID = s2.ROW_ID
        ON s2.PR_SYN_ID = s6.ROW_ID
            AND X_TYPE_NOM = 'Raison sociale'
            AND X_DATE_FIN IS NULL

    --SUIVI DROIT EXERCICE
    INNER JOIN S_ENTLMNT AS s7 
        ON s7.PAR_AGREE_ID = s1.ROW_ID
        AND X_STATUS = 'Actif'

    --HABILITATION_ACCORDÉS
    INNER JOIN S_ENTLMNT_ITEM AS s8 
        ON s8.DOC_AGREE_ID = s7.ROW_ID
        AND X_STATUS_CD IN ('Active', 'Partielle')

    --COMPETENCE UTILISE
    INNER JOIN CX_COMPET_UTIL AS s10 
        ON s8.ROW_ID = s10.HABIL_ACCORD_ID
        AND X_RESULTAT = '03'

    --COMPETENCE 
    INNER JOIN S_PROD_CON AS s11 
        ON s11.ROW_ID = s10.COMPET_ID

    --SOUS_CATG, PRODUITS
    INNER JOIN S_PROD_INT AS s9 
        ON s9.ROW_ID = s11.PROD_ID

    --INTERLOCUTEUR
    INNER JOIN S_CONTACT s12 
        ON s12.ROW_ID = s11.CONTACT_ID

    --LIEN_INTERLOCUTEUR
    LEFT OUTER JOIN S_CON_ADDR AS s13 
        ON s12.ROW_ID = s13.CONTACT_ID
        AND s13.ADDR_TYPE_CD = 'Principale'
        AND ((GETDATE() &gt; s13.[START_DT]
              AND GETDATE() &lt; s13.[END_DT])
             OR (GETDATE() &gt; s13.[START_DT]
                 AND s13.[END_DT] IS NULL))

    --ADRESSES INTERVENANTS
    LEFT OUTER JOIN S_ADDR_PER AS s14 
        ON s14.ROW_ID = s13.ADDR_PER_ID
	
    --LOV STAT JURIDIQUE
    LEFT OUTER JOIN [S_LST_OF_VAL] AS STAT_JUR 
        ON STAT_JUR.[LANG_ID] = 'FRA'
        AND STAT_JUR.[TYPE] = 'ACCOUNT_TYPE'
        AND STAT_JUR.[NAME] = s2.OU_TYPE_CD
                                                   
    --LOV Région administrative
    LEFT JOIN S_LST_OF_VAL AS REG_ADM 
        ON REG_ADM.[LANG_ID] = 'FRA'
        AND REG_ADM.[TYPE] = 'RBQ_REGION_ADMIN'
        AND REG_ADM.[NAME] = s4.X_CODE_REGION_ADM

    LEFT JOIN S_LST_OF_VAL AS REG_ADM2 
        ON REG_ADM2.[LANG_ID] = 'FRA'
        AND REG_ADM2.[TYPE] = 'RBQ_REGION_ADMIN'
        AND REG_ADM2.[NAME] = s14.X_CODE_REGION_ADM
                                          
    --LOV MRC
    LEFT JOIN S_LST_OF_VAL AS MRC 
        ON MRC.[LANG_ID] = 'FRA'
        AND MRC.[TYPE] = 'RBQ_MRC'
        AND MRC.[NAME] = s4.X_CODE_MRC

    LEFT JOIN S_LST_OF_VAL AS MRC2 
        ON MRC2.[LANG_ID] = 'FRA'
        AND MRC2.[TYPE] = 'RBQ_MRC'
        AND MRC2.[NAME] = s14.X_CODE_MRC
                                      
    WHERE   
        STAT_CD = 'Active'
        AND s5.ATTRIB_50 = s1.AGREE_CD</property>
