                  <properties>
                    <property
                      dataType="System.String"
                      description="Spécifie l'instruction SQL qui génère la table de correspondance."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select * from [dbo].[GI2_ENT_REP]</property>
                    <property
                      dataType="System.String"
                      description="Spécifie une instruction SQL qui utilise des paramètres pour générer la table de correspondance."
                      expressionType="Notify"
                      name="SqlCommandParam"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select * from
	(select * from [dbo].[GI2_ENT_REP]) as refTable
where substring([refTable].[NO_INTERVN],1,4) + substring([refTable].[NO_INTERVN],6,4) = ?</property>
                    <property
                      dataType="System.Int32"
                      description="Spécifie le type de cache de la table de correspondance."
                      name="CacheType"
                      typeConverter="CacheType">0</property>
