      DTS:DTSID="{1F5799E5-84EF-4DE1-8137-E09B5934BC2F}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="ENTREPRISE_REPONDANS REG_CD">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\ENTREPRISE_REPONDANS REG_CD\Ajout Fonction"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Tâche d'exécution de requêtes SQL"
          DTS:DTSID="{CF37AD58-FC29-4521-B51C-342065AB940C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Ajout Fonction"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; Microsoft SQL Server v9; © 2004 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{732520B4-637C-4975-BC17-1FF4E2C9BBFE}"
              SQLTask:SqlStatementSource="-- Curseur permettant de mettre à jour la liste des fonctions.&#xA;--------------------------------------&#xA;DECLARE @cINTRVN_ID varchar(15)&#xA;  ,@cINTRL_ID varchar(15)&#xA;  ,@cFONC varchar(MAX)&#xA;DECLARE @getLstFonc CURSOR&#xA;&#xA;SET @getLstFonc = CURSOR FOR&#xA;&#xA;SELECT id_intrvn, id_intrl, FONCTION&#xA;&#xA;-- La table GI2_ENTCONS est chargé avant le traitement&#xA;-- Le champ CATG_FIN doit être à '' et non NULL&#xA;&#xA;FROM GI2_TEMP_FONC&#xA;ORDER BY FONCTION&#xA;&#xA;OPEN @getLstFonc&#xA;FETCH NEXT FROM @getLstFonc INTO @cINTRVN_ID,@cINTRL_ID, @cFONC&#xA;WHILE @@FETCH_STATUS = 0&#xA;BEGIN&#xA;-- PRINT @OU_NUM&#xA; UPDATE dbo.GI2_LST_INTRVN_INTRL_TMP&#xA;  set liste_fonctions_rep = LTRIM(isnull(liste_fonctions_rep,'') + ';' + @cFONC)&#xA; where  [id_intrvn] = @cINTRVN_ID and [id_intrl] = @cINTRL_ID&#xA;FETCH NEXT FROM @getLstFonc INTO @cINTRVN_ID,@cINTRL_ID, @cFONC&#xA;END&#xA;CLOSE @getLstFonc&#xA;DEALLOCATE @getLstFonc&#xA;&#xA;&#xA;&#xA;--Remettre le champ nombre et liste à null au lieu de 0 et ''&#xA;--------------------------------------&#xA;update GI2_LST_INTRVN_INTRL_TMP&#xA; set liste_fonctions_rep = null&#xA;where liste_fonctions_rep = ''&#xA;GO&#xA;&#xA;update GI2_LST_INTRVN_INTRL_TMP&#xA; set liste_fonctions_rep = STUFF ( liste_fonctions_rep , 1 , 1 ,'' )&#xA;where liste_fonctions_rep IS NOT NULL &#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\ENTREPRISE_REPONDANS REG_CD\Ajout NB Intervenant"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Tâche d'exécution de requêtes SQL"
          DTS:DTSID="{2DC9650E-D494-4E52-A192-3B589FB5EAA5}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Ajout NB Intervenant"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; Microsoft SQL Server v9; © 2004 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{732520B4-637C-4975-BC17-1FF4E2C9BBFE}"
              SQLTask:SqlStatementSource="-- Update du nombre de sous-catg selon&#xA;-- la table temporaire contenant la liste&#xA;-- de toutes les sous-catg pour un intervenant&#xA;--------------------------------------&#xA;update GI2_LST_INTRVN_INTRL_TMP&#xA; set nb_souscatg = count_habil&#xA;&#xA;from&#xA; (&#xA; select DREX_ID, INTRVN_ID, SDREX_ID, count(1) count_habil&#xA; from dbo.GI2_LST_HABIL&#xA; group by DREX_ID, INTRVN_ID, SDREX_ID&#xA; ) b&#xA;&#xA;where b.DREX_ID = id_drex&#xA; and b.INTRVN_ID = id_intrvn&#xA; AND b.SDREX_Id = id_sdrex&#xA;GO&#xA;&#xA;&#xA;-- Curseur permettant de mettre à jour la liste des catégorie.&#xA;--------------------------------------&#xA;DECLARE @cDREX_ID varchar(15)&#xA;  ,@cSDREX_ID varchar(15)&#xA;  ,@cINTRVN_ID varchar(15)&#xA;  ,@cTXT varchar(MAX)&#xA;DECLARE @getLstCatg CURSOR&#xA;&#xA;SET @getLstCatg = CURSOR FOR&#xA;&#xA;SELECT DREX_ID, INTRVN_ID, NAME, SDREX_ID&#xA;&#xA;-- La table GI2_ENTCONS est chargé avant le traitement&#xA;-- Le champ CATG_FIN doit être à '' et non NULL&#xA;&#xA;FROM GI2_LST_HABIL&#xA;order by NAME&#xA;&#xA;OPEN @getLstCatg&#xA;FETCH NEXT FROM @getLstCatg INTO @cDREX_ID,@cINTRVN_ID, @cTXT, @cSDREX_ID&#xA;WHILE @@FETCH_STATUS = 0&#xA;BEGIN&#xA;-- PRINT @OU_NUM&#xA; UPDATE dbo.GI2_LST_INTRVN_INTRL_TMP&#xA;  set liste_souscatg = LTRIM(isnull(liste_souscatg,'') + ' ' + @cTXT)&#xA; where  id_drex = @cDREX_ID and id_intrvn = @cINTRVN_ID and id_sdrex = @cSDREX_ID&#xA;FETCH NEXT FROM @getLstCatg INTO @cDREX_ID,@cINTRVN_ID, @cTXT, @cSDREX_ID&#xA;END&#xA;CLOSE @getLstCatg&#xA;DEALLOCATE @getLstCatg&#xA;&#xA;&#xA;&#xA;--Remettre le champ nombre et liste à null au lieu de 0 et ''&#xA;--------------------------------------&#xA;update GI2_LST_INTRVN_INTRL_TMP&#xA; set nb_souscatg = null,&#xA; liste_souscatg = null&#xA;where nb_souscatg = 0" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\ENTREPRISE_REPONDANS REG_CD\Ajout NB_INTRL et ASCG"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Tâche d'exécution de requêtes SQL"
          DTS:DTSID="{BF41E3F5-6CEF-4141-8CCF-27774B6D338D}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Ajout NB_INTRL et ASCG"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; Microsoft SQL Server v9; © 2004 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{732520B4-637C-4975-BC17-1FF4E2C9BBFE}"
              SQLTask:SqlStatementSource="-- Update du nombre de sous-catg selon&#xA;-- la table temporaire contenant la liste&#xA;-- de toutes les comp utilisé pour un interlo&#xA;-- et un intervenant&#xA;--------------------------------------&#xA;UPDATE&#xA;    GI2_LST_INTRVN_INTRL_TMP&#xA;SET &#xA;    nb_souscatg_intrl = count_habil&#xA;FROM&#xA;    (&#xA;      SELECT&#xA;        DREX_ID,&#xA;        INTRVN_ID,&#xA;        INTRL_ID,&#xA;        SDREX_ID,&#xA;        COUNT(1) count_habil&#xA;      FROM&#xA;        dbo.GI2_LST_ASCG&#xA;      GROUP BY&#xA;        DREX_ID,&#xA;        INTRVN_ID,&#xA;        INTRL_ID,&#xA;        SDREX_ID&#xA;    ) b&#xA;WHERE&#xA;    b.DREX_ID = id_drex&#xA;    AND b.INTRVN_ID = id_intrvn&#xA;    AND b.INTRL_ID = id_intrl&#xA;    AND b.SDREX_ID = id_sdrex&#xA;GO&#xA;&#xA;-- Curseur permettant de mettre à jour la liste des catégorie.&#xA;--------------------------------------&#xA;DECLARE&#xA;        @cDREX_ID VARCHAR(15),&#xA;        @cINTRVN_ID VARCHAR(15),&#xA;        @cINTRL_ID VARCHAR(15),&#xA;        @cSDREX_ID VARCHAR(15),&#xA;        @cASCG VARCHAR(1),&#xA;        @cTXT VARCHAR(MAX)&#xA;DECLARE @getLstCatg CURSOR&#xA;&#xA;SET&#xA; @getLstCatg = CURSOR FOR&#xA;&#xA;SELECT DREX_ID, INTRVN_ID, INTRL_ID, SDREX_ID, ASCG, CATG&#xA;FROM dbo.GI2_LST_ASCG&#xA;order by CATG&#xA;&#xA;OPEN @getLstCatg&#xA;FETCH NEXT FROM @getLstCatg INTO @cDREX_ID, @cINTRVN_ID, @cINTRL_ID,&#xA;      @cSDREX_ID, @cASCG, @cTXT&#xA;WHILE @@FETCH_STATUS = 0&#xA;      BEGIN&#xA;-- PRINT @OU_NUM&#xA;            UPDATE&#xA;                dbo.GI2_LST_INTRVN_INTRL_TMP&#xA;            SET &#xA;                liste_souscatg_intrl = LTRIM(ISNULL(liste_souscatg_intrl, '')&#xA;                                             + ' ' + @cTXT),&#xA;                a = CASE @cASCG&#xA;                      WHEN 'A' THEN 'O'&#xA;                      ELSE a&#xA;                    END,&#xA;                s = CASE @cTXT&#xA;                      WHEN '1.4S' THEN s&#xA;                      WHEN '1.5S' THEN s&#xA;                      WHEN '1.6S' THEN s&#xA;                      WHEN '1.7S' THEN s&#xA;                      ELSE CASE @cASCG&#xA;                             WHEN 'S' THEN 'O'&#xA;                             ELSE s&#xA;                           END&#xA;                    END,&#xA;                c = CASE @cASCG&#xA;                      WHEN 'C' THEN 'O'&#xA;                      ELSE c&#xA;                    END,&#xA;                g = CASE @cTXT&#xA;                      WHEN '1.4G' THEN g&#xA;                      WHEN '1.5G' THEN g&#xA;                      WHEN '1.6G' THEN g&#xA;                      WHEN '1.7G' THEN g&#xA;                      ELSE CASE @cASCG&#xA;                             WHEN 'G' THEN 'O'&#xA;                             ELSE g&#xA;                           END&#xA;                    END&#xA;            WHERE&#xA;                id_drex = @cDREX_ID&#xA;                AND id_intrvn = @cINTRVN_ID&#xA;                AND id_intrl = @cINTRL_ID&#xA;                AND id_sdrex = @cSDREX_ID&#xA;&#xA;            FETCH NEXT FROM @getLstCatg INTO @cDREX_ID, @cINTRVN_ID,&#xA;                  @cINTRL_ID, @cSDREX_ID, @cASCG, @cTXT&#xA;      END&#xA;CLOSE @getLstCatg&#xA;DEALLOCATE @getLstCatg&#xA;&#xA;&#xA;--Remettre le champ nombre et liste à null au lieu de 0 et ''&#xA;--------------------------------------&#xA;UPDATE&#xA;    GI2_LST_INTRVN_INTRL_TMP&#xA;SET &#xA;    nb_souscatg_intrl = NULL,&#xA;    liste_souscatg_intrl = NULL&#xA;WHERE&#xA;    nb_souscatg_intrl = 0&#xA;&#xA;-- Quand une licence à un S et un G (1.4S et 1.4G) mettre C à 'O''&#xA;-------------------------------------- &#xA;UPDATE&#xA; GI2_LST_INTRVN_INTRL_TMP&#xA;SET &#xA; c = 'O' &#xA;WHERE &#xA;    liste_souscatg_intrl LIKE '%1.4S%1.4G%'&#xA; OR liste_souscatg_intrl LIKE '%1.5S%1.5G%'&#xA; OR liste_souscatg_intrl LIKE '%1.6S%1.6G%'&#xA; OR liste_souscatg_intrl LIKE '%1.7S%1.7G%'&#xA; OR liste_souscatg_intrl LIKE '%1.4G%1.4S%'&#xA; OR liste_souscatg_intrl LIKE '%1.5G%1.5S%'&#xA; OR liste_souscatg_intrl LIKE '%1.6G%1.6S%'&#xA; OR liste_souscatg_intrl LIKE '%1.7G%1.7S%'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\ENTREPRISE_REPONDANS REG_CD\Conteneur de séquences"
          DTS:CreationName="STOCK:SEQUENCE"
          DTS:Description="Conteneur de séquences"
          DTS:DTSID="{8A4D1751-E585-4D82-A161-C4571E4489DA}"
          DTS:ExecutableType="STOCK:SEQUENCE"
          DTS:LocaleID="-1"
          DTS:ObjectName="Conteneur de séquences">
          <DTS:Variables />
          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\ENTREPRISE_REPONDANS REG_CD\Conteneur de séquences\LIGNE DE CONTROLE"
              DTS:CreationName="Microsoft.ScriptTask"
              DTS:Description="Tâche de script"
              DTS:DTSID="{FAECE9E4-929B-4E09-A25F-F06D3CCCDC5F}"
              DTS:ExecutableType="Microsoft.ScriptTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="LIGNE DE CONTROLE"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <ScriptProject
                  Name="ScriptTask_2818be0fd9834c55abfbaa0acc2485b8"
                  VSTAMajorVersion="17"
                  VSTAMinorVersion="0"
                  Language="VisualBasic"
                  ReadOnlyVariables="SAVEPATH,SAVEPATH_CCQ,CONN_STRING_GIC01,SAVEPATH_CD,FILENAME_REG_CD,FILENAME_REG_CCQ">
                  <ProjectItem
                    Name="ScriptMain.vb"
                    Encoding="UTF8"><![CDATA[' Microsoft SQL Server Integration Services Script Task
' Write scripts using Microsoft Visual Basic
' The ScriptMain class is the entry point of the Script Task.

Imports System
Imports System.Data
Imports System.Math
Imports Microsoft.SqlServer.Dts.Runtime
Imports System.IO
Imports System.Data.OleDb
Imports System.Data.OleDb.OleDbCommand



<Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute> _
<System.CLSCompliantAttribute(False)> _
Partial Public Class ScriptMain
	Inherits Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase

	Enum ScriptResults
		Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success
		Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
	End Enum

    ' The execution engine calls this method when the task executes.
    ' To access the object model, use the Dts object. Connections, variables, events,
    ' and logging features are available as static members of the Dts class.
    ' Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
    ' 
    ' To open Code and Text Editor Help, press F1.
    ' To open Object Browser, press Ctrl+Alt+J.

    Public Sub Main()
        '
        ' Fonction permettant de créer un ligne de contrôle pour un fichier.
        ' Le répertoire et le nom de fichier sont contenu dans des variables SSIS.
        '
        Dim pointeur As Integer
        Dim sPath(2) As String
        Dim sCompteur As String

        ' Nom du chemin avec le nom du fichier.
        sPath(0) = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_CCQ").Value) + System.Convert.ToString(Dts.Variables("FILENAME_REG_CCQ").Value)
        sPath(1) = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_CD").Value) + System.Convert.ToString(Dts.Variables("FILENAME_REG_CD").Value)

        '
        ' Ouverture de la connexion OLEDB selon la "connection string" de la variable SSIS.
        '
        Dim oOleDbConnection As OleDbConnection
        Dim sConnString As String = System.Convert.ToString(Dts.Variables("CONN_STRING_GIC01").Value)
        oOleDbConnection = New OleDb.OleDbConnection(sConnString)
        oOleDbConnection.Open()

        '
        ' Appel de la commande SQL avec la connexion OLEDB.
        ' permet d'avoir un compteur du nombre d'enregistrement.
        '
        Dim sqlComm As OleDbCommand = New OleDbCommand("select count(*) cnt from GI2_ENT_REP", oOleDbConnection)

        Dim dr As OleDbDataReader = sqlComm.ExecuteReader()
        While dr.Read()
            sCompteur = dr.GetInt32(0).ToString
        End While

        dr.Close()
        oOleDbConnection.Close()

        '
        ' Écriture de la ligne de contrôle dans le fichier.
        ' Cette ligne doit avoir le format DATETIME|NB_ENREGISTREMENT.
        '

        For pointeur = 1 To 1 Step 1
            'Instructions
            Try
                Using sw As StreamWriter = File.CreateText(sPath(pointeur))
                    sw.WriteLine(Format(System.DateTime.Now, "yyyy-MM-dd HH:mm:ss") + "|" + sCompteur)
                    sw.Close()
                End Using

            Catch e As Exception
                Console.WriteLine("Erreur: Création de la ligne de contrôle.", e.ToString())
                ' Résultat retourné pour SSIS = ÉCHEC.
                Dts.TaskResult = ScriptResults.Failure
            End Try
        Next
        ' Résultat retourné pour SSIS = SUCCÈS.
        Dts.TaskResult = ScriptResults.Success
    End Sub

End Class]]></ProjectItem>
