                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">-- Selection de tous les intervenants ayant une licences sans compétences utilisées
-- Modification: 
--      Date: 2026-04-24 
--      Auteur: Chouaebou Mafera
--      Objet: afficher le courriel, telephone, cellulaire ou fax avec ou sans consentement
--------------------------------------------------------------------------------------------
SELECT DISTINCT
    s2.X_OU_NUM_RBQ         AS NO_INTERV,
    s2.X_NEQ                AS NEQ,
    STAT_JUR.[VAL]          AS STAT_JUR,
    s2.[NAME]               AS NOM,
    s6.[NAME]               AS ATR_NOM,
    s4.ADDR_LINE_2          AS ADR_LIGNE1,
    s4.ADDR_LINE_4          AS ADR_LIGNE2,
    s4.ADDR_LINE_5          AS ADR_LIGNE3,
    s4.ADDR_NUM             AS NO_CIVIQ,
    s4.X_ARTERE             AS TYP_ARTR,
    s4.ADDR                 AS RUE,
    s4.ADDR_LINE_3          AS APT,
    s4.ZIPCODE              AS COD_POST,
    s4.[STATE]              AS PROV,
    s4.X_CODE_MUNICIPALITE  AS CPMUNIC,
    s4.CITY                 AS MUNIC,
    s4.X_CODE_REGION_ADM    AS COD_REG_ADM,
    REG_ADM.DESC_TEXT       AS X_REGION_ADMIN,
    s4.X_CODE_MRC           AS COD_MRC,
    MRC.DESC_TEXT           AS MRC,
    CASE OU_TYPE_CD
        WHEN 'Personne physique' THEN 
             CASE X_CONSENTEMENT_TEL_FLG
                WHEN 'Y' 
                THEN s2.MAIN_PH_NUM
                ELSE s2.MAIN_PH_NUM /*retourner le numéro telephone sans consentement. Sinon NULL (état initial avant modification)*/
             END
        ELSE s2.MAIN_PH_NUM
    END AS NO_TEL,
    CASE OU_TYPE_CD
        WHEN 'Personne physique' 
        THEN s2.MAIN_FAX_PH_NUM     /*retourner le numéro fax sans consentement. Sinon NULL (état initial avant modification)*/ 
        ELSE s2.MAIN_FAX_PH_NUM
    END AS NO_FAX,
    CASE OU_TYPE_CD
        WHEN 'Personne physique' THEN 
             CASE X_CONSENTEMENT_COURRIEL_FLG
                WHEN 'Y' THEN s2.MAIN_EMAIL_ADDR
                ELSE s2.MAIN_EMAIL_ADDR     /*retourner le email sans consentement. Sinon NULL (état initial avant modification)*/ 
             END
        ELSE s2.MAIN_EMAIL_ADDR
    END AS COURRIEL,
    CASE s5.ATTRIB_50
        WHEN 'Entrepreneur' THEN 'E'
        WHEN 'Constructeur-proprietaire' THEN 'CP'
        ELSE NULL
    END AS TYPE_INTRVT,
    s1.X_AGREE_NUM_RBQ NO_LIC,
    CASE s1.X_CATEGORIE
        WHEN 'Generale et specialisee' THEN 'GS'
        WHEN 'Specialisee' THEN 'S'
        WHEN 'Generale' THEN 'G'
        ELSE NULL
    END AS CATG_LIC,
    CASE 
        WHEN s7.EFF_START_DT IS NOT NULL 
        THEN s7.ENTLMNT_NUM
        ELSE NULL
    END AS ENTLMNT_NUM,
    s7.EFF_START_DT     AS DT_ENTREE_VIG,
    s1.DUE_DT           AS DT_FIN_ANN,
    s7.EFF_END_DT       AS DT_FIN_LIC,
    s7.X_RESTRICTION    AS X_RESTRICTION,
    0                   AS NB_CATG,
    0                   AS NB_SC_INTRL,
    ''                  AS LIST_CATG_INTRL,
    s2.ROW_ID           AS ID_INTRVN,
    s1.ROW_ID           AS ID_DREX,
    s7.ROW_ID           AS ID_SDREX,
    CASE OU_TYPE_CD
        WHEN 'Personne physique' THEN 
            CASE X_CONSENTEMENT_TEL_FLG
                WHEN 'Y' THEN s2.X_CELLULAIRE
                ELSE s2.X_CELLULAIRE    /*retourner le numéro cellulaire sans consentement. Sinon NULL (état initial avant modification)*/
            END
        ELSE s2.X_CELLULAIRE
    END AS CELLULLAIRE,
    s1.APPR_DT DATE_EMIS
FROM
    -- DROITS EXERCICES
    S_DOC_AGREE AS s1  

    -- INTERVENANTS 
    INNER JOIN S_ORG_EXT AS s2         
        ON s2.ROW_ID = s1.TARGET_OU_ID
        --AND ACCNT_FLG = 'Y'

    -- DOMAINES
    LEFT OUTER JOIN S_ORG_EXT_XM AS s5 
        ON s5.PAR_ROW_ID = s2.ROW_ID
        AND s5.TYPE = 'Type_Intervenant'

    -- LIEN INTERVENANT-ADRESSES
    LEFT OUTER JOIN S_CON_ADDR AS s3 
        ON s3.ACCNT_ID = s2.ROW_ID
        AND s3.ADDR_TYPE_CD = 'Principale'
        AND ((GETDATE() &gt; s3.[START_DT] AND GETDATE() &lt; s3.[END_DT])
                OR (GETDATE() &gt; s3.[START_DT] AND s3.[END_DT] IS NULL))

    -- ADRESSES INTERVENANTS
    LEFT OUTER JOIN S_ADDR_PER AS s4 
        ON s4.ROW_ID = s3.ADDR_PER_ID

    -- AUTRES NOMS
    LEFT OUTER JOIN S_ORG_SYN AS s6 
        ON s6.OU_ID = s2.ROW_ID
        AND X_TYPE_NOM = 'Raison sociale'
        AND X_DATE_FIN IS NULL

    -- SUIVI DROIT EXERCICE
    INNER JOIN S_ENTLMNT AS s7 
        ON s7.PAR_AGREE_ID = s1.ROW_ID
        AND X_STATUS = 'Actif'

    -- HABILITATION_ACCORDÉS
    INNER JOIN S_ENTLMNT_ITEM AS s8 
        ON s8.DOC_AGREE_ID = s7.ROW_ID
        AND X_STATUS_CD IN ('Active','Partielle')

    -- LOV STAT JURIDIQUE
    LEFT OUTER JOIN [S_LST_OF_VAL] AS STAT_JUR 
        ON STAT_JUR.[LANG_ID] = 'FRA'
        AND STAT_JUR.[TYPE] = 'ACCOUNT_TYPE'
        AND STAT_JUR.[NAME] = s2.OU_TYPE_CD

    -- LOV Région administrative
    LEFT JOIN S_LST_OF_VAL AS REG_ADM 
        ON REG_ADM.[LANG_ID] = 'FRA'
        AND REG_ADM.[TYPE] = 'RBQ_REGION_ADMIN'
        AND REG_ADM.[NAME] = s4.X_CODE_REGION_ADM

    -- LOV MRC
    LEFT JOIN S_LST_OF_VAL AS MRC 
        ON MRC.[LANG_ID] = 'FRA'
        AND MRC.[TYPE] = 'RBQ_MRC'
        AND MRC.[NAME] = s4.X_CODE_MRC                                      
WHERE   
    STAT_CD = 'Active'
    AND s5.ATTRIB_50 = s1.AGREE_CD
    /* Avec Habilitation accordée */
    AND EXISTS (    
        SELECT 1
        FROM   CX_COMPET_UTIL s10
        WHERE  s10.HABIL_ACCORD_ID = s8.ROW_ID 
    ) 
    /* état initial */
    --AND NOT EXISTS (    
    --    SELECT 1
    --    FROM   CX_COMPET_UTIL s10
    --    WHERE  s10.HABIL_ACCORD_ID = s8.ROW_ID 
    --)</property>
