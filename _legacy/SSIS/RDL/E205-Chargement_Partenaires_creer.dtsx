                    <property
                      dataType="System.String"
                      description="Commande SQL à exécuter."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select 
	SUBSTRING(s1.OU_NUM,1,4) + SUBSTRING(s1.OU_NUM,6,4) NO_INTERV,

	'Demande de modification entrepreneur' Description,
	CONVERT(varchar(8),s2.CREATED,112) DATE_DEBUT,
	CONVERT(varchar(8),s2.EXP_CLOSE_DT,112) DATE_FIN,
isnull (X_RESULTAT ,'En traitement') CONCLUSION
from
	S_ORG_EXT s1
inner join S_SRV_REQ s2
	on s1.ROW_ID = s2.CST_OU_ID
where 
	SR_AREA in (38,54)</property>
                    <property
