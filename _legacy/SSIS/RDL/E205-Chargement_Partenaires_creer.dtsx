                      description="Commande SQL à exécuter."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT a.[X_AGREE_NUM_RBQ] NO_LIC,b.ENTLMNT_NUM NO_VALIDATION_LIC, c.NAME ADRESSE_1, c.LIGNE2 ADRESSE_2  FROM 
	[S_DOC_AGREE] a
	INNER JOIN S_ENTLMNT b
		ON b.PAR_AGREE_ID = a.ROW_ID
	INNER JOIN [CX_LIEUX_TRAV] c
		ON c.PAR_ROW_ID = b.ROW_ID
WHERE b.X_STATUS = 'Actif'
AND a.AGREE_CD = 'Constructeur-proprietaire'</property>
