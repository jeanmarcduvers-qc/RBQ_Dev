      <DTS:ObjectData>
        <ScriptProject
          Name="ScriptTask_bd63b47326474843a7fa8f74a644b37e"
          VSTAMajorVersion="17"
          VSTAMinorVersion="0"
          Language="VisualBasic"
          ReadOnlyVariables="SAVEPATH,SAVEPATH_CD,SAVEPATH_CCQ,SAVEPATH_GEN,SAVEPATH_HQ">
          <ProjectItem
            Name="ScriptMain.vb"
            Encoding="UTF8"><![CDATA[Imports System
Imports System.Data
Imports System.Math
Imports Microsoft.SqlServer.Dts.Runtime
Imports System.IO
Imports Microsoft.VisualBasic

<Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute> _
<System.CLSCompliantAttribute(False)> _
Partial Public Class ScriptMain
	Inherits Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase

	Enum ScriptResults
		Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success
		Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
	End Enum

    Public Sub Main()
        ' Spécifier le répertoire à créer
        Dim pointeur As Integer
        Dim savePath(4) As String

        savePath(0) = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_CD").Value)
        savePath(1) = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_CCQ").Value)
        savePath(2) = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_HQ").Value)
        savePath(3) = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_GEN").Value)

        For pointeur = 0 To 3 Step 1
            'Instructions
            Try
                ' Determine si le répertoire existe
                If Directory.Exists(savePath(pointeur)) Then
                    ' Le répertoire existe, rien à faire.
                    Return
                End If

                ' Crée le repertoire.
                Dim di As DirectoryInfo = Directory.CreateDirectory(savePath(pointeur))

            Catch e As Exception
                Console.WriteLine("Erreur: Création de répertoire.", e.ToString())
                Dts.TaskResult = ScriptResults.Failure
            End Try


        Next
        Dts.TaskResult = ScriptResults.Success
    End Sub

End Class]]></ProjectItem>
