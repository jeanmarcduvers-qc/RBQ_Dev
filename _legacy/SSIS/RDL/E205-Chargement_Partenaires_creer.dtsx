                    <property
                      dataType="System.String"
                      description="Commande SQL à exécuter."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select 
	SUBSTRING(s1.OU_NUM,1,4) + SUBSTRING(s1.OU_NUM,6,4) NO_INTERV,

	'Avis de convocation aux examens imprimés' Description,
	CONVERT(varchar(8),s2.CREATED,112) DATE,
	X_STATUT CONCLUSION
from
	S_ORG_EXT s1
inner join CX_FILE_ATT s2 WITH (NOLOCK)
	on s1.ROW_ID = s2.X_ACCOUNT_ID
where FILE_NAME = '6-3 Examens à passer pour une demande de licence - informer l''entreprise'</property>
