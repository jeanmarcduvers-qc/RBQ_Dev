                      description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Commande SQL à exécuter."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select 
	s1.ROW_ID DREX_ID, 
	s2.ROW_ID INTRVN_ID, 
	s12.ROW_ID INTRL_ID,
	s8.ROW_ID HABIL_ID,
	s11.ROW_ID CPUTIL_ID,
	substring(s9.MODEL_CD,1,1) ASCG,
	s9.NAME CATG,
	s7.ROW_ID SDREX_ID
from 


--DROITS EXERCICES
	S_DOC_AGREE s1

--INTERVENANTS
inner join 
	S_ORG_EXT s2
	on s2.ROW_ID = s1.TARGET_OU_ID
	and ACCNT_FLG = 'Y'

--SUIVI DROIT EXERCICE
inner join S_ENTLMNT s7
	on s7.PAR_AGREE_ID = s1.ROW_ID
	

--HABILITATION_ACCORDÉS
inner join S_ENTLMNT_ITEM s8
	on s8.DOC_AGREE_ID = s7.ROW_ID

--COMPETENCE UTILISE
inner join CX_COMPET_UTIL s10
	on s8.ROW_ID = s10.HABIL_ACCORD_ID

--COMPETENCE 
inner join S_PROD_CON s11
	on s11.ROW_ID = s10.COMPET_ID

--INTERLOCUTEUR
inner join S_CONTACT s12
	on s12.ROW_ID = s11.CONTACT_ID

--LIEN_INTERLOCUTEUR
left outer join S_CON_ADDR s13
	on s12.ROW_ID = s13.CONTACT_ID
	and s13.ADDR_TYPE_CD = 'Principale'
	AND ((GETDATE() &gt; s13.[START_DT] AND GETDATE() &lt; s13.[END_DT]) OR (GETDATE() &gt; s13.[START_DT] AND s13.[END_DT] IS NULL))

--SOUS_CATG, PRODUITS
inner join S_PROD_INT s9
	on s9.ROW_ID = s11.PROD_ID</property>
                    <property
                      dataType="System.String"
                      description="Variable contenant la commande SQL à exécuter."
                      name="SqlCommandVariable"></property>
                    <property
                      dataType="System.Int32"
