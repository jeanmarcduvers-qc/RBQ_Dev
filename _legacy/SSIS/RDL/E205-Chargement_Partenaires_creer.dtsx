                    <component
                      refId="Package\ENTREPRISE_REPONDANS REG_CD\Table de travail INTERVENANT_LICENCE_INTERLOCUTEUR\Contrevenant au noir\SIEBEL"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                      description="Source OLE DB"
                      name="SIEBEL"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
        s2.OU_NUM NO_INTERV,
        s2.X_NEQ NEQ,
        STAT_JUR.[VAL] STAT_JUR,
        s2.NAME NOM,
        s6.X_AUTRE_NOM ATR_NOM,
        s4.ADDR_LINE_2 ADR_LIGNE1,
        s4.ADDR_LINE_4 ADR_LIGNE2,
        s4.ADDR_LINE_5 ADR_LIGNE3,
        s4.ADDR_NUM NO_CIVIQ,
        s4.X_ARTERE TYP_ARTR,
        s4.ADDR RUE,
        s4.ADDR_LINE_3 APT,
        s4.ZIPCODE COD_POST,
        s4.STATE PROV,
        s4.X_CODE_MUNICIPALITE CPMUNIC,
        s4.CITY MUNIC,
        s4.X_CODE_REGION_ADM COD_REG_ADM,
        REG_ADM.DESC_TEXT X_REGION_ADMIN,
        s4.X_CODE_MRC COD_MRC,
        MRC.DESC_TEXT MRC,
        s2.MAIN_PH_NUM NO_TEL,
        s2.MAIN_FAX_PH_NUM NO_FAX,
        s2.MAIN_EMAIL_ADDR COURRIEL,
        CASE OU_TYPE_CD
          WHEN 'Personne physique' THEN CASE X_CONSENTEMENT_TEL_FLG
                                          WHEN 'Y' THEN s2.MAIN_PH_NUM
                                          ELSE NULL
                                        END
          ELSE s2.MAIN_PH_NUM
        END NO_TEL_CCQ,
        CASE OU_TYPE_CD
          WHEN 'Personne physique' THEN CASE X_CONSENTEMENT_COURRIEL_FLG
                                          WHEN 'Y' THEN s2.MAIN_EMAIL_ADDR
                                          ELSE NULL
                                        END
          ELSE s2.MAIN_EMAIL_ADDR
        END COURRIEL_CCQ,
        'TSL' TYPE_INTRVT,
        0 NB_CATG,
        0 NB_SC_INTRL,
        s2.ROW_ID id_intrvn,
        CASE OU_TYPE_CD
          WHEN 'Personne physique' THEN CASE X_CONSENTEMENT_TEL_FLG
                                          WHEN 'Y' THEN s2.X_CELLULAIRE
                                          ELSE NULL
                                        END
          ELSE s2.X_CELLULAIRE
        END cellullaire_ccq 
FROM    
--INTERVENANTS
        S_ORG_EXT s2 
--DOMAINES
        LEFT OUTER JOIN S_ORG_EXT_XM s5 ON s5.PAR_ROW_ID = s2.ROW_ID
                                           AND s5.TYPE = 'Type_Intervenant'

--LIEN INTERVENANT-ADRESSES
        LEFT OUTER JOIN S_CON_ADDR s3 ON s3.ACCNT_ID = s2.ROW_ID
                                         AND s3.ADDR_TYPE_CD = 'Principale'
                                         AND ( ( GETDATE() &gt; s3.[START_DT]
                                                 AND GETDATE() &lt; s3.[END_DT]
                                               )
                                               OR ( GETDATE() &gt; s3.[START_DT]
                                                    AND s3.[END_DT] IS NULL
                                                  )
                                             )
--ADRESSES INTERVENANTS
        LEFT OUTER JOIN S_ADDR_PER s4 ON s4.ROW_ID = s3.ADDR_PER_ID


--AUTRES NOMS
        LEFT JOIN S_ORG_SYN s6 --	on s6.OU_ID = s2.ROW_ID
        ON s2.PR_SYN_ID = s6.ROW_ID
           AND X_TYPE_NOM = 'Raison sociale'
           AND X_DATE_FIN IS NULL

--LOV STAT JURIDIQUE
        LEFT OUTER JOIN [S_LST_OF_VAL] STAT_JUR ON STAT_JUR.[LANG_ID] = 'FRA'
                                                   AND STAT_JUR.[TYPE] = 'ACCOUNT_TYPE'
                                                   AND STAT_JUR.[NAME] = s2.OU_TYPE_CD
                                                   
--LOV Région administrative
		LEFT JOIN S_LST_OF_VAL REG_ADM ON REG_ADM.[LANG_ID] = 'FRA'
                                          AND REG_ADM.[TYPE] = 'RBQ_REGION_ADMIN'
                                          AND REG_ADM.[NAME] = s4.X_CODE_REGION_ADM
                                          
--LOV MRC
		LEFT JOIN S_LST_OF_VAL MRC ON MRC.[LANG_ID] = 'FRA'
                                      AND MRC.[TYPE] = 'RBQ_MRC'
                                      AND MRC.[NAME] = s4.X_CODE_MRC
                                      
WHERE   s2.ACCNT_FLG = 'Y'
        AND s5.ATTRIB_50 = 'Contrevenant au noir'</property>
                        <property
                          dataType="System.String"
                          description="Variable contenant la commande SQL à exécuter."
                          name="SqlCommandVariable"></property>
                        <property
                          dataType="System.Int32"
