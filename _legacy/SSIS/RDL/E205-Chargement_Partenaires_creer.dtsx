                      description="Commande SQL à exécuter."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select 
	SUBSTRING(s1.OU_NUM,1,4) + SUBSTRING(s1.OU_NUM,6,4) NO_INTERV,
	s2.X_AUTRE_NOM NOM,
	CONVERT(varchar(8),s2.X_DATE_DEBUT,112) [DATE_DEBUT],
	CONVERT(varchar(8),s2.X_DATE_FIN,112) [DATE_FIN]
from 
	S_ORG_EXT s1
inner join S_ORG_SYN s2
	on s2.OU_ID = s1.ROW_ID
where
	X_TYPE_NOM = 'Raison sociale'</property>
