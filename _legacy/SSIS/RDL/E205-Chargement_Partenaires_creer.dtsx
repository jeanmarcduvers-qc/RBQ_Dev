      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; Microsoft SQL Server v9; © 2004 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{732520B4-637C-4975-BC17-1FF4E2C9BBFE}"
          SQLTask:SqlStatementSource="IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[GI2_LST_SOUS_CATG]') AND type IN (N'U'))&#xA;TRUNCATE TABLE [dbo].[GI2_LST_SOUS_CATG]&#xA;GO&#xA;IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[GI2_LST_ASCG]') AND type IN (N'U'))&#xA;TRUNCATE TABLE [dbo].[GI2_LST_ASCG]&#xA;GO&#xA;IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[GI2_LST_HABIL_CMP]') AND type IN (N'U'))&#xA;TRUNCATE TABLE [dbo].[GI2_LST_HABIL_CMP]&#xA;GO&#xA;IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[GI2_LST_HABIL]') AND type IN (N'U'))&#xA;TRUNCATE TABLE [dbo].[GI2_LST_HABIL]&#xA;GO&#xA;IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[GI2_LST_INTRVN_INTRL_TMP]') AND type IN (N'U'))&#xA;TRUNCATE TABLE [dbo].[GI2_LST_INTRVN_INTRL_TMP]&#xA;GO&#xA;IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[GI2_LST_INTRVN_TMP]') AND type IN (N'U'))&#xA;TRUNCATE TABLE [dbo].[GI2_LST_INTRVN_TMP]&#xA;GO&#xA;IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[GI2_LST_INTRVN_NOIR_TMP]') AND type IN (N'U'))&#xA;TRUNCATE TABLE [dbo].[GI2_LST_INTRVN_NOIR_TMP]&#xA;GO&#xA;IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[GI2_ENT_REP]') AND type IN (N'U'))&#xA;TRUNCATE TABLE [dbo].[GI2_ENT_REP]&#xA;GO&#xA;IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].GI2_ATR_NOM') AND type IN (N'U'))&#xA;TRUNCATE TABLE [dbo].GI2_ATR_NOM&#xA;GO&#xA;IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].GI2_EVENCD') AND type IN (N'U'))&#xA;TRUNCATE TABLE [dbo].GI2_EVENCD&#xA;GO&#xA;IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].GI2_EVENCCQ') AND type IN (N'U'))&#xA;TRUNCATE TABLE [dbo].GI2_EVENCCQ&#xA;GO&#xA;&#xA;IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[GI2_2810_LIEUX_TRAV]') AND type IN (N'U'))&#xA;TRUNCATE TABLE [dbo].[GI2_2810_LIEUX_TRAV]&#xA;GO&#xA;IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[GI2_TEMP_FONC]') AND type IN (N'U'))&#xA;TRUNCATE TABLE [dbo].[GI2_TEMP_FONC]&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
