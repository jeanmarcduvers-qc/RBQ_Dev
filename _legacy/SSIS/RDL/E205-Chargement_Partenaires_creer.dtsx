                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select 
	SUBSTRING(s1.OU_NUM,1,4) + SUBSTRING(s1.OU_NUM,6,4) NO_INTERV,

	'Préavis de décis. défav. - ÉCHEC ou .ÉCHEC PARTIEL aux examens' Description,
		CONVERT(varchar(8),s3.TODO_ACTL_START_DT ,112) DATE_DEBUT,
	CONVERT(varchar(8),s3.TODO_ACTL_END_DT ,112) DATE_FIN,
	s4.RESULT_CODE CONCLUSION
from
	S_ORG_EXT s1
inner join S_SRV_REQ s2
	on s1.ROW_ID = s2.CST_OU_ID
inner join S_EVT_ACT s3
	on s2.ROW_ID = s3.SRA_SR_ID
left join CX_WFM_RESULTCD s4
	on s3.X_RESULT_CD_ID = s4.ROW_ID
left join CX_WFM_ACTIONCD s5
	on s3.X_ACTION_CD_ID = s5.ROW_ID
where 
	SR_AREA in (29,30,31,32,34,35,36,37,38,39,52,53,54,55,65,66)
	and s5.ACTION_CODE  = 'Envoyer préavis de déc. défav - examens'

UNION

select 
	SUBSTRING(s1.OU_NUM,1,4) + SUBSTRING(s1.OU_NUM,6,4) NO_INTERV,

	'Préavis de décis. défav. - ÉCHEC ou .ÉCHEC PARTIEL aux examens' Description,
		CONVERT(varchar(8),s3.TODO_ACTL_START_DT ,112) DATE_DEBUT,
	CONVERT(varchar(8),s3.TODO_ACTL_END_DT ,112) DATE_FIN,
	s4.RESULT_CODE CONCLUSION
from
	S_ORG_EXT s1
inner join S_EVT_ACT s3
	on s1.ROW_ID = s3.TARGET_OU_ID 

left join CX_WFM_RESULTCD s4
	on s3.X_RESULT_CD_ID = s4.ROW_ID
where 
	s3.NAME ='Préavis décis. défav. ÉCHEC ou ECHEC PARTIEL exam'</property>
