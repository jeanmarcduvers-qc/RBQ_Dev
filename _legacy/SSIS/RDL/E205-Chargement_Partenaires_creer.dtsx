    <DTS:Executable
      DTS:refId="Package\ENTREPRISES_REPONDANTS_GEN_HQ"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Conteneur de séquences"
      DTS:DTSID="{14044761-2B23-45FE-9D68-E01A62227AF7}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="ENTREPRISES_REPONDANTS_GEN_HQ">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\ENTREPRISES_REPONDANTS_GEN_HQ\Ajout NB Intervenant"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Tâche d'exécution de requêtes SQL"
          DTS:DTSID="{7C0079D7-20DF-4A31-A845-B795DA49309A}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Ajout NB Intervenant"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; Microsoft SQL Server v9; © 2004 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{732520B4-637C-4975-BC17-1FF4E2C9BBFE}"
              SQLTask:SqlStatementSource="-- Update du nombre de sous-catg selon&#xA;-- la table temporaire contenant la liste&#xA;-- de toutes les sous-catg pour un intervenant&#xA;--------------------------------------&#xA;UPDATE&#xA;    GI2_LST_INTRVN_INTRL_TMP&#xA;SET &#xA;    nb_souscatg = count_habil&#xA;FROM&#xA;    (&#xA;      SELECT&#xA;        DREX_ID,&#xA;        INTRVN_ID,&#xA;        SDREX_ID,&#xA;        COUNT(1) count_habil&#xA;      FROM&#xA;        dbo.GI2_LST_HABIL&#xA;      GROUP BY&#xA;        DREX_ID,&#xA;        INTRVN_ID,&#xA;        SDREX_ID&#xA;    ) b&#xA;WHERE&#xA;    b.DREX_ID = id_drex&#xA;    AND b.INTRVN_ID = id_intrvn&#xA;    AND b.SDREX_Id = id_sdrex&#xA;GO&#xA;&#xA;&#xA;&#xA;-- Curseur permettant de mettre à jour la liste des catégorie.&#xA;--------------------------------------&#xA;DECLARE @cDREX_ID varchar(15)&#xA;  ,@cSDREX_ID varchar(15)&#xA;  ,@cINTRVN_ID varchar(15)&#xA;  ,@cTXT varchar(MAX)&#xA;DECLARE @getLstCatg CURSOR&#xA;&#xA;SET @getLstCatg = CURSOR FOR&#xA;&#xA;SELECT DREX_ID, INTRVN_ID, NAME, SDREX_ID&#xA;&#xA;-- La table GI2_ENTCONS est chargé avant le traitement&#xA;-- Le champ CATG_FIN doit être à '' et non NULL&#xA;&#xA;FROM GI2_LST_HABIL&#xA;order by NAME&#xA;&#xA;OPEN @getLstCatg&#xA;FETCH NEXT FROM @getLstCatg INTO @cDREX_ID,@cINTRVN_ID, @cTXT, @cSDREX_ID&#xA;WHILE @@FETCH_STATUS = 0&#xA;BEGIN&#xA; UPDATE dbo.GI2_LST_INTRVN_INTRL_TMP&#xA;  set liste_souscatg = LTRIM(isnull(liste_souscatg,'') + ' ' + @cTXT)&#xA; where  id_drex = @cDREX_ID and id_intrvn = @cINTRVN_ID and id_sdrex = @cSDREX_ID&#xA;FETCH NEXT FROM @getLstCatg INTO @cDREX_ID,@cINTRVN_ID, @cTXT, @cSDREX_ID&#xA;END&#xA;CLOSE @getLstCatg&#xA;DEALLOCATE @getLstCatg&#xA;&#xA;&#xA;&#xA;-- Curseur permettant de mettre à jour la liste de toutes les catégories. Permet d'avoir la compétence 16.&#xA;-- Pas seulement les catégories qui ne sont liés a aucune compétences utilisées.&#xA;--------------------------------------&#xA;DECLARE @getLstCatg1 CURSOR&#xA;&#xA;SET @getLstCatg1 = CURSOR FOR&#xA;&#xA;SELECT DREX_ID, INTRVN_ID, NAME, SDREX_ID&#xA;&#xA;FROM GI2_LST_HABIL_CMP&#xA;order by NAME&#xA;&#xA;OPEN @getLstCatg1&#xA;FETCH NEXT FROM @getLstCatg1 INTO @cDREX_ID,@cINTRVN_ID, @cTXT, @cSDREX_ID&#xA;WHILE @@FETCH_STATUS = 0&#xA;BEGIN&#xA; UPDATE dbo.GI2_LST_INTRVN_INTRL_TMP&#xA;  set liste_souscatgcmp = LTRIM(isnull(liste_souscatgcmp,'') + ' ' + @cTXT)&#xA; where  id_drex = @cDREX_ID and id_intrvn = @cINTRVN_ID and id_sdrex = @cSDREX_ID&#xA;FETCH NEXT FROM @getLstCatg1 INTO @cDREX_ID,@cINTRVN_ID, @cTXT, @cSDREX_ID&#xA;END&#xA;CLOSE @getLstCatg1&#xA;DEALLOCATE @getLstCatg1&#xA;&#xA;--Remettre le champ nombre et liste à null au lieu de 0 et ''&#xA;--------------------------------------&#xA;update GI2_LST_INTRVN_INTRL_TMP&#xA;&#x9;set nb_souscatg = null,&#xA;&#x9;liste_souscatg = null&#xA;where nb_souscatg = 0" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\ENTREPRISES_REPONDANTS_GEN_HQ\Ajout NB_INTRL et ASCG"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Tâche d'exécution de requêtes SQL"
          DTS:DTSID="{4400498C-53FF-4FC1-A646-11A10E8C84CD}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Ajout NB_INTRL et ASCG"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; Microsoft SQL Server v9; © 2004 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{732520B4-637C-4975-BC17-1FF4E2C9BBFE}"
              SQLTask:SqlStatementSource="-- Update du nombre de sous-catg selon&#xA;-- la table temporaire contenant la liste&#xA;-- de toutes les comp utilisé pour un interlo&#xA;-- et un intervenant&#xA;--------------------------------------&#xA;UPDATE&#xA;    GI2_LST_INTRVN_INTRL_TMP&#xA;SET &#xA;    nb_souscatg_intrl = count_habil&#xA;FROM&#xA;    (&#xA;      SELECT&#xA;        DREX_ID,&#xA;        INTRVN_ID,&#xA;        INTRL_ID,&#xA;        SDREX_ID,&#xA;        COUNT(1) count_habil&#xA;      FROM&#xA;        dbo.GI2_LST_ASCG&#xA;      GROUP BY&#xA;        DREX_ID,&#xA;        INTRVN_ID,&#xA;        INTRL_ID,&#xA;        SDREX_ID&#xA;    ) b&#xA;WHERE&#xA;    b.DREX_ID = id_drex&#xA;    AND b.INTRVN_ID = id_intrvn&#xA;    AND b.INTRL_ID = id_intrl&#xA;    AND b.SDREX_ID = id_sdrex&#xA;GO&#xA;&#xA;-- Curseur permettant de mettre à jour la liste des catégorie.&#xA;--------------------------------------&#xA;DECLARE&#xA;        @cDREX_ID VARCHAR(15),&#xA;        @cINTRVN_ID VARCHAR(15),&#xA;        @cINTRL_ID VARCHAR(15),&#xA;        @cSDREX_ID VARCHAR(15),&#xA;        @cASCG VARCHAR(1),&#xA;        @cTXT VARCHAR(MAX)&#xA;DECLARE @getLstCatg CURSOR&#xA;&#xA;SET&#xA; @getLstCatg = CURSOR FOR&#xA;&#xA;SELECT DREX_ID, INTRVN_ID, INTRL_ID, SDREX_ID, ASCG, CATG&#xA;FROM dbo.GI2_LST_ASCG&#xA;order by CATG&#xA;&#xA;OPEN @getLstCatg&#xA;FETCH NEXT FROM @getLstCatg INTO @cDREX_ID, @cINTRVN_ID, @cINTRL_ID,&#xA;      @cSDREX_ID, @cASCG, @cTXT&#xA;WHILE @@FETCH_STATUS = 0&#xA;      BEGIN&#xA;-- PRINT @OU_NUM&#xA;            UPDATE&#xA;                dbo.GI2_LST_INTRVN_INTRL_TMP&#xA;            SET &#xA;                liste_souscatg_intrl = LTRIM(ISNULL(liste_souscatg_intrl, '')&#xA;                                             + ' ' + @cTXT),&#xA;                a = CASE @cASCG&#xA;                      WHEN 'A' THEN 'O'&#xA;                      ELSE a&#xA;                    END,&#xA;                s = CASE @cTXT&#xA;                      WHEN '1.4S' THEN s&#xA;                      WHEN '1.5S' THEN s&#xA;                      WHEN '1.6S' THEN s&#xA;                      WHEN '1.7S' THEN s&#xA;                      ELSE CASE @cASCG&#xA;                             WHEN 'S' THEN 'O'&#xA;                             ELSE s&#xA;                           END&#xA;                    END,&#xA;                c = CASE @cASCG&#xA;                      WHEN 'C' THEN 'O'&#xA;                      ELSE c&#xA;                    END,&#xA;                g = CASE @cTXT&#xA;                      WHEN '1.4G' THEN g&#xA;                      WHEN '1.5G' THEN g&#xA;                      WHEN '1.6G' THEN g&#xA;                      WHEN '1.7G' THEN g&#xA;                      ELSE CASE @cASCG&#xA;                             WHEN 'G' THEN 'O'&#xA;                             ELSE g&#xA;                           END&#xA;                    END&#xA;            WHERE&#xA;                id_drex = @cDREX_ID&#xA;                AND id_intrvn = @cINTRVN_ID&#xA;                AND id_intrl = @cINTRL_ID&#xA;                AND id_sdrex = @cSDREX_ID&#xA;&#xA;            FETCH NEXT FROM @getLstCatg INTO @cDREX_ID, @cINTRVN_ID,&#xA;                  @cINTRL_ID, @cSDREX_ID, @cASCG, @cTXT&#xA;      END&#xA;CLOSE @getLstCatg&#xA;DEALLOCATE @getLstCatg&#xA;&#xA;&#xA;--Remettre le champ nombre et liste à null au lieu de 0 et ''&#xA;--------------------------------------&#xA;UPDATE&#xA;    GI2_LST_INTRVN_INTRL_TMP&#xA;SET &#xA;    nb_souscatg_intrl = NULL,&#xA;    liste_souscatg_intrl = NULL&#xA;WHERE&#xA;    nb_souscatg_intrl = 0&#xA;&#xA;-- Quand une licence à un S et un G (1.4S et 1.4G) mettre C à 'O''&#xA;-------------------------------------- &#xA;UPDATE&#xA;&#x9;GI2_LST_INTRVN_INTRL_TMP&#xA;SET &#xA;&#x9;c = 'O' &#xA;WHERE &#xA;&#x9;   liste_souscatg_intrl LIKE '%1.4S%1.4G%'&#xA;&#x9;OR liste_souscatg_intrl LIKE '%1.5S%1.5G%'&#xA;&#x9;OR liste_souscatg_intrl LIKE '%1.6S%1.6G%'&#xA;&#x9;OR liste_souscatg_intrl LIKE '%1.7S%1.7G%'&#xA;&#x9;OR liste_souscatg_intrl LIKE '%1.4G%1.4S%'&#xA;&#x9;OR liste_souscatg_intrl LIKE '%1.5G%1.5S%'&#xA;&#x9;OR liste_souscatg_intrl LIKE '%1.6G%1.6S%'&#xA;&#x9;OR liste_souscatg_intrl LIKE '%1.7G%1.7S%'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\ENTREPRISES_REPONDANTS_GEN_HQ\GI2_LST_ASCG"
