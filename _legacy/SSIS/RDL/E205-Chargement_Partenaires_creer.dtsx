                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Commande SQL à exécuter."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select distinct
	SUBSTRING(s1.OU_NUM,1,4) + SUBSTRING(s1.OU_NUM,6,4) NO_INTERV,

	'Restriction à la licence 1 an (CCQ)' Description,
	CONVERT(varchar(8),s3.TODO_ACTL_START_DT ,112) DATE_DEBUT,
	CONVERT(varchar(8),s3.TODO_ACTL_END_DT ,112) DATE_FIN,
	s2.RESULT_CODE CONCLUSION
from
	S_ORG_EXT s1

inner join S_EVT_ACT s3
	on s1.ROW_ID = s3.TARGET_OU_ID 

left join CX_WFM_RESULTCD s2
	on s3.X_RESULT_CD_ID = s2.ROW_ID

left join CX_WFM_ACTIONCD s4
	on s4.ROW_ID = s3.X_ACTION_CD_ID 

where 
	s4.ACTION_CODE = 'Restriction à la licence 1 an (CCQ)'</property>
