            <ScriptProject
              Name="ScriptTask_038b0df956514c9e8b8a5906fcaa92a4"
              VSTAMajorVersion="17"
              VSTAMinorVersion="0"
              Language="VisualBasic"
              ReadOnlyVariables="SAVEPATH,SAVEPATH_CD,FILENAME_EVENEMENT,CONN_STRING_GIC01">
              <ProjectItem
                Name="ScriptMain.vb"
                Encoding="UTF8"><![CDATA[' Microsoft SQL Server Integration Services Script Task
' Write scripts using Microsoft Visual Basic
' The ScriptMain class is the entry point of the Script Task.

Imports System
Imports System.Data
Imports System.Math
Imports Microsoft.SqlServer.Dts.Runtime
Imports System.IO
Imports System.Data.OleDb
Imports System.Data.OleDb.OleDbCommand



<Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute> _
<System.CLSCompliantAttribute(False)> _
Partial Public Class ScriptMain
	Inherits Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase

	Enum ScriptResults
		Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success
		Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
	End Enum

    ' The execution engine calls this method when the task executes.
    ' To access the object model, use the Dts object. Connections, variables, events,
    ' and logging features are available as static members of the Dts class.
    ' Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
    ' 
    ' To open Code and Text Editor Help, press F1.
    ' To open Object Browser, press Ctrl+Alt+J.

    Public Sub Main()
        '
        ' Fonction permettant de créer un ligne de contrôle pour un fichier.
        ' Le répertoire et le nom de fichier sont contenu dans des variables SSIS.
        '
        Dim pointeur As Integer
        Dim sPath As String
        Dim sCompteur As String

        ' Nom du chemin avec le nom du fichier.
        sPath = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_CD").Value) + System.Convert.ToString(Dts.Variables("FILENAME_EVENEMENT").Value)

        '
        ' Ouverture de la connexion OLEDB selon la "connection string" de la variable SSIS.
        '
        Dim oOleDbConnection As OleDbConnection
        Dim sConnString As String = System.Convert.ToString(Dts.Variables("CONN_STRING_GIC01").Value)
        oOleDbConnection = New OleDb.OleDbConnection(sConnString)
        oOleDbConnection.Open()

        '
        ' Appel de la commande SQL avec la connexion OLEDB.
        ' permet d'avoir un compteur du nombre d'enregistrement.
        '
        Dim sqlComm As OleDbCommand = New OleDbCommand("select count(*) cnt from GI2_EVENCD", oOleDbConnection)

        Dim dr As OleDbDataReader = sqlComm.ExecuteReader()
        While dr.Read()
            sCompteur = dr.GetInt32(0).ToString
        End While

        dr.Close()
        oOleDbConnection.Close()

        '
        ' Écriture de la ligne de contrôle dans le fichier.
        ' Cette ligne doit avoir le format DATETIME|NB_ENREGISTREMENT.
        '

        Try
            Using sw As StreamWriter = File.CreateText(sPath)
                sw.WriteLine(Format(System.DateTime.Now, "yyyy-MM-dd HH:mm:ss") + "|" + sCompteur)
                sw.Close()
            End Using

        Catch e As Exception
            Console.WriteLine("Erreur: Création de la ligne de contrôle.", e.ToString())
            ' Résultat retourné pour SSIS = ÉCHEC.
            Dts.TaskResult = ScriptResults.Failure
        End Try

        ' Résultat retourné pour SSIS = SUCCÈS.
        Dts.TaskResult = ScriptResults.Success
    End Sub

End Class]]></ProjectItem>
