                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">-- Selection de tous les licences ayant des compétences utilisées
-- par un interlocuteur.
------------------
select DISTINCT
        s2.OU_NUM NO_INTERV,
        s2.X_NEQ NEQ,
        STAT_JUR.[VAL] STAT_JUR,
        s2.NAME NOM,
        s6.X_AUTRE_NOM ATR_NOM,
        s4.ADDR_LINE_2 ADR_LIGNE1,
        s4.ADDR_LINE_4 ADR_LIGNE2,
        s4.ADDR_LINE_5 ADR_LIGNE3,
        s4.ADDR_NUM NO_CIVIQ,
        s4.X_ARTERE TYP_ARTR,
        s4.ADDR RUE,
        s4.ADDR_LINE_3 APT,
        s4.ZIPCODE COD_POST,
        s4.STATE PROV,
        s4.X_CODE_MUNICIPALITE CPMUNIC,
        s4.CITY MUNIC,
        s4.X_CODE_REGION_ADM COD_REG_ADM,
        REG_ADM.DESC_TEXT X_REGION_ADMIN,
        s4.X_CODE_MRC COD_MRC,
        MRC.DESC_TEXT MRC,
        s2.MAIN_PH_NUM NO_TEL,
        s2.MAIN_FAX_PH_NUM NO_FAX,
        s2.MAIN_EMAIL_ADDR COURRIEL,
        CASE OU_TYPE_CD
          WHEN 'Personne physique' THEN CASE X_CONSENTEMENT_TEL_FLG
                                          when 'Y' then s2.MAIN_PH_NUM
                                          else NULL
                                        END
          ELSE s2.MAIN_PH_NUM
        END NO_TEL_CCQ,
        CASE OU_TYPE_CD
          WHEN 'Personne physique' THEN CASE X_CONSENTEMENT_COURRIEL_FLG
                                          when 'Y' then s2.MAIN_EMAIL_ADDR
                                          else NULL
                                        END
          ELSE s2.MAIN_EMAIL_ADDR
        END COURRIEL_CCQ,
        CASE s5.ATTRIB_50
          when 'Entrepreneur' then 'E'
          when 'Constructeur-proprietaire' then 'CP'
          ELSE NULL
        END TYPE_INTRVT,
        s1.X_AGREE_NUM_RBQ NO_LIC,
        case s1.X_CATEGORIE
          when 'Generale et specialisee' then 'GS'
          when 'Specialisee' then 'S'
          when 'Generale' then 'G'
          else null
        end CATG_LIC,
        CASE WHEN s7.EFF_START_DT IS NOT null THEN s7.ENTLMNT_NUM
             ELSE NULL
        END ENTLMNT_NUM,
        s7.EFF_START_DT DT_ENTREE_VIG,
        CASE
            WHEN s7.X_STATUS = 'Actif' THEN
                s1.DUE_DT
            ELSE
                NULL
        END 
        DT_FIN_ANN,
        s7.EFF_END_DT DT_FIN_LIC,
        CASE 

                                   WHEN s7.X_RESTRICTION = 'Restriction 1 an' OR s7.X_RESTRICTION = 'Restriction 2 ans' OR s7.X_RESTRICTION = 'Restriction Regie' THEN replace(convert(varchar, s7.EFF_START_DT, 111), '/', '') + ' ' + replace(convert(varchar, s7.X_GI_D_FIN_REST_SUIV, 111), '/', '')

                                   ELSE NULL

                        END X_RESTRICTION,
        --s7.X_TXT_RESTRICT X_RESTRICTION,
        NULL CATG,
        0 NB_CATG,
        s12.PERSON_UID NO_INTRL,
        s12.LAST_NAME INOM,
        s12.FST_NAME IPRENOM,
        s12.BIRTH_DT DT_NAISSANCE,
        s14.ADDR_LINE_2 IADR_LIGNE1,
        s14.ADDR_LINE_4 IADR_LIGNE2,
        s14.ADDR_LINE_5 IADR_LIGNE3,
        s14.ADDR_NUM INO_CIVIQ,
        s14.X_ARTERE ITYP_ARTR,
        s14.ADDR IRUE,
        s14.ADDR_LINE_3 IAPT,
        s14.ZIPCODE ICOD_POST,
        s14.STATE IPROV,
        s14.X_CODE_MUNICIPALITE ICPMUNIC,
        s14.CITY IMUNIC,
        s14.X_CODE_REGION_ADM ICOD_REG_ADM,
        REG_ADM2.DESC_TEXT I_REGADMIN,
        s14.X_CODE_MRC ICOD_MRC,
        MRC2.DESC_TEXT IMRC,
        0 NB_SC_INTRL,
        'N' a,
        'N' s,
        'N' c,
        'N' g,
        '' LIST_CATG_INTRL,
        s2.ROW_ID id_intrvn,
        s1.ROW_ID id_drex,
        s12.ROW_ID id_intrl,
        s7.ROW_ID id_sdrex,
        CASE OU_TYPE_CD
          WHEN 'Personne physique' THEN CASE X_CONSENTEMENT_TEL_FLG
                                          WHEN 'Y' THEN s2.X_CELLULAIRE
                                          ELSE NULL
                                        END
          ELSE s2.X_CELLULAIRE
        END cellullaire_ccq,
        s1.APPR_DT date_emis,
        '' liste_fonction_rep,
REPLACE(CONVERT(Varchar(10), s7.X_GI_D_FIN_REST_SUIV , 120), '-', '') GI_D_FIN_REST,
s7.X_RAISON_FIN GI_C_RAIS_FIN,
s7.X_GI_C_SOUS_RAIS_FIN GI_DE_MOTF,          
s7.X_RESTRICTION  XX_RESTRICTION  
from    
--DROITS EXERCICES
        S_DOC_AGREE s1 
--INTERVENANTS
        inner join S_ORG_EXT s2 on s2.ROW_ID = s1.TARGET_OU_ID
                                   and ACCNT_FLG = 'Y'

--DOMAINES
        left join S_ORG_EXT_XM s5 on s5.PAR_ROW_ID = s2.ROW_ID
                                     and s5.TYPE = 'Type_Intervenant'

--LIEN INTERVENANT-ADRESSES
        left outer join S_CON_ADDR s3 on s3.ACCNT_ID = s2.ROW_ID
                                          and s3.ADDR_TYPE_CD = 'Principale'
                                          AND ( ( GETDATE() &gt; s3.[START_DT]
                                                  AND GETDATE() &lt; s3.[END_DT]
                                                )
                                                OR ( GETDATE() &gt; s3.[START_DT]
                                                     AND s3.[END_DT] IS NULL
                                                   )
                                              )

--ADRESSES INTERVENANTS
        left outer join S_ADDR_PER s4 on s4.ROW_ID = s3.ADDR_PER_ID

--AUTRES NOMS
        left outer join S_ORG_SYN s6 --	on s6.OU_ID = s2.ROW_ID
        on s2.PR_SYN_ID = s6.ROW_ID
           and X_TYPE_NOM = 'Raison sociale'
           and X_DATE_FIN is null

--SUIVI DROIT EXERCICE
        inner join S_ENTLMNT s7 on s7.PAR_AGREE_ID = s1.ROW_ID
       

--HABILITATION_ACCORDÉS
        inner join S_ENTLMNT_ITEM s8 on s8.DOC_AGREE_ID = s7.ROW_ID
            AND s8.X_STATUS_CD IN ('Active', 'Partielle')

--COMPETENCE UTILISE
        inner join CX_COMPET_UTIL s10 on s8.ROW_ID = s10.HABIL_ACCORD_ID
            AND s10.X_RESULTAT = '03'

--COMPETENCE 
        inner join S_PROD_CON s11 on s11.ROW_ID = s10.COMPET_ID

--SOUS_CATG, PRODUITS
        inner join S_PROD_INT s9 on s9.ROW_ID = s11.PROD_ID

--INTERLOCUTEUR
        inner join S_CONTACT s12 on s12.ROW_ID = s11.CONTACT_ID

--LIEN_INTERLOCUTEUR
        left outer join S_CON_ADDR s13 on s12.ROW_ID = s13.CONTACT_ID
                                          and s13.ADDR_TYPE_CD = 'Principale'
                                          AND ( ( GETDATE() &gt; s13.[START_DT]
                                                  AND GETDATE() &lt; s13.[END_DT]
                                                )
                                                OR ( GETDATE() &gt; s13.[START_DT]
                                                     AND s13.[END_DT] IS NULL
                                                   )
                                              )


--ADRESSES INTERVENANTS
        left outer join S_ADDR_PER s14 on s14.ROW_ID = s13.ADDR_PER_ID

--LOV STAT JURIDIQUE
        LEFT OUTER JOIN [S_LST_OF_VAL] STAT_JUR ON STAT_JUR.[LANG_ID] = 'FRA'
                                                   AND STAT_JUR.[TYPE] = 'ACCOUNT_TYPE'
                                                   AND STAT_JUR.[NAME] = s2.OU_TYPE_CD
                                                   
--LOV Région administrative
		LEFT JOIN S_LST_OF_VAL REG_ADM ON REG_ADM.[LANG_ID] = 'FRA'
                                          AND REG_ADM.[TYPE] = 'RBQ_REGION_ADMIN'
                                          AND REG_ADM.[NAME] = s4.X_CODE_REGION_ADM
	    LEFT JOIN S_LST_OF_VAL REG_ADM2 ON REG_ADM2.[LANG_ID] = 'FRA'
                                          AND REG_ADM2.[TYPE] = 'RBQ_REGION_ADMIN'
                                          AND REG_ADM2.[NAME] = s14.X_CODE_REGION_ADM
                                          
--LOV MRC
		LEFT JOIN S_LST_OF_VAL MRC ON MRC.[LANG_ID] = 'FRA'
                                      AND MRC.[TYPE] = 'RBQ_MRC'
                                      AND MRC.[NAME] = s4.X_CODE_MRC
		LEFT JOIN S_LST_OF_VAL MRC2 ON MRC2.[LANG_ID] = 'FRA'
                                      AND MRC2.[TYPE] = 'RBQ_MRC'
                                      AND MRC2.[NAME] = s14.X_CODE_MRC
                                      
where   s5.ATTRIB_50 = s1.AGREE_CD</property>
