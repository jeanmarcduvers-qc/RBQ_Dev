	substring(s1.OU_NUM,1,4) + substring(s1.OU_NUM,6,4) NO_INTERV,
	'74' CODE_EVEN,
	'Entreprise résultante d''une fusion' Description,
	CONVERT(varchar(8),s2.CREATED,112) DATE,
	null CONCLUSION
from
	S_ORG_EXT s1
inner join S_NOTE_ACCNT s2
	on s1.ROW_ID = s2.SRC_ROW_ID
where 
	s2.SUB_AREA_CD = 'Entreprise resultante fusion'

union all
select 
	s1.PERSON_UID NO_INTERV,
	'74' CODE_EVEN,
	'Entreprise résultante d''une fusion' Description,
	CONVERT(varchar(8),s2.CREATED,112) DATE,
	null CONCLUSION
from
	S_CONTACT s1
inner join S_NOTE_CON  s2
	on s1.ROW_ID = s2.SRC_ROW_ID
where 
	s2.X_AREA_CD = 'Entreprise resultante fusion'</property>
