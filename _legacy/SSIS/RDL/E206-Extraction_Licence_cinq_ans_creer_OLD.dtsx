          Name="ScriptTask_4329f4c9b5f64cdcb64db60d9fb42d40"
          VSTAMajorVersion="17"
          VSTAMinorVersion="0"
          Language="VisualBasic"
          ReadOnlyVariables="CONN_STRING_GIC01,SAVEPATH,SAVEPATH_LIC5,FILEPATH_ATRNOM,FILEPATH_DESC_S_CATG,FILEPATH_DIRIGEANT,FILEPATH_EVEN,FILEPATH_INTRL,FILEPATH_INTRVN,FILEPATH_INTRVN_LIC,FILEPATH_LIEN_ADDR,FILEPATH_TYPE_INTRVN">
          <ProjectItem
            Name="ScriptMain.vb"
            Encoding="UTF8"><![CDATA[' Microsoft SQL Server Integration Services Script Task
' Write scripts using Microsoft Visual Basic
' The ScriptMain class is the entry point of the Script Task.

Imports System
Imports System.Data
Imports System.Math
Imports Microsoft.SqlServer.Dts.Runtime
Imports System.IO
Imports System.Data.OleDb
Imports System.Data.OleDb.OleDbCommand


<Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute> _
<System.CLSCompliantAttribute(False)> _
Partial Public Class ScriptMain
	Inherits Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase

	Enum ScriptResults
		Success = DTSExecResult.Success
		Failure = DTSExecResult.Failure
	End Enum

	' The execution engine calls this method when the task executes.
	' To access the object model, use the Dts object. Connections, variables, events,
	' and logging features are available as static members of the Dts class.
	' Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
	' 
	' To open Code and Text Editor Help, press F1.
	' To open Object Browser, press Ctrl+Alt+J.

	Public Sub Main()

        Dim pointeur As Integer
        Dim sPath(9) As String
        Dim sCompteur(9) As String

        '
        ' Chargement de tous les noms de dossier complet plus le nom des fichiers 
        ' pour les licences 5 ans dans la variable sPath à partir des variables SSIS.
        '
        sPath(0) = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_LIC5").Value) + System.Convert.ToString(Dts.Variables("FILEPATH_ATRNOM").Value)
        sPath(1) = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_LIC5").Value) + System.Convert.ToString(Dts.Variables("FILEPATH_DESC_S_CATG").Value)
        sPath(2) = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_LIC5").Value) + System.Convert.ToString(Dts.Variables("FILEPATH_DIRIGEANT").Value)
        sPath(3) = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_LIC5").Value) + System.Convert.ToString(Dts.Variables("FILEPATH_EVEN").Value)
        sPath(4) = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_LIC5").Value) + System.Convert.ToString(Dts.Variables("FILEPATH_INTRL").Value)
        sPath(5) = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_LIC5").Value) + System.Convert.ToString(Dts.Variables("FILEPATH_INTRVN").Value)
        sPath(6) = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_LIC5").Value) + System.Convert.ToString(Dts.Variables("FILEPATH_INTRVN_LIC").Value)
        sPath(7) = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_LIC5").Value) + System.Convert.ToString(Dts.Variables("FILEPATH_LIEN_ADDR").Value)
        sPath(8) = System.Convert.ToString(Dts.Variables("SAVEPATH").Value) + System.Convert.ToString(Dts.Variables("SAVEPATH_LIC5").Value) + System.Convert.ToString(Dts.Variables("FILEPATH_TYPE_INTRVN").Value)

        '
        ' Appel OLE DB pour avoir le nombre de lignes dans le fichier.
        '
        Dim oOleDbConnection As OleDbConnection
        Dim sConnString As String = System.Convert.ToString(Dts.Variables("CONN_STRING_GIC01").Value)
        oOleDbConnection = New OleDb.OleDbConnection(sConnString)
        oOleDbConnection.Open()


        Dim sqlComm(9) As OleDbCommand
        Dim dr As OleDbDataReader

        '
        ' Chargement des commandes SQL pour avoir les compteurs dans la ligne de contrôle.
        '
        sqlComm(0) = New OleDbCommand("select count(*) cnt from GI2_LIC5_INTRVN_ATR_NOM", oOleDbConnection)
        sqlComm(1) = New OleDbCommand("select count(*) cnt from GI2_LIC5_PRODUIT", oOleDbConnection)
        sqlComm(2) = New OleDbCommand("select count(*) cnt from GI2_LIC5_LIC_INTRVN_SOUS_CATG", oOleDbConnection)
        sqlComm(3) = New OleDbCommand("select count(*) cnt from GI2_LIC5_EVEN", oOleDbConnection)
        sqlComm(4) = New OleDbCommand("select count(*) cnt from GI2_LIC5_INTERLOCUTEUR", oOleDbConnection)
        sqlComm(5) = New OleDbCommand("select count(*) cnt from GI2_LIC5_INTERVENANT", oOleDbConnection)
        sqlComm(6) = New OleDbCommand("select count(*) cnt from GI2_LIC5_LIC_INTRVN", oOleDbConnection)
        sqlComm(7) = New OleDbCommand("select count(*) cnt from GI2_LIC5_INTERVN_INTRL_ADDR", oOleDbConnection)
        sqlComm(8) = New OleDbCommand("select count(*) cnt from GI2_LIC5_TYPE_INTRVN", oOleDbConnection)

        '
        ' Exécution des commandes SQL
        '
        For pointeur = 0 To 8 Step 1
            dr = sqlComm(pointeur).ExecuteReader()
            While dr.Read()
                sCompteur(pointeur) = dr.GetInt32(0).ToString
            End While
        Next

        '
        ' Fermeture de la connexion OLE DB et du dataReader
        '
        dr.Close()
        oOleDbConnection.Close()

        '
        ' Écriture de la ligne de contrôle dans le fichier. 
        ' Date courante + nombre de ligne ramèné par les requêtes SQL.
        '
        For pointeur = 0 To 8 Step 1
            'Instructions
            Try

                Using sw As StreamWriter = File.CreateText(sPath(pointeur))
                    sw.WriteLine(Format(System.DateTime.Now, "yyyy-MM-dd HH:mm:ss") + "|" + sCompteur(pointeur))
                    sw.Close()
                End Using

            Catch e As Exception
                Console.WriteLine("Création de la ligne de contrôle en erreur.", e.ToString())
                '
                ' Résultat de la fonction pour SSIS : ERREUR
                '
                Dts.TaskResult = ScriptResults.Failure
            End Try
        Next

        '
        ' Résultat de la fonction pour SSIS : RÉUSSITE
        '
        Dts.TaskResult = ScriptResults.Success

	End Sub

End Class]]></ProjectItem>
