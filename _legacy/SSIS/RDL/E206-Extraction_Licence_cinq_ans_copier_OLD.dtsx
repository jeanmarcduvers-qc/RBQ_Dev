          <ProjectItem
            Name="ScriptMain.vb"
            Encoding="UTF8"><![CDATA[Imports System
Imports System.Data
Imports System.Math
Imports Microsoft.SqlServer.Dts.Runtime
Imports System.IO
Imports Microsoft.VisualBasic

<Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute> _
<System.CLSCompliantAttribute(False)> _
Partial Public Class ScriptMain
	Inherits Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase

	Enum ScriptResults
		Success = DTSExecResult.Success
		Failure = DTSExecResult.Failure
	End Enum

    Public Sub Main()
        ' Spécifier le répertoire à créer

        Dim savePath As String
        Dim di As DirectoryInfo

        savePath = System.Convert.ToString(Dts.Variables("destPath").Value)

        'Instructions
        Try
            ' Determine si le répertoire existe
            If Directory.Exists(savePath) Then
                ' Le répertoire existe, rien à faire.
                Directory.Delete(savePath)
                Directory.CreateDirectory(savePath)
                Return
            End If

            ' Crée le repertoire.
            Directory.CreateDirectory(savePath)

        Catch e As Exception
            Console.WriteLine("Erreur: Création de répertoire.", e.ToString())
            Dts.TaskResult = ScriptResults.Failure
        End Try
        Dts.TaskResult = ScriptResults.Success
    End Sub
End Class]]></ProjectItem>
