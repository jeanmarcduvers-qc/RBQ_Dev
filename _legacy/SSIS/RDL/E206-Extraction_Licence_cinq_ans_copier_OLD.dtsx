              <ProjectItem
                Name="ScriptMain.vb"
                Encoding="UTF8"><![CDATA[Imports System
Imports System.Data
Imports System.Math
Imports Microsoft.SqlServer.Dts.Runtime
Imports System.IO
Imports Microsoft.VisualBasic

<Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute> _
<System.CLSCompliantAttribute(False)> _
Partial Public Class ScriptMain
	Inherits Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase

	Enum ScriptResults
		Success = DTSExecResult.Success
		Failure = DTSExecResult.Failure
	End Enum

    Sub CopyDirectory(ByVal SourcePath As String, ByVal DestPath As String, Optional ByVal Overwrite As Boolean = False)
        Dim SourceDir As DirectoryInfo = New DirectoryInfo(SourcePath)
        Dim DestDir As DirectoryInfo = New DirectoryInfo(DestPath)

        ' the source directory must exist, otherwise throw an exception
        If SourceDir.Exists Then
            ' if destination SubDir's parent SubDir does not exist throw an exception
            If Not DestDir.Parent.Exists Then
                Throw New DirectoryNotFoundException _
                    ("Destination directory does not exist: " + DestDir.Parent.FullName)
            End If

            If Not DestDir.Exists Then
                DestDir.Create()
            End If

            ' copy all the files of the current directory
            Dim ChildFile As FileInfo
            For Each ChildFile In SourceDir.GetFiles()
                If Overwrite Then
                    ChildFile.CopyTo(Path.Combine(DestDir.FullName, ChildFile.Name), True)
                Else
                    ' if Overwrite = false, copy the file only if it does not exist
                    ' this is done to avoid an IOException if a file already exists
                    ' this way the other files can be copied anyway...
                    If Not File.Exists(Path.Combine(DestDir.FullName, ChildFile.Name)) Then
                        ChildFile.CopyTo(Path.Combine(DestDir.FullName, ChildFile.Name), False)
                    End If
                End If
            Next

            ' copy all the sub-directories by recursively calling this same routine
            Dim SubDir As DirectoryInfo
            For Each SubDir In SourceDir.GetDirectories()
                CopyDirectory(SubDir.FullName, Path.Combine(DestDir.FullName, _
                    SubDir.Name), Overwrite)
            Next
        Else
            Throw New DirectoryNotFoundException("Source directory does not exist: " + SourceDir.FullName)
        End If
    End Sub



    Public Sub Main()
        ' Spécifier le répertoire à créer

        Dim destPath As String
        Dim sourcePath As String

        Dim systemPath(1) As String
        systemPath(0) = "LIC5"

        Dim copyFile(1) As String
        copyFile(0) = System.Convert.ToString(Dts.Variables("GI_V_LIC5").Value)



        destPath = System.Convert.ToString(Dts.Variables("destPath").Value)
        sourcePath = System.Convert.ToString(Dts.Variables("sourcePath").Value)

        Dim userName As String = System.Convert.ToString(Dts.Variables("GI_C_PARTN").Value)

        Dim di As DirectoryInfo
        'Instructions
        Try
            Dim i As Integer = 0

            If Directory.Exists(sourcePath + systemPath(i)) Then
                If copyFile(i) = "Y" Then
                    Directory.CreateDirectory(destPath + userName + "\" + systemPath(i))
                    CopyDirectory(sourcePath + systemPath(i), destPath + userName + "\" + systemPath(i), True)
                End If
            End If

        Catch e As Exception
            Console.WriteLine("Erreur: Création de répertoire.", e.ToString())
            Dts.TaskResult = ScriptResults.Failure
        End Try
        Dts.TaskResult = ScriptResults.Success
    End Sub
End Class]]></ProjectItem>
