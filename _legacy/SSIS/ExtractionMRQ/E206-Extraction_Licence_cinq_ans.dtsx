			WHEN T1.X_CERTIFICAT_DT &lt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.X_CERTIFICAT_DT) - 2007), '2007-04-01 07:00:00.000') OR
			T1.X_CERTIFICAT_DT &gt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.X_CERTIFICAT_DT) - 2007), '2007-10-28 06:00:00.000')
			THEN
			DATEADD(hh, -5, T1.X_CERTIFICAT_DT)
			ELSE
			DATEADD(hh, -4, T1.X_CERTIFICAT_DT)
		END
		ELSE
