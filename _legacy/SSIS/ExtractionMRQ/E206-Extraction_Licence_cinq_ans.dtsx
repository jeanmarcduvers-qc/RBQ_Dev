			T1.X_CERTIFICAT_DT_2 &gt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.X_CERTIFICAT_DT_2) - 2007), '2007-11-04 06:00:00.000')
			THEN
			DATEADD(hh, -5, T1.X_CERTIFICAT_DT_2)
			ELSE
			DATEADD(hh, -4, T1.X_CERTIFICAT_DT_2)
		END
