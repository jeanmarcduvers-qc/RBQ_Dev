                <component
                  refId="Package\Conteneur de séquences\Hiérarchie des relations - S_PARTY_REL\S_PARTY_REL"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                  description="Source OLE DB"
                  name="S_PARTY_REL"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Commande SQL à exécuter."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SET LANGUAGE ENGLISH;

SELECT
	A.DB_LAST_UPD_SRC,
	CASE
		WHEN A.END_DT &lt; '2007-03-11 07:00:00.000' THEN
		CASE
			WHEN A.END_DT &lt; DATEADD(ww, -52 * ABS(DATEPART(yy, A.END_DT) - 2007), '2007-04-01 07:00:00.000') OR
			A.END_DT &gt;= DATEADD(ww, -52 * ABS(DATEPART(yy, A.END_DT) - 2007), '2007-10-28 06:00:00.000')
			THEN
			DATEADD(hh, -5, A.END_DT)
			ELSE
			DATEADD(hh, -4, A.END_DT)
		END
		ELSE
		CASE
			WHEN A.END_DT &lt; DATEADD(ww, 52 * ABS(DATEPART(yy, A.END_DT) - 2007), '2007-03-11 07:00:00.000') OR
			A.END_DT &gt;= DATEADD(ww, 52 * ABS(DATEPART(yy, A.END_DT) - 2007), '2007-11-04 06:00:00.000')
			THEN
			DATEADD(hh, -5, A.END_DT)
			ELSE
			DATEADD(hh, -4, A.END_DT)
		END
	END AS [A.END_DT],
	CASE
		WHEN A.LAST_UPD &lt; '2007-03-11 07:00:00.000' THEN
		CASE
			WHEN A.LAST_UPD &lt; DATEADD(ww, -52 * ABS(DATEPART(yy, A.LAST_UPD) - 2007), '2007-04-01 07:00:00.000') OR
			A.LAST_UPD &gt;= DATEADD(ww, -52 * ABS(DATEPART(yy, A.LAST_UPD) - 2007), '2007-10-28 06:00:00.000')
			THEN
			DATEADD(hh, -5, A.LAST_UPD)
			ELSE
			DATEADD(hh, -4, A.LAST_UPD)
		END
		ELSE
		CASE
			WHEN A.LAST_UPD &lt; DATEADD(ww, 52 * ABS(DATEPART(yy, A.LAST_UPD) - 2007), '2007-03-11 07:00:00.000') OR
			A.LAST_UPD &gt;= DATEADD(ww, 52 * ABS(DATEPART(yy, A.LAST_UPD) - 2007), '2007-11-04 06:00:00.000')
			THEN
			DATEADD(hh, -5, A.LAST_UPD)
			ELSE
			DATEADD(hh, -4, A.LAST_UPD)
		END
	END AS [A.LAST_UPD],
	A.MODIFICATION_NUM,
	A.PARTY_ID,
	A.PERCENT_OWNED,
	A.REL_PARTY_ID,
	A.REL_TYPE_CD,
	B.PARTY_TYPE_CD,
	CASE
		WHEN A.START_DT &lt; '2007-03-11 07:00:00.000' THEN
		CASE
			WHEN A.START_DT &lt; DATEADD(ww, -52 * ABS(DATEPART(yy, A.START_DT) - 2007), '2007-04-01 07:00:00.000') OR
			A.START_DT &gt;= DATEADD(ww, -52 * ABS(DATEPART(yy, A.START_DT) - 2007), '2007-10-28 06:00:00.000')
			THEN
			DATEADD(hh, -5, A.START_DT)
			ELSE
			DATEADD(hh, -4, A.START_DT)
		END
		ELSE
		CASE
			WHEN A.START_DT &lt; DATEADD(ww, 52 * ABS(DATEPART(yy, A.START_DT) - 2007), '2007-03-11 07:00:00.000') OR
			A.START_DT &gt;= DATEADD(ww, 52 * ABS(DATEPART(yy, A.START_DT) - 2007), '2007-11-04 06:00:00.000')
			THEN
			DATEADD(hh, -5, A.START_DT)
			ELSE
			DATEADD(hh, -4, A.START_DT)
		END
	END AS [A.START_DT],
	A.X_FONTION_CD,
	A.X_RAISON_FIN,
	A.X_TELEPHONE

FROM S_PARTY_REL A
INNER JOIN S_PARTY B ON A.REL_PARTY_ID = B.ROW_ID
INNER JOIN S_ORG_EXT C ON A.PARTY_ID = C.ROW_ID
WHERE 
	C.OU_NUM NOT IN (
		 '5580-9560'
		,'5580-9651'
		,'5580-9503'
		,'5580-9529'
		,'5580-9610'
		,'5580-9545'
		,'5580-9636'
		,'5581-9908'
		,'5754-4801'
		,'5582-2464'
		,'5754-0262'
		,'5674-9153'
		,'5712-6112'
		,'5841-8443'
	)</property>
                    <property
                      dataType="System.String"
                      description="Variable contenant la commande SQL à exécuter."
                      name="SqlCommandVariable"></property>
                    <property
                      dataType="System.Int32"
                      description="Spécifie la page de codes de la colonne à utiliser lorsque les informations de page de codes ne sont pas disponibles à partir de la source de données."
                      name="DefaultCodePage">1252</property>
                    <property
                      dataType="System.Boolean"
                      description="Force l'utilisation de la valeur de propriété DefaultCodePage lors de la description des données de caractères."
