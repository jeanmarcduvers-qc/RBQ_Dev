                <component
                  refId="Package\Conteneur de séquences\Intervenants - S_ORG_EXT\S_ORG_EXT"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                  description="Source OLE DB"
                  name="S_ORG_EXT"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowset">[dbo].[S_ORG_EXT]</property>
                    <property
                      dataType="System.String"
                      description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Commande SQL à exécuter."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SET LANGUAGE ENGLISH;

SELECT 
	ROW_ID,
	ACCNT_FLG,
	CUST_END_DT,
	CUST_STAT_CD,
	DB_LAST_UPD_SRC,
	CASE
		WHEN LAST_UPD &lt; '2007-03-11 07:00:00.000' THEN
		CASE
			WHEN LAST_UPD &lt; DATEADD(ww, -52 * ABS(DATEPART(yy, LAST_UPD) - 2007), '2007-04-01 07:00:00.000') OR
			LAST_UPD &gt;= DATEADD(ww, -52 * ABS(DATEPART(yy, LAST_UPD) - 2007), '2007-10-28 06:00:00.000')
			THEN
			DATEADD(hh, -5, LAST_UPD)
			ELSE
			DATEADD(hh, -4, LAST_UPD)
		END
		ELSE
		CASE
			WHEN LAST_UPD &lt; DATEADD(ww, 52 * ABS(DATEPART(yy, LAST_UPD) - 2007), '2007-03-11 07:00:00.000') OR
			LAST_UPD &gt;= DATEADD(ww, 52 * ABS(DATEPART(yy, LAST_UPD) - 2007), '2007-11-04 06:00:00.000')
			THEN
			DATEADD(hh, -5, LAST_UPD)
			ELSE
			DATEADD(hh, -4, LAST_UPD)
		END
	END AS [LAST_UPD],
	MAIN_EMAIL_ADDR,
	MAIN_FAX_PH_NUM,
	MAIN_PH_NUM,
	MODIFICATION_NUM,
	NAME,
	OU_NUM,
	OU_TYPE_CD,
	PAR_OU_ID,
	PR_ADDR_ID,
	PR_POSTN_ID,
	PR_SYN_ID,
	REFERENCE_CUST_FLG,
	X_ALERTE_HABIL_FLG,
	X_ARTICLE59_FLG,
	X_BLOCAGE_FLG,
	X_CELLULAIRE,
	X_CONSORTIUM_FLG,
	X_COP_FLG,
	X_DATE_CREATION,
	X_DOMAINE_AL_FLG,
	X_DOMAINE_AP_FLG,
	X_DOMAINE_BA_FLG,
	X_DOMAINE_EL_FLG,
	X_DOMAINE_GA_FLG,
	X_DOMAINE_PB_FLG,
	X_ENTENTE_HORS,
	X_ENTREPRENEUR_FLG,
	X_NEQ,
	X_OU_NUM_RBQ,
	X_PHONE_EXTENSION,
	X_PROFIL,
	X_PR_DOMAINE_ID,
	X_PR_TYPE_ID,
	X_REDEVANCE_ANNUELLE,
	X_SYNDIC_FAILLITE_FLG
FROM S_ORG_EXT
WHERE (INT_ORG_FLG &lt;&gt; 'Y' OR PRTNR_FLG &lt;&gt; 'N') 
	AND ACCNT_FLG &lt;&gt; 'N'
-- Exclusion des cas d'essais et en erreur
	AND OU_NUM NOT IN (
		 '5580-9560'
		,'5580-9651'
		,'5580-9503'
		,'5580-9529'
		,'5580-9610'
		,'5580-9545'
		,'5580-9636'
		,'5581-9908'
		,'5754-4801'
		,'5582-2464'
		,'5754-0262'
		,'5674-9153'
		,'5712-6112'
		,'5841-8443'
	)</property>
