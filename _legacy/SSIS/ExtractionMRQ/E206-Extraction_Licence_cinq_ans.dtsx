                <component
                  refId="Package\Conteneur de séquences\Interlocuteurs - S_CONTACT\S_CONTACT"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                  description="Source OLE DB"
                  name="S_CONTACT"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Commande SQL à exécuter."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SET LANGUAGE ENGLISH;

SELECT
	ROW_ID,
	BIRTH_DT,
	CELL_PH_NUM,
	CUST_END_DT,
	CUST_STAT_CD,
	DB_LAST_UPD_SRC,
	EMAIL_ADDR,
	FAX_PH_NUM,
	FST_NAME,
	HOME_PH_NUM,
	INTEGRATION_ID,
	LAST_NAME,
	LAST_UPD,
	MODIFICATION_NUM,
	PAR_ROW_ID,
	PERSON_UID,
	PER_TITLE,
	PR_PER_ADDR_ID,
	X_COMP_ELEC_FLG,
	X_DATE_CREATION_ADM,
	X_DATE_TRICHERIE,
	X_DISTRIB_BY,
	CASE
		WHEN X_DISTRIB_DATE &lt; '2007-03-11 07:00:00.000' THEN
		CASE
			WHEN X_DISTRIB_DATE &lt; DATEADD(ww, -52 * ABS(DATEPART(yy, X_DISTRIB_DATE) - 2007), '2007-04-01 07:00:00.000') OR
			X_DISTRIB_DATE &gt;= DATEADD(ww, -52 * ABS(DATEPART(yy, X_DISTRIB_DATE) - 2007), '2007-10-28 06:00:00.000')
			THEN
			DATEADD(hh, -5, X_DISTRIB_DATE)
			ELSE
			DATEADD(hh, -4, X_DISTRIB_DATE)
		END
		ELSE
		CASE
			WHEN X_DISTRIB_DATE &lt; DATEADD(ww, 52 * ABS(DATEPART(yy, X_DISTRIB_DATE) - 2007), '2007-03-11 07:00:00.000') OR
			X_DISTRIB_DATE &gt;= DATEADD(ww, 52 * ABS(DATEPART(yy, X_DISTRIB_DATE) - 2007), '2007-11-04 06:00:00.000')
			THEN
			DATEADD(hh, -5, X_DISTRIB_DATE)
			ELSE
			DATEADD(hh, -4, X_DISTRIB_DATE)
		END
	END AS [X_DISTRIB_DATE],
	X_FLG_TRICHERIE,
	X_INACTIVATION,
	X_PERSON_UID_RBQ
	
FROM S_CONTACT C 
WHERE 
	NOT EXISTS (SELECT 1 FROM S_USER U WHERE C.ROW_ID = U.ROW_ID)
	AND PRIV_FLG = 'N' AND (EMP_FLG &lt;&gt; 'Y' OR EMP_FLG IS NULL)
-- Exclusion des cas d'essais et en erreur
	AND PERSON_UID NOT IN (
		 '5621-2350'
		,'5642-7495'
		,'5580-9586'
		,'5580-9594'
		,'5580-9602'
		,'5606-9875'
		,'5580-9578'
		,'5580-9669'
		,'5580-9677'
		,'5629-9886'
		,'5641-9880'
		,'5642-7503'
		,'5733-5150'
		,'5641-9740'
		,'8144-8185'
		,'5759-8179'
		,'5759-8187'
		,'5629-8482'
		,'5630-0734'
		,'5667-7057'
		,'5580-9511'
		,'5580-9537'
		,'5580-9552'
		,'5580-9644'
		,'5580-9628'
		,'5763-5013'
		,'5803-3028'
		,'5803-3051'
		,'5803-3085'
		,'5764-6085'
	)</property>
                    <property
                      dataType="System.String"
                      description="Variable contenant la commande SQL à exécuter."
                      name="SqlCommandVariable"></property>
