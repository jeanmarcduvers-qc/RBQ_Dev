			WHEN T1.X_CERTIFICAT_DT &lt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.X_CERTIFICAT_DT) - 2007), '2007-03-11 07:00:00.000') OR
			T1.X_CERTIFICAT_DT &gt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.X_CERTIFICAT_DT) - 2007), '2007-11-04 06:00:00.000')
			THEN
