			WHEN T1.X_RESTRIC_DT &lt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.X_RESTRIC_DT) - 2007), '2007-04-01 07:00:00.000') OR
			T1.X_RESTRIC_DT &gt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.X_RESTRIC_DT) - 2007), '2007-10-28 06:00:00.000')
			THEN
			DATEADD(hh, -5, T1.X_RESTRIC_DT)
			ELSE
			DATEADD(hh, -4, T1.X_RESTRIC_DT)
		END
		ELSE
		CASE
			WHEN T1.X_RESTRIC_DT &lt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.X_RESTRIC_DT) - 2007), '2007-03-11 07:00:00.000') OR
			T1.X_RESTRIC_DT &gt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.X_RESTRIC_DT) - 2007), '2007-11-04 06:00:00.000')
			THEN
			DATEADD(hh, -5, T1.X_RESTRIC_DT)
			ELSE
			DATEADD(hh, -4, T1.X_RESTRIC_DT)
		END
	END AS [X_RESTRIC_DT]
FROM S_DOC_AGREE T1
INNER JOIN S_ORG_EXT T2 ON T1.TARGET_OU_ID = T2.ROW_ID
LEFT OUTER JOIN
	CX_CAUTION_LICN T3 ON T1.PR_CAUTION_ID = T3.ROW_ID

LEFT OUTER JOIN 	S_LST_OF_VAL LOV1 ON LOV1.NAME = T3.[X_GI_NM_ASSC_CAUT_LICN] AND LOV1.TYPE = 'RBQ_ASSOC'
LEFT OUTER JOIN 	S_LST_OF_VAL LOV2 ON LOV2.NAME = T3.[X_GI_NM_EMMT_CAUT_LICN] AND LOV2.TYPE = 'RBQ_CAUTION' 
LEFT OUTER JOIN 	S_LST_OF_VAL LOV3 ON LOV3.NAME = T3.[X_GI_C_MODE_CAUT_LICN] AND LOV3.TYPE = 'RBQ_MODE'

WHERE CONTRACT_FLG = 'N'
-- Exclusion des cas d'essais et en erreur
	AND T2.OU_NUM NOT IN (
		 '5580-9560'
		,'5580-9651'
		,'5580-9503'
		,'5580-9529'
		,'5580-9610'
		,'5580-9545'
		,'5580-9636'
