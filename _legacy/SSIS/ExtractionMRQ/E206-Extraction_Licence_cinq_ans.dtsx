                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Commande SQL à exécuter."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SET LANGUAGE ENGLISH;

SELECT
	T1.ROW_ID,
	CASE
		WHEN T1.DB_LAST_UPD &lt; '2007-03-11 07:00:00.000' THEN
		CASE
			WHEN T1.DB_LAST_UPD &lt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.DB_LAST_UPD) - 2007), '2007-04-01 07:00:00.000') OR
			T1.DB_LAST_UPD &gt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.DB_LAST_UPD) - 2007), '2007-10-28 06:00:00.000')
			THEN
			DATEADD(hh, -5, T1.DB_LAST_UPD)
			ELSE
			DATEADD(hh, -4, T1.DB_LAST_UPD)
		END
		ELSE
		CASE
			WHEN T1.DB_LAST_UPD &lt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.DB_LAST_UPD) - 2007), '2007-03-11 07:00:00.000') OR
			T1.DB_LAST_UPD &gt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.DB_LAST_UPD) - 2007), '2007-11-04 06:00:00.000')
			THEN
			DATEADD(hh, -5, T1.DB_LAST_UPD)
			ELSE
			DATEADD(hh, -4, T1.DB_LAST_UPD)
		END
	END AS [DB_LAST_UPD],
	T1.DB_LAST_UPD_SRC,
	CASE
		WHEN T1.EFF_END_DT &lt; '2007-03-11 07:00:00.000' THEN
		CASE
			WHEN T1.EFF_END_DT &lt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.EFF_END_DT) - 2007), '2007-04-01 07:00:00.000') OR
			T1.EFF_END_DT &gt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.EFF_END_DT) - 2007), '2007-10-28 06:00:00.000')
			THEN
			DATEADD(hh, -5, T1.EFF_END_DT)
			ELSE
			DATEADD(hh, -4, T1.EFF_END_DT)
		END
		ELSE
		CASE
			WHEN T1.EFF_END_DT &lt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.EFF_END_DT) - 2007), '2007-03-11 07:00:00.000') OR
			T1.EFF_END_DT &gt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.EFF_END_DT) - 2007), '2007-11-04 06:00:00.000')
			THEN
			DATEADD(hh, -5, T1.EFF_END_DT)
			ELSE
			DATEADD(hh, -4, T1.EFF_END_DT)
		END
	END AS [EFF_END_DT],
	CASE
		WHEN T1.EFF_START_DT &lt; '2007-03-11 07:00:00.000' THEN
		CASE
			WHEN T1.EFF_START_DT &lt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.EFF_START_DT) - 2007), '2007-04-01 07:00:00.000') OR
			T1.EFF_START_DT &gt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.EFF_START_DT) - 2007), '2007-10-28 06:00:00.000')
			THEN
			DATEADD(hh, -5, T1.EFF_START_DT)
			ELSE
			DATEADD(hh, -4, T1.EFF_START_DT)
		END
		ELSE
		CASE
			WHEN T1.EFF_START_DT &lt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.EFF_START_DT) - 2007), '2007-03-11 07:00:00.000') OR
			T1.EFF_START_DT &gt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.EFF_START_DT) - 2007), '2007-11-04 06:00:00.000')
			THEN
			DATEADD(hh, -5, T1.EFF_START_DT)
			ELSE
			DATEADD(hh, -4, T1.EFF_START_DT)
		END
	END AS [EFF_START_DT],
	T1.MODIFICATION_NUM,
	T1.PAR_AGREE_ID,
	T1.TRANSFERABLE_FLG,
	T1.X_CATEGORIE,
	T1.X_HABILITATION,
	T1.X_IND_CMEQ,
	T1.X_IND_CMMTQ,
	T1.X_IND_REGIE,
	T1.X_MANDATAIRE,
	T1.X_RAISON_FIN,
	T1.X_RESTRICTION,
	T1.X_STATUS,
	T1.X_TXT_1,
	T1.X_TXT_2,
	T1.X_TXT_3,
	T1.X_TXT_RESTRICT
FROM S_ENTLMNT T1
INNER JOIN S_DOC_AGREE T2 ON T1.PAR_AGREE_ID = T2.ROW_ID
INNER JOIN S_ORG_EXT T3 ON T2.TARGET_OU_ID = T3.ROW_ID
WHERE ISNULL(X_RAISON_FIN, '') &lt;&gt; 'Erreur administrative'
-- Exclusion des cas d'essais et en erreur
	AND T3.OU_NUM NOT IN (
		 '5580-9560'
		,'5580-9651'
		,'5580-9503'
		,'5580-9529'
		,'5580-9610'
		,'5580-9545'
		,'5580-9636'
		,'5581-9908'
		,'5754-4801'
		,'5582-2464'
		,'5754-0262'
		,'5674-9153'
		,'5712-6112'
		,'5841-8443'
	)</property>
                    <property
                      dataType="System.String"
                      description="Variable contenant la commande SQL à exécuter."
                      name="SqlCommandVariable"></property>
