                <component
                  refId="Package\Factures et paiements\Paiements\S_SRC_PAYMENT"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                  description="Source OLE DB"
                  name="S_SRC_PAYMENT"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Commande SQL à exécuter."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
S_SRC_PAYMENT.ROW_ID GI3_C_ROWD_PAIM,

CASE WHEN S_SRC_PAYMENT.ACCNT_ID IN (SELECT T1.ROW_ID FROM S_ORG_EXT T1 WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')) THEN
	S_SRC_PAYMENT.ACCNT_ID
ELSE
	NULL 
END GI3_C_ROWD_INTRVN,

CASE WHEN S_SRC_PAYMENT.ORDER_ID IN (SELECT T2.ROW_ID FROM S_ORDER T2 WHERE T2.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')) THEN
	S_SRC_PAYMENT.ORDER_ID
ELSE
	NULL
END GI3_C_ROWD_FACT,

S_SRC_PAYMENT.PAY_AMT GI3_M_PAIM,
CX_POSTE_REV.CODE GI3_C_CODE_REV,
S_SRC_PAYMENT.X_BORDEREAU_DT GI3_D_DEPT_BORD, 
S_SRC_PAYMENT.PAY_STAT_CD GI3_S_PAIM_AJUS,
S_SRC_PAYMENT.X_RAISON_ANNULATION_PAIEMENT GI3_C_RAIS_ANNL_PAIM,
S_SRC_PAYMENT.TXN_TYPE_CD GI3_C_TYPE_PAIM,
S_SRC_PAYMENT.PAYMENT_TYPE_CD GI3_C_MODE_PAIM,
 CASE
        WHEN U1.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U1.[LOGIN]
    END AS [GI3_C_UTIL_CRET],
    CASE
        WHEN U2.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U2.[LOGIN]
    END AS [GI3_C_UTIL_MODF],
S_SRC_PAYMENT.CREATED GI3_D_CRET,
S_SRC_PAYMENT.LAST_UPD GI3_D_MODF,
getdate() GI3_D_INSR_INIT,
NULL GI3_D_INSR_MODF,
CASE WHEN CON_ID &lt;&gt; 'No Match Row Id' THEN
	CON_ID
ELSE
	NULL
END GI3_C_ROWD_INTRL,
S_SRC_PAYMENT.X_PS_D_HR_TRAN GI3_D_HR_TRAN_PAIM,
S_SRC_PAYMENT.X_PS_N_TRAN_PAIM GI3_N_TRAN_PAIM,
S_SRC_PAYMENT.ACTL_PAY_DT GI3_D_PAIM,
S_SRC_PAYMENT.X_PAR_ROW_ID_SORDER_AUTR	AS GI3_C_ROWD_FACT_AUTRE

FROM S_SRC_PAYMENT
INNER join CX_POSTE_REV on
S_SRC_PAYMENT.X_POSTE_REV_ID = CX_POSTE_REV.ROW_ID
left join S_USER U1 on 
S_SRC_PAYMENT.CREATED_BY = U1.ROW_ID
left join S_USER U2 on
S_SRC_PAYMENT.LAST_UPD_BY = U2.ROW_ID
where S_SRC_PAYMENT.TXN_TYPE_CD IS NOT NULL
AND S_SRC_PAYMENT.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
                    <property
