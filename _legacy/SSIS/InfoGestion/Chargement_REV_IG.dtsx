                <component
                  refId="Package\Factures et paiements\Lignes de détail facture\S_ORDER_ITEM"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                  description="Source OLE DB"
                  name="S_ORDER_ITEM"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Commande SQL à exécuter."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select
	T1.ROW_ID GI3_C_ROWD_FACT_DETL,
	--CASE WHEN T1.ORDER_ID IN (SELECT T10.ROW_ID FROM S_ORDER T10 WHERE T10.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')) THEN
	--	T1.ORDER_ID
	--ELSE
	--	NULL
	--END GI3_C_ROWD_FACT,
	T1.ORDER_ID GI3_C_ROWD_FACT,
	T1.LN_NUM GI3_N_LIGN_FACT,
	case when exists ( select 1 from S_EVT_ACT where T1.X_ACTIVITY_ID = S_EVT_ACT.ROW_ID)
	then
		T1.X_ACTIVITY_ID
	else
		null
	end GI3_C_ROWD_ACTV,
	T1.ASSET_ID GI3_C_ROWD_APPR,
	case when exists ( select 1 from S_PRI_LST where S_PRI_LST.ROW_ID = T1.PRI_LST_ID)
	then 
		T1.PRI_LST_ID 
	else 
		null
	end  GI3_C_ROWD_CEDL_TARF,
	T1.PROD_ID GI3_C_ROWD_PROD,
	T1.BASE_UNIT_PRI GI3_V_TARF,
	T1.QTY_REQ GI3_V_QUANT,
	T1.DISCNT_PERCENT GI3_V_FACT,
	T1.DISCNT_SRC_CD GI3_C_RAIS_FACT,
	T1.LINE_NOTE GI3_DE_COMM,
	CASE
       		 WHEN U1.[LOGIN] IS NULL THEN
          		  'Utilisateur inexistant'
       	 ELSE
           		 U1.[LOGIN]
   	 END AS [GI3_C_UTIL_CRET],
   	 CASE
       		 WHEN U2.[LOGIN] IS NULL THEN
           		 'Utilisateur inexistant'
        	ELSE
            		U2.[LOGIN]
   	 END AS [GI3_C_UTIL_MODF],
	T1.CREATED GI3_D_CRET,
	T1.LAST_UPD GI3_D_MODF,
	getdate() GI3_D_INSR_INIT,
	NULL GI3_D_INSR_MODF
from S_ORDER_ITEM T1
left join S_USER U1 on 
T1.CREATED_BY = U1.ROW_ID
left join S_USER U2 on
T1.LAST_UPD_BY = U2.ROW_ID

--INNER JOIN S_ORDER T2
--ON T2.ROW_ID = T1.ORDER_ID
--AND T2.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')

WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
                    <property
                      dataType="System.String"
                      description="Variable contenant la commande SQL à exécuter."
                      name="SqlCommandVariable"></property>
                    <property
                      dataType="System.Int32"
                      description="Spécifie la page de codes de la colonne à utiliser lorsque les informations de page de codes ne sont pas disponibles à partir de la source de données."
                      name="DefaultCodePage">1252</property>
                    <property
