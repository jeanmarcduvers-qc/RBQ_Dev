              <DTS:Variables />
              <DTS:ObjectData>
                <pipeline
                  BLOBTempStoragePath=""
                  bufferTempStoragePath=""
                  version="1">
                  <components>
                    <component
                      refId="Package\embarque\Activités\Reclamants\CX_RECLAMANTS"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SqlServer v10; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="CX_RECLAMANTS"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
	 RCL.[ROW_ID]				AS GI3_C_ROWD_RECL
	,RCL.[CREATED]				AS GI3_D_CRET
	,RCL.[CREATED_BY]			AS GI3_C_UTIL_CRET
	,RCL.[LAST_UPD]				AS GI3_D_MODF
	,RCL.[LAST_UPD_BY]			AS GI3_C_UTIL_MODF
	,RCL.[PAR_ROW_ID_SEVT_ACT]	AS GI3_C_ROWD_ACTV
	,RCL.[X_GI_M_RECL]			AS GI3_M_RECL
	,RCL.[X_GI_M_VERS_CAUT]		AS GI3_M_VERS_CAUT
	,RCL.[PAR_ROW_ID_SSRV_REQ]	AS GI3_C_ROWD_DEMN_DECL
	,RCL.[X_GI_C_DECS_INDM]		AS GI3_C_DECS_INDM
	,RCL.[X_GI_C_STAT_JURD]		AS GI3_C_STAT_JURD
	,RCL.[X_GI_NM_ORGN]			AS GI3_NM_ORGN
	,RCL.[X_GI_NM_PREN_RECL]	AS GI3_NM_PREN_RECL
	,RCL.[X_GI_NM_RECL]			AS GI3_NM_RECL
	,GETDATE()					AS GI3_D_INS_INIT
	  
FROM [dbo].[CX_RECLAMANTS] RCL
LEFT OUTER JOIN [S_USER] AS U1 WITH (NOLOCK) ON RCL.[CREATED_BY] = U1.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U2 WITH (NOLOCK) ON RCL.[LAST_UPD_BY] = U2.[ROW_ID]</property>
