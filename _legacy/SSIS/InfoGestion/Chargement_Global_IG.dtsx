              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{E1CAA913-7F97-4520-9150-B60471728BDA}"
                  SQLTask:SqlStatementSource="UPDATE GI3_PLAN_ACTIVITE&#xA;SET GI3_DE_STAT_PLAN_ACTV = 'En cours'&#xA;FROM (select b.GI3_C_ROWD_PLAN_ACTV as aaa, count(1) as count_en_cours FROM GI3_ACTIVITE as b where GI3_C_ETAT = 'En cours' GROUP BY GI3_C_ROWD_PLAN_ACTV) a&#xA;WHERE a.aaa = GI3_C_ROWD_PLAN_ACTV&#xA;&#xA;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
