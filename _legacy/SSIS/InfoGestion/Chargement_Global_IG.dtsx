                      <outputs>
                        <output
                          refId="Package\embarque\Permis et redevances\Contact Administratif\CX_CONTACT.Outputs[Sortie de source OLE DB]"
                          name="Sortie de source OLE DB">
                          <outputColumns>
                            <outputColumn
                              refId="Package\embarque\Permis et redevances\Contact Administratif\CX_CONTACT.Outputs[Sortie de source OLE DB].Columns[GI3_C_ROWD_CONT]"
                              codePage="1252"
                              dataType="str"
                              errorOrTruncationOperation="Conversion"
                              errorRowDisposition="FailComponent"
                              externalMetadataColumnId="Package\embarque\Permis et redevances\Contact Administratif\CX_CONTACT.Outputs[Sortie de source OLE DB].ExternalColumns[GI3_C_ROWD_CONT]"
                              length="15"
