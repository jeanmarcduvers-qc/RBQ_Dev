                    <component
                      refId="Package\embarque\Permis et redevances\Déclarations\Source OLE DB"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                      description="Source OLE DB"
                      name="Source OLE DB"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT T1.[ROW_ID] AS GI3_C_ROWD_DECL
      ,T1.PAR_ROW_ID_CXREDEVANCE GI3_C_ROWD_REDV
      ,T1.X_GI_Q_DECL GI3_Q_DECL
      ,T1.X_GI_C_UNIT_MESR GI3_C_UNIT_MESR
      ,T1.X_GI_Q_UNIT_MESR_GAZ_CANL GI3_Q_UNIT_MESR_GAZ_CANL
      ,T1.X_GI_Q_UNIT_MESR_GAZ_COMP GI3_Q_UNIT_MESR_GAZ_COMP
      ,T1.X_GI_Q_UNIT_MESR_GAZ_LIQF GI3_Q_UNIT_MESR_GAZ_LIQF
      ,T1.X_GI_Q_INST_UNIF GI3_Q_INST_UNIF
      ,T1.X_GI_Q_INST_NOUV_LOGM GI3_Q_INST_NOUV_LOGM
      ,T1.X_GI_Q_INST_APPR GI3_Q_INST_APPR
      ,T1.X_GI_Q_INST_TARF_MINM GI3_Q_INST_TARF_MINM
      ,U1.LOGIN AS GI3_C_UTIL_CRET
      ,T1.[CREATED] AS GI3_D_CRET
      ,U2.LOGIN AS GI3_C_UTIL_MODF
      ,T1.[LAST_UPD] AS GI3_D_MODF
      ,getdate() AS GI3_D_INS_INIT
      ,getdate() AS GI3_D_INS_MODF
  FROM [siebeldb].[dbo].[CX_DECLARATION] AS T1 WITH (NOLOCK)
LEFT OUTER JOIN [S_USER] AS U1 WITH (NOLOCK)
    ON T1.[CREATED_BY] = U1.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U2 WITH (NOLOCK)
    ON T1.[LAST_UPD_BY] = U2.[ROW_ID]
INNER JOIN CX_REDEVANCE T3 WITH (NOLOCK)
    ON T1.PAR_ROW_ID_CXREDEVANCE = T3.ROW_ID

WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')

ORDER BY T1.ROW_ID ASC</property>
