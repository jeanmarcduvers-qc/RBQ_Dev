                    </component>
                    <component
                      refId="Package\embarque\Produits et compétences\Demandes Declaration\S_SRV_REQ"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                      description="Source OLE DB"
                      name="S_SRV_REQ"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET LANGUAGE ENGLISH

SELECT
    T1.[ROW_ID] AS [GI3_C_ROWD_DEMN_DECL],
    T1.[PAR_SR_ID] AS [GI3_C_ROWD_DROT_EXER],
  --T3.[ROW_ID] AS [GI3_C_ROWD_INTRL],
    CASE WHEN T1.[CST_CON_ID] IN (SELECT DISTINCT T10.[ROW_ID] FROM [S_CONTACT] AS T10 WITH (NOLOCK)WHERE T10.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')) THEN
		T1.[CST_CON_ID]
	ELSE
		NULL
	END AS [GI3_C_ROWD_INTRL],
    T4.[ROW_ID] AS [GI3_C_ROWD_INTRVN],
    T5.[ROW_ID] AS [GI3_C_ROWD_SITE],
    CASE T1.[SR_SUB_STAT_ID]
      WHEN 'No Match Row Id' THEN NULL
      ELSE T1.[SR_SUB_STAT_ID]
    END AS [GI3_C_SOU_STAT],
    CASE T1.[SR_STAT_ID]
      WHEN 'No Match Row Id' THEN NULL
      ELSE T1.[SR_STAT_ID]
    END AS [GI3_C_STAT],
    T6.[ROW_ID] AS [GI3_C_ROWD_AGT_ASGN],
    T1.[SR_SUBTYPE_CD] AS [GI3_C_CANAL],
    T1.[SR_AREA] AS [GI3_C_TYP_DEMN],
 CASE
        WHEN U1.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U1.[LOGIN]
    END AS [GI3_C_UTIL_CRET],
    CASE
        WHEN U2.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U2.[LOGIN]
    END AS [GI3_C_UTIL_MODF],
     
CONVERT(DATETIME, T1.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_CRET],
     
  CASE 
    WHEN T1.[EXP_CLOSE_DT] &lt; '2007-03-11 07:00:00.000' THEN
        CASE
            WHEN T1.[EXP_CLOSE_DT] &gt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[EXP_CLOSE_DT]) - 2007), '2007-04-01 07:00:00.000') OR
                 T1.[EXP_CLOSE_DT] &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[EXP_CLOSE_DT]) - 2007), '2007-10-28 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[EXP_CLOSE_DT])
            ELSE
                 DATEADD(hh, -4, T1.[EXP_CLOSE_DT])
        END
    ELSE
        CASE
            WHEN T1.[EXP_CLOSE_DT] &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[EXP_CLOSE_DT]) - 2007), '2007-03-11 07:00:00.000') OR
                 T1.[EXP_CLOSE_DT] &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[EXP_CLOSE_DT]) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[EXP_CLOSE_DT])
            ELSE
                 DATEADD(hh, -4, T1.[EXP_CLOSE_DT])
        END
  END AS [GI3_D_DAT_FERM],
     
  CASE 
    WHEN T1.[ACT_OPEN_DT] &lt; '2007-03-11 07:00:00.000' THEN
        CASE
            WHEN T1.[ACT_OPEN_DT] &gt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[ACT_OPEN_DT]) - 2007), '2007-04-01 07:00:00.000') OR
                 T1.[ACT_OPEN_DT] &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[ACT_OPEN_DT]) - 2007), '2007-10-28 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[ACT_OPEN_DT])
            ELSE
                 DATEADD(hh, -4, T1.[ACT_OPEN_DT])
        END
    ELSE
        CASE
            WHEN T1.[ACT_OPEN_DT] &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[ACT_OPEN_DT]) - 2007), '2007-03-11 07:00:00.000') OR
                 T1.[ACT_OPEN_DT] &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[ACT_OPEN_DT]) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[ACT_OPEN_DT])
            ELSE
                 DATEADD(hh, -4, T1.[ACT_OPEN_DT])
        END
  END AS [GI3_D_DAT_RECP],
     
CONVERT(DATETIME, T1.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_MODF],
    T1.[SR_NUM] AS [GI3_N_DEMN],
    CASE WHEN T1.[X_JRS_ATT_CLIENT] IS NULL THEN 0
         ELSE T1.[X_JRS_ATT_CLIENT]
    END AS [GI3_V_ATTN_CLNT],
    T1.[SRV_FEE] AS [GI3_V_PRIO],
    T1.[INS_PRODUCT] AS [GI3_V_PROC],
    T1.[SR_TITLE] AS [GI3_DE_TYP_DEMN],
    T1.[X_IND_REGIE] AS [GI3_V_IND_REGIE],
    T1.[X_IND_CMMTQ] AS [GI3_V_IND_CMMTQ],
    T1.[X_IND_CMEQ] AS [GI3_V_IND_CMEQ],
    T1.[X_DEPOSITAIRE] AS [GI3_V_DEPOSITAIRE],
    T1.[X_DATE_RECEPTION] AS [GI3_D_RECEPTION],
    GETDATE() AS [GI3_D_INS_INIT],
    NULL AS [GI3_D_INS_MODF],
    T1.[X_PR_FORM_TEMP_ID] AS [GI3_C_ROWD_GABARIT],
    T1.[X_QUANTITE] AS [GI3_Q_QUAN],
    T1.[X_RESULTAT] AS [GI3_DE_RESL],
    T1.[X_SOUS_STATUS_CMEQ] AS [GI3_DE_SOUS_STAT_CMEQ],
    T1.[X_SOUS_STATUS_CMMTQ] AS [GI3_DE_SOUS_STAT_CMMTQ],
    T1.[X_NUMERISE_FLAG] AS [GI3_I_NUMR],
	T1.[X_GI_D_PRIS_CHAR] AS [GI3_D_PRIS_CHAR],
	T1.[X_GI_N_SEQN_TRAN_PST] AS [GI3_N_SEQN_TRAN_PST],
	T1.[X_GI_N_CONF_USAG_PST] AS [GI3_N_CONF_USAG_PST],
	T1.[X_GI_NM_PREN_USAG_PST] AS [GI3_NM_PREN_USAG_PST],
	T1.[X_GI_NM_USAG_PST] AS [GI3_NM_USAG_PST],
	CASE WHEN T1.[X_PAR_ROW_ID_CXFICH_TRANS] IN (SELECT T10.ROW_ID FROM CX_FICH_TRANS T10
												WHERE T10.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')) THEN
		T1.X_PAR_ROW_ID_CXFICH_TRANS
	ELSE
		NULL
	END [GI3_C_ROWD_FICH_TRAN],
	--T1.[X_PAR_ROW_ID_CXFICH_TRANS] AS [GI3_C_ROWD_FICH_TRAN],
	T1.[DESC_TEXT] AS [GI3_DE_COMM],
	--T1X.X_GI_I_LIGN_AFFR_SECR AS GI3_I_LIGN_AFFR_SECR,
	--T1X.X_GI_I_ANAL_EFFC_LIGN_AFFR AS GI3_I_ANAL_EFFC_LIGN_AFFR,
	--T1X.X_GI_I_LIGN_AFFR_CONS AS GI3_I_LIGN_AFFR_CONS,
	--T1X.X_GI_I_ANAL_EFFC_LIGN_CONS AS GI3_I_ANAL_EFFC_LIGN_CONS,
	DO.SR_ID AS GI3_N_DEMD_ORIG,
	T1.X_PAR_ROW_ID_SPROD_INT_CRSE AS GI3_C_ROWD_FORM_CONT,
	T1.X_GI_C_ANNE AS GI3_C_ANNE,
	T1.X_GI_C_MOIS AS GI3_C_MOIS,
	T1.X_PAR_ROW_ID_CXCONTACT_INTL AS GI3_C_ROWD_CONT_INTL,
	T1.X_PAR_ROW_ID_CXCONTACT_INTV AS GI3_C_ROWD_CONT_INTV,
	T1.X_DOMAINE_INTERVENTION AS GI3_C_DOMAINE_INTRV,
    T1.X_GI_C_LANG_FORM_RECU_DEMN AS GI3_C_LANG_FORM_RECU_DEMN

FROM
    [S_SRV_REQ] AS T1 WITH (NOLOCK)
LEFT OUTER JOIN [S_SRV_REQ_X] AS T1X WITH (NOLOCK)
    ON T1X.[PAR_ROW_ID] = T1.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U1 WITH (NOLOCK)
    ON T1.[CREATED_BY] = U1.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U2 WITH (NOLOCK)
    ON T1.[LAST_UPD_BY] = U2.[ROW_ID]
--LEFT OUTER JOIN [S_CONTACT] AS T3 WITH (NOLOCK)
--	ON T1.[CST_CON_ID] = T3.[ROW_ID]
LEFT OUTER JOIN [S_ORG_EXT] AS T4 WITH (NOLOCK)
	ON T1.[CST_OU_ID] = T4.[ROW_ID]
LEFT OUTER JOIN [S_ORG_EXT] AS T5 WITH (NOLOCK)
	ON T1.[X_SITE_ID] =T5.[ROW_ID]
LEFT OUTER JOIN [S_CONTACT] AS T6 WITH (NOLOCK)
	ON T1.[OWNER_EMP_ID] = T6.[ROW_ID]
LEFT OUTER JOIN [CX_FRM_ADM] AS T7 WITH (NOLOCK)
	ON T1.[X_PR_FORM_TEMP_ID] = T7.[ROW_ID]
LEFT OUTER JOIN 
	(SELECT k.SR_ID, d.SR_NUM from
		(SELECT r.SR_ID, MAX(d.CREATED) as Recente from S_SRV_REQ_REL r  
				INNER JOIN S_SRV_REQ d on d.ROW_ID = r.PAR_SR_ID 
			GROUP BY r.SR_ID) k 
		INNER JOIN S_SRV_REQ d 
		ON  k.SR_ID = d.ROW_ID and d.CREATED = k.Recente) DO
	ON T1.ROW_ID = DO.SR_ID 


WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
                        <property
