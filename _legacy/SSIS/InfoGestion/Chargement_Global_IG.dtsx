                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select 
T1.ROW_ID AS [GI3_C_ROWD_CARC_VERS_PERM_ISP]
,T1.PAR_ROW_ID_CXCATG_VER_ISP as [GI3_C_ROWD_CATG_INTR_PERM_ISP]
,T1.X_GI_C_TYPE_EQUP_PERM_ISP as [GI3_C_TYPE_EQUP_PERM_ISP]
,T1.X_GI_C_CHAM_ACTV_PERM_ISP as [GI3_C_CHAM_ACTV_PERM_ISP]
,T1.X_GI_V_DIMN_MINM_SOUP as [GI3_V_DIMN_MINM_SOUP]
,T1.X_GI_C_FRAC_DIMN_MINM_SOUP as [GI3_C_FRAC_DIMN_MINM_SOUP]
,T1.X_GI_V_DIMN_MAXM_SOUP as  [GI3_V_DIMN_MAXM_SOUP]
,T1.X_GI_C_FRAC_DIMN_MAXM_SOUP as [GI3_C_FRAC_DIMN_MAXM_SOUP]
,T1.CREATED AS [GI3_D_CRET]
,T1.LAST_UPD AS [GI3_D_MODF]
,U1.LOGIN AS GI3_C_UTIL_CRET
,U2.LOGIN AS GI3_C_UTIL_MODF
,getdate() AS GI3_D_INS_INIT
,getdate() AS GI3_D_INS_MODF 
 FROM [siebeldb].[dbo].CX_CARC_VER_ISP AS T1 WITH (NOLOCK)
INNER JOIN CX_CATG_VER_ISP T2 WITH (NOLOCK)
    ON T2.ROW_ID= T1.PAR_ROW_ID_CXCATG_VER_ISP
LEFT OUTER JOIN [S_USER] AS U1 WITH (NOLOCK)
    ON T1.[CREATED_BY] = U1.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U2 WITH (NOLOCK)
    ON T1.[LAST_UPD_BY] = U2.[ROW_ID]
WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
