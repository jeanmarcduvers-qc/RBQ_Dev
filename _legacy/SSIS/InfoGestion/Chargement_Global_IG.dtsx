                        <component
                          refId="Package\embarque\Phase 1 - Intervenants - Sites- Adresses - Interlocuteurs - LOV\Site\Attributs Valeurs\OLE DB Source"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SqlServer v10; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="OLE DB Source"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT T1.ROW_ID AS GI3_C_ROWD_ATTR_SITE_COMP_VALR,
T1.CREATED AS GI3_D_CRET,
T1.LAST_UPD AS GI3_D_MODF,
T1.CREATED_BY AS GI3_C_UTIL_CRET,
T1.LAST_UPD_BY AS GI3_C_UTIL_MODF,
GETDATE() AS GI3_D_INS_INIT,
NULL AS GI3_D_INS_MODF,
T1.ASSESS_ID AS GI3_C_ROWD_ATTR_SITE_COMP,
T1.ATTRIB_ID AS GI3_C_ROWD_ATTR_SITE_COMP_ATTR,
T1.COMMENTS AS GI3_DE_COMM,
T1.SEQUENCE_NUM AS GI3_N_COMM_ORDR,
T1.ATTRIB_NAME AS GI3_NM_ATTR,
T1.ATTRIB_VALUE AS GI3_V_LIST_VALR,
T2.METRIC_CD AS GI3_V_TYPE_LIST_NUMR_TEXT,
T3.ATTRIB_12 AS GI3_D_ATTR,
T3.ATTRIB_14 AS GI3_V_NUMR_ATTR,
T3.ATTRIB_47 AS GI3_V_TEXT_ATTR

from S_ASSESS_VAL T1 
inner  join S_ASSESS T0 on T1.ASSESS_ID=  T0.ROW_ID
inner join S_ORG_EXT s on s.ROW_ID= T0.ACCNT_ID
left outer join S_ASSESS_ATTRIB T2 on T2.ROW_ID= T1.ATTRIB_ID

left outer  join S_ASSESS_VAL_X T3   on T3.PAR_ROW_ID=T1.ROW_ID
where 
T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
                            <property
                              dataType="System.String"
                              description="The variable that contains the SQL command to be executed."
                              name="SqlCommandVariable"></property>
                            <property
                              dataType="System.Int32"
                              description="Specifies the column code page to use when code page information is unavailable from the data source."
                              name="DefaultCodePage">1252</property>
                            <property
                              dataType="System.Boolean"
                              description="Forces the use of the DefaultCodePage property value when describing character data."
                              name="AlwaysUseDefaultCodePage">false</property>
                            <property
                              dataType="System.Int32"
                              description="Specifies the mode used to access the database."
                              name="AccessMode"
                              typeConverter="AccessMode">2</property>
                            <property
                              dataType="System.String"
                              description="The mappings between the parameters in the SQL command and variables."
                              name="ParameterMapping"></property>
                          </properties>
