                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT S_ASSESS_ATTRIB.ROW_ID AS GI3_C_ROWD_ATTR_SITE_COMP_ATTR,
S_ASSESS_ATTRIB.CREATED AS GI3_D_CRET,
S_ASSESS_ATTRIB.LAST_UPD AS GI3_D_MODF,
S_ASSESS_ATTRIB.CREATED_BY AS GI3_C_UTIL_CRET,
S_ASSESS_ATTRIB.LAST_UPD_BY AS GI3_C_UTIL_MODF,
GETDATE() AS GI3_D_INS_INIT,
NULL AS GI3_D_INS_MODF,
S_ASSESS_ATTRIB.DESC_TEXT AS GI3_DE_DESC,
S_ASSESS_ATTRIB.METRIC_CD AS GI3_V_TYPE_LIST_NUMR_TEXT
from 
S_ASSESS_ATTRIB
where 
  S_ASSESS_ATTRIB.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
                            <property
