                              dataType="dbTimeStamp"
                              errorOrTruncationOperation="Conversion"
                              errorRowDisposition="FailComponent"
                              externalMetadataColumnId="Package\embarque\Formation continue\Formation continue\S_PROD_INT_CRSE.Outputs[OLE DB Source Output].ExternalColumns[GI3_D_CRET]"
                              lineageId="Package\embarque\Formation continue\Formation continue\S_PROD_INT_CRSE.Outputs[OLE DB Source Output].Columns[GI3_D_CRET]"
