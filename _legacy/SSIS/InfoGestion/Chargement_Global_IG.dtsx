                                  errorRowDisposition="FailComponent"
                                  externalMetadataColumnId="Package\embarque\Phase 1 - Intervenants - Sites- Adresses - Interlocuteurs - LOV\Audits\Extraction audit\Source OLE DB.Outputs[Sortie de source OLE DB].ExternalColumns[TBL_RECORD_ID]"
                                  length="15"
