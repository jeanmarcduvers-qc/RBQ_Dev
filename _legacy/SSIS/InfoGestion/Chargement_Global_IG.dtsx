                    <component
                      refId="Package\embarque\Interventions\Notes Sites\SRC_siebeldb S_NOTE_CASE Site"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                      description="Source OLE DB"
                      localeId="3084"
                      name="SRC_siebeldb S_NOTE_CASE Site"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select  DISTINCT S_NOTE_CASE.ROW_ID GI3_C_ROWD_NOTE,
		--S_ORG_EXT.ROW_ID GI3_C_ROWD_SITE,
		T3.ROW_ID GI3_C_ROWD_SITE,
		S_NOTE_CASE.CREATED GI3_D_CRET,
		S_NOTE_CASE.LAST_UPD GI3_D_MODF,
		UTIL_CRET.LOGIN GI3_C_UTIL_CRET,
		UTIL_MODF.LOGIN GI3_C_UTIL_MODF,
		getdate() GI3_D_INS_INIT,
		NULL GI3_D_INS_MODF,
		S_NOTE_CASE.X_GI_C_SUJT_NOTE_INTR GI3_C_SUJT_NOTE_INTR,
		S_NOTE_CASE.NOTE_TYPE GI3_C_SOUS_SUJT_NOTE,
		S_NOTE_CASE.NOTE GI3_DE_NOTE
from 
	S_NOTE_CASE
	INNER JOIN S_ORG_EXT T3
ON  S_NOTE_CASE.SRC_ROW_ID = T3.ROW_ID
	INNER join S_ORG_EXT --Site 
--on S_NOTE_CASE.SRC_ROW_ID = S_ORG_EXT.ROW_ID
ON S_NOTE_CASE.SRC_ROW_ID IN (SELECT DISTINCT T1.[ROW_ID] FROM [S_ORG_EXT] AS T1 WITH (NOLOCK)
								LEFT OUTER JOIN [S_USER] AS U1 WITH (NOLOCK)
								ON T1.[CREATED_BY] = U1.[ROW_ID]
								LEFT OUTER JOIN [S_USER] AS U2 WITH (NOLOCK)
									ON T1.[LAST_UPD_BY] = U2.[ROW_ID]
								LEFT OUTER JOIN [S_ORG_EXT_UTX] AS T8 WITH (NOLOCK)
									ON T1.[ROW_ID] = T8.[PAR_ROW_ID]
								LEFT OUTER JOIN [S_ORG_EXT] AS T9 WITH (NOLOCK)
									ON T1.[PAR_OU_ID] = T9.[ROW_ID]
								LEFT OUTER JOIN [S_POSTN] AS T2 WITH (NOLOCK)
									ON T2.[PR_POSTN_ID] = T1.[ROW_ID]
								WHERE T1.[ACCNT_FLG] = 'N' 
								AND T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00'))
--AND S_ORG_EXT.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')
	INNER join S_USER UTIL_CRET on
S_NOTE_CASE.CREATED_BY = UTIL_CRET.ROW_ID
	INNER join S_USER UTIL_MODF on
S_NOTE_CASE.CREATED_BY = UTIL_MODF.ROW_ID

WHERE S_NOTE_CASE.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
                        <property
                          dataType="System.String"
