                  SQLTask:SqlStatementSource="--update T1 &#xA;--set T1.GI3_C_QUAL= T3.GI3_V_TEXT_ATTR&#xA;--FROM&#xA;--GI3_SITE_COMPOSANTE T1&#xA;--inner join GI3_ATTRIBUTS_SITE_COMPOSANTE T2 on T1.GI3_C_ROWD_SITE=T2.GI3_C_ROWD_SITE&#xA;--inner join GI3_ATTRIBUTS_SITE_COMP_VALEURS T3  on T3.GI3_C_ROWD_ATTR_SITE_COMP = T2.GI3_C_ROWD_ATTR_SITE_COMP&#xA;--where &#xA;--T2.GI3_NM_MODL='Caractéristiques du site'&#xA;--and T2.GI3_I_MODL_ACTF='Y'&#xA;--and T3.GI3_NM_ATTR='Code de qualification principal'&#xA;&#xA;&#xA;--update T1 &#xA;--set T1.GI3_C_TYPE_CONS= T3.GI3_V_LIST_VALR&#xA;--FROM&#xA;--GI3_SITE_COMPOSANTE T1&#xA;--inner join GI3_ATTRIBUTS_SITE_COMPOSANTE T2 on T1.GI3_C_ROWD_SITE=T2.GI3_C_ROWD_SITE&#xA;--inner join GI3_ATTRIBUTS_SITE_COMP_VALEURS T3  on T3.GI3_C_ROWD_ATTR_SITE_COMP = T2.GI3_C_ROWD_ATTR_SITE_COMP&#xA;--where &#xA;--T2.GI3_NM_MODL='Caractéristiques du site'&#xA;--and T2.GI3_I_MODL_ACTF='Y'&#xA;--and T3.GI3_NM_ATTR='Genre de construction'&#xA;&#xA;&#xA;--update T1 &#xA;--set T1.GI3_N_ANN_CONS_SITE= CAST(T3.GI3_V_NUMR_ATTR as INT)&#xA;&#xA;--FROM&#xA;--GI3_SITE_COMPOSANTE T1&#xA;--inner join GI3_ATTRIBUTS_SITE_COMPOSANTE T2 on T1.GI3_C_ROWD_SITE=T2.GI3_C_ROWD_SITE&#xA;--inner join GI3_ATTRIBUTS_SITE_COMP_VALEURS T3  on T3.GI3_C_ROWD_ATTR_SITE_COMP = T2.GI3_C_ROWD_ATTR_SITE_COMP&#xA;--where &#xA;--T2.GI3_NM_MODL='Caractéristiques du site'&#xA;--and T2.GI3_I_MODL_ACTF='Y'&#xA;--and T3.GI3_NM_ATTR='Année de construction'&#xA;&#xA;--update T1 &#xA;--set T1.GI3_Q_ETAG_BATM= T3.GI3_V_NUMR_ATTR&#xA;&#xA;--FROM&#xA;--GI3_SITE_COMPOSANTE T1&#xA;--inner join GI3_ATTRIBUTS_SITE_COMPOSANTE T2 on T1.GI3_C_ROWD_SITE=T2.GI3_C_ROWD_SITE&#xA;--inner join GI3_ATTRIBUTS_SITE_COMP_VALEURS T3  on T3.GI3_C_ROWD_ATTR_SITE_COMP = T2.GI3_C_ROWD_ATTR_SITE_COMP&#xA;--where &#xA;--T2.GI3_NM_MODL='Caractéristiques du site'&#xA;--and T2.GI3_I_MODL_ACTF='Y'&#xA;--and T3.GI3_NM_ATTR='Nb étages'&#xA;&#xA;&#xA;--update T1 &#xA;--set T1.GI3_V_AIRE_BATM= T3.GI3_V_NUMR_ATTR&#xA;&#xA;--FROM&#xA;--GI3_SITE_COMPOSANTE T1&#xA;--inner join GI3_ATTRIBUTS_SITE_COMPOSANTE T2 on T1.GI3_C_ROWD_SITE=T2.GI3_C_ROWD_SITE&#xA;--inner join GI3_ATTRIBUTS_SITE_COMP_VALEURS T3  on T3.GI3_C_ROWD_ATTR_SITE_COMP = T2.GI3_C_ROWD_ATTR_SITE_COMP&#xA;--where &#xA;--T2.GI3_NM_MODL='Caractéristiques du site'&#xA;--and T2.GI3_I_MODL_ACTF='Y'&#xA;--and T3.GI3_NM_ATTR='Aire (m2)'&#xA;&#xA;--update T1 &#xA;--set T1.GI3_V_CAPC_MAXM_BATM= T3.GI3_V_NUMR_ATTR&#xA;&#xA;--FROM&#xA;--GI3_SITE_COMPOSANTE T1&#xA;--inner join GI3_ATTRIBUTS_SITE_COMPOSANTE T2 on T1.GI3_C_ROWD_SITE=T2.GI3_C_ROWD_SITE&#xA;--inner join GI3_ATTRIBUTS_SITE_COMP_VALEURS T3  on T3.GI3_C_ROWD_ATTR_SITE_COMP = T2.GI3_C_ROWD_ATTR_SITE_COMP&#xA;--where &#xA;--T2.GI3_NM_MODL='Caractéristiques du site'&#xA;--and T2.GI3_I_MODL_ACTF='Y'&#xA;--and T3.GI3_NM_ATTR='Capacité'&#xA;&#xA;--update T1 &#xA;--set T1.GI3_C_TYPE_CAPC= T3.GI3_V_LIST_VALR&#xA;&#xA;--FROM&#xA;--GI3_SITE_COMPOSANTE T1&#xA;--inner join GI3_ATTRIBUTS_SITE_COMPOSANTE T2 on T1.GI3_C_ROWD_SITE=T2.GI3_C_ROWD_SITE&#xA;--inner join GI3_ATTRIBUTS_SITE_COMP_VALEURS T3  on T3.GI3_C_ROWD_ATTR_SITE_COMP = T2.GI3_C_ROWD_ATTR_SITE_COMP&#xA;--where &#xA;--T2.GI3_NM_MODL='Caractéristiques du site'&#xA;--and T2.GI3_I_MODL_ACTF='Y'&#xA;--and T3.GI3_NM_ATTR='Unité de capacité'&#xA;&#xA;&#xA;--update T1 &#xA;--set T1.GI3_C_MODE_SURV= T3.GI3_V_LIST_VALR&#xA;&#xA;--FROM&#xA;--GI3_SITE_COMPOSANTE T1&#xA;--inner join GI3_ATTRIBUTS_SITE_COMPOSANTE T2 on T1.GI3_C_ROWD_SITE=T2.GI3_C_ROWD_SITE&#xA;--inner join GI3_ATTRIBUTS_SITE_COMP_VALEURS T3  on T3.GI3_C_ROWD_ATTR_SITE_COMP = T2.GI3_C_ROWD_ATTR_SITE_COMP&#xA;--where &#xA;--T2.GI3_NM_MODL='Caractéristiques du site'&#xA;--and T2.GI3_I_MODL_ACTF='Y'&#xA;--and T3.GI3_NM_ATTR='Surveillance ISP'&#xA;&#xA;&#xA;--update T1 &#xA;--set T1.GI3_C_EXTN_AUTM_BATM= T3.GI3_V_LIST_VALR&#xA;&#xA;--FROM&#xA;--GI3_SITE_COMPOSANTE T1&#xA;--inner join GI3_ATTRIBUTS_SITE_COMPOSANTE T2 on T1.GI3_C_ROWD_SITE=T2.GI3_C_ROWD_SITE&#xA;--inner join GI3_ATTRIBUTS_SITE_COMP_VALEURS T3  on T3.GI3_C_ROWD_ATTR_SITE_COMP = T2.GI3_C_ROWD_ATTR_SITE_COMP&#xA;--where &#xA;--T2.GI3_NM_MODL='Caractéristiques du site'&#xA;--and T2.GI3_I_MODL_ACTF='Y'&#xA;--and T3.GI3_NM_ATTR='Extincteur automatique à eau'&#xA;&#xA;&#xA;--update T1 &#xA;--set T1.GI3_N_IMMT= T3.GI3_V_TEXT_ATTR&#xA;--FROM&#xA;--GI3_SITE_COMPOSANTE T1&#xA;--inner join GI3_ATTRIBUTS_SITE_COMPOSANTE T2 on T1.GI3_C_ROWD_SITE=T2.GI3_C_ROWD_SITE&#xA;--inner join GI3_ATTRIBUTS_SITE_COMP_VALEURS T3  on T3.GI3_C_ROWD_ATTR_SITE_COMP = T2.GI3_C_ROWD_ATTR_SITE_COMP&#xA;--where &#xA;--T2.GI3_NM_MODL='Caractéristiques du site'&#xA;--and T2.GI3_I_MODL_ACTF='Y'&#xA;--and T3.GI3_NM_ATTR='No immatriculation camion-citerne Gaz'&#xA;&#xA;--update T1 &#xA;--set T1.GI3_C_PROV= T3.GI3_V_LIST_VALR&#xA;&#xA;--FROM&#xA;--GI3_SITE_COMPOSANTE T1&#xA;--inner join GI3_ATTRIBUTS_SITE_COMPOSANTE T2 on T1.GI3_C_ROWD_SITE=T2.GI3_C_ROWD_SITE&#xA;--inner join GI3_ATTRIBUTS_SITE_COMP_VALEURS T3  on T3.GI3_C_ROWD_ATTR_SITE_COMP = T2.GI3_C_ROWD_ATTR_SITE_COMP&#xA;--where &#xA;--T2.GI3_NM_MODL='Caractéristiques du site'&#xA;--and T2.GI3_I_MODL_ACTF='Y'&#xA;--and T3.GI3_NM_ATTR='Province origine camion'&#xA;&#xA;Update T1&#xA;set T1.GI3_DE_STAT_SITE_COMP =T2.GI3_C_STAT_ETAT_SITE&#xA;From &#xA;GI3_SITE_COMPOSANTE T1&#xA;left outer join GI3_ETAT_SITE T2 on  T1.GI3_C_ROWD_SITE=T2.GI3_C_ROWD_SITE&#xA;where  GI3_I_STAT_ETAT_COUR= 'Y'&#xA; &#xA; &#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
