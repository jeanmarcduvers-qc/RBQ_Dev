                      <outputs>
                        <output
                          refId="Package\embarque\Formation continue\Raison refus disp\CX_RAI_REF_DISP.Outputs[OLE DB Source Output]"
                          name="OLE DB Source Output">
                          <outputColumns>
                            <outputColumn
                              refId="Package\embarque\Formation continue\Raison refus disp\CX_RAI_REF_DISP.Outputs[OLE DB Source Output].Columns[GI3_C_ROWD_RAIS_REFS]"
                              codePage="1252"
                              dataType="str"
