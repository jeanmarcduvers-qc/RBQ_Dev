	,T1.X_GI_D_FIN_VALD_PERM AS GI3_D_FIN_VALD_PERM
	,T1.X_GI_D_FIN_PROR_VERS_PERM AS GI3_D_FIN_PROR_VERS_PERM
	,T1.X_GI_D_ENV_RENV_PERM AS GI3_D_ENV_RENV_PERM
	,T1.X_GI_DE_COMM_VERS_PERM AS GI3_DE_COMM_VERS_PERM
	,T1.X_GI_DE_PREC_VERS_PERM AS GI3_DE_PREC_VERS_PERM
	,T2.X_GI_C_NIV_SERV_PERM_GAZ AS GI3_C_NIV_SERV_PERM_GAZ
	--,ISNULL(X_GI_Q_CAPC_FIXE_PROP,0) + ISNULL(X_GI_Q_CAPC_PORT_PROP,0) + ISNULL(X_GI_Q_TRAN_PROP,0) AS GI3_Q_CAPC_TOTL_PROP
	,T2.X_GI_Q_CAPC_TOTL_PROP AS GI3_Q_CAPC_TOTL_PROP
	,T2.X_GI_Q_CAPC_LIMT_PROP AS GI3_Q_CAPC_LIMT_PROP
	--,ISNULL(X_GI_Q_CAPC_FIXE_NATR,0) + ISNULL(X_GI_Q_CAPC_PORT_NATR,0) + ISNULL(X_GI_Q_CAPC_TRAN_NATR,0) AS GI3_Q_CAPC_TOTL_NATR
	,T2.X_GI_Q_CAPC_TOTL_NATR AS GI3_Q_CAPC_TOTL_NATR
	,T2.X_GI_Q_CAPC_LIMT_NATR AS GI3_Q_CAPC_LIMT_NATR
	,T2.X_GI_Q_CAPC_FIXE_PROP AS GI3_Q_CAPC_FIXE_PROP
	,T2.X_GI_Q_TRAN_PROP AS GI3_Q_TRAN_PROP
	,T2.X_GI_Q_CAPC_PORT_PROP AS GI3_Q_CAPC_PORT_PROP
	,T2.X_GI_Q_CAPC_FIXE_NATR AS GI3_Q_CAPC_FIXE_NATR
	,T2.X_GI_Q_CAPC_TRAN_NATR AS GI3_Q_CAPC_TRAN_NATR
	,T2.X_GI_Q_CAPC_PORT_NATR AS GI3_Q_CAPC_PORT_NATR
	,T2.X_GI_I_RECP_RAPP_RISQ_PROP AS GI3_I_RECP_RAPP_RISQ_PROP
	,T2.X_GI_I_RECP_RAPP_RISQ_NATR AS GI3_I_RECP_RAPP_RISQ_NATR
	,CONVERT(DATETIME, T1.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_CRET]
	,CONVERT(DATETIME, T1.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_MODF]
	,U1.LOGIN AS GI3_C_UTIL_CRET
	,U2.LOGIN AS GI3_C_UTIL_MODF
	,GETDATE() AS GI3_D_INS_INIT
	,T1.X_GI_I_VERS_PERM_COUR_DUR AS GI3_I_VERS_PERM_COUR_DUR
	,T1.X_GI_D_DERN_VERF_INST AS GI3_D_DERN_VERF_INST
	,T1.X_GI_D_VERF_PLANF_INST AS GI3_D_VERF_PLANF_INST
	,T1.X_GI_I_MODF_ENSM_EP AS GI3_I_MODF_ENSM_EP
	,T2.X_GI_Q_CAPC_FIXE_HYDR		AS GI3_Q_CAPC_FIXE_HYDR
	,T2.X_GI_Q_CAPC_TRAN_HYDR		AS GI3_Q_CAPC_TRAN_HYDR
	,T2.X_GI_Q_CAPC_PORT_HYDR		AS GI3_Q_CAPC_PORT_HYDR
	,T2.X_GI_Q_CAPC_TOTL_HYDR		AS GI3_Q_CAPC_TOTL_HYDR
	,T2.X_GI_Q_CAPC_LIMT_HYDR		AS GI3_Q_CAPC_LIMT_HYDR
	,T2.X_GI_I_RECP_RAPP_RISQ_HYDR	AS GI3_I_RECP_RAPP_RISQ_HYDR


FROM CX_VERS_PERM T1  
LEFT OUTER JOIN CX_CAR_PERM_GAZ AS T2 WITH (NOLOCK)	ON T1.ROW_ID = T2.PAR_ROW_ID_CXVERS_PERM
LEFT OUTER JOIN [S_USER] AS U1 WITH (NOLOCK) ON T1.[CREATED_BY] = U1.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U2 WITH (NOLOCK) ON T1.[LAST_UPD_BY] = U2.[ROW_ID]

WHERE 
	T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
