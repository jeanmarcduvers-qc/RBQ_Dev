                              name="Sortie de source OLE DB">
                              <outputColumns>
                                <outputColumn
                                  refId="Package\embarque\Phase 1 - Intervenants - Sites- Adresses - Interlocuteurs - LOV\Interlocuteur\Type Interlocuteur\SRC_siebeldb S_CONTACT_XM.Outputs[Sortie de source OLE DB].Columns[GI3_C_ROWD_INTRL]"
                                  codePage="1252"
                                  dataType="str"
                                  errorOrTruncationOperation="Conversion"
                                  errorRowDisposition="FailComponent"
