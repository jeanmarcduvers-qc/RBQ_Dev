                              lineageId="Package\embarque\Comptabilité (REV)\Compte client\S_ASSET.Outputs[OLE DB Source Output].Columns[GI3_D_CRET]"
                              name="GI3_D_CRET"
                              truncationRowDisposition="FailComponent" />
                            <outputColumn
                              refId="Package\embarque\Comptabilité (REV)\Compte client\S_ASSET.Outputs[OLE DB Source Output].Columns[GI3_C_UTIL_CRET]"
                              codePage="1252"
                              dataType="str"
                              errorOrTruncationOperation="Conversion"
                              errorRowDisposition="FailComponent"
                              externalMetadataColumnId="Package\embarque\Comptabilité (REV)\Compte client\S_ASSET.Outputs[OLE DB Source Output].ExternalColumns[GI3_C_UTIL_CRET]"
                              length="15"
                              lineageId="Package\embarque\Comptabilité (REV)\Compte client\S_ASSET.Outputs[OLE DB Source Output].Columns[GI3_C_UTIL_CRET]"
                              name="GI3_C_UTIL_CRET"
                              truncationRowDisposition="FailComponent" />
                            <outputColumn
                              refId="Package\embarque\Comptabilité (REV)\Compte client\S_ASSET.Outputs[OLE DB Source Output].Columns[GI3_D_MODF]"
                              dataType="dbTimeStamp"
