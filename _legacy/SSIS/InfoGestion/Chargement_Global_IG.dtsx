                                  externalMetadataColumnId="Package\embarque\Phase 1 - Intervenants - Sites- Adresses - Interlocuteurs - LOV\Site\Sites\OLE DB Source.Outputs[OLE DB Source Output].ExternalColumns[GI3_C_ROWD_ATTRIBUE_A]"
                                  length="15"
