              <DTS:Variables />
              <DTS:ObjectData>
                <pipeline
                  BLOBTempStoragePath=""
                  bufferTempStoragePath=""
                  engineThreads="5"
                  version="1">
                  <components>
                    <component
                      refId="Package\embarque\Documents\Document\CX_FILE_ATT"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                      description="Source OLE DB"
                      name="CX_FILE_ATT"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET LANGUAGE ENGLISH;

SELECT
    T1.[ROW_ID] AS [GI3_C_ROWD_DOCM],
    T2.[ROW_ID] AS [GI3_C_ROWD_DROT_EXER],
    T3.[ROW_ID] AS [GI3_C_ROWD_APPR],
    T4.[ROW_ID] AS [GI3_C_ROWD_DEMN_DECL],
    T5.[ROW_ID] AS [GI3_C_ROWD_INTRL],
    T6.[ROW_ID] AS [GI3_C_ROWD_INTRVN],
    T7.[ROW_ID] AS [GI3_C_ROWD_INTRVT],
    T8.[ROW_ID] AS [GI3_C_ROWD_SITE],
    T1.[X_CATEGORIE] AS [GI3_C_CATG],
    T1.[LANGUE] AS [GI3_C_LANG_DOCM],
    T1.[X_SOUS_CATEG] AS [GI3_C_SOUS_CATG],
    T1.[FILE_EXT] AS [GI3_C_TYPE_DOCM],    
	CONVERT(DATETIME, T1.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_CRET],
	CONVERT(DATETIME, T1.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_MODF],
    T1.[FINAL_FLG] AS [GI3_I_DOCM_FINL],
    T1.[X_STATUT] AS [GI3_S_DOCM],
    U1.[LOGIN] AS [GI3_C_UTIL_CRET],
    U2.[LOGIN] AS [GI3_C_UTIL_MODF],
    GETDATE() [GI3_D_INS_INIT],
    NULL [GI3_D_INS_MODF],
    T1.[PAR_ROW_ID] AS [GI3_C_ROWD_GABARIT],
    T1.[X_SEQ_LIVRAISON] AS [GI3_N_SEQ_LIVRAISON],
    T9.[ORDER_NUM] AS [GI3_N_FACT],
    T1.[X_NUM_LOT] AS [GI3_N_NUMR_LOT],
    T1.[X_NUM_REF] AS [GI3_N_NUMR_REFR],
    T1.[X_CLIENT_FLG] AS [GI3_I_AFFC_CLIN],
    T1.[COPIE_CURT] AS [GI3_I_COPI_COUR],
    T11.[NAME] AS [GI3_NM_BURE],
    T1.[UNDISPLAYED] AS [GI3_I_CACH_ENRG],
    T1.[X_GI_DE_COMM_DOCM] AS [GI3_DE_COMM_PIEC_JOIN],
    T1 .X_GI_C_TYPE_DEST_DOCM AS [GI3_C_TYPE_DEST_DOCM],
	T1.PAR_ROW_ID_CXCOM_IMPR_LIC AS [GI3_C_ROWD_COMM_IMPR_LICN],
    T1.PAR_ROW_ID_CXVERS_PERM AS [GI3_C_ROWD_VERS_PERM_RBQ],
	T1.X_GI_IN_DOCM_COUR AS GI3_I_DOCM_ENV_COUR,
	T1.PAR_ROW_ID_CXDECL_FCON AS GI3_C_ROWD_DECL_FORM,
	T1.PAR_ROW_ID_CXRIG_LEV_JURD AS GI3_C_ROWD_RAPP_IG_LEV_JURD,
	T1.DATE_FERM AS GI3_D_FERM,
	T1.PAR_ROW_ID_CXSEANCE_EXAM AS GI3_C_ROWD_SEANCE,
	T1.COMMENTS AS GI3_DE_COMMENTAIRE

FROM
    [CX_FILE_ATT] AS T1 with (NOLOCK)
LEFT JOIN [S_DOC_AGREE] AS T2 WITH (NOLOCK)
    ON T1.[X_AGREEMENT_ID] = T2.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U1 WITH (NOLOCK)
    ON T1.[CREATED_BY] = U1.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U2 WITH (NOLOCK)
    ON T1.[LAST_UPD_BY] = U2.[ROW_ID]
LEFT OUTER JOIN [S_ASSET] AS T3 WITH (NOLOCK)
	ON T1.[X_ASSET_ID] = T3.[ROW_ID]
LEFT OUTER JOIN [S_SRV_REQ] AS T4 WITH (NOLOCK)
	ON T1.[X_SR_ID] = T4.[ROW_ID]
LEFT OUTER JOIN [S_CONTACT] AS T5 WITH (NOLOCK)
	ON T1.[X_CONTACT_ID] = T5.ROW_ID
LEFT OUTER JOIN [S_ORG_EXT] AS T6 WITH (NOLOCK)
	ON T1.[X_ACCOUNT_ID] = T6.[ROW_ID]
LEFT OUTER JOIN [S_CASE] AS T7 WITH (NOLOCK)
	ON T1.[X_CASE_ID] = T7.[ROW_ID]
LEFT OUTER JOIN [S_ORG_EXT] AS T8 WITH (NOLOCK)
	ON T1.[X_SITE_ID] = T8.[ROW_ID]
LEFT OUTER JOIN [S_ORDER] AS T9 WITH (NOLOCK)
	ON T1.[X_INVOICE_ID] = T9.[ROW_ID]
LEFT OUTER JOIN [S_ORG_EXT] AS T10 WITH (NOLOCK)
	ON T1.[DIV_ID] = T10.[ROW_ID]
LEFT OUTER JOIN [CX_FRM_ADM] AS Z1 WITH (NOLOCK)
	ON T1.[PAR_ROW_ID] = Z1.ROW_ID
LEFT OUTER JOIN [S_ORG_EXT] AS T11 WITH (NOLOCK)
	ON Z1.PAR_ROW_ID_SCASE= T11.ROW_ID

WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
                        <property
                          dataType="System.String"
                          description="Variable contenant la commande SQL à exécuter."
                          name="SqlCommandVariable"></property>
                        <property
