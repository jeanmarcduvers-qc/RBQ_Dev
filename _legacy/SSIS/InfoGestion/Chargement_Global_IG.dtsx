                        <component
                          refId="Package\embarque\Phase 1 - Intervenants - Sites- Adresses - Interlocuteurs - LOV\Lien Site + Appareil\Scelle appareil\Source scelle appareil"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="Source scelle appareil"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET LANGUAGE ENGLISH

SELECT 
	T1.[ASSET_ID] AS [GI3_C_ROWD_APPR],
	T1.[X_ATTRIB_01] AS [GI3_N_SCEL],
	T1.[START_DT] AS [GI3_D_DEBT],
	T1.[END_DT] AS [GI3_D_FIN],
	T1.[X_ATTRIB_02] AS [GI3_DE_COMM],
	T1.[ROW_ID] AS [GI3_C_ROWD_APPR_SCEL],
	T1.[X_GI_N_EXPL_SCEL] As [GI3_C_TYPE_SCEL],
  CASE 
    WHEN T1.CREATED &lt; '2007-03-11 07:00:00.000' THEN
        CASE
            WHEN T1.CREATED &gt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.CREATED) - 2007), '2007-04-01 07:00:00.000') OR
                 T1.CREATED &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.CREATED) - 2007), '2007-10-28 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.CREATED)
            ELSE
                 DATEADD(hh, -4, T1.CREATED)
        END
    ELSE
        CASE
            WHEN T1.CREATED &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.CREATED) - 2007), '2007-03-11 07:00:00.000') OR
                 T1.CREATED &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.CREATED) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.CREATED)
            ELSE
                 DATEADD(hh, -4, T1.CREATED)
        END
  END AS [GI3_D_CRET],
     

   CASE 
    WHEN T1.LAST_UPD &lt; '2007-03-11 07:00:00.000' THEN
        CASE
            WHEN T1.LAST_UPD &gt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.LAST_UPD) - 2007), '2007-04-01 07:00:00.000') OR
                 T1.LAST_UPD &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.LAST_UPD) - 2007), '2007-10-28 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.LAST_UPD)
            ELSE
                 DATEADD(hh, -4, T1.LAST_UPD)
        END
    ELSE
        CASE
            WHEN T1.LAST_UPD &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.LAST_UPD) - 2007), '2007-03-11 07:00:00.000') OR
                 T1.LAST_UPD &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.LAST_UPD) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.LAST_UPD)
            ELSE
                 DATEADD(hh, -4, T1.LAST_UPD)
        END
  END AS [GI3_D_MODF],
    U1.LOGIN AS [GI3_C_UTIL_CRET],
    U2.LOGIN AS [GI3_C_UTIL_MODF],
    GETDATE() AS [GI3_D_INS_INIT],
    NULL AS [GI3_D_INS_MODF]
FROM [S_ASSET_WRNTY] AS T1 WITH (NOLOCK)
INNER JOIN [S_ASSET] AS T2 WITH (NOLOCK)
	ON T1.[ASSET_ID] = T2.[ROW_ID]
LEFT OUTER JOIN S_USER AS U1 WITH (NOLOCK)
    ON T1.CREATED_BY = U1.ROW_ID
LEFT OUTER JOIN S_USER AS U2 WITH (NOLOCK)
    ON T1.LAST_UPD_BY = U2.ROW_ID

WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
                            <property
