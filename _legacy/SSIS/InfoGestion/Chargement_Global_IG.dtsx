        <DTS:Executable
          DTS:refId="Package.EventHandlers[OnError]\SMTP_RBQ"
          DTS:CreationName="Microsoft.SendMailTask"
          DTS:Description="Serveur SMTP pour notifications ETL"
          DTS:DTSID="{a5c43cbc-af29-47d4-89ea-88b64a767bb2}"
          DTS:ExecutableType="Microsoft.SendMailTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SMTP_RBQ"
          DTS:TaskContact="Send Mail Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="MessageSource">"Bonjour,\r\n\r\nUne erreur a été détectée lors de l'exécution du package Global_IG en PROD. Veuillez trouver ci-dessous le détail de l'incident :\r\n\r\n" +
"Package  : " + @[System::PackageName] + "\r\n" +
"Heure    : " + @[User::Error_Time] + "\r\n" +
"Source   : " + @[User::Source_Name] + "\r\n" +
"Code     : " + @[User::Error_Code] + "\r\n" +
"Erreur   : " + @[User::Error_Description] + "\r\n\r\n" +
"Nous vous prions de bien vouloir prendre les mesures nécessaires afin de résoudre cette anomalie dans les meilleurs délais.\r\n\r\n" +
"Ce courriel a été généré automatiquement. Merci de ne pas y répondre directement.\r\n\r\n" +
"Cordialement,\r\nL'équipe d'exploitation"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <SendMailTask:SendMailTaskData
              SendMailTask:SMTPServer="{7D21A81F-151F-49E3-94B5-04EADFE93A5B}"
              SendMailTask:From="alertage.etl.app@rbq.gouv.qc.ca"
              SendMailTask:To="alertage.etl.app@rbq.gouv.qc.ca"
              SendMailTask:Subject="Erreur d'execution Global IG-PROD"
              SendMailTask:MessageSource="Bonjour,&#xA;&#xA;Une erreur a été détectée lors de l'exécution du package Global_IG en PROD. Veuillez trouver ci-dessous le détail de l'incident :&#xA;&#xA;Package  : Chargement_Global_IG&#xA;Heure    : &#xA;Source   : &#xA;Code     : &#xA;Erreur   : &#xA;&#xA;Nous vous prions de bien vouloir prendre les mesures nécessaires afin de résoudre cette anomalie dans les meilleurs délais.&#xA;&#xA;Ce courriel a été généré automatiquement. Merci de ne pas y répondre directement.&#xA;&#xA;Cordialement,&#xA;L'équipe d'exploitation" xmlns:SendMailTask="www.microsoft.com/sqlserver/dts/tasks/sendmailtask" />
          </DTS:ObjectData>
        </DTS:Executable>
