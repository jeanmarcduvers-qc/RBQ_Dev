                      SQLTask:SqlStatementSource="INSERT INTO [SDGIC01].[dbo].[GI3_GENR_APPR]&#xA;           ([GI3_C_GENR_APPR],[GI3_FREQN_INSPC_ASP], [GI3_NM_GENR_APPR])&#xA;     VALUES&#xA;           ('01'&#xA;           ,1, '01-Autoclave ouverture rapide');&#xA;&#xA;INSERT INTO [SDGIC01].[dbo].[GI3_GENR_APPR]&#xA;           ([GI3_C_GENR_APPR],[GI3_FREQN_INSPC_ASP] , [GI3_NM_GENR_APPR])&#xA;     VALUES&#xA;           ('02'&#xA;           ,1, '02-Chaudière à vapeur');&#xA;&#xA;INSERT INTO [SDGIC01].[dbo].[GI3_GENR_APPR]&#xA;           ([GI3_C_GENR_APPR],[GI3_FREQN_INSPC_ASP] , [GI3_NM_GENR_APPR])&#xA;     VALUES&#xA;           ('03'&#xA;           ,1, '03-Appareil spécial');&#xA;&#xA;INSERT INTO [SDGIC01].[dbo].[GI3_GENR_APPR]&#xA;           ([GI3_C_GENR_APPR],[GI3_FREQN_INSPC_ASP] , [GI3_NM_GENR_APPR])&#xA;     VALUES&#xA;           ('04'&#xA;           ,2, '04-Chaudière à eau chaude');&#xA;&#xA;INSERT INTO [SDGIC01].[dbo].[GI3_GENR_APPR]&#xA;           ([GI3_C_GENR_APPR],[GI3_FREQN_INSPC_ASP] , [GI3_NM_GENR_APPR])&#xA;     VALUES&#xA;           ('05'&#xA;           ,2, '05-Chauffe-eau');&#xA;&#xA;INSERT INTO [SDGIC01].[dbo].[GI3_GENR_APPR]&#xA;           ([GI3_C_GENR_APPR],[GI3_FREQN_INSPC_ASP] , [GI3_NM_GENR_APPR])&#xA;     VALUES&#xA;           ('06'&#xA;           ,2, '06-Générateur de vapeur');&#xA;&#xA;INSERT INTO [SDGIC01].[dbo].[GI3_GENR_APPR]&#xA;           ([GI3_C_GENR_APPR],[GI3_FREQN_INSPC_ASP] , [GI3_NM_GENR_APPR])&#xA;     VALUES&#xA;           ('17'&#xA;           ,2, '17-Rouleau séchoir');&#xA;&#xA;INSERT INTO [SDGIC01].[dbo].[GI3_GENR_APPR]&#xA;           ([GI3_C_GENR_APPR],[GI3_FREQN_INSPC_ASP] , [GI3_NM_GENR_APPR])&#xA;     VALUES&#xA;           ('18'&#xA;           ,2, '18-Lessiveur');&#xA;&#xA;INSERT INTO [SDGIC01].[dbo].[GI3_GENR_APPR]&#xA;           ([GI3_C_GENR_APPR],[GI3_FREQN_INSPC_ASP] , [GI3_NM_GENR_APPR])&#xA;     VALUES&#xA;           ('19'&#xA;           ,2, '19-Réservoir ammoniaque');&#xA;&#xA;INSERT INTO [SDGIC01].[dbo].[GI3_GENR_A