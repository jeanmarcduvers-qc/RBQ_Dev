            <DTS:Executable
              DTS:refId="Package\embarque\Préférences - Déclarations Intégrité\Choix Réponse - Type Action"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:Description="Tâche de flux de données"
              DTS:DTSID="{6F5FE560-3313-49BD-A37A-83AE13903DD6}"
              DTS:ExecutableType="Microsoft.Pipeline"
              DTS:LocaleID="-1"
              DTS:ObjectName="Choix Réponse - Type Action"
              DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server v9; (C) 2004 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
              <DTS:Variables />
              <DTS:ObjectData>
                <pipeline
                  BLOBTempStoragePath=""
                  bufferTempStoragePath=""
                  engineThreads="5"
                  version="1">
                  <components>
                    <component
                      refId="Package\embarque\Préférences - Déclarations Intégrité\Choix Réponse - Type Action\CX_JCT_CHREP_AC"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                      description="Source OLE DB"
                      name="CX_JCT_CHREP_AC"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT T1.ROW_ID AS GI3_C_ROWD_CHOX_REPS_ACTN,
	   T1.PAR_ROW_IC_CXTYPE_ACTION AS GI3_C_ROWD_TYPE_ACTN,
	   T1.PAR_ROW_ID_CXCHOIX_REP AS GI3_C_ROWD_CHOX_REPS,

CONVERT(DATETIME, T1.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_CRET],
 CASE
    WHEN U1.[LOGIN] IS NULL THEN
        'Utilisateur inexistant'
    ELSE
        U1.[LOGIN]
 END AS [GI3_C_UTIL_CRET],
CASE
    WHEN U2.[LOGIN] IS NULL THEN
        'Utilisateur inexistant'
    ELSE
        U2.[LOGIN]
END AS [GI3_C_UTIL_MODF],
CASE 
	WHEN T1.[LAST_UPD] &lt; '2007-03-11 07:00:00.000' THEN
		CASE
			WHEN T1.[LAST_UPD] &gt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[LAST_UPD]) - 2007), '2007-04-01 07:00:00.000') OR
				 T1.[LAST_UPD] &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[LAST_UPD]) - 2007), '2007-10-28 06:00:00.000')
			THEN
				 DATEADD(hh, -5, T1.[LAST_UPD])
			ELSE
				 DATEADD(hh, -4, T1.[LAST_UPD])
		END
	ELSE
		CASE
			WHEN T1.[LAST_UPD] &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[LAST_UPD]) - 2007), '2007-03-11 07:00:00.000') OR
				 T1.[LAST_UPD] &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[LAST_UPD]) - 2007), '2007-11-04 06:00:00.000')
			THEN
				 DATEADD(hh, -5, T1.[LAST_UPD])
			ELSE
				 DATEADD(hh, -4, T1.[LAST_UPD])
	END
END AS [GI3_D_MODF],
GETDATE() AS [GI3_D_INS_INIT],
NULL AS [GI3_D_INS_MODF]

FROM CX_JCT_CHREP_AC T1

LEFT OUTER JOIN [S_USER] AS U1 WITH (NOLOCK)
    ON T1.[CREATED_BY] = U1.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U2 WITH (NOLOCK)
    ON T1.[LAST_UPD_BY] = U2.[ROW_ID]
LEFT OUTER JOIN [CX_TYPE_ACTION] AS T2 WITH (NOLOCK)
    ON T2.ROW_ID = T1.PAR_ROW_IC_CXTYPE_ACTION
LEFT OUTER JOIN [CX_CHOIX_REP] AS T3 WITH (NOLOCK)
    ON T3.ROW_ID = T1.PAR_ROW_ID_CXCHOIX_REP

WHERE T1.ROW_ID NOT IN ('ACREP-000000001','ACREP-000000002','ACREP-000000003','ACREP-000000004','ACREP-000000005','ACREP-000000006')

AND T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
