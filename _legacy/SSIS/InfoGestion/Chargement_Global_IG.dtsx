                      <outputs>
                        <output
                          refId="Package\embarque\ITRE\Jonction Analyse Traitement\CX_JCT_AN_TRAIT.Outputs[Sortie de source OLE DB]"
                          name="Sortie de source OLE DB">
                          <outputColumns>
                            <outputColumn
                              refId="Package\embarque\ITRE\Jonction Analyse Traitement\CX_JCT_AN_TRAIT.Outputs[Sortie de source OLE DB].Columns[GI3_C_ROWD_JCT_ANAL_TRAT]"
                              codePage="1252"
                              dataType="str"
                              errorOrTruncationOperation="Conversion"
                              errorRowDisposition="FailComponent"
