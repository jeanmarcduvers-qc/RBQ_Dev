                    <component
                      refId="Package\embarque\Factures et paiements\Factures\Source OLE DB"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                      description="Source OLE DB"
                      localeId="3084"
                      name="Source OLE DB"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET LANGUAGE ENGLISH;

SELECT 
	S_ORDER.ROW_ID GI3_C_ROWD_FACT, 
	S_ORDER.ACCNT_ID GI3_C_ROWD_INTRVN,
	S_ORDER.ORDER_NUM GI3_N_FACT,
	O1.Total GI3_M_TOTL_FACT, 
	O2.SOLDE GI3_M_SOLD_FACT,
	CX_POSTE_REV.CODE GI3_C_CODE_REV,
	S_ORDER.ORDER_DT GI3_D_FACT,
	S_ORDER.STATUS_CD GI3_S_FACT,
	S_ORDER.CANCEL_REASON_CD GI3_C_RAIS_ANNL_FACT,
	CONVERT(DATETIME, S_ORDER.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS GI3_D_CRET,
	CASE
        WHEN U1.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U1.[LOGIN]
    END AS [GI3_C_UTIL_CRET],
    CASE
        WHEN U2.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U2.[LOGIN]
    END AS [GI3_C_UTIL_MODF],
	CONVERT(DATETIME, S_ORDER.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS GI3_D_MODF,
	GETDATE() GI3_D_INSR_INIT,
	NULL GI3_D_INSR_MODF,
	CASE WHEN CONTACT_ID &lt;&gt; 'No Match Row Id' THEN
		CONTACT_ID
	ELSE
		NULL
	END GI3_C_ROWD_INTRL,
	CX_POSTE_REV.DESCRIPTION GI3_DE_POST_REVN,
	CX_POSTE_REV.DOMAINE_INTERVENTION GI3_DE_DOMN_INTRVT,
	S_ORDER_PSX.CASE_ID GI3_C_ROWD_INTRVT,
	S_ORDER_TYPE.NAME GI3_DE_TYPE_FACT,
	S_ORDER.X_DUE_DATE GI3_D_ECHN,
	S_ORDER.X_DEPOSITAIRE GI3_C_DEPS,
	CASE WHEN S_ORDER.X_SITE_ID IN (SELECT T1.ROW_ID FROM S_ORG_EXT T1 WHERE ACCNT_FLG = 'N' AND T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')) THEN
		S_ORDER.X_SITE_ID
	ELSE
		NULL
	END GI3_C_ROWD_SITE,
	CASE WHEN S_ORDER.SR_ID IN (SELECT T2.ROW_ID FROM S_SRV_REQ T2 WHERE T2.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')) THEN
		S_ORDER.SR_ID
	ELSE
		NULL
	END GI3_C_ROWD_DEMN_DECL,
	CASE WHEN S_ORDER.AGREE_ID IN (SELECT T3.ROW_ID FROM S_DOC_AGREE T3 WHERE T3.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')) THEN
		S_ORDER.AGREE_ID
	ELSE
		NULL
	END GI3_C_ROWD_DROT_EXER,
	S_ORDER.X_GI_NO_DEMN_ZE			AS GI3_N_DEMN_ZE,
	S_ORDER.X_POSTE_REV_ID			AS GI3_C_ROWD_POST_REVN,
	S_ORDER.ORDER_TYPE_ID			AS GI3_C_ROWD_TYP_FACT,
	S_ORDER.PRI_LST_ID				AS GI3_C_ROWD_CEDL_TARF


FROM S_ORDER 

INNER JOIN (
	SELECT 
		S_ORDER.ROW_ID,
		SUM(S_ORDER_ITEM.BASE_UNIT_PRI * S_ORDER_ITEM.QTY_REQ * S_ORDER_ITEM.DISCNT_PERCENT) Total

	FROM S_ORDER 
	LEFT JOIN S_ORDER_ITEM ON S_ORDER_ITEM.ORDER_ID = S_ORDER.ROW_ID
	GROUP BY S_ORDER.ROW_ID, S_ORDER.ACCNT_ID
) O1 ON S_ORDER.ROW_ID = O1.ROW_ID


INNER JOIN (
	SELECT 
		Z1.ROW_ID, 
		SUM(Z1.PAY_AMT) AS SOLDE
	FROM (
		SELECT T5.ROW_ID, 'Facture' AS TXN_TYPE_CD, CONVERT(DECIMAL(10, 2), SUM(T6.BASE_UNIT_PRI * T6.DISCNT_PERCENT * T6.QTY_REQ)) AS PAY_AMT
		FROM S_ORDER (NOLOCK) T5 
			INNER JOIN S_ORDER_ITEM (NOLOCK) T6 ON T5.ROW_ID = T6.ORDER_ID
		GROUP BY T5.ROW_ID
 
		UNION ALL
 
		SELECT T5.ROW_ID, 'Crédit' AS TXN_TYPE_CD, CONVERT(DECIMAL(10, 2), SUM(T6.BASE_UNIT_PRI * T6.DISCNT_PERCENT * T6.QTY_REQ)) * -1 AS PAY_AMT
		FROM S_ORDER (NOLOCK) T5 
			INNER JOIN S_ORDER_ITEM (NOLOCK) T6 ON T5.ROW_ID = T6.ORDER_ID
		WHERE ((T5.STATUS_CD = 'Annulée' AND T5.INTEGRATION_ID IS NOT NULL) OR (T5.STATUS_CD = 'À annuler' AND T5.X_DEPOSITAIRE IS NULL))
		GROUP BY T5.ROW_ID
 
		UNION ALL
 
		SELECT T2.ROW_ID, T1.TXN_TYPE_CD, CASE WHEN T1.TXN_TYPE_CD IN ('Crédit', 'Paiement', 'Transfert paiement à', 'Annulation remboursement', 'Radiation', NULL) THEN CONVERT(DECIMAL(10, 2), T1.PAY_AMT) * -1 ELSE CONVERT(DECIMAL(10, 2), T1.PAY_AMT) END AS PAY_AMT
		FROM S_SRC_PAYMENT (NOLOCK) T1
			INNER JOIN S_ORDER (NOLOCK) T2 ON T1.ORDER_ID = T2.ROW_ID
		WHERE T1.PAY_STAT_CD IN ('Transmitted', 'To Be Transmitted') AND T1.TXN_TYPE_CD IS NOT NULL AND T1.TXN_TYPE_CD != 'Annulation facture'
	) Z1
	GROUP BY Z1.ROW_ID
) O2 ON O1.ROW_ID = O2.ROW_ID

LEFT JOIN S_LST_OF_VAL lovOrderStat ON lovOrderStat.TYPE = 'FS_ORDER_STATUS'
									   AND lovOrderStat.LANG_ID = 'FRA'
									   AND S_ORDER.STATUS_CD = lovOrderStat.VAL

LEFT JOIN CX_POSTE_REV ON S_ORDER.X_POSTE_REV_ID = CX_POSTE_REV.ROW_ID
LEFT JOIN S_ORDER_PSX ON S_ORDER.ROW_ID = S_ORDER_PSX.ROW_ID
LEFT JOIN S_ORDER_TYPE ON S_ORDER.ORDER_TYPE_ID = S_ORDER_TYPE.ROW_ID
LEFT JOIN S_USER U1 ON S_ORDER.CREATED_BY = U1.ROW_ID
LEFT JOIN S_USER U2 ON S_ORDER.LAST_UPD_BY = U2.ROW_ID

WHERE S_ORDER.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
