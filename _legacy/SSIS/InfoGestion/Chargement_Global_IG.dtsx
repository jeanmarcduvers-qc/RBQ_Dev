                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET LANGUAGE ENGLISH;

SELECT T1.[ROW_ID]				AS GI3_C_ROWD_CAUTION_LICN
      ,CONVERT(DATETIME, T1.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_CRET]
      ,T1.[CREATED_BY]			AS GI3_C_UTIL_CRET
      ,CONVERT(DATETIME, T1.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_MODF]
      ,T1.[LAST_UPD_BY]					AS GI3_C_UTIL_MODF
	  ,GETDATE()						AS GI3_D_INS_INIT
      ,[PAR_ROW_ID_SDOC_AGREE]			AS GI3_C_ROWD_DROT_EXER
      ,[X_GI_D_DEBT_CAUT_LICN]			AS GI3_D_DEBT_CAUT_LICN
      ,[X_GI_D_FIN_CAUT_LICN]			AS GI3_D_FIN_CAUT_LICN
      ,[X_GI_C_MODE_CAUT_LICN]			AS GI3_C_MODE_CAUT_LICN
      ,[X_GI_MN_TOTL_CAUT_LICN]			AS GI3_MN_TOTL_CAUT_LICN
      ,[X_GI_NM_ASSC_CAUT_LICN]			AS GI3_NM_ASSC_CAUT_LICN
      ,[X_GI_NM_EMMT_CAUT_LICN]			AS GI3_NM_EMMT_CAUT_LICN
      ,[X_GI_NO_CAUT_LICN]				AS GI3_NO_CAUT_LICN
	  ,[X_GI_I_CHEQ_REMB_CAUT_LICN]		AS GI3_I_CHEQ_REMB_CAUT_LICN
	  ,[X_GI_DE_COMM_CAUT_LICN]			AS GI3_DE_COMM_CAUT_LICN
	  ,[X_GI_C_MOTF_RAIS_FIN_CAUT]		AS GI3_C_MOTF_RAIS_FIN_CAUT
	  ,[X_GI_C_RAIS_FIN_CAUT_LICN]		AS GI3_C_RAIS_FIN_CAUT_LICN
      ,T1.X_GI_I_EPUS_CAUT_LICN         AS GI3_I_EPUS_CAUT_LICN
      ,T1.X_GI_MN_INDM_PAYE_CAUT_LICN   AS GI3_MN_INDM_PAYE_CAUT_LICN

FROM [dbo].[CX_CAUTION_LICN] T1 WITH (NOLOCK)

INNER JOIN [S_USER] AS U1 WITH (NOLOCK)
    ON T1.[CREATED_BY] = U1.[ROW_ID]
INNER JOIN [S_USER] AS U2 WITH (NOLOCK)
    ON T1.[LAST_UPD_BY] = U2.[ROW_ID]

WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
