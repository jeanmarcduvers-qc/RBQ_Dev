                        <output
                          refId="Package\embarque\Produits et compétences\Demandes Declaration\GI3_DEMANDE_DECLARATION.Outputs[Sortie d'erreur de destination OLE DB]"
                          exclusionGroup="1"
                          isErrorOut="true"
                          name="Sortie d'erreur de destination OLE DB"
                          synchronousInputId="Package\embarque\Produits et compétences\Demandes Declaration\GI3_DEMANDE_DECLARATION.Inputs[Entrée de destination OLE DB]">
                          <outputColumns>
                            <outputColumn
                              refId="Package\embarque\Produits et compétences\Demandes Declaration\GI3_DEMANDE_DECLARATION.Outputs[Sortie d'erreur de destination OLE DB].Columns[ErrorCode]"
                              dataType="i4"
                              lineageId="Package\embarque\Produits et compétences\Demandes Declaration\GI3_DEMANDE_DECLARATION.Outputs[Sortie d'erreur de destination OLE DB].Columns[ErrorCode]"
                              name="ErrorCode"
                              specialFlags="1" />
                            <outputColumn
