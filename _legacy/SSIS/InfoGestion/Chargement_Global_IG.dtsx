                    <component
                      refId="Package\embarque\Comptabilité (REV)\Transaction comptable\S_FN_ACCNT_TXN"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="S_FN_ACCNT_TXN"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET LANGUAGE ENGLISH;

WITH SRC AS (
    SELECT T1.[ROW_ID]                          AS GI3_C_ROWD_TRAN_COMP
          ,CONVERT(DATETIME, T1.[CREATED]  AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_CRET]
          ,T1.[CREATED_BY]                      AS GI3_C_UTIL_CRET
          ,CONVERT(DATETIME, T1.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_MODF]
          ,T1.[LAST_UPD_BY]                     AS GI3_C_UTIL_MODF
          ,GETDATE()                            AS GI3_D_INS_INIT
          ,T1.ACCNT_ID                          AS GI3_C_ROWD_COMP_CLIN
          ,T1.X_PAR_ROW_ID_CXPERD_COMP          AS GI3_C_ROWD_PERD_COMP
          ,T1.X_PAR_ROW_ID_SFN_ACCNT_BAL        AS GI3_C_ROWD_SOLD_FERM
          ,T1.X_PAR_ROW_ID_SORDER               AS GI3_C_ROWD_FACT
          ,T1.X_PAR_ROW_ID_CXPOSTE_REV          AS GI3_C_ROWD_POST_REVN
          ,T1.X_PAR_ROW_ID_SSRC_PAYMENT         AS GI3_C_ROWD_PAIM
          ,T1.ITEM_TYPE_CD                      AS GI3_C_TYPE_TRAN_COMP
          ,T1.AMT                               AS GI3_MN_TRAN_COMP
          ,T1.X_GI_D_TRAN_COMP_SH               AS GI3_D_TRAN_COMP
          ,T1.X_GI_D_TRAN_COMP                  AS GI3_D_DOC_COMP
          ,T1.X_GI_I_ECRT_COMP_HORS_BALN        AS GI3_I_ECRT_COMP_HORS_BALN
          ,T1.X_GI_D_FIN_TRAN_COMP              AS GI3_D_FIN_TRAN_COMP
          ,T1.X_GI_C_RAIS_FIN_TRAN_COMP         AS GI3_C_RAIS_FIN_TRAN_COMP
          ,T1.X_GI_MN_SOLD_CC_TRAN_COMP         AS GI3_MN_SOLD_CC_TRAN_COMP
          ,T1.X_GI_NO_IDEN_TRAN_REV             AS GI3_N_IDEN_TRAN_REV
          ,T1.X_GI_C_MODE_PAIM_TRAN_COMP        AS GI3_C_MODE_PAIM_TRAN_COMP
          ,T1.X_PAR_ROW_ID_CXBORD_DEPOT         AS GI3_C_ROWD_BORD_DEPT
          ,T1.X_PAR_ROW_ID_SASSET_AUTR_CC       AS GI3_C_ROWD_AUTRE_COMP_CLIN
          ,ROW_NUMBER() OVER (
               PARTITION BY T1.[ROW_ID]
               ORDER BY T1.[LAST_UPD] DESC, T1.[CREATED] DESC
           ) AS RN
    FROM [dbo].S_FN_ACCNT_TXN T1 WITH (NOLOCK)
    WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')
      AND EXISTS (SELECT 1 FROM [S_USER] U1 WITH (NOLOCK) WHERE U1.[ROW_ID] = T1.[CREATED_BY])
      AND EXISTS (SELECT 1 FROM [S_USER] U2 WITH (NOLOCK) WHERE U2.[ROW_ID] = T1.[LAST_UPD_BY])
)
SELECT  GI3_C_ROWD_TRAN_COMP
       ,GI3_D_CRET
       ,GI3_C_UTIL_CRET
       ,GI3_D_MODF
       ,GI3_C_UTIL_MODF
       ,GI3_D_INS_INIT
       ,GI3_C_ROWD_COMP_CLIN
       ,GI3_C_ROWD_PERD_COMP
       ,GI3_C_ROWD_SOLD_FERM
       ,GI3_C_ROWD_FACT
       ,GI3_C_ROWD_POST_REVN
       ,GI3_C_ROWD_PAIM
       ,GI3_C_TYPE_TRAN_COMP
       ,GI3_MN_TRAN_COMP
       ,GI3_D_TRAN_COMP
       ,GI3_D_DOC_COMP
       ,GI3_I_ECRT_COMP_HORS_BALN
       ,GI3_D_FIN_TRAN_COMP
       ,GI3_C_RAIS_FIN_TRAN_COMP
       ,GI3_MN_SOLD_CC_TRAN_COMP
       ,GI3_N_IDEN_TRAN_REV
       ,GI3_C_MODE_PAIM_TRAN_COMP
       ,GI3_C_ROWD_BORD_DEPT
       ,GI3_C_ROWD_AUTRE_COMP_CLIN
FROM SRC
WHERE RN = 1</property>
