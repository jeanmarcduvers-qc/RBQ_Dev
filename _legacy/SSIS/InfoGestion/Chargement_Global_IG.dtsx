            <DTS:Executable
              DTS:refId="Package\embarque\Examens (AEB)\Inscription exam"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:Description="Data Flow Task"
              DTS:DTSID="{23B25BAA-372B-437A-AB6C-896F39AE2E86}"
              DTS:ExecutableType="Microsoft.Pipeline"
              DTS:LocaleID="-1"
              DTS:ObjectName="Inscription exam"
              DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
              <DTS:Variables />
              <DTS:ObjectData>
                <pipeline
                  version="1">
                  <components>
                    <component
                      refId="Package\embarque\Examens (AEB)\Inscription exam\CX_INSC_EXAM"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="CX_INSC_EXAM"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET LANGUAGE ENGLISH;
SET TRANSACTION ISOLATION LEVEL READ COMMITTED;

SELECT T1.[ROW_ID]						AS GI3_C_ROWD_INSC_EXAM
      ,T1.[CREATED_BY]					AS GI3_C_UTIL_CRET
      ,T1.[LAST_UPD_BY]					AS GI3_C_UTIL_MODF
	  ,CONVERT(DATETIME, T1.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_CRET]
	  ,CONVERT(DATETIME, T1.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_MODF]
      ,GETDATE()						AS GI3_D_INS_INIT
	  ,T1.[PAR_ROW_ID__CXEXAMEN]		AS GI3_C_ROWD_EXAM
      ,T1.[PAR_ROW_ID__SCONTACT]		AS GI3_C_ROWD_INTRL
      ,[X_GI_I_REPR_EXAM]				AS GI3_I_REPR_EXAM
      ,[X_GI_D_ANNL_INSC_EXAM]			AS GI3_D_ANNL_INSC_EXAM
      ,[X_GI_D_CORR_EXAM]				AS GI3_D_CORR_EXAM
      ,[X_GI_D_REVS_NOTE_EXAM]			AS GI3_D_REVS_NOTE_EXAM
      ,[X_GI_V_NOTE_INIT_EXAM]			AS GI3_V_NOTE_INIT_EXAM
      ,[X_GI_V_NOTE_REVS_EXAM]			AS GI3_V_NOTE_REVS_EXAM
      ,[X_GI_C_RAIS_ANNL_INSC]			AS GI3_C_RAIS_ANNL_INSC
      ,[X_GI_C_TYPE_MESR_ADAP_REQS]		AS GI3_C_TYPE_MESR_ADAP_REQS
      ,[X_GI_DE_COMM_MESR_ADAP_REQS]	AS GI3_DE_COMM_MESR_ADAP_REQS
      ,[X_GI_DE_COMM_REVS_NOTE_EXAM]	AS GI3_DE_COMM_REVS_NOTE_EXAM
      ,[X_GI_NO_VERS_EXAM]				AS GI3_NO_VERS_EXAM
      ,[X_GI_V_VECT_REPN_CAND_EXAM]		AS GI3_V_VECT_REPN_CAND_EXAM
      ,T1.PAR_ROW_ID__SSRV_REQ			AS GI3_C_ROWD_DEMN_DECL
      ,T1.PAR_ROW_ID__SPROD_CON			AS GI3_C_ROWD_COMP
	  , CAST(T1.X_GI_V_VECT_CORR_EXAM AS NVARCHAR(MAX)) AS GI3_V_VECT_CORR_EXAM
	  ,CAST(T1.X_GI_V_VECT_EXAM AS NVARCHAR(max)) AS GI3_V_VECT_EXAM
FROM 
	[dbo].[CX_INSC_EXAM] T1 WITH (NOLOCK)
LEFT OUTER JOIN [S_USER] AS U1 WITH (NOLOCK)
    ON T1.[CREATED_BY] = U1.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U2 WITH (NOLOCK)
    ON T1.[LAST_UPD_BY] = U2.[ROW_ID]

WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
