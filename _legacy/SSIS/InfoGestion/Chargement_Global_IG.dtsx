              <DTS:Variables />
              <DTS:ObjectData>
                <pipeline
                  version="1">
                  <components>
                    <component
                      refId="Package\embarque\IBH\Version certificat IBH\CX_VERS_PERM"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SqlServer v10; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="CX_VERS_PERM"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET LANGUAGE ENGLISH;

SELECT 
	   T1.[ROW_ID] AS						GI3_C_ROWD_VERS_CERT_IBH
      ,CONVERT(DATETIME, T1.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS GI3_D_CRET
      ,CONVERT(DATETIME, T1.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS GI3_D_MODF
      ,T1.CREATED_BY AS						GI3_C_UTIL_CRET
	  ,T1.LAST_UPD_BY AS					GI3_C_UTIL_MODF
	  ,GETDATE() AS							GI3_D_INS_INIT
	  ,T1.PAR_ROW_ID_CXPERMIS_RBQ			GI3_C_ROWD_CERT_IBH
	  ,T1.PAR_ROW_ID_SSRV_REQ				GI3_C_ROWD_DEMN_DECL
	  ,T1.X_GI_C_STAT_VERS_PERM				GI3_C_STAT_VERS_CERT_IBH
	  ,T1.X_GI_D_FIN_VERS_PERM				GI3_D_FIN_VERS_CERT_IBH
	  ,T1.X_GI_D_DEBT_VALD_PERM				GI3_D_DEBT_VALD_CERT_IBH
	  ,T1.X_GI_D_FIN_VALD_PERM				GI3_D_FIN_VALD_CERT_IBH
	  ,T1.X_GI_DE_COMM_VERS_PERM			GI3_DE_COMM_VERS_CERT_IBH
	  ,T1.X_GI_C_CATG_CERT_IBH				GI3_C_CATG_CERT_IBH
	  ,T1.X_GI_C_RAIS_FIN_VERS_CIBH			GI3_C_RAIS_FIN_VERS_CIBH
	  ,T1.X_GI_C_MOTF_FIN_VERS_CIBH			GI3_C_MOTF_FIN_VERS_CIBH
	  ,T1.X_GI_NB_JOUR_SUSP_VERS_CIBH		GI3_NB_JOUR_SUSP_VERS_CIBH
	  ,T1.X_GI_D_FIN_SUSP_VERS_CIBH			GI3_D_FIN_SUSP_VERS_CIBH
	  ,T1.X_GI_DE_DECS_REGS_VERS_CIBH		GI3_DE_DECS_REGS_VERS_CIBH

FROM CX_VERS_PERM AS T1 WITH (NOLOCK)
INNER JOIN [CX_PERMIS_RBQ] AS T2 ON T2.ROW_ID = T1.PAR_ROW_ID_CXPERMIS_RBQ
LEFT OUTER JOIN [S_USER] AS U1 WITH (NOLOCK) ON T1.[CREATED_BY] = U1.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U2 WITH (NOLOCK) ON T1.[LAST_UPD_BY] = U2.[ROW_ID]

WHERE 
	T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')
	AND T2.X_GI_C_TYPE_PERM = 'IBH'</property>
