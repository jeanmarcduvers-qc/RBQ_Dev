                        <component
                          refId="Package\embarque\Phase 1 - Intervenants - Sites- Adresses - Interlocuteurs - LOV\Audits\Extraction audit\Source OLE DB"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                          description="Source OLE DB"
                          name="Source OLE DB"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="Commande SQL à exécuter."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select AUD.ROW_ID,
		AUD.TBL_RECORD_ID
                  ,cast(case when substring (AUD.AUDIT_LOG,1,28) = '2*C27*X_SR_ID11*INTRST_QNTY2'
                        then substring(AUD.AUDIT_LOG,29,100)          
                        when substring (AUD.AUDIT_LOG,1,32) = '2*C27*X_SR_ID15*X_CORRECTION_DT2'
                        then substring(AUD.AUDIT_LOG,33,100)
                        when substring (AUD.AUDIT_LOG,1,32) = '2*C27*X_SR_ID15*X_CORRECTION_DT2'
                        then substring(AUD.AUDIT_LOG,33,100)
                        when substring (AUD.AUDIT_LOG,1,33) = '2*C27*X_SR_ID16*RELATION_TYPE_CD2'
                        then substring(AUD.AUDIT_LOG,34,100)
                        when substring (AUD.AUDIT_LOG,1,25) = '2*C27*X_SR_ID9*SIGNED_DT2'
                        then substring(AUD.AUDIT_LOG,26,100)

                         when substring (AUD.AUDIT_LOG,1,39) = '2*C37*X_SR_ID11*INTRST_QNTY9*SIGNED_DT2'
                        then substring(AUD.AUDIT_LOG,40,100)
                        when substring (AUD.AUDIT_LOG,1,46) = '2*C37*X_SR_ID15*X_CORRECTION_DT11*INTRST_QNTY2'
                        then substring(AUD.AUDIT_LOG,47,100)
                        when substring (AUD.AUDIT_LOG,1,51) = '2*C37*X_SR_ID15*X_CORRECTION_DT16*RELATION_TYPE_CD2'
                        then substring(AUD.AUDIT_LOG,52,100)
                        when substring (AUD.AUDIT_LOG,1,43) = '2*C37*X_SR_ID15*X_CORRECTION_DT9*SIGNED_DT2'
                        then substring(AUD.AUDIT_LOG,44,100)
                        when substring (AUD.AUDIT_LOG,1,47) = '2*C37*X_SR_ID16*RELATION_TYPE_CD11*INTRST_QNTY2'
                        then substring(AUD.AUDIT_LOG,48,100)
                        when substring (AUD.AUDIT_LOG,1,41) = '2*C37*X_SR_ID16*RELATION_TYPE_CD6*END_DT2'
                        then substring(AUD.AUDIT_LOG,42,100)
                        when substring (AUD.AUDIT_LOG,1,44) = '2*C37*X_SR_ID16*RELATION_TYPE_CD9*SIGNED_DT2'
                        then substring(AUD.AUDIT_LOG,45,100)
                        when substring (AUD.AUDIT_LOG,1,33) = '2*C37*X_SR_ID9*SIGNED_DT6*END_DT2'
                        then substring(AUD.AUDIT_LOG,34,100)

                        when substring (AUD.AUDIT_LOG,1,57) = '2*C47*X_SR_ID15*X_CORRECTION_DT11*INTRST_QNTY9*SIGNED_DT2'
                        then substring(AUD.AUDIT_LOG,58,100)
                        when substring (AUD.AUDIT_LOG,1,65) = '2*C47*X_SR_ID15*X_CORRECTION_DT16*RELATION_TYPE_CD11*INTRST_QNTY2'
                        then substring(AUD.AUDIT_LOG,66,100)
                        when substring (AUD.AUDIT_LOG,1,62) = '2*C47*X_SR_ID15*X_CORRECTION_DT16*RELATION_TYPE_CD9*SIGNED_DT2'
                        then substring(AUD.AUDIT_LOG,63,100)
                        when substring (AUD.AUDIT_LOG,1,58) = '2*C47*X_SR_ID16*RELATION_TYPE_CD11*INTRST_QNTY9*SIGNED_DT2'
                        then substring(AUD.AUDIT_LOG,69,100)
                        when substring (AUD.AUDIT_LOG,1,52) = '2*C47*X_SR_ID16*RELATION_TYPE_CD9*SIGNED_DT6*END_DT2'
                        then substring(AUD.AUDIT_LOG,53,100)

 
                         when substring (AUD.AUDIT_LOG,1,65) = '2*C57*X_SR_ID15*X_CORRECTION_DT11*INTRST_QNTY9*SIGNED_DT6*END_DT2'
                        then substring(AUD.AUDIT_LOG,66,100)
                        when substring (AUD.AUDIT_LOG,1,73) = '2*C57*X_SR_ID15*X_CORRECTION_DT16*RELATION_TYPE_CD11*INTRST_QNTY6*END_DT2'
                        then substring(AUD.AUDIT_LOG,74,100)
                        when substring (AUD.AUDIT_LOG,1,76) = '2*C57*X_SR_ID15*X_CORRECTION_DT16*RELATION_TYPE_CD11*INTRST_QNTY9*SIGNED_DT2'
                        then substring(AUD.AUDIT_LOG,77,100)

                        when substring (AUD.AUDIT_LOG,1,84) = '2*C67*X_SR_ID15*X_CORRECTION_DT16*RELATION_TYPE_CD11*INTRST_QNTY9*SIGNED_DT6*END_DT2'
                        then substring(AUD.AUDIT_LOG,85,100)
                        
                         else NULL end as varchar(100)) as AUDIT_LOG_TEXT

                  ,CASE 
    WHEN AUD.[CREATED] &lt; '2007-03-11 07:00:00.000' THEN
        CASE
            WHEN AUD.[CREATED] &gt; DATEADD(ww, -52 * ABS(DATEPART(yy, AUD.[CREATED]) - 2007), '2007-04-01 07:00:00.000') OR
                 AUD.[CREATED] &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, AUD.[CREATED]) - 2007), '2007-10-28 06:00:00.000')
            THEN
                 DATEADD(hh, -5, AUD.[CREATED])
            ELSE
                 DATEADD(hh, -4, AUD.[CREATED])
        END
    ELSE
        CASE
            WHEN AUD.[CREATED] &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, AUD.[CREATED]) - 2007), '2007-03-11 07:00:00.000') OR
                 AUD.[CREATED] &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, AUD.[CREATED]) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, AUD.[CREATED])
            ELSE
                 DATEADD(hh, -4, AUD.[CREATED])
        END
  END AS [GI3_D_CRET]
                        from dbo.S_AUDIT_ITEM AUD WITH (NOLOCK)

where  AUD.TBL_NAME = 'S_PROD_CON'
            AND AUD.OPERATION_CD IN ('Modify')
            AND CHARINDEX('X_SR_ID', AUD.AUDIT_LOG)&gt;0
            and (substring (AUD.AUDIT_LOG,1,5) = '2*C27'
            or substring (AUD.AUDIT_LOG,1,5) = '2*C37'
            or substring (AUD.AUDIT_LOG,1,5) = '2*C47'
            or substring (AUD.AUDIT_LOG,1,5) = '2*C57'
            or substring (AUD.AUDIT_LOG,1,5) = '2*C67')</property>
                            <property
                              dataType="System.String"
                              description="Variable contenant la commande SQL à exécuter."
                              name="SqlCommandVariable"></property>
                            <property
                              dataType="System.Int32"
                              description="Spécifie la page de codes de la colonne à utiliser lorsque les informations de page de codes ne sont pas disponibles à partir de la source de données."
                              name="DefaultCodePage">1252</property>
                            <property
                              dataType="System.Boolean"
                              description="Force l'utilisation de la valeur de propriété DefaultCodePage lors de la description des données de caractères."
                              name="AlwaysUseDefaultCodePage">false</property>
                            <property
                              dataType="System.Int32"
                              description="Spécifie le mode utilisé pour accéder à la base de données."
                              name="AccessMode"
                              typeConverter="AccessMode">2</property>
                            <property
