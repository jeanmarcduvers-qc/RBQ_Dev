                    <component
                      refId="Package\embarque\Produits et compétences\Droit Exercice\SRC_siebeldb S_DOC_AGREE"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                      description="Source OLE DB"
                      name="SRC_siebeldb S_DOC_AGREE"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET LANGUAGE ENGLISH

SELECT
    T1.[ROW_ID] AS [GI3_C_ROWD_DROT_EXER],
    T2.[ROW_ID] AS [GI3_C_ROWD_INTRVN],
    T1.[X_ASSOCIATION] AS [GI3_C_ASSC],
    T1.[X_CATEGORIE] AS [GI3_C_CATG],
    T1.[X_CAUTIONNEUR] AS [GI3_C_CAUT],
    T1.[X_MODE] AS [GI3_C_MODE],
    T1.[AGREE_CD] AS [GI3_C_TYPE_DROT_EXER],
    T1.[X_CAUTION_DT] AS [GI3_D_CAUT],
     
CONVERT(DATETIME, T1.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_CRET],
    T1.[DUE_DT] AS [GI3_D_ECHN],
     T1.[APPR_DT] AS [GI3_D_EMIS],
     
CONVERT(DATETIME, T1.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_MODF],
    T1.[X_NUM_CAUTION] AS [GI3_N_CAUT],
    T1.[AGREE_NUM] AS [GI3_C_LICN],
    T1.[X_JOURS_RESTR] AS [GI3_Q_JOUR_REST],
    T1.[STAT_CD] AS [GI3_S_DROT_EXER],
    T1.[X_MONTANT] AS [GI3_V_MONT],
 CASE
        WHEN U1.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U1.[LOGIN]
    END AS [GI3_C_UTIL_CRET],
    CASE
        WHEN U2.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U2.[LOGIN]
    END AS [GI3_C_UTIL_MODF],
    GETDATE() AS [GI3_D_INS_INIT],
    NULL AS [GI3_D_INS_MODF],
    T1.[X_CERTIFICAT_DT] AS [GI3_D_CERTIFICAT_1],
    T1.[X_CERTIFICAT_DT_2] [GI3_D_CERTIFICAT_2],
    T1.[X_CERTIFICAT_DT_3] AS [GI3_D_CERTIFICAT_3],
    T1.[X_EMET_CERTIFICAT] AS [GI3_C_EMET_CERTIFICAT_1],
    T1.[X_EMET_CERTIFICAT_2] AS [GI3_C_EMET_CERTIFICAT_2],
    T1.[X_EMET_CERTIFICAT_3] AS [GI3_C_EMET_CERTIFICAT_3],
    T1.[X_NUM_CERTIFICAT] AS [GI3_N_CERTIFICAT_1],
    T1.[X_NUM_CERTIFICAT_2] AS [GI3_N_CERTIFICAT_2],
    T1.[X_NUM_CERTIFICAT_3] AS [GI3_N_CERTIFICAT_3],
  T1.[X_DATE_ANNULATION_CAUTION] AS [GI3_D_ANNUL_CAUTION],     
  CASE 
    WHEN T1.[X_DATE_DERNIER_CTRL] &lt; '2007-03-11 07:00:00.000' THEN
        CASE
            WHEN T1.[X_DATE_DERNIER_CTRL] &gt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[X_DATE_DERNIER_CTRL]) - 2007), '2007-04-01 07:00:00.000') OR
                 T1.[X_DATE_DERNIER_CTRL] &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[X_DATE_DERNIER_CTRL]) - 2007), '2007-10-28 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[X_DATE_DERNIER_CTRL])
            ELSE
                 DATEADD(hh, -4, T1.[X_DATE_DERNIER_CTRL])
        END
    ELSE
        CASE
            WHEN T1.[X_DATE_DERNIER_CTRL] &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[X_DATE_DERNIER_CTRL]) - 2007), '2007-03-11 07:00:00.000') OR
                 T1.[X_DATE_DERNIER_CTRL] &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[X_DATE_DERNIER_CTRL]) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[X_DATE_DERNIER_CTRL])
            ELSE
                 DATEADD(hh, -4, T1.[X_DATE_DERNIER_CTRL])
        END
  END AS [GI3_D_DERN_CONT],
    T1.[X_A_CONTROLER] AS [GI3_I_A_CONT],
    T3.[ROW_ID] AS [GI3_C_ROWD_INTRL],
    T1.[ALL_PROD_FLG] AS [GI3_I_EN_RECL_],
    T1.X_GI_D_ANNL_PREM_CERT_GARN AS [GI3_D_ANNL_PREM_CERT_GARN],
    T1.X_GI_D_ANNL_DEUX_CERT_GARN AS [GI3_D_ANNL_DEUX_CERT_GARN],
    T1.X_GI_D_ANNL_TROS_CERT_GARN AS [GI3_D_ANNL_TROS_CERT_GARN],
	T1.PR_CAUTION_ID AS GI3_C_CAUTION_PRINCIPALE


FROM
    [S_DOC_AGREE] AS T1 WITH (NOLOCK)
LEFT OUTER JOIN [S_USER] AS U1 WITH (NOLOCK)
    ON T1.[CREATED_BY] = U1.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U2 WITH (NOLOCK)
    ON T1.[LAST_UPD_BY] = U2.[ROW_ID]
LEFT OUTER JOIN [S_ORG_EXT] AS T2 WITH (NOLOCK)
	ON T1.[TARGET_OU_ID] = T2.[ROW_ID]
LEFT OUTER JOIN [S_CONTACT] AS T3 WITH (NOLOCK)
	ON T1.[X_REP_MAS_ID] = T3.[PAR_ROW_ID]

WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
