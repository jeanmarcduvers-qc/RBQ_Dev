                        <component
                          refId="Package\embarque\Phase 1 - Intervenants - Sites- Adresses - Interlocuteurs - LOV\Lien Site + Appareil\Appareils\Source OLE DB"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                          description="Source OLE DB"
                          name="Source OLE DB"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="Commande SQL à exécuter."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET LANGUAGE ENGLISH

SELECT
--CLÉ PRIMAIRE
    T1.[ROW_ID] AS [GI3_C_ROWD_APPR],
--CLÉ ÉTRANGÈRE
    T6.[ROW_ID] AS [GI3_C_ROWD_SITE],
    T7.[ROW_ID] AS [GI3_C_ROWD_INTRVN_ENTRT],
    T8.[ROW_ID] AS [GI3_C_ROWD_INTRVN_ESSAI],
    T9.[ROW_ID] AS [GI3_C_ROWD_INTRVN_FOURN],
    T10.[ROW_ID] AS [GI3_C_ROWD_INTRVN_PARCH],
--APPAREIL GÉNÉRAL
    T1.LCNS_EXP_DT AS [GI3_D_ESSAI_APL],

    T1.CAUTION_FLG AS [GI3_I_FACTR],
    T1.ASSET_NUM AS [GI3_N_APPR],
    T2.ATTRIB_06 AS [GI3_N_APPR_ANCN],
    left(T1.DESC_TEXT, 250) AS [GI3_N_APPR_LIEU_APL],
    T1.BAR_CODE_NUM AS [GI3_N_IMMAT_APL],
    T1.OWNER_ASSET_NUM AS [GI3_N_NEC_CRN],
    T1.SERIAL_NUM AS [GI3_N_SERIE],
    T2.ATTRIB_01 AS [GI3_NM_FABR_APL],
    T2.ATTRIB_44 AS [GI3_NM_FABR_CONTR],
    T1.STATUS_CD AS [GI3_S_APPR],
    YEAR(

  CASE 
    WHEN T1.START_DT &lt; '2007-03-11 07:00:00.000' THEN
        CASE
            WHEN T1.START_DT &gt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.START_DT) - 2007), '2007-04-01 07:00:00.000') OR
                 T1.START_DT &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.START_DT) - 2007), '2007-10-28 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.START_DT)
            ELSE
                 DATEADD(hh, -4, T1.START_DT)
        END
    ELSE
        CASE
            WHEN T1.START_DT &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.START_DT) - 2007), '2007-03-11 07:00:00.000') OR
                 T1.START_DT &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.START_DT) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.START_DT)
            ELSE
                 DATEADD(hh, -4, T1.START_DT)
        END
  END 

    ) AS [GI3_V_ANNE_DEBT_FACT],
    YEAR(
  CASE 
    WHEN T5.LAST_ORDER_DT &lt; '2007-03-11 07:00:00.000' THEN
        CASE
            WHEN T5.LAST_ORDER_DT &gt; DATEADD(ww, -52 * ABS(DATEPART(yy, T5.LAST_ORDER_DT) - 2007), '2007-04-01 07:00:00.000') OR
                 T5.LAST_ORDER_DT &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T5.LAST_ORDER_DT) - 2007), '2007-10-28 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T5.LAST_ORDER_DT)
            ELSE
                 DATEADD(hh, -4, T5.LAST_ORDER_DT)
        END
    ELSE
        CASE
            WHEN T5.LAST_ORDER_DT &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, T5.LAST_ORDER_DT) - 2007), '2007-03-11 07:00:00.000') OR
                 T5.LAST_ORDER_DT &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T5.LAST_ORDER_DT) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T5.LAST_ORDER_DT)
            ELSE
                 DATEADD(hh, -4, T5.LAST_ORDER_DT)
        END
  END 


    ) AS [GI3_V_ANNE_DERN_FACT],
    YEAR(T1.INSTALL_DT) AS [GI3_V_ANNE_INSTAL],
    T1.CAPITALIZED_CD AS [GI3_V_CLASS_CHARG],
    LEFT(T2.X_COMMENTAIRES, 6000) AS [X_COMM],
    T1.PARTNER_BRANCH AS [GI3_V_MODL_CONTR],
    T1.PREMIUM AS [GI3_V_VITS_METRE_SECND_APL],
    T1.MAKE_CD AS [GI3_C_GENR_APPR],
    CASE WHEN T2.ATTRIB_03 IS NOT NULL THEN T2.ATTRIB_05
         WHEN T2.ATTRIB_05 IS NOT NULL THEN T2.ATTRIB_03
         ELSE NULL
    END AS [GI3_C_MODL],
	T1.METER_LOC AS GI3_N_ANCN_MODL_APPR,
    T1.BODY_STYLE_CD AS [GI3_C_NORME_REF],
    T1.MODEL_CD AS [GI3_C_SOUS_GENR_APPR],
    T1.SUB_TYPE_CD AS [GI3_C_TYPE_APPR],
    T1.BUILD AS [GI3_C_TYPE_GAINE],
	ISNULL(T2.X_GI_I_APPR_SOUM_INTM, 'N') AS [GI3_I_APPR_SOUM_INTM],

--APPAREIL DE LEVAGE
    T1.EFFICIENCY_RATING AS [GI3_V_COURSE_AS],
    T1.CURRENT_BAL AS [GI3_V_CTRA_ENTR_AS],
    T1.DLR_INV_PRICE AS [GI3_V_LARGR_MARCH_AS],
    T2.ATTRIB_15 AS [GI3_V_ANGL_INCL_AS],
    T1.APR AS [GI3_Q_CABLE_AS],
    T1.EXTD_QTY AS [GI3_Q_ETAGE_AS],
    T1.MODEL_YR AS [GI3_Q_PALR_AS],
    T1.EXTENDED_QTY AS [GI3_N_CAPACITE_AS],
    T1.LAST_TEST_DT AS [GI3_D_ESSAI_PARA_AS],
    T1.OPER_STATUS_CD AS [GI3_C_CMDE_PRTE_CABN_AS],
    T1.COMPANY_CD AS [GI3_C_COMND_AS],
    T1.APY AS [GI3_C_DIMSN_CABLE_AS],
    T1.NEW_USD_CD AS [GI3_C_GENR_PORTE_CABN_AS],
    T1.METER_USE_CD AS [GI3_C_GENR_PORTE_PALR_AS],
    T1.PROM_INTEG_ID AS [GI3_C_PROT_OUV_PLCH_AS],
    T1.REF_NUMBER_3 AS [GI3_C_PROT_TABL_SURB_AS],
    T1.CFG_TYPE_CD AS [GI3_C_TYPE_MACH_AS],
    T1.LCNS_NUM AS [GI3_C_VROU_PRTE_CABN_AS],    

      CASE 
    WHEN T1.END_DT &lt; '2007-03-11 07:00:00.000' THEN
        CASE
            WHEN T1.END_DT &gt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.END_DT) - 2007), '2007-04-01 07:00:00.000') OR
                 T1.END_DT &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.END_DT) - 2007), '2007-10-28 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.END_DT)
            ELSE
                 DATEADD(hh, -4, T1.END_DT)
        END
    ELSE
        CASE
            WHEN T1.END_DT &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.END_DT) - 2007), '2007-03-11 07:00:00.000') OR
                 T1.END_DT &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.END_DT) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.END_DT)
            ELSE
                 DATEADD(hh, -4, T1.END_DT)
        END
  END AS [GI3_D_CONTR_ENTRT_AS],
    T1.STOCK_NUM AS [GI3_C_TYPE_TABL_AS],
    T1.VALUE_BASIS_CD AS [GI3_C_TYPE_PARCH_CABN_AS],
    T1.CFG_VALDN_STAT_CD AS [GI3_C_TYPE_PARCH_CONTR_POIDS_AS],
    T1.QTY AS [GI3_Q_CHAIN_AS],

--APPAREIL SOUS PRESSION
    T2.ATTRIB_20 AS [GI3_C_DIAMT_ASP],
    T2.ATTRIB_19 AS [GI3_V_LONGR_ASP],
    T1.SVC_PER_PROD_AMT AS [GI3_V_CHARG_SYST_FRIG_ASP],
    T2.ATTRIB_46 AS [GI3_NM_MANFC_ASP],
    T2.ATTRIB_36 AS [GI3_NM_REFRIG_ASP],
    T2.ATTRIB_38 AS [GI3_N_SERIE_ASP],
    T1.PARTNER_BANK AS [GI3_N_CERTF_ASP],
    T2.ATTRIB_18 AS [GI3_V_PRESN_ASP],
    T1.X_GI_C_PRES_APPR_SPRE AS [GI3_C_PRES_APPR_SPRE],
    T2.ATTRIB_17 AS [GI3_V_PRESN_MAX_ASP],
    T2.ATTRIB_21 AS [GI3_V_PUISN_CHADR_ASP],
    T1.CURRENT_BAL AS [GI3_V_PUISN_SYST_ASP],
    T2.ATTRIB_22 AS [GI3_V_SURFC_CHADR_ASP],
    T1.CFG_STATE_CD AS [GI3_C_TYPE_CABN_AS],
    T1.EXT_COLOR_CD AS [GI3_C_TYPE_CHADR_ASP],
    case when T1.MAKE_CD in ('01','02', '03') then '1' when T1.MAKE_CD in ('04', '05', '06', '17', '18', '19') then '2' when T1.MAKE_CD in ('07', '08', '09','10', '11', '12', '13', '14', '15', '16', '20') then '4' else '' end AS [GI3_C_FREQN_INSPC_ASP],
    T1.SUSP_DRUG_TYPE_CD AS [GI3_NM_CIE_ASSUR_ASP],

--REMONTÉE MÉCANIQUE
    T1.INTR_RATE AS [GI3_V_PRESN_RM],
    T1.METER_CNT AS [GI3_V_VITS_RM],
    T1.PROFIT AS [GI3_C_DENVL_RM],
    T1.COST_LST_ID AS [GI3_C_FABR_PINCE_RM],
    T1.CHANNEL_TYPE_CD AS [GI3_C_EMPLC_MACHN_RM],
    T1.CAPACITY AS [GI3_C_ESPCM_MIN_SUSPN_RM],
    T1.TRADEIN_TYPE_CD AS [GI3_C_GENR_INTRP_DERLM_RM],
    T1.RATE_EXCEPTION AS [GI3_C_INTRP_DERLM_RM],
    T1.OWNERSHIP_TYPE_CD AS [GI3_C_SYSTM_TENSN_RM],
    T1.LOAD_ADDED AS [GI3_V_LONGR_RM],
    T1.AVAIL_BAL AS [GI3_V_DIAM_CABL_TRAC_RM],
    T1.ANNUAL_USG AS [GI3_Q_MAX_SUSPN_RM],
    T2.ATTRIB_45 AS [GI3_NM_FABR_PINCE_RM],
    T1.LOB_CD AS [GI3_I_FREIN_SERVC_RM],
    T1.LOAD_PERIOD_CD AS [GI3_I_FREIN_URGC_RM],
    T1.METER_TYPE_CD AS [GI3_I_POULI_FLOTN_RM],
    T1.PROP_TYPE_CD AS [GI3_I_UTILS_DESCT_RM],
    T1.REF_NUMBER_1 AS [GI3_I_FREIN_ANTI_RECUL_RM],
    T1.UOM_CD AS [GI3_C_TYPE_POULIE_RM],
    T1.AVERAGE_BAL AS [GI3_Q_MIN_SUSPN_RM],

--JEUX MÉCANIQUE
    T1.HLTHACCNT_TYPE_CD AS [GI3_C_TYPE_VITS_JM],
    T1.BILLPAY_FLG AS [GI3_I_FREIN_JM],
    T2.ATTRIB_16 AS [GI3_N_MAX_PERS_JM],
    T1.REF_NUMBER_2 AS [GI3_NM_APPR_JM],
    T2.ATTRIB_23 AS [GI3_Q_NACL_JM],
    T1.RATE_CD AS [GI3_C_SOURC_ENERG_JM],
    T2.ATTRIB_14 AS [GI3_V_VITS_MIN_JM],
    T1.PNSN_SUBTYPE_CD AS [GI3_C_CATGR_JM],
    T2.ATTRIB_24 AS [GI3_V_VITS_ENRG_JM],
    T2.ATTRIB_25 AS [GI3_V_VITS_MAX_JM],

--NEW
	T1.X_GI_D_MM_DEBT_PERD_ANNL_SERV AS [GI3_D_MM_DEBT_PERD_ANNL_SERV],
	T1.X_GI_D_MM_FIN_PERD_ANNL_SERV AS [GI3_D_MM_FIN_PERD_ANNL_SERV],

-- ISP
	T2.X_GI_C_ASSJ_ISP AS GI3_C_ASSJ_ISP,
	T2.X_GI_C_CONF_ISP AS GI3_C_CONF_ISP,
	CASE 
		WHEN T2.ATTRIB_04 IS NOT NULL THEN
			T2.ATTRIB_04
		ELSE
			T2.ATTRIB_01
	END							AS GI3_C_FABR_APPR,
	CASE
		WHEN T2.ATTRIB_04 IS NOT NULL THEN
			T2.ATTRIB_01
	END							AS GI3_NM_ANCN_FABR_APPR,
	T2.ATTRIB_43				AS GI3_NM_ANCN_FABR_CONTR,

--SIEBEL   
  CASE 
    WHEN T1.CREATED &lt; '2007-03-11 07:00:00.000' THEN
        CASE
            WHEN T1.CREATED &gt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.CREATED) - 2007), '2007-04-01 07:00:00.000') OR
                 T1.CREATED &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.CREATED) - 2007), '2007-10-28 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.CREATED)
            ELSE
                 DATEADD(hh, -4, T1.CREATED)
        END
    ELSE
        CASE
            WHEN T1.CREATED &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.CREATED) - 2007), '2007-03-11 07:00:00.000') OR
                 T1.CREATED &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.CREATED) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.CREATED)
            ELSE
                 DATEADD(hh, -4, T1.CREATED)
        END
  END AS [GI3_D_CRET],
     

   CASE 
    WHEN T1.LAST_UPD &lt; '2007-03-11 07:00:00.000' THEN
        CASE
            WHEN T1.LAST_UPD &gt;DATEADD(ww, -52 * ABS(DATEPART(yy, T1.LAST_UPD) - 2007), '2007-04-01 07:00:00.000') OR
                 T1.LAST_UPD &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.LAST_UPD) - 2007), '2007-10-28 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.LAST_UPD)
            ELSE
                 DATEADD(hh, -4, T1.LAST_UPD)
        END
    ELSE
        CASE
            WHEN T1.LAST_UPD &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.LAST_UPD) - 2007), '2007-03-11 07:00:00.000') OR
                 T1.LAST_UPD &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.LAST_UPD) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.LAST_UPD)
            ELSE
                 DATEADD(hh, -4, T1.LAST_UPD)
        END
  END AS [GI3_D_MODF],
    U1.LOGIN AS [GI3_C_UTIL_CRET],
    U2.LOGIN AS [GI3_C_UTIL_MODF],
    GETDATE() AS [GI3_D_INS_INIT],
    NULL AS [GI3_D_INS_MODF],
    T1.X_GI_NM_APPR_PROP AS [GI3_NM_SELN_PROP],
   T1.VERSION AS GI3_DE_COMM_PORT_PALR,
   T1.INSTALL_DT AS GI3_D_INST,
   T1.BRANCH_ID AS GI3_C_ROWD_INTRVN,
   T1.X_GI_C_MODE_TRAT_EAU AS [GI3_C_MODE_TRAT_EAU],
   T1.X_GI_C_TYPE_TRAT_EAU AS [GI3_C_TYPE_TRAT_EAU],
   T1.X_GI_C_TYPE_UTIL_APPR AS [GI3_C_TYPE_UTIL_APPR],
   T1.X_GI_C_TYPE_PERD_SERV AS [GI3_C_TYPE_PERD_SERV],
   T1.X_GI_Q_TOUR_REFR_EAU AS [GI3_Q_TOUR_REFR_EAU],
   T1.X_GI_Q_TOUR_PARE_GOUT AS [GI3_Q_TOUR_PARE_GOUT],
   T1.X_GI_DE_PREC_TYPE_UTIL_APPR AS [GI3_DE_PREC_TYPE_UTIL_APPR],
   T1.X_GI_DE_PREC_TYPE_TRAT_EAU AS [GI3_DE_PREC_TYPE_TRAT_EAU],
   T1.X_PAR_ROW_ID_SASSET_JMAN As GI3_C_ROWD_APPR_JMAN, 
   T2.ATTRIB_02 AS GI3_N_SERI_EPUR,
   T2.ATTRIB_37 AS GI3_N_NEC_EPUR,
   T2.X_GI_I_ENTR_BOUT AS GI3_I_ENTR_BOUT,
   T2. X_GI_I_LIVR_BOUT AS GI3_I_LIVR_BOUT,
   T2.X_GI_I_LIVR_VRAC AS GI3_I_LIVR_VRAC,
   T2.X_GI_I_CENT_RAVT_BOUT AS GI3_I_CENT_RAVT_BOUT,
   T2.X_GI_I_CENT_RAVT_VEHC_APRP AS GI3_I_CENT_RAVT_VEHC_APRP,
   T2.X_GI_I_CENT_RAVT_VEHC_SPRP AS GI3_I_CENT_RAVT_VEHC_SPRP,
   T2.X_GI_I_STAT_REMP_FIXE AS GI3_I_STAT_REMP_FIXE,
   T2.X_GI_I_STAT_REMP_MOBL AS GI3_I_STAT_REMP_MOBL,
   T2.X_GI_I_GAZ_NATR_COMP_BOUT AS GI3_I_GAZ_NATR_COMP_BOUT,
   T2.X_GI_I_GAZ_NATR_COMP_VEHC AS GI3_I_GAZ_NATR_COMP_VEHC,
   T2.X_GI_I_GAZ_NATR_COMP_FIXE AS GI3_I_GAZ_NATR_COMP_FIXE,
   T2.X_GI_I_GAZ_NATR_COMP_MOBL AS GI3_I_GAZ_NATR_COMP_MOBL,
   T2.X_GI_I_GNL_MOIN_QUAT_TONN AS GI3_I_GNL_MOIN_QUAT_TONN,
   T2.X_GI_I_GNL_PLUS_QUAT_TONN AS GI3_I_GNL_PLUS_QUAT_TONN,
   T2.X_GI_Q_NOMB_APPR_CHAF AS GI3_Q_NOMB_APPR_CHAF,
   T2.X_GI_Q_NOMB_APPR_CHAF_EAU AS GI3_Q_NOMB_APPR_CHAF_EAU,
   T2.X_GI_Q_NOMB_APPR_CUIS AS GI3_Q_NOMB_APPR_CUIS,
   T2.X_GI_Q_NOMB_APPR_PROC AS GI3_Q_NOMB_APPR_PROC,
   T2.X_GI_Q_NOMB_APPR_AUTR AS GI3_Q_NOMB_APPR_AUTR,
   T2.X_GI_DE_PREC_APPR_AUTR AS GI3_DE_PREC_APPR_AUTR

   -- Equipements petroliers
    ,T1.PAR_ROW_ID_CX_NORME_APPR AS GI3_C_ROWD_NORM_APPR_SIMPL
	,T1.PAR_ROW_ID_CX_NORME_APPR_INTR AS GI3_C_ROWD_NORM_APPR_INTR
	,T1.PAR_ROW_ID_CX_NORME_APPR_EXTR AS GI3_C_ROWD_NORM_APPR_EXTR
	,T1.X_PAR_ROW_ID_SORG_EXT_CANL AS GI3_C_ROWD_SITE_CANL
	,T1.STATUS_CHG_DT AS GI3_D_STAT_APPR
	,T2.X_GI_D_RETR_APPR AS GI3_D_RETR_APPR
	,T2.X_GI_D_RECR_APPR AS GI3_D_RECR_APPR
	,T2.X_GI_C_TYPE_CONS_APPR AS GI3_C_TYPE_CONS_APPR
	,T2.X_GI_C_TYPE_MATR_PSIM_APPR AS GI3_C_TYPE_MATR_PSIM_APPR
	,T2.X_GI_C_TYPE_MATR_PINT_APPR AS GI3_C_TYPE_MATR_PINT_APPR
	,T2.X_GI_C_TYPE_MATR_PEXT_APPR AS GI3_C_TYPE_MATR_PEXT_APPR
	,T2.X_GI_C_TYPE_LOCL_APPR AS GI3_C_TYPE_LOCL_APPR
	,T2.X_GI_C_TYPE_PROT_APPR AS GI3_C_TYPE_PROT_APPR
	,T2.X_GI_C_TYPE_EMPL_APPR AS GI3_C_TYPE_EMPL_APPR
	,ISNULL(T2.X_GI_I_FIN_LUCR_APPR, 'N') AS GI3_I_FIN_LUCR_APPR
	,T2.X_GI_N_AA_FREQ_VERF_APPR AS GI3_N_AA_FREQ_VERF_APPR
	,T2.X_GI_N_LITR_CAPC_TOTL_APPR AS GI3_N_LITR_CAPC_TOTL_APPR
	,ISNULL(T2.X_GI_I_RESR_SOUS_PERM_APPR, 'N') AS GI3_I_RESR_SOUS_PERM_APPR
	,ISNULL(T2.X_GI_I_DROT_ACQS_APPR, 'N') AS GI3_I_DROT_ACQS_APPR
	,T2.X_GI_DE_COMM_DIST_APPR AS GI3_DE_COMM_DIST_APPR
	,T2.X_GI_C_TYPE_UTIL_PART_APPR AS GI3_C_TYPE_UTIL_PART_APPR
	,T2.X_GI_DH_STAT_COUR_APPR AS GI3_DH_STAT_COUR_APPR
	,T2.X_GI_C_TYPE_DIST_APPR AS GI3_C_TYPE_DIST_APPR
	,T2.X_GI_C_ETAT_APPR AS GI3_C_ETAT_APPR
	,T2.X_GI_D_DERN_CHAN_ETAT_APPR AS GI3_D_DERN_CHAN_ETAT_APPR
	,ISNULL(T2.X_GI_I_DETC_FUIT_APPR, 'N') AS GI3_I_DETC_FUIT_APPR
	,T2.X_GI_V_LONG_CANL_APPR AS GI3_V_LONG_CANL_APPR
	,T2.X_GI_V_DIAM_CANL_APPR AS GI3_V_DIAM_CANL_APPR
	,T2.X_GI_V_CAPC_CANL_APPR AS GI3_V_CAPC_CANL_APPR
	,T1.PAR_ASSET_ID AS GI3_C_ROWD_APPR_RESR_COMP
	,CASE
		WHEN T1.PR_ASSET_ID = 'No Match Row Id' 
			THEN NULL
			ELSE T1.PR_ASSET_ID
	 END AS GI3_C_ROWD_APPR_COMP
	 ,T2.X_GI_C_TYPE_POMP_APPR AS GI3_C_TYPE_POMP_APPR
	 ,T2.X_GI_I_SYST_DETC_FUIT_APPR AS GI3_I_SYST_DETC_FUIT_APPR
	 ,T2.X_GI_D_VERF_DONN_TECH AS GI3_D_VERF_DONN_TECH
	 ,T2.X_GI_V_FREQ_INSP_INTR AS GI3_V_FREQ_INSP_INTR
	 ,T2.X_GI_V_FREQ_INSP_EXTR AS GI3_V_FREQ_INSP_EXTR
	 ,T2.X_GI_DE_EMPL_APPR AS GI3_DE_EMPL_APPR
	 ,T2.X_GI_DE_AUTR_GENR_APPR AS GI3_DE_AUTR_GENR_APPR

FROM
    S_ASSET AS T1 WITH (NOLOCK)
LEFT OUTER JOIN S_USER AS U1 WITH (NOLOCK)
    ON T1.CREATED_BY = U1.ROW_ID
LEFT OUTER JOIN S_USER AS U2 WITH (NOLOCK)
    ON T1.LAST_UPD_BY = U2.ROW_ID
LEFT OUTER JOIN S_ASSET_X AS T2 WITH (NOLOCK)
    ON T2.PAR_ROW_ID = T1.ROW_ID
LEFT OUTER JOIN (
                  SELECT
                    T3.[ASSET_ID],
                    ( MAX(T4.ORDER_DT) ) LAST_ORDER_DT
                  FROM
                    S_ORDER_ITEM AS T3 WITH (NOLOCK) 
                  INNER JOIN S_ORDER AS T4 WITH (NOLOCK)
                    ON T4.ROW_ID = T3.[ORDER_ID]
                  GROUP BY
                    T3.[ASSET_ID]
                ) AS T5
    ON T5.ASSET_ID = T1.ROW_ID
--SITE
LEFT OUTER JOIN [S_ORG_EXT] AS T6 WITH (NOLOCK)
    ON T1.[DLR_ID] = T6.[ROW_ID]
LEFT OUTER JOIN [S_ORG_EXT] AS T7 WITH (NOLOCK)
    ON T1.[SERV_ACCT_ID] = T7.[PAR_ROW_ID]
LEFT OUTER JOIN [S_ORG_EXT] AS T8 WITH (NOLOCK)
    ON T1.[FLEET_OU_ID] = T8.[ROW_ID]
LEFT OUTER JOIN [S_ORG_EXT] AS T9 WITH (NOLOCK)
    ON T1.[SUPPLIER_OU_ID] = T9.[ROW_ID]
LEFT OUTER JOIN [S_ORG_EXT] AS T10 WITH (NOLOCK)
    ON T1.[BILL_ACCNT_ID] = T10.[ROW_ID]
LEFT OUTER JOIN [S_CON_ADDR] AS T11 WITH (NOLOCK)
    ON T6.ROW_ID = T11.ACCNT_ID
       AND T11.[ADDR_TYPE_CD] = 'Principale'
       AND GETDATE() BETWEEN T11.START_DT AND ISNULL(T11.END_DT,'9999-01-01')
LEFT OUTER JOIN [S_ADDR_PER] AS T12 WITH (NOLOCK)
    ON T11.ADDR_PER_ID = T12.ROW_ID

WHERE
	T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')
	AND T1.TYPE_CD NOT IN ('Fin Account')</property>
