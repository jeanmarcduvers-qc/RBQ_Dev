                <pipeline
                  BLOBTempStoragePath=""
                  bufferTempStoragePath=""
                  engineThreads="5"
                  version="1">
                  <components>
                    <component
                      refId="Package\embarque\Documents\Documents Numériques\CX_DOCM_NUMR"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                      description="Source OLE DB"
                      name="CX_DOCM_NUMR"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowset">[dbo].[CX_DOCM_NUMR]</property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT T1.[ROW_ID] AS 'GI3_C_ROWD_DOCM_NUMR'
      ,CONVERT(DATETIME, T1.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_CRET]
      ,GETDATE() AS 'GI3_D_INS_INIT'
      ,T1.[CREATED_BY] AS 'GI3_C_UTIL_CRET'
      ,CONVERT(DATETIME, T1.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_MODF]
      ,T1.[LAST_UPD_BY] AS 'GI3_C_UTIL_MODF'
      ,NULL AS 'GI3_D_INS_MODF'
      ,T1.[X_GI_DE_DOCM] AS 'GI3_DE_DOCM'
      ,T1.[X_GI_D_CRET_FICH] AS 'GI3_D_CRET_FICH'
      ,T1.[X_GI_D_MODF_STAT] AS 'GI3_D_MODF_STAT'
      ,T1.[X_GI_I_DOCM_ACTF] AS 'GI3_I_DOCM_ACTF'
      ,T1.[X_GI_I_DOCM_DISP] AS 'GI3_I_DOCM_DISP'
      ,T1.[X_GI_I_SCASE] AS 'GI3_I_INTVT'
      ,T1.[X_GI_I_SORDER] AS 'GI3_I_FACT'
      ,T1.[X_GI_I__SASSET] AS 'GI3_I_APPR'
      ,T1.[X_GI_I__SCONTACT_INTR] AS 'GI3_I_INTL'
      ,T1.[X_GI_I__SORG_EXT_INTR] AS 'GI3_I_INTVN'
      ,T1.[X_GI_I__SORG_EXT_SITE] AS 'GI3_I_SITE'
      ,T1.[X_GI_I__SSRV_REQ] AS 'GI3_I_DEMD'
      ,T1.[X_GI_S_DOCM] AS 'GI3_S_DOCM'
	  ,T1.[FILE_SIZE] AS 'GI3_V_TAIL_FICH'
      ,T1.[PAR_ROW_ID_SORDER] AS 'GI3_C_ROWD_FACT'
      ,T1.[PAR_ROW_ID__SASSET] AS 'GI3_C_ROWD_APPR'
      ,T1.[PAR_ROW_ID__SCASE] AS 'GI3_C_ROWD_INTRVT'
      ,T1.[PAR_ROW_ID__SCONTACT_CONC] AS 'GI3_C_ROWD_INTRL_CONC'
      ,T1.[PAR_ROW_ID__SCONTACT_INTR] AS 'GI3_C_ROWD_INTRL'
      ,T1.[PAR_ROW_ID__SORG_EXT_INTR] AS 'GI3_C_ROWD_INTRVN'
      ,T1.[PAR_ROW_ID__SORG_EXT_SITE] AS 'GI3_C_ROWD_SITE'
      ,CASE WHEN T1.[PAR_ROW_ID__SSRV_REQ] IN (SELECT T10.ROW_ID FROM S_SRV_REQ T10 WHERE T10.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')) THEN
			T1.[PAR_ROW_ID__SSRV_REQ]
		ELSE
			NULL
		END AS 'GI3_C_ROWD_DEMN_DECL'
      ,T1.[PAR_ROW_ID__SUSER] AS 'GI3_C_ROWD_EMPL'
	  ,T1.[FILE_EXT] AS 'GI3_C_TYPE_FICH'
      ,T1.[X_GI_DE_SOUR_CRET] AS 'GI3_DE_SOUR_CRET'
	  ,CASE WHEN T1.[X_GI_NM_FICH] IS NOT NULL THEN
			T1.X_GI_NM_FICH
	   ELSE
			T1.FILE_NAME
	   END AS 'GI3_NM_FICH'
      ,T1.[X_GI_C_DOMN_INTR] AS 'GI3_C_DOMN_INTR'
      ,T1.[X_GI_I_SCONTACT_CONC] AS 'GI3_I_CONC'
      ,T1.[X_GI_DE_TYPE_DOCM] AS 'GI3_DE_TYPE_DOCM'
	  ,T1.[FILE_AUTO_UPD_FLG] AS GI3_I_FILE_AUTO_UPD
	  ,T1.[FILE_DATE] AS GI3_D_FILE_DATE
	  ,T1.[FILE_DEFER_FLG] AS GI3_I_FILE_DEFER
	  ,T1.[FILE_DOCK_REQ_FLG] AS GI3_I_FILE_DOCK_REQ
	  ,T1.[FILE_DOCK_STAT_FLG] AS GI3_I_FILE_DOCK_STAT
	  ,T1.[FILE_NAME] AS GI3_C_FILE_NAME
	  ,T1.FILE_EXT AS GI3_C_FILE_EXT
	  ,T1.FILE_SIZE AS GI3_N_FILE_SIZE
	  ,T1.[FILE_REV_NUM] AS GI3_C_FILE_REV_NUM
	  ,T1.[FILE_SRC_PATH] AS GI3_C_FILE_SRC_PATH
	  ,T1.[FILE_SRC_TYPE] AS GI3_C_FILE_SRC_TYPE
	  ,T1.X_GI_I_CXDECL_FCON AS GI3_C_I_CXDECL_FCON
	  ,T1.PAR_ROW_ID_CXDECL_FCON AS GI3_C_ROWD_DECL_FORM
	  ,T1.PAR_ROW_ID_CXRIG_LEV_JURD AS GI3_C_ROWD_RAPP_IG_LEV_JURD
	  ,T1.X_GI_I_CXRIG_LEV_JURD AS GI3_I_RAPP_IG_LEV_JURD

FROM [siebeldb].[dbo].[CX_DOCM_NUMR] T1

INNER JOIN [siebeldb].[dbo].[S_USER] T2
ON T2.ROW_ID = T1.[PAR_ROW_ID__SUSER]

WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')

--------------------------
--ORDER BY T1.CREATED DESC
--------------------------</property>
