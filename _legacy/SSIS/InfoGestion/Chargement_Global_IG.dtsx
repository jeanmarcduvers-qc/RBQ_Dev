                    <component
                      refId="Package\embarque\Phase 1 - Intervenants - Sites- Adresses - Interlocuteurs - LOV\Adresse courriel\S_PER_COMM_ADDR"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="S_PER_COMM_ADDR"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET LANGUAGE ENGLISH;

SELECT T1.[ROW_ID]						AS GI3_C_ROWD_ADRS_COUR
      ,T1.[CREATED_BY]					AS GI3_C_UTIL_CRET
      ,T1.[LAST_UPD_BY]					AS GI3_C_UTIL_MODF
	  ,CONVERT(DATETIME, T1.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_CRET]
	  ,CONVERT(DATETIME, T1.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_MODF]
      ,GETDATE()						AS GI3_D_INS_INIT
      ,T1.[ADDR]						AS GI3_C_ADRS_COUR
      ,T1.[COMM_MEDIUM_CD]				AS GI3_C_TYP_ADRS_COUR
      ,T1.[COMM_USE_TYPE_CD]			AS GI3_C_TYP_UTLS_COUR
	  ,T1.[YEARLY_START_DT]				AS GI3_D_DEB_UTLS_COUR
      ,T1.[YEARLY_END_DT]				AS GI3_D_FIN_UTLS_COUR
      ,T1.[X_GI_C_VALD_COUR]			AS GI3_C_VALD_COUR
      ,T1.[X_GI_DH_ENVO_CODE_VALD_COUR]	AS GI3_DH_ENVO_CODE_VALD
      ,T1.[X_GI_DH_FIN_CODE_VALD_COUR]	AS GI3_DH_FIN_CODE_VALD
      ,T1.[X_GI_DH_VALD_COUR]			AS GI3_DH_VALD_COUR
      ,T1.[X_GI_I_COUR_VALD]			AS GI3_I_COUR_VALD
	  ,T1.[PER_ID]						AS GI3_C_ROWD_INTRL

FROM [dbo].[S_PER_COMM_ADDR] T1
LEFT OUTER JOIN [S_USER] AS U1 WITH (NOLOCK)
    ON T1.[CREATED_BY] = U1.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U2 WITH (NOLOCK)
    ON T1.[LAST_UPD_BY] = U2.[ROW_ID]

WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
