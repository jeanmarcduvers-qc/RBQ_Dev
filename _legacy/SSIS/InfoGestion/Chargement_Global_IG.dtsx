                    <component
                      refId="Package\embarque\Phase 1 - Intervenants - Sites- Adresses - Interlocuteurs - LOV\Adresses\S_ADDR_PER"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                      description="Source OLE DB"
                      name="S_ADDR_PER"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET LANGUAGE ENGLISH;
SET TRANSACTION ISOLATION LEVEL READ COMMITTED;

SELECT
    T1.[ROW_ID] AS [GI3_C_ROWD_ADRS],
    T1.[ADDR_LINE_2] AS [GI3_A_ADRS_LIGN_1],
    T1.[ADDR_LINE_4] AS [GI3_A_ADRS_LIGN_2],
    T1.[ADDR_LINE_5] AS [GI3_A_ADRS_LIGN_3],
    T1.[ADDR_NAME] AS [GI3_A_ADRS_STRG],
    T1.[MISC_ADDR_LINE] AS [GI3_A_INSTL_POST],
    T1.[ADDR_MAIL_CD] AS [GI3_A_LOCL],
    T1.[X_CODE_BUREAU_REG] AS [GI3_C_BURE_REGN],
    T1.[X_MODE_LIVRAISON] AS [GI3_C_MODE_LIVR],
    T1.[X_CODE_MRC] AS [GI3_C_MRC],
    T1.[X_CODE_MUNICIPALITE] AS [GI3_C_MUNC],
    T1.[ZIPCODE] AS [GI3_C_POST],
    T1.[X_CODE_REGION_ADM] AS [GI3_C_REGN_ADMN],
    T1.[X_CODE_TERRITOIRE] AS [GI3_C_TERR],
    T1.[X_ARTERE] AS [GI3_C_TYPE_ARTR],  
	CONVERT(DATETIME, T1.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_CRET],   
	CONVERT(DATETIME, T1.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_MODF],
    T1.[ADDR_LINE_3] AS [GI3_N_APPT],
    T1.[X_NUMERO_CASE] AS [GI3_N_CASE_POST],
    T1.[ADDR_NUM] AS [GI3_N_IMMB],
    ISNULL(T2.VAL, T1.X_CODE_BUREAU_REG) AS [GI3_NM_BUR_REGN],
    T1.[X_MRC] AS [GI3_NM_MRC],
    T1.[CITY] AS [GI3_NM_MUNC],
    T1.[COUNTRY] AS [GI3_NM_PAYS],
    T1.[STATE] AS [GI3_NM_PROV],
    ISNULL(T4.VAL, T1.X_CODE_REGION_ADM) AS [GI3_NM_REG_ADMN],
    T1.[ADDR] AS [GI3_NM_RUE],
    ISNULL(T5.VAL, T1.X_CODE_TERRITOIRE) AS [GI3_NM_TERR],
    CASE
        WHEN U1.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U1.[LOGIN]
    END AS [GI3_C_UTIL_CRET],
    CASE
        WHEN U2.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U2.[LOGIN]
    END AS [GI3_C_UTIL_MODF],
    GETDATE() AS [GI3_D_INS_INIT],
    NULL AS [GI3_D_INS_MODF],
    ISNULL(T3.VAL, T1.X_GI_C_ZONE_ASSG_INSP) AS [GI3_NM_ZONE_ASSG_INSP],
    T1.X_GI_D_ENVO_NORM AS [GI3_D_ENVO_NORM],
    T1.X_GI_N_SEQN_DRT AS [GI3_N_SEQN_DRT],
    T1.X_GI_C_ZONE_ASSG_INSP AS [GI3_C_ZONE_ASSG_INSP],
    T1.X_GI_D_FIN_EFFC AS [GI3_D_FIN_EFFC],
    T1.X_GI_C_NIVE_CONF AS [GI3_C_NIVE_CONF],
    T1.X_GI_C_ETAT_ADRS AS [GI3_C_ETAT_ADRS],
    T1.X_GI_C_TYPE_INST_POST AS [GI3_C_TYPE_INST_POST],
    T1.X_GI_V_RESP_MODF_ADRS AS [GI3_V_RESP_MODF_ADRS],
    T1.LATITUDE AS [GI3_V_LATT_ADRS],
    T1.LONGITUDE AS [GI3_V_LONG_ADRS],
	T1.X_GI_V_SUFF_NUMR_CIVQ AS [GI3_V_SUFF_NUMR_CIVQ],
	T1.X_GI_V_SUFF_APPR AS [GI3_V_SUFF_APPR],
	T1.X_GI_C_TYPE_EMPL AS [GI3_C_TYPE_EMPL],
	T1.X_GI_DE_PREC_ADRS AS GI3_DE_PREC_ADRS

FROM
    [S_ADDR_PER] AS T1
LEFT JOIN S_LST_OF_VAL T2
    ON T2.LANG_ID = 'FRA' AND T2.ACTIVE_FLG = 'Y' and T2.TYPE = 'RBQ_BUREAU_REGIONAL' 
    AND T1.X_CODE_BUREAU_REG = T2.NAME
LEFT JOIN S_LST_OF_VAL T3
    ON T3.LANG_ID = 'FRA' AND T3.ACTIVE_FLG = 'Y' and T3.TYPE = 'RBQ_ZONE_ASSIGN_INSPEC' 
    AND T1.X_GI_C_ZONE_ASSG_INSP = T3.NAME
LEFT JOIN S_LST_OF_VAL T4
    ON T4.LANG_ID = 'FRA' AND T4.ACTIVE_FLG = 'Y' and T4.TYPE = 'RBQ_REGION_ADMIN' 
    AND T1.X_CODE_REGION_ADM = T4.NAME
LEFT JOIN S_LST_OF_VAL T5
    ON T5.LANG_ID = 'FRA' AND T5.ACTIVE_FLG = 'Y' and T5.TYPE = 'RBQ_TERRITOIRE' 
    AND T1.X_CODE_TERRITOIRE = T5.NAME
LEFT OUTER JOIN [S_USER] AS U1
    ON T1.[CREATED_BY] = U1.[ROW_ID] 
LEFT OUTER JOIN S_USER AS U2
    ON T1.[LAST_UPD_BY] = U2.[ROW_ID]

WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
                        <property
                          dataType="System.String"
                          description="Variable contenant la commande SQL à exécuter."
                          name="SqlCommandVariable"></property>
                        <property
                          dataType="System.Int32"
