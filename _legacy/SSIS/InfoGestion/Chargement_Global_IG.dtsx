                    <component
                      refId="Package\embarque\Interventions\Intervention\SRC_siebeldb S_CASE"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                      description="Source OLE DB"
                      name="SRC_siebeldb S_CASE"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET LANGUAGE ENGLISH;

SELECT DISTINCT
    T1.[ROW_ID] AS [GI3_C_ROWD_INTRVT],
    T2.[ROW_ID] AS [GI3_C_ROWD_INTRVN],
    T3.[ROW_ID] AS [GI3_C_ROWD_POSN_RESP],
    T4.[ROW_ID] AS [GI3_C_ROWD_RESP],
    T8.[ROW_ID] AS [GI3_C_ROWD_INTRL],
    T9.[ROW_ID] AS [GI3_C_ROWD_DEMN_DECL],
    T10.[ROW_ID] AS [GI3_C_ROWD_INTRVT_MAIT],
	CASE 
		WHEN T11.[ROW_ID] IN (SELECT T30.[ROW_ID] AS [GI3_C_ROWD_SITE] FROM [S_ORG_EXT] AS T30 WITH (NOLOCK) WHERE T30.[ACCNT_FLG] = 'N' AND T30.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')) THEN
			T11.[ROW_ID]
		ELSE
			NULL
	END AS [GI3_C_ROWD_SITE],
	--T11.[ROW_ID] AS [GI3_C_ROWD_SITE],
    T12.[ROW_ID] AS [GI3_C_ROWD_CONCEPTR],
    
    --DOMAINE INTRVT
    T1.[X_DOMAINE] AS [GI3_DE_DOMN_INTRVT],
    T1.[X_SOUS_DOMAINE_INTERVENANT] AS [GI3_DE_SOUS_DOMN_INTRVT],
    T1.[X_CODE] AS [GI3_C_CODE_INTRVT],
    T1.[X_DESCRIPTION] AS [GI3_DE_TYPE_BATM],
    T1.[X_DETAIL] AS [GI3_V_DETAIL],
    T1.[X_LOI_REGLE_CODE] AS [GI3_C_LOI_REGL_CODE],
    T7.[LOGIN] AS [GI3_C_ASSIGNE_A],
	T1.SUB_STATUS_CD AS [GI3_C_DECISN], 
    --L1.[NAME] ,
	CASE
		WHEN T1.[CRIME_SUB_TYPE_CD] = 'TNC Iteration' THEN
			(SELECT [TYPE_CD] FROM S_CASE WHERE ROW_ID = T10.[PAR_CASE_ID]) -- On prend le parent du parent
		WHEN T1.[TYPE_CD] IS NOT NULL THEN
			T1.[TYPE_CD]
		ELSE
			T10.[TYPE_CD] -- On prend le parent
	END AS [GI3_C_TYPE_INTRVT],

  CASE 
    WHEN T1.[CLOSED_DT] &lt; '2007-03-11 07:00:00.000' THEN
        CASE
            WHEN T1.[CLOSED_DT] &gt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[CLOSED_DT]) - 2007), '2007-04-01 07:00:00.000') OR
                 T1.[CLOSED_DT] &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[CLOSED_DT]) - 2007), '2007-10-28 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[CLOSED_DT])
            ELSE
                 DATEADD(hh, -4, T1.[CLOSED_DT])
        END
    ELSE
        CASE
            WHEN T1.[CLOSED_DT] &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[CLOSED_DT]) - 2007), '2007-03-11 07:00:00.000') OR
                 T1.[CLOSED_DT] &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[CLOSED_DT]) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[CLOSED_DT])
            ELSE
                 DATEADD(hh, -4, T1.[CLOSED_DT])
        END
  END AS [GI3_D_CLOT_INTRVT],
     
CONVERT(DATETIME, T1.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_CRET],
     
CONVERT(DATETIME, T1.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_MODF],
     
  CASE 
    WHEN T1.[CASE_DT] &lt; '2007-03-11 07:00:00.000' THEN
        CASE
            WHEN T1.[CASE_DT] &gt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[CASE_DT]) - 2007), '2007-04-01 07:00:00.000') OR
                 T1.[CASE_DT] &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[CASE_DT]) - 2007), '2007-10-28 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[CASE_DT])
            ELSE
                 DATEADD(hh, -4, T1.[CASE_DT])
        END
    ELSE
        CASE
            WHEN T1.[CASE_DT] &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[CASE_DT]) - 2007), '2007-03-11 07:00:00.000') OR
                 T1.[CASE_DT] &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[CASE_DT]) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[CASE_DT])
            ELSE
                 DATEADD(hh, -4, T1.[CASE_DT])
        END
  END AS [GI3_D_OUVE_INTRVT],
    T1.[X_DT_NEXT_EVAL] AS [GI3_D_PROC_EVAL],
    T1.[X_DESC_REGROUPEMENT] AS [GI3_DE_REGR],
	--28-04-2011 JL : Commentaire
	T1.[X_COMMENTAIRE] AS [GI3_DE_COMM],
	-----------------------------
    T1.[X_DATE_DECISION] AS [GI3_D_DECISN],
    T1.[X_DT_LAST_EVAL] AS [GI3_D_DERN_EVAL],
    T1.[X_TYPE_COMMANDE] AS [GI3_C_INTRVT],
    T1.[X_RISQUE] AS [GI3_C_RISQ],
    CASE
		WHEN T1.[CRIME_SUB_TYPE_CD] = 'TNC Iteration' THEN
			(SELECT [X_DESC_TYPE] FROM S_CASE WHERE ROW_ID = T10.[PAR_CASE_ID]) -- On prend le parent du parent
		WHEN T1.[X_DESC_TYPE] IS NOT NULL THEN
			T1.[X_DESC_TYPE]	
		ELSE
			T10.[X_DESC_TYPE] -- On prend le parent
	END AS [GI3_DE_TYPE_INTRVT],
    T1.[CASE_NUM] AS [GI3_N_INTRVT],
    T1.[X_REGROUPEMENT] AS [GI3_N_REGR],
    L2.VAL AS [GI3_S_INTRVT],
    T1.[X_ADM_MONTREAL] AS [GI3_V_ADMMTL],
    T1.[X_ADM_QUEBEC] AS [GI3_V_ADMQC],
 CASE
        WHEN U1.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U1.[LOGIN]
    END AS [GI3_C_UTIL_CRET],
    CASE
        WHEN U2.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U2.[LOGIN]
    END AS [GI3_C_UTIL_MODF],
    GETDATE() AS [GI3_D_INS_INIT],
    NULL AS [GI3_D_INS_MODF],
    T1.X_LAST_EVALUATION_RESULT AS [GI3_C_DERN_EVAL_RESULT],
    T1.X_EL_DECLENCH AS [GI3_DE_ELEM_DECLENCH],
CASE 
    WHEN T1.[X_DATE_FIN_BIEN_FONDE_EVAL] &lt; '2007-03-11 07:00:00.000' THEN
        CASE
            WHEN T1.[X_DATE_FIN_BIEN_FONDE_EVAL] &gt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[X_DATE_FIN_BIEN_FONDE_EVAL]) - 2007), '2007-04-01 07:00:00.000') OR
                 T1.[X_DATE_FIN_BIEN_FONDE_EVAL] &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[X_DATE_FIN_BIEN_FONDE_EVAL]) - 2007), '2007-10-28 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[X_DATE_FIN_BIEN_FONDE_EVAL])
            ELSE
                 DATEADD(hh, -4, T1.[X_DATE_FIN_BIEN_FONDE_EVAL])
        END
    ELSE
        CASE
            WHEN T1.[X_DATE_FIN_BIEN_FONDE_EVAL] &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[X_DATE_FIN_BIEN_FONDE_EVAL]) - 2007), '2007-03-11 07:00:00.000') OR
                 T1.[X_DATE_FIN_BIEN_FONDE_EVAL] &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[X_DATE_FIN_BIEN_FONDE_EVAL]) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[X_DATE_FIN_BIEN_FONDE_EVAL])
            ELSE
                 DATEADD(hh, -4, T1.[X_DATE_FIN_BIEN_FONDE_EVAL])
        END
  END AS [GI3_D_FIN_BIEN_FONDE_EVAL],
CASE 
    WHEN T1.[X_DATE_DEBUT_SAISIR_EFFORTS] &lt; '2007-03-11 07:00:00.000' THEN
        CASE
            WHEN T1.[X_DATE_DEBUT_SAISIR_EFFORTS] &gt; DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[X_DATE_DEBUT_SAISIR_EFFORTS]) - 2007), '2007-04-01 07:00:00.000') OR
                 T1.[X_DATE_DEBUT_SAISIR_EFFORTS] &lt;= DATEADD(ww, -52 * ABS(DATEPART(yy, T1.[X_DATE_DEBUT_SAISIR_EFFORTS]) - 2007), '2007-10-28 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[X_DATE_DEBUT_SAISIR_EFFORTS])
            ELSE
                 DATEADD(hh, -4, T1.[X_DATE_DEBUT_SAISIR_EFFORTS])
        END
    ELSE
        CASE
            WHEN T1.[X_DATE_DEBUT_SAISIR_EFFORTS] &gt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[X_DATE_DEBUT_SAISIR_EFFORTS]) - 2007), '2007-03-11 07:00:00.000') OR
                 T1.[X_DATE_DEBUT_SAISIR_EFFORTS] &lt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[X_DATE_DEBUT_SAISIR_EFFORTS]) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[X_DATE_DEBUT_SAISIR_EFFORTS])
            ELSE
                 DATEADD(hh, -4, T1.[X_DATE_DEBUT_SAISIR_EFFORTS])
        END
  END AS [GI3_D_DEB_SAISIR_EFFORTS],
T1.[X_CONSTAT_ORG] AS [GI3_DE_CONSTAT_ORG],
T1.[X_CONSTAT_INTERVNT] AS [GI3_DE_CONSTAT_INTERVNT],
T1.[X_RETOUR_DOCUMENTS] AS [GI3_I_RETR_DOCM],
T1.[X_NOM_GRILLE] AS [GI3_NM_GRIL],
T1.[X_RECOMMANDATION] AS [GI3_DE_RECM],
T1.[X_A_FINALISER] AS [GI3_I_INTR_A_COMP],
T1.[X_NOM_CONTACT_INTERVENTION] AS [GI3_NM_CONT],
T1.[X_NO_TEL_CONTACT_INTERVENTION] AS [GI3_N_TEL_CONT],
T1.[X_AVIS_TRANSMIS] AS [GI3_I_AVIS_TRAN],
T1.[ASGN_USR_EXCLD_FLG] AS [GI3_I_ASSG_MANL],
T1.[X_NON_REQUIS] AS [GI3_I_INTR_NON_REQS],
T1.X_GI_DE_PREC_DOMN AS GI3_DE_PREC_DOMN,
T1.X_GI_I_GEST_SAIS_PERM_RAPP AS GI3_I_RAPP_LECT_SEUL,
T1.X_LIMITE_AVIS AS GI3_DE_LIMT_AVIS,
T1.THREAT_LVL_CD AS GI3_C_THREAT_LVL,
--T1.X_NOM_OPERATION AS GI3_C_ROWD_NOM_OPER,
CASE 
    WHEN T1.[X_NOM_OPERATION] IN (SELECT T20.ROW_ID GI3_C_ROWD_CODE_PARM FROM CX_SYS_PARAM AS T20 WITH (NOLOCK) WHERE T20.CATEGORY = 'Operations specifiques' AND T20.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')) THEN
        T1.X_NOM_OPERATION
    ELSE
        NULL
END AS GI3_C_ROWD_NOM_OPER,
T14.PAR_ROW_ID_GENR_OBJT_RETN AS GI3_C_ROWD_INTRVN_RETN_FINL,
T15.PAR_ROW_ID_GENR_OBJT_RETN AS GI3_C_ROWD_SITE_RETN_FINL,
T1.CRIME_SUB_TYPE_CD AS GI3_C_VERF_NECS,
T13.ATTRIB_03 AS GI3_C_JUST_NON_CONF,
/**Ajouts pour TNC**/
T1.X_AVIS_DATE AS GI3_D_AVIS,
T1.DESC_TEXT AS GI3_DE_DESC_INTR,
T1.ASGN_DT AS GI3_D_AUDT_QUAL,
T1.PR_REP_DNRM_FLG AS GI3_I_DOCM_NUMR,
T1.X_ENGAG_AVIS AS GI3_C_ENGG_AVIS,
T1.CRIME_TYPE_CD AS GI3_C_ETAP_ACTL,
T1.X_LIBELLE AS GI3_DE_LIBL_LOI_REGL_CODE,
T1.STAGE_CD AS GI3_N_REFR,
T1.X_DT_LAST_EVAL AS GI3_D_EVAL,
T13.ATTRIB_01 AS GI3_C_GRAV_DOSS_NON_CONF,
T13.ATTRIB_04 AS GI3_C_JUST_INTR,
T13.ATTRIB_08 AS GI3_I_INTR_T0,
T13.ATTRIB_11 AS GI3_I_ITER_SUIV,
T13.ATTRIB_32 AS GI3_D_ECHN_DPCP,
T13.ATTRIB_14 AS GI3_Q_NOMB_ITER,
T13.ATTRIB_05 AS GI3_C_COTE_PRIR_INTR,
T13.ATTRIB_09 AS GI3_I_FACT_EMIS_INTR,
T1.X_GI_I_VERF_LICN_INTR_DNC AS GI3_I_VERF_LICN_INTR_DNC,
T1.X_PAR_ROW_ID_CXCONTACT_INTV AS GI3_C_ROWD_CONT,
T1.X_GI_C_ROLE_INTV_FDNC AS GI3_C_ROLE_INTV_FDNC,
T1.X_GI_DE_COMM_FDNC AS GI3_DE_COMM_FDNC,
T1.X_PAR_ROW_ID_SORG_EXT_INTV_FDN AS GI3_C_ROWD_INTRVN_FDN

,T13.X_GI_I_REFS_VIST_INTR		AS GI3_I_REFS_VIST_INTR
,T13.X_GI_NO_ARTC_LOI_ORDN		AS GI3_NO_ARTC_LOI_ORDN
,T13.X_GI_I_SUIV_ITER_ORDN		AS GI3_I_SUIV_ITER_ORDN
,T13.X_GI_NO_MED_ORDN			AS GI3_NO_MED_ORDN
,T13.X_GI_D_RECP_MED_ORDN		AS GI3_D_RECP_MED_ORDN
,T13.X_GI_D_DECS_MED_ORDN		AS GI3_D_DECS_MED_ORDN
,T13.X_GI_CO_RESL_ORDN			AS GI3_CO_RESL_ORDN
,T13.X_GI_I_CRET_ITER_TERM		AS GI3_I_CRET_ITER_TERM
,T13.X_GI_D_EMIS_ORDN           AS GI3_D_EMIS_ORDN
,T13.X_GI_DE_NATR_ORDN          AS GI3_DE_NATR_ORDN
,T13.X_GI_DE_NCON_ORDN          AS GI3_DE_NCON_ORDN
,T13.X_GI_I_PUBL_REGS_ORDN      AS GI3_I_PUBL_REGS_ORDN

FROM
    [S_CASE] AS T1 WITH (NOLOCK)
LEFT OUTER JOIN [S_USER] AS U1 WITH (NOLOCK)
    ON T1.[CREATED_BY] = U1.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U2 WITH (NOLOCK)
    ON T1.[LAST_UPD_BY] = U2.[ROW_ID]
    
-- RESPONSABLE
LEFT OUTER JOIN [S_ORG_EXT] AS T2 WITH (NOLOCK)
    ON T1.[X_INTERVNT_ID] = T2.[ROW_ID]
LEFT OUTER JOIN [S_POSTN] AS T3 WITH (NOLOCK)
    ON T2.[PR_POSTN_ID] = T3.[ROW_ID]
LEFT OUTER JOIN [S_CONTACT] AS T4 WITH (NOLOCK)
    ON T4.[ROW_ID] = T3.[PR_EMP_ID]
	
--ASSIGNÉ À
LEFT OUTER JOIN [S_CASE_POSTN] AS T5 WITH (NOLOCK)
    ON T5.[CASE_ID] = T1.[ROW_ID]
    AND T1.[PR_POSTN_ID] = T5.[POSTN_ID]
LEFT OUTER JOIN [S_POSTN] AS T6 WITH (NOLOCK)
    ON T6.[ROW_ID] = T5.[POSTN_ID]
LEFT OUTER JOIN [S_USER] AS T7 WITH (NOLOCK)
    ON T7.[PAR_ROW_ID] = T6.[PR_EMP_ID]
LEFT OUTER JOIN [S_CONTACT] AS T8 WITH (NOLOCK)
    ON T1.[X_INTERLCR_ID] = T8.[ROW_ID]
LEFT OUTER JOIN [S_SRV_REQ] AS T9 WITH (NOLOCK)
    ON T1.[X_SR_ID] = T9.[ROW_ID]
LEFT OUTER JOIN [S_CASE] AS T10 WITH (NOLOCK)
    ON T1.[PAR_CASE_ID] = T10.[ROW_ID]
LEFT OUTER JOIN [S_ORG_EXT] AS T11 WITH (NOLOCK)
    ON T1.[X_SITE_ID] = T11.[ROW_ID] AND T11.[ACCNT_FLG] = 'N'
LEFT OUTER JOIN [S_ORG_EXT] AS T12 WITH (NOLOCK)
    ON T1.[X_CONCEPTR_ID] = T12.[ROW_ID]
LEFT OUTER JOIN [S_CASE_X] AS T13 WITH (NOLOCK)
    ON T1.[ROW_ID] = T13.[ROW_ID]
LEFT OUTER JOIN [CX_PORTRAIT_GLB] AS T14 WITH (NOLOCK)
    ON T1.[X_INTERVNT_ID] = T14.[PAR_ROW_ID_GENR_OBJT_DEST]
LEFT OUTER JOIN [CX_PORTRAIT_GLB] AS T15 WITH (NOLOCK)
    ON T1.[X_SITE_ID] = T15.[PAR_ROW_ID_GENR_OBJT_DEST]
--LEFT OUTER JOIN (select * from S_LST_OF_VAL where TYPE = 'HLS_CASE_STATUS' and  LANG_ID='FRA' AND ACTIVE_FLG = 'Y') L1 
  --  ON L1.VAL= T1.[SUB_STATUS_CD] 
LEFT OUTER JOIN (select * from S_LST_OF_VAL where TYPE = 'HLS_CASE_STATUS' and  LANG_ID='FRA' AND ACTIVE_FLG = 'Y') L2 
	ON L2.NAME=T1.[STATUS_CD]

WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
