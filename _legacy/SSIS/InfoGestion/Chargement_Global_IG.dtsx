                    <component
                      refId="Package\embarque\Activités\ActiviteEvenement\SRC_siebeldb S_EVT_ACT"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="Source OLE DB;Microsoft Corporation;Microsoft SqlServer v9; (C) 2005 Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
                      description="Source OLE DB"
                      name="SRC_siebeldb S_EVT_ACT"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="Nombre de secondes avant l'expiration d'une commande. Une valeur égale à 0 indique un délai d'expiration infini."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="Commande SQL à exécuter."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET LANGUAGE ENGLISH;

SET TRANSACTION ISOLATION LEVEL READ COMMITTED;

SELECT
    T1.[ROW_ID] AS [GI3_C_ROWD_ACTV],
    T10.[ROW_ID] AS [GI3_C_ROWD_APPR],
    T4.[ROW_ID] AS [GI3_C_ROWD_CODE_ACTN],
       
    CASE WHEN T4.[ROW_ID] IS NOT NULL 
		THEN T3.[ROW_ID]
		ELSE NULL
    END AS [GI3_C_ROWD_CODE_RESL],
    T5.[ROW_ID] AS [GI3_C_ROWD_DEMN_DECL],
    T6.[ROW_ID] AS [GI3_C_ROWD_INTRVN],
    T11.[ROW_ID] AS [GI3_C_ROWD_INTRVT],
    T8.[ROW_ID] AS [GI3_C_ROWD_PLAN_ACTV],
       T9.[ROW_ID] AS [GI3_C_ROWD_PORT],
    T1.[CALLER_TYPE_CD] AS [GI3_C_CALL],
    T1.[EVT_STAT_CD] AS [GI3_C_ETAT],
    T1.[TODO_CD] AS [GI3_C_TYP],
	CASE
        WHEN U1.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U1.[LOGIN]
    END AS [GI3_C_UTIL_CRET],
    CASE
        WHEN U2.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U2.[LOGIN]
    END AS [GI3_C_UTIL_MODF],
     
	CONVERT(DATETIME, T1.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_CRET],
CASE
WHEN DATEPART(hh, T1.[TODO_ACTL_END_DT])in (4,5) and DATEPART(mi, T1.[TODO_ACTL_END_DT])=0 and  DATEPART(ss, T1.[TODO_ACTL_END_DT])=0 
 THEN DATEADD(hh, -DATEPART(hh, T1.[TODO_ACTL_END_DT]),T1.[TODO_ACTL_END_DT]) 
 ELSE
  CASE
            WHEN T1.[TODO_ACTL_END_DT] &lt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[TODO_ACTL_END_DT]) - 2007), '2007-03-11 07:00:00.000') OR
                 T1.[TODO_ACTL_END_DT] &gt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[TODO_ACTL_END_DT]) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[TODO_ACTL_END_DT])
            ELSE
                 DATEADD(hh, -4, T1.[TODO_ACTL_END_DT])
        END  
 END AS [GI3_D_FIN_ACTV],
     
	CONVERT(DATETIME, T1.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_MODF],
    T1.[NAME] AS [GI3_DE_ACTV],
    T1.[COMMENTS_LONG] AS [GI3_DE_COMM],
    T1.[X_IND_BLOCAGE_FLG] AS [GI3_I_BLOC],
    T1.[X_HORS_HEURS_NORM] AS [GI3_I_HOR_HR_NORM],
    T1.[X_NON_BILLABLE_FLG] AS [GI3_I_NON_FACT],
    T1.[TRAVEL_TM_MIN] AS [GI3_Q_DEPL],
    T1.[LEAD_TM] AS [GI3_V_DELAI],
    T1.[X_GENRE_ASP] AS [GI3_V_GENR_ASP],
    T1.[X_INSP_ASP] AS [GI3_V_INSP_ASP],
    T1.[X_SEQUENCE] AS [GI3_V_SEQ],
    T1.[DURATION_HRS] AS [GI3_V_TEMP],
    T12.[ORDER_NUM] AS [GI3_N_FACT],
       T13.[ACTION_CODE] AS [GI3_C_ACT], 
    GETDATE() AS [GI3_D_INS_INIT],
    NULL AS [GI3_D_INS_MODF],
CASE
WHEN DATEPART(hh, T1.[TODO_ACTL_START_DT])in (4,5) and DATEPART(mi, T1.[TODO_ACTL_START_DT])=0 and  DATEPART(ss, T1.[TODO_ACTL_START_DT])=0 
 THEN DATEADD(hh, -DATEPART(hh, T1.[TODO_ACTL_START_DT]),T1.[TODO_ACTL_START_DT]) 
 ELSE
  CASE
            WHEN T1.[TODO_ACTL_START_DT] &lt; DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[TODO_ACTL_START_DT]) - 2007), '2007-03-11 07:00:00.000') OR
                 T1.[TODO_ACTL_START_DT] &gt;= DATEADD(ww, 52 * ABS(DATEPART(yy, T1.[TODO_ACTL_START_DT]) - 2007), '2007-11-04 06:00:00.000')
            THEN
                 DATEADD(hh, -5, T1.[TODO_ACTL_START_DT])
            ELSE
                 DATEADD(hh, -4, T1.[TODO_ACTL_START_DT])
        END  
 end
  as [GI3_D_DEBT],
  T3.RESULT_CODE As GI3_DE_RESL,
  T1.X_GI_D_RECP_DOCM As GI3_D_RECP_DOCM,
  T1.TODO_DUE_DT AS GI3_D_ECHN

FROM
    dbo.[S_EVT_ACT] AS T1
LEFT OUTER JOIN dbo.[S_USER] AS U1
    ON T1.[CREATED_BY] = U1.[ROW_ID]
LEFT OUTER JOIN dbo.[S_USER] AS U2
    ON T1.[LAST_UPD_BY] = U2.[ROW_ID]
LEFT OUTER JOIN dbo.[CX_WFM_RESULTCD] AS T3
    ON T1.[X_RESULT_CD_ID] = T3.[ROW_ID]
LEFT OUTER JOIN dbo.[CX_WFM_ACTIONCD] AS T4
    ON T4.[ROW_ID] = T3.[ACTION_CODE_ID]
LEFT OUTER JOIN dbo.[S_SRV_REQ] AS T5
    ON T5.[ROW_ID] = T1.[SRA_SR_ID]
LEFT OUTER JOIN dbo.[S_ORG_EXT] AS T6
    ON T6.[ROW_ID] = T1.[TARGET_OU_ID]
LEFT OUTER JOIN dbo.[S_SUSP_ACT] AS T7
    ON T1.[ROW_ID] = T7.[PAR_ROW_ID]
LEFT OUTER JOIN dbo.[S_EVT_ACT] AS T8 
    ON T1.[TMPL_PLANITEM_ID] = T8.[ROW_ID]
    AND T8.[TEMPLATE_FLG] = 'Y'
LEFT OUTER JOIN dbo.[S_USER] AS T9 
       ON T9.[ROW_ID] = T1.[OWNER_PER_ID]
LEFT OUTER JOIN dbo.[S_ASSET] AS T10 
       ON T1.[ASSET_ID] = T10.[ROW_ID]
LEFT OUTER JOIN dbo.[S_CASE] AS T11 
       ON T7.[CASE_ID] = T11.[ROW_ID]
LEFT OUTER JOIN dbo.[S_ORDER] AS T12
       ON T1.[ORDER_ID] = T12.[ROW_ID]
LEFT OUTER JOIN dbo.[CX_WFM_ACTIONCD] AS T13
       on T13.ROW_ID= T1.[X_ACTION_CD_ID]

WHERE
T1.[TEMPLATE_FLG] = 'N'
AND T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
