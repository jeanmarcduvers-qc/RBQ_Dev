                                  name="GI3_C_ROWD_ATTRIBUE_A"
                                  truncationRowDisposition="FailComponent" />
                                <outputColumn
                                  refId="Package\embarque\Phase 1 - Intervenants - Sites- Adresses - Interlocuteurs - LOV\Site\Sites\OLE DB Source.Outputs[OLE DB Source Output].Columns[GI3_C_EXTN_AUTM_BATM]"
                                  codePage="1252"
