          <DTS:Variables />
          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\embarque\Documents\Document"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:Description="Tâche de flux de données"
              DTS:DTSID="{0B9969FF-066C-4721-B8FF-44658DAF6AAF}"
              DTS:ExecutableType="Microsoft.Pipeline"
