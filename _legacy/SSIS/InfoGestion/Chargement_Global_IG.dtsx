      ELSE NULL
    END AS [GI3_Q_TRAV_PB_PCT_TERR_NON_ORGA],
    CASE [ELEMENT]
      WHEN 'PBTypePourcentTotal' THEN VALEUR
      ELSE NULL
    END AS [GI3_Q_TRAV_PB_PCT_TOTL],
    CASE [ELEMENT]
      WHEN 'PBTypeVilleArrondissementExemptes' THEN VALEUR
      ELSE NULL
    END AS [GI3_Q_TRAV_PB_PCT_VILL_EXEM],
    CASE [ELEMENT]
      WHEN 'PersonneRespDossier' THEN VALEUR
      ELSE NULL
    END AS [GI3_V_COMM_RESP_DOSS],
    CASE [ELEMENT]
      WHEN 'Commentaires' THEN VALEUR
      ELSE NULL
    END AS [GI3_V_COMM_TEXT],
    CASE [ELEMENT]
      WHEN 'DocumentationAjourPreciser' THEN VALEUR
      ELSE NULL
    END AS [GI3_V_ENTP_DOCU_NOTE],
    CASE [ELEMENT]
      WHEN 'MembreAssociation' THEN VALEUR
      ELSE NULL
    END AS [GI3_V_ENTP_MEMB_ASSC],
    CASE [ELEMENT]
      WHEN 'ControledequaliteProgrPrecision' THEN VALEUR
      ELSE NULL
    END AS [GI3_V_ENTP_QUAL_NOTE],
    CASE [ELEMENT]
      WHEN 'SecteurInstalExterieurePrecision' THEN VALEUR
      ELSE NULL
    END AS [GI3_V_SECT_INST_EXTR_NOTE],
    CASE [ELEMENT]
      WHEN 'PersonneConsultee' THEN VALEUR
      ELSE NULL
    END AS [GI3_V_TITR_PERS_CONS],
    CASE [ELEMENT]
      WHEN 'ALTypeAutreAppareilDetail' THEN VALEUR
      ELSE NULL
    END AS [GI3_V_TRAV_AL_NOTE],
 CASE
        WHEN U1.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U1.[LOGIN]
    END AS [GI3_C_UTIL_CRET],
    CASE
        WHEN U2.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U2.[LOGIN]
    END AS [GI3_C_UTIL_MODF],
    GETDATE() AS [GI3_D_INS_INIT],
    NULL AS [GI3_D_INS_MODF]
FROM
    [CX_FILE_ATT] AS T1 WITH (NOLOCK)
INNER JOIN [CX_FORM_DATA] AS T2 WITH (NOLOCK)
    ON T1.[ROW_ID] = T2.[FRM_INST_ID]
LEFT OUTER JOIN [S_USER] U1 WITH (NOLOCK)
    ON T1.[CREATED_BY] = U1.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U2 WITH (NOLOCK)
    ON T1.[LAST_UPD_BY] = U2.[ROW_ID]
LEFT OUTER JOIN [S_ORG_EXT] AS T3 WITH (NOLOCK)
	ON T1.[X_ACCOUNT_ID] = T3.[ROW_ID]
WHERE
    T1.[FILE_NAME] LIKE '%ProfilIntervenant%'
AND T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
