                        <component
                          refId="Package\embarque\Phase 1 - Intervenants - Sites- Adresses - Interlocuteurs - LOV\Site\Composantes\OLE DB Source"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SqlServer v10; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="OLE DB Source"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET LANGUAGE ENGLISH;
SET TRANSACTION ISOLATION LEVEL READ COMMITTED;

SELECT
    T1.[ROW_ID] AS [GI3_C_ROWD_SITE],
    T9.[ROW_ID] AS [GI3_C_ROWD_SITE_PRIN],
    T10.[ROW_ID] AS [GI3_C_ROWD_ATTRIBUE_A],
    T8.[SEAS_USE_CD] AS [GI3_C_EXTN_AUTM_BATM],
    T8.[LEGAL_STAT_CD] AS [GI3_C_MODE_SURV],
    T8.[SITE_TYPE_CD] AS [GI3_C_QUAL],
    T8.[USG_PATTERN_CD] AS [GI3_C_TYPE_CAPC],
    T8.[STRUCT_TYPE_CD] AS [GI3_C_TYPE_CONS],   
    CONVERT(DATETIME, T1.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_CRET],     
    CONVERT(DATETIME, T1.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_MODF],
    CONVERT(DATETIME, T8.[OCCUPANCY_DT] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_FERM_DOSS],
    CAST(T1.[DIRECTIONS] AS VARCHAR(8000)) AS [GI3_DE_NOTE],
    YEAR(T8.[BLDG_DT]) AS [GI3_N_ANN_CONS_SITE],
    T1.[OU_NUM] AS [GI3_N_SITE],
    T1.[ALIAS_NAME] AS [GI3_NM_ENDR],
    T8.[TOTAL_FLOORS] AS [GI3_Q_ETAG_BATM],
    T8.[TOTAL_AREA] AS [GI3_V_AIRE_BATM],
    T1.[LOC] AS [GI3_V_ANCN_NUMR_SITE],
    T8.[POPULATION] AS [GI3_V_CAPC_MAXM_BATM],
    T1.[STATUS_CD] AS [GI3_DE_STAT_SITE_COMP],
    CASE
        WHEN U1.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U1.[LOGIN]
    END AS [GI3_C_UTIL_CRET],
    CASE
        WHEN U2.[LOGIN] IS NULL THEN
            'Utilisateur inexistant'
        ELSE
            U2.[LOGIN]
    END AS [GI3_C_UTIL_MODF],
    GETDATE() AS [GI3_D_INS_INIT],
    NULL AS [GI3_D_INS_MODF],
    T1.IMPL_DESC As GI3_DE_COMM_SITE,
    T1.X_GI_N_IMMT AS GI3_N_IMMT,
    T1.X_GI_C_PROV AS GI3_C_PROV,
    T1.X_GI_N_IMMT_ITRE_DERN_ATTR AS [GI3_N_IMMT_ITRE_DERN_ATTR],
    T8.LOYAL_SCORE1 AS GI3_N_TOUR_REFR_SITE
	,T1X.ATTRIB_03 AS GI3_C_ROWD_CONT

	--UEP
	,T1.X_GI_ANCN_N_UEP AS GI3_N_ANCN_UEP
	,T1.X_GI_C_SECT_ACTV_ECON_EP AS GI3_C_SECT_ACTV_ECON_EP
	,T1.X_GI_C_SSEC_ACTV_ECON_EP AS GI3_C_SSEC_ACTV_ECON_EP
	,T1.X_GI_I_DERG_SITE_EP AS GI3_I_DERG_SITE_EP
	,T1.X_GI_I_APPR_MOBL_EP AS GI3_I_APPR_MOBL_EP

	--Terrain
	,T1.X_PAR_ROW_ID_CXTERRAIN AS GI3_C_ROWD_TERR

FROM
    [S_ORG_EXT] AS T1
LEFT OUTER JOIN [S_USER] AS U1
    ON T1.[CREATED_BY] = U1.[ROW_ID]
LEFT OUTER JOIN [S_USER] AS U2
    ON T1.[LAST_UPD_BY] = U2.[ROW_ID]
LEFT OUTER JOIN [S_ORG_EXT_UTX] AS T8
    ON T1.[ROW_ID] = T8.[PAR_ROW_ID]
LEFT OUTER JOIN [S_ORG_EXT] AS T9
    ON T1.[PAR_OU_ID] = T9.[ROW_ID]
LEFT OUTER JOIN [S_POSTN] AS T10
    ON T1.[PR_POSTN_ID] = T10.[ROW_ID]
LEFT OUTER JOIN S_ORG_EXT_X AS T1X
    ON T1X.[PAR_ROW_ID] = T1.[ROW_ID]
WHERE
    T1.[ACCNT_FLG] = 'N'

AND T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')
AND T9.[ROW_ID] IS NOT NULL</property>
                            <property
                              dataType="System.String"
                              description="The variable that contains the SQL command to be executed."
                              name="SqlCommandVariable"></property>
                            <property
