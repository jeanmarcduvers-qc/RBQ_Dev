                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Commande SQL à exécuter."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select T1.ROW_ID GI3_C_ROWD_CAS_DOUB,
X_GI_C_TYPE_OBJT_PARN GI3_C_TYPE_OBJT_PARN,
case when X_GI_C_TYPE_OBJT_PARN = 'Appareil' 
THEN PAR_ROW_ID_GENR_OBJT_RETN
ELSE NULL
END GI3_C_ROWD_OBJT_RETN_APPR,
case when X_GI_C_TYPE_OBJT_PARN = 'Site' 
THEN PAR_ROW_ID_GENR_OBJT_RETN
ELSE NULL
END GI3_C_ROWD_OBJT_RETN_SITE,
case when X_GI_C_TYPE_OBJT_PARN = 'Appareil' 
THEN PAR_ROW_ID_GENR_OBJT_DEST
ELSE NULL
END GI3_C_ROWD_OBJT_DEST_APPR,
case when X_GI_C_TYPE_OBJT_PARN = 'Site' 
THEN PAR_ROW_ID_GENR_OBJT_DEST
ELSE NULL
END GI3_C_ROWD_OBJT_DEST_SITE,
X_GI_S_CAS GI3_S_CAS,
T1.CREATED GI3_D_CRET,
T1.LAST_UPD GI3_D_MODF,
U1.LOGIN GI3_C_UTIL_CRET,
U2.LOGIN GI3_C_UTIL_MODF,
getdate() GI3_D_INS_INIT,
NULL GI3_D_INS_MODF 
from CX_CAS_DOUBLON AS T1 WITH (NOLOCK)
LEFT OUTER JOIN S_USER U1 WITH (NOLOCK)
    ON T1.CREATED_BY = U1.ROW_ID
LEFT OUTER JOIN S_USER U2 WITH (NOLOCK)
    ON T1.LAST_UPD_BY = U2.ROW_ID</property>
