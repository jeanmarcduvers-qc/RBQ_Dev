                              refId="Package\embarque\Phase 1 - Intervenants - Sites- Adresses - Interlocuteurs - LOV\Site\Lien Sites-Adresses\SRC_siebeldb S_CON_ADDR.Connections[OleDbConnection]"
                              connectionManagerID="Package.ConnectionManagers[SiebelDB]"
                              connectionManagerRefId="Package.ConnectionManagers[SiebelDB]"
