                              synchronousInputId="Package\embarque\Phase 1 - Intervenants - Sites- Adresses - Interlocuteurs - LOV\Lien Site + Appareil\Appareils\GI3_APPAREIL.Inputs[Entrée de destination OLE DB]">
                              <outputColumns>
                                <outputColumn
