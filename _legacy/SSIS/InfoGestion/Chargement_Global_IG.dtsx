              <DTS:ObjectData>
                <pipeline
                  version="1">
                  <components>
                    <component
                      refId="Package\embarque\Formation continue\Declaration formation continue\CX_DECL_FCON"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="CX_DECL_FCON"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT T1.[ROW_ID]						AS GI3_C_ROWD_DECL_FORM
      ,CONVERT(DATETIME, T1.[CREATED] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_CRET]
      ,T1.[CREATED_BY]					AS GI3_C_UTIL_CRET
      ,CONVERT(DATETIME, T1.[LAST_UPD] AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time') AS [GI3_D_MODF]
      ,T1.[LAST_UPD_BY]					AS GI3_C_UTIL_MODF
	  ,GETDATE()						AS GI3_D_INS_INIT
      ,[X_GI_C_STAT_DECL_FORM_CONT]		AS GI3_C_STAT_DECL_FORM
      ,[X_GI_D_DECL_FORM_CONT]			AS GI3_D_DECL_FORM
      ,[PAR_ROW_ID_CXDECL_FCON]			AS GI3_C_ROWD_DECL_FORM_PAR
      ,[PAR_ROW_ID_CXPERD_FCON]			AS GI3_C_ROWD_PERD_FORM
      ,[PAR_ROW_ID_SCONTACT_REPN]		AS GI3_C_ROWD_INTRL
      ,[PAR_ROW_ID_SORG_EXT_DECL]		AS GI3_C_ROWD_INTRVN
      ,[PAR_ROW_ID_SPROD_INT_CRSE]		AS GI3_C_ROWD_FORM_CONT
      ,[X_GI_A_COUR_CONF_DECL_FORM]		AS GI3_C_ADR_COUR_CONF_DECL_FORM
      ,[X_GI_I_CONS_DECL_FORM_CONT]		AS GI3_I_CONS_DECL_FORM
      ,[X_GI_D_ANNL_DECL_FORM_CONT]		AS GI3_D_ANNL_DECL_FORM
      ,[X_GI_C_RAIS_ANNL_DECL_FORM]		AS GI3_C_RAIS_ANNL_DECL_FORM
      ,[X_GI_D_PART_FORM_CONT]			AS GI3_D_PART_FORM_CONT
	  ,[X_GI_DE_REPR_HEUR_FORM_CONT]	AS GI3_DE_REPR_HEUR_FORM_CONT
	  ,[X_GI_DE_REPR_DOMN_FORM_CONT]	AS GI3_DE_REPR_DOMN_FORM_CONT
	  ,[X_GI_A_COUR_SAIS_DECL_FCO]		AS GI3_A_COUR_SAIS_DECL_FCO
	  ,[X_GI_NM_REPN_SAIS_DECL_FCO]		AS GI3_NM_REPN_SAIS_DECL_FCO
	  ,[X_GI_NM_PREN_REPN_SAIS_DFCO]	AS GI3_NM_PREN_REPN_SAIS_DFCO
	  ,[X_GI_NO_LICN_DECL_FORM_CONT]	AS GI3_C_NO_LICN_DECL_FCO
	  ,[X_GI_NO_INTR_DECL_FORM_CONT]	AS GI3_C_NO_INTR_DECL_FCO
	  ,[PAR_ROW_ID_SDOC_AGREE]			AS GI3_C_ROWD_DROT_EXER

FROM [dbo].[CX_DECL_FCON] T1 WITH (NOLOCK)
INNER JOIN [S_USER] AS U1 WITH (NOLOCK)
    ON T1.[CREATED_BY] = U1.[ROW_ID]
INNER JOIN [S_USER] AS U2 WITH (NOLOCK)
    ON T1.[LAST_UPD_BY] = U2.[ROW_ID]

WHERE T1.CREATED &lt; (SELECT DATEADD(dd, 0, DATEDIFF(dd, 0, GETDATE())) + '00:00')</property>
