        <DTS:Executable
          DTS:refId="Package\embarque\Adresses de correspondance"
          DTS:CreationName="STOCK:SEQUENCE"
          DTS:Description="Conteneur de séquences"
          DTS:DTSID="{4C79CD36-563B-4705-ABB0-70AD3300CE23}"
