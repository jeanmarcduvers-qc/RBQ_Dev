            <DTS:Executable
              DTS:refId="Package\embarque\Produits et compétences\Moyen eval habilitation"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:Description="Data Flow Task"
              DTS:DTSID="{46AE7A10-EE80-4BFF-86C7-BBD6028CB662}"
              DTS:ExecutableType="Microsoft.Pipeline"
              DTS:LocaleID="-1"
