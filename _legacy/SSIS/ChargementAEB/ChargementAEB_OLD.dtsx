                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
T.DR_C_MUNP as AE_C_MUNC,
T.DR_NM_MUNP as AE_NM_MUNC,
R.DR_C_REGN_ADMN as AE_C_REGN_ADMN,
C.DR_C_MRC as AE_C_MRC,
T.DR_S_MUNP as AE_S_MUNC,
fth.DR_C_MUNP as AE_C_MUNC_OFFC

FROM DR1_MUNICIPALITE T

INNER JOIN DR1_REGION_ADMINISTRATIVE R ON R.DR_N_SEQN_REGN_ADMN = T.DR_N_SEQN_REGN_ADMN

LEFT JOIN DR1_MUNICIPALITE_REGIONALE_COMTE C ON C.[DR_N_SEQN_MRC] = T.[DR_N_SEQN_MRC]

left join DR1_MUNICIPALITE fth on T.DR_N_SEQN_MUNP_OFFC = fth.DR_N_SEQN_MUNP</property>
