          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0D5C663D-78AB-470A-BFDC-0FFDDB85E87B}"
              SQLTask:SqlStatementSource="insert into AEB.AE1_RESULTAT_INSCRIPTION (AE_N_SEQN_RESL, AE_N_SEQN_INSC)&#xA;select  AE_N_SEQN_RESL, AE_N_SEQN_INSC&#xA; from aeb.AE1_INSCRIPTION insc &#xA;inner join aeb.AE1_RESULTAT result on insc.AE_C_EXAM = result.AE_C_EXAM and insc.AE_N_DOSS_NDI = result.AE_N_DOSS_NDI&#xA;where result.AE_N_DOSS_NDI is not null&#xA;and insc.AE_C_RAIS_ANNL_INSC is null                                           &#xA;and result.AE_I_ABSN &lt;&gt; 'O'&#xA;and result.AE_V_VECT_CODE_RESN_CAND IS NOT NULL&#xA;  order by insc.AE_N_SEQN_INSC " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
