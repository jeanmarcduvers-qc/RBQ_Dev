                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT DISTINCT T.DR_V_CODE_POST,
		M.DR_C_MUNP 
FROM 	DR1_CODE_POSTAL_MUNICIPALITE_POSTALE T
		INNER JOIN DR1_MUNICIPALITE M ON M.DR_N_SEQN_MUNP = T.DR_N_SEQN_MUNP AND M.DR_N_SEQN_REGN_ADMN IS NOT NULL
WHERE T.DR_D_SUPP_CODE_POST_MUNC_POST IS NULL
ORDER BY 1</property>
