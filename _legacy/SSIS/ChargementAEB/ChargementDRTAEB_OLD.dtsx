                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 	T.DR_C_MUNP,
	T.DR_NM_MUNP,
	R.DR_C_REGN_ADMN,
	T.DR_S_MUNP 
FROM 	DR1_MUNICIPALITE T
		INNER JOIN DR1_REGION_ADMINISTRATIVE R ON R.DR_N_SEQN_REGN_ADMN = T.DR_N_SEQN_REGN_ADMN
ORDER BY T.DR_C_MUNP</property>
