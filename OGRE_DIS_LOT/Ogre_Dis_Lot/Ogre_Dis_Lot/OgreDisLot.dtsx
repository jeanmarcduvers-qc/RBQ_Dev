                                                            "AND     ((tbl_RegionIntervention.Domaine) = 'GA') " +
                                                            "AND     ((tbl_RegionIntervention.Nbr_Inspection) > 0)) " +
                                                            ") sQry_SitesTermines_GA " +
                                                    "GROUP BY sQry_SitesTermines_GA.Statut, " +
                                                             "sQry_SitesTermines_GA.Revalide, " +
                                                             "sQry_SitesTermines_GA.Finale, " +
                                                             "sQry_SitesTermines_GA.TypeSignalement, " +
                                                             "sQry_SitesTermines_GA.No_site, " +
                                                             "sQry_SitesTermines_GA.[GA], " +
                                                             "sQry_SitesTermines_GA.TraiterAscenseur, " +
