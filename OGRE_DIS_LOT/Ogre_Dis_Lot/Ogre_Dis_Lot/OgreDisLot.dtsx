                //////////////////////////////////////////////////////////////////////
                ///
                //     Recherche le proprio du site
                ///
                /////////////////////////////////////////////////////////////////////
                string Get_SiteProprio(string pNoSite)
                {
                    string sqlCmdSite = "SELECT TOP 1 dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, " +
                                               "dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROLE, " +
                                               "dbo_GI3_INTERVENANT.GI3_NM_INTRVN, " +
                                               "dbo_GI3_INTERVENANT.GI3_A_COUR, " +
                                               "dbo_GI3_INTERVENANT.GI3_N_TELP, " +
                                               "dbo_GI3_INTERVENANT.GI3_N_TELC, " +
                                               "dbo_GI3_INTERVENANT.GI3_C_INTRVN, " +
                                               "dbo_GI3_ADRESSE.GI3_A_ADRS_LIGN_1, " +
                                               "dbo_GI3_ADRESSE.GI3_A_ADRS_LIGN_2, " +
                                               "dbo_GI3_ADRESSE.GI3_A_ADRS_LIGN_3, " +
                                               "dbo_GI3_INTERVENANT.GI3_N_CELLULAIRE " +
                                       "FROM   ((([SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT as dbo_GI3_LIEN_SITE_INTERVENANT " +
                                               "INNER JOIN [SDGIC01].[dbo].GI3_INTERVENANT as dbo_GI3_INTERVENANT ON dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN = dbo_GI3_INTERVENANT.GI3_C_ROWD_INTRVN)" +
                                               "INNER JOIN [SDGIC01].[dbo].GI3_LIEN_INTERVENANT_ADRESSE as dbo_GI3_LIEN_INTERVENANT_ADRESSE ON dbo_GI3_INTERVENANT.GI3_C_ROWD_INTRVN = dbo_GI3_LIEN_INTERVENANT_ADRESSE.GI3_C_ROWD_INTRVN) " +
                                               "INNER JOIN [SDGIC01].[dbo].GI3_ADRESSE as dbo_GI3_ADRESSE ON dbo_GI3_LIEN_INTERVENANT_ADRESSE.GI3_C_ROWD_ADRS = dbo_GI3_ADRESSE.GI3_C_ROWD_ADRS) " +
                                               "INNER JOIN [SDGIC01].[dbo].GI3_SITE_COMPOSANTE as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE " +
                                       "WHERE   (((dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE) = '" + pNoSite + "') " +
                                       "AND      ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROLE) = 'Proprietaire') " +
                                       "AND      ((dbo_GI3_INTERVENANT.GI3_S_DOSS) = 'Active') " +
                                       "AND      ((dbo_GI3_LIEN_INTERVENANT_ADRESSE.GI3_D_FIN)Is Null) " +
                                       "AND      ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_D_FIN)Is Null) " +
                                       "AND      ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Actif' " +
                                              "Or (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Non exploite') " +
                                       "AND      ((dbo_GI3_LIEN_INTERVENANT_ADRESSE.GI3_C_TYPE_UTIL) = 'Principale')) ";


                    string strSiteProprio = "";
                    EtapeDebug = "Get_SiteProprio";

                    try
                    {
                        SqlConnection mySQLConnectionSiteProprio =
                        Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                        as SqlConnection;

                        // Récupère la capacité du site
                        SqlCommand commandDataReader = new SqlCommand(sqlCmdSite, mySQLConnectionSiteProprio);
                        SqlDataReader ValueReader = commandDataReader.ExecuteReader();

                        while (ValueReader.Read())
                        {
                            strSiteProprio = ValueReader["GI3_C_INTRVN"].ToString();
                        }

                        ValueReader.Close();
                        mySQLConnectionSiteProprio.Close();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("Get_SiteProprio()", ex.Message.ToString());
                        LoadTableErreur = true;
                    }
                    return strSiteProprio;
                }

                //////////////////////////////////////////////////////////////////////
                ///
                //     Mise à jour des sites à revalider
                ///
                /////////////////////////////////////////////////////////////////////
                void MajSiteRevalide(string strNoSite, string strDomaine)
                {
                    string sqlCmd = "";
                    string strEtape = "";

                    EtapeDebug = "MajSiteRevalide";
                    try
                    {
                        // Modifier le statut du dossier
                        strEtape = "tbl_DossiersSuivi";
                        sqlCmd = "UPDATE tbl_DossiersSuivi SET tbl_DossiersSuivi.Statut = 'Revalider' WHERE tbl_DossiersSuivi.No_site='" + strNoSite + "'";

                        using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                        {
                            conn.Open();
                            using (var transaction = conn.BeginTransaction())
                            {
                                OleDbCommand SQLCommandUpdt = new OleDbCommand(sqlCmd.ToString(), conn, transaction);
                                SQLCommandUpdt.CommandType = CommandType.Text;
                                SQLCommandUpdt.CommandTimeout = 12000;
                                SQLCommandUpdt.ExecuteNonQuery();
                                transaction.Commit();
                            }
                            conn.Close();
                        }

                        // Remettre les indicateur de mise à jour de GIC à vide dans la table du suivi
                        strEtape = "tbl_SuiviSite";
                        sqlCmd = "UPDATE tbl_SuiviSite SET Statut = 'Revalider', Contact_Complete = False, Contact_NonRequis = False, Justification_Complete = False, Justification_NonRequis = False, NoteInspecteur_Complete = False, NoteInspecteur_NonRequis = False, Interlocuteurs_Complete = False, NoteInspection_Complete = False, Gaz_Complete = False, Gaz_NonRequis = False, Transformation_Complete = False, Transformation_NonRequis = False, AutreProprio_Complete = False, AutreProprio_NonRequis = False, Appareil_Complete = False, Appareil_NonRequis = False, Date_Statut = Now() WHERE No_site='" + strNoSite + "'";

                        using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                        {
                            conn.Open();
                            using (var transaction = conn.BeginTransaction())
                            {
                                OleDbCommand SQLCommandUpdt = new OleDbCommand(sqlCmd.ToString(), conn, transaction);
                                SQLCommandUpdt.CommandType = CommandType.Text;
                                SQLCommandUpdt.CommandTimeout = 12000;
                                SQLCommandUpdt.ExecuteNonQuery();
                                transaction.Commit();
                            }
                            conn.Close();
                        }

                        // Ajouter le changement de statut dans l'historique
                        strEtape = "tbl_HistoriqueStatut";
                        sqlCmd = "INSERT INTO tbl_HistoriqueStatut ( NoSite, Statut, DateMajStatut, Commentaire, IDUser ) Values('" + strNoSite + "', 'Revalider', Now(), 'Revalider site dans GIC avant la création intervention en '" + strDomaine + "' (délais de 3 mois)', 'SSIS'";

                        using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                        {
                            conn.Open();
                            using (var transaction = conn.BeginTransaction())
                            {
                                OleDbCommand SQLCommandUpdt = new OleDbCommand(sqlCmd.ToString(), conn, transaction);
                                SQLCommandUpdt.CommandType = CommandType.Text;
                                SQLCommandUpdt.CommandTimeout = 12000;
                                SQLCommandUpdt.ExecuteNonQuery();
                                transaction.Commit();
                            }
                            conn.Close();
                        }
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("MajSiteRevalide(" + strEtape + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                    }
                }

                //////////////////////////////////////////////////////////////////////
                ///
                //     JournalEvent
                ///
                /////////////////////////////////////////////////////////////////////
                void JournalEvent(string pstrEtape, string pstrDescription, string pstrUsager, string pstrErreur, string pstrSite)
                {
                    string strUsager = "PPA_OGRE_LOT";
                    string sqlCmd = "";
                    string sqlCmdSystemeEvent = "SELECT Etape, Description From tbl_SystemeEvent WHERE Etape = 'Valide Algo création des interventions' AND Description = '%1' and Site = '%2'";
                    string sqlInsSystemeEvent = "INSERT INTO tbl_SystemeEvent ( DateEvent, Etape, Description, Usager, Erreur, Site ) VALUES (Now(), '%1', '%2', '%3', '%4', '%5')";
                    bool insJournalEvent = true;

                    if (pstrUsager == "") { strUsager = "PPA_OGRE_LOT"; } else { strUsager = pstrUsager; }

                    try
                    {
                        using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                        {
                            conn.Open();

                            if (pstrEtape == "Valide Algo création des interventions")
                            {
                                sqlCmd = sqlCmdSystemeEvent.Replace("%1", pstrDescription.Replace("'", "''")).Replace("%2", pstrSite);

                                OleDbCommand SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                                SQLCommandExec.CommandType = CommandType.Text;
                                SQLCommandExec.CommandTimeout = 12000;
                                OleDbDataReader readerExec = SQLCommandExec.ExecuteReader(CommandBehavior.SequentialAccess | CommandBehavior.SingleResult);
                                readerExec.Read();

                                if (readerExec.HasRows == true)
                                {
                                    insJournalEvent = false;
                                }

                                readerExec.Close();
                            }

                            if (insJournalEvent)
                            {
                                sqlCmd = sqlInsSystemeEvent.Replace("%1", pstrEtape.Replace("'", "''")).Replace("%2", pstrDescription.Replace("'", "''")).Replace("%3", strUsager.Replace("'", "''")).Replace("%4", pstrErreur.Replace("'", "''")).Replace("%5", pstrSite);

                                using (var transaction = conn.BeginTransaction())
                                {
                                    using (var cmd = new OleDbCommand(sqlCmd.ToString(), conn, transaction))
                                    {
                                        cmd.ExecuteNonQuery();
                                    }

                                    transaction.Commit();

                                }
                            }
                            conn.Close();
                        }
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("JournalEvent(" + pstrEtape + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                    }
                }

