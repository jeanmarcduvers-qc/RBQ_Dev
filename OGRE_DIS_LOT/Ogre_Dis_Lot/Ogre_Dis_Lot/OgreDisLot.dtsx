                            "ORDER BY dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE";

        public const string sqlCmdRM = "SELECT dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS NoSite,  " +
                                   "dbo_GI3_APPAREIL.GI3_N_IMMAT_APL AS No_Immatriculation,  " +
                                   "dbo_GI3_APPAREIL.GI3_NM_FABR_CONTR AS NomFabricant,  " +
