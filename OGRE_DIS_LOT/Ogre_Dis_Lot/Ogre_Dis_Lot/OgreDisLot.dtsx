                                                                           "Sum(1) AS SommeDomaine " +
                                                                    "FROM  (([SDGIC01].[dbo].[GI3_INTERVENTION] AS dbo_GI3_INTERVENTION " +
                                                                           "INNER JOIN [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] AS dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_INTERVENTION.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE) " +
                                                                           "INNER JOIN [SDGIC01].[dbo].[GI3_LIEN_SITE_ADRESSE] AS dbo_GI3_LIEN_SITE_ADRESSE ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_ROWD_SITE) " +
                                                                           "INNER JOIN [SDGIC01].[dbo].[GI3_ADRESSE] AS dbo_GI3_ADRESSE ON dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_ROWD_ADRS = dbo_GI3_ADRESSE.GI3_C_ROWD_ADRS " +
                                                                    "GROUP BY dbo_GI3_ADRESSE.GI3_NM_REG_ADMN, " +
                                                                                "Left([GI3_DE_DOMN_INTRVT],2), " +
                                                                                "dbo_GI3_INTERVENTION.GI3_C_ASSIGNE_A, " +
                                                                                "dbo_GI3_INTERVENTION.GI3_C_CODE_INTRVT, " +
                                                                                "dbo_GI3_INTERVENTION.GI3_S_INTRVT, " +
                                                                                "dbo_GI3_LIEN_SITE_ADRESSE.GI3_I_PRIN, " +
                                                                                "dbo_GI3_LIEN_SITE_ADRESSE.GI3_D_FIN, " +
                                                                                "dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_TYPE_UTIL " +
                                                                        "HAVING  (((dbo_GI3_INTERVENTION.GI3_C_ASSIGNE_A) = 'SADMIN') " +
                                                                        "AND      ((dbo_GI3_INTERVENTION.GI3_C_CODE_INTRVT) = 'Sécurité') " +
                                                                        "AND      ((dbo_GI3_INTERVENTION.GI3_S_INTRVT) = 'Non débutée') " +
                                                                        "AND      ((dbo_GI3_LIEN_SITE_ADRESSE.GI3_I_PRIN) = 'Y') " +
                                                                        "AND      ((dbo_GI3_LIEN_SITE_ADRESSE.GI3_D_FIN) Is Null) " +
                                                                        "AND      ((dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_TYPE_UTIL) = 'Principale')) " +
                                                                        "UNION " +
                                                                        "SELECT   tbl_Region.Région, " +
                                                                                 "tbl_RegionIntervention.Domaine, " +
                                                                                 "0 AS SommeDom " +
                                                                        "FROM    [SDDMU01].[dbo].[ORGRE_tbl_Region] AS tbl_Region " +
                                                                                "INNER JOIN [SDDMU01].[dbo].[ORGRE_RegionIntervention] AS tbl_RegionIntervention ON tbl_Region.NoRégion = tbl_RegionIntervention.NoRégion " +
                                                                                ")	sQry_DossiersOuvertGIC " +
                                                                        "GROUP BY sQry_DossiersOuvertGIC.Region_Adm, sQry_DossiersOuvertGIC.Domaine) Qry_DossiersOuvertGIC " + 
                                                                "INNER JOIN  (([SDDMU01].[dbo].[ORGRE_tbl_DossiersSuivi] AS tbl_DossiersSuivi " +
                                                                "INNER JOIN    [SDDMU01].[dbo].[ORGRE_Site_SELECTion] AS tbl_Site_Selection ON tbl_DossiersSuivi.No_site = tbl_Site_Selection.NoSite) " +
                                                                "INNER JOIN   ([SDDMU01].[dbo].[ORGRE_tbl_Region] AS tbl_Region " +
                                                                "INNER JOIN    [SDDMU01].[dbo].[ORGRE_RegionIntervention] AS tbl_RegionIntervention ON tbl_Region.NoRégion = tbl_RegionIntervention.NoRégion) " +
                                                                           "ON tbl_Site_Selection.RegionAdm = tbl_Region.Région) " +
                                                                           "ON (Qry_DossiersOuvertGIC.Domaine = tbl_RegionIntervention.Domaine) AND(Qry_DossiersOuvertGIC.Region_Adm = tbl_Region.Région) " +
                                                            "WHERE  (((tbl_DossiersSuivi.Statut) = 'Terminé' Or (tbl_DossiersSuivi.Statut) = 'Retiré-Intrv') " +
                                                            "AND     ((tbl_DossiersSuivi.TypeSignalement) = '9' Or (tbl_DossiersSuivi.TypeSignalement) = '7') " +
                                                            "AND     ((tbl_DossiersSuivi.[BA]) > 0) " +
                                                            "AND     ((tbl_Site_Selection.TraiterAscenseur) = 0) " +
                                                            "AND     ((tbl_RegionIntervention.Domaine) = 'BA') " +
                                                            "AND     ((tbl_RegionIntervention.Nbr_Inspection) > 0)) " +
                                                            ") sQry_SitesTermines_BA " +
                                                    "GROUP BY sQry_SitesTermines_BA.Statut, " +
                                                             "sQry_SitesTermines_BA.Revalide, " +
                                                             "sQry_SitesTermines_BA.Finale, " +
                                                             "sQry_SitesTermines_BA.TypeSignalement, " +
                                                             "sQry_SitesTermines_BA.No_site, " +
                                                             "sQry_SitesTermines_BA.[BA], " +
                                                             "sQry_SitesTermines_BA.TraiterAscenseur, " +
                                                             "sQry_SitesTermines_BA.DateTerminé, " +
                                                             "sQry_SitesTermines_BA.RegionAdm, " +
                                                             "sQry_SitesTermines_BA.Domaine, " +
                                                             "sQry_SitesTermines_BA.BA_GIC, " +
                                                             "sQry_SitesTermines_BA.SommeDomaine";

        public const string strSqlContact = "SELECT count(*) FROM tbl_Fiche_Inspecteur";
        public const string strSqlInterventionCount = "SELECT count(1) FROM tbl_Intervention WHERE ((tbl_Intervention.No_Site) = '%1') AND ((tbl_Intervention.Date_Interv_GIC) >= DateAdd('d', -30, Now))";
        public const string strSqlFicheInspecteur = "Select id, NoSite from tbl_Fiche_Inspecteur where NoSite is not null";

        public const string strSqlSitesTerminesSansImpression = "SELECT tbl_SystemeEvent.Id, " +
                                                          "tbl_SystemeEvent.Site, " +
                                                          "tbl_SystemeEvent.Traitee, " +
                                                          "tbl_SystemeEvent.DateEvent, " +
                                                          "tbl_SystemeEvent.Etape, " +
                                                          "tbl_DossiersSuivi.Statut, " +
                                                          "tbl_DossiersSuivi.No_site, " +
                                                          "tbl_SystemeEvent.Description, " +
                                                          "tbl_SystemeEvent.Erreur " +
                                                   "FROM   tbl_SystemeEvent " +
                                                           "LEFT JOIN tbl_DossiersSuivi ON tbl_SystemeEvent.Site = tbl_DossiersSuivi.No_site " +
                                                   "WHERE  (((tbl_SystemeEvent.Traitee) = False) " +
                                                   "AND     ((tbl_SystemeEvent.DateEvent) < DateSerial(Year(Now()), Month(Now()), Day(Now()))) " +
                                                   "AND     ((tbl_SystemeEvent.Etape) = 'Impression Fiche Inspecteur') " +
                                                   "AND     ((tbl_DossiersSuivi.Statut) = 'Terminé' Or (tbl_DossiersSuivi.Statut) = 'Retiré' Or (tbl_DossiersSuivi.Statut) = 'Retiré-Intrv')) " +
                                                   "OR     (((tbl_SystemeEvent.Traitee) = False) " +
                                                   "AND     ((tbl_SystemeEvent.DateEvent) < DateSerial(Year(Now()), Month(Now()), Day(Now()))) " + 
                                                   "AND     ((tbl_SystemeEvent.Etape) = 'Impression Manuelle Fiche Inspecteur')) " +
                                                   "ORDER BY tbl_SystemeEvent.DateEvent";
      
        public const string strSQLFiche_Inspecteur_AS = "SELECT SSQry_Site_TypeAppareil.GI3_N_SITE AS SiteParent, " +
                                                               "dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS SiteEnfant, " +
                                                               "dbo_GI3_APPAREIL.GI3_N_APPR_LIEU_APL AS No_Id_SurLieu, " +
                                                               "Qry_Genre_Appareil.GI3_DE_VALEUR AS Genre_Appareil, " +
                                                               "dbo_GI3_APPAREIL.GI3_C_TYPE_MACH_AS AS TypeMachine, " +
                                                               "IIF(dbo_GI3_APPAREIL.GI3_Q_PALR_AS is null, 0, dbo_GI3_APPAREIL.GI3_Q_PALR_AS) AS Nbre_Pallier, " +
                                                               "IIf(dbo_GI3_APPAREIL.GI3_C_FABR_APPR is null, dbo_GI3_APPAREIL.GI3_NM_ANCN_FABR_APPR, dbo_GI3_APPAREIL.GI3_C_FABR_APPR) AS NomFabricant, " +
                                                               "dbo_GI3_APPAREIL.GI3_D_INST AS DateMiseEnService, " +
                                                               "IIf([dbo_GI3_APPAREIL_SCELLE].[GI3_C_ROWD_APPR] is null,'',IIf([dbo_GI3_APPAREIL_SCELLE].[GI3_D_FIN] is null,'O','N')) AS Scelle, " +
                                                               "dbo_GI3_SITE_COMPOSANTE.GI3_NM_ENDR, " +
                                                               "Qry_SousGenre_Appareil.GI3_DE_VALEUR AS SousGenreApp, " +
                                                               "IIf([Qry_Date_Dern_Activite].[DT_DERN_ACT] is not null " +
                                                               "And [Qry_Date_Dern_Inspection].[DT_DERN_ASS] is not null, " +
                                                               "IIf([Qry_Date_Dern_Inspection].[DT_DERN_ASS] >= [Qry_Date_Dern_Activite].[DT_DERN_ACT], [Qry_Date_Dern_Inspection].[DT_DERN_ASS], [Qry_Date_Dern_Activite].[DT_DERN_ACT]), " +
                                                               "IIf([Qry_Date_Dern_Inspection].[DT_DERN_ASS] is not null And [Qry_Date_Dern_Activite].[DT_DERN_ACT] is null,[Qry_Date_Dern_Inspection].[DT_DERN_ASS],[Qry_Date_Dern_Activite].[DT_DERN_ACT])) AS Date_Dern_Insp " +
                                                         "FROM  ((((( " +
                                                                "(SELECT dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, " +
                                                                           "IIf([dbo_GI3_SITE_COMPOSANTE_1].[GI3_C_ROWD_SITE] is null, [dbo_GI3_SITE_COMPOSANTE].[GI3_C_ROWD_SITE], [dbo_GI3_SITE_COMPOSANTE_1].[GI3_C_ROWD_SITE]) AS RowSite, " +
                                                                           "dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE, " +
                                                                           "dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN, " +
                                                                           "dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS SiteParent, " +
                                                                           "dbo_GI3_SITE_COMPOSANTE_1.GI3_N_SITE AS SiteEnfant " +
                                                                    "FROM (([SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] AS dbo_GI3_SITE_COMPOSANTE " +
                                                                           "LEFT JOIN [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] AS dbo_GI3_SITE_COMPOSANTE_1 ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE_1.GI3_C_ROWD_SITE_PRIN) " +
                                                                           "LEFT JOIN [SDGIC01].[dbo].[GI3_LIEN_SITE_INTERVENANT] AS dbo_GI3_LIEN_SITE_INTERVENANT ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_SITE) " +
                                                                           "LEFT JOIN [SDGIC01].[dbo].[GI3_LIEN_SITE_INTERVENANT] AS dbo_GI3_LIEN_SITE_INTERVENANT_1 ON dbo_GI3_SITE_COMPOSANTE_1.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_C_ROWD_SITE " +
                                                                    "WHERE (((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN) = [dbo_GI3_LIEN_SITE_INTERVENANT].[GI3_C_ROWD_INTRVN] " +
                                                                         "Or (dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN) Is Null) " +
                                                                       "AND ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROLE) = 'Proprietaire') " +
                                                                       "AND ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Actif' " +
                                                                         "Or (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Non exploite') " +
                                                                       "AND ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_D_FIN) Is Null) " +
                                                                       "AND ((dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_C_ROLE) = 'Proprietaire' " +
                                                                       "Or   (dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_C_ROLE) Is Null) " +
                                                                       "AND ((dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) = 'Actif' " +
                                                                         "Or (dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) = 'Fusion' " +
                                                                         "Or (dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) ='Non exploite' Or (dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) Is Null) AND ((dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE) = '[EntrerNoSite]')) " +
                                                                    "UNION " +
                                                                    "SELECT dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, " +
                                                                          "dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE AS RowSite, " +
                                                                          "dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE, " +
                                                                          "dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN, " +
                                                                          "dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS SiteParent, " +
                                                                          "null AS SiteEnfant " +
                                                                    "FROM  [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] AS dbo_GI3_SITE_COMPOSANTE " +
                                                                          "INNER JOIN [SDGIC01].[dbo].[GI3_LIEN_SITE_INTERVENANT] AS dbo_GI3_LIEN_SITE_INTERVENANT ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_SITE " +
                                                                    "WHERE (((dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE) = '[EntrerNoSite]') " +
                                                                    "AND    ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROLE) = 'Proprietaire') " +
                                                                    "AND    ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Actif' " +
                                                                        "Or  (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Non exploite') " +
                                                                       "AND ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_D_FIN) Is Null)) " +
                                                                ") SSQry_Site_TypeAppareil " +
                                                                "INNER JOIN [SDGIC01].[dbo].[GI3_APPAREIL] AS dbo_GI3_APPAREIL " +
                                                                "INNER JOIN [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] AS dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_APPAREIL.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE " +
                                                                "    ON SSQry_Site_TypeAppareil.[RowSite] = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE) " +
                                                                "LEFT JOIN [SDGIC01].[dbo].[GI3_APPAREIL_SCELLE] as dbo_GI3_APPAREIL_SCELLE ON dbo_GI3_APPAREIL.GI3_C_ROWD_APPR = dbo_GI3_APPAREIL_SCELLE.GI3_C_ROWD_APPR) " +
                                                                "LEFT JOIN (SELECT dbo_GI3_ACTIVITE.GI3_C_ROWD_APPR AS CLE_APP_ACT, Max(dbo_GI3_ACTIVITE.GI3_D_FIN_ACTV) AS DT_DERN_ACT " +
                                                                            "FROM [SDGIC01].[dbo].[GI3_ACTIVITE] AS dbo_GI3_ACTIVITE " +
                                                                            "	 INNER JOIN [SDGIC01].[dbo].[GI3_APPAREIL] AS dbo_GI3_APPAREIL ON dbo_GI3_ACTIVITE.GI3_C_ROWD_APPR = dbo_GI3_APPAREIL.GI3_C_ROWD_APPR " +
                                                                            "GROUP BY dbo_GI3_ACTIVITE.GI3_C_ROWD_APPR " +
                                                                           ") Qry_Date_Dern_Activite ON dbo_GI3_APPAREIL.GI3_C_ROWD_APPR = Qry_Date_Dern_Activite.CLE_APP_ACT) " +
                                                                "LEFT JOIN (SELECT dbo_GI3_APPAREIL_XM.GI3_C_ROWD_APPR AS CLE_APP_XM, Max(dbo_GI3_APPAREIL_XM.GI3_D_INSP) AS DT_DERN_ASS " +
                                                                            "FROM [SDGIC01].[dbo].[GI3_APPAREIL_XM] AS dbo_GI3_APPAREIL_XM " +
                                                                            "GROUP BY dbo_GI3_APPAREIL_XM.GI3_C_ROWD_APPR " +
                                                                           ") Qry_Date_Dern_Inspection ON dbo_GI3_APPAREIL.GI3_C_ROWD_APPR = Qry_Date_Dern_Inspection.CLE_APP_XM) " +
                                                                "LEFT JOIN (SELECT dbo_GI3_VALEUR.GI3_DE_VALEUR, dbo_GI3_VALEUR.GI3_NM_VALEUR " +
                                                                            "FROM [SDGIC01].[dbo].[GI3_VALEUR] AS dbo_GI3_VALEUR " +
                                                                            "GROUP BY dbo_GI3_VALEUR.GI3_DE_VALEUR, dbo_GI3_VALEUR.GI3_NM_VALEUR, dbo_GI3_VALEUR.GI3_C_VALEUR, dbo_GI3_VALEUR.GI3_I_ACTIF " +
                                                                            "HAVING (((dbo_GI3_VALEUR.GI3_C_VALEUR) = 'RBQ_GENRE_APPAREIL') " +
                                                                            "AND     ((dbo_GI3_VALEUR.GI3_I_ACTIF) = 'Y')) " +
                                                                           ") Qry_Genre_Appareil ON dbo_GI3_APPAREIL.GI3_C_GENR_APPR = Qry_Genre_Appareil.GI3_NM_VALEUR) " +
                                                                "LEFT JOIN (SELECT dbo_GI3_VALEUR.GI3_DE_VALEUR, dbo_GI3_VALEUR.GI3_NM_VALEUR " +
                                                                            "FROM [SDGIC01].[dbo].[GI3_VALEUR] AS dbo_GI3_VALEUR " +
                                                                            "GROUP BY dbo_GI3_VALEUR.GI3_DE_VALEUR, dbo_GI3_VALEUR.GI3_NM_VALEUR, dbo_GI3_VALEUR.GI3_C_VALEUR, dbo_GI3_VALEUR.GI3_I_ACTIF " +
                                                                            "HAVING (((dbo_GI3_VALEUR.GI3_C_VALEUR) = 'RBQ_SOUS_GENRE_APPAREIL') " +
                                                                            "AND     ((dbo_GI3_VALEUR.GI3_I_ACTIF) = 'Y')) " +
                                                                           ") Qry_SousGenre_Appareil ON dbo_GI3_APPAREIL.GI3_C_SOUS_GENR_APPR = Qry_SousGenre_Appareil.GI3_NM_VALEUR " +
                                                        "WHERE  (((dbo_GI3_APPAREIL.GI3_C_TYPE_APPR) = 'AL') " +
                                                        "AND     ((dbo_GI3_APPAREIL.GI3_S_APPR) = 'ACTIF') " +
                                                        "AND     ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Actif' Or (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Non exploite')) " +
                                                        "ORDER BY SSQry_Site_TypeAppareil.GI3_N_SITE, dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, dbo_GI3_APPAREIL.GI3_N_APPR_LIEU_APL ";

        public const string strSqlSitesTypeAppareil = "SELECT dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, " +
                                                "IsNull(dbo_GI3_SITE_COMPOSANTE_1.GI3_C_ROWD_SITE, dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE) AS RowSite, " +
                                                "dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE, " +
                                                "dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN, " +
                                                "dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS SiteParent, " +
                                                "dbo_GI3_SITE_COMPOSANTE_1.GI3_N_SITE AS SiteEnfant " +
                                          "FROM (([SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] as dbo_GI3_SITE_COMPOSANTE " +
                                                "LEFT JOIN [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] AS dbo_GI3_SITE_COMPOSANTE_1 ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE_1.GI3_C_ROWD_SITE_PRIN) " +
                                                "LEFT JOIN [SDGIC01].[dbo].[GI3_LIEN_SITE_INTERVENANT] as dbo_GI3_LIEN_SITE_INTERVENANT ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_SITE) " +
                                                "LEFT JOIN [SDGIC01].[dbo].[GI3_LIEN_SITE_INTERVENANT] AS dbo_GI3_LIEN_SITE_INTERVENANT_1 ON dbo_GI3_SITE_COMPOSANTE_1.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_C_ROWD_SITE " +
                                         "WHERE (((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN) = dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN " +
                                             "Or  (dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN) Is Null) " +
                                            "AND ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROLE) = 'Proprietaire') " +
                                            "AND ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Actif' " +
                                             "Or  (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Non exploite') " +
                                            "AND ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_D_FIN)Is Null) " +
                                            "AND ((dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_C_ROLE) = 'Proprietaire' " +
                                             "Or  (dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_C_ROLE) Is Null) " +
                                            "AND ((dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) = 'Actif' " +
                                             "Or  (dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) = 'Fusion' " +
                                             "Or  (dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) = 'Non exploite' " +
                                             "Or  (dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) Is Null) " +
                                            "AND ((dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE) = '%EntrerNoSite%')) " +
                                            "UNION " +
                                            "SELECT dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, " +
                                                   "dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE AS RowSite, " +
                                                   "dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE, " +
                                                   "dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN, " +
                                                   "dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS SiteParent, " +
                                                   "null AS SiteEnfant " +
                                           "FROM  [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] as dbo_GI3_SITE_COMPOSANTE " +
                                                  "INNER JOIN [SDGIC01].[dbo].[GI3_LIEN_SITE_INTERVENANT] as dbo_GI3_LIEN_SITE_INTERVENANT ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_SITE " +
                                           "WHERE (((dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE) = '%EntrerNoSite%') " +
                                           "AND    ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROLE) = 'Proprietaire') " +
                                           "AND    ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Actif' " +
                                             "Or    (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Non exploite') " +
                                           "AND    ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_D_FIN) Is Null))";

        public const string strSqlMesureDiff = "SELECT  dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, GI3_C_DOMN_INTR " +
                                   "FROM   [SDGIC01].[dbo].[GI3_DOCUMENT_NUMERISE] as dbo_GI3_DOCUMENT_NUMERISE " +
                                        "INNER JOIN [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_DOCUMENT_NUMERISE.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE " +
                                   "WHERE  dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE = '%1' " +
                                   "and    (((dbo_GI3_DOCUMENT_NUMERISE.GI3_DE_TYPE_DOCM) = 'MED - Réponse') " +
                                   "AND     ((dbo_GI3_DOCUMENT_NUMERISE.GI3_C_DOMN_INTR) in ('AS - Ascenseurs', 'BA - Bâtiment', 'EL - Électricité', 'GA - Gaz', 'PB - Plomberie') " +
                                   "And      (dbo_GI3_DOCUMENT_NUMERISE.GI3_C_DOMN_INTR) = 'autres app.') " +
                                   "AND     ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Actif' " +
                                   "Or       (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Non exploite'))";

        public const string strSqlMiseJourCBCS_Adoption = "UPDATE tbl_Fiche_Inspecteur " +
                                                            "LEFT JOIN TbMuniCBCS ON tbl_Fiche_Inspecteur.NomMuniSite = TbMuniCBCS.NomMuni " +
                                                           "SET tbl_Fiche_Inspecteur.CBCS = TbMuniCBCS.CBCS, " +
                                                           "tbl_Fiche_Inspecteur.ModeAdoption = IIf(UCase(TbMuniCBCS.CBCS) = 'OUI', IIf(IsNull(TbMuniCBCS.ModeAdoption) or TbMuniCBCS.ModeAdoption = '', 'Partielle', TbMuniCBCS.ModeAdoption), 'Non')";


        public const string sqlCmdSiteAdresse = "SELECT TOP 1 [SDGIC01].[dbo].GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE, " +
                   "[SDGIC01].[dbo].GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE_PRIN, " +
                   "[SDGIC01].[dbo].GI3_SITE_COMPOSANTE.GI3_NM_ENDR, " +
                   "[SDGIC01].[dbo].GI3_ADRESSE.GI3_A_ADRS_LIGN_1, " +
                   "[SDGIC01].[dbo].GI3_ADRESSE.GI3_A_ADRS_LIGN_2, " +
                   "[SDGIC01].[dbo].GI3_ADRESSE.GI3_A_ADRS_LIGN_3, " +
                   "[SDGIC01].[dbo].GI3_ADRESSE.GI3_NM_REG_ADMN, " +
                   "[SDGIC01].[dbo].GI3_ADRESSE.GI3_NM_MUNC " +
              "FROM [SDGIC01].[dbo].GI3_SITE_COMPOSANTE, " +
                   "[SDGIC01].[dbo].GI3_LIEN_SITE_ADRESSE, " +
                   "[SDGIC01].[dbo].GI3_ADRESSE " +
             "WHERE [SDGIC01].[dbo].GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = [SDGIC01].[dbo].GI3_LIEN_SITE_ADRESSE.GI3_C_ROWD_SITE " +
               "AND [SDGIC01].[dbo].GI3_LIEN_SITE_ADRESSE.GI3_C_ROWD_ADRS = [SDGIC01].[dbo].GI3_ADRESSE.GI3_C_ROWD_ADRS " +
               "AND [SDGIC01].[dbo].GI3_SITE_COMPOSANTE.GI3_N_SITE = 'strNoSite' " +
               "AND [SDGIC01].[dbo].GI3_LIEN_SITE_ADRESSE.GI3_D_FIN IS NULL " +
               "AND ([SDGIC01].[dbo].GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP = 'Actif' OR [SDGIC01].[dbo].GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP = 'Non exploite') " +
               "AND ([SDGIC01].[dbo].GI3_LIEN_SITE_ADRESSE.GI3_I_PRIN = 'Y' OR [SDGIC01].[dbo].GI3_LIEN_SITE_ADRESSE.GI3_I_PRIN IS NULL) " +
               "AND [SDGIC01].[dbo].GI3_LIEN_SITE_ADRESSE.GI3_C_TYPE_UTIL = 'Principale' " +
          "ORDER BY CASE WHEN [SDGIC01].[dbo].GI3_LIEN_SITE_ADRESSE.GI3_I_PRIN = 'Y' THEN 0 ELSE 1 END, " +
                   "[SDGIC01].[dbo].GI3_LIEN_SITE_ADRESSE.GI3_D_DEBUT DESC";

        public const string sqlCmdNote = "Select GI3_C_SUJT_NOTE_INTR, " +
                                   "GI3_C_SOUS_SUJT_NOTE, " +
                                   "GI3_DE_NOTE, " +
                                   "GI3_D_CRET " +
                              "FROM [SDGIC01].[dbo].[GI3_NOTE_INTERVENTION_APPR_SITE] " +
                             "WHERE GI3_C_ROWD_SITE = 'strRowSite' ORDER BY GI3_D_CRET ASC";

        public const string sqlCmdIntervenant = "SELECT [SDGIC01].[dbo].GI3_INTERVENANT.GI3_NM_INTRVN, " +
                                            "[SDGIC01].[dbo].GI3_INTERVENANT.GI3_A_COUR, " +
                                            "[SDGIC01].[dbo].GI3_INTERVENANT.GI3_N_TELP, " +
                                            "[SDGIC01].[dbo].GI3_INTERVENANT.GI3_N_TELC, " +
                                            "[SDGIC01].[dbo].GI3_INTERVENANT.GI3_C_INTRVN, " +
                                            "[SDGIC01].[dbo].GI3_INTERVENANT.GI3_C_ROWD_INTRVN, " +
                                            "[SDGIC01].[dbo].GI3_ADRESSE.GI3_A_ADRS_LIGN_1, " +
                                            "[SDGIC01].[dbo].GI3_ADRESSE.GI3_A_ADRS_LIGN_2, " +
                                            "[SDGIC01].[dbo].GI3_ADRESSE.GI3_A_ADRS_LIGN_3, " +
                                            "[SDGIC01].[dbo].GI3_INTERVENANT.GI3_N_CELLULAIRE, " +
                                            "[SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT.GI3_C_ROLE " +
                                            "FROM [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT, [SDGIC01].[dbo].GI3_INTERVENANT, [SDGIC01].[dbo].GI3_LIEN_INTERVENANT_ADRESSE, [SDGIC01].[dbo].GI3_ADRESSE " +
                                            "WHERE [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN = [SDGIC01].[dbo].GI3_INTERVENANT.GI3_C_ROWD_INTRVN " +
                                            "AND [SDGIC01].[dbo].GI3_INTERVENANT.GI3_C_ROWD_INTRVN = [SDGIC01].[dbo].GI3_LIEN_INTERVENANT_ADRESSE.GI3_C_ROWD_INTRVN " +
                                            "AND [SDGIC01].[dbo].GI3_LIEN_INTERVENANT_ADRESSE.GI3_C_ROWD_ADRS = [SDGIC01].[dbo].GI3_ADRESSE.GI3_C_ROWD_ADRS " +
                                            "AND [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_SITE = 'strRowSite' " +
                                            "AND [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT.GI3_C_ROLE = 'Propriétaire' " +
                                            "AND [SDGIC01].[dbo].GI3_INTERVENANT.GI3_S_DOSS = 'Active' " +
                                            "AND [SDGIC01].[dbo].GI3_LIEN_INTERVENANT_ADRESSE.GI3_D_FIN IS NULL " +
                                            "AND [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT.GI3_D_FIN IS NULL " +
                                            "AND [SDGIC01].[dbo].GI3_LIEN_INTERVENANT_ADRESSE.GI3_C_TYPE_UTIL = 'Principale'";

        public const string sqlCmdIntervenantAutre = "SELECT [SDGIC01].[dbo].GI3_INTERVENANT.GI3_NM_INTRVN, " +
                                            "[SDGIC01].[dbo].GI3_INTERVENANT.GI3_A_COUR, " +
                                            "[SDGIC01].[dbo].GI3_INTERVENANT.GI3_N_TELP, " +
                                            "[SDGIC01].[dbo].GI3_INTERVENANT.GI3_N_TELC, " +
                                            "[SDGIC01].[dbo].GI3_INTERVENANT.GI3_C_INTRVN, " +
                                            "[SDGIC01].[dbo].GI3_INTERVENANT.GI3_C_ROWD_INTRVN, " +
                                            "[SDGIC01].[dbo].GI3_INTERVENANT.GI3_N_CELLULAIRE," +
                                            "[SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT.GI3_C_ROLE " +
                                            "FROM [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT, [SDGIC01].[dbo].GI3_INTERVENANT " +
                                            "WHERE [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN = [SDGIC01].[dbo].GI3_INTERVENANT.GI3_C_ROWD_INTRVN " +
                                            "AND [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_SITE = 'strRowSite' " +
                                            "AND [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT.GI3_C_ROLE = 'Autre proprietaire' " +
                                            "AND [SDGIC01].[dbo].GI3_INTERVENANT.GI3_S_DOSS = 'Active' " +
                                            "AND [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT.GI3_D_FIN IS NULL ";

        public const string sqlCmdEnfant = "SELECT SiteEnfant.GI3_C_ROWD_SITE, " +
                                       "SiteEnfant.GI3_DE_STAT_SITE_COMP " +
                                "FROM [SDGIC01].[dbo].GI3_SITE_COMPOSANTE SiteEnfant " +
                               "WHERE SiteEnfant.GI3_C_ROWD_SITE_PRIN = 'strRowSite' " +
                                 "AND (SiteEnfant.GI3_DE_STAT_SITE_COMP = 'Actif' OR SiteEnfant.GI3_DE_STAT_SITE_COMP = 'Non exploite') ";

        public const string sqlCmdSite = "SELECT [SDGIC01].[dbo].GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_V_NUMR_ATTR, " +
                                   "[SDGIC01].[dbo].GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_V_TEXT_ATTR, " +
                                   "[SDGIC01].[dbo].GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_V_LIST_VALR, " +
                                   "[SDGIC01].[dbo].GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR " +
                              "FROM [SDGIC01].[dbo].GI3_ATTRIBUTS_SITE_COMPOSANTE, [SDGIC01].[dbo].GI3_ATTRIBUTS_SITE_COMP_VALEURS " +
                             "WHERE [SDGIC01].[dbo].GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_ATTR_SITE_COMP = [SDGIC01].[dbo].GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_C_ROWD_ATTR_SITE_COMP " +
                               "AND [SDGIC01].[dbo].GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_SITE = 'strRowSite' " +
                               "AND [SDGIC01].[dbo].GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_D_FIN IS NULL";

        public const string sqlCmdContact = "SELECT GI3_NM_CONT, " +
                                       "GI3_NM_PREN_CONT, " +
                                       "GI3_N_TELP_CONT, " +
                                       "GI3_N_POST_TELP_CONT, " +
                                       "GI3_A_COUR_CONT, " +
                                       "GI3_N_TELP_PORT, " +
                                       "GI3_A_COUR_CONT, " +
                                       "GI3_C_TYPE_CONT " +
                                 "FROM [SDGIC01].[dbo].[GI3_CONTACT] " +
                                "WHERE GI3_C_ROWD_SITE = 'strRowSite'  AND GI3_I_CONT_INAC <> 'Y' ORDER BY GI3_D_MODF ASC";

        public const string sqlCmdFicheInspecteur = "Insert into tbl_Fiche_Inspecteur (NomProprio, AutreProprio, No_Intervenant, Adr_Intervenant, NomContact, CourrielContact, NoTelContact, NoCellContact, CodeQualif, " +
                                                                         "NoSite, NomSite, AdresseSite, NomMuniSite, Contact_Concierge, NoTelConcierge, NoCellConcierge, NoteInspecteur, AnConstruc, NbEtage, " +
                                                                         "Aire, Type_Capacite, Maximum_Capacite, Agrandissement, AjoutEtage, ChgUsage, Construction, Gicleur, MesureDifferente, Diff_AS, Diff_BA, " +
                                                                         "Diff_EL, Diff_PB, Diff_GA, Nbr_ITRE, No_ITRE, Ascenseur, EscMecanique, MonteCharge, AscHandicape, AppLevage, NoCell_Intervenant, " +
                                                                         "FournisseurGAS, Composante, NotePPA) " +
                                                                         "values('strNomProprio', 'strAutreProprio', 'strNoIntervenant', 'strAdrIntervenant', 'strContactProprio', 'strCourrielInterloc', 'strNoTelInterloc', 'strNoTelInterloc', " +
                                                                         "'strCodeQualif', 'strNoSite', 'strNomSite', 'strAdresseSite', 'strNomMun', 'strConcierge', 'strNoTelConcierge', 'strNoCellConcierge', " +
                                                                         "'strNoteInspecteur', 'sngAnneeeConst', 'sngEtage', 'sngAir', 'strType_Capacite', 'sngCapacite', 'strAgrandissement', 'strAjoutEtage', 'strChgUsage', " +
                                                                         "intTypeConstruction, intGicleur, false, false, false, false, false, false, false, false, intAscenseur, intEscMecanique, intMonteCharge, " +
                                                                         "intAscHandicape, blnAppLevage, 'strNoTelInterloc', 'strNoteGaz', blnComposante, 'strNoteGroupeUsage')";

        public const string sqlCmdCheckSiteEnfant = "SELECT [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE].GI3_N_SITE, " +
                                                           "dbo_GI3_SITE_COMPOSANTE_1.GI3_N_SITE AS Site_Parent, " +
                                                           "dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_C_ROWD_INTRVN AS C_ROWD_INTRVN_Parent, " +
                                                           "dbo_GI3_SITE_COMPOSANTE_1.GI3_N_SITE as GetSite " +
                                                    "FROM(([SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] LEFT JOIN [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] AS dbo_GI3_SITE_COMPOSANTE_1 ON[SDGIC01].[dbo].[GI3_SITE_COMPOSANTE].GI3_C_ROWD_SITE_PRIN = dbo_GI3_SITE_COMPOSANTE_1.GI3_C_ROWD_SITE) " +
                                                           "LEFT JOIN [SDGIC01].[dbo].[GI3_LIEN_SITE_INTERVENANT] AS dbo_GI3_LIEN_SITE_INTERVENANT_1 ON[SDGIC01].[dbo].[GI3_SITE_COMPOSANTE].GI3_C_ROWD_SITE_PRIN = dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_C_ROWD_SITE)  " +
                                                     "WHERE[SDGIC01].[dbo].[GI3_SITE_COMPOSANTE].GI3_N_SITE = 'strNoSite'  " +
                                                     "AND dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_C_ROLE = 'Proprietaire'  " +
                                                     "AND dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_D_FIN Is Null";

        public const string sqlCmdContactII = "SELECT GI3_NM_CONT, " +
                                       "GI3_NM_PREN_CONT, " +
                                       "GI3_N_TELP_CONT, " +
                                       "GI3_N_POST_TELP_CONT, " +
                                       "GI3_A_COUR_CONT, " +
                                       "GI3_N_TELP_PORT, " +
                                       "GI3_A_COUR_CONT, " +
                                       "GI3_C_TYPE_CONT " +
                                 "FROM [SDGIC01].[dbo].GI3_CONTACT " +
                                "WHERE GI3_C_ROWD_SITE = 'strRowSite' ORDER BY GI3_D_MODF ASC";

        public const string sqlCmdSiteSelection = "Insert into tbl_Site_Selection (NoSite, NomSite, CodeQualif, NbEtage, AnConstruc, Gicleur, Aire, NbrPersonnes, NbrChambres, NbrLogements, TypeConstruction, AdresseSite, " +
                                                                "RegionAdm, FournisseurGas, AutreProprio, NoteInspecteur, NotePPA, A1, A2, A3, A4, B1, B2, B3, C, D, E, F1, F2, F3, NbEtageSS, PresenceStationnement, " +
                                                                "NbEtageStationnement, ChangementUsage, Agrandissment, AjoutÉtage, Contrainte, NoTelInterloc, NoCell_Interloc, Courriel_Interloc, Role_Intervenant, Nom_Proprio, " +
                                                                "Courriel_Intervenant, NoTel_Intervenant, NoCell_Intervenant, NoTelecIntervenant, No_intervenant, Adr_Intervenant, Contact_Intervant, Type_Capacite, Maximum_Capacite, " +
                                                                "Ascenseur, EscMecanique, MonteCharge, AscHandicape, AppLevage, NoSiteEnfant) Values (" +
                                                                "'strNoSite', 'strNomSite', 'strCodeQualif', sngEtage, sngAnneeeConst, intGicleur, sngAir, intNbrPersonnes, intNbrChambres, intNbrLogements, intTypeConstruction, 'strAdresseSite', " +
                                                                "'strRegionAdm', 'strNoteGaz', 'strNoteAutreProprio', 'strNoteInspecteur', 'strNoteGroupeUsage', 'strGroupeUsage02', 'strGroupeUsage04', 'strGroupeUsage06', 'strGroupeUsage08', 'strGroupeUsage10', " +
                                                                "'strGroupeUsage12', 'strGroupeUsage14', 'strGroupeUsage16', 'strGroupeUsage18', 'strGroupeUsage20', 'strGroupeUsage22', 'strGroupeUsage24', 'strGroupeUsage26', 'strGroupeUsage28', " +
                                                                "blnPresenceStationnement, 'strGroupeUsage30', 'strChgUsage', 'strAgrandissement', 'strAjoutEtage', 'strGroupeUsage34', 'strNoTelInterloc', 'strNoTelInterloc', 'strCourrielInterloc', " +
                                                                "'strRoleIntervenant', 'strNomProprio', 'strCourriel_Intervenant', 'strNoTel_Intervenant', 'strNoCell_Intervenant', 'strNoTelecIntervenant', 'strNoIntervenant', 'strAdrIntervenant', " +
                                                                "'strAutreProprio', 'strType_Capacite', intMaximum_Capacite, intAscenseur, intEscMecanique, intMonteCharge, intAscHandicape, blnAppLevage, 'strSiteEnfant')";

        public const string sqlCmdAjoutDossierSuivi = "select GI3_N_SITE, " +
                                                                "IIf( [NotePPA] = 0, 'Rechercher doublon', " +
                                                                "IIf( [NoteFiche] > 0 And DateDiff(m, [DateMax], GETDATE()) < 12, 'Terminé', 'Prise en charge')) AS Statut, " +
                                                                "GETDATE() AS DateNouveau, " +
                                                                "0 AS Expr6, " +
                                                                "0 AS Expr1, " +
                                                                "0 AS Expr7, " +
                                                                "0 AS Expr2, " +
                                                                "0 AS Expr3, " +
                                                                "0 AS Expr5, " +
                                                                "'%2' AS Finale, " +
                                                                "0 AS Expr4, " +
                                                                "7 AS Expr8 " +
                                                          "from( SELECT COMP.GI3_N_SITE, " +
                                                                       "[SDGIC01].[dbo].GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SUJT_NOTE_INTR, " +
                                                                       "NotePPA, " +
                                                                       "NoteInspecteur, " +
                                                                       "NoteFiche, " +
                                                                       "Max([SDGIC01].[dbo].GI3_NOTE_INTERVENTION_APPR_SITE.GI3_D_CRET) AS DateMax " +
                                                                 "FROM [SDGIC01].[dbo].GI3_SITE_COMPOSANTE " +
                                                                       "INNER JOIN[SDGIC01].[dbo].GI3_NOTE_INTERVENTION_APPR_SITE ON[SDGIC01].[dbo].GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = [SDGIC01].[dbo].GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_ROWD_SITE " +
                                                                                       "AND [SDGIC01].[dbo].GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SUJT_NOTE_INTR = 'PPA' " +
                                                                                       "AND [SDGIC01].[dbo].GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SOUS_SUJT_NOTE = 'Note Fiche d''inspection' " +
                                                                       "RIGHT JOIN (SELECT  [SDGIC01].[dbo].GI3_SITE_COMPOSANTE.GI3_N_SITE, " +
                                                                                           "Sum(IIf([SDGIC01].[dbo].[GI3_NOTE_INTERVENTION_APPR_SITE].[GI3_C_SUJT_NOTE_INTR] = 'PPA',1,0)) AS NotePPA, " +
                                                                                           "Sum(IIf([SDGIC01].[dbo].[GI3_NOTE_INTERVENTION_APPR_SITE].[GI3_C_SUJT_NOTE_INTR] = 'PPA' And[SDGIC01].[dbo].[GI3_NOTE_INTERVENTION_APPR_SITE].[GI3_C_SOUS_SUJT_NOTE] = 'Note Inspecteur', 1, 0)) AS NoteInspecteur, " +
                                                                                           "Sum(IIf([SDGIC01].[dbo].[GI3_NOTE_INTERVENTION_APPR_SITE].[GI3_C_SUJT_NOTE_INTR] = 'PPA' And[SDGIC01].[dbo].[GI3_NOTE_INTERVENTION_APPR_SITE].[GI3_C_SOUS_SUJT_NOTE] = 'Note Fiche d''inspection', 1, 0)) AS NoteFiche " +
                                                                                    "FROM  [SDGIC01].[dbo].GI3_SITE_COMPOSANTE " +
                                                                                           "LEFT JOIN [SDGIC01].[dbo].GI3_NOTE_INTERVENTION_APPR_SITE ON [SDGIC01].[dbo].GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = [SDGIC01].[dbo].GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_ROWD_SITE " +
                                                                                     "WHERE [SDGIC01].[dbo].GI3_SITE_COMPOSANTE.GI3_N_SITE = '%1' " +
                                                                                     "GROUP BY [SDGIC01].[dbo].GI3_SITE_COMPOSANTE.GI3_N_SITE) COMP ON COMP.GI3_N_SITE = [SDGIC01].[dbo].GI3_SITE_COMPOSANTE.GI3_N_SITE " +
                                                                 "GROUP BY COMP.GI3_N_SITE, " +
                                                                          "[SDGIC01].[dbo].GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SUJT_NOTE_INTR, " +
                                                                          "[SDGIC01].[dbo].GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SOUS_SUJT_NOTE, " +
                                                                          "NotePPA, " +
                                                                          "NoteInspecteur, " +
                                                                          "NoteFiche " +
                                                                 "HAVING  COMP.GI3_N_SITE = '%1') rest";

    }
}]]></ProjectItem>
