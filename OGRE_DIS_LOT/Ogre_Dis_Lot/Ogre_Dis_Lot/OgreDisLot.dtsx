                                                            "dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS SiteParent, " +
                                                            "dbo_GI3_SITE_COMPOSANTE_1.GI3_N_SITE AS SiteEnfant " +
                                                    "FROM (([SDGIC01].[dbo].GI3_SITE_COMPOSANTE as dbo_GI3_SITE_COMPOSANTE " +
                                                           "LEFT JOIN [SDGIC01].[dbo].GI3_SITE_COMPOSANTE AS dbo_GI3_SITE_COMPOSANTE_1 ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE_1.GI3_C_ROWD_SITE_PRIN)  " +
                                                           "LEFT JOIN [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT as dbo_GI3_LIEN_SITE_INTERVENANT ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_SITE) " +
                                                           "LEFT JOIN [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT AS dbo_GI3_LIEN_SITE_INTERVENANT_1 ON dbo_GI3_SITE_COMPOSANTE_1.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_C_ROWD_SITE " +
                                                    "WHERE (((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN) = dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN " +
                                                         "Or (dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN) Is Null) " +
                                                      "AND ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROLE) = 'Proprietaire') " +
                                                      "AND ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Actif' Or (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Non exploite') " +
                                                      "AND ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_D_FIN)Is Null) AND ((dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_C_ROLE) = 'Proprietaire' " +
                                                        "Or (dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_C_ROLE) Is Null) " +
                                                      "AND ((dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) = 'Actif' " +
                                                        "Or (dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) = 'Fusion' " +
                                                        "Or (dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) = 'Non exploite' " +
                                                        "Or (dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) Is Null) " +
                                                      "AND ((dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE) = '%1'))  " +
                                                    "UNION " +
                                                    "SELECT dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE,  " +
                                                           "dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE AS RowSite,  " +
                                                           "dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE,  " +
                                                           "dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN,  " +
                                                           "dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS SiteParent,  " +
                                                           "null AS SiteEnfant " +
                                                    "FROM [SDGIC01].[dbo].GI3_SITE_COMPOSANTE as dbo_GI3_SITE_COMPOSANTE " +
                                                        "INNER JOIN [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT as dbo_GI3_LIEN_SITE_INTERVENANT ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_SITE " +
                                                    "WHERE (((dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE) = '%1') " +
                                                    "AND  ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROLE) = 'Proprietaire') " +
                                                    "AND  ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Actif' " +
                                                       "Or  (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Non exploite') " +
                                                    "AND ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_D_FIN)Is Null))) Site_TypeAppareil " +
                                            "INNER JOIN ([SDGIC01].[dbo].GI3_APPAREIL as dbo_GI3_APPAREIL " +
                                            "INNER JOIN  [SDGIC01].[dbo].GI3_SITE_COMPOSANTE as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_APPAREIL.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE)  " +
                                                "ON Site_TypeAppareil.[RowSite] = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE " +
                                            "WHERE (((dbo_GI3_APPAREIL.GI3_C_TYPE_APPR) = 'AL') AND ((dbo_GI3_APPAREIL.GI3_S_APPR) = 'ACTIF') " +
