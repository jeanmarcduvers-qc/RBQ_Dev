        public const string sqlCmdTypeAppareil = "SELECT Site_TypeAppareil.GI3_N_SITE AS SiteParent, " +
                                                    "dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS SiteEnfant, " +
                                                    "dbo_GI3_APPAREIL.GI3_N_APPR_LIEU_APL AS No_Id_SurLieu, " +
                                                    "dbo_GI3_APPAREIL.GI3_C_TYPE_MACH_AS AS TypeMachine, " +
                                                    "dbo_GI3_APPAREIL.GI3_Q_PALR_AS AS Nbre_Pallier, " +
                                                    "isnull(dbo_GI3_APPAREIL.GI3_C_FABR_APPR, dbo_GI3_APPAREIL.GI3_NM_ANCN_FABR_APPR) AS NomFabricant, " +
                                                    "dbo_GI3_APPAREIL.GI3_D_INST AS DateMiseEnService, " +
                                                    "dbo_GI3_SITE_COMPOSANTE.GI3_NM_ENDR " +
                                            "FROM (SELECT dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, " +
                                                            "IIf(dbo_GI3_SITE_COMPOSANTE_1.GI3_C_ROWD_SITE is null, dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE, dbo_GI3_SITE_COMPOSANTE_1.GI3_C_ROWD_SITE) AS RowSite,  " +
                                                            "dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE, " +
