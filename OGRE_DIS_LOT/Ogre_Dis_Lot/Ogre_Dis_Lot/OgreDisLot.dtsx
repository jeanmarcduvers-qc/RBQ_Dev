                //////////////////////////////////////////////////////////////////////
                ///
                //     Impression des fiches inspecteurs 
                ///
                /////////////////////////////////////////////////////////////////////
                void ImpressionFicheInspecteur()
                {
                    int intCount = 0;
                    long lngCptFiche = 0;
                    string sqlCmdCount = "";
                    string strColonne = "";

                    string strSqlUpdate = "";
                    string strSqlDelete = "";
                    string strSqlCmd = "";
                    int intValueReaderContactCount = 0;
                    int intValueReaderInterventionCount = 0;
                    object resultCount;

                    EtapeDebug = "ImpressionFicheInspecteur";

                    JournalEvent("Impression Fiche Inspecteur", "Début de traitement", "PPA_OGRE_LOT", "", "");

                    // Mise à jour des tables vers SQL Server
                    majORGRE_RegionIntervention();
                    majORGRE_Site_Selection();
                    majORGRE_tbl_DossiersSuivi();

                    ValideSqlConnection(mySQLConnection);
                    SqlCommand commandDataReader = new SqlCommand(RequetesSQL.strSqlValideGIC, mySQLConnection);
                    SqlDataReader ValueReader = commandDataReader.ExecuteReader();

                    // Vérifier si GIC est à jour
                    while (ValueReader.Read())
                    {
                        // S'il existe un site Parent et que son intervenant est inscrit
                        // Validation : vérifie valeur non-vide et conversion réussie avant comparaison
                        if (!string.IsNullOrEmpty(ValueReader["MaxDeGI3_D_INS_INIT"].ToString()) &&
                            int.TryParse(ValueReader["MaxDeGI3_D_INS_INIT"].ToString(), out int maxGI3) &&
                            maxGI3 > 14)
                        {
                            //Inscrire dans le journal des événement du système que GIC n'est pas à jour.
                            JournalEvent("Impression Fiche Inspecteur", "Aucune fiche de créée. Dernière mise à jour de l'info de gestion effectué le (" + ValueReader["MaxDeGI3_D_INS_INIT"].ToString() + ")", "PPA_OGRE_LOT", "Info de gestion n''est pas à jour.", "");
                        }
                        else
                        {
                            using (var connSite = new OleDbConnection(strConnectBdAccess.ToString()))
                            {
                                connSite.Open();
                                using (OleDbDataAdapter dataAdapterSitesTerminesSansImpression = new OleDbDataAdapter(RequetesSQL.strSqlSitesTerminesSansImpression.ToString(), connSite))
                                {
                                    DataSet dataSetSitesTerminesSansImpression = new DataSet();
                                    dataAdapterSitesTerminesSansImpression.SelectCommand.CommandTimeout = 12000;
                                    dataAdapterSitesTerminesSansImpression.Fill(dataSetSitesTerminesSansImpression, "SitesTerminesSansImpression");

                                    // Si la table n'est pas vide
                                    if (dataSetSitesTerminesSansImpression.Tables["SitesTerminesSansImpression"].Rows.Count > 0)
                                    {
                                        foreach (DataRow pRowSitesTerminesSansImpression in dataSetSitesTerminesSansImpression.Tables["SitesTerminesSansImpression"].Rows)
                                        {

                                            // Mettre à jour la table d'impression pour l'impression de la fiche d'inscpection
                                            // Détruire le contenue des tables temporaires
                                            strSqlDelete = "DELETE tbl_Fiche_Inspecteur.* FROM tbl_Fiche_Inspecteur";
                                            using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                                            {
                                                conn.Open();
                                                using (var transaction = conn.BeginTransaction())
                                                {
                                                    OleDbCommand CmdDelete = new OleDbCommand(strSqlDelete.ToString(), conn, transaction);
                                                    CmdDelete.CommandType = CommandType.Text;
                                                    CmdDelete.ExecuteNonQuery();
                                                    transaction.Commit();
                                                    conn.Close();
                                                }
                                            }

                                            strSqlDelete = "DELETE tbl_Fiche_Inspecteur_AS.* FROM tbl_Fiche_Inspecteur_AS";
                                            using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                                            {
                                                conn.Open();
                                                using (var transaction = conn.BeginTransaction())
                                                {
                                                    OleDbCommand CmdDelete = new OleDbCommand(strSqlDelete.ToString(), conn, transaction);
                                                    CmdDelete.CommandType = CommandType.Text;
                                                    CmdDelete.ExecuteNonQuery();
                                                    transaction.Commit();
                                                    conn.Close();
                                                }
                                            }

                                            CreerSiteImpression(pRowSitesTerminesSansImpression["Site"].ToString(), false);

                                            intValueReaderContactCount = 3;
                                            intValueReaderInterventionCount = 3;
                                            // Valider s'il existe un contact pour le site.  Cette information est essentiel pour l'inspecteur
                                            using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                                            {
                                                conn.Open();
                                                using (OleDbCommand commandDataReaderContact = new OleDbCommand(RequetesSQL.strSqlContact, conn))
                                                {
                                                    intValueReaderContactCount = Convert.ToInt32(commandDataReaderContact.ExecuteScalar());
                                                }
                                            }

                                            sqlCmdCount = RequetesSQL.strSqlInterventionCount.Replace("%1", pRowSitesTerminesSansImpression["Site"].ToString());
                                            using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                                            {
                                                conn.Open();
                                                using (OleDbCommand commandDataReaderIntervention = new OleDbCommand(sqlCmdCount, conn))
                                                {
                                                    intValueReaderInterventionCount = Convert.ToInt32(commandDataReaderIntervention.ExecuteScalar());
                                                }
                                            }

                                            if (intValueReaderContactCount == 0 && intValueReaderInterventionCount == 0)
                                            {
                                                strSqlUpdate = "update tbl_SystemeEvent set Description = 'La fiche d’inspection n’a pas été générée.', " +
                                                                                            "Erreur = 'Aucune Fiche présente, site probablement fusionné.', " +
                                                                                            "Traitee = true " +
                                                                "where id = " + pRowSitesTerminesSansImpression["Id"].ToString();

                                                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                                                {
                                                    conn.Open();
                                                    using (var transaction = conn.BeginTransaction())
                                                    {
                                                        OleDbCommand CmdUpdate = new OleDbCommand(strSqlUpdate.ToString(), conn, transaction);
                                                        CmdUpdate.CommandType = CommandType.Text;
                                                        CmdUpdate.ExecuteNonQuery();
                                                        transaction.Commit();
                                                        conn.Close();
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                lngCptFiche++;

                                                // Valider si plus d'une fiche vont être imprimer pour ce site.
                                                if (intValueReaderContactCount > 1)
                                                {
                                                    strSqlUpdate = "update tbl_SystemeEvent set Erreur = 'Plusieurs fiches imprimées pour ce site. Veuillez vérifier les informations inscrites dans GIC.' " +
                                                                    "where id = " + pRowSitesTerminesSansImpression["Id"].ToString();

                                                    using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                                                    {
                                                        conn.Open();
                                                        using (var transaction = conn.BeginTransaction())
                                                        {
                                                            OleDbCommand CmdUpdateII = new OleDbCommand(strSqlUpdate.ToString(), conn, transaction);
                                                            CmdUpdateII.CommandType = CommandType.Text;
                                                            CmdUpdateII.ExecuteNonQuery();
                                                            transaction.Commit();
                                                            conn.Close();
                                                        }
                                                    }
                                                }

                                                strSqlCmd = RequetesSQL.strSqlSitesTypeAppareil.Replace("%EntrerNoSite%", pRowSitesTerminesSansImpression["Site"].ToString());
                                                using (SqlDataAdapter dataAdapterSitesTypeAppareil = new SqlDataAdapter(strSqlCmd.ToString(), mySQLConnectionII))
                                                {
                                                    DataSet dataSetSitesTypeAppareil = new DataSet();
                                                    dataAdapterSitesTypeAppareil.Fill(dataSetSitesTypeAppareil, "SitesTypeAppareil");

                                                    // Permet l'ajout des informations pour les composantes du Site dans la table temporaire
                                                    if (dataSetSitesTypeAppareil.Tables["SitesTypeAppareil"].Rows.Count > 0)
                                                    {
                                                        // Ajout des info pour chaque composantes du site
                                                        foreach (DataRow pRowSitesTypeAppareil in dataSetSitesTypeAppareil.Tables["SitesTypeAppareil"].Rows)
                                                        {
                                                            if (pRowSitesTypeAppareil["SiteEnfant"].ToString().ToString() != "")
                                                            {
                                                                CreerSiteImpression(pRowSitesTypeAppareil["SiteEnfant"].ToString(), true);
                                                            }

                                                        }
                                                    }
                                                }

                                                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                                                {
                                                    conn.Open();

                                                    using (OleDbDataAdapter dataAdapterFicheInspecteur = new OleDbDataAdapter(RequetesSQL.strSqlFicheInspecteur.ToString(), conn))
                                                    {
                                                        DataSet dataSetFicheInspecteur = new DataSet();
                                                        dataAdapterFicheInspecteur.SelectCommand.CommandTimeout = 12000;
                                                        dataAdapterFicheInspecteur.Fill(dataSetFicheInspecteur, "FicheInspecteur");

                                                        foreach (DataRow pRowFicheInspecteur in dataSetFicheInspecteur.Tables["FicheInspecteur"].Rows)
                                                        {
                                                            strSqlCmd = RequetesSQL.strSqlMesureDiff.Replace("%1", pRowFicheInspecteur["NoSite"].ToString());
                                                            using (SqlDataAdapter dataAdapterMesureDiff = new SqlDataAdapter(strSqlCmd.ToString(), mySQLConnectionII))
                                                            {
                                                                DataSet dataSetMesureDiff = new DataSet();
                                                                dataAdapterMesureDiff.Fill(dataSetMesureDiff, "MesureDiff");

                                                                // Permet l'update des informations pour la table tbl_Fiche_Inspecteur
                                                                if (dataSetMesureDiff.Tables["MesureDiff"].Rows.Count > 0)
                                                                {
                                                                    // Update tbl_Fiche_Inspecteur
                                                                    foreach (DataRow pRowMesureDiff in dataSetMesureDiff.Tables["MesureDiff"].Rows)
                                                                    {
                                                                        switch (pRowMesureDiff["GI3_C_DOMN_INTR"].ToString())
                                                                        {
                                                                            case "AS - Ascenseurs":
                                                                                strColonne = "Diff_AS";
                                                                                break;

                                                                            case "BA - Bâtiment":
                                                                                strColonne = "Diff_BA";
                                                                                break;

                                                                            case "EL - Électricité":
                                                                                strColonne = "Diff_EL";
                                                                                break;

                                                                            case "GA - Gaz":
                                                                                strColonne = "Diff_GA";
                                                                                break;

                                                                            case "PB - Plomberie":
                                                                                strColonne = "Diff_PB";
                                                                                break;
                                                                        }

                                                                        strSqlUpdate = "update tbl_Fiche_Inspecteur set " + strColonne + " = true, " +
                                                                                                                        "MesureDifferente = true " +
                                                                                        "where id = " + pRowFicheInspecteur["Id"].ToString();

                                                                        using (var connII = new OleDbConnection(strConnectBdAccess.ToString()))
                                                                        {
                                                                            connII.Open();
                                                                            using (var transaction = connII.BeginTransaction())
                                                                            {
                                                                                OleDbCommand CmdUpdateII = new OleDbCommand(strSqlUpdate.ToString(), connII, transaction);
                                                                                CmdUpdateII.CommandType = CommandType.Text;
                                                                                CmdUpdateII.ExecuteNonQuery();
                                                                                transaction.Commit();
                                                                                connII.Close();
                                                                            }
                                                                        }

                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    conn.Close();
                                                }
                                                mySQLConnectionII.Close();

                                                // Insert into tbl_Fiche_Inspecteur_AS
                                                ValideSqlConnection(mySQLConnectionII);
                                                sqlCmdMaj = RequetesSQL.strSQLFiche_Inspecteur_AS.ToString().Replace("[EntrerNoSite]", pRowSitesTerminesSansImpression["Site"].ToString());
                                                SqlCommand CmdInsertFichInsp = new SqlCommand(sqlCmdMaj.ToString(), mySQLConnectionII);
                                                CmdInsertFichInsp.CommandTimeout = 12000;
                                                SqlDataReader ValueReaderFichInsp = CmdInsertFichInsp.ExecuteReader();

                                                while (ValueReaderFichInsp.Read())
                                                {
                                                    var strSqlRequete = "INSERT INTO tbl_Fiche_Inspecteur_AS ( SiteParent, SiteComposant, No_Id_SurLieu, Genre_Appareil, TypeMachine, Nbre_Pallier, NomFabricant, DateMiseEnService, Scelle, GI3_NM_ENDR, SousGenreApp, Date_Dern_Insp ) " +
                                                                        "Values(strSiteParent, strSiteComposant, strNo_Id_SurLieu, strGenre_Appareil, strTypeMachine, nbNbre_Pallier, strNomFabricant, strDateMiseEnService, strScelle, strGI3_NM_ENDR, strSousGenreApp, strDate_Dern_Insp)";

                                                    if (string.IsNullOrEmpty(ValueReaderFichInsp["SiteParent"].ToString()))
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strSiteParent", "NULL");
                                                    }
                                                    else
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strSiteParent", ValueReaderFichInsp["SiteParent"].ToString());
                                                    }

                                                    if (string.IsNullOrEmpty(ValueReaderFichInsp["SiteEnfant"].ToString()))
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strSiteComposant", "NULL");
                                                    }
                                                    else
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strSiteComposant", "'" + ValueReaderFichInsp["SiteEnfant"].ToString() + "'");
                                                    }

                                                    if (string.IsNullOrEmpty(ValueReaderFichInsp["No_Id_SurLieu"].ToString()))
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strNo_Id_SurLieu", "NULL");
                                                    }
                                                    else
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strNo_Id_SurLieu", "'" + ValueReaderFichInsp["No_Id_SurLieu"].ToString() + "'");
                                                    }

                                                    if (string.IsNullOrEmpty(ValueReaderFichInsp["Genre_Appareil"].ToString()))
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strGenre_Appareil", "NULL");
                                                    }
                                                    else
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strGenre_Appareil", "'" + ValueReaderFichInsp["Genre_Appareil"].ToString().Replace("'", "’") + "'");
                                                    }


                                                    if (string.IsNullOrEmpty(ValueReaderFichInsp["TypeMachine"].ToString()))
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strTypeMachine", "NULL");
                                                    }
                                                    else
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strTypeMachine", "'" + ValueReaderFichInsp["TypeMachine"].ToString().Replace("'", "’") + "'");
                                                    }

                                                    if (string.IsNullOrEmpty(ValueReaderFichInsp["Nbre_Pallier"].ToString()))
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("nbNbre_Pallier", "NULL");
                                                    }
                                                    else
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("nbNbre_Pallier", ValueReaderFichInsp["Nbre_Pallier"].ToString());
                                                    }

                                                    if (string.IsNullOrEmpty(ValueReaderFichInsp["NomFabricant"].ToString()))
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strNomFabricant", "NULL");
                                                    }
                                                    else
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strNomFabricant", "'" + ValueReaderFichInsp["NomFabricant"].ToString().Replace("'", "’") + "'");
                                                    }

                                                    if (string.IsNullOrEmpty(ValueReaderFichInsp["DateMiseEnService"].ToString()))
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strDateMiseEnService", "NULL");
                                                    }
                                                    else
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strDateMiseEnService", "'" + ValueReaderFichInsp["DateMiseEnService"].ToString() + "'");
                                                    }

                                                    if (string.IsNullOrEmpty(ValueReaderFichInsp["Scelle"].ToString()))
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strScelle", "NULL");
                                                    }
                                                    else
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strScelle", "'" + ValueReaderFichInsp["Scelle"].ToString() + "'");
                                                    }

                                                    if (string.IsNullOrEmpty(ValueReaderFichInsp["GI3_NM_ENDR"].ToString()))
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strGI3_NM_ENDR", "NULL");
                                                    }
                                                    else
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strGI3_NM_ENDR", "'" + ValueReaderFichInsp["GI3_NM_ENDR"].ToString().Replace("'", "’") + "'");
                                                    }

                                                    if (string.IsNullOrEmpty(ValueReaderFichInsp["SousGenreApp"].ToString()))
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strSousGenreApp", "NULL");
                                                    }
                                                    else
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strSousGenreApp", "'" + ValueReaderFichInsp["SousGenreApp"].ToString() + "'");
                                                    }

                                                    if (string.IsNullOrEmpty(ValueReaderFichInsp["Date_Dern_Insp"].ToString()))
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strDate_Dern_Insp", "NULL");
                                                    }
                                                    else
                                                    {
                                                        strSqlRequete = strSqlRequete.ToString().Replace("strDate_Dern_Insp", "'" + ValueReaderFichInsp["Date_Dern_Insp"].ToString() + "'");
                                                    }

                                                    ExecuteSQL("insertFicheInspecteurAS", strSqlRequete);
                                                }
                                                ValueReaderFichInsp.Close();


                                                // Update MAJ CBCS Adoption
                                                strSqlUpdate = RequetesSQL.strSqlMiseJourCBCS_Adoption.ToString();

                                                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                                                {
                                                    conn.Open();
                                                    using (var transaction = conn.BeginTransaction())
                                                    {
                                                        OleDbCommand CmdUpdateCBCS = new OleDbCommand(strSqlUpdate.ToString(), conn, transaction);
                                                        CmdUpdateCBCS.CommandType = CommandType.Text;
                                                        CmdUpdateCBCS.ExecuteNonQuery();
                                                        transaction.Commit();
                                                        conn.Close();
                                                    }
                                                }

                                                sqlCmdCount = "select count(1) from tbl_Intervention where No_site = '" + pRowSitesTerminesSansImpression["Site"].ToString() + "' and Date_Interv_GIC >= DateAdd('d', -30, Now)";
                                                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                                                {
                                                    conn.Open();
                                                    OleDbCommand commandDataReaderCount = new OleDbCommand(sqlCmdCount, conn);
                                                    resultCount = commandDataReaderCount.ExecuteScalar();
                                                    intCount = Convert.ToInt32(resultCount);
                                                    conn.Close();
                                                }

                                                // load table ORGRE_Fiche_Inspecteur pour le rapport
                                                majORGRE_Fiche_Inspecteur();
                                                majORGRE_Fiche_Inspecteur_AS();

                                                if (intCount == 0)
                                                {
                                                    //Impression en format PDF de la fiche d'inspecteur
                                                    //ImprimePDF(ORGRE_Repertoire + @"\TestYvesMcDuff\", "Fiche_Inspecteur_(" + pRowSitesTerminesSansImpression["Site"].ToString() + ").pdf");
                                                    ImprimePDF(ORGRE_Repertoire + @"\FichesInspecteur\", "Fiche_Inspecteur_(" + pRowSitesTerminesSansImpression["Site"].ToString() + ").pdf");
                                                }
                                                else
                                                {
                                                    //Impression en format PDF de la fiche d'inspecteur
                                                    //ImprimePDF(ORGRE_Repertoire + @"\TestYvesMcDuff\", "Plainte_Fiche_Inspecteur_(" + pRowSitesTerminesSansImpression["Site"].ToString() + ").pdf");
                                                    ImprimePDF(ORGRE_Repertoire + @"\FichesInspecteur\", "Plainte_Fiche_Inspecteur_(" + pRowSitesTerminesSansImpression["Site"].ToString() + ").pdf");
                                                }

                                                strSqlUpdate = "update tbl_SystemeEvent set Traitee = true " +
                                                                "where id = " + pRowSitesTerminesSansImpression["Id"].ToString();

                                                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                                                {
                                                    conn.Open();
                                                    OleDbCommand CmdUpdate = new OleDbCommand(strSqlUpdate.ToString(), conn);
                                                    CmdUpdate.CommandType = CommandType.Text;
                                                    CmdUpdate.ExecuteNonQuery();
                                                    conn.Close();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    JournalEvent("Impression Fiche Inspecteur", lngCptFiche + " Fiche(s) créé(s)", "PPA_OGRE_LOT", "", "");
                    ValueReader.Close();
                }

                //////////////////////////////////////////////////////////////////////
                ///
                //     Récupère le path de ORGRE
                ///
                /////////////////////////////////////////////////////////////////////
                void PathOGRE()
                {
                    string sqlCmdRep = "SELECT tbl_Param_Stat.Repertoire_OGRE From tbl_Param_Stat";

                    EtapeDebug = "PathOGRE";

                    // Récupère le répertoire
                    using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                    {
                        conn.Open();
                        using (OleDbCommand commandDataReader = new OleDbCommand(sqlCmdRep, conn))
                        {
                            OleDbDataReader ValueReader = commandDataReader.ExecuteReader(CommandBehavior.SequentialAccess | CommandBehavior.SingleResult);
                            while (ValueReader.Read())
                            {
                                ORGRE_Repertoire = ValueReader["Repertoire_OGRE"].ToString();
                            }
                            conn.Close();
                            ValueReader.Close();
                        }
                    }


                    // Valide si le répertoire et les sous répertoires existes
                    if (string.IsNullOrEmpty(ORGRE_Repertoire.ToString()))
                    {
                        InsertTableLogJobPlanificateur("PathOGRE()", "La valeur dans tbl_Param_Stat.Repertoire_OGRE est vide");
                        LoadTableErreur = true;
                    }
                    else
                    {
                        //if (!Directory.Exists(ORGRE_Repertoire + @"\TestYvesMcDuff"))
                        if (!Directory.Exists(ORGRE_Repertoire + @"\FichesInspecteur"))
                        {
                            //System.IO.Directory.CreateDirectory(ORGRE_Repertoire + @"\TestYvesMcDuff");
                            System.IO.Directory.CreateDirectory(ORGRE_Repertoire + @"\FichesInspecteur");
                        }
                    }

                }

                //////////////////////////////////////////////////////////////////////
                ///
                //     Création du site 
                ///
                /////////////////////////////////////////////////////////////////////
                bool CreerSiteImpression(string strNoSite, bool blnComposante)
                {
                    object resultCount;
                    string strSqlRequete;
                    bool blCreerSiteImpression = true;

                    string strRowSite = "";
                    string strNomSite = "";
                    string strAdresseSite = "";
                    string strNomMun = "";
                    int intTypeConstruction = 0;
                    int intGicleur = 0;
                    string strRegionAdm = "";
                    string strType_Capacite = "";
                    double dblMaximum_Capacite;

                    string strNoteGaz = "";
                    string strNoteAutreProprio = "";
                    string strNoteGroupeUsage = "";
                    string strNoteInspecteur = "";

                    string strAgrandissement = "";
                    string strAjoutEtage = "";
                    string strChgUsage = "";

                    string[] strGroupeUsageImp = new string[0];
                    bool blnPresenceStationnement = false;

                    string strAutreProprio = "";
                    string strNomProprio = "";
                    string strNoIntervenant = "";
                    string strAdrIntervenant = "";
                    string strRoleIntervenant = "";
                    string strNoTel_Intervenant = "";
                    string strNoCell_Intervenant = "";
                    string strCourriel_Intervenant = "";
                    string strNoTelecIntervenant = "";

                    int intAscenseur = 0;
                    int intEscMecanique = 0;
                    int intMonteCharge = 0;
                    int intAscHandicape = 0;
                    bool blnAppLevage = false;

                    int sngAnneeeConst = 0;
                    double dblEtage = 0;
                    double dblCapacite = 0;
                    string strCodeQualif = "";
                    double dblAir = 0;

                    string strContactProprio = "";
                    string strNoTelInterloc = "";
                    //string strNoCellInterloc = "";
                    string strCourrielInterloc = "";

                    string strConcierge = "";
                    string strNoTelConcierge = "";
                    string strNoCellConcierge = "";
                    string strCourrielConcierge = "";

                    EtapeDebug = "CreerSiteImpression";

                    // ======================
                    // Section Site + Adresse
                    strSqlRequete = RequetesSQL.sqlCmdSiteAdresse.Replace("strNoSite", strNoSite);
                    SqlCommand commandDataReaderSiteAdresse = new SqlCommand(strSqlRequete, mySQLConnectionSiteImpression);
                    SqlDataReader ValueReaderSiteAdresse = commandDataReaderSiteAdresse.ExecuteReader();

                    if (ValueReaderSiteAdresse.HasRows)
                    {
                        while (ValueReaderSiteAdresse.Read())
                        {

                            strRowSite = ValueReaderSiteAdresse["GI3_C_ROWD_SITE"].ToString();
                            strNomSite = ValueReaderSiteAdresse["GI3_NM_ENDR"].ToString().Replace("'", "’");
                            strAdresseSite = ValueReaderSiteAdresse["GI3_A_ADRS_LIGN_1"].ToString() + newLine + ValueReaderSiteAdresse["GI3_A_ADRS_LIGN_2"].ToString() + newLine + ValueReaderSiteAdresse["GI3_A_ADRS_LIGN_3"].ToString();
                            strAdresseSite = strAdresseSite.TrimEnd().Replace("'", "’");
                            strAdresseSite = strAdresseSite.Substring(0, Math.Min(250, strAdresseSite.Length));
                            strRegionAdm = ValueReaderSiteAdresse["GI3_NM_REG_ADMN"].ToString().Replace("'", "’");


                            if (strRegionAdm.ToString() == "")
                            {
                                strRegionAdm = "Autre";
                            }
                            strNomMun = ValueReaderSiteAdresse["GI3_NM_MUNC"].ToString().Replace("'", "’");

                        }

                        ValueReaderSiteAdresse.Close();
                        commandDataReaderSiteAdresse.Clone();
                        mySQLConnectionSiteImpression.Close();
                        mySQLConnectionSiteImpression.Open();

                        // ======================
                        // Section Note
                        strSqlRequete = RequetesSQL.sqlCmdNote.Replace("strRowSite", strRowSite);
                        SqlCommand commandDataReaderNote = new SqlCommand(strSqlRequete, mySQLConnectionSiteImpression);
                        SqlDataReader ValueReaderNote = commandDataReaderNote.ExecuteReader();

                        if (ValueReaderNote.HasRows)
                        {
                            while (ValueReaderNote.Read())
                            {
                                switch (ValueReaderNote["GI3_C_SUJT_NOTE_INTR"].ToString())
                                {
                                    case "PPA":
                                        switch (ValueReaderNote["GI3_C_SOUS_SUJT_NOTE"].ToString())
                                        {
                                            case "Alimentation en gaz":
                                                strNoteGaz = ValueReaderNote["GI3_DE_NOTE"].ToString().Replace("'", "’");
                                                break;

                                            case "Autres proprietaires":
                                                strNoteAutreProprio = ValueReaderNote["GI3_DE_NOTE"].ToString().Replace("'", "’");
                                                break;

                                            case "Note Fiche d'inspection":
                                                strNoteGroupeUsage = ValueReaderNote["GI3_DE_NOTE"].ToString().Replace("'", "’");
                                                strNoteGroupeUsage = strNoteGroupeUsage.Substring(0, Math.Min(250, strNoteGroupeUsage.Length));

                                                break;

                                            case "Note inspecteur":
                                                strNoteInspecteur = ValueReaderNote["GI3_DE_NOTE"].ToString().Replace("'", "’");
                                                break;
                                        }
                                        break;

                                    case "TRANSFORMATION":
                                        switch (ValueReaderNote["GI3_C_SOUS_SUJT_NOTE"].ToString())
                                        {
                                            case "Agrandissement":
                                                strAgrandissement = ValueReaderNote["GI3_DE_NOTE"].ToString().Replace("'", "’");
                                                break;

                                            case "Ajout etage":
                                                strAjoutEtage = ValueReaderNote["GI3_DE_NOTE"].ToString().Replace("'", "’");
                                                break;

                                            case "Changement usage":
                                                strChgUsage = ValueReaderNote["GI3_DE_NOTE"].ToString().Replace("'", "’");
                                                break;
                                        }
                                        break;
                                }

                            }
                        }
                        else
                        {
                            strNoteGaz = "";
                            strNoteAutreProprio = "";
                            strNoteGroupeUsage = "";
                            strNoteInspecteur = ""; ;
                            strAgrandissement = "";
                            strAjoutEtage = "";
                            strChgUsage = "";
                        }

                        ValueReaderNote.Close();
                        mySQLConnectionSiteImpression.Close();
                        mySQLConnectionSiteImpression.Open();

                        if (strNoteGroupeUsage == "")
                        { strNoteGroupeUsage = "USAGE;A1;0;A2;0;A3;0;A4;0;B1;0;B2;0;B3;0;C;0;D;0;E;0;F1;0;F2;0;F3;0;SOUSSOL;000;STATIONNEMENT;000;TRANSFORMATION;0000;CONTRAINTEDACCES;Aucune contrainte"; }

                        strGroupeUsageImp = strNoteGroupeUsage.ToString().Split(';');

                        // Validation complète : vérifie (1) taille array, (2) valeur non-vide, (3) conversion réussie
                        if (strGroupeUsageImp.Length > 30 &&
                        !string.IsNullOrEmpty(strGroupeUsageImp[30]) &&
                        int.TryParse(strGroupeUsageImp[30].ToString(), out int valeurStationnement) &&
                        valeurStationnement > 0)
                        {
                            blnPresenceStationnement = true;
                        }
                        else
                        {
                            blnPresenceStationnement = false;
                        }

                        // ======================
                        // Section Intervenant 
                        strSqlRequete = RequetesSQL.sqlCmdIntervenant.Replace("strRowSite", strRowSite);
                        SqlCommand commandDataReaderIntervenant = new SqlCommand(strSqlRequete, mySQLConnectionSiteImpression);
                        SqlDataReader ValueReaderIntervenant = commandDataReaderIntervenant.ExecuteReader();

                        if (ValueReaderIntervenant.HasRows)
                        {
                            while (ValueReaderIntervenant.Read())
                            {
                                strNomProprio = ValueReaderIntervenant["GI3_NM_INTRVN"].ToString().Replace("'", "’");
                                strNoIntervenant = ValueReaderIntervenant["GI3_C_INTRVN"].ToString().Replace("'", "’");
                                strAdrIntervenant = ValueReaderIntervenant["GI3_A_ADRS_LIGN_1"].ToString() + newLine + ValueReaderIntervenant["GI3_A_ADRS_LIGN_2"].ToString() + newLine + ValueReaderIntervenant["GI3_A_ADRS_LIGN_3"].ToString();
                                strAdrIntervenant = strAdrIntervenant.TrimEnd().Replace("'", "’");
                                strRoleIntervenant = "Propriétaire";
                                strNoTelecIntervenant = ValueReaderIntervenant["GI3_N_TELC"].ToString().Replace("'", "’");
                                strNoTel_Intervenant = ValueReaderIntervenant["GI3_N_TELP"].ToString().Replace("'", "’");
                                strNoCell_Intervenant = ValueReaderIntervenant["GI3_N_TELP"].ToString().Replace("'", "’");
                                strCourriel_Intervenant = ValueReaderIntervenant["GI3_A_COUR"].ToString().Replace("'", "’");

                            }
                        }
                        else
                        {
                            strNomProprio = "";
                            strNoIntervenant = "";
                            strAdrIntervenant = "";
                            strRoleIntervenant = "Propriétaire";
                            strNoTel_Intervenant = "";
                            strNoCell_Intervenant = "";
                            strCourriel_Intervenant = "";
                            strNoTelecIntervenant = "";
                        }

                        ValueReaderIntervenant.Close();
                        mySQLConnectionSiteImpression.Close();
                        mySQLConnectionSiteImpression.Open();

                        // =========================
                        // Section Intervenant Autre
                        strSqlRequete = RequetesSQL.sqlCmdIntervenantAutre.Replace("strRowSite", strRowSite);
                        SqlCommand commandDataReaderIntervenantAutre = new SqlCommand(strSqlRequete, mySQLConnectionSiteImpression);
                        SqlDataReader ValueReaderIntervenantAutre = commandDataReaderIntervenantAutre.ExecuteReader();

                        if (ValueReaderIntervenantAutre.HasRows)
                        {
                            strAutreProprio = "";

                            while (ValueReaderIntervenantAutre.Read())
                            {
                                strAutreProprio = strAutreProprio + ValueReaderIntervenantAutre["GI3_NM_INTRVN"].ToString().Replace("'", "’") + ", ";
                            }
                            strAutreProprio = strAutreProprio.Substring(0, strAutreProprio.Length - 2);
                        }
                        else
                        {
                            strAutreProprio = "";
                        }

                        ValueReaderIntervenantAutre.Close();
                        mySQLConnectionSiteImpression.Close();
                        mySQLConnectionSiteImpression.Open();

                        // ======================
                        // Section Appareil
                        strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + strRowSite + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR = '26'";
                        SqlCommand commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnectionSiteImpression);
                        resultCount = commandDataReaderAppareil.ExecuteScalar();
                        intAscenseur = Convert.ToInt32(resultCount);

                        mySQLConnectionSiteImpression.Close();
                        mySQLConnectionSiteImpression.Open();

                        strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + strRowSite + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR IN ('28', '29')";
                        commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnectionSiteImpression);
                        resultCount = commandDataReaderAppareil.ExecuteScalar();
                        intEscMecanique = Convert.ToInt32(resultCount);

                        mySQLConnectionSiteImpression.Close();
                        mySQLConnectionSiteImpression.Open();

                        strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + strRowSite + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR IN ('27', '30', '31')";
                        commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnectionSiteImpression);
                        resultCount = commandDataReaderAppareil.ExecuteScalar();
                        intMonteCharge = Convert.ToInt32(resultCount);

                        mySQLConnectionSiteImpression.Close();
                        mySQLConnectionSiteImpression.Open();

                        strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + strRowSite + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR IN ('32', '33')";
                        commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnectionSiteImpression);
                        resultCount = commandDataReaderAppareil.ExecuteScalar();
                        intAscHandicape = Convert.ToInt32(resultCount);

                        mySQLConnectionSiteImpression.Close();
                        mySQLConnectionSiteImpression.Open();

                        // ======================
                        // Site Enfant
                        strSqlRequete = RequetesSQL.sqlCmdEnfant.Replace("strRowSite", strRowSite);
                        SqlCommand commandDataReaderEnfant = new SqlCommand(strSqlRequete, mySQLConnectionSiteImpression);
                        SqlDataReader ValueReaderEnfant = commandDataReaderEnfant.ExecuteReader();

                        while (ValueReaderEnfant.Read())
                        {
                            strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + ValueReaderEnfant["GI3_C_ROWD_SITE"].ToString() + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR = '26'";
                            commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnectionAutre);
                            resultCount = commandDataReaderAppareil.ExecuteScalar();
                            intAscenseur = intAscenseur + Convert.ToInt32(resultCount);

                            mySQLConnectionAutre.Close();
                            mySQLConnectionAutre.Open();

                            strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + ValueReaderEnfant["GI3_C_ROWD_SITE"].ToString() + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR IN ('28', '29')";
                            commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnectionAutre);
                            resultCount = commandDataReaderAppareil.ExecuteScalar();
                            intEscMecanique = intEscMecanique + Convert.ToInt32(resultCount);

                            mySQLConnectionAutre.Close();
                            mySQLConnectionAutre.Open();

                            strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + ValueReaderEnfant["GI3_C_ROWD_SITE"].ToString() + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR IN ('27', '30', '31')";
                            commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnectionAutre);
                            resultCount = commandDataReaderAppareil.ExecuteScalar();
                            intMonteCharge = intMonteCharge + Convert.ToInt32(resultCount);

                            mySQLConnectionAutre.Close();
                            mySQLConnectionAutre.Open();

                            strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + ValueReaderEnfant["GI3_C_ROWD_SITE"].ToString() + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR IN ('32', '33')";
                            commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnectionAutre);
                            resultCount = commandDataReaderAppareil.ExecuteScalar();
                            intAscHandicape = intAscHandicape + Convert.ToInt32(resultCount);

                            mySQLConnectionAutre.Close();
                            mySQLConnectionAutre.Open();

                            if ((intAscenseur + intEscMecanique + intMonteCharge + intAscHandicape) > 0)
                            {
                                blnAppLevage = true;
                            }
                            else
                            {
                                blnAppLevage = false;
                            }
                        }

                        ValueReaderEnfant.Close();
                        mySQLConnectionSiteImpression.Close();
                        mySQLConnectionSiteImpression.Open();

                        // ======================
                        // Section Site
                        strSqlRequete = RequetesSQL.sqlCmdSite.Replace("strRowSite", strRowSite);
                        SqlCommand commandDataReaderSite = new SqlCommand(strSqlRequete, mySQLConnectionSiteImpression);
                        SqlDataReader ValueReaderSite = commandDataReaderSite.ExecuteReader();

                        if (ValueReaderSite.HasRows)
                        {
                            while (ValueReaderSite.Read())
                            {
                                switch (ValueReaderSite["GI3_NM_ATTR"].ToString())
                                {
                                    case "Année de construction":
                                        // Validation : TryParse évite crash si valeur non-numérique
                                        if (!double.TryParse(ValueReaderSite["GI3_V_NUMR_ATTR"].ToString(), out double tempAnnee))
                                            sngAnneeeConst = 0;
                                        else
                                            sngAnneeeConst = (int)tempAnnee;
                                        break;

                                    case "Nb étages":
                                        // Validation : TryParse évite crash si valeur non-numérique
                                        if (!double.TryParse(ValueReaderSite["GI3_V_NUMR_ATTR"].ToString(), out double tempEtage))
                                            dblEtage = 0;
                                        else
                                            dblEtage = tempEtage;
                                        break;

                                    case "Capacité":
                                        // Validation : TryParse évite crash si valeur non-numérique
                                        if (!double.TryParse(ValueReaderSite["GI3_V_NUMR_ATTR"].ToString(), out double tempCapacite))
                                        {
                                            dblCapacite = 0;
                                            dblMaximum_Capacite = 0;
                                        }
                                        else
                                        {
                                            dblCapacite = tempCapacite;
                                            dblMaximum_Capacite = tempCapacite;
                                        }
                                        break;

                                    case "Code de qualification":
                                        strCodeQualif = ValueReaderSite["GI3_V_TEXT_ATTR"].ToString().Replace("'", "’");
                                        break;

                                    case "Code de qualification principal":
                                        strCodeQualif = ValueReaderSite["GI3_V_TEXT_ATTR"].ToString().Replace("'", "’");
                                        break;

                                    case "Aire (m2)":
                                        // Validation : TryParse évite crash si valeur non-numérique
                                        if (!double.TryParse(ValueReaderSite["GI3_V_NUMR_ATTR"].ToString(), out double tempAire))
                                            dblAir = 0;
                                        else
                                            dblAir = tempAire;
                                        break;

                                    case "Genre de construction":
                                        switch (ValueReaderSite["GI3_V_LIST_VALR"].ToString())
                                        {
                                            case "Combustible":
                                                intTypeConstruction = 0;
                                                break;
                                            case "Incombustible":
                                                intTypeConstruction = -1;
                                                break;
                                            default:
                                                intTypeConstruction = 3;
                                                break;
                                        }
                                        break;

                                    case "Unité de capacité":
                                        strType_Capacite = ValueReaderSite["GI3_V_LIST_VALR"].ToString().Replace("'", "’");
                                        break;

                                    case "Extincteur automatique à eau":
                                        if (ValueReaderSite["GI3_V_LIST_VALR"].ToString() == "Partiel" || ValueReaderSite["GI3_V_LIST_VALR"].ToString() == "Total")
                                        {
                                            intGicleur = 1;
                                        }
                                        else
                                        {
                                            intGicleur = 0;
                                        }
                                        break;
                                }
                            }
                        }
                        else
                        {
                            sngAnneeeConst = 0;
                            dblEtage = 0;
                            dblCapacite = 0;
                            strCodeQualif = "";
                            dblAir = 0;
                            intTypeConstruction = 3;
                            strType_Capacite = "";
                            dblMaximum_Capacite = 0;
                            intGicleur = 0;
                        }

                        ValueReaderSite.Close();
                        mySQLConnectionSiteImpression.Close();
                        mySQLConnectionSiteImpression.Open();

                        // ======================
                        // Section Contact
                        strSqlRequete = RequetesSQL.sqlCmdContact.Replace("strRowSite", strRowSite);
                        SqlCommand commandDataReaderContact = new SqlCommand(strSqlRequete, mySQLConnectionSiteImpression);
                        SqlDataReader ValueReaderContact = commandDataReaderContact.ExecuteReader();

                        while (ValueReaderContact.Read())
                        {
                            switch (ValueReaderContact["GI3_C_TYPE_CONT"].ToString())
                            {
                                case "Concierge":
                                    strConcierge = ValueReaderContact["GI3_NM_PREN_CONT"].ToString() + " " + ValueReaderContact["GI3_NM_CONT"].ToString();

                                    if (ValueReaderContact["GI3_N_TELP_PORT"].ToString() == "")
                                    {
                                        strNoTelConcierge = ValueReaderContact["GI3_N_TELP_CONT"].ToString();
                                    }
                                    else
                                    {
                                        strNoCellConcierge = ValueReaderContact["GI3_N_TELP_PORT"].ToString();
                                    }

                                    strCourrielConcierge = ValueReaderContact["GI3_A_COUR_CONT"].ToString();
                                    break;

                                case "Contact":

                                    strContactProprio = ValueReaderContact["GI3_NM_PREN_CONT"].ToString() + " " + ValueReaderContact["GI3_NM_CONT"].ToString();

                                    if (ValueReaderContact["GI3_N_TELP_PORT"].ToString() == "")
                                    {
                                        strNoTelInterloc = ValueReaderContact["GI3_N_TELP_CONT"].ToString();
                                    }
                                    else
                                    {
                                        strNoTelInterloc = ValueReaderContact["GI3_N_TELP_PORT"].ToString();
                                    }

                                    strCourrielInterloc = ValueReaderContact["GI3_A_COUR_CONT"].ToString();
                                    break;
                            }
                        }
                        ValueReaderContact.Close();
                        mySQLConnectionSiteImpression.Close();
                        mySQLConnectionSiteImpression.Open();

                        // ======================
                        // Section Insert into tbl_Fiche_Inspecteur
                        strSqlRequete = RequetesSQL.sqlCmdFicheInspecteur.ToString().Replace("strNomProprio", strNomProprio.Replace("'", "''"));
                        strSqlRequete = strSqlRequete.ToString().Replace("strAutreProprio", strAutreProprio);
                        strSqlRequete = strSqlRequete.ToString().Replace("strNoIntervenant", strNoIntervenant);
                        strSqlRequete = strSqlRequete.ToString().Replace("strAdrIntervenant", strAdrIntervenant.Replace("'", "''"));
                        strSqlRequete = strSqlRequete.ToString().Replace("strContactProprio", strContactProprio.Replace("'", "''"));
                        strSqlRequete = strSqlRequete.ToString().Replace("strCourrielInterloc", strCourrielInterloc);
                        strSqlRequete = strSqlRequete.ToString().Replace("strNoTelInterloc", strNoTelInterloc);
                        strSqlRequete = strSqlRequete.ToString().Replace("strNoTelInterloc", strNoTelInterloc);
                        strSqlRequete = strSqlRequete.ToString().Replace("strCodeQualif", strCodeQualif);
                        strSqlRequete = strSqlRequete.ToString().Replace("strNoSite", strNoSite);
                        strSqlRequete = strSqlRequete.ToString().Replace("strNomSite", strNomSite.Replace("'", "''"));
                        strSqlRequete = strSqlRequete.ToString().Replace("strAdresseSite", strAdresseSite.Replace("'", "''"));
                        strSqlRequete = strSqlRequete.ToString().Replace("strNomMun", strNomMun.Replace("'", "''"));
                        strSqlRequete = strSqlRequete.ToString().Replace("strConcierge", strConcierge.Replace("'", "''"));
                        strSqlRequete = strSqlRequete.ToString().Replace("strNoTelConcierge", strNoTelConcierge);
                        strSqlRequete = strSqlRequete.ToString().Replace("strNoCellConcierge", strNoCellConcierge);
                        strSqlRequete = strSqlRequete.ToString().Replace("strNoteInspecteur", strNoteInspecteur.Replace("'", "''"));
                        strSqlRequete = strSqlRequete.ToString().Replace("sngAnneeeConst", sngAnneeeConst.ToString());
                        strSqlRequete = strSqlRequete.ToString().Replace("sngEtage", dblEtage.ToString());
                        strSqlRequete = strSqlRequete.ToString().Replace("sngAir", dblAir.ToString());
                        strSqlRequete = strSqlRequete.ToString().Replace("strType_Capacite", strType_Capacite);
                        strSqlRequete = strSqlRequete.ToString().Replace("sngCapacite", dblCapacite.ToString());
                        strSqlRequete = strSqlRequete.ToString().Replace("strAgrandissement", strAgrandissement);
                        strSqlRequete = strSqlRequete.ToString().Replace("strAjoutEtage", strAjoutEtage);
                        strSqlRequete = strSqlRequete.ToString().Replace("strChgUsage", strChgUsage);
                        strSqlRequete = strSqlRequete.ToString().Replace("intTypeConstruction", intTypeConstruction.ToString());
                        strSqlRequete = strSqlRequete.ToString().Replace("intGicleur", intGicleur.ToString());
                        strSqlRequete = strSqlRequete.ToString().Replace("intAscenseur", intAscenseur.ToString());
                        strSqlRequete = strSqlRequete.ToString().Replace("intEscMecanique", intEscMecanique.ToString());
                        strSqlRequete = strSqlRequete.ToString().Replace("intMonteCharge", intMonteCharge.ToString());
                        strSqlRequete = strSqlRequete.ToString().Replace("intAscHandicape", intAscHandicape.ToString());
                        strSqlRequete = strSqlRequete.ToString().Replace("blnAppLevage", blnAppLevage.ToString());
                        strSqlRequete = strSqlRequete.ToString().Replace("strNoTelInterloc", strNoTelInterloc);
                        strSqlRequete = strSqlRequete.ToString().Replace("strNoteGaz", strNoteGaz);
                        strSqlRequete = strSqlRequete.ToString().Replace("blnComposante", blnComposante.ToString());
                        strSqlRequete = strSqlRequete.ToString().Replace("strNoteGroupeUsage", strNoteGroupeUsage.Replace("'", "''"));

                        ExecuteSQL("sqlCmdFicheInspecteur", strSqlRequete);

                        blCreerSiteImpression = true;
                    }
                    else
                    {
                        ValueReaderSiteAdresse.Close();
                        mySQLConnectionSiteImpression.Close();
                        mySQLConnectionSiteImpression.Open();
                        blCreerSiteImpression = false;
                    }

                    return blCreerSiteImpression;
                }


                //////////////////////////////////////////////////////////////////////
                ///
                //     Création du site
                ///
                /////////////////////////////////////////////////////////////////////
                bool CreerSite(string strNoSite, string strFinale, bool blnAjoutSuivi)
                {
                    object resultCount;
                    Boolean blCreerSite = true;
                    string strSqlRequete = "";

                    string strSiteEnfant = "";
                    string strRowSite = "";
                    string strNomSite = "";
                    string strAdresseSite = "";
                    string strNoteGaz = "";
                    string strNoteAutreProprio = "";
                    string strNoteGroupeUsage = "";
                    string strNoteInspecteur = ""; ;
                    string strAgrandissement = "";
                    string strAjoutEtage = "";
                    string strChgUsage = "";
                    string strNomProprio = "";
                    string strNoIntervenant = "";
                    string strAdrIntervenant = "";
                    string strRoleIntervenant = "Propriétaire";
                    string strNoTel_Intervenant = "";
                    string strNoCell_Intervenant = "";
                    string strCourriel_Intervenant = "";
                    string strNoTelecIntervenant = "";
                    int sngAnneeeConst = 0;
                    int sngEtage = 0;
                    double sngCapacite = 0;
                    string strCodeQualif = "";
                    int sngAir = 0;
                    int intTypeConstruction = 3;
                    string strType_Capacite = "";
                    int intMaximum_Capacite = 0;
                    int intGicleur = 0;
                    string strAutreProprio = "";
                    string strNoTelInterloc = "";
                    string strCourrielInterloc = "";
                    string strRegionAdm = "";
                    string strStatut = "";

                    bool blnPresenceStationnement = false;
                    bool blnAppLevage = false;

                    int intAscenseur = 0;
                    int intEscMecanique = 0;
                    int intMonteCharge = 0;
                    int intAscHandicape = 0;
                    int intNbrPersonnes = 0;
                    int intNbrChambres = 0;
                    int intNbrLogements = 0;

                    long intCount = 0;

                    string strDossiersSuiviNoSite = "";

                    ValideSqlConnection(mySQLConnection);
                    strSqlRequete = RequetesSQL.sqlCmdCheckSiteEnfant.Replace("strNoSite", strNoSite);
                    SqlCommand commandDataReader = new SqlCommand(strSqlRequete, mySQLConnection);
                    SqlDataReader ValueReader = commandDataReader.ExecuteReader();

                    EtapeDebug = "sqlCmdCheckSiteEnfant";

                    while (ValueReader.Read())
                    {
                        // S'il existe un site Parent et que son intervenant est inscrit
                        if (ValueReader["Site_Parent"].ToString() != "" && ValueReader["C_ROWD_INTRVN_Parent"].ToString() != "")
                        {
                            // Inscrire le site à retiré de la liste
                            strSqlRequete = "INSERT INTO tbl_Site_Selection ( NoSite, NomSite, Commentaire ) VALUES('" + strNoSite + "', 'Retiré_Enfant', 'Site enfant retiré lors de importabion')";
                            ExecuteSQL("tbl_Site_Selection", strSqlRequete);

                            strSqlRequete = "INSERT INTO tbl_DossiersSuivi ( No_site, Statut, DateNouveau, BA, EL, PB, GA, JM, RM, NiveauPriorite, DateTerminé ) SELECT tbl_PrioFinale.No_site, 'Retiré_Enfant', Now(), 0, 0, 0, 0, 0, 0, tbl_PrioFinale.FINALE, Now() From tbl_PrioFinale WHERE tbl_PrioFinale.No_site = '" + strNoSite + "'";
                            ExecuteSQL("tbl_DossiersSuivi", strSqlRequete);

                            JournalEvent("AjoutDossiers", "Site enfant retiré: " + strNoSite + ", remplacé par parent: " + ValueReader["Site_Parent"].ToString(), "PPA_OGRE_LOT", "", strNoSite);


                            strDossiersSuiviNoSite = GetSite(ValueReader["GetSite"].ToString());

                            if (strDossiersSuiviNoSite != "")
                            {
                                // Remplacer le Paramètre de site par le parent
                                strSiteEnfant = strNoSite;
                                strNoSite = ValueReader["Site_Parent"].ToString();
                            }
                            else
                            {
                                JournalEvent("AjoutDossiers", "Site Parent déjà traiter: " + ValueReader["Site_Parent"].ToString(), "PPA_OGRE_LOT", "", strNoSite);
                                blCreerSite = false;
                            }
                        }
                    }

                    ValueReader.Close();

                    // Si on doit creer le site on continu les validations
                    if (blCreerSite)
                    {
                        // ======================
                        // Section Site + Adresse
                        EtapeDebug = "sqlCmdSiteAdresse";
                        strSqlRequete = RequetesSQL.sqlCmdSiteAdresse.Replace("strNoSite", strNoSite);
                        SqlCommand commandDataReaderSiteAdresseII = new SqlCommand(strSqlRequete, mySQLConnection);
                        SqlDataReader ValueReaderSiteAdresseII = commandDataReaderSiteAdresseII.ExecuteReader();

                        if (ValueReaderSiteAdresseII.HasRows)
                        {
                            while (ValueReaderSiteAdresseII.Read())
                            {
                                strRowSite = ValueReaderSiteAdresseII["GI3_C_ROWD_SITE"].ToString();
                                strNomSite = ValueReaderSiteAdresseII["GI3_NM_ENDR"].ToString().Replace("'", "’");
                                strAdresseSite = ValueReaderSiteAdresseII["GI3_A_ADRS_LIGN_1"].ToString() + " " + ValueReaderSiteAdresseII["GI3_A_ADRS_LIGN_2"].ToString() + " " + ValueReaderSiteAdresseII["GI3_A_ADRS_LIGN_3"].ToString();
                                strAdresseSite = strAdresseSite.TrimEnd();
                                strAdresseSite = strAdresseSite.Substring(0, Math.Min(250, strAdresseSite.Length));

                                strRegionAdm = ValueReaderSiteAdresseII["GI3_NM_REG_ADMN"].ToString().Replace("'", "’");
                            }

                            ValueReaderSiteAdresseII.Close();

                            // ======================
                            // Section Note
                            EtapeDebug = "sqlCmdNote";
                            strSqlRequete = RequetesSQL.sqlCmdNote.Replace("strRowSite", strRowSite);
                            SqlCommand commandDataReaderNote = new SqlCommand(strSqlRequete, mySQLConnection);
                            SqlDataReader ValueReaderNote = commandDataReaderNote.ExecuteReader();

                            if (ValueReaderNote.HasRows)
                            {
                                while (ValueReaderNote.Read())
                                {
                                    switch (ValueReaderNote["GI3_C_SUJT_NOTE_INTR"].ToString())
                                    {
                                        case "PPA":
                                            switch (ValueReaderNote["GI3_C_SOUS_SUJT_NOTE"].ToString())
                                            {
                                                case "Alimentation en gaz":
                                                    strNoteGaz = ValueReaderNote["GI3_DE_NOTE"].ToString().Replace("'", "’");
                                                    break;

                                                case "Autres proprietaires":
                                                    strNoteAutreProprio = ValueReaderNote["GI3_DE_NOTE"].ToString().Replace("'", "’");
                                                    break;

                                                case "Note Fiche d'inspection":
                                                    strNoteGroupeUsage = ValueReaderNote["GI3_DE_NOTE"].ToString().Replace("'", "’");
                                                    strNoteGroupeUsage = strNoteGroupeUsage.Substring(0, Math.Min(250, strNoteGroupeUsage.Length)); // ← AJOUTE ICI

                                                    break;

                                                case "Note inspecteur":
                                                    strNoteInspecteur = ValueReaderNote["GI3_DE_NOTE"].ToString().Replace("'", "’");
                                                    break;
                                            }
                                            break;

                                        case "TRANSFORMATION":
                                            switch (ValueReaderNote["GI3_C_SOUS_SUJT_NOTE"].ToString())
                                            {
                                                case "Agrandissement":
                                                    strAgrandissement = ValueReaderNote["GI3_DE_NOTE"].ToString().Replace("'", "’");
                                                    break;

                                                case "Ajout etage":
                                                    strAjoutEtage = ValueReaderNote["GI3_DE_NOTE"].ToString().Replace("'", "’");
                                                    break;

                                                case "Changement usage":
                                                    strChgUsage = ValueReaderNote["GI3_DE_NOTE"].ToString().Replace("'", "’");
                                                    break;
                                            }
                                            break;
                                    }

                                }
                            }
                            else
                            {
                                strNoteGaz = "";
                                strNoteAutreProprio = "";
                                strNoteGroupeUsage = "";
                                strNoteInspecteur = ""; ;
                                strAgrandissement = "";
                                strAjoutEtage = "";
                                strChgUsage = "";
                            }

                            ValueReaderNote.Close();

                            if (strNoteGroupeUsage == "")
                            { strNoteGroupeUsage = "USAGE;A1;0;A2;0;A3;0;A4;0;B1;0;B2;0;B3;0;C;0;D;0;E;0;F1;0;F2;0;F3;0;SOUSSOL;000;STATIONNEMENT;000;TRANSFORMATION;0000;CONTRAINTEDACCES;Aucune contrainte"; }

                            string[] strGroupeUsage = strNoteGroupeUsage.ToString().Split(';');

                            // Validation complète : vérifie (1) taille array, (2) valeur non-vide, (3) conversion réussie
                            if (strGroupeUsage.Length > 30 &&
                                !string.IsNullOrEmpty(strGroupeUsage[30]) &&
                                int.TryParse(strGroupeUsage[30].ToString(), out int valeurStationnement) &&
                                valeurStationnement > 0)
                            {
                                blnPresenceStationnement = true;
                            }
                            else
                            {
                                blnPresenceStationnement = false;
                            }

                            // ======================
                            // Section Intervenant
                            EtapeDebug = "sqlCmdIntervenant";
                            strSqlRequete = RequetesSQL.sqlCmdIntervenant.Replace("strRowSite", strRowSite);
                            SqlCommand commandDataReaderIntervenant = new SqlCommand(strSqlRequete, mySQLConnection);
                            SqlDataReader ValueReaderIntervenant = commandDataReaderIntervenant.ExecuteReader();

                            if (ValueReaderIntervenant.HasRows)
                            {
                                while (ValueReaderIntervenant.Read())
                                {
                                    strNomProprio = ValueReaderIntervenant["GI3_NM_INTRVN"].ToString().Replace("'", "’");
                                    strNoIntervenant = ValueReaderIntervenant["GI3_C_INTRVN"].ToString().Replace("'", "’");
                                    strAdrIntervenant = ValueReaderIntervenant["GI3_A_ADRS_LIGN_1"].ToString() + " " + ValueReaderIntervenant["GI3_A_ADRS_LIGN_2"].ToString() + " " + ValueReaderIntervenant["GI3_A_ADRS_LIGN_3"].ToString();
                                    strAdrIntervenant = strAdrIntervenant.TrimEnd();
                                    strRoleIntervenant = "Propriétaire";
                                    strNoTelecIntervenant = ValueReaderIntervenant["GI3_N_TELC"].ToString().Replace("'", "’");
                                    strNoTel_Intervenant = ValueReaderIntervenant["GI3_N_TELP"].ToString().Replace("'", "’");
                                    strNoCell_Intervenant = ValueReaderIntervenant["GI3_N_TELP"].ToString().Replace("'", "’");
                                    strCourriel_Intervenant = ValueReaderIntervenant["GI3_A_COUR"].ToString().Replace("'", "’");

                                }
                            }
                            else
                            {
                                strNomProprio = "";
                                strNoIntervenant = "";
                                strAdrIntervenant = "";
                                strRoleIntervenant = "Propriétaire";
                                strNoTel_Intervenant = "";
                                strNoCell_Intervenant = "";
                                strCourriel_Intervenant = "";
                                strNoTelecIntervenant = "";
                            }

                            ValueReaderIntervenant.Close();
                            mySQLConnection.Close();
                            mySQLConnection.Open();

                            // ======================
                            // Section Appareil
                            EtapeDebug = "Ascenseur";
                            strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + strRowSite + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR = '26'";
                            SqlCommand commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnection);
                            resultCount = commandDataReaderAppareil.ExecuteScalar();
                            intAscenseur = Convert.ToInt32(resultCount);

                            mySQLConnection.Close();
                            mySQLConnection.Open();

                            EtapeDebug = "EscMecanique";
                            strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + strRowSite + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR IN ('28', '29')";
                            commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnection);
                            resultCount = commandDataReaderAppareil.ExecuteScalar();
                            intEscMecanique = Convert.ToInt32(resultCount);

                            mySQLConnection.Close();
                            mySQLConnection.Open();

                            EtapeDebug = "MonteCharge";
                            strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + strRowSite + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR IN ('27', '30', '31')";
                            commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnection);
                            resultCount = commandDataReaderAppareil.ExecuteScalar();
                            intMonteCharge = Convert.ToInt32(resultCount);

                            mySQLConnection.Close();
                            mySQLConnection.Open();

                            EtapeDebug = "AscHandicape";
                            strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + strRowSite + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR IN ('32', '33')";
                            commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnection);
                            resultCount = commandDataReaderAppareil.ExecuteScalar();
                            intAscHandicape = Convert.ToInt32(resultCount);

                            mySQLConnection.Close();
                            mySQLConnection.Open();

                            // ======================
                            // Section Enfant
                            EtapeDebug = "sqlCmdEnfant";
                            strSqlRequete = RequetesSQL.sqlCmdEnfant.Replace("strRowSite", strRowSite);
                            SqlCommand commandDataReaderEnfant = new SqlCommand(strSqlRequete, mySQLConnection);
                            SqlDataReader ValueReaderEnfant = commandDataReaderEnfant.ExecuteReader();

                            while (ValueReaderEnfant.Read())
                            {
                                mySQLConnectionAutre.Close();
                                mySQLConnectionAutre.Open();

                                EtapeDebug = "AscenseurEnfant";
                                strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + ValueReaderEnfant["GI3_C_ROWD_SITE"].ToString() + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR = '26'";
                                commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnectionAutre);
                                resultCount = commandDataReaderAppareil.ExecuteScalar();
                                intAscenseur = intAscenseur + Convert.ToInt32(resultCount);

                                mySQLConnectionAutre.Close();
                                mySQLConnectionAutre.Open();

                                EtapeDebug = "EscMecaniqueEnfant";
                                strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + ValueReaderEnfant["GI3_C_ROWD_SITE"].ToString() + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR IN ('28', '29')";
                                commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnectionAutre);
                                resultCount = commandDataReaderAppareil.ExecuteScalar();
                                intEscMecanique = intEscMecanique + Convert.ToInt32(resultCount);

                                mySQLConnectionAutre.Close();
                                mySQLConnectionAutre.Open();

                                EtapeDebug = "MonteChargeEnfant";
                                strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + ValueReaderEnfant["GI3_C_ROWD_SITE"].ToString() + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR IN ('27', '30', '31')";
                                commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnectionAutre);
                                resultCount = commandDataReaderAppareil.ExecuteScalar();
                                intMonteCharge = intMonteCharge + Convert.ToInt32(resultCount);

                                mySQLConnectionAutre.Close();
                                mySQLConnectionAutre.Open();

                                EtapeDebug = "AscHandicapeEnfant";
                                strSqlRequete = "SELECT Count(1) FROM [SDGIC01].[dbo].GI3_APPAREIL WHERE GI3_C_ROWD_SITE = '" + ValueReaderEnfant["GI3_C_ROWD_SITE"].ToString() + "' AND GI3_S_APPR = 'ACTIF' AND GI3_C_GENR_APPR IN ('32', '33')";
                                commandDataReaderAppareil = new SqlCommand(strSqlRequete, mySQLConnectionAutre);
                                resultCount = commandDataReaderAppareil.ExecuteScalar();
                                intAscHandicape = intAscHandicape + Convert.ToInt32(resultCount);

                            }

                            ValueReaderEnfant.Close();

                            if ((intAscenseur + intEscMecanique + intMonteCharge + intAscHandicape) > 0)
                            {
                                blnAppLevage = true;
                            }
                            else
                            {
                                blnAppLevage = false;
                            }

                            // ======================
                            // Section Site
                            EtapeDebug = "sqlCmdSite";
                            strSqlRequete = RequetesSQL.sqlCmdSite.Replace("strRowSite", strRowSite);
                            SqlCommand commandDataReaderSite = new SqlCommand(strSqlRequete, mySQLConnection);
                            SqlDataReader ValueReaderSite = commandDataReaderSite.ExecuteReader();

                            if (ValueReaderSite.HasRows)
                            {
                                while (ValueReaderSite.Read())
                                {
                                    switch (ValueReaderSite["GI3_NM_ATTR"].ToString())
                                    {
                                        case "Année de construction":

                                            // Validation : TryParse évite crash si valeur non-numérique
                                            if (!double.TryParse(ValueReaderSite["GI3_V_NUMR_ATTR"].ToString(), out double tempAnnee))
                                                sngAnneeeConst = 0;
                                            else
                                                sngAnneeeConst = (int)tempAnnee;
                                            break;

                                        case "Nb étages":

                                            // Validation : TryParse évite crash si valeur non-numérique
                                            if (!double.TryParse(ValueReaderSite["GI3_V_NUMR_ATTR"].ToString(), out double tempEtage))
                                                sngEtage = 0;
                                            else
                                                sngEtage = (int)tempEtage;
                                            break;

                                        case "Capacité":

                                            // Validation : TryParse évite crash si valeur non-numérique
                                            if (!double.TryParse(ValueReaderSite["GI3_V_NUMR_ATTR"].ToString(), out double tempCapacite))
                                            {
                                                sngCapacite = 0;
                                                intMaximum_Capacite = 0;
                                            }
                                            else
                                            {
                                                sngCapacite = tempCapacite;
                                                intMaximum_Capacite = (int)tempCapacite;
                                            }
                                            break;

                                        case "Code de qualification":
                                            strCodeQualif = ValueReaderSite["GI3_V_TEXT_ATTR"].ToString().Replace("'", "’");
                                            break;

                                        case "Code de qualification principal":
                                            strCodeQualif = ValueReaderSite["GI3_V_TEXT_ATTR"].ToString().Replace("'", "’");
                                            break;

                                        case "Aire (m2)":

                                            // Validation : TryParse évite crash si valeur non-numérique
                                            if (!double.TryParse(ValueReaderSite["GI3_V_NUMR_ATTR"].ToString(), out double tempAire))
                                                sngAir = 0;
                                            else
                                                sngAir = (int)tempAire;
                                            break;

                                        case "Genre de construction":
                                            switch (ValueReaderSite["GI3_V_LIST_VALR"].ToString())
                                            {
                                                case "Combustible":
                                                    intTypeConstruction = 1;
                                                    break;
                                                case "Incombustible":
                                                    intTypeConstruction = 2;
                                                    break;
                                                default:
                                                    intTypeConstruction = 3;
                                                    break;
                                            }
                                            break;

                                        case "Unité de capacité":
                                            strType_Capacite = ValueReaderSite["GI3_V_LIST_VALR"].ToString().Replace("'", "’");
                                            break;

                                        case "Extincteur automatique à eau":
                                            if (ValueReaderSite["GI3_V_LIST_VALR"].ToString() == "Partiel" || ValueReaderSite["GI3_V_LIST_VALR"].ToString() == "Total")
                                            {
                                                intGicleur = 1;
                                            }
                                            else
                                            {
                                                intGicleur = 0;
                                            }
                                            break;
                                    }
                                }
                            }
                            else
                            {
                                sngAnneeeConst = 0;
                                sngEtage = 0;
                                sngCapacite = 0;
                                strCodeQualif = "";
                                sngAir = 0;
                                intTypeConstruction = 3;
                                strType_Capacite = "";
                                intMaximum_Capacite = 0;
                                intGicleur = 0;
                            }

                            ValueReaderSite.Close();

                            // ======================
                            // Section Contact
                            EtapeDebug = "sqlCmdContactII";
                            strSqlRequete = RequetesSQL.sqlCmdContactII.Replace("strRowSite", strRowSite);
                            SqlCommand commandDataReaderContact = new SqlCommand(strSqlRequete.ToString(), mySQLConnection);
                            SqlDataReader ValueReaderContact = commandDataReaderContact.ExecuteReader();

                            while (ValueReaderContact.Read())
                            {
                                switch (ValueReaderContact["GI3_C_TYPE_CONT"].ToString())
                                {
                                    case "Concierge":
                                    case "Contact":

                                        strAutreProprio = ValueReaderContact["GI3_NM_PREN_CONT"].ToString() + " " + ValueReaderContact["GI3_NM_CONT"].ToString();

                                        if (ValueReaderContact["GI3_N_TELP_PORT"].ToString() == "")
                                        {
                                            strNoTelInterloc = ValueReaderContact["GI3_N_TELP_CONT"].ToString();
                                        }
                                        else
                                        {
                                            strNoTelInterloc = ValueReaderContact["GI3_N_TELP_PORT"].ToString();
                                        }

                                        strCourrielInterloc = ValueReaderContact["GI3_A_COUR_CONT"].ToString();
                                        break;
                                }
                            }
                            ValueReaderContact.Close();

                            EtapeDebug = "sqlCmdClePrimaire";

                            // Valide l'intégrité de la clé primaire
                            strSqlRequete = "select count(1) from tbl_Site_Selection where NoSite = '" + strNoSite + "'";
                            using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                            {
                                conn.Open();
                                OleDbCommand commandDataReaderCount = new OleDbCommand(strSqlRequete, conn);
                                resultCount = commandDataReaderCount.ExecuteScalar();
                                intCount = Convert.ToInt32(resultCount);
                                conn.Close();
                            }

                            if (intCount == 0)
                            {
                                // ======================
                                // Section Insert into Site Selection
                                strSqlRequete = RequetesSQL.sqlCmdSiteSelection.Replace("strNoSite", strNoSite);
                                strSqlRequete = strSqlRequete.Replace("strNomSite", strNomSite.Replace("'", "''"));
                                strSqlRequete = strSqlRequete.Replace("strCodeQualif", strCodeQualif);
                                strSqlRequete = strSqlRequete.Replace("sngEtage", sngEtage.ToString());
                                strSqlRequete = strSqlRequete.Replace("sngAnneeeConst", sngAnneeeConst.ToString());
                                strSqlRequete = strSqlRequete.Replace("intGicleur", intGicleur.ToString());
                                strSqlRequete = strSqlRequete.Replace("sngAir", sngAir.ToString());
                                strSqlRequete = strSqlRequete.Replace("intNbrPersonnes", intNbrPersonnes.ToString());
                                strSqlRequete = strSqlRequete.Replace("intNbrChambres", intNbrChambres.ToString());
                                strSqlRequete = strSqlRequete.Replace("intNbrLogements", intNbrLogements.ToString());
                                strSqlRequete = strSqlRequete.Replace("intTypeConstruction", intTypeConstruction.ToString());
                                strSqlRequete = strSqlRequete.Replace("strAdresseSite", strAdresseSite.Replace("'", "''"));
                                strSqlRequete = strSqlRequete.Replace("strRegionAdm", strRegionAdm.Replace("'", "''"));
                                strSqlRequete = strSqlRequete.Replace("strNoteGaz", strNoteGaz.Replace("'", "''"));
                                strSqlRequete = strSqlRequete.Replace("strNoteAutreProprio", strNoteAutreProprio.Replace("'", "''"));
                                strSqlRequete = strSqlRequete.Replace("strNoteInspecteur", strNoteInspecteur.Replace("'", "''"));
                                strSqlRequete = strSqlRequete.Replace("strNoteGroupeUsage", strNoteGroupeUsage);
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage02", strGroupeUsage[2]);
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage04", strGroupeUsage[4]);
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage06", strGroupeUsage[6]);
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage08", strGroupeUsage[8]);
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage10", strGroupeUsage[10]);
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage12", strGroupeUsage[12]);
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage14", strGroupeUsage[14]);
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage16", strGroupeUsage[16]);
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage18", strGroupeUsage[18]);
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage20", strGroupeUsage[20].ToString());
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage22", strGroupeUsage[22].ToString());
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage24", strGroupeUsage[24].ToString());
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage26", strGroupeUsage[26].ToString());
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage28", strGroupeUsage[28].ToString());
                                strSqlRequete = strSqlRequete.Replace("blnPresenceStationnement", blnPresenceStationnement.ToString());
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage30", strGroupeUsage[30]);
                                strSqlRequete = strSqlRequete.Replace("strChgUsage", strChgUsage);
                                strSqlRequete = strSqlRequete.Replace("strAgrandissement", strAgrandissement);
                                strSqlRequete = strSqlRequete.Replace("strAjoutEtage", strAjoutEtage);
                                strSqlRequete = strSqlRequete.Replace("strGroupeUsage34", strGroupeUsage[34]);
                                strSqlRequete = strSqlRequete.Replace("strNoTelInterloc", strNoTelInterloc);
                                strSqlRequete = strSqlRequete.Replace("strNoTelInterloc", strNoTelInterloc);
                                strSqlRequete = strSqlRequete.Replace("strCourrielInterloc", strCourrielInterloc);
                                strSqlRequete = strSqlRequete.Replace("strRoleIntervenant", strRoleIntervenant);
                                strSqlRequete = strSqlRequete.Replace("strNomProprio", strNomProprio.Replace("'", "''"));
                                strSqlRequete = strSqlRequete.Replace("strCourriel_Intervenant", strCourriel_Intervenant);
                                strSqlRequete = strSqlRequete.Replace("strNoTel_Intervenant", strNoTel_Intervenant);
                                strSqlRequete = strSqlRequete.Replace("strNoCell_Intervenant", strNoCell_Intervenant);
                                strSqlRequete = strSqlRequete.Replace("strNoTelecIntervenant", strNoTelecIntervenant);
                                strSqlRequete = strSqlRequete.Replace("strNoIntervenant", strNoIntervenant);
                                strSqlRequete = strSqlRequete.Replace("strAdrIntervenant", strAdrIntervenant.Replace("'", "''"));
                                strSqlRequete = strSqlRequete.Replace("strAutreProprio", strAutreProprio);
                                strSqlRequete = strSqlRequete.Replace("strType_Capacite", strType_Capacite);
                                strSqlRequete = strSqlRequete.Replace("intMaximum_Capacite", intMaximum_Capacite.ToString());
                                strSqlRequete = strSqlRequete.Replace("intAscenseur", intAscenseur.ToString());
                                strSqlRequete = strSqlRequete.Replace("intEscMecanique", intEscMecanique.ToString());
                                strSqlRequete = strSqlRequete.Replace("intMonteCharge", intMonteCharge.ToString());
                                strSqlRequete = strSqlRequete.Replace("intAscHandicape", intAscHandicape.ToString());
                                strSqlRequete = strSqlRequete.Replace("blnAppLevage", blnAppLevage.ToString());
                                strSqlRequete = strSqlRequete.Replace("strSiteEnfant", strSiteEnfant);

                                strSqlRequete = strSqlRequete.Replace(", ''", ", null");

                                ExecuteSQL("sqlCmdSiteSelection", strSqlRequete);
                            }

                            if (blnAjoutSuivi && intCount == 0)
                            {
                                EtapeDebug = "sqlCmdAjoutDossierSuivi";
                                ValideSqlConnection(mySQLConnection);
                                strSqlRequete = RequetesSQL.sqlCmdAjoutDossierSuivi.Replace("%2", strFinale.Replace("'", "''")).Replace("%1", strNoSite);
                                SqlCommand commandDataReaderDossierSuivi = new SqlCommand(strSqlRequete.ToString(), mySQLConnection);
                                commandDataReaderDossierSuivi.CommandTimeout = 12000;
                                SqlDataReader ValueReaderDossierSuivi = commandDataReaderDossierSuivi.ExecuteReader();

                                while (ValueReaderDossierSuivi.Read())
                                {
                                    strSqlRequete = "INSERT INTO tbl_DossiersSuivi ( No_site, Statut, DateNouveau, BA, EL, PB, GA, JM, RM, NiveauPriorite, [AS], TypeSignalement) " +
                                        "Values('strNo_site', 'strStatut', 'dtDateNouveau', 0, 0, 0, 0, 0, 0, 'dblNiveauPriorite', 0, '7')";

                                    strSqlRequete = strSqlRequete.ToString().Replace("strNo_site", strNoSite.ToString());
                                    strSqlRequete = strSqlRequete.ToString().Replace("strStatut", ValueReaderDossierSuivi["Statut"].ToString());
                                    strSqlRequete = strSqlRequete.ToString().Replace("dtDateNouveau", ValueReaderDossierSuivi["DateNouveau"].ToString());
                                    strSqlRequete = strSqlRequete.ToString().Replace("dblNiveauPriorite", ValueReaderDossierSuivi["Finale"].ToString());

                                    ExecuteSQL("sqlCmdAjoutDossierSuivi", strSqlRequete);
                                }
                                ValueReaderDossierSuivi.Close();

                                EtapeDebug = "sqlCmdAjoutDossierSuiviII";
                                strSqlRequete = "INSERT INTO tbl_SuiviSite ( No_site, Statut, Date_Statut ) VALUES('" + strNoSite + "', 'Rechercher doublon', Now())";
                                ExecuteSQL("tbl_SuiviSite", strSqlRequete);

                                // Récupère le nombre code de qualification
                                EtapeDebug = "Statut";
                                strSqlRequete = "select Statut from tbl_DossiersSuivi where No_site = '" + strNoSite + "'";

                                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                                {
                                    conn.Open();

                                    OleDbCommand commandDataReaderStatut = new OleDbCommand(strSqlRequete, conn);
                                    OleDbDataReader ValueReaderStatut = commandDataReaderStatut.ExecuteReader();

                                    while (ValueReaderStatut.Read())
                                    {
                                        strStatut = ValueReaderStatut["Statut"].ToString();
                                    }

                                    if (strStatut == "Prise en charge")
                                    {
                                        strSqlRequete = "UPDATE tbl_SuiviSite SET tbl_SuiviSite.Doublon_NonRequis = True WHERE tbl_SuiviSite.No_site='" + strNoSite + "'";
                                        ExecuteSQL("tbl_SuiviSite", strSqlRequete);

                                        // Ajouter le changement de statut dans l'historique
                                        strSqlRequete = "INSERT INTO tbl_HistoriqueStatut ( NoSite, Statut, DateMajStatut, Commentaire ) VALUES ('" + strNoSite + "', 'Prise en charge', Now(), 'Création du site')";
                                        ExecuteSQL("tbl_HistoriqueStatut", strSqlRequete);
                                    }
                                    else
                                    {
                                        // Ajouter le changement de statut dans l'historique
                                        strSqlRequete = "INSERT INTO tbl_HistoriqueStatut ( NoSite, Statut, DateMajStatut, Commentaire ) VALUES ('" + strNoSite + "', 'Rechercher doublon', Now(), 'Création du site')";
                                        ExecuteSQL("tbl_HistoriqueStatut", strSqlRequete);
                                    }
                                    conn.Close();
                                }
                            }

                            EtapeDebug = "AjoutDossiers";
                            if (intCount == 0)
                            {
                                JournalEvent("AjoutDossiers", "Site ajouté", "PPA_OGRE_LOT", "", strNoSite);
                                blCreerSite = true;
                            }
                            else
                            {
                                JournalEvent("AjoutDossiers", "Site n''est pas ajouté violation de la clé primaire tbl_Site_Selection(" + strNoSite + ")", "PPA_OGRE_LOT", "", strNoSite);
                                blCreerSite = false;
                            }
                        }
                        else
                        {
                            ValueReaderSiteAdresseII.Close();
                            JournalEvent("AjoutDossiers", "Site non ajouté", "PPA_OGRE_LOT", "Site inconnu dans GIC , " + strNoSite, "");
                            blCreerSite = false;
                        }
                    }

                    EtapeDebug = "blCreerSite";
                    return blCreerSite;
                }

                //////////////////////////////////////////////////////////////////////
                ///
                //     Recherche le code de qualification du site
                ///
                /////////////////////////////////////////////////////////////////////
                string Get_SiteCodeQualif(string pNoSite)
                {
                    string sqlCmdSite = "SELECT dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, " +
                                        "dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_D_FIN, " +
                                        "dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR, " +
                                        "dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_V_TEXT_ATTR AS CodeQualif " +
                                  "FROM ([SDGIC01].[dbo].GI3_ATTRIBUTS_SITE_COMP_VALEURS as dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS INNER JOIN [SDGIC01].[dbo].GI3_ATTRIBUTS_SITE_COMPOSANTE as dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE ON dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_C_ROWD_ATTR_SITE_COMP = dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_ATTR_SITE_COMP) " +
                                        "INNER JOIN [SDGIC01].[dbo].GI3_SITE_COMPOSANTE as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE " +
                                  "WHERE (((dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE) = '" + pNoSite + "') " +
                                  "AND    ((dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_D_FIN)Is Null) " +
                                  "AND    ((dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR) = 'Code de qualification' " +
                                  "Or      (dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR) = 'Code de qualification principal')) ";

                    string strCodeQualif = "";
                    EtapeDebug = "Get_SiteCodeQualif";

                    SqlConnection mySQLConnectionSiteCodeQualif =
                    Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                    as SqlConnection;

                    // Récupère le Site
                    SqlCommand commandDataReaderSiteCodeQualif = new SqlCommand(sqlCmdSite, mySQLConnectionSiteCodeQualif);
                    SqlDataReader ValueReaderSiteCodeQualif = commandDataReaderSiteCodeQualif.ExecuteReader();

                    while (ValueReaderSiteCodeQualif.Read())
                    {
                        strCodeQualif = ValueReaderSiteCodeQualif["CodeQualif"].ToString();
                    }

                    ValueReaderSiteCodeQualif.Close();
                    mySQLConnectionSiteCodeQualif.Close();

                    return strCodeQualif;
                }

                //////////////////////////////////////////////////////////////////////
                ///
                //     Recherche le site
                ///
                /////////////////////////////////////////////////////////////////////
                string GetSite(string pNoSite)
                {
                    string sqlCmdSite = "SELECT distinct No_site From tbl_DossiersSuivi WHERE No_site = '" + pNoSite + "'";
                    string strNoSite = "";
                    EtapeDebug = "GetSite";

                    // Récupère le Site
                    using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                    {
                        conn.Open();
                        OleDbCommand commandDataReaderSite = new OleDbCommand(sqlCmdSite, conn);
                        OleDbDataReader ValueReaderSite = commandDataReaderSite.ExecuteReader();

                        while (ValueReaderSite.Read())
                        {
                            strNoSite = ValueReaderSite["No_Site"].ToString();
                        }

                        ValueReaderSite.Close();
                        conn.Close();
                    }

                    return strNoSite;
                }

                //////////////////////////////////////////////////////////////////////
                ///
                //     Valide Algo
                ///
                /////////////////////////////////////////////////////////////////////
                bool ValidAlgo(string strNoSite, string strDomaine, string strCodeQualif)
                {

                    string sngCapacite = "";
                    string sngAire = "";
                    int intNbEtage = 0;
                    bool blValidAlgo = true;
                    EtapeDebug = "ValidAlgo";
                    string strEtape = "";

                    sngCapacite = Get_SiteCapacite(strNoSite);
                    sngAire = Get_SiteAir(strNoSite);
                    intNbEtage = Get_SiteNbEtage(strNoSite);

                    try
                    {
                        strEtape = "Switch";
                        switch (strCodeQualif)
                        {
                            case "F1":
                            case "F2":
                            case "F3":
                                if (strDomaine == "BA")
                                {
                                    blValidAlgo = false;
                                    JournalEvent("Valide Algo création des interventions", "Rejet par l'algo du domaine " + strDomaine + ". Cause: Code de Qualification = " + strCodeQualif, "PPA_OGRE_LOT", "", strNoSite);
                                }
                                break;

                            case "C10102":
                            case "C10201":
                            case "C10202":
                                if (!string.IsNullOrEmpty(intNbEtage.ToString()) && !string.IsNullOrEmpty(sngCapacite))
                                {
                                    if ((intNbEtage < 3 || int.Parse(sngCapacite) < 9) && (strDomaine == "BA" || strDomaine == "PB" || strDomaine == "AS"))
                                    {
                                        blValidAlgo = false;
                                        JournalEvent("Valide Algo création des interventions", "Rejet par l'algo du domaine " + strDomaine + ".Cause: Code de Qualification = " + strCodeQualif + " et (NbEtage: " + intNbEtage.ToString() + " < 3 ou Capacité: " + sngCapacite + " < 9)", "PPA_OGRE_LOT", "", strNoSite);
                                    }
                                }
                                break;

                            case "A20901":
                                if (!string.IsNullOrEmpty(sngCapacite) && !string.IsNullOrEmpty(sngAire))
                                {
                                    if ((int.Parse(sngCapacite) < 60 || int.Parse(sngAire) < 150) && strDomaine == "BA")
                                    {
                                        blValidAlgo = false;
                                        JournalEvent("Valide Algo création des interventions", "Rejet par l'algo du domaine " + strDomaine + ". Cause: Code de Qualification = " + strCodeQualif + " et (Capacité: " + sngCapacite.ToString() + " < 60 ou Aire: " + sngAire + " < 150)", "PPA_OGRE_LOT", "", strNoSite);
                                    }
                                }
                                break;

                            case "A40501":
                                if (!string.IsNullOrEmpty(sngCapacite) && !string.IsNullOrEmpty(sngAire))
                                {
                                    if ((int.Parse(sngCapacite) < 60 || int.Parse(sngAire) < 100) && strDomaine == "BA")
                                    {
                                        blValidAlgo = false;
                                        JournalEvent("Valide Algo création des interventions", "Rejet par l'algo du domaine " + strDomaine + ". Cause: Code de Qualification = " + strCodeQualif + " et (Capacité: " + sngCapacite.ToString() + " < 60 ou Aire: " + sngAire + " < 100)", "PPA_OGRE_LOT", "", strNoSite);
                                    }
                                }
                                break;

                            case "C10308":
                            case "B10102":
                            case "B30202":
                            case "C10305":
                                if (!string.IsNullOrEmpty(sngCapacite))
                                {
                                    if (int.Parse(sngCapacite) < 10 && strDomaine == "BA")
                                    {
                                        blValidAlgo = false;
                                        JournalEvent("Valide Algo création des interventions", "Rejet par l'algo du domaine " + strDomaine + ". Cause: Code de Qualification = " + strCodeQualif + " et (Capacité: " + sngCapacite.ToString() + " < 10)", "PPA_OGRE_LOT", "", strNoSite);
                                    }
                                }
                                break;

                            case "C10203":
                            case "C10204":
                            case "A20902":
                                if (strDomaine == "BA" || strDomaine == "PB" || strDomaine == "AS")
                                {
                                    blValidAlgo = false;
                                    JournalEvent("Valide Algo création des interventions", "Rejet par l'algo du domaine " + strDomaine + ". Cause: Code de Qualification = " + strCodeQualif, "PPA_OGRE_LOT", "", strNoSite);
                                }
                                break;

                            case "C10103":
                                if (!string.IsNullOrEmpty(intNbEtage.ToString()) && !string.IsNullOrEmpty(sngCapacite))
                                {
                                    if (intNbEtage < 3 || int.Parse(sngCapacite) < 9 && (strDomaine == "PB" || strDomaine == "AS"))
                                    {
                                        blValidAlgo = false;
                                        JournalEvent("Valide Algo création des interventions", "Rejet par l'algo du domaine " + strDomaine + ". Cause: Code de Qualification = " + strCodeQualif + "et (NbEtage: " + intNbEtage.ToString() + " < 3 Ou Capacité: " + sngCapacite + " < 9)", "PPA_OGRE_LOT", "", strNoSite);
                                    }
                                }
                                break;

                            case "C40001":
                            case "C40002":
                                if (strDomaine == "BA" || strDomaine == "PB" || strDomaine == "AS" || strDomaine == "EL")
                                {
                                    blValidAlgo = false;
                                    JournalEvent("Valide Algo création des interventions", "Rejet par l'algo du domaine " + strDomaine + ". Cause: Code de Qualification = " + strCodeQualif, "PPA_OGRE_LOT", "", strNoSite);
                                }
                                break;
                        }

                        strEtape = "sngCapacite";
                        if (!string.IsNullOrEmpty(sngCapacite))
                        {
                            if (strCodeQualif.Substring(0, 1) == "A" && int.Parse(sngCapacite) < 10 && strDomaine == "BA")
                            {
                                blValidAlgo = false;
                                JournalEvent("Valide Algo création des interventions", "Rejet par l'algo du domaine " + strDomaine + ". Cause: Code de Qualification = " + strCodeQualif + "et (Capacité: " + sngCapacite + " < 10)", "PPA_OGRE_LOT", "", strNoSite);
                            }
                        }

                        strEtape = "sngCapacite_sngAire";
                        if (!string.IsNullOrEmpty(sngCapacite) && !string.IsNullOrEmpty(sngAire))
                        {
                            if (strCodeQualif.Substring(0, 1) == "E" && int.Parse(sngAire) < 301 && strDomaine == "BA")
                            {
                                blValidAlgo = false;
                                JournalEvent("Valide Algo création des interventions", "Rejet par l'algo du domaine " + strDomaine + ". Cause: Code de Qualification = " + strCodeQualif + "et (Aire: " + sngAire + " < 301)", "PPA_OGRE_LOT", "", strNoSite);
                            }
                        }

                        strEtape = "intNbEtage";
                        if (!string.IsNullOrEmpty(intNbEtage.ToString()))
                        {
                            if (strCodeQualif.Substring(0, 1) == "D" && intNbEtage < 3 && strDomaine == "BA")
                            {
                                blValidAlgo = false;
                                JournalEvent("Valide Algo création des interventions", "Rejet par l'algo du domaine " + strDomaine + ". Cause: Code de Qualification = " + strCodeQualif + "et (NbEtage: " + intNbEtage.ToString() + " < 3)", "PPA_OGRE_LOT", "", strNoSite);
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("ValidAlgo(" + strEtape + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                    }

                    return blValidAlgo;
                }
                //////////////////////////////////////////////////////////////////////
                ///
                //     Recherche le nombre d'étages
                ///
                /////////////////////////////////////////////////////////////////////
                int Get_SiteNbEtage(string pNoSite)
                {
                    string sqlCmdSite = "SELECT dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, " +
                                               "dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_D_FIN, " +
                                               "dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR, " +
                                               "isnull(dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_V_NUMR_ATTR, '0') AS NbEtage " +
                                         "FROM  ([SDGIC01].[dbo].GI3_ATTRIBUTS_SITE_COMP_VALEURS as dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS " +
                                                 "INNER JOIN[SDGIC01].[dbo].GI3_ATTRIBUTS_SITE_COMPOSANTE as dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE ON dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_C_ROWD_ATTR_SITE_COMP = dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_ATTR_SITE_COMP) " +
                                                 "INNER JOIN[SDGIC01].[dbo].GI3_SITE_COMPOSANTE as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE " +
                                         "WHERE(((dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE) = '" + pNoSite + "') " +
                                         "AND   ((dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_D_FIN)Is Null) " +
                                         "AND   ((dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR) = 'Nb étages'))";

                    string intNbEtage = "";
                    EtapeDebug = "Get_SiteNbEtage";
                    int index = 0;
                    int result = 0;

                    try
                    {
                        SqlConnection mySQLConnectionSite =
                        Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                        as SqlConnection;

                        // Récupère la capacité du site
                        SqlCommand commandDataReader = new SqlCommand(sqlCmdSite, mySQLConnectionSite);
                        SqlDataReader ValueReader = commandDataReader.ExecuteReader();

                        while (ValueReader.Read())
                        {
                            intNbEtage = ValueReader["NbEtage"].ToString();
                        }

                        ValueReader.Close();
                        mySQLConnectionSite.Close();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("Get_SiteNbEtage()", ex.Message.ToString());
                        LoadTableErreur = true;
                    }

                    index = intNbEtage.IndexOf(",");
                    if (index >= 0)
                    {
                        result = int.Parse(intNbEtage.Substring(0, index));
                    }
                    else
                    {
                        result = 0;
                    }

                    return result;
                }


