                //////////////////////////////////////////////////////////////////////
                ///
                //     Mise à jour de la table ORGRE_Fiche_Inspecteur
                ///
                /////////////////////////////////////////////////////////////////////
                void majORGRE_Fiche_Inspecteur()
                {
                    string sqlCmdDelete = "DELETE [SDDMU01].[dbo].[ORGRE_Fiche_Inspecteur]";
                    string sqlCmdSelect = "SELECT tbl_Fiche_Inspecteur.* " +
                                           "FROM tbl_Fiche_Inspecteur ";
                    string sqlCmdCount = "Select count(1) from tbl_Fiche_Inspecteur where Composante = true";
                    int nbRecord = 0;
                    object resultCount;
                    int intCount;

                    string Etape = "";
                    EtapeDebug = "majORGRE_Fiche_Inspecteur";

                    SqlConnection mySQLConnectionMaj =
                    Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                    as SqlConnection;

                    Etape = "Delete ORGRE_Fiche_Inspecteur";
                    try
                    {
                        SqlCommand CmdDel = new SqlCommand(sqlCmdDelete.ToString(), mySQLConnectionMaj);
                        CmdDel.CommandType = CommandType.Text;
                        SqlDataReader readerDel = CmdDel.ExecuteReader();
                        readerDel.Read();
                        readerDel.Close();
                    }
                    catch (Exception ex)
                    {
                        InsertTableLogJobPlanificateur("ORGRE_Fiche_Inspecteur(" + Etape + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                    }

                    Etape = "Select tbl_Fiche_Inspecteur";
                    try
                    {
                        using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                        {
                            conn.Open();

                            // Charger dans DataTable
                            OleDbCommand cmdBulkCopy = new OleDbCommand(sqlCmdSelect, conn);
                            cmdBulkCopy.CommandTimeout = 18000;
                            OleDbDataAdapter adapter = new OleDbDataAdapter(cmdBulkCopy);
                            DataTable dt = new DataTable();
                            adapter.Fill(dt);

                            // BulkCopy avec ColumnMappings explicites
                            Etape = "commandSourceData.ExecuteReader";
                            using (var bulkCopy = new SqlBulkCopy(mySQLConnectionMaj))
                            {
                                bulkCopy.BulkCopyTimeout = 0;
                                bulkCopy.DestinationTableName = "[SDDMU01].[dbo].[ORGRE_Fiche_Inspecteur]";

                                // Mapper chaque colonne par nom
                                foreach (DataColumn col in dt.Columns)
                                {
                                    bulkCopy.ColumnMappings.Add(col.ColumnName, col.ColumnName);
                                }

                                bulkCopy.WriteToServer(dt);
                            }
                            conn.Close();
                        }
                    }
                    catch (Exception ex)
                    {
                        InsertTableLogJobPlanificateur("majORGRE_Fiche_Inspecteur(" + Etape + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                    }

                    // Valide s'il y a des composants
                    ValideSqlConnection(mySQLConnectionMaj);
                    using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                    {
                        conn.Open();
                        OleDbCommand commandDataReaderCountII = new OleDbCommand(sqlCmdCount, conn);
                        resultCount = commandDataReaderCountII.ExecuteScalar();
                        intCount = Convert.ToInt32(resultCount);
                        conn.Close();
                    }

                    if (intCount == 0)
                    {
                        sqlCmdSelect = "Insert into [SDDMU01].[dbo].[ORGRE_Fiche_Inspecteur] (CodeQualif, Maximum_Capacite, Composante, id) values('Z', 0, 1, 1)";
                        SqlCommand CmdIns = new SqlCommand(sqlCmdSelect.ToString(), mySQLConnectionMaj);
                        CmdIns.CommandType = CommandType.Text;
                        SqlDataReader readerIns = CmdIns.ExecuteReader();
                        readerIns.Read();
                        readerIns.Close();
                    }

                    mySQLConnectionMaj.Close();
                }
