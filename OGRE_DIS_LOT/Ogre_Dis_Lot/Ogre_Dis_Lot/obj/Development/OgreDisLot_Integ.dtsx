          <ProjectItem
            Name="RequetesSQL.cs"
            Encoding="UTF8"><![CDATA[using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ST_72623c1e4fa44b22ba9390e5501454fa
{
    public static class RequetesSQL
    {
        public const string updtACSUN_TbStatutGIC = "UPDATE ACSUN_TbStatutGIC_MAJ SET date_StatutGIC_MAJ = Now()";

        public const string updtTOPO_TbStatutGIC = "UPDATE TOPO_TbStatutGIC_MAJ SET date_StatutGIC_MAJ = Now()";

        public const string tblStatutGIC_DroitExerciceTOPO = "SELECT Left([GI3_C_LICN],9) AS NoGIC, [GI3_S_DROT_EXER] FROM [SDGIC01].[dbo].[GI3_DROIT_EXERCICE] inner join [SDDMU01].[SDDMUVPE].[VPE_TOPO_Verification] on DossierGICN =  Left([GI3_C_LICN],9) and STATUT <> 'Termin�'";

        public const string tblStatutGIC_DroitExerciceACSUM = "SELECT Left([GI3_C_LICN],9) AS NoGIC, [GI3_S_DROT_EXER] FROM [SDGIC01].[dbo].[GI3_DROIT_EXERCICE] inner join [SDDMU01].[dbo].[BGP_Plaintes] on DossierGIC =  Left([GI3_C_LICN],9) and STATUT <> 'Termin�'";

        public const string updtACSUN_StatutGIC_DroitExercice = "UPDATE BGP_tbPlaintes " +
                                                                "SET STATUT_GIC = '%2' " +
                                                                "WHERE DossierGIC = '%1' " +
                                                                "AND STATUT<> 'Terminé' ";
        public const string updtTOPO_StatutGIC_DroitExercice = "UPDATE tbVerification " +
                                                                "SET STATUT_GIC = '%2' " +
                                                                "WHERE DossierGICN = '%1' " +
                                                                "AND STATUT <> 'Terminé'";

        public const string delLogJobChargement = "DELETE [SDDMU01].[dbo].[Log_Job_Planificateur] " +
                                                  "WHERE [IndSystem] = 'OgreDisLot'";

        public const string tblAfficheErreur = "SELECT [IndSystem], " +
                                                      "[CodeTraitement], " +
                                                      "[TypeTraitement], " +
                                                      "[ErrorMessage] " +
                                                 "FROM [SDDMU01].[dbo].[Log_Job_Planificateur] " +
                                                 "WHERE [IndSystem] = 'OgreDisLot'";

        public const string sqlCmdDossiersSuivi = "SELECT tbl_Region.Région, [SiteAForcer] * -1 AS NbrDossier " +
                                             "FROM tbl_ForcerSite_Region " +
                                                   "INNER JOIN tbl_Region ON tbl_ForcerSite_Region.NoRegion = tbl_Region.NoRégion " +
                                             "WHERE tbl_ForcerSite_Region.SiteAForcer > 0 ";

        public const string sqlCmdDossiersACreerOGRE = "SELECT sQry_DossiersACreerOGRE.Région, Min(sQry_DossiersACreerOGRE.Nbr) AS NbrDossier " +
                                                  "FROM sQry_DossiersACreerOGRE " +
                                                  "GROUP BY sQry_DossiersACreerOGRE.Région ";

        public const string sqlCmdCount = "select count(1) as NbRecord from tbl_Param_CodeQualif ";

        public const string sqlCmdSitesPriorisesCodeQualif = "SELECT TOP 1 tbl_PrioFinale.No_site, " +
                                                             "tbl_PrioFinale.GI3_NM_REG_ADMN, " +
                                                             "tbl_PrioFinale.Finale, " +
                                                             "tbl_PrioFinale.CodeQualif, " +
                                                             "tbl_PrioFinale.STAT " +
                                                "FROM (tbl_PrioFinale LEFT JOIN tbl_Site_Selection ON tbl_PrioFinale.No_site = tbl_Site_Selection.NoSite) INNER JOIN tbl_Param_CodeQualif ON tbl_PrioFinale.CodeQualif = tbl_Param_CodeQualif.CodeQualif " +
                                                "WHERE tbl_PrioFinale.GI3_NM_REG_ADMN = '%1' " +
                                                "AND   tbl_Site_Selection.NoSite Is Null " +
                                                "AND   tbl_PrioFinale.STAT='Actif' " +
                                                "ORDER BY tbl_PrioFinale.Finale DESC";

        public const string sqlCmdSitesPriorisesSansCodeQualif = "SELECT TOP 1 tbl_PrioFinale.No_site, " +
                                                              "tbl_PrioFinale.GI3_NM_REG_ADMN, " +
                                                              "tbl_PrioFinale.Finale, " +
                                                              "tbl_PrioFinale.STAT " +
                                                         "FROM tbl_PrioFinale LEFT JOIN tbl_Site_Selection ON tbl_PrioFinale.No_site = tbl_Site_Selection.NoSite " +
                                                        "WHERE tbl_PrioFinale.GI3_NM_REG_ADMN = '%1' " +
                                                          "AND tbl_Site_Selection.NoSite Is Null " +
                                                          "AND tbl_PrioFinale.STAT = 'Actif' " +
                                                     "ORDER BY tbl_PrioFinale.Finale DESC";

        public const string sqlCmdTypeAppareil = "SELECT Site_TypeAppareil.GI3_N_SITE AS SiteParent, " +
                                                    "dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS SiteEnfant, " +
                                                    "dbo_GI3_APPAREIL.GI3_N_APPR_LIEU_APL AS No_Id_SurLieu, " +
                                                    "dbo_GI3_APPAREIL.GI3_C_TYPE_MACH_AS AS TypeMachine, " +
                                                    "dbo_GI3_APPAREIL.GI3_Q_PALR_AS AS Nbre_Pallier, " +
                                                    "isnull(dbo_GI3_APPAREIL.GI3_C_FABR_APPR, dbo_GI3_APPAREIL.GI3_NM_ANCN_FABR_APPR) AS NomFabricant, " +
                                                    "dbo_GI3_APPAREIL.GI3_D_INST AS DateMiseEnService, " +
                                                    "dbo_GI3_SITE_COMPOSANTE.GI3_NM_ENDR " +
                                            "FROM (SELECT dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, " +
                                                            "IIf(dbo_GI3_SITE_COMPOSANTE_1.GI3_C_ROWD_SITE is null, dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE, dbo_GI3_SITE_COMPOSANTE_1.GI3_C_ROWD_SITE) AS RowSite,  " +
                                                            "dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE, " +
                                                            "dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN, " +
                                                            "dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS SiteParent, " +
                                                            "dbo_GI3_SITE_COMPOSANTE_1.GI3_N_SITE AS SiteEnfant " +
                                                    "FROM (([SDGIC01].[dbo].GI3_SITE_COMPOSANTE as dbo_GI3_SITE_COMPOSANTE " +
                                                           "LEFT JOIN [SDGIC01].[dbo].GI3_SITE_COMPOSANTE AS dbo_GI3_SITE_COMPOSANTE_1 ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE_1.GI3_C_ROWD_SITE_PRIN)  " +
                                                           "LEFT JOIN [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT as dbo_GI3_LIEN_SITE_INTERVENANT ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_SITE) " +
                                                           "LEFT JOIN [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT AS dbo_GI3_LIEN_SITE_INTERVENANT_1 ON dbo_GI3_SITE_COMPOSANTE_1.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_C_ROWD_SITE " +
                                                    "WHERE (((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN) = dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN " +
                                                         "Or (dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN) Is Null) " +
                                                      "AND ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROLE) = 'Proprietaire') " +
                                                      "AND ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Actif' Or (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Non exploite') " +
                                                      "AND ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_D_FIN)Is Null) AND ((dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_C_ROLE) = 'Proprietaire' " +
                                                        "Or (dbo_GI3_LIEN_SITE_INTERVENANT_1.GI3_C_ROLE) Is Null) " +
                                                      "AND ((dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) = 'Actif' " +
                                                        "Or (dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) = 'Fusion' " +
                                                        "Or (dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) = 'Non exploite' " +
                                                        "Or (dbo_GI3_SITE_COMPOSANTE_1.GI3_DE_STAT_SITE_COMP) Is Null) " +
                                                      "AND ((dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE) = '%1'))  " +
                                                    "UNION " +
                                                    "SELECT dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE,  " +
                                                           "dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE AS RowSite,  " +
                                                           "dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE,  " +
                                                           "dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_INTRVN,  " +
                                                           "dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS SiteParent,  " +
                                                           "null AS SiteEnfant " +
                                                    "FROM [SDGIC01].[dbo].GI3_SITE_COMPOSANTE as dbo_GI3_SITE_COMPOSANTE " +
                                                        "INNER JOIN [SDGIC01].[dbo].GI3_LIEN_SITE_INTERVENANT as dbo_GI3_LIEN_SITE_INTERVENANT ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROWD_SITE " +
                                                    "WHERE (((dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE) = '%1') " +
                                                    "AND  ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_C_ROLE) = 'Proprietaire') " +
                                                    "AND  ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Actif' " +
                                                       "Or  (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Non exploite') " +
                                                    "AND ((dbo_GI3_LIEN_SITE_INTERVENANT.GI3_D_FIN)Is Null))) Site_TypeAppareil " +
                                            "INNER JOIN ([SDGIC01].[dbo].GI3_APPAREIL as dbo_GI3_APPAREIL " +
                                            "INNER JOIN  [SDGIC01].[dbo].GI3_SITE_COMPOSANTE as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_APPAREIL.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE)  " +
                                                "ON Site_TypeAppareil.[RowSite] = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE " +
                                            "WHERE (((dbo_GI3_APPAREIL.GI3_C_TYPE_APPR) = 'AL') AND ((dbo_GI3_APPAREIL.GI3_S_APPR) = 'ACTIF') " +
                                            "AND    ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Actif' Or (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Non exploite')) " +
                                            "ORDER BY Site_TypeAppareil.GI3_N_SITE, dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, dbo_GI3_APPAREIL.GI3_N_APPR_LIEU_APL";

        public const string sqlCmdJM = "SELECT dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS NoSite,  " +
                                   "dbo_GI3_APPAREIL.GI3_N_IMMAT_APL AS No_Immatriculation,  " +
                                   "dbo_GI3_APPAREIL.GI3_NM_FABR_CONTR AS NomFabricant,  " +
                                   "dbo_GI3_APPAREIL.GI3_D_INST AS DateMiseEnService,  " +
                                   "dbo_GI3_APPAREIL.GI3_N_APPR_LIEU_APL " +
                            "FROM [SDGIC01].[dbo].GI3_APPAREIL as dbo_GI3_APPAREIL " +
                                  "INNER JOIN [SDGIC01].[dbo].GI3_SITE_COMPOSANTE as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_APPAREIL.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE " +
                            "WHERE (((dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE) = '%1') " +
                            "AND    ((dbo_GI3_APPAREIL.GI3_C_TYPE_APPR) = 'JM') " +
                            "AND    ((dbo_GI3_APPAREIL.GI3_S_APPR) = 'ACTIF') " +
                            "AND    ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Actif' Or (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Non exploite')) " +
                            "ORDER BY dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE";

        public const string sqlCmdRM = "SELECT dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS NoSite,  " +
                                   "dbo_GI3_APPAREIL.GI3_N_IMMAT_APL AS No_Immatriculation,  " +
                                   "dbo_GI3_APPAREIL.GI3_NM_FABR_CONTR AS NomFabricant,  " +
                                   "dbo_GI3_APPAREIL.GI3_D_INST AS DateMiseEnService,  " +
                                   "dbo_GI3_APPAREIL.GI3_N_APPR_LIEU_APL " +
                            "FROM [SDGIC01].[dbo].GI3_APPAREIL as dbo_GI3_APPAREIL " +
                                  "INNER JOIN [SDGIC01].[dbo].GI3_SITE_COMPOSANTE as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_APPAREIL.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE " +
                            "WHERE (((dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE) = '%1') " +
                            "AND    ((dbo_GI3_APPAREIL.GI3_C_TYPE_APPR) = 'RM') " +
                            "AND    ((dbo_GI3_APPAREIL.GI3_S_APPR) = 'ACTIF') " +
                            "AND    ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Actif' Or (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP) = 'Non exploite')) " +
                            "ORDER BY dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE";

        public const string sqlCmdAlimGaz = "SELECT TOP 1 dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE,  " +
                                           "dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_DE_NOTE " +
                                    "FROM  [SDGIC01].[dbo].GI3_SITE_COMPOSANTE as dbo_GI3_SITE_COMPOSANTE " +
                                           "INNER JOIN[SDGIC01].[dbo].GI3_NOTE_INTERVENTION_APPR_SITE as dbo_GI3_NOTE_INTERVENTION_APPR_SITE ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_ROWD_SITE " +
                                    "WHERE (((dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE) = '%1') " +
                                    "AND    ((dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SOUS_SUJT_NOTE) = 'Alimentation en gaz') " +
                                    "AND    ((dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SUJT_NOTE_INTR) = 'PPA'))";

        public const string strSqlValideGIC = "SELECT DateDiff(hh, Max(GI3_D_INS_INIT), GETDATE()) AS MaxDeGI3_D_INS_INIT FROM [SDGIC01].[dbo].GI3_SITE_COMPOSANTE";


        public const string strSqlSiteTermineAS = "SELECT sQry_SitesTermines_AS.Statut, " +
                                                         "sQry_SitesTermines_AS.Revalide, " +
                                                         "sQry_SitesTermines_AS.Finale, " +
                                                         "sQry_SitesTermines_AS.TypeSignalement, " +
                                                         "sQry_SitesTermines_AS.No_site, " +
                                                         "sQry_SitesTermines_AS.[AS], " +
                                                         "sQry_SitesTermines_AS.TraiterAscenseur, " +
                                                         "sQry_SitesTermines_AS.DateTerminé, " +
                                                         "sQry_SitesTermines_AS.RegionAdm, " +
                                                         "sQry_SitesTermines_AS.Domaine, " +
                                                         "sQry_SitesTermines_AS.AS_GIC, " +
                                                         "sQry_SitesTermines_AS.SommeDomaine " +
                                                    "FROM (SELECT tbl_DossiersSuivi.Statut, " +
                                                                   "IIf(DateDiff(m, [DateTerminé], getdate()) >= 6,'Revalidé','Ok') AS Revalide, " +
                                                                   "tbl_DossiersSuivi.NiveauPriorite AS Finale, " +
                                                                   "tbl_DossiersSuivi.TypeSignalement, " +
                                                                   "tbl_DossiersSuivi.No_site, " +
                                                                   "tbl_DossiersSuivi.[AS], " +
                                                                   "tbl_Site_Selection.TraiterAscenseur, " +
                                                                   "tbl_DossiersSuivi.DateTerminé, " +
                                                                   "tbl_Site_Selection.RegionAdm, " +
                                                                   "tbl_RegionIntervention.Domaine, " +
                                                                   "([tbl_RegionIntervention].[Maximum] * [tbl_RegionIntervention].[Nbr_Inspection]) - [Qry_DossiersOuvertGIC].[SommeDomaine] AS AS_GIC, " +
                                                                   "[Qry_DossiersOuvertGIC].[SommeDomaine] " +
                                                            "FROM  (Select sQry_DossiersOuvertGIC.Region_Adm AS Region_Adm, sQry_DossiersOuvertGIC.Domaine, Sum(sQry_DossiersOuvertGIC.SommeDomaine) AS SommeDomaine from (" +
                                                                   "SELECT dbo_GI3_ADRESSE.GI3_NM_REG_ADMN as Region_Adm, " +
                                                                           "Left([GI3_DE_DOMN_INTRVT],2) AS Domaine, " +
                                                                           "Sum(1) AS SommeDomaine " +
                                                                    "FROM  (([SDGIC01].[dbo].[GI3_INTERVENTION] as dbo_GI3_INTERVENTION " +
                                                                           "INNER JOIN [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_INTERVENTION.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE) " +
                                                                           "INNER JOIN [SDGIC01].[dbo].[GI3_LIEN_SITE_ADRESSE] as dbo_GI3_LIEN_SITE_ADRESSE ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_ROWD_SITE) " +
                                                                           "INNER JOIN [SDGIC01].[dbo].[GI3_ADRESSE] as dbo_GI3_ADRESSE ON dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_ROWD_ADRS = dbo_GI3_ADRESSE.GI3_C_ROWD_ADRS " +
                                                                    "GROUP BY dbo_GI3_ADRESSE.GI3_NM_REG_ADMN, " +
                                                                                "Left([GI3_DE_DOMN_INTRVT],2), " +
                                                                                "dbo_GI3_INTERVENTION.GI3_C_ASSIGNE_A, " +
                                                                                "dbo_GI3_INTERVENTION.GI3_C_CODE_INTRVT, " +
                                                                                "dbo_GI3_INTERVENTION.GI3_S_INTRVT, " +
                                                                                "dbo_GI3_LIEN_SITE_ADRESSE.GI3_I_PRIN, " +
                                                                                "dbo_GI3_LIEN_SITE_ADRESSE.GI3_D_FIN, " +
                                                                                "dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_TYPE_UTIL " +
                                                                        "HAVING  (((dbo_GI3_INTERVENTION.GI3_C_ASSIGNE_A) = 'SADMIN') " +
                                                                        "AND      ((dbo_GI3_INTERVENTION.GI3_C_CODE_INTRVT) = 'Sécurité') " +
                                                                        "AND      ((dbo_GI3_INTERVENTION.GI3_S_INTRVT) = 'Non débutée') " +
                                                                        "AND      ((dbo_GI3_LIEN_SITE_ADRESSE.GI3_I_PRIN) = 'Y') " +
                                                                        "AND      ((dbo_GI3_LIEN_SITE_ADRESSE.GI3_D_FIN) Is Null) " +
                                                                        "AND      ((dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_TYPE_UTIL) = 'Principale')) " +
                                                                        "UNION " +
                                                                        "SELECT   tbl_Region.Région, " +
                                                                                 "tbl_RegionIntervention.Domaine, " +
                                                                                 "0 AS SommeDom " +
                                                                        "FROM    [SDDMU01].[dbo].[ORGRE_tbl_Region] as tbl_Region " +
                                                                                "INNER JOIN [SDDMU01].[dbo].[ORGRE_RegionIntervention] AS tbl_RegionIntervention ON tbl_Region.NoRégion = tbl_RegionIntervention.NoRégion " +
                                                                                ")	sQry_DossiersOuvertGIC " +
                                                                        "GROUP BY sQry_DossiersOuvertGIC.Region_Adm, sQry_DossiersOuvertGIC.Domaine) Qry_DossiersOuvertGIC " +
                                                                "INNER JOIN  (([SDDMU01].[dbo].[ORGRE_tbl_DossiersSuivi] as tbl_DossiersSuivi " +
                                                                "INNER JOIN    [SDDMU01].[dbo].[ORGRE_Site_Selection] as tbl_Site_Selection ON tbl_DossiersSuivi.No_site = tbl_Site_Selection.NoSite) " +
                                                                "INNER JOIN   ([SDDMU01].[dbo].[ORGRE_tbl_Region] as tbl_Region " +
                                                                "INNER JOIN    [SDDMU01].[dbo].[ORGRE_RegionIntervention] AS tbl_RegionIntervention ON tbl_Region.NoRégion = tbl_RegionIntervention.NoRégion) " +
                                                                           "ON tbl_Site_Selection.RegionAdm = tbl_Region.Région) " +
                                                                           "ON (Qry_DossiersOuvertGIC.Domaine = tbl_RegionIntervention.Domaine) AND(Qry_DossiersOuvertGIC.Region_Adm = tbl_Region.Région) " +
                                                            "WHERE  (((tbl_DossiersSuivi.Statut) = 'Terminé' Or (tbl_DossiersSuivi.Statut) = 'Retiré-Intrv') " +
                                                            "AND     ((tbl_DossiersSuivi.TypeSignalement) = '9' Or (tbl_DossiersSuivi.TypeSignalement) = '7') " +
                                                            "AND     ((tbl_DossiersSuivi.[AS]) > 0) " +
                                                            "AND     ((tbl_Site_Selection.TraiterAscenseur) = 0) " +
                                                            "AND     ((tbl_RegionIntervention.Domaine) = 'AS') " +
                                                            "AND     ((tbl_RegionIntervention.Nbr_Inspection) > 0)) " +
                                                            ") sQry_SitesTermines_AS " +
                                                    "GROUP BY sQry_SitesTermines_AS.Statut, " +
                                                             "sQry_SitesTermines_AS.Revalide, " +
                                                             "sQry_SitesTermines_AS.Finale, " +
                                                             "sQry_SitesTermines_AS.TypeSignalement, " +
                                                             "sQry_SitesTermines_AS.No_site, " +
                                                             "sQry_SitesTermines_AS.[AS], " +
                                                             "sQry_SitesTermines_AS.TraiterAscenseur, " +
                                                             "sQry_SitesTermines_AS.DateTerminé, " +
                                                             "sQry_SitesTermines_AS.RegionAdm, " +
                                                             "sQry_SitesTermines_AS.Domaine, " +
                                                             "sQry_SitesTermines_AS.AS_GIC, " +
                                                             "sQry_SitesTermines_AS.SommeDomaine";

        public const string strSqlSiteTermineGA = "SELECT sQry_SitesTermines_GA.Statut, " +
                                                         "sQry_SitesTermines_GA.Revalide, " +
                                                         "sQry_SitesTermines_GA.Finale, " +
                                                         "sQry_SitesTermines_GA.TypeSignalement, " +
                                                         "sQry_SitesTermines_GA.No_site, " +
                                                         "sQry_SitesTermines_GA.[GA], " +
                                                         "sQry_SitesTermines_GA.TraiterAscenseur, " +
                                                         "sQry_SitesTermines_GA.DateTerminé, " +
                                                         "sQry_SitesTermines_GA.RegionAdm, " +
                                                         "sQry_SitesTermines_GA.Domaine, " +
                                                         "sQry_SitesTermines_GA.GA_GIC, " +
                                                         "sQry_SitesTermines_GA.SommeDomaine " +
                                                    "FROM (SELECT tbl_DossiersSuivi.Statut, " +
                                                                   "IIf(DateDiff(m, [DateTerminé], getdate()) >= 6,'Revalidé','Ok') AS Revalide, " +
                                                                   "tbl_DossiersSuivi.NiveauPriorite AS Finale, " +
                                                                   "tbl_DossiersSuivi.TypeSignalement, " +
                                                                   "tbl_DossiersSuivi.No_site, " +
                                                                   "tbl_DossiersSuivi.[GA], " +
                                                                   "tbl_Site_Selection.TraiterAscenseur, " +
                                                                   "tbl_DossiersSuivi.DateTerminé, " +
                                                                   "tbl_Site_Selection.RegionAdm, " +
                                                                   "tbl_RegionIntervention.Domaine, " +
                                                                   "([tbl_RegionIntervention].[Maximum] * [tbl_RegionIntervention].[Nbr_Inspection]) - [Qry_DossiersOuvertGIC].[SommeDomaine] AS GA_GIC, " +
                                                                   "[Qry_DossiersOuvertGIC].[SommeDomaine] " +
                                                            "FROM  (Select sQry_DossiersOuvertGIC.Region_Adm AS Region_Adm, sQry_DossiersOuvertGIC.Domaine, Sum(sQry_DossiersOuvertGIC.SommeDomaine) AS SommeDomaine from (" +
                                                                   "SELECT dbo_GI3_ADRESSE.GI3_NM_REG_ADMN AS Region_Adm, " +
                                                                           "Left([GI3_DE_DOMN_INTRVT],2) AS Domaine, " +
                                                                           "Sum(1) AS SommeDomaine " +
                                                                    "FROM  (([SDGIC01].[dbo].[GI3_INTERVENTION] AS dbo_GI3_INTERVENTION " +
                                                                           "INNER JOIN [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] AS dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_INTERVENTION.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE) " +
                                                                           "INNER JOIN [SDGIC01].[dbo].[GI3_LIEN_SITE_ADRESSE] AS dbo_GI3_LIEN_SITE_ADRESSE ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_ROWD_SITE) " +
                                                                           "INNER JOIN [SDGIC01].[dbo].[GI3_ADRESSE] AS dbo_GI3_ADRESSE ON dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_ROWD_ADRS = dbo_GI3_ADRESSE.GI3_C_ROWD_ADRS " +
                                                                    "GROUP BY dbo_GI3_ADRESSE.GI3_NM_REG_ADMN, " +
                                                                                "Left([GI3_DE_DOMN_INTRVT],2), " +
                                                                                "dbo_GI3_INTERVENTION.GI3_C_ASSIGNE_A, " +
                                                                                "dbo_GI3_INTERVENTION.GI3_C_CODE_INTRVT, " +
                                                                                "dbo_GI3_INTERVENTION.GI3_S_INTRVT, " +
                                                                                "dbo_GI3_LIEN_SITE_ADRESSE.GI3_I_PRIN, " +
                                                                                "dbo_GI3_LIEN_SITE_ADRESSE.GI3_D_FIN, " +
                                                                                "dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_TYPE_UTIL " +
                                                                        "HAVING  (((dbo_GI3_INTERVENTION.GI3_C_ASSIGNE_A) = 'SADMIN') " +
                                                                        "AND      ((dbo_GI3_INTERVENTION.GI3_C_CODE_INTRVT) = 'Sécurité') " +
                                                                        "AND      ((dbo_GI3_INTERVENTION.GI3_S_INTRVT) = 'Non débutée') " +
                                                                        "AND      ((dbo_GI3_LIEN_SITE_ADRESSE.GI3_I_PRIN) = 'Y') " +
                                                                        "AND      ((dbo_GI3_LIEN_SITE_ADRESSE.GI3_D_FIN) Is Null) " +
                                                                        "AND      ((dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_TYPE_UTIL) = 'Principale')) " +
                                                                        "UNION " +
                                                                        "SELECT   tbl_Region.Région, " +
                                                                                 "tbl_RegionIntervention.Domaine, " +
                                                                                 "0 AS SommeDom " +
                                                                        "FROM    [SDDMU01].[dbo].[ORGRE_tbl_Region] AS tbl_Region " +
                                                                                "INNER JOIN [SDDMU01].[dbo].[ORGRE_RegionIntervention] AS tbl_RegionIntervention ON tbl_Region.NoRégion = tbl_RegionIntervention.NoRégion " +
                                                                                ")	sQry_DossiersOuvertGIC " +
                                                                        "GROUP BY sQry_DossiersOuvertGIC.Region_Adm, sQry_DossiersOuvertGIC.Domaine) Qry_DossiersOuvertGIC " +
                                                                "INNER JOIN  (([SDDMU01].[dbo].[ORGRE_tbl_DossiersSuivi] AS tbl_DossiersSuivi " +
                                                                "INNER JOIN    [SDDMU01].[dbo].[ORGRE_Site_Selection] AS tbl_Site_Selection ON tbl_DossiersSuivi.No_site = tbl_Site_Selection.NoSite) " +
                                                                "INNER JOIN   ([SDDMU01].[dbo].[ORGRE_tbl_Region] AS tbl_Region " +
                                                                "INNER JOIN    [SDDMU01].[dbo].[ORGRE_RegionIntervention] AS tbl_RegionIntervention ON tbl_Region.NoRégion = tbl_RegionIntervention.NoRégion) " +
                                                                           "ON tbl_Site_Selection.RegionAdm = tbl_Region.Région) " +
                                                                           "ON (Qry_DossiersOuvertGIC.Domaine = tbl_RegionIntervention.Domaine) AND(Qry_DossiersOuvertGIC.Region_Adm = tbl_Region.Région) " +
                                                            "WHERE  (((tbl_DossiersSuivi.Statut) = 'Terminé' Or (tbl_DossiersSuivi.Statut) = 'Retiré-Intrv') " +
                                                            "AND     ((tbl_DossiersSuivi.TypeSignalement) = '9' Or (tbl_DossiersSuivi.TypeSignalement) = '7') " +
                                                            "AND     ((tbl_DossiersSuivi.[GA]) > 0) " +
                                                            "AND     ((tbl_Site_Selection.TraiterAscenseur) = 0) " +
                                                            "AND     ((tbl_RegionIntervention.Domaine) = 'GA') " +
                                                            "AND     ((tbl_RegionIntervention.Nbr_Inspection) > 0)) " +
                                                            ") sQry_SitesTermines_GA " +
                                                    "GROUP BY sQry_SitesTermines_GA.Statut, " +
                                                             "sQry_SitesTermines_GA.Revalide, " +
                                                             "sQry_SitesTermines_GA.Finale, " +
                                                             "sQry_SitesTermines_GA.TypeSignalement, " +
                                                             "sQry_SitesTermines_GA.No_site, " +
                                                             "sQry_SitesTermines_GA.[GA], " +
                                                             "sQry_SitesTermines_GA.TraiterAscenseur, " +
                                                             "sQry_SitesTermines_GA.DateTerminé, " +
                                                             "sQry_SitesTermines_GA.RegionAdm, " +
                                                             "sQry_SitesTermines_GA.Domaine, " +
                                                             "sQry_SitesTermines_GA.GA_GIC, " +
                                                             "sQry_SitesTermines_GA.SommeDomaine";

        public const string strSqlSiteTerminePB = "SELECT sQry_SitesTermines_PB.Statut, " +
                                                         "sQry_SitesTermines_PB.Revalide, " +
                                                         "sQry_SitesTermines_PB.Finale, " +
                                                         "sQry_SitesTermines_PB.TypeSignalement, " +
                                                         "sQry_SitesTermines_PB.No_site, " +
                                                         "sQry_SitesTermines_PB.[PB], " +
                                                         "sQry_SitesTermines_PB.TraiterAscenseur, " +
                                                         "sQry_SitesTermines_PB.DateTerminé, " +
                                                         "sQry_SitesTermines_PB.RegionAdm, " +
                                                         "sQry_SitesTermines_PB.Domaine, " +
                                                         "sQry_SitesTermines_PB.PB_GIC, " +
                                                         "sQry_SitesTermines_PB.SommeDomaine " +
                                                    "FROM (SELECT tbl_DossiersSuivi.Statut, " +
                                                                   "IIf(DateDiff(m, [DateTerminé], getdate()) >= 6,'Revalidé','Ok') AS Revalide, " +
                                                                   "tbl_DossiersSuivi.NiveauPriorite AS Finale, " +
                                                                   "tbl_DossiersSuivi.TypeSignalement, " +
                                                                   "tbl_DossiersSuivi.No_site, " +
                                                                   "tbl_DossiersSuivi.[PB], " +
                                                                   "tbl_Site_Selection.TraiterAscenseur, " +
                                                                   "tbl_DossiersSuivi.DateTerminé, " +
                                                                   "tbl_Site_Selection.RegionAdm, " +
                                                                   "tbl_RegionIntervention.Domaine, " +
                                                                   "([tbl_RegionIntervention].[Maximum] * [tbl_RegionIntervention].[Nbr_Inspection]) - [Qry_DossiersOuvertGIC].[SommeDomaine] AS PB_GIC, " +
                                                                   "[Qry_DossiersOuvertGIC].[SommeDomaine] " +
                                                            "FROM  (Select sQry_DossiersOuvertGIC.Region_Adm AS Region_Adm, sQry_DossiersOuvertGIC.Domaine, Sum(sQry_DossiersOuvertGIC.SommeDomaine) AS SommeDomaine from (" +
                                                                   "SELECT dbo_GI3_ADRESSE.GI3_NM_REG_ADMN AS Region_Adm, " +
                                                                           "Left([GI3_DE_DOMN_INTRVT],2) AS Domaine, " +
                                                                           "Sum(1) AS SommeDomaine " +
                                                                    "FROM  (([SDGIC01].[dbo].[GI3_INTERVENTION] AS dbo_GI3_INTERVENTION " +
                                                                           "INNER JOIN [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] AS dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_INTERVENTION.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE) " +
                                                                           "INNER JOIN [SDGIC01].[dbo].[GI3_LIEN_SITE_ADRESSE] AS dbo_GI3_LIEN_SITE_ADRESSE ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_ROWD_SITE) " +
                                                                           "INNER JOIN [SDGIC01].[dbo].[GI3_ADRESSE] AS dbo_GI3_ADRESSE ON dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_ROWD_ADRS = dbo_GI3_ADRESSE.GI3_C_ROWD_ADRS " +
                                                                    "GROUP BY dbo_GI3_ADRESSE.GI3_NM_REG_ADMN, " +
                                                                                "Left([GI3_DE_DOMN_INTRVT],2), " +
                                                                                "dbo_GI3_INTERVENTION.GI3_C_ASSIGNE_A, " +
                                                                                "dbo_GI3_INTERVENTION.GI3_C_CODE_INTRVT, " +
                                                                                "dbo_GI3_INTERVENTION.GI3_S_INTRVT, " +
                                                                                "dbo_GI3_LIEN_SITE_ADRESSE.GI3_I_PRIN, " +
                                                                                "dbo_GI3_LIEN_SITE_ADRESSE.GI3_D_FIN, " +
                                                                                "dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_TYPE_UTIL " +
                                                                        "HAVING  (((dbo_GI3_INTERVENTION.GI3_C_ASSIGNE_A) = 'SADMIN') " +
                                                                        "AND      ((dbo_GI3_INTERVENTION.GI3_C_CODE_INTRVT) = 'Sécurité') " +
                                                                        "AND      ((dbo_GI3_INTERVENTION.GI3_S_INTRVT) = 'Non débutée') " +
                                                                        "AND      ((dbo_GI3_LIEN_SITE_ADRESSE.GI3_I_PRIN) = 'Y') " +
                                                                        "AND      ((dbo_GI3_LIEN_SITE_ADRESSE.GI3_D_FIN) Is Null) " +
                                                                        "AND      ((dbo_GI3_LIEN_SITE_ADRESSE.GI3_C_TYPE_UTIL) = 'Principale')) " +
                                                                        "UNION " +
                                                                        "SELECT   tbl_Region.Région, " +
                                                                                 "tbl_RegionIntervention.Domaine, " +
                                                                                 "0 AS SommeDom " +
                                                                        "FROM    [SDDMU01].[dbo].[ORGRE_tbl_Region] AS tbl_Region " +
                                                                                "INNER JOIN [SDDMU01].[dbo].[ORGRE_RegionIntervention] AS tbl_RegionIntervention ON tbl_Region.NoRégion = tbl_RegionIntervention.NoRégion " +
                                                                                ")	sQry_DossiersOuvertGIC " +
                                                                        "GROUP BY sQry_DossiersOuvertGIC.Region_Adm, sQry_DossiersOuvertGIC.Domaine) Qry_DossiersOuvertGIC " +
                                                                "INNER JOIN  (([SDDMU01].[dbo].[ORGRE_tbl_DossiersSuivi] AS tbl_DossiersSuivi " +
                                                                "INNER JOIN    [SDDMU01].[dbo].[ORGRE_Site_Selection] AS tbl_Site_Selection ON tbl_DossiersSuivi.No_site = tbl_Site_Selection.NoSite) " +
                                                                "INNER JOIN   ([SDDMU01].[dbo].[ORGRE_tbl_Region] AS tbl_Region " +
                                                                "INNER JOIN    [SDDMU01].[dbo].[ORGRE_RegionIntervention] AS tbl_RegionIntervention ON tbl_Region.NoRégion = tbl_RegionIntervention.NoRégion) " +
                                                                           "ON tbl_Site_Selection.RegionAdm = tbl_Region.Région) " +
                                                                           "ON (Qry_DossiersOuvertGIC.Domaine = tbl_RegionIntervention.Domaine) AND(Qry_DossiersOuvertGIC.Region_Adm = tbl_Region.Région) " +
                                                            "WHERE  (((tbl_DossiersSuivi.Statut) = 'Terminé' Or (tbl_DossiersSuivi.Statut) = 'Retiré-Intrv') " +
                                                            "AND     ((tbl_DossiersSuivi.TypeSignalement) = '9' Or (tbl_DossiersSuivi.TypeSignalement) = '7') " +
                                                            "AND     ((tbl_DossiersSuivi.[PB]) > 0) " +
                                                            "AND     ((tbl_Site_Selection.TraiterAscenseur) = 0) " +
                                                            "AND     ((tbl_RegionIntervention.Domaine) = 'PB') " +
                                                            "AND     ((tbl_RegionIntervention.Nbr_Inspection) > 0)) " +
                                                            ") sQry_SitesTermines_PB " +
                                                    "GROUP BY sQry_SitesTermines_PB.Statut, " +
                                                             "sQry_SitesTermines_PB.Revalide, " +
                                                             "sQry_SitesTermines_PB.Finale, " +
                                                             "sQry_SitesTermines_PB.TypeSignalement, " +
                                                             "sQry_SitesTermines_PB.No_site, " +
                                                             "sQry_SitesTermines_PB.[PB], " +
                                                             "sQry_SitesTermines_PB.TraiterAscenseur, " +
                                                             "sQry_SitesTermines_PB.DateTerminé, " +
                                                             "sQry_SitesTermines_PB.RegionAdm, " +
                                                             "sQry_SitesTermines_PB.Domaine, " +
                                                             "sQry_SitesTermines_PB.PB_GIC, " +
                                                             "sQry_SitesTermines_PB.SommeDomaine";

