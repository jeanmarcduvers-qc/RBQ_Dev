                //////////////////////////////////////////////////////////////////////
                ///
                //     Mise à jour des statuts de dossiers
                ///
                /////////////////////////////////////////////////////////////////////
                void MajStatutsDossier()
                {
                    string sqlCmdSite = "SELECT tbl_SuiviSite.No_site From tbl_SuiviSite, tbl_Param_Stat WHERE tbl_SuiviSite.Statut='Attente appel' AND DateDiff('h',[Appel1_Date],Now())>[tbl_Param_Stat].[Delai_Attente_Tel] AND tbl_SuiviSite.Appel2_Message=False AND tbl_SuiviSite.Appel2_NonApplicable=False";
                    string strNoSite = "";
                    string strSqlUpdate = "";

                    EtapeDebug = "MajStatutsDossier";

                    // Récupère les Sites
                    using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                    {
                        conn.Open();
                        using (var transaction = conn.BeginTransaction())
                        {
                            OleDbCommand commandDataReader = new OleDbCommand(sqlCmdSite, conn, transaction);
                            commandDataReader.CommandTimeout = 18000;
                            OleDbDataReader ValueReader = commandDataReader.ExecuteReader();

                            // Vérifier si le Statut «Attente Appel» de l'appel 1 est échu
                            while (ValueReader.Read())
                            {
                                strNoSite = ValueReader["No_Site"].ToString();

                                strSqlUpdate = "UPDATE tbl_DossiersSuivi SET tbl_DossiersSuivi.Statut = 'Appel2' WHERE tbl_DossiersSuivi.No_site = '" + strNoSite.ToString() + "'";
                                OleDbCommand CmdUpdate = new OleDbCommand(strSqlUpdate.ToString(), conn, transaction);
                                CmdUpdate.CommandType = CommandType.Text;
                                CmdUpdate.ExecuteNonQuery();

                                strSqlUpdate = "INSERT INTO tbl_HistoriqueStatut ( NoSite, Statut, DateMajStatut, IDUser, Commentaire ) Values('" + strNoSite.ToString() + "', 'Appel2', Now(), 'OGRE', 'Mise à jour statut (délais dépassé)')";
                                CmdUpdate = new OleDbCommand(strSqlUpdate.ToString(), conn, transaction);
                                CmdUpdate.CommandType = CommandType.Text;
                                CmdUpdate.ExecuteNonQuery();

                                strSqlUpdate = "UPDATE tbl_SuiviSite SET tbl_SuiviSite.Statut = 'Appel2', tbl_SuiviSite.Date_Statut = Now() WHERE tbl_SuiviSite.No_site = '" + strNoSite.ToString() + "'";
                                CmdUpdate = new OleDbCommand(strSqlUpdate.ToString(), conn, transaction);
                                CmdUpdate.CommandType = CommandType.Text;
                                CmdUpdate.ExecuteNonQuery();
                            }

                            transaction.Commit();
                            ValueReader.Close();
                        }
                    }

                    sqlCmdSite = "SELECT tbl_SuiviSite.No_site From tbl_SuiviSite, tbl_Param_Stat WHERE tbl_SuiviSite.Statut = 'Attente appel' AND DateDiff('h',[Appel2_Date],Now()) > [tbl_Param_Stat].[Delai_Attente_Courrier] AND (tbl_SuiviSite.Appel2_Message = True OR tbl_SuiviSite.Appel2_NonApplicable = True)";
                    // Récupère les Sites
                    using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                    {
                        conn.Open();
                        using (var transaction = conn.BeginTransaction())
                        {
                            OleDbCommand commandDataReader = new OleDbCommand(sqlCmdSite, conn, transaction);
                            OleDbDataReader ValueReader = commandDataReader.ExecuteReader();

                            // Vérifier si le Statut «Attente Appel» de l'appel 2 est échu
                            while (ValueReader.Read())
                            {
                                strNoSite = ValueReader["No_Site"].ToString();

                                strSqlUpdate = "UPDATE tbl_DossiersSuivi SET tbl_DossiersSuivi.Statut = 'Lettre à faire' WHERE tbl_DossiersSuivi.No_site = '" + strNoSite.ToString() + "'";
                                OleDbCommand CmdUpdate = new OleDbCommand(strSqlUpdate.ToString(), conn, transaction);
                                CmdUpdate.CommandType = CommandType.Text;
                                CmdUpdate.ExecuteNonQuery();

                                strSqlUpdate = "INSERT INTO tbl_HistoriqueStatut (NoSite, Statut, DateMajStatut, IDUser, Commentaire) Values('" + strNoSite.ToString() + "', 'Lettre à faire', Now(), 'OGRE', 'Mise à jour statut (délais dépassé)')";
                                CmdUpdate = new OleDbCommand(strSqlUpdate.ToString(), conn, transaction);
                                CmdUpdate.CommandType = CommandType.Text;
                                CmdUpdate.ExecuteNonQuery();

                                strSqlUpdate = "UPDATE tbl_SuiviSite SET tbl_SuiviSite.Statut = 'Lettre à faire', tbl_SuiviSite.Date_Statut = Now() WHERE tbl_SuiviSite.No_site = '" + strNoSite.ToString() + "'";
                                CmdUpdate = new OleDbCommand(strSqlUpdate.ToString(), conn, transaction);
                                CmdUpdate.CommandType = CommandType.Text;
                                CmdUpdate.ExecuteNonQuery();
                            }
                            transaction.Commit();
                            conn.Close();
                            ValueReader.Close();
                        }
                    }

                    sqlCmdSite = "SELECT tbl_SuiviSite.No_site FROM tbl_SuiviSite, tbl_Param_Stat WHERE (tbl_SuiviSite.Statut = 'Attente courrier' AND tbl_SuiviSite.LettreCertifiee_NoSuivi Is Null) AND ((DateDiff('h',[LettreStandard_Date],Now()) > [tbl_Param_Stat].[Delai_Attente_Courrier] AND tbl_SuiviSite.Courriel Is Not Null) OR (DateDiff('h',[LettreStandard_Date],Now()) > [tbl_Param_Stat].[Delai_Attente_Courrier] AND tbl_SuiviSite.LettreStandard = True) OR (tbl_SuiviSite.Courriel Is Not Null AND DateDiff('h',[Courriel_Date],Now()) > [tbl_Param_Stat].[Delai_Attente_Courrier]) OR (tbl_SuiviSite.LettreStandard = True AND DateDiff('h',[Courriel_Date],Now()) > [tbl_Param_Stat].[Delai_Attente_Courrier]))";
                    // Récupère les Sites
                    using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                    {
                        conn.Open();
                        using (var transaction = conn.BeginTransaction())
                        {
                            OleDbCommand commandDataReader = new OleDbCommand(sqlCmdSite, conn, transaction);
                            OleDbDataReader ValueReader = commandDataReader.ExecuteReader();

                            // Vérifier si le Statut «Attente Courriel» est échu
                            while (ValueReader.Read())
                            {
                                strNoSite = ValueReader["No_Site"].ToString();
                                strSqlUpdate = "UPDATE tbl_DossiersSuivi SET tbl_DossiersSuivi.Statut = 'Poste certifiée à faire' WHERE tbl_DossiersSuivi.No_site = '" + strNoSite.ToString() + "'";
                                OleDbCommand CmdUpdate = new OleDbCommand(strSqlUpdate.ToString(), conn, transaction);
                                CmdUpdate.CommandType = CommandType.Text;
                                CmdUpdate.ExecuteNonQuery();

                                strSqlUpdate = "INSERT INTO tbl_HistoriqueStatut (NoSite, Statut, DateMajStatut, IDUser, Commentaire) Values('" + strNoSite.ToString() + "', 'Poste certifiée à faire', Now(), 'OGRE', 'Mise à jour statut (délais dépassé)')";
                                CmdUpdate = new OleDbCommand(strSqlUpdate.ToString(), conn, transaction);
                                CmdUpdate.CommandType = CommandType.Text;
                                CmdUpdate.ExecuteNonQuery();

                                strSqlUpdate = "UPDATE tbl_SuiviSite SET tbl_SuiviSite.Statut = 'Poste certifiée à faire', tbl_SuiviSite.Date_Statut = Now() WHERE tbl_SuiviSite.No_site = '" + strNoSite.ToString() + "'";
                                CmdUpdate = new OleDbCommand(strSqlUpdate.ToString(), conn, transaction);
                                CmdUpdate.CommandType = CommandType.Text;
                                CmdUpdate.ExecuteNonQuery();
                            }
                            transaction.Commit();
                            conn.Close();
                            ValueReader.Close();
                        }
                    }



                    sqlCmdSite = "SELECT tbl_SuiviSite.Date_Statut, tbl_SuiviSite.No_site From tbl_SuiviSite, tbl_Param_Stat WHERE tbl_SuiviSite.Statut = 'Attente Courrier' AND DateDiff('h',[LettreCertifiee_Date],Now()) > [tbl_Param_Stat].[Delai_Attente_Courrier] AND tbl_SuiviSite.LettreCertifiee_NoSuivi Is Not Null";
                    // Récupère les Sites
                    using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                    {
                        conn.Open();
                        using (var transaction = conn.BeginTransaction())
                        {
                            OleDbCommand commandDataReader = new OleDbCommand(sqlCmdSite, conn, transaction);
                            OleDbDataReader ValueReader = commandDataReader.ExecuteReader();

                            // Vérifier si le Statut «Lettre Certifiée» est échu
                            while (ValueReader.Read())
                            {
                                strNoSite = ValueReader["No_Site"].ToString();
                                strSqlUpdate = "UPDATE tbl_DossiersSuivi SET tbl_DossiersSuivi.Statut = 'Traitement spécial' WHERE tbl_DossiersSuivi.No_site = '" + strNoSite.ToString() + "'";
                                OleDbCommand CmdUpdate = new OleDbCommand(strSqlUpdate.ToString(), conn, transaction);
                                CmdUpdate.CommandType = CommandType.Text;
                                CmdUpdate.ExecuteNonQuery();

                                strSqlUpdate = "INSERT INTO tbl_HistoriqueStatut (NoSite, Statut, DateMajStatut, IDUser, Commentaire) Values('" + strNoSite.ToString() + "', 'Traitement spécial', Now(), 'OGRE', 'Mise à jour statut (délais dépassé)')";
                                CmdUpdate = new OleDbCommand(strSqlUpdate.ToString(), conn, transaction);
                                CmdUpdate.CommandType = CommandType.Text;
                                CmdUpdate.ExecuteNonQuery();

                                strSqlUpdate = "UPDATE tbl_SuiviSite SET tbl_SuiviSite.Statut = 'Traitement spécial', tbl_SuiviSite.Date_Statut = Now() WHERE tbl_SuiviSite.No_site = '" + strNoSite.ToString() + "'";
                                CmdUpdate = new OleDbCommand(strSqlUpdate.ToString(), conn, transaction);
                                CmdUpdate.CommandType = CommandType.Text;
                                CmdUpdate.ExecuteNonQuery();
                            }
                            transaction.Commit();
                            conn.Close();
                            ValueReader.Close();
                        }
                    }

                    JournalEvent("Statuts de dossier", "Mise à jour effectué", "PPA_OGRE_LOT", "", "");
                }

                //////////////////////////////////////////////////////////////////////
                ///
                //     Mise à jour de la table TableRevalider
                ///
                /////////////////////////////////////////////////////////////////////
                void CreerTableRevalider()
                {
                    string sqlCmdSite = "SELECT DISTINCT tbl_DossiersSuivi.No_site, " +
                                                        "dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_V_TEXT_ATTR AS CodeQualif, " +
                                                        "tbl_DossiersSuivi.Statut, " +
                                                        "tbl_DossiersSuivi.NiveauPriorite, " +
                                                        "tbl_DossiersSuivi.DateNouveau, " +
                                                        "tbl_DossiersSuivi.DateTerminé, " +
                                                        "sQry_SiteRevalider_InterventionsGAZ.DispoGAZ, " +
                                                        "tbl_DossiersSuivi.BA, " +
                                                        "tbl_DossiersSuivi.EL, " +
                                                        "tbl_DossiersSuivi.PB, " +
                                                        "tbl_DossiersSuivi.GA," +
                                                        "tbl_DossiersSuivi.[AS], " +
                                                        "tbl_DossiersSuivi.JM, " +
                                                        "tbl_DossiersSuivi.RM, " +
                                                        "dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_V_TEXT_ATTR, " +
                                                        "tbl_Site_Selection.Ascenseur, " +
                                                        "tbl_Site_Selection.EscMecanique, " +
                                                        "tbl_Site_Selection.MonteCharge, " +
                                                        "tbl_Site_Selection.AscHandicape, " +
                                                        "tbl_Site_Selection.TraiterAscenseur " +
                                                 "FROM  ([SDDMU01].[dbo].[ORGRE_Site_Selection] as tbl_Site_Selection " +
                                                     "INNER JOIN(([SDGIC01].dbo.GI3_SITE_COMPOSANTE as dbo_GI3_SITE_COMPOSANTE " +
                                                     "INNER JOIN[SDDMU01].[dbo].[ORGRE_tbl_DossiersSuivi] as tbl_DossiersSuivi ON dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE = tbl_DossiersSuivi.No_site) " +
                                                     "INNER JOIN([SDGIC01].dbo.GI3_ATTRIBUTS_SITE_COMP_VALEURS as dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS " +
                                                     "INNER JOIN[SDGIC01].dbo.GI3_ATTRIBUTS_SITE_COMPOSANTE as dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE ON dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_C_ROWD_ATTR_SITE_COMP = dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_ATTR_SITE_COMP) " +
                                                            "ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_SITE) " +
                                                            "ON tbl_Site_Selection.NoSite = tbl_DossiersSuivi.No_site) " +
                                                     "INNER JOIN (SELECT tbl_DossiersSuivi.No_site, " +
                                                                        "IIf([ssQry_SiteRevalider_InterventionsGAZ].[No_site] is null,'Non','Oui') AS DispoGaz, " +
                                                                        "tbl_DossiersSuivi.Statut, " +
                                                                        "tbl_DossiersSuivi.BA, " +
                                                                        "tbl_DossiersSuivi.EL, " +
                                                                        "tbl_DossiersSuivi.PB, " +
                                                                        "tbl_DossiersSuivi.GA, " +
                                                                        "tbl_DossiersSuivi.[AS], " +
                                                                        "tbl_DossiersSuivi.JM, " +
                                                                        "tbl_DossiersSuivi.RM " +
                                                                  "FROM (SELECT tbl_DossiersSuivi2.No_site " +
                                                                        "FROM  ([SDGIC01].dbo.GI3_NOTE_INTERVENTION_APPR_SITE as dbo_GI3_NOTE_INTERVENTION_APPR_SITE " +
                                                                              "RIGHT JOIN [SDGIC01].dbo.GI3_SITE_COMPOSANTE as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE) " +
                                                                              "INNER JOIN [SDDMU01].[dbo].[ORGRE_tbl_DossiersSuivi] as tbl_DossiersSuivi2 ON dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE = tbl_DossiersSuivi2.No_site " +
                                                                        "WHERE (((tbl_DossiersSuivi2.Statut) = 'Revalider') " +
                                                                        "AND    ((dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SOUS_SUJT_NOTE) = 'Alimentation en gaz') " +
                                                                        "AND    ((dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SUJT_NOTE_INTR) = 'PPA'))) ssQry_SiteRevalider_InterventionsGAZ " +
                                                                      "RIGHT JOIN [SDDMU01].[dbo].[ORGRE_tbl_DossiersSuivi] as tbl_DossiersSuivi ON ssQry_SiteRevalider_InterventionsGAZ.No_site = tbl_DossiersSuivi.No_site " +
                                                                       "LEFT JOIN  [SDDMU01].[dbo].[ORGRE_tbl_SiteRevalider_DispoInterv] as tbl_SiteRevalider_DispoInterv ON tbl_DossiersSuivi.No_site = tbl_SiteRevalider_DispoInterv.No_site " +
                                                                  "WHERE  (((tbl_DossiersSuivi.Statut) = 'Revalider') " +
                                                                  "AND     ((tbl_DossiersSuivi.BA) <> 0) " +
                                                                  "AND     ((tbl_DossiersSuivi.EL) <> 0) " +
                                                                  "AND     ((tbl_DossiersSuivi.PB) <> 0) " +
                                                                  "AND     ((tbl_DossiersSuivi.GA) <> 0) " +
                                                                  "AND     ((tbl_DossiersSuivi.[AS]) <> 0) " +
                                                                  "AND     ((tbl_DossiersSuivi.JM) <> 0) " +
                                                                  "AND     ((tbl_DossiersSuivi.RM) <> 0) " +
                                                                  "AND     ((tbl_SiteRevalider_DispoInterv.No_site)Is Null))) sQry_SiteRevalider_InterventionsGAZ ON dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE = sQry_SiteRevalider_InterventionsGAZ.No_site " +
                                                 "WHERE   (((tbl_DossiersSuivi.Statut) = 'Revalider') " +
                                                 "AND      ((dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_D_FIN)Is Null) " +
                                                 "AND      ((dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR) = 'Code de qualification' Or(dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR) = 'Code de qualification principal')) " +
                                                 "ORDER BY tbl_DossiersSuivi.NiveauPriorite DESC";

                    string strNoSite = "";
                    string strCodeQualif = "";
                    string strDispoPB;
                    string strDispoEL;
                    string strDispoRM;
                    string strDispoAS;

                    string strSqlInsert = "";
                    EtapeDebug = "CreerTableRevalider";

                    // Mise à jours des tables SQL
                    majORGRE_Site_Selection();
                    majORGRE_tbl_DossiersSuivi();
                    majORGRE_tbl_SiteRevalider_DispoInterv();

                    SqlCommand commandDataReaderIntervention = new SqlCommand(sqlCmdSite.ToString(), mySQLConnectionII);
                    commandDataReaderIntervention.CommandType = CommandType.Text;
                    commandDataReaderIntervention.CommandTimeout = 12000;
                    SqlDataReader ValueReader = commandDataReaderIntervention.ExecuteReader();

                    // Vérifier si le Statut «Attente Appel» de l'appel 1 est échu
                    while (ValueReader.Read())
                    {
                        strNoSite = ValueReader["No_Site"].ToString();
                        strCodeQualif = ValueReader["CodeQualif"].ToString();

                        if (ValidAlgo(strNoSite, "PB", strCodeQualif) == false)
                        {
                            strDispoPB = "Non";
                        }
                        else
                        {
                            strDispoPB = "Oui";
                        }

                        if (ValidAlgo(strNoSite, "EL", strCodeQualif) == false)
                        {
                            strDispoEL = "Non";
                        }
                        else
                        {
                            strDispoEL = "Oui";
                        }

                        if (strCodeQualif == "R1")
                        {
                            strDispoRM = "Oui";
                        }
                        else
                        {
                            strDispoRM = "Non";
                        }

                        if (int.Parse(ValueReader["Ascenseur"].ToString()) + int.Parse(ValueReader["EscMecanique"].ToString()) + int.Parse(ValueReader["MonteCharge"].ToString()) + int.Parse(ValueReader["AscHandicape"].ToString()) > 0)
                        {
                            strDispoAS = "Oui";
                        }
                        else
                        {
                            strDispoAS = "Non";
                        }

                        strSqlInsert = "Insert into tbl_SiteRevalider_DispoInterv ([No_site], [CodeQualif], [Statut], [NiveauPriorite], [DateNouveau], [DateTerminé], [DispoPB], [DispoEL], [DispoGAZ], [DispoRM], [DispoAS], [BA], [EL], [PB] ,[GA], [AS], [JM], [RM]) " +
                                       "Values('strNo_site', 'strCodeQualif', 'strStatut', lgNiveauPriorite, 'dtDateNouveau', 'dtDateTerminé', 'strDispoPB', 'strDispoEL', 'strDispoGAZ', 'strDispoRM', 'strDispoAS', intBA, intEL, intPB, intGA, intAS, intJM, intRM)";

                        strSqlInsert = strSqlInsert.Replace("strNo_site", strNoSite);
                        strSqlInsert = strSqlInsert.Replace("strCodeQualif", strCodeQualif);
                        strSqlInsert = strSqlInsert.Replace("strStatut", ValueReader["Statut"].ToString());
                        strSqlInsert = strSqlInsert.Replace("lgNiveauPriorite", ValueReader["NiveauPriorite"].ToString());
                        strSqlInsert = strSqlInsert.Replace("dtDateNouveau", ValueReader["DateNouveau"].ToString());
                        strSqlInsert = strSqlInsert.Replace("dtDateTerminé", ValueReader["DateTerminé"].ToString());
                        strSqlInsert = strSqlInsert.Replace("strDispoPB", strDispoPB);
                        strSqlInsert = strSqlInsert.Replace("strDispoEL", strDispoEL);
                        strSqlInsert = strSqlInsert.Replace("strDispoGAZ", ValueReader["DispoGAZ"].ToString());
                        strSqlInsert = strSqlInsert.Replace("strDispoRM", strDispoRM);
                        strSqlInsert = strSqlInsert.Replace("strDispoAS", strDispoAS);
                        strSqlInsert = strSqlInsert.Replace("intBA", ValueReader["BA"].ToString());
                        strSqlInsert = strSqlInsert.Replace("intEL", ValueReader["EL"].ToString());
                        strSqlInsert = strSqlInsert.Replace("intPB", ValueReader["PB"].ToString());
                        strSqlInsert = strSqlInsert.Replace("intGA", ValueReader["GA"].ToString());
                        strSqlInsert = strSqlInsert.Replace("intAS", ValueReader["AS"].ToString());
                        strSqlInsert = strSqlInsert.Replace("intJM", ValueReader["JM"].ToString());
                        strSqlInsert = strSqlInsert.Replace("intRM", ValueReader["RM"].ToString());

                        using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                        {
                            conn.Open();
                            using (var transaction = conn.BeginTransaction())
                            {
                                OleDbCommand CmdUpdate = new OleDbCommand(strSqlInsert.ToString(), conn, transaction);
                                CmdUpdate.CommandType = CommandType.Text;
                                CmdUpdate.ExecuteNonQuery();
                                transaction.Commit();
                                conn.Close();
                            }
                        }
                    }
                }


                void ReactiverSitesRetires()
                {
                    try
                    {
                        InsertTableLogPlanificateur("ReactiverSites", "Début réactivation");

                        int compteurReactives = 0;

                        // Requête pour trouver sites "Délais 12 mois" > 12 mois
                        string sqlSitesAReactiver = @"
                                    SELECT DISTINCT h.NoSite
                                    FROM tbl_HistoriqueStatut h
                                    WHERE h.Statut = 'Délais 12 mois'
                                      AND DateDiff('m', h.DateMajStatut, Now()) >= 12
                                      AND NOT EXISTS (
                                          SELECT 1 
                                          FROM tbl_HistoriqueStatut h2 
                                          WHERE h2.NoSite = h.NoSite 
                                            AND h2.DateMajStatut > h.DateMajStatut
                                    )";

                        // Connexion Access
                        using (var connAccess = new OleDbConnection(strConnectBdAccess))
                        {
                            connAccess.Open();
                            OleDbCommand cmdSites = new OleDbCommand(sqlSitesAReactiver, connAccess);
                            OleDbDataReader readerSites = cmdSites.ExecuteReader();

                            while (readerSites.Read())
                            {
                                string noSite = readerSites["NoSite"].ToString();

                                // UPDATE statut dans tbl_DossiersSuivi
                                string sqlUpdateDossier = "UPDATE tbl_DossiersSuivi SET Statut = 'Rechercher doublon', DateNouveau = Now() WHERE No_site = '" + noSite + "'";

                                using (var connUpdate = new OleDbConnection(strConnectBdAccess))
                                {
                                    connUpdate.Open();
                                    OleDbCommand cmdUpdate = new OleDbCommand(sqlUpdateDossier, connUpdate);
                                    cmdUpdate.ExecuteNonQuery();
                                }

                                // INSERT nouvel historique
                                string sqlInsertHistorique = "INSERT INTO tbl_HistoriqueStatut (NoSite, Statut, DateMajStatut, Commentaire, IDUser) " +
                                                            "VALUES ('" + noSite + "', 'Rechercher doublon', Now(), 'Réactivation automatique après 12 mois', 'SSIS')";

                                using (var connInsert = new OleDbConnection(strConnectBdAccess))
                                {
                                    connInsert.Open();
                                    OleDbCommand cmdInsert = new OleDbCommand(sqlInsertHistorique, connInsert);
                                    cmdInsert.ExecuteNonQuery();
                                }

                                compteurReactives++;
                            }

                            readerSites.Close();
                        }

                        InsertTableLogPlanificateur("ReactiverSites", compteurReactives + " sites");
                    }
                    catch (Exception ex)
                    {
                        InsertTableLogPlanificateur("ReactiverSites", "Erreur: " + ex.Message.Substring(0, Math.Min(100, ex.Message.Length)));
                    }
                }


                void ImprimePDF(string strPath, string strNomFichier)
                {
                    EtapeDebug = "ImprimePDF";
                    try
                    {
                        // Exécuter un rapport spécifique et récupérer le rendu en PDF
                        string reportPath = "/Rapport pour Service SSIS/Fiche Inspecteur – utilisé par le service SSIS ORGRE_LOT";
                        string format = "PDF";
                        byte[] result = null;
                        string encoding, mimeType, extension;
                        string[] streamIds;
                        string historyId = null;
                        ST_72623c1e4fa44b22ba9390e5501454fa.WebReportExecution.ReportExecutionService rs = new ST_72623c1e4fa44b22ba9390e5501454fa.WebReportExecution.ReportExecutionService();
                        rs.Credentials = System.Net.CredentialCache.DefaultCredentials;
                        rs.LoadReport(reportPath, historyId);
                        ST_72623c1e4fa44b22ba9390e5501454fa.WebReportExecution.Warning[] warnings = null;


                        result = rs.Render(format, null, out extension, out mimeType, out encoding, out warnings, out streamIds);

                        // Sauvegarder le fichier sur le disque
                        File.WriteAllBytes(@strPath + "\\" + strNomFichier, result);

                    }
                    catch (System.Web.Services.Protocols.SoapException soapEx)
                    {
                        string detailText = soapEx.Detail?.InnerText ?? "(aucun détail)";
                        string detailXml = soapEx.Detail?.OuterXml ?? "(aucun XML)";
                        string inner = soapEx.InnerException?.Message ?? "(aucune inner exception)";

                        if (soapEx.Detail != null)
                        {
                            detailText = soapEx.Detail.InnerText;
                            detailXml = soapEx.Detail.InnerXml;
                        }

                        // Empêche SafeLinks de modifier le XML
                        string encodedXml = System.Security.SecurityElement.Escape(detailXml);

                        string msg =
                            "SOAP ERROR: " + soapEx.Message + "\n\n" +
                            "DETAIL TEXT: " + detailText + "\n\n" +
                            "DETAIL XML: " + detailXml + "\n\n" +
                            "ENCODE XML: " + encodedXml + "\n\n" +
                            "INNER: " + inner + "\n\n" +
                            "CODE: " + soapEx.Code + "\n" +
                            "ACTOR: " + soapEx.Actor;

                        InsertTableLogJobPlanificateur("ImprimePDF(" + strCodeTraitement + ")", "SOAP ERROR: " + soapEx.Message);
                        InsertTableLogJobPlanificateur("ImprimePDF(" + strCodeTraitement + ")", "DETAIL TEXT: " + detailText);
                        InsertTableLogJobPlanificateur("ImprimePDF(" + strCodeTraitement + ")", "DETAIL XML: " + detailXml);
                        InsertTableLogJobPlanificateur("ImprimePDF(" + strCodeTraitement + ")", "ENCODE XML: " + encodedXml);
                        InsertTableLogJobPlanificateur("ImprimePDF(" + strCodeTraitement + ")", "INNER: " + inner);
                        InsertTableLogJobPlanificateur("ImprimePDF(" + strCodeTraitement + ")", "CODE: " + soapEx.Code);
                        InsertTableLogJobPlanificateur("ImprimePDF(" + strCodeTraitement + ")", "ACTOR: " + soapEx.Actor);
                        InsertTableLogJobPlanificateur("ImprimePDF(" + strCodeTraitement + ")", msg);
                        succesLoadTable = false;
                    }
                    catch (System.Net.WebException webEx)
                    {
                        string responseText = "";
                        if (webEx.Response != null)
                        {
                            using (var reader = new StreamReader(webEx.Response.GetResponseStream()))
                            {
                                responseText = reader.ReadToEnd();
                            }
                        }

                        string msg =
                            "WEB ERROR: " + webEx.Message + "\n" +
                            "HTTP RESPONSE: " + responseText;

                        InsertTableLogJobPlanificateur("ImprimePDF(" + strCodeTraitement + ")", msg);
                        succesLoadTable = false;
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("ImprimePDF(" + strCodeTraitement + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                    }
                }


                SendMailConfirmation();

                // delete l'historique du dernier log de chargement
                try
                {
                    DeleteTableLogJobChargement();
                }
                catch (Exception exDelete)
                {
                    InsertTableLogPlanificateur("ERR", "DeleteTableLogJobChargement: " + exDelete.Message);
                }

                try
                {
                    if (mySQLConnection != null && mySQLConnection.State == ConnectionState.Open)
                    {
                        mySQLConnection.Close();
                    }
                }
                catch
                {
                    // Ignore
                }

            } 
            catch (Exception ex)
            {
                try
                {
                    InsertTableLogJobPlanificateur("PLANTAGE_FATAL", "Erreur: " + ex.Message + " | StackTrace: " + (ex.StackTrace != null ? ex.StackTrace.Substring(0, Math.Min(200, ex.StackTrace.Length)) : ""));
                }
                catch
                {
                    // Logging failure ignored - continue to send email
                }
                SendMailPlantage(ex);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }



            ////////////////////////////////////////////////////////////////////////
            ///
            //     Envois le courriel s'il y a une ou des erreurs
            ///
            ///////////////////////////////////////////////////////////////////////
            void SendMailErreurMetier(string EnvoisCourrielPar)
            {
                string newLine = Environment.NewLine;
                string strDate = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
                string EnvoisCourrielA = "alertage.etl.app@rbq.gouv.qc.ca";
                string EnvoisCourrielSuject = "⚠️ Service OGRE INT - Erreurs détectées (INT)";

                // Compter et récupérer les erreurs
                int recCount = 0;
                string listeErreurs = "";

                string SQLString = "SELECT IndSystem, CodeTraitement, TypeTraitement, ErrorMessage " +
                                   "FROM [SDDMU01].[dbo].[Log_Job_Planificateur] " +
                                   "WHERE IndSystem = 'OgreDisLot' " +
                                   "ORDER BY DateErreur DESC";

                try
                {
                    SqlCommand commandDataReader = new SqlCommand(SQLString, mySQLConnectionLog);
                    commandDataReader.CommandType = CommandType.Text;
                    SqlDataReader ValueReader = commandDataReader.ExecuteReader();

                    while (ValueReader.Read())
                    {
                        recCount++;
                        listeErreurs += recCount + ". " +
                                       ValueReader["IndSystem"].ToString() + " - " +
                                       ValueReader["CodeTraitement"].ToString() + " - " +
                                       ValueReader["TypeTraitement"].ToString() + newLine +
                                       "   " + ValueReader["ErrorMessage"].ToString() + newLine + newLine;
                    }
                    ValueReader.Close();
                }
                catch (Exception ex)
                {
                    listeErreurs = "Erreur lors de la récupération des logs : " + ex.Message;
                }

                // SECTION SIMPLE (pour centre de pilotage)
                string sectionSimple = "Bonjour," + newLine + newLine +
                                       "Le service de mise à jour OGRE INT a détecté des erreurs lors du dernier traitement." + newLine + newLine +
                                       "Date/Heure : " + strDate + newLine +
                                       "Impact : Certaines données peuvent être incomplètes dans la base Access" + newLine +
                                       "Nombre d'erreurs : " + recCount + newLine + newLine +
                                       "L'équipe informatique a été alertée et analysera la situation." + newLine + newLine +
                                       "...";

                // SECTION TECHNIQUE (pour équipe IT)
                string sectionTechnique = newLine + newLine +
                                          "---------------------------------------------------------------------" + newLine +
                                          "INFORMATIONS TECHNIQUES (pour equipe ETL)" + newLine +
                                          "---------------------------------------------------------------------" + newLine + newLine +
                                          "Package SSIS : OGRE_DIS_Lot_INT (ACCEPTATION)" + newLine +
                                          "Erreurs détectées :" + newLine + newLine +
                                          listeErreurs +
                                          "Pour investigation :" + newLine +
                                          "- Table logs : [SDDMU01].[dbo].[Log_Job_Planificateur]" + newLine +
                                          "- Filtre : IndSystem = 'OgreDisLot'" + newLine +
                                          "- Date : >= '" + strDate + "'" + newLine + newLine;

                string EnvoisCourrielCorps = sectionSimple + sectionTechnique +
                                             "Direction des technologies de l'information" + newLine +
                                             "Régie du bâtiment du Québec";

                string SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                try
                {
                    MailMessage mail = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    SmtpClient smtp = new SmtpClient(SmtpServer);
                    smtp.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    smtp.Send(mail);

                    InsertTableLogPlanificateur("Mail", "Mail erreur métier envoyé");
                }
                catch (Exception ex)
                {
                    InsertTableLogPlanificateur("ERR", "SendMailErreurMetier: " + ex.Message);
                }
            }


            // Envoie email si plantage empêche impression des fiches
            void SendMessageDelai(string EnvoisCourrielPar)
            {
                string strDate = DateTime.Now.ToString("yyyy-MM-dd");
                String strAfficheNote = "Les fiches inspecteur n’ont pas pu être imprimées en raison d’un plantage de la mise à jour de OGRE effectuée ce matin à 7h." +
                                         newLine + newLine +
                                         "Vous n’avez pas à créer un billet pour régler la situation. L’équipe informatique est déjà avisée et travaillera à régler le bogue dans les meilleurs délais.";
                String EnvoisCourrielA = "proprio.site@rbq.gouv.qc.ca"; // "proprio.site@rbq.gouv.qc.ca" "centre.de.pilotage@rbq.gouv.qc.ca"; "yves.mcduff-ext@rbq.gouv.qc.ca"
                String EnvoisCourrielSuject = "Plantage de OGRE – " + strDate;
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             strAfficheNote + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";



                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();

                String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message.ToString();
                    strMessageSql = "Fonction SendMessageDelais (SmtpClient) Erreur délai ";
                    InsertTableLogJobPlanificateur("MAIL", strMessageSql.ToString());
                }
                InsertTableLogPlanificateur("Mail", "Mail erreur délais");
            }

        } ///// FIN OGREDISLOT
