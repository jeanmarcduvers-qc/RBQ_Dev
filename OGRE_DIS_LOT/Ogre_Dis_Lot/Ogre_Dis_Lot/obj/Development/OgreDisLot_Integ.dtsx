                {

                    string sqlInsCmd = strSqlRequete.ToString();
                    EtapeDebug = "ExecuteSQL";

                    try
                    {
                        using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                        {
                            conn.Open();
                            using (var transaction = conn.BeginTransaction())
                            {
                                OleDbCommand SQLCommandExec = new OleDbCommand(sqlInsCmd.ToString(), conn, transaction);
                                SQLCommandExec.ExecuteNonQuery();
                                transaction.Commit();
                            }
                            conn.Close();
                        }
                    }
                    catch (Exception ex)
                    {

                        //MessageBox.Show(ex2.Message);
                        InsertTableLogJobPlanificateur("ExecuteSQL(" + strCodeTraitement + ")", strSqlRequete.ToString());
                        InsertTableLogJobPlanificateur("ExecuteSQL(" + strCodeTraitement + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                    }
                }

                //////////////////////////////////////////////////////////////////////
                ///
                //     Mise à jour de la table ORGRE_RegionIntervention
                ///
                /////////////////////////////////////////////////////////////////////
                void majORGRE_RegionIntervention()
                {
                    string sqlCmdDelete = "DELETE [SDDMU01].[dbo].[ORGRE_RegionIntervention]";
                    string sqlCmdSelect = "SELECT tbl_Region.[NoRégion], " +
                                                 "tbl_Region.[Région], " +
                                                 "tbl_RegionIntervention.Domaine, " +
                                                 "tbl_RegionIntervention.Minimum, " +
                                                 "tbl_RegionIntervention.Maximum, " +
                                                 "tbl_RegionIntervention.Nbr_Inspection, " +
                                                 "tbl_RegionIntervention.Priorite " +
                                                 "FROM tbl_Region " +
                                                       "INNER JOIN tbl_RegionIntervention ON tbl_Region.[NoRégion] = tbl_RegionIntervention.[Région]";

                    string Etape = "";
                    EtapeDebug = "majORGRE_RegionIntervention";

                    SqlConnection mySQLConnectionMaj =
                    Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                    as SqlConnection;

                    Etape = "Delete ORGRE_RegionIntervention";
                    try
                    {
                        SqlCommand CmdDel = new SqlCommand(sqlCmdDelete.ToString(), mySQLConnectionMaj);
                        CmdDel.CommandType = CommandType.Text;
                        SqlDataReader readerDel = CmdDel.ExecuteReader();
                        readerDel.Read();
                        readerDel.Close();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("majORGRE_RegionIntervention(" + Etape + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                    }

                    Etape = "Select Intervention";
                    try
                    {
                        using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                        {
                            conn.Open();
                            OleDbCommand cmdBulkCopy = new OleDbCommand(sqlCmdSelect, conn);
                            using (var bulkCopy = new SqlBulkCopy(mySQLConnectionMaj))
                            {
