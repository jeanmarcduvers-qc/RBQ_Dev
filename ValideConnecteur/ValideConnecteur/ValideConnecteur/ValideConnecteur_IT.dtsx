         *  object rawConnection = Dts.Connections["Prices.zip"].AcquireConnection(Dts.Transaction);
         *  string filePath = (string)rawConnection;
         *  //Use the connection in some code here, then release the connection
         *  Dts.Connections["Prices.zip"].ReleaseConnection(rawConnection);
         * */
        #endregion

        public const string tblogChargement = "SELECT count(1) nbRecord " +
                                              "FROM   [SDDMU01].[dbo].[Log_Chargement] " +
                                              "WHERE  DATEADD(DAY,1, [DateChargement]) > GETDATE() " +
                                              "AND exists(SELECT 1 " +
                                              "           FROM[SDDMU01].[dbo].[Log_Chargement] " +
                                              "           WHERE [NomTable] = 'Log_Chargement') ";

        public const string tblAfficheErreur = "SELECT [NomTable] + ' (' + [IndSystem] + ')' as 'NomTable' " + 
                                               "FROM   [SDDMU01].[dbo].[Log_Chargement] log " +
                                               "WHERE  DATEADD(DAY,1, [DateChargement]) > GETDATE() " +
                                               "AND    not exists(SELECT 1 " +
                                               "                  FROM   sys.tables tab " +
                                               "                  WHERE  tab.name = log.NomTable) " +
                                               "ORDER BY [NomTable] ";

        public string newLine = Environment.NewLine;

        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        public void Main()
        {
            // TODO: Add your code here
            TraiteTableConnecteur();
            Dts.TaskResult = (int)ScriptResults.Success;
        }

        public void TraiteTableConnecteur()
        {
            String date = DateTime.Now.ToString("yyyy-MM-dd hh:mm:ss");
            String EnvoyePar = Dts.Variables["User::EnvoyePar"].Value.ToString();

            SqlConnection myValideConnecteur =
                Dts.Connections["ConnectBD_ValideConnecteur"].AcquireConnection(Dts.Transaction)
                as SqlConnection;

            using (SqlDataAdapter dataAdapter = new SqlDataAdapter(tblogChargement.ToString(), myValideConnecteur))
            {
                try
                {
                    // Cr�ation du DataSet 
                    DataSet dataSetValideConnecteur = new DataSet();
                    dataAdapter.SelectCommand.CommandTimeout = 180;
                    dataAdapter.Fill(dataSetValideConnecteur, "Connecteur");

                    foreach (DataRow pRowValideConnecteur in dataSetValideConnecteur.Tables["Connecteur"].Rows)
                    {
                        if ((pRowValideConnecteur["nbRecord"].ToString() == "0"))
                        {
                            // Envoyer le courriel
                            SendMailMessage(EnvoyePar, "TableAbsente");
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message.ToString());
                    SendMailMessage(EnvoyePar, "ErreurExecution");
                }
            }

            myValideConnecteur.Close();
            Dts.TaskResult = (int)ScriptResults.Success;
        }

        void SendMailMessage(string EnvoisCourrielPar, string TypeErreur)
        {
            string strMessageSql = "";
            String strAfficheErreur = "";
            String SQLString = tblAfficheErreur;
            String EnvoisCourrielA = "yves.mcduff-ext@rbq.gouv.qc.ca";
            String EnvoisCourrielCC = "";
            String EnvoisCourrielSuject = "Le connecteur n'a pas fonctionné correctement";
            String EnvoisCourrielCorps = "Bonjour," + newLine + newLine + "« " +
                                         EnvoisCourrielSuject + " » a une ou plusieurs erreurs possibles." + newLine + newLine;
            String EnvoisCourrielPiedCorps = "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine +
                                             "..." + newLine +
                                             "Pour toutes questions, veuillez communiquer avec la Boîte Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                             "Direction des technologies de l'information" + newLine +
                                             "Régie du bâtiment du Québec";

            SqlConnection myValideErreur = Dts.Connections["ConnectBD_ValideConnecteur"].AcquireConnection(Dts.Transaction) as SqlConnection;

            if (TypeErreur.Equals("ErreurExecution"))
            {
                strAfficheErreur = "          La table Log_Chargement n'est pas présente dans Info de Gestion, impossible de valider le chargement." + newLine;
            }
            else
            {
                using (SqlDataAdapter dataAdapterAfficheErreur = new SqlDataAdapter(SQLString.ToString(), myValideErreur))
                {
                    // create the DataSet 
                    try
                    {
                        DataSet dataSetAfficheErreur = new DataSet();
                        dataAdapterAfficheErreur.SelectCommand.CommandTimeout = 180;
                        dataAdapterAfficheErreur.Fill(dataSetAfficheErreur, "AfficheErreur");

                        foreach (DataRow pRowRegleAfficheErreur in dataSetAfficheErreur.Tables["AfficheErreur"].Rows)
                        {

                            strAfficheErreur = strAfficheErreur.ToString() + newLine + "          " + pRowRegleAfficheErreur["NomTable"].ToString();

                        }
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message.ToString());
                        strMessageSql = "Fonction SendMailMessage - SMTP Erreur :: " + ex.Message.ToString();
                    }
                }
            }

            EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + strAfficheErreur.ToString() + newLine + newLine + EnvoisCourrielPiedCorps.ToString();

            String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

            try
            {


                // Création du courriel et changement du format en HTML
                MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);
                if (EnvoisCourrielCC.ToString() != "")
                {
                    FormatCourrielHtml.CC.Add(EnvoisCourrielCC.ToString());
                }

                // Créer le SMTP client et envois le courriel
                SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                monSmtpClient.Send(FormatCourrielHtml);
            }
            catch (Exception ex)
            {
                //MessageBox.Show(ex.Message.ToString());
                strMessageSql = "Fonction SendMailMessage - SMTP Erreur :: " + ex.Message.ToString();
            }
        }

        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
