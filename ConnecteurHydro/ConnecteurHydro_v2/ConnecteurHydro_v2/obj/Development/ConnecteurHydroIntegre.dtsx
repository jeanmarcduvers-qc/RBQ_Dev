            }
            if (StructureHydro.strNomSup.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strNomSup: {StructureHydro.strNomSup.Count} vs {count}", "", 0);
                return false;
            }
            if (StructureHydro.strCodRegRes.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
