#endregion

namespace ST_HydroIntegration_SQL
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        public class Structure_Hydro
        {
            private List<String> NoRECQ;
            private List<String> NoForm;
            private List<String> NoDem;
            private List<String> DatePer;
            private List<String> NoCiv;
            private List<String> Rue;
            private List<String> Orient;
            private List<String> Appart;
            private List<String> Munic;
            private List<String> CP;
            private List<String> GenTrav;
            private List<String> DescClasRev;
            private List<String> ModChauf;
            private List<int> PrinAmp;
            private List<String> PrinVolt;
            private List<int> NbInt1;
            private List<int> Amp1;
            private List<string> Volt1;
            private List<int> NbInt2;
            private List<int> Amp2;
            private List<string> Volt2;
            private List<string> Client;
            private List<string> NomSup;
            private List<string> CodRegRes;
            private List<string> TelRes;
            private List<string> CodRegTrav;
            private List<string> TelTrav;
            private List<string> PostTelTrav;
            private List<string> DateDebutTrav;
            private List<string> DateFinTrav;
            private List<string> NbEtage;
            private List<string> Genre;
            private List<string> DateInsert;
            private List<string> Source;

            public Structure_Hydro()
            {
                strNoRECQ = new List<string>();
                strNoForm = new List<string>();
                strNoDem = new List<string>();
                strDatePer = new List<string>();
                strNoCiv = new List<string>();
                strRue = new List<string>();
                strOrient = new List<string>();
                strAppart = new List<string>();
                strMunic = new List<string>();
                strCP = new List<string>();
                strGenTrav = new List<string>();
                strDescClasRev = new List<string>();
                strModChauf = new List<string>();
                strPrinVolt = new List<string>();
                strVolt1 = new List<string>();
                strVolt2 = new List<string>();
                strClient = new List<string>();
                strNomSup = new List<string>();
                strCodRegRes = new List<string>();
                strTelRes = new List<string>();
                strCodRegTrav = new List<string>();
                strTelTrav = new List<string>();
                strPostTelTrav = new List<string>();
                strDateDebutTrav = new List<string>();
                strDateFinTrav = new List<string>();
                strNbEtage = new List<string>();
                strGenre = new List<string>();
                strDateInsert = new List<string>();
                strSource = new List<string>();

                intPrinAmp = new List<int>();
                intNbInt1 = new List<int>();
                intAmp1 = new List<int>();
                intNbInt2 = new List<int>();
                intAmp2 = new List<int>();
            }

            public List<String> strNoRECQ { get { return NoRECQ; } set { NoRECQ = value; } }
            public List<String> strNoForm { get { return NoForm; } set { NoForm = value; } }
            public List<String> strNoDem { get { return NoDem; } set { NoDem = value; } }
            public List<String> strDatePer { get { return DatePer; } set { DatePer = value; } }
            public List<String> strNoCiv { get { return NoCiv; } set { NoCiv = value; } }
            public List<String> strRue { get { return Rue; } set { Rue = value; } }
            public List<String> strOrient { get { return Orient; } set { Orient = value; } }
            public List<String> strAppart { get { return Appart; } set { Appart = value; } }
            public List<String> strMunic { get { return Munic; } set { Munic = value; } }
            public List<String> strCP { get { return CP; } set { CP = value; } }
            public List<String> strGenTrav { get { return GenTrav; } set { GenTrav = value; } }
            public List<String> strDescClasRev { get { return DescClasRev; } set { DescClasRev = value; } }
            public List<String> strModChauf { get { return ModChauf; } set { ModChauf = value; } }
            public List<int> intPrinAmp { get { return PrinAmp; } set { PrinAmp = value; } }
            public List<String> strPrinVolt { get { return PrinVolt; } set { PrinVolt = value; } }
            public List<int> intNbInt1 { get { return NbInt1; } set { NbInt1 = value; } }
            public List<int> intAmp1 { get { return Amp1; } set { Amp1 = value; } }
            public List<string> strVolt1 { get { return Volt1; } set { Volt1 = value; } }
            public List<int> intNbInt2 { get { return NbInt2; } set { NbInt2 = value; } }
            public List<int> intAmp2 { get { return Amp2; } set { Amp2 = value; } }
            public List<string> strVolt2 { get { return Volt2; } set { Volt2 = value; } }
            public List<string> strClient { get { return Client; } set { Client = value; } }
            public List<string> strNomSup { get { return NomSup; } set { NomSup = value; } }
            public List<string> strCodRegRes { get { return CodRegRes; } set { CodRegRes = value; } }
            public List<string> strTelRes { get { return TelRes; } set { TelRes = value; } }
            public List<string> strCodRegTrav { get { return CodRegTrav; } set { CodRegTrav = value; } }
            public List<string> strTelTrav { get { return TelTrav; } set { TelTrav = value; } }
            public List<string> strPostTelTrav { get { return PostTelTrav; } set { PostTelTrav = value; } }
            public List<string> strDateDebutTrav { get { return DateDebutTrav; } set { DateDebutTrav = value; } }
            public List<string> strDateFinTrav { get { return DateFinTrav; } set { DateFinTrav = value; } }
            public List<string> strNbEtage { get { return NbEtage; } set { NbEtage = value; } }
            public List<string> strGenre { get { return Genre; } set { Genre = value; } }
            public List<string> strDateInsert { get { return DateInsert; } set { DateInsert = value; } }
