        }

        // Variables globales
        SqlConnection mySQLConnection;
        String tblLogChargement = "";
        OleDbConnection connectionAccess;  // ⭐ AJOUTER CETTE LIGNE
        String tblLogJob = "";
        String tblAfficheErreur = "";


        public void Main()
        {
            bool fireAgain = true;
            bool blErreurExecution = false;
            SqlConnection mySQLConnection = null;
            OleDbConnection connectionAccess = null;

            try
            {
                Dts.Events.FireInformation(0, "HydroIntegration", "=== SCRIPT DÉMARRÉ ===", "", 0, ref fireAgain);

                // Variables
                string strRepertoireIn = Dts.Variables["User::RepertoireIn"].Value.ToString();
                string strRepertoireArchive = Dts.Variables["User::RepertoireArchive"].Value.ToString();
                string strConnectionSQL = Dts.Variables["User::ServerName"].Value.ToString();  
                string strConnectionAccess = Dts.Variables["User::ConnectStringAccess"].Value.ToString();  

                // Connexion SQL
                Dts.Events.FireInformation(0, "HydroIntegration", "Tentative de connexion SQL...", "", 0, ref fireAgain);
                Dts.Events.FireInformation(0, "HydroIntegration", $"Connection string: {strConnectionSQL}", "", 0, ref fireAgain);

                mySQLConnection = new SqlConnection(strConnectionSQL);
                mySQLConnection.Open();
                Dts.Events.FireInformation(0, "HydroIntegration", "=== CONNEXION SQL RÉUSSIE ===", "", 0, ref fireAgain);

                // Connexion Access
                Dts.Events.FireInformation(0, "HydroIntegration", "Connexion à Access...", "", 0, ref fireAgain);
                Dts.Events.FireInformation(0, "HydroIntegration", $"Access connection string: {strConnectionAccess}", "", 0, ref fireAgain);

                connectionAccess = new OleDbConnection(strConnectionAccess);
                connectionAccess.Open();
                Dts.Events.FireInformation(0, "HydroIntegration", "=== CONNEXION ACCESS RÉUSSIE ===", "", 0, ref fireAgain);

                // Supprimer anciens logs
                Dts.Events.FireInformation(0, "HydroIntegration", "Suppression anciens logs...", "", 0, ref fireAgain);
                DeleteTableLogJobChargement(mySQLConnection);
                Dts.Events.FireInformation(0, "HydroIntegration", "Logs supprimés avec succès", "", 0, ref fireAgain);

                // VIDER LA TABLE Log_Job_Connecteur
                Dts.Events.FireInformation(0, "HydroIntegration", "Suppression table Log_Job_Connecteur...", "", 0, ref fireAgain);
                DeleteTableLogJobConnecteur(mySQLConnection);

                // Insertion premier log
                Dts.Events.FireInformation(0, "HydroIntegration", "Insertion premier log...", "", 0, ref fireAgain);
                InsertTableLogChargement(mySQLConnection,"TraiteHydro", "Début du traitement");
                Dts.Events.FireInformation(0, "HydroIntegration", "Premier log inséré avec succès", "", 0, ref fireAgain);

                // Initialisation structure
                Dts.Events.FireInformation(0, "HydroIntegration", "Initialisation de la structure...", "", 0, ref fireAgain);
                Structure_Hydro StructureHydro = new Structure_Hydro();
                string dtExecution = "";
                string strAnneeExecution = "";
                Dts.Events.FireInformation(0, "HydroIntegration", "Structure initialisée", "", 0, ref fireAgain);

                // Vérifier répertoire
                if (Directory.Exists(strRepertoireIn))
                {
                    Dts.Events.FireInformation(0, "HydroIntegration", "Répertoire trouvé: " + strRepertoireIn, "", 0, ref fireAgain);

                    // ⭐ DÉZIPPER SHERBROOKE
                    UnzipSherbrookeFiles(strRepertoireIn, ref fireAgain);

                    // ⭐ TRAITER QUEBEC (Transmission_Hydro-Quebec_*.dat) file name convention --nommage
                    FileInfo[] fiQue = new DirectoryInfo(strRepertoireIn).GetFiles("Transmission_Hydro-Quebec_*.dat", SearchOption.TopDirectoryOnly);
                    Dts.Events.FireInformation(0, "HydroIntegration", $"Fichiers Quebec trouvés: {fiQue.Length}", "", 0, ref fireAgain);

                    foreach (FileInfo fi in fiQue)
                    {
                        Dts.Events.FireInformation(0, "HydroIntegration", $"Traitement fichier: {fi.Name}", "", 0, ref fireAgain);

                        string[] plineQue = File.ReadAllLines(fi.FullName);
                        Dts.Events.FireInformation(0, "HydroIntegration", $"Fichier {fi.Name}: {plineQue.Length} lignes lues", "", 0, ref fireAgain);

                        LoadFichier(plineQue, "Quebec", ref StructureHydro, ref dtExecution, ref strAnneeExecution, ref blErreurExecution);

                        // Archiver si succès
                        if (!blErreurExecution)
                        {
                            ArchiveFile(fi.FullName, strRepertoireArchive, "Hydro Quebec", strAnneeExecution, ref fireAgain);
                        }
                    }

                    // ⭐ TRAITER SHERBROOKE (hs*.zip) (hs_*.dat) file name convention --nommage
                    FileInfo[] fiSheZip = new DirectoryInfo(strRepertoireIn).GetFiles("hs*.zip", SearchOption.TopDirectoryOnly);
                    Dts.Events.FireInformation(0, "HydroIntegration", $"Fichiers Sherbrooke trouvés: {fiSheZip.Length}", "", 0, ref fireAgain);

                    foreach (FileInfo zipFile in fiSheZip)
                    {
                        string baseFileName = Path.GetFileNameWithoutExtension(zipFile.Name); // HS251205

                        // ⭐ CHERCHER SANS EXTENSION D'ABORD
                        string datFilePath = Path.Combine(strRepertoireIn, baseFileName);

                        // ⭐ SI PAS TROUVÉ, CHERCHER AVEC .dat
                        if (!File.Exists(datFilePath))
                        {
                            datFilePath = Path.Combine(strRepertoireIn, baseFileName + ".dat");
                        }

                        if (File.Exists(datFilePath))
                        {
                            string[] plineShe = File.ReadAllLines(datFilePath);

                            LoadFichier(plineShe, "Sherbrooke", ref StructureHydro, ref dtExecution, ref strAnneeExecution, ref blErreurExecution);

                            if (!blErreurExecution)
                            {
                                ArchiveFile(zipFile.FullName, strRepertoireArchive, "Hydro Sherbrooke", strAnneeExecution, ref fireAgain);
                                File.Delete(datFilePath); // Supprime quel que soit l'extension
                            }
                        }
                    }

                    // Log résultats
                    int totalEnregistrements = StructureHydro.strNoRECQ.Count;
                    Dts.Events.FireInformation(0, "HydroIntegration", $"=== TOTAL ENREGISTREMENTS PARSÉS: {totalEnregistrements} ===", "", 0, ref fireAgain);

                    // Validation
                    Dts.Events.FireInformation(0, "HydroIntegration", "Validation de la structure des données...", "", 0, ref fireAgain);
                    bool structureValide = ValidateStructure(StructureHydro, ref fireAgain);

                    if (!structureValide)
                    {
                        Dts.Events.FireError(0, "HydroIntegration", "ERREUR: Structure de données invalide!", "", 0);
                        InsertTableLogJob("Main()", "Structure invalide");
                        Dts.TaskResult = (int)Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure;
                        return;
                    }

                    Dts.Events.FireInformation(0, "HydroIntegration", "Structure validée avec succès!", "", 0, ref fireAgain);

                    // Insertion Access
                    if (totalEnregistrements > 0)
                    {
                        Dts.Events.FireInformation(0, "HydroIntegration", "Début insertion dans Access...", "", 0, ref fireAgain);
                        InsertTableLogChargement(mySQLConnection, "TraiteHydro", $"Début insertion: {totalEnregistrements} enregistrements");

                        InsertBD(connectionAccess, StructureHydro, ref blErreurExecution);

                        if (blErreurExecution)
                        {
                            SendErrorEmail("Des erreurs d'insertion se sont produites. Consultez Log_Job_Connecteur pour les détails.", ref fireAgain);
                            Dts.Events.FireWarning(0, "HydroIntegration",
                                $"=== INSERTION ACCESS TERMINÉE AVEC ERREURS: {totalEnregistrements} tentatives - Consultez Log_Job_Connecteur ===", "", 0);
                        }
                        else
                        {
                            Dts.Events.FireInformation(0, "HydroIntegration",
                                $"=== INSERTION ACCESS TERMINÉE AVEC SUCCÈS: {totalEnregistrements} enregistrements ===", "", 0, ref fireAgain);
                        }

                        InsertTableLogChargement(mySQLConnection, "TraiteHydro", "Insertion terminée");
                    }
                    else
                    {
                        Dts.Events.FireWarning(0, "HydroIntegration", "Aucun enregistrement à insérer", "", 0);
                    }

                    InsertTableLogChargement(mySQLConnection,"TraiteHydro", "Fin du traitement");
                }

                Dts.Events.FireInformation(0, "HydroIntegration", "=== SCRIPT TERMINÉ AVEC SUCCÈS ===", "", 0, ref fireAgain);
                Dts.TaskResult = (int)Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success;
            }
            catch (Exception ex)
            {
                blErreurExecution = true;
                InsertTableLogJob("Main()", ex.Message.ToString());
                Dts.Events.FireError(0, "HydroIntegration", $"ERREUR FATALE: {ex.Message}", "", 0);

                // ⭐ ENVOYER EMAIL D'ERREUR
                SendErrorEmail(ex.Message, ref fireAgain);

                Dts.TaskResult = (int)Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure;
            }
            finally
            {
                if (mySQLConnection != null && mySQLConnection.State == ConnectionState.Open)
                {
                    mySQLConnection.Close();
                    Dts.Events.FireInformation(0, "HydroIntegration", "Connexion SQL fermée", "", 0, ref fireAgain);
                }

                if (connectionAccess != null && connectionAccess.State == ConnectionState.Open)
                {
                    connectionAccess.Close();
                    Dts.Events.FireInformation(0, "HydroIntegration", "Connexion Access fermée", "", 0, ref fireAgain);
                }
            }
        }


        void LoadFichier(string[] pline, string psource, ref Structure_Hydro StructureHydro,
            ref string dtExecution, ref string strAnneeExecution, ref bool blErreurExecution)
        {
            bool fireAgain = true;
            int intVariable = 0;

            // ⭐ LIRE TOUT LE CONTENU EN UNE SEULE STRING
            string allContent = string.Join("", pline);

            Dts.Events.FireInformation(0, "HydroIntegration",
                $"Contenu total: {allContent.Length} caractères", "", 0, ref fireAgain);

            // ⭐ EXTRAIRE LA DATE (8 premiers caractères)
            if (allContent.Length < 8)
            {
                blErreurExecution = true;
                InsertTableLogJob("LoadFichier()", "Fichier trop court, pas de date");
                return;
            }

            dtExecution = allContent.Substring(0, 8).Trim();
            strAnneeExecution = allContent.Substring(0, 4).Trim();

            Dts.Events.FireInformation(0, "HydroIntegration",
                $"Date extraction: {dtExecution}", "", 0, ref fireAgain);

            // ⭐ LE RESTE = DONNÉES (commence à la position 8)
            string dataContent = allContent.Substring(8);

            Dts.Events.FireInformation(0, "HydroIntegration",
                $"Données disponibles: {dataContent.Length} caractères", "", 0, ref fireAgain);

            // ⭐ CHAQUE ENREGISTREMENT FAIT 288 CARACTÈRES
            int recordLength = 287;
            int numRecords = dataContent.Length / recordLength;

            Dts.Events.FireInformation(0, "HydroIntegration",
                $"Nombre d'enregistrements détectés: {numRecords}", "", 0, ref fireAgain);

            // ⭐ PARSER CHAQUE ENREGISTREMENT
            for (int recNum = 0; recNum < numRecords; recNum++)
            {
                int startPos = recNum * recordLength;

                if (startPos + recordLength > dataContent.Length)
                {
                    Dts.Events.FireWarning(0, "HydroIntegration",
                        $"Enregistrement {recNum + 1} incomplet, ignoré", "", 0);
                    break;
                }

                string line = dataContent.Substring(startPos, recordLength);

                Dts.Events.FireInformation(0, "HydroIntegration",
                    $"Parsing enregistrement {recNum + 1}...", "", 0, ref fireAgain);


                try
                {
                    int tempNbInt1 = 0;
                    int tempNbInt2 = 0;
                    int tempPrinAmp = 0;
                    int tempAmp1 = 0;
                    int tempAmp2 = 0;

                    // Parser TOUTES les valeurs
                    string tempNoRECQ = line.Substring(0, 8).Trim();       // Pos 0-7
                    string tempNoForm = line.Substring(8, 9).Trim();       // Pos 8-16
                    string tempNoDem = line.Substring(17, 9).Trim();       // Pos 17-25
                    string tempDatePer = line.Substring(26, 8).Trim();     // Pos 26-33
                    string tempNoCiv = line.Substring(34, 6).Trim();       // Pos 34-39
                    string tempRue = line.Substring(40, 18).Trim();        // Pos 40-57
                    string tempOrient = line.Substring(58, 1).Trim();      // Pos 58
                    string tempAppart = line.Substring(59, 4).Trim();      // Pos 59-62
                    string tempMunic = line.Substring(63, 23).Trim();      // Pos 63-85
                    string tempCP = line.Substring(86, 6).Trim();          // Pos 86-91
                    string tempGenTrav = line.Substring(92, 31).Trim();    // Pos 92-122
                    string tempDescClasRev = line.Substring(123, 18).Trim(); // Pos 123-140
                    string tempModChauf = line.Substring(141, 20).Trim();  // Pos 141-160

                    if (int.TryParse(line.Substring(161, 4), out intVariable))
                        tempPrinAmp = intVariable;
                    else
                        tempPrinAmp = 0;

                    string tempPrinVolt = line.Substring(165, 7).Trim();

                    if (int.TryParse(line.Substring(172, 3), out intVariable))
                        tempNbInt1 = intVariable;
                    else
                        tempNbInt1 = 0;

                    if (int.TryParse(line.Substring(175, 3), out intVariable))
                        tempAmp1 = intVariable;
                    else
                        tempAmp1 = 0;

                    string tempVolt1 = line.Substring(178, 7).Trim();

                    if (int.TryParse(line.Substring(185, 3), out intVariable))
                        tempNbInt2 = intVariable;
                    else
                        tempNbInt2 = 0;

                    if (int.TryParse(line.Substring(188, 3), out intVariable))
                        tempAmp2 = intVariable;
                    else
                        tempAmp2 = 0;

                    string tempVolt2 = line.Substring(191, 7).Trim();
                    string tempClient = line.Substring(198, 23).Trim().Replace("'", "''");
                    string tempNomSup = line.Substring(221, 23).Trim();
                    string tempCodRegRes = line.Substring(244, 3).Trim();
                    string tempTelRes = line.Substring(247, 7).Trim();
                    string tempCodRegTrav = line.Substring(254, 3).Trim();
                    string tempTelTrav = line.Substring(257, 7).Trim();
                    string tempPostTelTrav = line.Substring(264, 4).Trim();
                    string tempDateDebutTrav = line.Substring(268, 8).Trim();
                    string tempDateFinTrav = line.Substring(276, 8).Trim();
                    string tempNbEtage = line.Substring(284, 3).Trim();

                    // Calcul du genre
                    string tempGenre = ValideBatiment(
                        tempDescClasRev.ToLower(),
                        tempPrinVolt,
                        tempNbInt1,
                        tempNbInt2
                    );

                    // ⭐ VÉRIFIEZ SI STRUCTURE EST NULL
                    if (StructureHydro == null)
                    {
                        Dts.Events.FireError(0, "HydroIntegration",
                            "ERREUR: StructureHydro est null!", "", 0);
                        return;
                    }

                    // ⭐ AJOUTER À LA STRUCTURE
                    StructureHydro.strNoRECQ.Add(tempNoRECQ);
                    StructureHydro.strNoForm.Add(tempNoForm);
                    StructureHydro.strNoDem.Add(tempNoDem);
                    StructureHydro.strDatePer.Add(tempDatePer);
                    StructureHydro.strNoCiv.Add(tempNoCiv);
                    StructureHydro.strRue.Add(tempRue);
                    StructureHydro.strOrient.Add(tempOrient);
                    StructureHydro.strAppart.Add(tempAppart);
                    StructureHydro.strMunic.Add(tempMunic);
                    StructureHydro.strCP.Add(tempCP);
                    StructureHydro.strGenTrav.Add(tempGenTrav);
                    StructureHydro.strDescClasRev.Add(tempDescClasRev);
                    StructureHydro.strModChauf.Add(tempModChauf);
                    StructureHydro.intPrinAmp.Add(tempPrinAmp);
                    StructureHydro.strPrinVolt.Add(tempPrinVolt);
                    StructureHydro.intNbInt1.Add(tempNbInt1);
                    StructureHydro.intAmp1.Add(tempAmp1);
                    StructureHydro.strVolt1.Add(tempVolt1);
                    StructureHydro.intNbInt2.Add(tempNbInt2);
                    StructureHydro.intAmp2.Add(tempAmp2);
                    StructureHydro.strVolt2.Add(tempVolt2);
                    StructureHydro.strClient.Add(tempClient);
                    StructureHydro.strNomSup.Add(tempNomSup);
                    StructureHydro.strCodRegRes.Add(tempCodRegRes.Replace("\0", ""));
                    StructureHydro.strTelRes.Add(tempTelRes.Replace("\0", ""));
                    StructureHydro.strCodRegTrav.Add(tempCodRegTrav.Replace("\0", ""));
                    StructureHydro.strTelTrav.Add(tempTelTrav.Replace("\0", ""));
                    StructureHydro.strPostTelTrav.Add(tempPostTelTrav.Replace("\0", ""));
                    StructureHydro.strDateDebutTrav.Add(tempDateDebutTrav);
                    StructureHydro.strDateFinTrav.Add(tempDateFinTrav);
                    StructureHydro.strNbEtage.Add(tempNbEtage);
                    StructureHydro.strGenre.Add(tempGenre);
                    StructureHydro.strDateInsert.Add(dtExecution);
                    StructureHydro.strSource.Add(psource);

                    Dts.Events.FireInformation(0, "HydroIntegration",
                        $"Enregistrement {recNum + 1} parsé: NoRECQ={tempNoRECQ}", "", 0, ref fireAgain);
                }
                catch (Exception ex)
                {
                    blErreurExecution = true;
                    // ⭐ LOG DÉTAILLÉ
                    InsertTableLogJob($"LoadFichier() - Enregistrement {recNum + 1}",
                        $"Erreur: {ex.Message} | StackTrace: {ex.StackTrace}");
                    Dts.Events.FireError(0, "HydroIntegration",
                        $"ERREUR parsing ligne {recNum + 1}: {ex.Message}", "", 0);
                }
            }
        }

        string ValideBatiment(string pDescClasRev, string pPrinVolt, int pNbInt1, int pNbInt2)
        {
            string strGenre = "";

            if (pDescClasRev == "res. mes. unique" && pPrinVolt == "120/240")
                strGenre = "C1";
            else if (pDescClasRev == "res. mes. unique" && pPrinVolt != "120/240")
                strGenre = "C3";
            else if (pDescClasRev == "res. mes. multiple" && pPrinVolt != "120/240")
                strGenre = "C3";
            else if (pDescClasRev == "res. mes. multiple" && pPrinVolt == "120/240" && pNbInt1 < 13 && pNbInt2 < 13)
                strGenre = "C2";
            else if (pDescClasRev == "res. mes. multiple")
                strGenre = "C3";
            else if (pDescClasRev == "ferme" || pDescClasRev == "temporaire" || pDescClasRev == "autre")
                strGenre = "G";
            else if (pDescClasRev == "commercial")
                strGenre = "E";
            else if (pDescClasRev == "industriel")
                strGenre = "F";
            else
                strGenre = "E";

            return strGenre;
        }

        void InsertTableLogChargement(SqlConnection connection, string strIndSystem, string strSqlTable)
        {
            try
            {
                string sqlInsCmd = "INSERT INTO [SDDMU01].[dbo].[Log_Chargement_Connecteur] " +
                            "(Application, IndSystem, NomTable, DateChargement, UserCode, UserName) " +
                            "VALUES ('TraiteHydro', '" + strIndSystem + "', '" + strSqlTable + "', " +
                            "GETDATE(), 'Auto01', SYSTEM_USER)";
                SqlCommand SQLCommandLog = new SqlCommand(sqlInsCmd, connection);  // ⭐ CHANGÉ
                SQLCommandLog.ExecuteNonQuery();
            }
            catch (Exception ex)
            {
                // Ne pas bloquer si erreur de log
            }
        }

        void DeleteTableLogJobChargement(SqlConnection connection)
        {
            try
            {
                string strSqlDeleteLog = "DELETE FROM Log_Chargement_Connecteur " +
                                        "WHERE Application = 'TraiteHydro' ";
                                        //"AND DATEDIFF(day, DateChargement, GETDATE()) > 30";

                SqlCommand cmd = new SqlCommand(strSqlDeleteLog, connection);  // ⭐ CHANGÉ
                int rowsDeleted = cmd.ExecuteNonQuery();

                bool fireAgain = true;
                Dts.Events.FireInformation(0, "HydroIntegration",
                    $"{rowsDeleted} anciens logs supprimés (>30 jours)", "", 0, ref fireAgain);
            }
            catch (Exception ex)
            {
                Dts.Events.FireWarning(0, "HydroIntegration",
                    $"Erreur suppression logs: {ex.Message}", "", 0);
            }
        }


        void DeleteTableLogJobConnecteur(SqlConnection connection)
        {
            try
            {
                string strSqlDeleteLog = "DELETE FROM [SDDMU01].[dbo].[Log_Job_Connecteur] " +
                                        "WHERE Application = 'TraiteHydro'";

