            {
                Dts.Events.FireWarning(0, "HydroIntegration",
                    $"Erreur suppression Log_Job_Connecteur: {ex.Message}", "", 0);
            }
        }



        void InsertTableLogJob(string pFonction, string pErreurMessage)
        {
            try
            {
                if (pErreurMessage.Length > 250)
                    pErreurMessage = pErreurMessage.Substring(0, 245) + "...";
                pErreurMessage = pErreurMessage.Replace("'", "''");
                pFonction = pFonction.Replace("'", "''");

                string strConnectionSQL = Dts.Variables["User::ServerName"].Value.ToString(); 
                using (SqlConnection connection = new SqlConnection(strConnectionSQL))
                {
                    connection.Open();

                    string sqlInsCmd = "INSERT INTO [SDDMU01].[dbo].[Log_Job_Connecteur] " +
                                       "(Application, IndSystem, NomTable, JobName, ActionType, ErrorMessage, UserCode, DateErreur) " +
                                       "VALUES ('TraiteHydro', 'Hydro', NULL, '" + pFonction + "', " +
                                       "'Erreur', '" + pErreurMessage + "', 'Auto01', GETDATE())";

                    SqlCommand SQLCommandJob = new SqlCommand(sqlInsCmd, connection);
                    SQLCommandJob.ExecuteNonQuery();
                }
            }
            catch (Exception ex)
            {
                Dts.Events.FireWarning(0, "HydroIntegration",
                    $"Erreur log job: {ex.Message}", "", 0);
            }
        }

        void InsertBD(OleDbConnection connectionAccess, Structure_Hydro StructureHydro, ref bool blErreurExecution)
        {
            bool fireAgain = true;
            string strEnteSql = "INSERT INTO tblHydro (" +
                                "NoRECQ, NoForm, NoDem, DatePer, NoCiv, Rue, Orient, Appart, " +
                                "Munic, CP, GenTrav, DescClasRev, ModChauf, IntPrinAmp, IntPrinVolt, " +
                                "NbsInt1, sIntAmp1, sIntVolt1, NbsInt2, sIntAmp2, sIntVolt2, Client, NomSup, " +
                                "CodRegRes, TelRes, CodRegTrav, TelTrav, PostTelTrav, Genre, DateInsert, Source, " +
                                "DateDebutTrav, DateFinTrav, NbEtage) " +
                                "VALUES ('";

            for (int rowNum = 0; rowNum <= StructureHydro.strNoRECQ.Count - 1; rowNum++)
            {
                try
                {
                    // ⭐ NOUVELLE SECTION: VÉRIFIER SI L'ENREGISTREMENT EXISTE DÉJÀ
       
                    string sqlCheck = "SELECT COUNT(*) FROM tblHydro WHERE " +
                                     "NoRECQ = '" + TruncateField(StructureHydro.strNoRECQ[rowNum].ToString(), 8, "NoRECQ") + "' AND " +
                                     "NoForm = '" + TruncateField(StructureHydro.strNoForm[rowNum].ToString(), 9, "NoForm") + "' AND " +
                                     "NoDem = '" + TruncateField(StructureHydro.strNoDem[rowNum].ToString(), 9, "NoDem") + "' AND " +
                                     "DatePer = '" + TruncateField(StructureHydro.strDatePer[rowNum].ToString(), 8, "DatePer") + "'";

                    OleDbCommand cmdCheck = new OleDbCommand(sqlCheck, connectionAccess);
                    int existe = (int)cmdCheck.ExecuteScalar();

                    // ⭐ SI EXISTE DÉJÀ, PASSER AU SUIVANT
                    if (existe > 0)
                    {
                        continue;
                    }
                    // ⭐ FIN NOUVELLE SECTION

                    // CODE EXISTANT: Construction de la requête INSERT
                    string strBodySql =
                        TruncateField(StructureHydro.strNoRECQ[rowNum].ToString(), 8, "NoRECQ") + "', '" +
                        TruncateField(StructureHydro.strNoForm[rowNum].ToString(), 9, "NoForm") + "', '" +
                        TruncateField(StructureHydro.strNoDem[rowNum].ToString(), 9, "NoDem") + "', '" +
                        TruncateField(StructureHydro.strDatePer[rowNum].ToString(), 8, "DatePer") + "', '" +
                        TruncateField(StructureHydro.strNoCiv[rowNum].ToString(), 6, "NoCiv") + "', '" +
                        TruncateField(StructureHydro.strRue[rowNum].ToString(), 18, "Rue") + "', '" +
                        TruncateField(StructureHydro.strOrient[rowNum].ToString(), 1, "Orient") + "', '" +
                        TruncateField(StructureHydro.strAppart[rowNum].ToString(), 4, "Appart") + "', '" +
                        TruncateField(StructureHydro.strMunic[rowNum].ToString(), 23, "Munic") + "', '" +
                        TruncateField(StructureHydro.strCP[rowNum].ToString(), 6, "CP") + "', '" +
                        TruncateField(StructureHydro.strGenTrav[rowNum].ToString(), 31, "GenTrav") + "', '" +
                        TruncateField(StructureHydro.strDescClasRev[rowNum].ToString(), 18, "DescClasRev") + "', '" +
                        TruncateField(StructureHydro.strModChauf[rowNum].ToString(), 20, "ModChauf") + "', " +
                        StructureHydro.intPrinAmp[rowNum].ToString() + ", '" +
                        TruncateField(StructureHydro.strPrinVolt[rowNum].ToString(), 7, "PrinVolt") + "', " +
                        StructureHydro.intNbInt1[rowNum].ToString() + ", " +
                        StructureHydro.intAmp1[rowNum].ToString() + ", '" +
                        TruncateField(StructureHydro.strVolt1[rowNum].ToString(), 3, "Volt1") + "', " +
                        StructureHydro.intNbInt2[rowNum].ToString() + ", " +
                        StructureHydro.intAmp2[rowNum].ToString() + ", '" +
                        TruncateField(StructureHydro.strVolt2[rowNum].ToString(), 7, "Volt2") + "', '" +
                        TruncateField(StructureHydro.strClient[rowNum].ToString(), 23, "Client") + "', '" +
                        TruncateField(StructureHydro.strNomSup[rowNum].ToString(), 23, "NomSup") + "', '" +
                        TruncateField(StructureHydro.strCodRegRes[rowNum].ToString(), 3, "CodRegRes") + "', '" +
                        TruncateField(StructureHydro.strTelRes[rowNum].ToString(), 7, "TelRes") + "', '" +
                        TruncateField(StructureHydro.strCodRegTrav[rowNum].ToString(), 3, "CodRegTrav") + "', '" +
                        TruncateField(StructureHydro.strTelTrav[rowNum].ToString(), 7, "TelTrav") + "', '" +
                        TruncateField(StructureHydro.strPostTelTrav[rowNum].ToString(), 4, "PostTelTrav") + "', '" +
                        TruncateField(StructureHydro.strGenre[rowNum].ToString(), 1, "Genre") + "', '" +
                        TruncateField(StructureHydro.strDateInsert[rowNum].ToString(), 8, "DateInsert") + "', '" +
                        TruncateField(StructureHydro.strSource[rowNum].ToString(), 10, "Source") + "', '" +
                        TruncateField(StructureHydro.strDateDebutTrav[rowNum].ToString(), 8, "DateDebutTrav") + "', '" +
                        TruncateField(StructureHydro.strDateFinTrav[rowNum].ToString(), 8, "DateFinTrav") + "', '" +
                        TruncateField(StructureHydro.strNbEtage[rowNum].ToString(), 3, "NbEtage") + "'";

                    string sqlInsCmd = strEnteSql + strBodySql + ")";

                    OleDbCommand cmd = new OleDbCommand(sqlInsCmd, connectionAccess);
                    cmd.CommandType = CommandType.Text;
                    cmd.ExecuteNonQuery();
                }
                catch (Exception ex)
                {
                    blErreurExecution = true;
                    InsertTableLogJob($"InsertBD() - NoRECQ: {StructureHydro.strNoRECQ[rowNum]}", ex.Message);
                    Dts.Events.FireError(0, "HydroIntegration",
                        $"ERREUR insertion Access NoRECQ {StructureHydro.strNoRECQ[rowNum]}: {ex.Message}", "", 0);
                }
            }
        }

        string TruncateField(string value, int maxLength, string fieldName)
        {
            if (string.IsNullOrEmpty(value))
                return "";

            // ⭐ ÉCHAPPER LES APOSTROPHES
            value = value.Replace("'", "''");

            if (value.Length > maxLength)
            {
                bool fireAgain = true;
                Dts.Events.FireWarning(0, "HydroIntegration",
                    $"Champ {fieldName} tronqué: '{value}' de {value.Length} à {maxLength} caractères",
                    "", 0);
                return value.Substring(0, maxLength);
            }

            return value;
        }

        bool ValidateStructure(Structure_Hydro StructureHydro, ref bool fireAgain)
        {
            int count = StructureHydro.strNoRECQ.Count;

            Dts.Events.FireInformation(0, "HydroIntegration",
                $"Validation: {count} enregistrements à vérifier", "", 0, ref fireAgain);

            // Vérifier toutes les listes string
            if (StructureHydro.strNoForm.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strNoForm: {StructureHydro.strNoForm.Count} vs {count}", "", 0);
                return false;
            }
            if (StructureHydro.strNoDem.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strNoDem: {StructureHydro.strNoDem.Count} vs {count}", "", 0);
                return false;
            }
            if (StructureHydro.strDatePer.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strDatePer: {StructureHydro.strDatePer.Count} vs {count}", "", 0);
                return false;
            }
            if (StructureHydro.strNoCiv.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strNoCiv: {StructureHydro.strNoCiv.Count} vs {count}", "", 0);
                return false;
            }
            if (StructureHydro.strRue.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strRue: {StructureHydro.strRue.Count} vs {count}", "", 0);
                return false;
            }
            if (StructureHydro.strOrient.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strOrient: {StructureHydro.strOrient.Count} vs {count}", "", 0);
                return false;
            }
            if (StructureHydro.strAppart.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strAppart: {StructureHydro.strAppart.Count} vs {count}", "", 0);
                return false;
            }
            if (StructureHydro.strMunic.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strMunic: {StructureHydro.strMunic.Count} vs {count}", "", 0);
                return false;
            }
            if (StructureHydro.strCP.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strCP: {StructureHydro.strCP.Count} vs {count}", "", 0);
                return false;
            }
            if (StructureHydro.strGenTrav.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strGenTrav: {StructureHydro.strGenTrav.Count} vs {count}", "", 0);
                return false;
            }
            if (StructureHydro.strDescClasRev.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strDescClasRev: {StructureHydro.strDescClasRev.Count} vs {count}", "", 0);
                return false;
            }
            if (StructureHydro.strModChauf.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strModChauf: {StructureHydro.strModChauf.Count} vs {count}", "", 0);
                return false;
            }
            if (StructureHydro.strPrinVolt.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strPrinVolt: {StructureHydro.strPrinVolt.Count} vs {count}", "", 0);
                return false;
            }
            if (StructureHydro.strVolt1.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strVolt1: {StructureHydro.strVolt1.Count} vs {count}", "", 0);
                return false;
            }
            if (StructureHydro.strVolt2.Count != count)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"strVolt2: {StructureHydro.strVolt2.Count} vs {count}", "", 0);
