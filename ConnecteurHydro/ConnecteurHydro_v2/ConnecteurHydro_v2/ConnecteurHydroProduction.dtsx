        void UnzipSherbrookeFiles(string repertoireIn, ref bool fireAgain)
        {
            try
            {
                string[] zipFiles = Directory.GetFiles(repertoireIn, "hs*.zip", SearchOption.TopDirectoryOnly);

                foreach (string zipFile in zipFiles)
                {
                    Dts.Events.FireInformation(0, "HydroIntegration",
                        $"Décompression: {Path.GetFileName(zipFile)}", "", 0, ref fireAgain);

                    System.IO.Compression.ZipFile.ExtractToDirectory(zipFile, repertoireIn);

                    // ⭐ NE PAS supprimer le zip! Il sera archivé après traitement

                    Dts.Events.FireInformation(0, "HydroIntegration",
                        $"Fichier décompressé: {Path.GetFileName(zipFile)}", "", 0, ref fireAgain);
                }
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"Erreur décompression: {ex.Message}", "", 0);
            }
        }


        void ArchiveFile(string filePath, string repertoireArchive, string source, string annee, ref bool fireAgain)
        {
            try
            {
                string fileName = Path.GetFileName(filePath);

                // Créer le chemin d'archive: Archive/Quebec/2025/ ou Archive/Sherbrooke/2025/
                string archivePath = Path.Combine(repertoireArchive, source, annee);

                // Créer les dossiers si nécessaire
                if (!Directory.Exists(archivePath))
                {
                    Directory.CreateDirectory(archivePath);
                }

                string destinationFile = Path.Combine(archivePath, fileName);

                // Déplacer le fichier
                File.Move(filePath, destinationFile);

                Dts.Events.FireInformation(0, "HydroIntegration",
                    $"Fichier archivé: {fileName} → {source}/{annee}/", "", 0, ref fireAgain);
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "HydroIntegration",
                    $"Erreur archivage {Path.GetFileName(filePath)}: {ex.Message}", "", 0);
            }
        }

        void SendErrorEmail(string errorMessage, ref bool fireAgain)
        {
            // ⭐ LOG AVANT TOUT
            Dts.Events.FireInformation(0, "HydroIntegration",
                ">>> DÉBUT SendErrorEmail() <<<", "", 0, ref fireAgain);

            try
            {
                // ⭐ LOG AVANT RÉCUPÉRATION DES VARIABLES
                Dts.Events.FireInformation(0, "HydroIntegration",
                    "Récupération des variables SSIS...", "", 0, ref fireAgain);

                string smtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();
                string emailFrom = Dts.Variables["User::EnvoyePar"].Value.ToString();
                string emailTo = Dts.Variables["User::ProfileCourriel"].Value.ToString();

                // ⭐ LOG DES VARIABLES
                Dts.Events.FireInformation(0, "HydroIntegration",
                    $"SMTP: {smtpServer}, From: {emailFrom}, To: {emailTo}", "", 0, ref fireAgain);

                // ⭐ LOG AVANT CRÉATION CLIENT SMTP
                Dts.Events.FireInformation(0, "HydroIntegration",
                    "Création du client SMTP...", "", 0, ref fireAgain);

                using (System.Net.Mail.SmtpClient client = new System.Net.Mail.SmtpClient(smtpServer))
                {
                    System.Net.Mail.MailMessage mail = new System.Net.Mail.MailMessage();
                    mail.From = new System.Net.Mail.MailAddress(emailFrom);
                    mail.To.Add(emailTo);
                    mail.Subject = "ERREUR - Connecteur Hydro-Québec";
                    mail.Body = $@"
Une erreur s'est produite lors de l'exécution du connecteur Hydro-Québec.

Détails de l'erreur:
{errorMessage}

Date: {DateTime.Now}
Serveur: {Environment.MachineName}

Veuillez vérifier les logs dans la table Log_Job_Connecteur pour plus de détails.
            ";

                    // ⭐ LOG AVANT ENVOI
                    Dts.Events.FireInformation(0, "HydroIntegration",
                        "Envoi de l'email...", "", 0, ref fireAgain);

                    client.Send(mail);

                    // ⭐ LOG SUCCÈS
                    Dts.Events.FireInformation(0, "HydroIntegration",
                        $"✅ Email d'erreur envoyé avec succès à {emailTo}", "", 0, ref fireAgain);
                }
            }
            catch (Exception ex)
            {
                // ⭐ LOG ERREUR DÉTAILLÉE
                Dts.Events.FireWarning(0, "HydroIntegration",
                    $"❌ Impossible d'envoyer l'email d'erreur: {ex.Message}", "", 0);
                Dts.Events.FireWarning(0, "HydroIntegration",
                    $"Type d'exception: {ex.GetType().Name}", "", 0);
                Dts.Events.FireWarning(0, "HydroIntegration",
                    $"Stack trace: {ex.StackTrace}", "", 0);
            }

            // ⭐ LOG FIN
            Dts.Events.FireInformation(0, "HydroIntegration",
                ">>> FIN SendErrorEmail() <<<", "", 0, ref fireAgain);
        }
    }
}]]></ProjectItem>
