        public const string delLogChargement = "DELETE [SDDMU01].[dbo].[Log_Chargement_Connecteur] where Application = 'AccesSharePoint'";
        public const string delLogJobChargement = "DELETE [SDDMU01].[dbo].[Log_Job_Connecteur] where Application = 'AccesSharePoint'";
        public const string delAccesSharePoint = "delete from [SDDMU01].[dbo].[AccesSharePoint]";

        public const string tblAfficheErreur = "SELECT [IndSystem], " +
                                                      "[NomTable], " +
                                                      "[JobName], " +
                                                      "[ErrorMessage] " +
                                                 "FROM [SDDMU01].[dbo].[Log_Job_Connecteur] " +
                                                "WHERE Application = 'AccesSharePoint' ";

        public string newLine = Environment.NewLine;
        public string oUserCode = "auto01";
        public string userlogin = Environment.UserName.ToString();
        public string UserName = "Tâche Automatisée";
        public string SchemasUser;
        public string oStartJob = DateTime.Now.ToString("yyyy-MM-dd hh:mm:ss");
        public string oSystem = "AccesSharePoint";

        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        public void Main()
        {
            AccesSharePoint();
            Dts.TaskResult = (int)ScriptResults.Success;
        }


        public void AccesSharePoint()
        {
            bool succesLoadTable = true;
            bool blErreurExecution = false;
            bool LoadTableErreur = false;
            string strMessageSql = "";
            string strEtape = "";

            string date = DateTime.Now.ToString("yyyy-MM-dd hh:mm:ss");
            string EnvoyePar = Dts.Variables["User::EnvoyePar"].Value.ToString();
            string oPathEnvironnement = Dts.Variables["User::PathEnvironnement"].Value.ToString();

        strEtape = "Début";

            SqlConnection mySQLConnection =
                Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                as SqlConnection;

            // delete l'historique du dernier log de chargement
            DeleteTableLogChargement();
            DeleteTableLogJobChargement();
            DeleteTableAccesSharePoint();
            InsertTableLogChargement("AccesSharePoint", "Début du traitement");

            strEtape = "Connecter à la BD";
            if (LoadTableErreur != true)
            {
                strEtape = "Traitement des fichiers ...";

                if (oPathEnvironnement != "")
                {
                    // Lire le répertoire 
                    DirectoryInfo d = new DirectoryInfo(@oPathEnvironnement);
                    try
                    {

                        //FileInfo[] Files = d.GetFiles("*.csv");
                        FileInfo[] Files = d.GetFiles("new_groupmembersreport.csv"); 

                        foreach (FileInfo file in Files)
                        {
                            blErreurExecution = false;
                            InsertTableLogChargement("Traite le fichier", file.Name);

                            ImporterFichier(file.FullName);

                            InsertTableLogChargement("Fichier complété", file.Name);
                        }
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        blErreurExecution = true;
                        InsertTableLogJobConnecteur("AccesSharePoint()", strEtape, ex.Message.ToString());
                    }
                }
            }

            if (LoadTableErreur == true)
            {
                // Envois un courriel si erreur de programmation (SQL ou autre)
                SendMailMessageError(EnvoyePar);
            }

            InsertTableLogChargement("AccesSharePoint", "Fin du traitement");
            mySQLConnection.Close();


            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Chargement_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogChargement(string strIndSystem, string strSqlTable)
            {
                string sqlInsCmd = "insert into[SDDMU01].[dbo].[Log_Chargement_Connecteur] values('AccesSharePoint', '" + strIndSystem + "', '" + strSqlTable + "', GETDATE(), 'Auto01', 'Tâche Automatisée')";

                try
                {
                    SqlCommand SQLCommandLog = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandLog.CommandType = CommandType.Text;
                    SqlDataReader readerLog = SQLCommandLog.ExecuteReader();
                    readerLog.Read();
                    readerLog.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobConnecteur("InsertTableLogChargement()", "", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Job_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogJobConnecteur(string pFonction, string pEtape, string pErreurMessage)
            {
                int lParametreErreurMessage;
                pErreurMessage = pErreurMessage.Replace("'", "''");
                pFonction = pFonction.Replace("'", "''");

                lParametreErreurMessage = pErreurMessage.Length;

                if (pErreurMessage.Length > 250)
                {
                    pErreurMessage = pErreurMessage.Substring(0, 245);
                    pErreurMessage = pErreurMessage + "...";
                }

                string sqlInsCmd = "insert into[SDDMU01].[dbo].[Log_Job_Connecteur] values('AccesSharePoint', '" + oSystem + "', '" + pEtape + "', '" + pFonction + "', 'Erreur', '" + pErreurMessage + "', 'Auto01', GETDATE())";

                try
                {
                    SqlCommand SQLCommandJob = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandJob.CommandType = CommandType.Text;
                    SqlDataReader readerErreur = SQLCommandJob.ExecuteReader();
                    readerErreur.Read();
                    readerErreur.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogChargement("ERR", "Impossible d''insérer dans Log_Job_Connecteur ::: " + ex.Message);
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Détruit les informations dant la table Log_Chargement_Connecteur
            ///
            ///////////////////////////////////////////////////////////////////////
            void DeleteTableLogChargement()
            {
                string sqlDelCmd = delLogChargement.ToString();

                try
                {
                    SqlCommand SQLCommandDel = new SqlCommand(sqlDelCmd.ToString(), mySQLConnection);
                    SQLCommandDel.CommandType = CommandType.Text;
                    SqlDataReader readerDel = SQLCommandDel.ExecuteReader();
                    readerDel.Read();
                    readerDel.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogChargement("ERR", "DeleteTableLogChargement()");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Détruit les informations dant la table AccesSharePoint
            ///
            ///////////////////////////////////////////////////////////////////////
            void DeleteTableAccesSharePoint()
            {
                string sqlDelCmd = delAccesSharePoint.ToString();

                try
                {
                    SqlCommand SQLCommandDel = new SqlCommand(sqlDelCmd.ToString(), mySQLConnection);
                    SQLCommandDel.CommandType = CommandType.Text;
                    SqlDataReader readerDel = SQLCommandDel.ExecuteReader();
                    readerDel.Read();
                    readerDel.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobConnecteur("DeleteTableAccesSharePoint()", "", ex.Message.ToString());
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     détruit les informations dant la table Log_Job_Connecteur
            ///
            ///////////////////////////////////////////////////////////////////////
            void DeleteTableLogJobChargement()
            {
                string sqlDelCmdCharg = delLogJobChargement.ToString();

                try
                {
                    SqlCommand DelCmdCharg = new SqlCommand(sqlDelCmdCharg.ToString(), mySQLConnection);
                    DelCmdCharg.CommandType = CommandType.Text;
                    SqlDataReader readerCharg = DelCmdCharg.ExecuteReader();
                    readerCharg.Read();
                    readerCharg.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogChargement("ERR", "DeleteTableLogJobChargement()");
                }
            }


            //////////////////////////////////////////////////////////////////////
            ///
            //     Force le format de la vaaleur
            ///
            /////////////////////////////////////////////////////////////////////
            string ForcerFormatValeurChamp(string strValeur)
            {
                string strReturnValeur = "";

                switch (strValeur)
                {
                    case "Vrai":
                        strReturnValeur = "True";
                        break;
                    case "Faux":
                        strReturnValeur = "False";
                        break;
                    default:
                        if (strValeur != "")
                        {
                            strReturnValeur = "'" + strValeur.Replace("'", "''") + "'";
                        }
                        else
                        {
                            strReturnValeur = "NULL";
                        }

                        break;
                }
                return strReturnValeur;
            }
            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute une instruction SQL
            ///
            /////////////////////////////////////////////////////////////////////
            void ExecuteSQL(string strIndSystem, string strSqlRequete)
            {
                InsertTableLogChargement(strIndSystem.ToString(), "ExecuteSQL");
                string sqlInsCmd = strSqlRequete.ToString();

                try
                {
                    SqlCommand SQLCommandExec = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandExec.CommandType = CommandType.Text;
                    SqlDataReader readerExec = SQLCommandExec.ExecuteReader();
                    readerExec.Read();
                    readerExec.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobConnecteur("ExecuteSQL()", "", ex.Message.ToString());
                    LoadTableErreur = true;
                }
            }
            ////////////////////////////////////////////////////////////////////////
            ///
            //     Lire le fichier texte et mettre à jour les tables de chargement
            ///
            ///////////////////////////////////////////////////////////////////////
            void ImporterFichier(string spFile)
            {
                var encoding = Encoding.Default;
                string[] arrColonne = new string[0];
                string sqlInsCmd = "";
                string strValeurChampsUtilisateur = "";
                bool blRowEntete = true;


                InsertTableLogChargement("ImporterFichier()", "Début importation");
                using (StreamReader file = new StreamReader(spFile, encoding))
                {
                    string ln;

                    while ((ln = file.ReadLine()) != null)
                    {
                        if (ln.ToString() != "")
                        {
                            
                            // détermine les colonnes
                            arrColonne = ln.Split(';');

                            // Extraction des valeurs
                            if (arrColonne.Count() > 0 && blRowEntete != true)
                            {
                                var pos = arrColonne[2].IndexOf('\\');
                                if (pos == -1)
                                {
                                    //pos = arrColonne[2].IndexOf('|');
                                    strValeurChampsUtilisateur = arrColonne[2].ToString();
                                }
                                else
                                {
                                    strValeurChampsUtilisateur = arrColonne[2].Substring((pos + 1), arrColonne[2].Length - (pos + 1));
                                }

                                sqlInsCmd = "insert into[SDDMU01].[dbo].[AccesSharePoint] values('" + arrColonne[0].ToString() + "', '" + 
                                                                                                      arrColonne[1].Replace("'", "''").ToString() + "', '" + 
                                                                                                      strValeurChampsUtilisateur.ToString() + "', '" +
                                                                                                      arrColonne[3].Replace("'", "''").ToString() + "', '" +
                                                                                                      arrColonne[4].ToString() + "', '" +
                                                                                                      arrColonne[5].Replace("'", "''").ToString() + "', '" +
                                                                                                      arrColonne[6].Replace("'", "''").ToString() + "', '" +
                                                                                                      arrColonne[7].Replace("'", "''").ToString() + "', '" +
                                                                                                      arrColonne[8].Replace("'", "''").ToString() + 
                                                                                                      "', GETDATE(), 'Auto01', '" +
                                                                                                      getSiteName(arrColonne[0].ToString()) + "')";

                                try
                                {
                                    SqlCommand SQLCommandJob = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                                    SQLCommandJob.CommandType = CommandType.Text;
                                    SqlDataReader readerErreur = SQLCommandJob.ExecuteReader();
                                    readerErreur.Read();
                                    readerErreur.Close();
                                }
                                catch (Exception ex)
                                {
                                    //MessageBox.Show(ex.Message);
                                    InsertTableLogJobConnecteur("ImporterFichier", sqlInsCmd, ex.Message.ToString());
                                }
                            }
                            blRowEntete = false;
                        }
                    }
                    file.Close();
                }
                InsertTableLogChargement("ImporterFichier()", "Fin importation");
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Retourne le nom du site
            ///
            ///////////////////////////////////////////////////////////////////////
            string getSiteName(string pstrValeur)
            {
                string strGetValeur = "";

                switch (0)
                {
                    case 0 when pstrValeur.LastIndexOf("/sites/gir") > 0:
                        strGetValeur = "GIR";
                    break;

                    case 0 when pstrValeur.LastIndexOf("/sites/rbqbp") > 0:
                        strGetValeur = "ESPP";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/DRECMED") > 0:
                        strGetValeur = "SGMED";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/BEHESP") > 0:
                    case 0 when pstrValeur.LastIndexOf("/sites/tnc") > 0:
                    case 0 when pstrValeur.LastIndexOf("/sites/DRECSoutien") > 0:
                    case 0 when pstrValeur.LastIndexOf("/sites/inspection") > 0:
                        strGetValeur = "QR";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/ae") > 0:
                        strGetValeur = "DOC - Architecture entreprise";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/BEHESP") > 0:
                        strGetValeur = "RVISP";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/DRHDTI") > 0:
                        strGetValeur = "DOC - Partage RH-TI";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/DPOPG") > 0:
                        strGetValeur = "DOC - DPOPG";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/RHSF") > 0:
                        strGetValeur = "DOC - Partage RH-SF";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/TraitementCRN") > 0:
                        strGetValeur = "TCRN";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/DAJ") > 0:
                        strGetValeur = "DOC - Affaires juridiques";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/InfoGestion") > 0:
                        strGetValeur = "DOC - Info de gestion";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/d") > 0:
                        strGetValeur = "DOC - Relation clientèle";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/DRECMandat") > 0:
                        strGetValeur = "SMDGREC";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/CadreDeGestion") > 0:
                        strGetValeur = "OSCG";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/docrbq") > 0:
                        strGetValeur = "DOC - Documentation TI";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/BCR") > 0:
                        strGetValeur = "BCR";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/Billetterie") > 0:
                        strGetValeur = "BILT";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/admin") > 0:
                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/soutien") > 0:
                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/Modèles") > 0:
                        strGetValeur = "Zone collaboration";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/Reddition") > 0:
                        strGetValeur = "DOC - Redditions de compte";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/DTISO") > 0:
                        strGetValeur = "DOC - DTISO";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/pg") > 0:
                        strGetValeur = "DOC - Plan de garantie";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/DSF") > 0:
                        strGetValeur = "DOC - Service financier";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/DPSP") > 0:
                        strGetValeur = "DOC - DPSP";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/RBQ-DRH") > 0:
                        strGetValeur = "DOC - Ressources humaines";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/RHSF") > 0:
                        strGetValeur = "DOC - Partage RH-SF";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/CommunauteCP") > 0:
                        strGetValeur = "DOC - Communauté de praticiens";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/SCT") > 0:
                        strGetValeur = "DOC - Redditions de compte SCT TI";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/ITEMEXAM") > 0:
                        strGetValeur = "ITEMEXAM";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/SGAI") > 0:
                        strGetValeur = "DOC - SGAI";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/TestHakim") > 0:
                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/hatimTest") > 0:
                        strGetValeur = "Site de test";
                        break;

                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone/") > 0:
                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/zone") > 0:
                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration/") > 0:
                    case 0 when pstrValeur.LastIndexOf("/sites/collaboration") > 0:
                        strGetValeur = "Zone collaboration";
                        break;
                    default:
                        strGetValeur = "Z - NOM À DÉTERMINER";
                        break;

                }


                return strGetValeur;
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Envois le courriel s'il y a une ou des erreurs
            ///
            ///////////////////////////////////////////////////////////////////////
            void SendMailMessageError(string EnvoisCourrielPar)
            {
                int recCount = 0;
                String strAfficheErreur = "";
                String SQLString = tblAfficheErreur.ToString();
                String EnvoisCourrielA = "yves.mcduff-ext@rbq.gouv.qc.ca"; // "centre.de.pilotage@rbq.gouv.qc.ca";
                String EnvoisCourrielSuject = "L'application (AccesSharePoint) a une ou plusieurs erreurs d'exécutions ";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine +
                                             "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";


                // Lire les erreurs
                using (SqlDataAdapter dataAdapterAfficheErreur = new SqlDataAdapter(SQLString, mySQLConnection))
                {
                    // create the DataSet 
                    try
                    {
                        DataSet dataSetAfficheErreur = new DataSet();
                        dataAdapterAfficheErreur.SelectCommand.CommandTimeout = 180;
                        dataAdapterAfficheErreur.Fill(dataSetAfficheErreur, "AfficheErreur");
                        recCount = 0;

                        foreach (DataRow pRowRegleAfficheErreur in dataSetAfficheErreur.Tables["AfficheErreur"].Rows)
                        {

                            if (recCount < 16)
                            {
                                strAfficheErreur = strAfficheErreur.ToString() + newLine + pRowRegleAfficheErreur["IndSystem"].ToString() + " - " +
                                                                                           pRowRegleAfficheErreur["JobName"].ToString() + " - " +
                                                                                           pRowRegleAfficheErreur["NomTable"].ToString() + " - " +
                                                                                           pRowRegleAfficheErreur["ErrorMessage"].ToString() + newLine;
                            }

                            recCount++;

                        }
                    }
                    catch (Exception ex)
                    {
                        ///
                        strMessageSql = "Fonction SendMailMessageError (dataSetAfficheErreur) Erreur SQL ";
                        InsertTableLogJobConnecteur("MAIL", "Étpae 1", strMessageSql.ToString());
                        succesLoadTable = false;
                    }
                }

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + strAfficheErreur.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();

                String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message.ToString();
                    strMessageSql = "Fonction SendMailMessageError (SmtpClient) Erreur SQL ";
                    InsertTableLogJobConnecteur("MAIL", "Étape 2", strMessageSql.ToString());
                    succesLoadTable = false;
                }
                InsertTableLogChargement("Mail", "Mail Envoyé");
            }


        }

        private bool defined()
        {
            throw new NotImplementedException();
        }
        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = DTSExecResult.Success,
            Failure = DTSExecResult.Failure
        };
        #endregion
    }

}]]></ProjectItem>
