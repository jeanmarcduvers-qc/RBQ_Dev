        #endregion


        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        public string strServerSDEXT01 = "Server=W367P002RPT1,60800;Database=SDEXT01;Integrated Security=True;";
        public string strServerBD = "";
        public DateTime dtNettoyage = DateTime.MinValue;

        public const string delLogChargement = "DELETE [SDEXT01].[CFG].[Log_Chargement_Connecteur] where Application = 'TraiteNettoyage'";
        public const string delLogJobChargement = "DELETE [SDEXT01].[CFG].[Log_Job_Connecteur] where Application = 'TraiteNettoyage'";
        public const string tblAfficheErreur = "SELECT * FROM [SDEXT01].[CFG].[Log_Job_Connecteur] where Application = 'TraiteNettoyage'";
        public const string updtConfigParm = @"update [SDEXT01].[CFG].[CFG_CONFIG_PARM] 
                                                  set [VALEUR_PARM] = 'N' 
                                                where [CD_PARAM] = 'IndExecNettoyage' 
                                                and   [CD_SYSTEM] = 'CCQ_ETL' ";

        public string newLine = Environment.NewLine;
        public bool blErreurExecution = false;
        public DateTime dtDateDebut = DateTime.Now;
        public string dtExecution = "";
        public string strTableName = "";  // Nom de la table d'insertion selon le type de fichier Hebdo ou Initial

        public void Main()
        {
            try
            {
                TraiteNettoyage();            
            }
            catch (Exception ex)
            {
                //MessageBox.Show("Yves :: " + ex.Message);
                Dts.Events.FireError(0, "Script Task", ex.Message, "", 0);
                Dts.TaskResult = (int) ScriptResults.Failure;
            }

            Dts.TaskResult = (int)ScriptResults.Success;
        }

        public void TraiteNettoyage()
        {
            // Récupére les paramètres
            string EnvoyePar = FindConfigParm("COMMUN", "EnvoyePar");
            strServerBD = FindConfigParm("CCQ_ETL", "ServerBD");
            string strEnvoisCourrielA = FindConfigParm("CCQ_ETL", "EnvoisCourrielA");
            string IndExecNettoyage = FindConfigParm("CCQ_ETL", "IndExecNettoyage");

            InsertTableLogChargement("TraiteNettoyage", "Début du traitement");
            // delete l'historique du dernier log de chargement
            ExecuteSQL("CCQ", delLogJobChargement);

            /////////////////////////////////////////////////////////////////////////////////////////////
            // Valide que nous pouvons lancer le nettoyage sans erreur
            /////////////////////////////////////////////////////////////////////////////////////////////
            if (IndExecNettoyage == "N")
            {
                blErreurExecution = true;
                InsertTableLogJob("ERR", "L'indicateur IndExecNettoyage de la table config n'est pas actif 'O'");
            }

            // Début du traitement
            if ((blErreurExecution != true) && (IndDoitTraier()) && (IndExecNettoyage == "O"))
            {
                
                DeleteAuditChangementsCritiques();
                DeleteRapMensDet();
                DeleteRapMensEnt();
                DeleteSalarDoss();
                DeleteEmplRel();
                DeleteEmplDoss();
                DeleteCtrlHebdo();
               
            }

            if (blErreurExecution)
            {
                Email_Send();
            }
            else
            {
                // Initialise la valeur à 'N' pour ne pas permettre des mises à jours par erreur
                ExecuteSQL("CCQ", updtConfigParm);
            }


            InsertTableLogChargement("TraiteNettoyage", "Fin du traitement");

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Récupére les valeurs de la table config
            ///
            ///////////////////////////////////////////////////////////////////////
            string FindConfigParm(string pCdSystem, string pCdParm)
            {
                string sqlCmd = "SELECT parm.valeur_parm as ValeurParm " +
                                "FROM  [SDEXT01].[CFG].[CFG_CONFIG] co, " +
                                      "[SDEXT01].[CFG].[CFG_CONFIG_PARM] parm " +
                                "where co.[CD_SYSTEM] = '" + pCdSystem + "' " +
                                "and   co.[IND_ACTIF] = 'O' " +
                                "and parm.[CD_SYSTEM] = co.[CD_SYSTEM] " +
                                "and parm.[IND_ACTIF] = 'O' " +
                                "and parm.[CD_PARAM] = '" + pCdParm + "'";

                string valParm = "";

                try
                {
                    using (SqlConnection mySQLConnectionParm = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnectionParm.Open();

                        using (SqlCommand SQLCommandCfg = new SqlCommand(sqlCmd.ToString(), mySQLConnectionParm))
                        {

                            SQLCommandCfg.CommandType = CommandType.Text;
                            SqlDataReader readerCfg = SQLCommandCfg.ExecuteReader();
                            readerCfg.Read();
                            valParm = readerCfg["ValeurParm"].ToString();
                            readerCfg.Close();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "FindConfigParm(" + pCdSystem + "." + pCdParm + ")");
                }
                return valParm;
            }

            /////////////////////////////////////////////////////////////////////////////////////////////
            // Récupère la date du dernier chargement
            /////////////////////////////////////////////////////////////////////////////////////////////
            bool IndDoitTraier()
            {
                string sqlCmdDate = @"SELECT max(charg_dt) as value
									FROM [SDEXT01].[CCQ].[CTRL_HEBDO] ";
                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlCmdDate, mySQLConnection))
                        {
                            SQLCommandExec.CommandTimeout = 12000;
                            dtNettoyage = (DateTime)SQLCommandExec.ExecuteScalar();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "Récupère la date du dernier chargement");
                    return false;
                }
                return true;
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Delete les occurences de la table CCQ_AUDIT_CHANGEMENTS_CRITIQUES
            ///
            /////////////////////////////////////////////////////////////////////
            void DeleteAuditChangementsCritiques()
            {
                string sqlCmd = @"delete TOP(100000) [SDEXT01].[CCQ].[CCQ_AUDIT_CHANGEMENTS_CRITIQUES]
                                    where  UPDATED_DT >= @dtNettoyage ";
                int intRows = 100000;
                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlCmd, mySQLConnection))
                        {
                           
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.Parameters.Add("@dtNettoyage", SqlDbType.DateTime);
                            SQLCommandExec.Parameters["@dtNettoyage"].Value = dtNettoyage;
                            while (intRows == 100000)
                            {
                                intRows = SQLCommandExec.ExecuteNonQuery();
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "DeleteAuditChangementsCritiques()");
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Delete les occurences de la table RAP_MENS_DET
            ///
            /////////////////////////////////////////////////////////////////////
            void DeleteRapMensDet()
            {
                string sqlDel = @"delete TOP(100000) [SDEXT01].[CCQ].[RAP_MENS_DET]
                                where  deb_effect_dt = @dtNettoyage ";

                string sqlupdt = @"update TOP(100000) [SDEXT01].[CCQ].[RAP_MENS_DET]
                                    set    fin_effect_dt = null,
                                           actif_ind = 'O'
                                    where  fin_effect_dt = DATEADD(DAY, -1, @dtNettoyage ) ";

                int intRows = 100000;
                string Etape = "Delete";
                try
                {
                    Etape = "Delete";
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlDel, mySQLConnection))
                        {

                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.Parameters.Add("@dtNettoyage", SqlDbType.DateTime);
                            SQLCommandExec.Parameters["@dtNettoyage"].Value = dtNettoyage;
                            while (intRows == 100000)
                            {
                                intRows = SQLCommandExec.ExecuteNonQuery();
                            }
                        }

                        intRows = 100000;
                        Etape = "Update";

                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlupdt, mySQLConnection))
                        {

                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.Parameters.Add("@dtNettoyage", SqlDbType.DateTime);
                            SQLCommandExec.Parameters["@dtNettoyage"].Value = dtNettoyage;
                            while (intRows == 100000)
                            {
                                intRows = SQLCommandExec.ExecuteNonQuery();
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "DeleteRapMensDet(" + Etape.ToString() + ")");
                }
            }

