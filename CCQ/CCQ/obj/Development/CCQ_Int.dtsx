                string sqlUpdateDest = @"UPDATE [SDEXT01].[CCQ].[RAP_MENS_ENT] 
								         SET FIN_EFFECT_DT = DATEADD(DAY, -1, S.DEB_EFFECT_DT), 
                                             ACTIF_IND = 'N',
										     MODIF_DT = S.MODIF_DT
										 FROM [SDEXT01].[CCQ].[RAP_MENS_ENT] T
										    JOIN [SDEXT01].[CCQ].[RAP_MENS_ENT_tmp] S
											  ON T.RAP_SAP_CLE = S.RAP_SAP_CLE
											     AND T.FIN_EFFECT_DT is null
										  WHERE S.AJOUT_MOD_IND = 'M'";

                string sqlInsertModifDest = @"insert into [SDEXT01].[CCQ].[RAP_MENS_ENT] ([RAP_SAP_CLE], [DEB_EFFECT_DT], [FIN_EFFECT_DT], [CLIENT_EMP_NO], [ACTIF_IND], [PER_ENV_DEB_DT], [PER_ENV_FIN_DT], [FISC_DEB_DT], [FISC_FIN_DT]
																					, [RAPPORT_NO], [AMEND_NB], [RAP_STATUT_CD], [TYPE_RAP_CD], [ENTRP_NM], [TOT_RM_AMT], [SOLDE_RM_AMT], [TOT_AV_SOC_AMT], [MNT_NET_CARCAP], [AJOUT_MOD_IND]
																					, [SOUM_RM_DT], [TOT_HEURE_RM], [SOLDE_RECL_AMT], [DEB_PER_RECL_DT], [FIN_PER_RECL_DT], [NO_RECLAMATION], [EST_EMP_ENQUETE_IND], [EST_RAP_RETARD_IND]
																					, [DERN_CHG_DT], [CREAT_DT], [CREAT_UTIL_ID], [MODIF_DT], [MODIF_UTIL_ID])
                                                                            select [RAP_SAP_CLE], [DEB_EFFECT_DT], [FIN_EFFECT_DT], [CLIENT_EMP_NO], [ACTIF_IND], [PER_ENV_DEB_DT], [PER_ENV_FIN_DT], [FISC_DEB_DT], [FISC_FIN_DT]
																					, [RAPPORT_NO], [AMEND_NB], [RAP_STATUT_CD], [TYPE_RAP_CD], [ENTRP_NM], [TOT_RM_AMT], [SOLDE_RM_AMT], [TOT_AV_SOC_AMT], [MNT_NET_CARCAP], [AJOUT_MOD_IND]
																					, [SOUM_RM_DT], [TOT_HEURE_RM], [SOLDE_RECL_AMT], [DEB_PER_RECL_DT], [FIN_PER_RECL_DT], [NO_RECLAMATION], [EST_EMP_ENQUETE_IND], [EST_RAP_RETARD_IND]
																					, [DERN_CHG_DT], [CREAT_DT], [CREAT_UTIL_ID], [MODIF_DT], [MODIF_UTIL_ID]
                                                                                        from [SDEXT01].[CCQ].[RAP_MENS_ENT_tmp] where [AJOUT_MOD_IND] = 'M'";

                InsertTableLogChargement("TraiteCCQ", "TraiteUpdtInsRM02()");

                using (SqlConnection conn = new SqlConnection(strServerBD))
                {
                    conn.Open();
                    SqlTransaction tran = conn.BeginTransaction();

                    try
                    {
                        // Insertion
                        SqlCommand cmd = new SqlCommand(sqlInsertDest, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteUpdtInsRM02(sqlInsertDest)", ex.Message);
                        }

                        // Insertion
                        cmd = new SqlCommand(sqlUpdateDest, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteUpdtInsRM02(sqlUpdateDest)", ex.Message);
                        }

                        // Insert les nouvelles modif
                        cmd = new SqlCommand(sqlInsertModifDest, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteUpdtInsRM02(sqlInsertModifDest)", ex.Message);
                        }

                        tran.Commit();
                    }
                    catch (Exception ex)
                    {
                        blErreurExecution = true;
                        tran.Rollback();
                        statutRM02 = "ERREUR";
                        InsertTableLogJob("TraiteUpdtInsRM02", ex.Message);
                        throw;
                    }
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute une instruction SQL
            ///
            /////////////////////////////////////////////////////////////////////
            void ExecuteSQL(string strCodeTraitement, string strSqlRequete)
            {
                string sqlCmd = strSqlRequete.ToString();

                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerBD))
                    {
                        mySQLConnection.Open();
                        using (var transaction = mySQLConnection.BeginTransaction())
                        {
                            SqlCommand SQLCommandExec = new SqlCommand(sqlCmd.ToString(), mySQLConnection, transaction);
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.ExecuteNonQuery();
                            transaction.Commit();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJob("ExecuteSQL(" + strCodeTraitement + ")", ex.Message.ToString());
                    blErreurExecution = true;
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Création du fichier rejet
            ///
            /////////////////////////////////////////////////////////////////////
            void CreerFichierRejet()
            {
                string sqlErreur = @"select JobName + '|' + ErrorMessage + '|' + replace(FORMAT(DateErreur, 'yyyy-MM-dd hh:mi:ss'), 'i', '') as resultat
                                     from   [SDEXT01].[CFG].[Log_Job_Connecteur]
                                     where  application = 'TraiteCCQ' 
                                     order by DateErreur ";

                string strpath = strCheminRejet + "Rejets_" + dtTraitementSSIS.ToString("yyyy_MM_dd") + ".csv";

                if (File.Exists(strpath))
                {
                    // Si le fichier existe le détruire
                    File.Delete(strpath);
                }

                StreamWriter sw = new StreamWriter(strpath, true, Encoding.Unicode);
                sw.WriteLine("Fonction(Code utile)|Erreur|Date exécution");

                // Lire les règles d'affaire
                using (SqlDataAdapter dataAdapterAfficheErreur = new SqlDataAdapter(sqlErreur, strServerBD))
                {
                    try
                    {
                        DataSet dataSetAfficheErreur = new DataSet();
                        dataAdapterAfficheErreur.SelectCommand.CommandTimeout = 600;
                        dataAdapterAfficheErreur.Fill(dataSetAfficheErreur, "AfficheErreur");

                        foreach (DataRow pRowRegleAfficheErreur in dataSetAfficheErreur.Tables["AfficheErreur"].Rows)
                        {
                            sw.WriteLine(pRowRegleAfficheErreur["resultat"].ToString().Replace(Environment.NewLine, "").Replace("\r", "").Replace("\n", ""));
                        }
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJob("CreerFichierRejet()", ex.Message.ToString());
                        blErreurExecution = true;
                    }
                }
                sw.Close();
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Création du fichier rejet
            ///
            /////////////////////////////////////////////////////////////////////
            void CCQ_Audit()
            {
                string sqlCmd = @"SELECT [CD_CONFIG]
                                          ,[ENTITE_TYPE]
                                          ,[REQ_SQL_AUDIT]
                                          ,[CATEGORIE]
                                          ,[SOUS_CATEGORIE]
                                          ,[EST_ACTIF]
                                          ,[RETENTION_JOURS]
                                      FROM [SDEXT01].[CCQ].[CCQ_AUDIT_CONFIG]
                                      WHERE [EST_ACTIF] = 'O'";

                // Lire la config des audits

                using (SqlDataAdapter dataAdapterAudit = new SqlDataAdapter(sqlCmd, strServerBD))
                {
                    try
                    {
                        DataSet dataSetAfficheErreur = new DataSet();
                        dataAdapterAudit.SelectCommand.CommandTimeout = 600;
                        dataAdapterAudit.Fill(dataSetAfficheErreur, "Audit");

                        foreach (DataRow pRowRegleAudit in dataSetAfficheErreur.Tables["Audit"].Rows)
                        {
                            var sqlAudit = pRowRegleAudit["REQ_SQL_AUDIT"].ToString();
                            var strCdConfig = pRowRegleAudit["CD_CONFIG"].ToString();
                            try
                            {
                                using (SqlConnection mySQLConnection = new SqlConnection(strServerBD))
                                {
                                    mySQLConnection.Open();
                                    using (var transaction = mySQLConnection.BeginTransaction())
                                    {
                                        SqlCommand SQLCommandExec = new SqlCommand(sqlAudit.ToString(), mySQLConnection, transaction);
                                        SQLCommandExec.CommandTimeout = 12000;
                                        SQLCommandExec.Parameters.Add("@dtDebEffect", SqlDbType.DateTime);
                                        SQLCommandExec.Parameters["@dtDebEffect"].Value = dtTraitementSSIS;
                                        SQLCommandExec.ExecuteNonQuery();
                                        transaction.Commit();
                                    }
                                }
                            }
                            catch (Exception ex)
                            {
                                //MessageBox.Show(ex.Message);
                                InsertTableLogJob("CCQ_Audit("+ strCdConfig + ")", ex.Message.ToString());
                                blErreurExecution = true;

                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJob("CCQ_Audit(SqlDataAdapter)", ex.Message.ToString());
                        blErreurExecution = true;
                    }
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Envois courriel
            ///
            /////////////////////////////////////////////////////////////////////
            void Email_Send()
            {
                String SQLString = tblAfficheErreur.ToString();
                String EnvoisCourrielPar = EnvoyePar.ToString();
                String EnvoisCourrielA = strEnvoisCourrielA; // "yves.mcduff-ext@rbq.gouv.qc.ca"; // strEnvoisCourrielA.ToString();  // "yves.mcduff-ext@rbq.gouv.qc.ca";  //"centre.de.pilotage@rbq.gouv.qc.ca"
                String EnvoisCourrielSuject = "L'application (TraiteCCQ) a une ou des erreurs d'exécutions. ";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine +
                                             "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";

                string strpath = strCheminRejet + "Rejets_" + dtTraitementSSIS.ToString("yyyy_MM_dd") + ".csv";

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();
                System.Net.Mail.Attachment fileAttachment = null;

                String SmtpServer = FindConfigParm("COMMUN", "SmtpServer");

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    if (File.Exists(strpath))
                    {
                        fileAttachment = new System.Net.Mail.Attachment(strpath);

                        //Ajout de l'attachements
                        FormatCourrielHtml.Attachments.Add(fileAttachment);
                    }

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("SendMail()", ex.Message.ToString());
                }
            }
        }
        #region ScriptResults declaration
            /// <summary>
            /// This enum provides a convenient shorthand within the scope of this class for setting the
            /// result of the script.
            /// 
            /// This code was generated automatically.
            /// </summary>
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
