                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlModif, mySQLConnection))
                        {
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.Parameters.Add("@dtDebEffect", SqlDbType.DateTime);
                            SQLCommandExec.Parameters["@dtDebEffect"].Value = dtTraitementSSIS;
                            intNbEnrModif = (int)SQLCommandExec.ExecuteScalar();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    intNbEnrModif = -1;
                    InsertTableLogJob("ERR", "UpdateStatRM02(" + pNomFichierTxt + " (Enrg. modifié)");
                }

                // Si aucune erreur de traitement 
                if (intNbEnrDesac != -1 && intNbEnrRejet != -1 && intNbEnrInsert != -1 && intNbEnrModif != -1)
                {
                    pStatutTraitement = "CHARGE";
                }

                UpdateCtrlHebdo(pNomFichierZip, pNomFichierTxt, pStatutTraitement, intNbEnrDesac, intNbEnrRejet, intNbEnrInsert - intNbEnrModif, intNbEnrModif, 0);
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Update les stats de RM01
            ///
            ///////////////////////////////////////////////////////////////////////
            void UpdateStatRM01(string pNomFichierZip, string pNomFichierTxt, string pStatutTraitement)
            {
                int intNbEnrDesac = 0;
                int intNbEnrRejet = 0;
                int intNbEnrInsert = 0;
                int intNbEnrModif = 0;

                string sqlDesac = @"select count(1)
                                    from   [SDEXT01].[CCQ].[RAP_MENS_DET] a
                                    where  a.DEB_EFFECT_DT is not null
                                    and    ISNULL(a.FIN_EFFECT_DT, '1900-01-01') = DATEADD(DAY, -1, @dtDebEffect)
                                    and    not exists(select 1
                                                      from   [SDEXT01].[CCQ].[RAP_MENS_DET] b
                                                      where  b.ACT_SAP_CLE = a.ACT_SAP_CLE
                                                      and    b.DEB_EFFECT_DT = @dtDebEffect) ";

                string sqlRejet = @"select count(1)
                                    from   [SDEXT01].[CFG].[Log_Job_Connecteur]
                                    where  JobName like 'InsertBD_RM01%'
                                    or     JobName like 'LoadFichierRM01%'";

                string sqlInsert = @"select count(1)
                                     from   [SDEXT01].[CCQ].[RAP_MENS_DET] a
                                     where  a.DEB_EFFECT_DT = @dtDebEffect
                                     and    a.FIN_EFFECT_DT is null ";

                string sqlModif = @"select  count(1)
                                    from    [SDEXT01].[CCQ].[RAP_MENS_DET] a
                                    where  a.DEB_EFFECT_DT is not null
                                    and    ISNULL(a.FIN_EFFECT_DT, '1900-01-01') = DATEADD(DAY, -1, @dtDebEffect)
                                    and    exists (select 1
                                                   from   [SDEXT01].[CCQ].[RAP_MENS_DET] b
                                                   where  b.ACT_SAP_CLE = a.ACT_SAP_CLE
                                                   and    b.DEB_EFFECT_DT = @dtDebEffect) ";

                /////////////////////////////////////////////////////////////////////////////////////////////
                // Nombre enregistrement désactivé
                /////////////////////////////////////////////////////////////////////////////////////////////
                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlDesac, mySQLConnection))
                        {
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.Parameters.Add("@dtDebEffect", SqlDbType.DateTime);
                            SQLCommandExec.Parameters["@dtDebEffect"].Value = dtTraitementSSIS;
                            intNbEnrDesac = (int)SQLCommandExec.ExecuteScalar();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    intNbEnrDesac = -1;
                    InsertTableLogJob("ERR", "UpdateStatRM01(" + pNomFichierTxt + " (Enrg. désactivé)");
                }

                /////////////////////////////////////////////////////////////////////////////////////////////
                // Nombre enregistrement rejeté
                /////////////////////////////////////////////////////////////////////////////////////////////
                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlRejet, mySQLConnection))
                        {
                            SQLCommandExec.CommandText = sqlRejet.ToString();
                            SQLCommandExec.CommandTimeout = 12000;
                            intNbEnrRejet = (int)SQLCommandExec.ExecuteScalar();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    intNbEnrRejet = -1;
                    InsertTableLogJob("ERR", "UpdateStatRM01(" + pNomFichierTxt + " (Enrg. rejeté)");
                }

                /////////////////////////////////////////////////////////////////////////////////////////////
                // Nombre enregistrement inséré
                /////////////////////////////////////////////////////////////////////////////////////////////
                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlInsert, mySQLConnection))
                        {
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.Parameters.Add("@dtDebEffect", SqlDbType.DateTime);
                            SQLCommandExec.Parameters["@dtDebEffect"].Value = dtTraitementSSIS;
                            intNbEnrInsert = (int)SQLCommandExec.ExecuteScalar();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    intNbEnrInsert = -1;
                    InsertTableLogJob("ERR", "UpdateStatRM01(" + pNomFichierTxt + " (Enrg. inséré)");
                }

                /////////////////////////////////////////////////////////////////////////////////////////////
                // Nombre enregistrement modifié
                /////////////////////////////////////////////////////////////////////////////////////////////
                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlModif, mySQLConnection))
                        {
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.Parameters.Add("@dtDebEffect", SqlDbType.DateTime);
                            SQLCommandExec.Parameters["@dtDebEffect"].Value = dtTraitementSSIS;
                            intNbEnrModif = (int)SQLCommandExec.ExecuteScalar();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    intNbEnrModif = -1;
                    InsertTableLogJob("ERR", "UpdateStatRM01(" + pNomFichierTxt + " (Enrg. modifié)");
                }

                // Si aucune erreur de traitement 
                if (intNbEnrDesac != -1 && intNbEnrRejet != -1 && intNbEnrInsert != -1 && intNbEnrModif != -1)
                {
                    pStatutTraitement = "CHARGE";
                }

                UpdateCtrlHebdo(pNomFichierZip, pNomFichierTxt, pStatutTraitement, intNbEnrDesac, intNbEnrRejet, intNbEnrInsert - intNbEnrModif, intNbEnrModif, 0);
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Update les stats
            ///
            ///////////////////////////////////////////////////////////////////////
            void UpdateCtrlHebdo(string pNomFichierZip, string pNomFichierTxt, string pStatut,
                                  int intNbDesac, int intNbEnrRejet, int intNbEnrInsert, int intNbEnrModif, int intNbEnrActif)
            {
                int intCmdTrait = 0;

                string strStatutTrait = "";
                string sqlcmd = @"update [SDEXT01].[CCQ].[CTRL_HEBDO] 
                                  set    [CHARG_STATUT_CD] = @strStatut, 
                                         [CHARG_DT] = @dtCharge, 
                                         [ENR_TRAIT_NB] = @intEnrgTraite, 
                                         [ENR_REJET_NB] = @intEnrgRejet, 
                                         [ENR_INSERT_NB] = @intEnrgInsert, 
                                         [ENR_MODIF_NB] = @intEnrgModif, 
                                         [ENR_ACTIF_NB] = @intEnrgActif,
                                         [ENR_DESAC_NB] = @intEnrgDesac
                                  where [FICH_ZIP_NM] = @strZipNm 
                                  and   [FICHIER_NM]  = @strTxtNm ";

                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        SqlTransaction transaction = mySQLConnection.BeginTransaction();

                        if (pStatut != "EN_COURS" && pStatut != "ERREUR")
                        {
                            strStatutTrait = "CHARGE";
                        }
                        else
                        {
                            strStatutTrait = pStatut;

                        }
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlcmd, mySQLConnection, transaction))
                        {
                            //SQLCommandExec.CommandText = sqlTrait.ToString();
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.Parameters.Add("@strStatut", SqlDbType.VarChar, 20);
                            SQLCommandExec.Parameters.Add("@dtCharge", SqlDbType.DateTime);
                            SQLCommandExec.Parameters.Add("@intEnrgTraite", SqlDbType.Int);
                            SQLCommandExec.Parameters.Add("@intEnrgRejet", SqlDbType.Int);
                            SQLCommandExec.Parameters.Add("@intEnrgInsert", SqlDbType.Int);
                            SQLCommandExec.Parameters.Add("@intEnrgModif", SqlDbType.Int);
                            SQLCommandExec.Parameters.Add("@intEnrgActif", SqlDbType.Int);
                            SQLCommandExec.Parameters.Add("@intEnrgDesac", SqlDbType.Int);
                            SQLCommandExec.Parameters.Add("@strZipNm", SqlDbType.VarChar, 100);
                            SQLCommandExec.Parameters.Add("@strTxtNm", SqlDbType.VarChar, 100);


                            SQLCommandExec.Parameters["@strStatut"].Value = pStatut;
                            SQLCommandExec.Parameters["@dtCharge"].Value = dtTraitementSSIS;
                            SQLCommandExec.Parameters["@intEnrgTraite"].Value = intNbEnrRejet + intNbEnrInsert + intNbEnrModif + intNbEnrActif;
                            SQLCommandExec.Parameters["@intEnrgRejet"].Value = intNbEnrRejet;
                            SQLCommandExec.Parameters["@intEnrgInsert"].Value = intNbEnrInsert;
                            SQLCommandExec.Parameters["@intEnrgModif"].Value = intNbEnrModif;
                            SQLCommandExec.Parameters["@intEnrgActif"].Value = intNbEnrActif;
                            SQLCommandExec.Parameters["@intEnrgDesac"].Value = intNbDesac;
                            SQLCommandExec.Parameters["@strZipNm"].Value = pNomFichierZip.Substring(pNomFichierZip.IndexOf("ZK"));
                            SQLCommandExec.Parameters["@strTxtNm"].Value = pNomFichierTxt;

                            intCmdTrait = (int)SQLCommandExec.ExecuteNonQuery();

                            if (intCmdTrait == 0)
                            {
                                InsertTableLogChargement("ERR", "Le nom du fichier ZIP ou TXT n’est pas identique au fichier de contrôle");
                            }
                        }
                        transaction.Commit();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "UpdateCtrlHebdo(" + pNomFichierTxt + ")");
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Chargement_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogChargement(string strIndSystem, string strSqlTable)
            {
                string sqlInsCmd = "insert into [SDEXT01].[CFG].[Log_Chargement_Connecteur] values('TraiteCCQ', '" + strIndSystem + "', '" + strSqlTable + "', GETDATE(), 'CCQ', 'Tâche Automatisée')";

                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerBD))
                    {
                        mySQLConnection.Open();
                        SqlCommand SQLCommandLog = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                        SQLCommandLog.CommandType = CommandType.Text;
                        SQLCommandLog.ExecuteNonQuery();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    //InsertTableLogJob("InsertTableLogChargement()", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Job_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogJob(string pFonction, string pErreurMessage)
            {
                int lParametreErreurMessage;
                pErreurMessage = pErreurMessage.Replace("'", "''");
                lParametreErreurMessage = pErreurMessage.Length;

                if (pErreurMessage.Length > 250)
                {
                    pErreurMessage = pErreurMessage.Substring(0, 245);
                    pErreurMessage = pErreurMessage + "...";
                }

                string sqlInsCmd = "insert into [SDEXT01].[CFG].[Log_Job_Connecteur] values('TraiteCCQ', 'CCQ', null, '" + pFonction + "', 'Erreur', '" + pErreurMessage + "', 'CCQ', GETDATE())";

                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerBD))
                    {
                        mySQLConnection.Open();
                        SqlCommand SQLCommandJob = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                        SQLCommandJob.CommandType = CommandType.Text;
                        SQLCommandJob.CommandTimeout = 12000;
                        SQLCommandJob.ExecuteNonQuery();
                        blErreurExecution = true;
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    //InsertTableLogChargement("ERR", "Impossible d'insérer dans Log_Job_Connecteur");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Si la table existe
            ///
            ///////////////////////////////////////////////////////////////////////
            void IfTableExists(string pNomTableUtilise)
            {
                string sqlCmd = "IF OBJECT_ID('" + pNomTableUtilise.ToString() + "', 'U') IS NOT NULL drop table " + pNomTableUtilise.ToString();

                // Valide si la table existe
                using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                {
                    mySQLConnection.Open();
                    using (SqlCommand checkTableIfExistsCommand = new SqlCommand(sqlCmd, mySQLConnection))
                    {
                        checkTableIfExistsCommand.CommandTimeout = 12000;
                        checkTableIfExistsCommand.ExecuteNonQuery();
                    }
                    mySQLConnection.Close();
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Archive le fichier
            ///
            /////////////////////////////////////////////////////////////////////
            void ArchiveFichier(string de, string a, string pFichierSource, bool supprimeFichier)
            {
                try
                {
                    if (!System.IO.Directory.Exists(a))
                    {
                        System.IO.Directory.CreateDirectory(a);
                    }
                    if (System.IO.File.Exists(a + pFichierSource))
                    {
                        System.IO.File.SetAttributes(a + pFichierSource, FileAttributes.Archive);
                        System.IO.File.Delete(a + pFichierSource);
                    }

                    System.IO.File.Copy(de, a + pFichierSource, true);

                    if (supprimeFichier)
                    {
                        SupprimeFichier(de);
                    }
                }

                catch (IOException ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ArchiveFichier()", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Supprime le fichier
            ///
            /////////////////////////////////////////////////////////////////////
            void SupprimeFichier(string strFchier)
            {
                try
                {
                    if (System.IO.File.Exists(strFchier))
                    {
                        System.IO.File.SetAttributes(strFchier, FileAttributes.Archive);
                        System.IO.File.Delete(strFchier);
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("SupprimeFichier()", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Décompresser les fichiers
            ///
            /////////////////////////////////////////////////////////////////////
            void DecompresseFichier(string strpCheminFchIn, string strpFilename)
            {
                try
                {
                    ZipFile.ExtractToDirectory(strpCheminFchIn + strpFilename, strpCheminFchIn);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("DecompresseFichier()", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Load le fichier dans la BD DCEMP01
            ///
            /////////////////////////////////////////////////////////////////////
            void LoadFichierDCEMP01(string plines, int noLine, DataTable dtDCEMP01, SqlConnection pconn_DCEMP01, SqlTransaction ptran_DCEMP01, string pFichierTXT)
            {

                try
                {
                    string[] strGroupeLineImp = plines.Split('|');
                    if (strGroupeLineImp.Length < 51)
                    {
                        blErreurExecution = true;
                        InsertTableLogJob("LoadFichierDCEMP01() - Ligne :: " + noLine.ToString(), "Le nombre de colonnes requis n’est pas respecté");
                        return;
                    }
                    // Ajout des validations de date pour les champs suivants : DATE_ENREG, DATE_DEB_TRAV, STATUT_JUR_DT, STATUT_AFF_DT et DT_INSOLVABILITE
                    if ((ValideDate(strGroupeLineImp[31], "DATE_ENREG", "LoadFichierDCEMP01()", noLine.ToString(), pFichierTXT) == false) ||
                        (ValideDate(strGroupeLineImp[32], "DATE_DEB_TRAV", "LoadFichierDCEMP01()", noLine.ToString(), pFichierTXT) == false) ||
                        (ValideDate(strGroupeLineImp[35], "STATUT_JUR_DT", "LoadFichierDCEMP01()", noLine.ToString(), pFichierTXT) == false) ||
                        (ValideDate(strGroupeLineImp[38], "STATUT_AFF_DT", "LoadFichierDCEMP01()", noLine.ToString(), pFichierTXT) == false) ||
                        (ValideDate(strGroupeLineImp[47], "DT_INSOLVABILITE", "LoadFichierDCEMP01()", noLine.ToString(), pFichierTXT) == false))
                    {
                        blErreurExecution = true;
                        return;
                    }

                    dtDCEMP01.Rows.Add(
                        strGroupeLineImp[2],
                        DBNull.Value,
                        string.IsNullOrWhiteSpace(strGroupeLineImp[4]) ? strGroupeLineImp[4] : strGroupeLineImp[4].Substring(0, 1),
                        string.IsNullOrWhiteSpace(strGroupeLineImp[5]) ? strGroupeLineImp[5] : strGroupeLineImp[5].Substring(0, 1),
                        strGroupeLineImp[6],
                        strGroupeLineImp[7],
                        strGroupeLineImp[8],
                        strGroupeLineImp[9],
                        strGroupeLineImp[10],
                        string.IsNullOrWhiteSpace(strGroupeLineImp[11]) ? strGroupeLineImp[11] : strGroupeLineImp[11].Substring(0, 2),
                        strGroupeLineImp[12],
                        strGroupeLineImp[13],
                        strGroupeLineImp[14],
                        strGroupeLineImp[15],
                        string.IsNullOrWhiteSpace(strGroupeLineImp[16]) ? strGroupeLineImp[16] : strGroupeLineImp[16].Substring(0, 2),
                        strGroupeLineImp[17],
                        strGroupeLineImp[18],
                        strGroupeLineImp[19],
                        strGroupeLineImp[20],
                        string.IsNullOrWhiteSpace(strGroupeLineImp[21]) ? strGroupeLineImp[21] : strGroupeLineImp[21].Substring(0, 2),
                        strGroupeLineImp[22],
                        strGroupeLineImp[23],
                        strGroupeLineImp[24],
                        strGroupeLineImp[25],
                        strGroupeLineImp[26],
                        strGroupeLineImp[27],
                        strGroupeLineImp[28],
                        strGroupeLineImp[29],
                        strGroupeLineImp[30],
                        string.IsNullOrWhiteSpace(strGroupeLineImp[31]) ? (object)DBNull.Value : Convert.ToDateTime(strGroupeLineImp[31]),
                        string.IsNullOrWhiteSpace(strGroupeLineImp[32]) ? (object)DBNull.Value : Convert.ToDateTime(strGroupeLineImp[32]),
                        strGroupeLineImp[33],
                        strGroupeLineImp[34],
                        string.IsNullOrWhiteSpace(strGroupeLineImp[35]) ? (object)DBNull.Value : Convert.ToDateTime(strGroupeLineImp[35]),
                        strGroupeLineImp[36],
                        strGroupeLineImp[37],
                        string.IsNullOrWhiteSpace(strGroupeLineImp[38]) ? (object)DBNull.Value : Convert.ToDateTime(strGroupeLineImp[38]),
                        string.IsNullOrWhiteSpace(strGroupeLineImp[39]) ? strGroupeLineImp[39] : strGroupeLineImp[39].Substring(0, 1),
                        strGroupeLineImp[40],
                        strGroupeLineImp[41],
                        strGroupeLineImp[42],
                        strGroupeLineImp[43],
                        strGroupeLineImp[44],
                        strGroupeLineImp[45],
                        strGroupeLineImp[46],
                        string.IsNullOrWhiteSpace(strGroupeLineImp[47]) ? (object)DBNull.Value : Convert.ToDateTime(strGroupeLineImp[47]),
                        strGroupeLineImp[48],
                        strGroupeLineImp[49],
                        strGroupeLineImp[50],
                        "O",
                        DBNull.Value,
                        dtTraitementSSIS,
                        DBNull.Value,
                        "ETL_CCQ_SSIS",
                        "ETL_CCQ_SSIS",
                        dtTraitementSSIS,
                        dtTraitementSSIS
                    );

                    // BULK toutes les 100 000 lignes
                    if (dtDCEMP01.Rows.Count >= 100000)
                    {
                        BulkInsertDCEMP01(dtDCEMP01, pconn_DCEMP01, ptran_DCEMP01);
                        dtDCEMP01.Clear();
                    }

                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("LoadFichierDCEMP01() - Ligne :: " + noLine.ToString(), ex.Message.ToString());
                }
            }

