                                ValideSiDoublon("[SDEXT01].[CCQ].[RAP_MENS_DET_tmp]", "[ACT_SAP_CLE], [DEB_EFFECT_DT]", fichier.Name, "[RAP_MENS_DET_ID]", "InsertBD_RM01()");
                                TraiteUpdtInsRM01();
                                UpdateStatRM01(FilesCCQzip[0].Name, fichier.Name, statutRM01);
