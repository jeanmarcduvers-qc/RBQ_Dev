                        }

                        // Traite une deuxième passe pour les insert non traité par la première passe
                        // Delta des inserts updates
                        cmd = new SqlCommand(sqlDeltaInsUpdt, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCEMP02(sqlDeltaInsUpdt2)", ex.Message);
                        }

                        tran.Commit();
                    }
                    catch (Exception ex)
                    {
                        blErreurExecution = true;
                        tran.Rollback();
                        statutDCEMP02 = "ERREUR";
                        InsertTableLogJob("TraiteDeltaDCEMP02", ex.Message);
                        throw;
                    }
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Traite delta DCSAL01
            ///
            /////////////////////////////////////////////////////////////////////
            void TraiteDeltaDCSAL01()
            {
                string sqlDeltaInsUpdt = @"MERGE INTO [SDEXT01].[CCQ].[SALAR_DOSS] AS T
                                            USING [SDEXT01].[CCQ].[SALAR_DOSS_tmp] AS S
                                                ON T.CLIENT_SAL_NO = S.CLIENT_SAL_NO
                                                AND T.ACTIF_IND = 'O'
                                                AND T.FIN_EFFECT_DT IS NULL

                                            WHEN MATCHED AND (
                                                    ISNULL(T.CERT2_ECH_DT, '1900-01-01') <> ISNULL(S.CERT2_ECH_DT, '1900-01-01') OR
                                                    ISNULL(T.DEB_INVAL_DT, '1900-01-01') <> ISNULL(S.DEB_INVAL_DT, '1900-01-01') OR
                                                    ISNULL(T.NOM, '') <> ISNULL(S.NOM, '') OR
                                                    ISNULL(T.PRENOM, '') <> ISNULL(S.PRENOM, '') OR
                                                    ISNULL(T.NAISS_DT, '1900-01-01') <> ISNULL(S.NAISS_DT, '1900-01-01') OR
                                                    ISNULL(T.NAISS_STATUT_CD, '') <> ISNULL(S.NAISS_STATUT_CD, '') OR
                                                    ISNULL(T.GENRE_CD, '') <> ISNULL(S.GENRE_CD, '') OR
                                                    ISNULL(T.CORR_ADR_L1, '') <> ISNULL(S.CORR_ADR_L1, '') OR
                                                    ISNULL(T.CORR_MUN_NM, '') <> ISNULL(S.CORR_MUN_NM, '') OR
                                                    ISNULL(T.CORR_REG_CD, '') <> ISNULL(S.CORR_REG_CD, '') OR
                                                    ISNULL(T.CORR_CP_CD, '') <> ISNULL(S.CORR_CP_CD, '') OR
                                                    ISNULL(T.CORR_PAYS_FR_DESC, '') <> ISNULL(S.CORR_PAYS_FR_DESC, '') OR
                                                    ISNULL(T.CORR_CHG_ADR_DT, '1900-01-01') <> ISNULL(S.CORR_CHG_ADR_DT, '1900-01-01') OR
                                                    ISNULL(T.CORR_NON_LIV_CD, '') <> ISNULL(S.CORR_NON_LIV_CD, '') OR
                                                    ISNULL(T.CORR_NON_LIV_DESC, '') <> ISNULL(S.CORR_NON_LIV_DESC, '') OR
                                                    ISNULL(T.DOM_ADR_L1, '') <> ISNULL(S.DOM_ADR_L1, '') OR
                                                    ISNULL(T.DOM_MUN_NM, '') <> ISNULL(S.DOM_MUN_NM, '') OR
                                                    ISNULL(T.DOM_PROV_CD, '') <> ISNULL(S.DOM_PROV_CD, '') OR
                                                    ISNULL(T.DOM_CP_CD, '') <> ISNULL(S.DOM_CP_CD, '') OR
                                                    ISNULL(T.DOM_PAYS_NM, '') <> ISNULL(S.DOM_PAYS_NM, '') OR
                                                    ISNULL(T.DOM_CHG_ADR_DT, '1900-01-01') <> ISNULL(S.DOM_CHG_ADR_DT, '1900-01-01') OR
                                                    ISNULL(T.TEL_PRINC_NO, '') <> ISNULL(S.TEL_PRINC_NO, '') OR
                                                    ISNULL(T.TEL_AUTRE_NO, '') <> ISNULL(S.TEL_AUTRE_NO, '') OR
                                                    ISNULL(T.REG_ADMIN_CD, '') <> ISNULL(S.REG_ADMIN_CD, '') OR
                                                    ISNULL(T.REG_TRAV_CD, '') <> ISNULL(S.REG_TRAV_CD, '') OR
                                                    ISNULL(T.REG_TRAV_NM, '') <> ISNULL(S.REG_TRAV_NM, '') OR
                                                    ISNULL(T.METIER_PRIO_CD, '') <> ISNULL(S.METIER_PRIO_CD, '') OR
                                                    ISNULL(T.METIER_PRIO_NM, '') <> ISNULL(S.METIER_PRIO_NM, '') OR
                                                    ISNULL(T.EMP_PRF_NO, '') <> ISNULL(S.EMP_PRF_NO, '') OR
                                                    ISNULL(T.CERT1_TYPE_CD, '') <> ISNULL(S.CERT1_TYPE_CD, '') OR
                                                    ISNULL(T.CERT1_ECH_DT, '1900-01-01') <> ISNULL(S.CERT1_ECH_DT, '1900-01-01') OR
                                                    ISNULL(T.CORR_PROV_CD, '') <> ISNULL(S.CORR_PROV_CD, '') OR
                                                    ISNULL(T.CORR_PAYS_NM, '') <> ISNULL(S.CORR_PAYS_NM, '') OR
                                                    ISNULL(T.REG_ADMIN_NM, '') <> ISNULL(S.REG_ADMIN_NM, '') OR
                                                    ISNULL(T.CERT2_TYPE_CD, '') <> ISNULL(S.CERT2_TYPE_CD, '') OR
                                                    ISNULL(T.DECES_PRESUME_DT, '1900-01-01') <> ISNULL(S.DECES_PRESUME_DT, '1900-01-01') OR
                                                    ISNULL(T.DECES_CONFIRME_DT, '1900-01-01') <> ISNULL(S.DECES_CONFIRME_DT, '1900-01-01') OR
                                                    ISNULL(T.ENREG_DT, '1900-01-01') <> ISNULL(S.ENREG_DT, '1900-01-01')
                                                )
                                            THEN UPDATE SET 
                                                    T.FIN_EFFECT_DT = DATEADD(DAY, -1, S.DEB_EFFECT_DT),
                                                    T.ACTIF_IND = 'N'

                                            WHEN NOT MATCHED BY TARGET
                                            THEN INSERT (
                                                    CLIENT_SAL_NO, DEB_EFFECT_DT, FIN_EFFECT_DT, ACTIF_IND,
                                                    CERT2_ECH_DT, DEB_INVAL_DT, NOM, PRENOM, NAISS_DT, NAISS_STATUT_CD,
                                                    GENRE_CD, CORR_ADR_L1, CORR_MUN_NM, CORR_REG_CD, CORR_CP_CD,
                                                    CORR_PAYS_FR_DESC, CORR_CHG_ADR_DT, CORR_NON_LIV_CD, CORR_NON_LIV_DESC,
                                                    DOM_ADR_L1, DOM_MUN_NM, DOM_PROV_CD, DOM_CP_CD, DOM_PAYS_NM,
                                                    DOM_CHG_ADR_DT, TEL_PRINC_NO, TEL_AUTRE_NO, REG_ADMIN_CD, REG_TRAV_CD,
                                                    REG_TRAV_NM, METIER_PRIO_CD, METIER_PRIO_NM, EMP_PRF_NO, CERT1_TYPE_CD,
                                                    CERT1_ECH_DT, CREAT_DT, CREAT_UTIL_ID, MODIF_DT, MODIF_UTIL_ID,
                                                    CORR_PROV_CD, CORR_PAYS_NM, REG_ADMIN_NM, CERT2_TYPE_CD,
                                                    DECES_PRESUME_DT, DECES_CONFIRME_DT, ENREG_DT)
                                            VALUES (
                                                    S.CLIENT_SAL_NO, S.DEB_EFFECT_DT, S.FIN_EFFECT_DT, S.ACTIF_IND,
                                                    S.CERT2_ECH_DT, S.DEB_INVAL_DT, S.NOM, S.PRENOM, S.NAISS_DT,
                                                    S.NAISS_STATUT_CD, S.GENRE_CD, S.CORR_ADR_L1, S.CORR_MUN_NM,
                                                    S.CORR_REG_CD, S.CORR_CP_CD, S.CORR_PAYS_FR_DESC, S.CORR_CHG_ADR_DT,
                                                    S.CORR_NON_LIV_CD, S.CORR_NON_LIV_DESC, S.DOM_ADR_L1, S.DOM_MUN_NM,
                                                    S.DOM_PROV_CD, S.DOM_CP_CD, S.DOM_PAYS_NM, S.DOM_CHG_ADR_DT,
                                                    S.TEL_PRINC_NO, S.TEL_AUTRE_NO, S.REG_ADMIN_CD, S.REG_TRAV_CD,
                                                    S.REG_TRAV_NM, S.METIER_PRIO_CD, S.METIER_PRIO_NM, S.EMP_PRF_NO,
                                                    S.CERT1_TYPE_CD, S.CERT1_ECH_DT, S.CREAT_DT, S.CREAT_UTIL_ID,
                                                    S.MODIF_DT, S.MODIF_UTIL_ID, S.CORR_PROV_CD, S.CORR_PAYS_NM,
                                                    S.REG_ADMIN_NM, S.CERT2_TYPE_CD, S.DECES_PRESUME_DT, S.DECES_CONFIRME_DT, S.ENREG_DT);";

                string sqlDeltaDel = @"MERGE INTO [SDEXT01].[CCQ].[SALAR_DOSS] AS T
                                        USING [SDEXT01].[CCQ].[SALAR_DOSS_tmp] AS S
                                            ON T.CLIENT_SAL_NO = S.CLIENT_SAL_NO

                                        -- Lignes modifiées
                                        WHEN MATCHED AND T.ACTIF_IND = 'O'
	                                        AND T.FIN_EFFECT_DT is null
                                        AND (
                                                    ISNULL(T.CERT2_ECH_DT, '1900-01-01') <> ISNULL(S.CERT2_ECH_DT, '1900-01-01') OR
                                                    ISNULL(T.DEB_INVAL_DT, '1900-01-01') <> ISNULL(S.DEB_INVAL_DT, '1900-01-01') OR
                                                    ISNULL(T.NOM, '') <> ISNULL(S.NOM, '') OR
                                                    ISNULL(T.PRENOM, '') <> ISNULL(S.PRENOM, '') OR
                                                    ISNULL(T.NAISS_DT, '1900-01-01') <> ISNULL(S.NAISS_DT, '1900-01-01') OR
                                                    ISNULL(T.NAISS_STATUT_CD, '') <> ISNULL(S.NAISS_STATUT_CD, '') OR
                                                    ISNULL(T.GENRE_CD, '') <> ISNULL(S.GENRE_CD, '') OR
                                                    ISNULL(T.CORR_ADR_L1, '') <> ISNULL(S.CORR_ADR_L1, '') OR
                                                    ISNULL(T.CORR_MUN_NM, '') <> ISNULL(S.CORR_MUN_NM, '') OR
                                                    ISNULL(T.CORR_REG_CD, '') <> ISNULL(S.CORR_REG_CD, '') OR
                                                    ISNULL(T.CORR_CP_CD, '') <> ISNULL(S.CORR_CP_CD, '') OR
                                                    ISNULL(T.CORR_PAYS_FR_DESC, '') <> ISNULL(S.CORR_PAYS_FR_DESC, '') OR
                                                    ISNULL(T.CORR_CHG_ADR_DT, '1900-01-01') <> ISNULL(S.CORR_CHG_ADR_DT, '1900-01-01') OR
                                                    ISNULL(T.CORR_NON_LIV_CD, '') <> ISNULL(S.CORR_NON_LIV_CD, '') OR
                                                    ISNULL(T.CORR_NON_LIV_DESC, '') <> ISNULL(S.CORR_NON_LIV_DESC, '') OR
                                                    ISNULL(T.DOM_ADR_L1, '') <> ISNULL(S.DOM_ADR_L1, '') OR
                                                    ISNULL(T.DOM_MUN_NM, '') <> ISNULL(S.DOM_MUN_NM, '') OR
                                                    ISNULL(T.DOM_PROV_CD, '') <> ISNULL(S.DOM_PROV_CD, '') OR
                                                    ISNULL(T.DOM_CP_CD, '') <> ISNULL(S.DOM_CP_CD, '') OR
                                                    ISNULL(T.DOM_PAYS_NM, '') <> ISNULL(S.DOM_PAYS_NM, '') OR
                                                    ISNULL(T.DOM_CHG_ADR_DT, '1900-01-01') <> ISNULL(S.DOM_CHG_ADR_DT, '1900-01-01') OR
                                                    ISNULL(T.TEL_PRINC_NO, '') <> ISNULL(S.TEL_PRINC_NO, '') OR
                                                    ISNULL(T.TEL_AUTRE_NO, '') <> ISNULL(S.TEL_AUTRE_NO, '') OR
                                                    ISNULL(T.REG_ADMIN_CD, '') <> ISNULL(S.REG_ADMIN_CD, '') OR
                                                    ISNULL(T.REG_TRAV_CD, '') <> ISNULL(S.REG_TRAV_CD, '') OR
                                                    ISNULL(T.REG_TRAV_NM, '') <> ISNULL(S.REG_TRAV_NM, '') OR
                                                    ISNULL(T.METIER_PRIO_CD, '') <> ISNULL(S.METIER_PRIO_CD, '') OR
                                                    ISNULL(T.METIER_PRIO_NM, '') <> ISNULL(S.METIER_PRIO_NM, '') OR
                                                    ISNULL(T.EMP_PRF_NO, '') <> ISNULL(S.EMP_PRF_NO, '') OR
                                                    ISNULL(T.CERT1_TYPE_CD, '') <> ISNULL(S.CERT1_TYPE_CD, '') OR
                                                    ISNULL(T.CERT1_ECH_DT, '1900-01-01') <> ISNULL(S.CERT1_ECH_DT, '1900-01-01') OR
                                                    ISNULL(T.CORR_PROV_CD, '') <> ISNULL(S.CORR_PROV_CD, '') OR
                                                    ISNULL(T.CORR_PAYS_NM, '') <> ISNULL(S.CORR_PAYS_NM, '') OR
                                                    ISNULL(T.REG_ADMIN_NM, '') <> ISNULL(S.REG_ADMIN_NM, '') OR
                                                    ISNULL(T.CERT2_TYPE_CD, '') <> ISNULL(S.CERT2_TYPE_CD, '') OR
                                                    ISNULL(T.DECES_PRESUME_DT, '1900-01-01') <> ISNULL(S.DECES_PRESUME_DT, '1900-01-01') OR
                                                    ISNULL(T.DECES_CONFIRME_DT, '1900-01-01') <> ISNULL(S.DECES_CONFIRME_DT, '1900-01-01')  OR
                                                    ISNULL(T.ENREG_DT, '1900-01-01') <> ISNULL(S.ENREG_DT, '1900-01-01')
                                            )
                                        THEN UPDATE SET 
                                                T.FIN_EFFECT_DT       = DATEADD(DAY, -1, S.DEB_EFFECT_DT),
		                                        T.ACTIF_IND           = 'N'

                                        -- Lignes à désactiver
                                        WHEN NOT MATCHED BY SOURCE AND T.ACTIF_IND = 'O'
                                        THEN UPDATE SET
                                                T.ACTIF_IND = 'N',
		                                        T.FIN_EFFECT_DT       =DATEADD(DAY, -1, @dtFinEffect),
                                                T.MODIF_DT  = @dtFinEffect; ";

                InsertTableLogChargement("TraiteCCQ", "TraiteDeltaDCSAL01()");

                using (SqlConnection conn = new SqlConnection(strServerBD))
                {
                    conn.Open();
                    SqlTransaction tran = conn.BeginTransaction();

                    try
                    {
                        // Delta des inserts updates
                        SqlCommand cmd = new SqlCommand(sqlDeltaInsUpdt, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCSAL01(sqlDeltaInsUpdt)", ex.Message);
                        }

                        // Delta des deletes
                        cmd = new SqlCommand(sqlDeltaDel, conn, tran);
                        cmd.CommandTimeout = 12000;

                        // Définition des paramètres 
                        cmd.Parameters.Add("@dtFinEffect", SqlDbType.DateTime);
                        cmd.Parameters["@dtFinEffect"].Value = dtTraitementSSIS;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCSAL01(sqlDeltaDel)", ex.Message);
                        }

                        // Traite une deuxième passe pour les insert non traité par la première passe
                        // Delta des inserts updates
                        cmd = new SqlCommand(sqlDeltaInsUpdt, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCSAL01(sqlDeltaInsUpdt2)", ex.Message);
                        }

                        tran.Commit();
                    }
                    catch (Exception ex)
                    {
                        blErreurExecution = true;
                        tran.Rollback();
                        statutDCSAL01 = "ERREUR";
                        InsertTableLogJob("TraiteDeltaDCSAL01", ex.Message);
                        throw;
                    }
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Traite les Updates et les Inserts RM01
            ///
            /////////////////////////////////////////////////////////////////////
            void TraiteUpdtInsRM01()
            {

                string sqlInsertDest = @"insert into [SDEXT01].[CCQ].[RAP_MENS_DET] ([ACT_SAP_CLE], [DEB_EFFECT_DT], [FIN_EFFECT_DT], [ACTIF_IND], [RAP_SAP_CLE], [CLIENT_EMP_NO], [CLIENT_SAL_NO], 
																					   [PER_ENV_DEB_DT], [PER_ENV_FIN_DT], [PERIODE_CD], [PRENOM], [NOM], [SEM_TRAV_NB], [METIER_CD], [METIER_NM], 
																					   [SECTEUR_CD], [SECTEUR_NM], [HRS_SAL_SOM], [STAT_SAL_CD], [TOT_AV_SOC_AMT], [CREAT_DT], [CREAT_UTIL_ID], 
																					   [MODIF_DT], [MODIF_UTIL_ID], [CD_ANNEXE_SAL], [ANNEXE_SAL_DESC], [EMP_CMEQ_IND], [EMP_CMMTQ_IND], 
                                                                                       [REG_ACTV_CD], [REG_ACTV_DESC])
                                                                            select [ACT_SAP_CLE], [DEB_EFFECT_DT], [FIN_EFFECT_DT], [ACTIF_IND], [RAP_SAP_CLE], [CLIENT_EMP_NO], [CLIENT_SAL_NO], 
																					   [PER_ENV_DEB_DT], [PER_ENV_FIN_DT], [PERIODE_CD], [PRENOM], [NOM], [SEM_TRAV_NB], [METIER_CD], [METIER_NM], 
																					   [SECTEUR_CD], [SECTEUR_NM], [HRS_SAL_SOM], [STAT_SAL_CD], [TOT_AV_SOC_AMT], [CREAT_DT], [CREAT_UTIL_ID], 
																					   [MODIF_DT], [MODIF_UTIL_ID], [CD_ANNEXE_SAL], [ANNEXE_SAL_DESC], [EMP_CMEQ_IND], [EMP_CMMTQ_IND], 
                                                                                       [REG_ACTV_CD], [REG_ACTV_DESC]
                                                                                        from [SDEXT01].[CCQ].[RAP_MENS_DET_tmp] where [AJOUT_MOD_IND] = 'A'";


                string sqlUpdateDest = @"UPDATE [SDEXT01].[CCQ].[RAP_MENS_DET]
								         SET FIN_EFFECT_DT = DATEADD(DAY, -1, S.DEB_EFFECT_DT),
                                             ACTIF_IND = 'N',
										     MODIF_DT = S.MODIF_DT
										 FROM [SDEXT01].[CCQ].[RAP_MENS_DET] T
										    JOIN [SDEXT01].[CCQ].[RAP_MENS_DET_tmp] S
											  ON T.ACT_SAP_CLE = S.ACT_SAP_CLE
											     AND T.FIN_EFFECT_DT is null
										  WHERE S.AJOUT_MOD_IND = 'M'";

                string sqlInsertModifDest = @"insert into [SDEXT01].[CCQ].[RAP_MENS_DET] ([ACT_SAP_CLE], [DEB_EFFECT_DT], [FIN_EFFECT_DT], [ACTIF_IND], [RAP_SAP_CLE], [CLIENT_EMP_NO], [CLIENT_SAL_NO], 
																					   [PER_ENV_DEB_DT], [PER_ENV_FIN_DT], [PERIODE_CD], [PRENOM], [NOM], [SEM_TRAV_NB], [METIER_CD], [METIER_NM], 
																					   [SECTEUR_CD], [SECTEUR_NM], [HRS_SAL_SOM], [STAT_SAL_CD], [TOT_AV_SOC_AMT], [CREAT_DT], [CREAT_UTIL_ID], 
																					   [MODIF_DT], [MODIF_UTIL_ID], [CD_ANNEXE_SAL], [ANNEXE_SAL_DESC], [EMP_CMEQ_IND], [EMP_CMMTQ_IND], 
                                                                                       [REG_ACTV_CD], [REG_ACTV_DESC])
                                                                            select [ACT_SAP_CLE], [DEB_EFFECT_DT], [FIN_EFFECT_DT], [ACTIF_IND], [RAP_SAP_CLE], [CLIENT_EMP_NO], [CLIENT_SAL_NO], 
																					   [PER_ENV_DEB_DT], [PER_ENV_FIN_DT], [PERIODE_CD], [PRENOM], [NOM], [SEM_TRAV_NB], [METIER_CD], [METIER_NM], 
																					   [SECTEUR_CD], [SECTEUR_NM], [HRS_SAL_SOM], [STAT_SAL_CD], [TOT_AV_SOC_AMT], [CREAT_DT], [CREAT_UTIL_ID], 
																					   [MODIF_DT], [MODIF_UTIL_ID], [CD_ANNEXE_SAL], [ANNEXE_SAL_DESC], [EMP_CMEQ_IND], [EMP_CMMTQ_IND], 
                                                                                       [REG_ACTV_CD], [REG_ACTV_DESC]
                                                                                        from [SDEXT01].[CCQ].[RAP_MENS_DET_tmp] where [AJOUT_MOD_IND] = 'M'";

                InsertTableLogChargement("TraiteCCQ", "TraiteUpdtInsRM01()");

                using (SqlConnection conn = new SqlConnection(strServerBD))
                {
                    conn.Open();
                    SqlTransaction tran = conn.BeginTransaction();

                    try
                    {
                        // Insertion
                        SqlCommand cmd = new SqlCommand(sqlInsertDest, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteUpdtInsRM01(sqlInsertDest)", ex.Message);
                        }

                        // Update
                        cmd = new SqlCommand(sqlUpdateDest, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteUpdtInsRM01(sqlUpdateDest)", ex.Message);
                        }

                        // Insert les nouvelles modif
                        cmd = new SqlCommand(sqlInsertModifDest, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteUpdtInsRM01(sqlInsertModifDest)", ex.Message);
                        }
                        tran.Commit();
                    }
                    catch (Exception ex)
                    {
                        blErreurExecution = true;
                        tran.Rollback();
                        statutRM01 = "ERREUR";
                        InsertTableLogJob("TraiteUpdtInsRM01", ex.Message);
                        throw;
                    }
                }
            }

            //////////////////////////////////////////////////////////////////////
