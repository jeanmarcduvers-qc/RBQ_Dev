            void LoadFichierRM01(string plines, int noLine, DataTable dtRM01, SqlConnection pconn_RM01, SqlTransaction ptran_RM01)
            {
                string CodeRegionTravail = string.Empty;
                string DescRegionTravail = string.Empty;

                try
                {
                    string[] strGroupeLineImp = plines.Split('|');
                    if (strGroupeLineImp.Length < 26)
                    {
                        blErreurExecution = true;
                        InsertTableLogJob("LoadFichierRM01() - Ligne :: " + noLine.ToString(), "Le nombre de colonnes requis n’est pas respecté");
                        return;
                    }

                    if (dtTraitementSSIS >= DateTime.Parse("2026-03-25"))
                    {
                        CodeRegionTravail = strGroupeLineImp[26];
                        DescRegionTravail = strGroupeLineImp[27];
                    }
                    else
                    {
                        CodeRegionTravail = string.Empty;
                        DescRegionTravail = string.Empty;
                    }

                        dtRM01.Rows.Add(
                            string.IsNullOrWhiteSpace(strGroupeLineImp[0]) ? (object)DBNull.Value : Convert.ToDateTime(strGroupeLineImp[0]),
                            string.IsNullOrWhiteSpace(strGroupeLineImp[1]) ? (object)DBNull.Value : Convert.ToDateTime(strGroupeLineImp[1]),
                            strGroupeLineImp[2],
                            strGroupeLineImp[3],
                            strGroupeLineImp[4],
                            strGroupeLineImp[6],
                            strGroupeLineImp[7],
                            strGroupeLineImp[8],
                            strGroupeLineImp[9],
                            strGroupeLineImp[10],
                            int.TryParse(strGroupeLineImp[13], out int b) ? b : (object)DBNull.Value,
                            strGroupeLineImp[14],
                            strGroupeLineImp[15],
                            strGroupeLineImp[16],
                            strGroupeLineImp[17],
                            decimal.TryParse(strGroupeLineImp[18], NumberStyles.Any, CultureInfo.InvariantCulture, out decimal c) ? c : (object)DBNull.Value,
                            strGroupeLineImp[19],
                            strGroupeLineImp[21],
                            strGroupeLineImp[22],
                            decimal.TryParse(strGroupeLineImp[23], NumberStyles.Any, CultureInfo.InvariantCulture, out decimal d) ? d : (object)DBNull.Value,
                            strGroupeLineImp[24],
                            strGroupeLineImp[25],
                            dtTraitementSSIS,
                            "ETL_CCQ_SSIS",
                            dtTraitementSSIS,
                            "ETL_CCQ_SSIS",
                            dtTraitementSSIS,
                            DBNull.Value,
                            "O",
                            CodeRegionTravail,
                            DescRegionTravail
                        );

                    // BULK toutes les 100 000 lignes
                    if (dtRM01.Rows.Count >= 100000)
                    {
                        BulkInsertRM01(dtRM01, pconn_RM01, ptran_RM01);
                        dtRM01.Clear();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("LoadFichierRM01() - Ligne :: " + noLine.ToString(), ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Load le fichier dans la BD ZK initial et hebdo
            ///
            /////////////////////////////////////////////////////////////////////
            void LoadFichierZK(string[] plines)
            {
                InsertTableLogChargement("TraiteCCQ", "LoadFichierZK");

                bool ifFirstRow = true;
                int noLigne = 0;
                string[] strGroupeLineImp = new string[0];

                try
                {
                    foreach (string line in plines)
                    {
                        if (line.Count(c => c == '|') > 0 && !(ifFirstRow))
                        {
                            strGroupeLineImp = new string[0];
                            strGroupeLineImp = line.ToString().Split('|');
                            noLigne = noLigne + 1;

                            if (int.TryParse(strGroupeLineImp[0], NumberStyles.Any, CultureInfo.InvariantCulture, out int tmpCleRapportCtrl))
                                StructureZK.intCleRapportCtrl.Add(tmpCleRapportCtrl);

                            StructureZK.strAbrev_IG.Add(strGroupeLineImp[1]);
                            StructureZK.strNomFichierZIP.Add(strGroupeLineImp[2]);
                            StructureZK.strDateEnvoi.Add(strGroupeLineImp[3]);
                            StructureZK.strHeure.Add(strGroupeLineImp[4]);
                            StructureZK.strNomFichier.Add(strGroupeLineImp[5]);
                            StructureZK.strDescription.Add(strGroupeLineImp[6]);

                            if (int.TryParse(strGroupeLineImp[7], NumberStyles.Any, CultureInfo.InvariantCulture, out int tmpNombreLignes))
                                StructureZK.intNombreLignes.Add(tmpNombreLignes);
                        }
                        else if (ifFirstRow)
                        {
                            ifFirstRow = false;
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("LoadFichierZK() - Ligne :: " + noLigne.ToString(), ex.Message.ToString());
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Insert dans la BD DCEMP01
            ///
            ///////////////////////////////////////////////////////////////////////
            void BulkInsertDCEMP01(DataTable dt, SqlConnection conn, SqlTransaction tran)
            {
                try
                {
                    using (SqlBulkCopy bulk = new SqlBulkCopy(conn, SqlBulkCopyOptions.TableLock, tran))
                    {
                        bulk.DestinationTableName = "[SDEXT01].[CCQ].[EMPL_DOSS_tmp]";
                        bulk.BatchSize = 100000;
                        bulk.BulkCopyTimeout = 0;

                        // Mappings explicites
                        foreach (DataColumn col in dt.Columns)
                            bulk.ColumnMappings.Add(col.ColumnName, col.ColumnName);

                        bulk.WriteToServer(dt);
                    }
                }
                catch (Exception ex)
                {
                    blErreurExecution = true;
                    tran.Rollback();
                    statutDCEMP01 = "ERREUR";
                    InsertTableLogJob("BulkInsertDCEMP01", ex.Message);
                    throw;
                }
            }
