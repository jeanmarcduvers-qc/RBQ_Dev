                                                ISNULL(T.CORR_VILLE_NM, '') <> ISNULL(S.CORR_VILLE_NM, '') OR
                                                ISNULL(T.CORR_PROV_CD, '') <> ISNULL(S.CORR_PROV_CD, '') OR
                                                ISNULL(T.CORR_CP_CD, '') <> ISNULL(S.CORR_CP_CD, '') OR
                                                ISNULL(T.CORR_PAYS_NM, '') <> ISNULL(S.CORR_PAYS_NM, '') OR
                                                ISNULL(T.BUR_QC_ADR, '') <> ISNULL(S.BUR_QC_ADR, '') OR
                                                ISNULL(T.BUR_QC_VILLE_NM, '') <> ISNULL(S.BUR_QC_VILLE_NM, '') OR
                                                ISNULL(T.BUR_QC_PROV_CD, '') <> ISNULL(S.BUR_QC_PROV_CD, '') OR
                                                ISNULL(T.BUR_QC_CP_CD, '') <> ISNULL(S.BUR_QC_CP_CD, '') OR
                                                ISNULL(T.BUR_QC_PAYS_NM, '') <> ISNULL(S.BUR_QC_PAYS_NM, '') OR
                                                ISNULL(T.BLOC_AFF_ADR_CD, '') <> ISNULL(S.BLOC_AFF_ADR_CD, '') OR
                                                ISNULL(T.BLOC_CORR_ADR_CD, '') <> ISNULL(S.BLOC_CORR_ADR_CD, '') OR
                                                ISNULL(T.BLOC_BUR_ADR_CD, '') <> ISNULL(S.BLOC_BUR_ADR_CD, '') OR
                                                ISNULL(T.TEL_PRINC_NO, '') <> ISNULL(S.TEL_PRINC_NO, '') OR
                                                ISNULL(T.TEL_AUTRE_NO, '') <> ISNULL(S.TEL_AUTRE_NO, '') OR
                                                ISNULL(T.FAX_NO, '') <> ISNULL(S.FAX_NO, '') OR
                                                ISNULL(T.COURRIEL_ADR, '') <> ISNULL(S.COURRIEL_ADR, '') OR
                                                ISNULL(T.STATUT_JUR_CD, '') <> ISNULL(S.STATUT_JUR_CD, '') OR
                                                ISNULL(T.STATUT_JUR_DT, '1900-01-01') <> ISNULL(S.STATUT_JUR_DT, '1900-01-01') OR
                                                ISNULL(T.TYPE_EMP_CD, '') <> ISNULL(S.TYPE_EMP_CD, '') OR
                                                ISNULL(T.STATUT_AFF_CD, '') <> ISNULL(S.STATUT_AFF_CD, '') OR
                                                ISNULL(T.STATUT_AFF_DT, '1900-01-01') <> ISNULL(S.STATUT_AFF_DT, '1900-01-01') OR
                                                ISNULL(T.EMP_RECONNU_IND, '') <> ISNULL(S.EMP_RECONNU_IND, '') OR
                                                ISNULL(T.LIC_CCQ1_TYPE, '') <> ISNULL(S.LIC_CCQ1_TYPE, '') OR
                                                ISNULL(T.LIC_CCQ1_STATUT, '') <> ISNULL(S.LIC_CCQ1_STATUT, '') OR
                                                ISNULL(T.LIC_CCQ2_TYPE, '') <> ISNULL(S.LIC_CCQ2_TYPE, '') OR
                                                ISNULL(T.LIC_CCQ2_STATUT, '') <> ISNULL(S.LIC_CCQ2_STATUT, '') OR
                                                ISNULL(T.NEQ_NO, '') <> ISNULL(S.NEQ_NO, '') OR
                                                ISNULL(T.NEQ_STATUT_CD, '') <> ISNULL(S.NEQ_STATUT_CD, '') OR
                                                ISNULL(T.DT_INSOLVABILITE, '1900-01-01') <> ISNULL(S.DT_INSOLVABILITE, '1900-01-01') OR
                                                ISNULL(T.RAISON_INSOLVABILITE, '') <> ISNULL(S.RAISON_INSOLVABILITE, '') OR
                                                ISNULL(T.NO_EMP_ANCIEN, '') <> ISNULL(S.NO_EMP_ANCIEN, '') OR
                                                ISNULL(T.NO_EMP_NOUVEAU, '') <> ISNULL(S.NO_EMP_NOUVEAU, '') OR
                                                ISNULL(T.LIEU_VERIF_REG, '') <> ISNULL(S.LIEU_VERIF_REG, '') OR
                                                ISNULL(T.DATE_ENREG, '1900-01-01') <> ISNULL(S.DATE_ENREG, '1900-01-01') OR
                                                ISNULL(T.DATE_DEB_TRAV, '1900-01-01') <> ISNULL(S.DATE_DEB_TRAV, '1900-01-01') OR
                                                ISNULL(T.NO_DOSSIER_RBQ, '') <> ISNULL(S.NO_DOSSIER_RBQ, '')
                                            )
                                        THEN UPDATE SET 
                                                T.FIN_EFFECT_DT       = DATEADD(DAY, -1, S.DEB_EFFECT_DT),
		                                        T.ACTIF_IND           = 'N'

                                        -- Lignes à désactiver
                                        WHEN NOT MATCHED BY SOURCE AND T.ACTIF_IND = 'O'
                                        THEN UPDATE SET
                                                T.ACTIF_IND = 'N',
		                                        T.FIN_EFFECT_DT       = DATEADD(DAY, -1, @dtFinEffect),
                                                T.MODIF_DT  = @dtFinEffect; ";

                InsertTableLogChargement("TraiteCCQ", "TraiteDeltaDCEMP01()");

                using (SqlConnection conn = new SqlConnection(strServerBD))
                {
                    conn.Open();
                    SqlTransaction tran = conn.BeginTransaction();

                    try
                    {
                        // Delta des inserts updates
                        SqlCommand cmd = new SqlCommand(sqlDeltaInsUpdt, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCEMP01(sqlDeltaInsUpdt)", ex.Message);
                        }

                        // Delta des deletes
                        cmd = new SqlCommand(sqlDeltaDel, conn, tran);
                        cmd.CommandTimeout = 12000;

                        // Définition des paramètres 
                        cmd.Parameters.Add("@dtFinEffect", SqlDbType.DateTime);
                        cmd.Parameters["@dtFinEffect"].Value = dtTraitementSSIS;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCEMP01(sqlDeltaDel)", ex.Message);
                        }

                        // Traite une deuxième passe pour les insert non traité par la première passe
                        // Delta des inserts updates
                        cmd = new SqlCommand(sqlDeltaInsUpdt, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCEMP01(sqlDeltaInsUpdt2)", ex.Message);
                        }

                        tran.Commit();
                    }
                    catch (Exception ex)
                    {
                        blErreurExecution = true;
                        tran.Rollback();
                        statutDCEMP01 = "ERREUR";
                        InsertTableLogJob("TraiteDeltaDCEMP01", ex.Message);
                        throw;
                    }
                }

            }

