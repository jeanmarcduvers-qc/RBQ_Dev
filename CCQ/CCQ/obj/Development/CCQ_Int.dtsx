                                                    ISNULL(T.ADR, '') <> ISNULL(S.ADR, '') OR
                                                    ISNULL(T.VILLE_NM, '') <> ISNULL(S.VILLE_NM, '') OR
                                                    ISNULL(T.PROV_CD, '') <> ISNULL(S.PROV_CD, '') OR
