                                                    ISNULL(T.TEL_NO, '') <> ISNULL(S.TEL_NO, '') OR
                                                    ISNULL(T.COURRIEL_ADR, '') <> ISNULL(S.COURRIEL_ADR, '') OR
                                                    ISNULL(T.NAISS_DT, '1900-01-01') <> ISNULL(S.NAISS_DT, '1900-01-01') OR
                                                    ISNULL(T.STATUT_REL_CD, '') <> ISNULL(S.STATUT_REL_CD, '') OR
                                                    ISNULL(T.AUTRE_NOM_ENTRP_REL, '') <> ISNULL(S.AUTRE_NOM_ENTRP_REL, '') OR
                                                    ISNULL(T.TEL_AUTRE_NO, '') <> ISNULL(S.TEL_AUTRE_NO, '') OR
                                                    ISNULL(T.FAX_NO, '') <> ISNULL(S.FAX_NO, '') OR
                                                    ISNULL(T.NOTE_TEL, '') <> ISNULL(S.NOTE_TEL, '') OR
                                                    ISNULL(T.NOTE_TEL_AUTRE, '') <> ISNULL(S.NOTE_TEL_AUTRE, '') OR
                                                    ISNULL(T.DT_DEB_VALIDITE, '1900-01-01') <> ISNULL(S.DT_DEB_VALIDITE, '1900-01-01') OR
                                                    ISNULL(T.DT_FIN_VALIDITE, '1900-01-01') <> ISNULL(S.DT_FIN_VALIDITE, '1900-01-01') OR
                                                    ISNULL(T.DT_INSOLVABILITE, '1900-01-01') <> ISNULL(S.DT_INSOLVABILITE, '1900-01-01') OR
                                                    ISNULL(T.DT_DECES, '1900-01-01') <> ISNULL(S.DT_DECES, '1900-01-01') OR
                                                    ISNULL(T.DT_PRESUME_DECES, '1900-01-01') <> ISNULL(S.DT_PRESUME_DECES, '1900-01-01') OR
                                                    ISNULL(T.DT_DEB_FONCTION, '1900-01-01') <> ISNULL(S.DT_DEB_FONCTION, '1900-01-01') OR
                                                    ISNULL(T.DT_FIN_FONCTION, '1900-01-01') <> ISNULL(S.DT_FIN_FONCTION, '1900-01-01') OR
                                                    ISNULL(T.DT_RECEP_DESIGNATION, '1900-01-01') <> ISNULL(S.DT_RECEP_DESIGNATION, '1900-01-01') OR
                                                    ISNULL(T.DT_ENR_DESIGNATION, '1900-01-01') <> ISNULL(S.DT_ENR_DESIGNATION, '1900-01-01')
                                                )
                                            THEN UPDATE SET 
                                                    T.FIN_EFFECT_DT       = DATEADD(DAY, -1, S.DEB_EFFECT_DT),
		                                            T.ACTIF_IND           = 'N'

                                            -- Lignes à insérer
                                            WHEN NOT MATCHED BY TARGET
                                            THEN INSERT (
                                                CLIENT_REL_NO, CLIENT_EMP_NO, DEB_EFFECT_DT, FIN_EFFECT_DT, ACTIF_IND, REG_ADMIN_CD, ENTRP_NM, 
                                                FONCTION_CD, NOM, PRENOM, ENTRP_REL_NM, ADR, VILLE_NM, PROV_CD, CP_CD, PAYS_NM, TEL_NO, COURRIEL_ADR, 
                                                NAISS_DT, STATUT_REL_CD, CREAT_DT, CREAT_UTIL_ID, MODIF_DT, MODIF_UTIL_ID, AUTRE_NOM_ENTRP_REL, TEL_AUTRE_NO, 
                                                FAX_NO, NOTE_TEL, NOTE_TEL_AUTRE, DT_DEB_VALIDITE, DT_FIN_VALIDITE, DT_INSOLVABILITE, DT_DECES, DT_PRESUME_DECES, 
                                                DT_DEB_FONCTION, DT_FIN_FONCTION, DT_RECEP_DESIGNATION, DT_ENR_DESIGNATION)
                                            VALUES (
                                                S.CLIENT_REL_NO, S.CLIENT_EMP_NO, S.DEB_EFFECT_DT, S.FIN_EFFECT_DT, S.ACTIF_IND, S.REG_ADMIN_CD, 
                                                S.ENTRP_NM, S.FONCTION_CD, S.NOM, S.PRENOM, S.ENTRP_REL_NM, S.ADR, S.VILLE_NM, S.PROV_CD, S.CP_CD, 
                                                S.PAYS_NM, S.TEL_NO, S.COURRIEL_ADR, S.NAISS_DT, S.STATUT_REL_CD, S.CREAT_DT, S.CREAT_UTIL_ID, 
                                                S.MODIF_DT, S.MODIF_UTIL_ID, S.AUTRE_NOM_ENTRP_REL, S.TEL_AUTRE_NO, S.FAX_NO, S.NOTE_TEL, 
                                                S.NOTE_TEL_AUTRE, S.DT_DEB_VALIDITE, S.DT_FIN_VALIDITE, S.DT_INSOLVABILITE, S.DT_DECES, 
                                                S.DT_PRESUME_DECES, S.DT_DEB_FONCTION, S.DT_FIN_FONCTION, S.DT_RECEP_DESIGNATION, S.DT_ENR_DESIGNATION);";

                string sqlDeltaDel = @"MERGE INTO [SDEXT01].[CCQ].[EMPL_REL] AS T
