																					, [RAPPORT_NO], [AMEND_NB], [RAP_STATUT_CD], [TYPE_RAP_CD], [ENTRP_NM], [TOT_RM_AMT], [SOLDE_RM_AMT], [TOT_AV_SOC_AMT], [MNT_NET_CARCAP], [AJOUT_MOD_IND]
																					, [SOUM_RM_DT], [TOT_HEURE_RM], [SOLDE_RECL_AMT], [DEB_PER_RECL_DT], [FIN_PER_RECL_DT], [NO_RECLAMATION], [EST_EMP_ENQUETE_IND], [EST_RAP_RETARD_IND]
