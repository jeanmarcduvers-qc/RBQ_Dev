                                                ISNULL(T.DATE_ENREG, '1900-01-01') <> ISNULL(S.DATE_ENREG, '1900-01-01') OR
                                                ISNULL(T.DATE_DEB_TRAV, '1900-01-01') <> ISNULL(S.DATE_DEB_TRAV, '1900-01-01') OR
                                                ISNULL(T.NO_DOSSIER_RBQ, '') <> ISNULL(S.NO_DOSSIER_RBQ, '')
                                                )
                                            THEN UPDATE SET
                                                    T.FIN_EFFECT_DT = DATEADD(DAY, -1, S.DEB_EFFECT_DT),
                                                    T.ACTIF_IND = 'N'

                                            -- Lignes à insérer
                                            WHEN NOT MATCHED BY TARGET
                                            THEN INSERT (
                                                CLIENT_EMP_NO, DEB_EFFECT_DT, FIN_EFFECT_DT, ACTIF_IND, DATE_ENREG, REG_ADMIN_CD, 
                                                CMEQ_IND, CMMTQ_IND, INTERV_NO, ENTRP_NM, ENTRP_AUTRE_NM, AFF_ADR, AFF_VILLE_NM, 
                                                AFF_PROV_CD, AFF_CP_CD, AFF_PAYS_NM, CORR_ADR, CORR_VILLE_NM, CORR_PROV_CD, CORR_CP_CD, 
                                                CORR_PAYS_NM, BUR_QC_ADR, BUR_QC_VILLE_NM, BUR_QC_PROV_CD, BUR_QC_CP_CD, BUR_QC_PAYS_NM, 
                                                BLOC_AFF_ADR_CD, BLOC_CORR_ADR_CD, BLOC_BUR_ADR_CD, TEL_PRINC_NO, TEL_AUTRE_NO, FAX_NO, 
                                                COURRIEL_ADR, STATUT_JUR_CD, STATUT_JUR_DT, TYPE_EMP_CD, STATUT_AFF_CD, STATUT_AFF_DT, 
                                                EMP_RECONNU_IND, LIC_CCQ1_TYPE, LIC_CCQ1_STATUT, LIC_CCQ2_TYPE, LIC_CCQ2_STATUT, NEQ_NO, 
                                                NEQ_STATUT_CD, CREAT_DT, CREAT_UTIL_ID, MODIF_DT, MODIF_UTIL_ID, DT_INSOLVABILITE, 
                                                RAISON_INSOLVABILITE, NO_EMP_ANCIEN, NO_EMP_NOUVEAU, LIEU_VERIF_REG, DATE_DEB_TRAV, NO_DOSSIER_RBQ
                                            )
                                            VALUES (
                                                S.CLIENT_EMP_NO, S.DEB_EFFECT_DT, S.FIN_EFFECT_DT, S.ACTIF_IND, S.DATE_ENREG, S.REG_ADMIN_CD, 
                                                S.CMEQ_IND, S.CMMTQ_IND, S.INTERV_NO, S.ENTRP_NM, S.ENTRP_AUTRE_NM, S.AFF_ADR, S.AFF_VILLE_NM, 
                                                S.AFF_PROV_CD, S.AFF_CP_CD, S.AFF_PAYS_NM, S.CORR_ADR, S.CORR_VILLE_NM, S.CORR_PROV_CD, S.CORR_CP_CD, 
                                                S.CORR_PAYS_NM, S.BUR_QC_ADR, S.BUR_QC_VILLE_NM, S.BUR_QC_PROV_CD, S.BUR_QC_CP_CD, S.BUR_QC_PAYS_NM, 
                                                S.BLOC_AFF_ADR_CD, S.BLOC_CORR_ADR_CD, S.BLOC_BUR_ADR_CD, S.TEL_PRINC_NO, S.TEL_AUTRE_NO, S.FAX_NO, 
                                                S.COURRIEL_ADR, S.STATUT_JUR_CD, S.STATUT_JUR_DT, S.TYPE_EMP_CD, S.STATUT_AFF_CD, S.STATUT_AFF_DT, 
                                                S.EMP_RECONNU_IND, S.LIC_CCQ1_TYPE, S.LIC_CCQ1_STATUT, S.LIC_CCQ2_TYPE, S.LIC_CCQ2_STATUT, S.NEQ_NO, 
                                                S.NEQ_STATUT_CD, S.CREAT_DT, S.CREAT_UTIL_ID, S.MODIF_DT, S.MODIF_UTIL_ID, S.DT_INSOLVABILITE, 
                                                S.RAISON_INSOLVABILITE, S.NO_EMP_ANCIEN, S.NO_EMP_NOUVEAU, S.LIEU_VERIF_REG, S.DATE_DEB_TRAV, S.NO_DOSSIER_RBQ
                                            );";

                string sqlDeltaDel = @"MERGE INTO [SDEXT01].[CCQ].[EMPL_DOSS] AS T
                                        USING [SDEXT01].[CCQ].[EMPL_DOSS_tmp] AS S
                                            ON T.CLIENT_EMP_NO = S.CLIENT_EMP_NO

                                        -- Lignes modifiées
                                        WHEN MATCHED AND T.ACTIF_IND = 'O'
	                                        AND T.FIN_EFFECT_DT is null
                                        AND (
                                                ISNULL(T.REG_ADMIN_CD, '') <> ISNULL(S.REG_ADMIN_CD, '') OR
                                                ISNULL(T.CMEQ_IND, '') <> ISNULL(S.CMEQ_IND, '') OR
                                                ISNULL(T.CMMTQ_IND, '') <> ISNULL(S.CMMTQ_IND, '') OR
                                                ISNULL(T.INTERV_NO, '') <> ISNULL(S.INTERV_NO, '') OR
                                                ISNULL(T.ENTRP_NM, '') <> ISNULL(S.ENTRP_NM, '') OR
                                                ISNULL(T.ENTRP_AUTRE_NM, '') <> ISNULL(S.ENTRP_AUTRE_NM, '') OR
                                                ISNULL(T.AFF_ADR, '') <> ISNULL(S.AFF_ADR, '') OR
                                                ISNULL(T.AFF_VILLE_NM, '') <> ISNULL(S.AFF_VILLE_NM, '') OR
                                                ISNULL(T.AFF_PROV_CD, '') <> ISNULL(S.AFF_PROV_CD, '') OR
                                                ISNULL(T.AFF_CP_CD, '') <> ISNULL(S.AFF_CP_CD, '') OR
                                                ISNULL(T.AFF_PAYS_NM, '') <> ISNULL(S.AFF_PAYS_NM, '') OR
                                                ISNULL(T.CORR_ADR, '') <> ISNULL(S.CORR_ADR, '') OR
                                                ISNULL(T.CORR_VILLE_NM, '') <> ISNULL(S.CORR_VILLE_NM, '') OR
                                                ISNULL(T.CORR_PROV_CD, '') <> ISNULL(S.CORR_PROV_CD, '') OR
                                                ISNULL(T.CORR_CP_CD, '') <> ISNULL(S.CORR_CP_CD, '') OR
                                                ISNULL(T.CORR_PAYS_NM, '') <> ISNULL(S.CORR_PAYS_NM, '') OR
                                                ISNULL(T.BUR_QC_ADR, '') <> ISNULL(S.BUR_QC_ADR, '') OR
                                                ISNULL(T.BUR_QC_VILLE_NM, '') <> ISNULL(S.BUR_QC_VILLE_NM, '') OR
                                                ISNULL(T.BUR_QC_PROV_CD, '') <> ISNULL(S.BUR_QC_PROV_CD, '') OR
                                                ISNULL(T.BUR_QC_CP_CD, '') <> ISNULL(S.BUR_QC_CP_CD, '') OR
                                                ISNULL(T.BUR_QC_PAYS_NM, '') <> ISNULL(S.BUR_QC_PAYS_NM, '') OR
                                                ISNULL(T.BLOC_AFF_ADR_CD, '') <> ISNULL(S.BLOC_AFF_ADR_CD, '') OR
                                                ISNULL(T.BLOC_CORR_ADR_CD, '') <> ISNULL(S.BLOC_CORR_ADR_CD, '') OR
                                                ISNULL(T.BLOC_BUR_ADR_CD, '') <> ISNULL(S.BLOC_BUR_ADR_CD, '') OR
                                                ISNULL(T.TEL_PRINC_NO, '') <> ISNULL(S.TEL_PRINC_NO, '') OR
                                                ISNULL(T.TEL_AUTRE_NO, '') <> ISNULL(S.TEL_AUTRE_NO, '') OR
                                                ISNULL(T.FAX_NO, '') <> ISNULL(S.FAX_NO, '') OR
                                                ISNULL(T.COURRIEL_ADR, '') <> ISNULL(S.COURRIEL_ADR, '') OR
                                                ISNULL(T.STATUT_JUR_CD, '') <> ISNULL(S.STATUT_JUR_CD, '') OR
                                                ISNULL(T.STATUT_JUR_DT, '1900-01-01') <> ISNULL(S.STATUT_JUR_DT, '1900-01-01') OR
                                                ISNULL(T.TYPE_EMP_CD, '') <> ISNULL(S.TYPE_EMP_CD, '') OR
                                                ISNULL(T.STATUT_AFF_CD, '') <> ISNULL(S.STATUT_AFF_CD, '') OR
                                                ISNULL(T.STATUT_AFF_DT, '1900-01-01') <> ISNULL(S.STATUT_AFF_DT, '1900-01-01') OR
                                                ISNULL(T.EMP_RECONNU_IND, '') <> ISNULL(S.EMP_RECONNU_IND, '') OR
                                                ISNULL(T.LIC_CCQ1_TYPE, '') <> ISNULL(S.LIC_CCQ1_TYPE, '') OR
                                                ISNULL(T.LIC_CCQ1_STATUT, '') <> ISNULL(S.LIC_CCQ1_STATUT, '') OR
                                                ISNULL(T.LIC_CCQ2_TYPE, '') <> ISNULL(S.LIC_CCQ2_TYPE, '') OR
                                                ISNULL(T.LIC_CCQ2_STATUT, '') <> ISNULL(S.LIC_CCQ2_STATUT, '') OR
                                                ISNULL(T.NEQ_NO, '') <> ISNULL(S.NEQ_NO, '') OR
                                                ISNULL(T.NEQ_STATUT_CD, '') <> ISNULL(S.NEQ_STATUT_CD, '') OR
                                                ISNULL(T.DT_INSOLVABILITE, '1900-01-01') <> ISNULL(S.DT_INSOLVABILITE, '1900-01-01') OR
                                                ISNULL(T.RAISON_INSOLVABILITE, '') <> ISNULL(S.RAISON_INSOLVABILITE, '') OR
                                                ISNULL(T.NO_EMP_ANCIEN, '') <> ISNULL(S.NO_EMP_ANCIEN, '') OR
                                                ISNULL(T.NO_EMP_NOUVEAU, '') <> ISNULL(S.NO_EMP_NOUVEAU, '') OR
                                                ISNULL(T.LIEU_VERIF_REG, '') <> ISNULL(S.LIEU_VERIF_REG, '') OR
                                                ISNULL(T.DATE_ENREG, '1900-01-01') <> ISNULL(S.DATE_ENREG, '1900-01-01') OR
                                                ISNULL(T.DATE_DEB_TRAV, '1900-01-01') <> ISNULL(S.DATE_DEB_TRAV, '1900-01-01') OR
                                                ISNULL(T.NO_DOSSIER_RBQ, '') <> ISNULL(S.NO_DOSSIER_RBQ, '')
                                            )
                                        THEN UPDATE SET 
                                                T.FIN_EFFECT_DT       = DATEADD(DAY, -1, S.DEB_EFFECT_DT),
		                                        T.ACTIF_IND           = 'N'

                                        -- Lignes à désactiver
                                        WHEN NOT MATCHED BY SOURCE AND T.ACTIF_IND = 'O'
                                        THEN UPDATE SET
                                                T.ACTIF_IND = 'N',
		                                        T.FIN_EFFECT_DT       = DATEADD(DAY, -1, @dtFinEffect),
                                                T.MODIF_DT  = @dtFinEffect; ";

                InsertTableLogChargement("TraiteCCQ", "TraiteDeltaDCEMP01()");

                using (SqlConnection conn = new SqlConnection(strServerBD))
                {
                    conn.Open();
                    SqlTransaction tran = conn.BeginTransaction();

                    try
                    {
                        // Delta des inserts updates
                        SqlCommand cmd = new SqlCommand(sqlDeltaInsUpdt, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCEMP01(sqlDeltaInsUpdt)", ex.Message);
                        }

                        // Delta des deletes
                        cmd = new SqlCommand(sqlDeltaDel, conn, tran);
                        cmd.CommandTimeout = 12000;

                        // Définition des paramètres 
                        cmd.Parameters.Add("@dtFinEffect", SqlDbType.DateTime);
                        cmd.Parameters["@dtFinEffect"].Value = dtTraitementSSIS;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCEMP01(sqlDeltaDel)", ex.Message);
                        }

                        // Traite une deuxième passe pour les insert non traité par la première passe
                        // Delta des inserts updates
                        cmd = new SqlCommand(sqlDeltaInsUpdt, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCEMP01(sqlDeltaInsUpdt2)", ex.Message);
                        }

                        tran.Commit();
                    }
                    catch (Exception ex)
                    {
                        blErreurExecution = true;
                        tran.Rollback();
                        statutDCEMP01 = "ERREUR";
                        InsertTableLogJob("TraiteDeltaDCEMP01", ex.Message);
                        throw;
                    }
                }

            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Traite delta DCEMP02 
            ///
            /////////////////////////////////////////////////////////////////////
            void TraiteDeltaDCEMP02()
            {
                string sqlDeltaInsUpdt = @"MERGE INTO [SDEXT01].[CCQ].[EMPL_REL] AS T
                                            USING [SDEXT01].[CCQ].[EMPL_REL_tmp] AS S
                                                ON T.CLIENT_REL_NO = S.CLIENT_REL_NO
                                                AND T.CLIENT_EMP_NO = S.CLIENT_EMP_NO
                                                AND T.FONCTION_CD = S.FONCTION_CD
                                                AND T.DT_DEB_VALIDITE = S.DT_DEB_VALIDITE
	                                            AND T.FIN_EFFECT_DT is null
   
                                            -- Lignes modifiées
                                            WHEN MATCHED AND (
                                                    ISNULL(T.REG_ADMIN_CD, '') <> ISNULL(S.REG_ADMIN_CD, '') OR
                                                    ISNULL(T.ENTRP_NM, '') <> ISNULL(S.ENTRP_NM, '') OR
                                                    ISNULL(T.NOM, '') <> ISNULL(S.NOM, '') OR
                                                    ISNULL(T.PRENOM, '') <> ISNULL(S.PRENOM, '') OR
                                                    ISNULL(T.ENTRP_REL_NM, '') <> ISNULL(S.ENTRP_REL_NM, '') OR
                                                    ISNULL(T.ADR, '') <> ISNULL(S.ADR, '') OR
                                                    ISNULL(T.VILLE_NM, '') <> ISNULL(S.VILLE_NM, '') OR
                                                    ISNULL(T.PROV_CD, '') <> ISNULL(S.PROV_CD, '') OR
                                                    ISNULL(T.CP_CD, '') <> ISNULL(S.CP_CD, '') OR
                                                    ISNULL(T.PAYS_NM, '') <> ISNULL(S.PAYS_NM, '') OR
                                                    ISNULL(T.TEL_NO, '') <> ISNULL(S.TEL_NO, '') OR
                                                    ISNULL(T.COURRIEL_ADR, '') <> ISNULL(S.COURRIEL_ADR, '') OR
                                                    ISNULL(T.NAISS_DT, '1900-01-01') <> ISNULL(S.NAISS_DT, '1900-01-01') OR
                                                    ISNULL(T.STATUT_REL_CD, '') <> ISNULL(S.STATUT_REL_CD, '') OR
                                                    ISNULL(T.AUTRE_NOM_ENTRP_REL, '') <> ISNULL(S.AUTRE_NOM_ENTRP_REL, '') OR
                                                    ISNULL(T.TEL_AUTRE_NO, '') <> ISNULL(S.TEL_AUTRE_NO, '') OR
                                                    ISNULL(T.FAX_NO, '') <> ISNULL(S.FAX_NO, '') OR
                                                    ISNULL(T.NOTE_TEL, '') <> ISNULL(S.NOTE_TEL, '') OR
                                                    ISNULL(T.NOTE_TEL_AUTRE, '') <> ISNULL(S.NOTE_TEL_AUTRE, '') OR
                                                    ISNULL(T.DT_DEB_VALIDITE, '1900-01-01') <> ISNULL(S.DT_DEB_VALIDITE, '1900-01-01') OR
                                                    ISNULL(T.DT_FIN_VALIDITE, '1900-01-01') <> ISNULL(S.DT_FIN_VALIDITE, '1900-01-01') OR
                                                    ISNULL(T.DT_INSOLVABILITE, '1900-01-01') <> ISNULL(S.DT_INSOLVABILITE, '1900-01-01') OR
                                                    ISNULL(T.DT_DECES, '1900-01-01') <> ISNULL(S.DT_DECES, '1900-01-01') OR
                                                    ISNULL(T.DT_PRESUME_DECES, '1900-01-01') <> ISNULL(S.DT_PRESUME_DECES, '1900-01-01') OR
                                                    ISNULL(T.DT_DEB_FONCTION, '1900-01-01') <> ISNULL(S.DT_DEB_FONCTION, '1900-01-01') OR
                                                    ISNULL(T.DT_FIN_FONCTION, '1900-01-01') <> ISNULL(S.DT_FIN_FONCTION, '1900-01-01') OR
                                                    ISNULL(T.DT_RECEP_DESIGNATION, '1900-01-01') <> ISNULL(S.DT_RECEP_DESIGNATION, '1900-01-01') OR
                                                    ISNULL(T.DT_ENR_DESIGNATION, '1900-01-01') <> ISNULL(S.DT_ENR_DESIGNATION, '1900-01-01')
                                                )
                                            THEN UPDATE SET 
                                                    T.FIN_EFFECT_DT       = DATEADD(DAY, -1, S.DEB_EFFECT_DT),
		                                            T.ACTIF_IND           = 'N'

                                            -- Lignes à insérer
                                            WHEN NOT MATCHED BY TARGET
                                            THEN INSERT (
                                                CLIENT_REL_NO, CLIENT_EMP_NO, DEB_EFFECT_DT, FIN_EFFECT_DT, ACTIF_IND, REG_ADMIN_CD, ENTRP_NM, 
                                                FONCTION_CD, NOM, PRENOM, ENTRP_REL_NM, ADR, VILLE_NM, PROV_CD, CP_CD, PAYS_NM, TEL_NO, COURRIEL_ADR, 
                                                NAISS_DT, STATUT_REL_CD, CREAT_DT, CREAT_UTIL_ID, MODIF_DT, MODIF_UTIL_ID, AUTRE_NOM_ENTRP_REL, TEL_AUTRE_NO, 
                                                FAX_NO, NOTE_TEL, NOTE_TEL_AUTRE, DT_DEB_VALIDITE, DT_FIN_VALIDITE, DT_INSOLVABILITE, DT_DECES, DT_PRESUME_DECES, 
                                                DT_DEB_FONCTION, DT_FIN_FONCTION, DT_RECEP_DESIGNATION, DT_ENR_DESIGNATION)
                                            VALUES (
                                                S.CLIENT_REL_NO, S.CLIENT_EMP_NO, S.DEB_EFFECT_DT, S.FIN_EFFECT_DT, S.ACTIF_IND, S.REG_ADMIN_CD, 
                                                S.ENTRP_NM, S.FONCTION_CD, S.NOM, S.PRENOM, S.ENTRP_REL_NM, S.ADR, S.VILLE_NM, S.PROV_CD, S.CP_CD, 
                                                S.PAYS_NM, S.TEL_NO, S.COURRIEL_ADR, S.NAISS_DT, S.STATUT_REL_CD, S.CREAT_DT, S.CREAT_UTIL_ID, 
                                                S.MODIF_DT, S.MODIF_UTIL_ID, S.AUTRE_NOM_ENTRP_REL, S.TEL_AUTRE_NO, S.FAX_NO, S.NOTE_TEL, 
                                                S.NOTE_TEL_AUTRE, S.DT_DEB_VALIDITE, S.DT_FIN_VALIDITE, S.DT_INSOLVABILITE, S.DT_DECES, 
                                                S.DT_PRESUME_DECES, S.DT_DEB_FONCTION, S.DT_FIN_FONCTION, S.DT_RECEP_DESIGNATION, S.DT_ENR_DESIGNATION);";

                string sqlDeltaDel = @"MERGE INTO [SDEXT01].[CCQ].[EMPL_REL] AS T
                                        USING [SDEXT01].[CCQ].[EMPL_REL_tmp] AS S
                                            ON T.CLIENT_REL_NO = S.CLIENT_REL_NO
                                             AND T.CLIENT_EMP_NO = S.CLIENT_EMP_NO
                                             AND T.DT_DEB_VALIDITE = S.DT_DEB_VALIDITE
                                             AND T.FONCTION_CD = S.FONCTION_CD
                                        -- Lignes modifiées
                                        WHEN MATCHED AND T.ACTIF_IND = 'O'
	                                        AND T.FIN_EFFECT_DT is null
                                        AND (
                                                    ISNULL(T.REG_ADMIN_CD, '') <> ISNULL(S.REG_ADMIN_CD, '') OR
                                                    ISNULL(T.ENTRP_NM, '') <> ISNULL(S.ENTRP_NM, '') OR
                                                    ISNULL(T.NOM, '') <> ISNULL(S.NOM, '') OR
                                                    ISNULL(T.PRENOM, '') <> ISNULL(S.PRENOM, '') OR
