                        InsertTableLogJob("LoadFichierRM01() - Ligne :: " + noLine.ToString(), "Le nombre de colonnes requis n’est pas respecté");
                        return;
                    }
                    if (dtTraitementSSIS >= DateTime.Parse("2026-03-25"))
                    {
                        CodeRegionTravail = strGroupeLineImp[26];
                        DescRegionTravail = strGroupeLineImp[27];
                    }
                    else
                    {
                        CodeRegionTravail = string.Empty;
                        DescRegionTravail = string.Empty;
                    }

                    dtRM01.Rows.Add(
                        string.IsNullOrWhiteSpace(strGroupeLineImp[0]) ? (object)DBNull.Value : Convert.ToDateTime(strGroupeLineImp[0]),
