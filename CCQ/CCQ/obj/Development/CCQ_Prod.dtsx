                                    }
                                }

                                if (dtDCEMP02.Rows.Count > 0)
                                {
                                    BulkInsertDCEMP02(dtDCEMP02, conn_DCEMP02, tran_DCEMP02);
                                    dtDCEMP02.Clear();
                                }

                                tran_DCEMP02.Commit();
                                UpdateRegionAdm("[SDEXT01].[CCQ].[EMPL_REL_tmp]", "[REG_ADMIN_CD]", "[CP_CD]");
                                ValideSiDoublon("[SDEXT01].[CCQ].[EMPL_REL_tmp]", "[CLIENT_REL_NO], [CLIENT_EMP_NO], [FONCTION_CD], [DT_DEB_VALIDITE], [DEB_EFFECT_DT]", fichier.Name, "[EMPL_REL_ID]", "InsertBD_DCEMP02()");
                                TraiteDeltaDCEMP02();
                                UpdateStatDCEMP02(FilesCCQzip[0].Name, fichier.Name, statutDCEMP02);
                                SupprimeFichier(@fichier.FullName);
                                IfTableExists("[SDEXT01].[CCQ].[EMPL_REL_tmp]");
                            }

                            // Lire le répertoire pour le fichier DCSAL01
                            ifFirstline = true;
                            intLineCount = 0;
                            fichiers = new DirectoryInfo(strCheminIn).GetFiles("DCSAL01*.TXT");

                            // Boucle sur le fichier
                            foreach (var fichier in fichiers)
                            {
                                string cheminComplet = fichier.FullName;
                                DateTime dateCreation = fichier.CreationTime;

                                UpdateCtrlHebdo(FilesCCQzip[0].Name, fichier.Name, statutDCSAL01, 0, 0, 0, 0, 0);

                                IfTableExists("[SDEXT01].[CCQ].[SALAR_DOSS_tmp]");
                                ExecuteSQL("CCQ", "select * into [SDEXT01].[CCQ].[SALAR_DOSS_tmp] from [SDEXT01].[CCQ].[SALAR_DOSS] where  1 = 0");
                                DataTable dtDCSAL01 = CreateDataTableDCSAL01();

                                InsertTableLogChargement("TraiteCCQ", "LoadFichierDCSAL01()");
                                SqlConnection conn_DCSAL01 = new SqlConnection(strServerBD);
                                conn_DCSAL01.Open();
                                SqlTransaction tran_DCSAL01 = conn_DCSAL01.BeginTransaction();

                                foreach (var line in File.ReadLines(fichier.FullName, encoding))
                                {
                                    if (ifFirstline)
                                    {
                                        ifFirstline = false;
                                    }
                                    else
                                    {
                                        intLineCount++;
                                        LoadFichierDCSAL01(line, intLineCount, dtDCSAL01, conn_DCSAL01, tran_DCSAL01);
                                    }
                                }

                                if (dtDCSAL01.Rows.Count > 0)
                                {
                                    BulkInsertDCSAL01(dtDCSAL01, conn_DCSAL01, tran_DCSAL01);
                                    dtDCSAL01.Clear();
                                }

                                tran_DCSAL01.Commit();
                                UpdateRegionAdm("[SDEXT01].[CCQ].[SALAR_DOSS_tmp]", "[CORR_REG_CD]", "[CORR_CP_CD]");
                                ValideSiDoublon("[SDEXT01].[CCQ].[SALAR_DOSS_tmp]", "[CLIENT_SAL_NO], [DEB_EFFECT_DT]", fichier.Name, "[SALAR_DOSS_ID]", "InsertBD_DCSAL01()");
                                TraiteDeltaDCSAL01();
                                UpdateStatDCSAL01(FilesCCQzip[0].Name, fichier.Name, statutDCSAL01);
                                SupprimeFichier(@fichier.FullName);
                                IfTableExists("[SDEXT01].[CCQ].[SALAR_DOSS_tmp]");
                            }

                            // Lire le répertoire pour le fichier RM02
                            ifFirstline = true;
                            intLineCount = 0;
                            fichiers = new DirectoryInfo(strCheminIn).GetFiles("RM02_RapportMensuelEntete*.TXT");

                            // Boucle sur le fichier
                            foreach (var fichier in fichiers)
                            {
                                string cheminComplet = fichier.FullName;
                                DateTime dateCreation = fichier.CreationTime;

                                UpdateCtrlHebdo(FilesCCQzip[0].Name, fichier.Name, statutRM02, 0, 0, 0, 0, 0);

                                IfTableExists("[SDEXT01].[CCQ].[RAP_MENS_ENT_tmp]");
                                ExecuteSQL("CCQ", "select * into [SDEXT01].[CCQ].[RAP_MENS_ENT_tmp] from [SDEXT01].[CCQ].[RAP_MENS_ENT] where  1 = 0");
                                DataTable dtRM02 = CreateDataTableRM02();

                                InsertTableLogChargement("TraiteCCQ", "LoadFichierRM02()");
                                SqlConnection conn_RM02 = new SqlConnection(strServerBD);
                                conn_RM02.Open();
                                SqlTransaction tran_RM02 = conn_RM02.BeginTransaction();

                                foreach (var line in File.ReadLines(fichier.FullName, encoding))
                                {
                                    if (ifFirstline)
                                    {
                                        ifFirstline = false;
                                    }
                                    else
                                    {
                                        intLineCount++;
                                        LoadFichierRM02(line, intLineCount, dtRM02, conn_RM02, tran_RM02);
                                    }
                                }

                                if (dtRM02.Rows.Count > 0)
                                {
                                    BulkInsertRM02(dtRM02, conn_RM02, tran_RM02);
                                    dtRM02.Clear();
                                }

                                tran_RM02.Commit();
                                ValideSiDoublon("[SDEXT01].[CCQ].[RAP_MENS_ENT_tmp]", "[RAP_SAP_CLE], [DEB_EFFECT_DT]", fichier.Name, "[RAP_MENS_ENT_ID]", "InsertBD_RM02()");
                                TraiteUpdtInsRM02();
                                UpdateStatRM02(FilesCCQzip[0].Name, fichier.Name, statutRM02);
                                SupprimeFichier(@fichier.FullName);
                                IfTableExists("[SDEXT01].[CCQ].[RAP_MENS_ENT_tmp]");
                            }

                            // Lire le répertoire pour le fichier RM01
                            ifFirstline = true;
                            intLineCount = 0;
                            fichiers = new DirectoryInfo(strCheminIn).GetFiles("RM01_RapportMensuelDetail*.TXT");

                            // Boucle sur le fichier
                            foreach (var fichier in fichiers)
                            {
                                string cheminComplet = fichier.FullName;
                                DateTime dateCreation = fichier.CreationTime;

                                UpdateCtrlHebdo(FilesCCQzip[0].Name, fichier.Name, statutRM01, 0, 0, 0, 0, 0);

                                IfTableExists("[SDEXT01].[CCQ].[RAP_MENS_DET_tmp]");
                                ExecuteSQL("CCQ", "select * into [SDEXT01].[CCQ].[RAP_MENS_DET_tmp] from [SDEXT01].[CCQ].[RAP_MENS_DET] where  1 = 0");
                                ExecuteSQL("CCQ", "ALTER TABLE [SDEXT01].[CCQ].[RAP_MENS_DET_tmp] ADD [AJOUT_MOD_IND] VARCHAR(1)");

                                DataTable dtRM01 = CreateDataTableRM01();

                                InsertTableLogChargement("TraiteCCQ", "LoadFichierRM01()");
                                SqlConnection conn_RM01 = new SqlConnection(strServerBD);
                                conn_RM01.Open();
                                SqlTransaction tran_RM01 = conn_RM01.BeginTransaction();

                                foreach (var line in File.ReadLines(fichier.FullName, encoding))
                                {
                                    if (ifFirstline)
                                    {
                                        ifFirstline = false;
                                    }
                                    else
                                    {
                                        intLineCount++;
                                        LoadFichierRM01(line, intLineCount, dtRM01, conn_RM01, tran_RM01);
                                    }
                                }

                                if (dtRM01.Rows.Count > 0)
                                {
                                    BulkInsertRM01(dtRM01, conn_RM01, tran_RM01);
                                    dtRM01.Clear();
                                }

                                tran_RM01.Commit();
                                ValideSiDoublon("[SDEXT01].[CCQ].[RAP_MENS_DET_tmp]", "[ACT_SAP_CLE], [DEB_EFFECT_DT]", fichier.Name, "[RAP_MENS_DET_ID]", "InsertBD_RM01()");
                                TraiteUpdtInsRM01();
                                UpdateStatRM01(FilesCCQzip[0].Name, fichier.Name, statutRM01);
                                SupprimeFichier(@fichier.FullName);
                                IfTableExists("[SDEXT01].[CCQ].[RAP_MENS_DET_tmp]");
                            }

                            // Exécute l'audit
                            CCQ_Audit();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("TraiteCCQ()", ex.Message.ToString());
                }
            }

            if (blErreurExecution)
            {
                CreerFichierRejet();
                Email_Send();
            }

            if (fichierArchive.ToString() != "")
            {
                ArchiveFichier(strCheminIn + fichierArchive, strCheminFchArch, fichierArchive, true);
            }

            InsertTableLogChargement("TraiteCCQ", "Fin du traitement");

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Récupére les valeurs de la table config
            ///
            ///////////////////////////////////////////////////////////////////////
            string FindConfigParm(string pCdSystem, string pCdParm)
            {
                string sqlCmd = "SELECT parm.valeur_parm as ValeurParm " +
                                "FROM  [SDEXT01].[CFG].[CFG_CONFIG] co, " +
                                      "[SDEXT01].[CFG].[CFG_CONFIG_PARM] parm " +
                                "where co.[CD_SYSTEM] = '" + pCdSystem + "' " +
                                "and   co.[IND_ACTIF] = 'O' " +
                                "and parm.[CD_SYSTEM] = co.[CD_SYSTEM] " +
                                "and parm.[IND_ACTIF] = 'O' " +
                                "and parm.[CD_PARAM] = '" + pCdParm + "'";

                string valParm = "";

                try
                {
                    using (SqlConnection mySQLConnectionParm = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnectionParm.Open();

                        using (SqlCommand SQLCommandCfg = new SqlCommand(sqlCmd.ToString(), mySQLConnectionParm))
                        {

                            SQLCommandCfg.CommandType = CommandType.Text;
                            SqlDataReader readerCfg = SQLCommandCfg.ExecuteReader();
                            readerCfg.Read();
                            valParm = readerCfg["ValeurParm"].ToString();
                            readerCfg.Close();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "FindConfigParm(" + pCdSystem + "." + pCdParm + ")");
                }
                return valParm;
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Récupére les valeurs de la table config
            ///
            ///////////////////////////////////////////////////////////////////////
            bool ValideDate(string pdate, string pNameCol, string pJobName, string valCle, string pNomFichier)
            {

                // Date SQL Server min
                DateTime minSqlDate = new DateTime(1753, 1, 1);
                // Date SQL Server max
                DateTime maxSqlDate = new DateTime(9999, 12, 31);

                // Null ou vide → invalide
                if (string.IsNullOrWhiteSpace(pdate))
                {
                    // journaliser la ligne fautive (date vide)
                    return true;
                }

                // Conversion string → DateTime
                if (!DateTime.TryParse(pdate, out DateTime dt))
                {
                    // journaliser la ligne fautive (format invalide)
                    blErreurExecution = true;
                    InsertTableLogJob(pJobName, "Le format de la date est invalide " + pNomFichier + " pour la ligne (" + valCle + ") colonne (" + pNameCol + ")");
                    return false;
                }

                // Vérification plage SQL Server
                if (dt < minSqlDate || dt > maxSqlDate)
                {
                    // journaliser la ligne fautive (date hors plage SQL)
                    blErreurExecution = true;
                    InsertTableLogJob(pJobName, "Doit être compris entre 1/1/1753 12:00:00 AM et 31/12/9999 11:59:59 PM. fichier (" + pNomFichier + ") pour la ligne (" + valCle + ") colonne (" + pNameCol + ")");
                    return false;
                }

                return true;
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Valide s'il y a des doublons et nettoyer
            ///
            ///////////////////////////////////////////////////////////////////////
            void ValideSiDoublon(string pNomTable, string pNomCol, string pNomFichier, string pColId, string pJobName)
            {
                string sqlCmd = @"SELECT " + pNomCol + @", count(1) as nbRecord
                                  FROM   " + pNomTable +
                               @" group  by " + pNomCol +
                               @" having count(1) > 1";

                string sqlDel = @"WITH CTE AS
                                    (
                                        SELECT *,
                                               ROW_NUMBER() OVER (
                                                   PARTITION BY " + pNomCol +
                                                @" ORDER BY " + pColId + @" asc
                                               ) AS rn
                                        FROM " + pNomTable +
                                   @")
                                    DELETE FROM CTE
                                    WHERE rn > 1 ";
                bool blDoublon = false;
                try
                {
                    using (SqlConnection mySQLConnectionParm = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnectionParm.Open();

                        using (SqlCommand SQLCommandDbl = new SqlCommand(sqlCmd.ToString(), mySQLConnectionParm))
                        {
                            SQLCommandDbl.CommandType = CommandType.Text;

                            using (SqlDataReader readerDbl = SQLCommandDbl.ExecuteReader())
                            {
                                while (readerDbl.Read())
                                {
                                    string valCle = readerDbl[0].ToString();
                                    blDoublon = true;
                                    blErreurExecution = true;
                                    for (int i = 0; i < (Convert.ToInt32(readerDbl["nbRecord"]) - 1); i++)
                                    {
                                        InsertTableLogJob(pJobName, "Il y a un doublon dans le fichier " + pNomFichier + " pour le code ( " + valCle + ")");
                                    }
                                }
                            }
                        }

                        // delete les doubons
                        if (blDoublon)
                        {
                            using (SqlCommand SQLCommandExec = new SqlCommand(sqlDel, mySQLConnectionParm))
                            {
                                SQLCommandExec.CommandText = sqlDel.ToString();
                                SQLCommandExec.CommandTimeout = 12000;
                                SQLCommandExec.ExecuteNonQuery();
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "ValideSiDoublon(" + pNomTable + "." + pNomCol + ")");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Update région administrative
            ///
            ///////////////////////////////////////////////////////////////////////
            void UpdateRegionAdm(string ptable, string pColonne, string pCpCD)
            {
                string sqlCmd = "update " + ptable.ToString() + " " +
                                "set " + pColonne.ToString() + " = (select top 1 mun.DR_C_REGN_ADMN " +
                                                                   "from [SDGIC01].[DRT].[DR1_CODE_POST] cdp " +
                                                                         "inner join [SDGIC01].[DRT].[DR1_MUNC]  mun on mun.DR_C_MUNC = cdp.DR_C_MUNC " +
                                                                   "where cdp.DR_C_POST_MUNC = replace(" + ptable.ToString() + "." + pCpCD.ToString() + ", ' ', '')) ";

                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        SqlTransaction transaction = mySQLConnection.BeginTransaction();
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlCmd, mySQLConnection, transaction))
                        {
                            SQLCommandExec.CommandText = @sqlCmd.ToString();
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.ExecuteNonQuery();
                        }
                        transaction.Commit();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "UpdateRegionAdm(" + ptable + "." + pColonne + ")");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Update les stats de DCEMP01
            ///
            ///////////////////////////////////////////////////////////////////////
            ////////////////////////////////////////////////////////////////////////
            ///
            //     Update les stats de DCEMP01
            ///
            ///////////////////////////////////////////////////////////////////////
            void UpdateStatDCEMP01(string pNomFichierZip, string pNomFichierTxt, string pStatutTraitement)
            {
                int intNbEnrDesac = 0;
                int intNbEnrRejet = 0;
                int intNbEnrInsert = 0;
                int intNbEnrModif = 0;
                int intNbEnrActif = 0;

                string sqlDesac = @"select count(1)
                                    from   [SDEXT01].[CCQ].[EMPL_DOSS] a
                                    where  a.DEB_EFFECT_DT is not null
                                    and    ISNULL(a.FIN_EFFECT_DT, '1900-01-01') = DATEADD(DAY, -1, @dtDebEffect)
                                    and    not exists(select 1
                                                      from   [SDEXT01].[CCQ].[EMPL_DOSS] b
                                                      where  b.CLIENT_EMP_NO = a.CLIENT_EMP_NO
                                                      and    b.DEB_EFFECT_DT = @dtDebEffect) ";

                string sqlRejet = @"select count(1)
                                    from   [SDEXT01].[CFG].[Log_Job_Connecteur]
                                    where  JobName like 'InsertBD_DCEMP01%'
                                    or     JobName like 'LoadFichierDCEMP01%'";

                string sqlInsert = @"select count(1)
                                     from   [SDEXT01].[CCQ].[EMPL_DOSS] a
                                     where  a.DEB_EFFECT_DT = @dtDebEffect
                                     and    a.FIN_EFFECT_DT is null ";

                string sqlActif = @"select count(1)
                                     from   [SDEXT01].[CCQ].[EMPL_DOSS] a
                                     where  a.DEB_EFFECT_DT != @dtDebEffect
                                     and    a.FIN_EFFECT_DT is null ";

                string sqlModif = @"select  count(1)
                                    from    [SDEXT01].[CCQ].[EMPL_DOSS] a
                                    where  a.DEB_EFFECT_DT is not null
                                    and    ISNULL(a.FIN_EFFECT_DT, '1900-01-01') = DATEADD(DAY, -1, @dtDebEffect)
                                    and    exists (select 1
                                                   from   [SDEXT01].[CCQ].[EMPL_DOSS] b
                                                   where  b.CLIENT_EMP_NO = a.CLIENT_EMP_NO
                                                   and    b.DEB_EFFECT_DT = @dtDebEffect) ";

                /////////////////////////////////////////////////////////////////////////////////////////////
                // Nombre enregistrement désactivé
                /////////////////////////////////////////////////////////////////////////////////////////////
                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlDesac, mySQLConnection))
                        {
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.Parameters.Add("@dtDebEffect", SqlDbType.DateTime);
                            SQLCommandExec.Parameters["@dtDebEffect"].Value = dtTraitementSSIS;
                            intNbEnrDesac = (int)SQLCommandExec.ExecuteScalar();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    intNbEnrDesac = -1;
                    InsertTableLogJob("ERR", "UpdateStatDCEMP01(" + pNomFichierTxt + " (Enrg. désactivé)");
                }

                /////////////////////////////////////////////////////////////////////////////////////////////
                // Nombre enregistrement rejeté
                /////////////////////////////////////////////////////////////////////////////////////////////
                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlRejet, mySQLConnection))
                        {
                            SQLCommandExec.CommandText = sqlRejet.ToString();
                            SQLCommandExec.CommandTimeout = 12000;
                            intNbEnrRejet = (int)SQLCommandExec.ExecuteScalar();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    intNbEnrRejet = -1;
                    InsertTableLogJob("ERR", "UpdateStatDCEMP01(" + pNomFichierTxt + " (Enrg. rejeté)");
                }

                /////////////////////////////////////////////////////////////////////////////////////////////
                // Nombre enregistrement inséré
                /////////////////////////////////////////////////////////////////////////////////////////////
                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlInsert, mySQLConnection))
                        {
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.Parameters.Add("@dtDebEffect", SqlDbType.DateTime);
                            SQLCommandExec.Parameters["@dtDebEffect"].Value = dtTraitementSSIS;
                            intNbEnrInsert = (int)SQLCommandExec.ExecuteScalar();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    intNbEnrInsert = -1;
                    InsertTableLogJob("ERR", "UpdateStatDCEMP01(" + pNomFichierTxt + " (Enrg. inséré)");
                }

                /////////////////////////////////////////////////////////////////////////////////////////////
                // Nombre enregistrement actif
                /////////////////////////////////////////////////////////////////////////////////////////////
                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlActif, mySQLConnection))
                        {
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.Parameters.Add("@dtDebEffect", SqlDbType.DateTime);
                            SQLCommandExec.Parameters["@dtDebEffect"].Value = dtTraitementSSIS;
                            intNbEnrActif = (int)SQLCommandExec.ExecuteScalar();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    intNbEnrInsert = -1;
                    InsertTableLogJob("ERR", "UpdateStatDCEMP01(" + pNomFichierTxt + " (Enrg. actif)");
                }
                /////////////////////////////////////////////////////////////////////////////////////////////
                // Nombre enregistrement modifié
                /////////////////////////////////////////////////////////////////////////////////////////////
                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlModif, mySQLConnection))
                        {
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.Parameters.Add("@dtDebEffect", SqlDbType.DateTime);
                            SQLCommandExec.Parameters["@dtDebEffect"].Value = dtTraitementSSIS;
                            intNbEnrModif = (int)SQLCommandExec.ExecuteScalar();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    intNbEnrModif = -1;
                    InsertTableLogJob("ERR", "UpdateStatDCEMP01(" + pNomFichierTxt + " (Enrg. modifié)");
                }

                // Si aucune erreur de traitement 
                if (intNbEnrDesac != -1 && intNbEnrRejet != -1 && intNbEnrInsert != -1 && intNbEnrModif != -1)
                {
                    pStatutTraitement = "CHARGE";
                }

                UpdateCtrlHebdo(pNomFichierZip, pNomFichierTxt, pStatutTraitement, intNbEnrDesac, intNbEnrRejet, intNbEnrInsert - intNbEnrModif, intNbEnrModif, intNbEnrActif);
            }

