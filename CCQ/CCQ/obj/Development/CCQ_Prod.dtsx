                                                    ISNULL(T.ADR, '') <> ISNULL(S.ADR, '') OR
                                                    ISNULL(T.VILLE_NM, '') <> ISNULL(S.VILLE_NM, '') OR
                                                    ISNULL(T.PROV_CD, '') <> ISNULL(S.PROV_CD, '') OR
                                                    ISNULL(T.CP_CD, '') <> ISNULL(S.CP_CD, '') OR
                                                    ISNULL(T.PAYS_NM, '') <> ISNULL(S.PAYS_NM, '') OR
                                                    ISNULL(T.TEL_NO, '') <> ISNULL(S.TEL_NO, '') OR
                                                    ISNULL(T.COURRIEL_ADR, '') <> ISNULL(S.COURRIEL_ADR, '') OR
                                                    ISNULL(T.NAISS_DT, '1900-01-01') <> ISNULL(S.NAISS_DT, '1900-01-01') OR
                                                    ISNULL(T.STATUT_REL_CD, '') <> ISNULL(S.STATUT_REL_CD, '') OR
                                                    ISNULL(T.AUTRE_NOM_ENTRP_REL, '') <> ISNULL(S.AUTRE_NOM_ENTRP_REL, '') OR
                                                    ISNULL(T.TEL_AUTRE_NO, '') <> ISNULL(S.TEL_AUTRE_NO, '') OR
                                                    ISNULL(T.FAX_NO, '') <> ISNULL(S.FAX_NO, '') OR
                                                    ISNULL(T.NOTE_TEL, '') <> ISNULL(S.NOTE_TEL, '') OR
                                                    ISNULL(T.NOTE_TEL_AUTRE, '') <> ISNULL(S.NOTE_TEL_AUTRE, '') OR
                                                    ISNULL(T.DT_DEB_VALIDITE, '1900-01-01') <> ISNULL(S.DT_DEB_VALIDITE, '1900-01-01') OR
                                                    ISNULL(T.DT_FIN_VALIDITE, '1900-01-01') <> ISNULL(S.DT_FIN_VALIDITE, '1900-01-01') OR
                                                    ISNULL(T.DT_INSOLVABILITE, '1900-01-01') <> ISNULL(S.DT_INSOLVABILITE, '1900-01-01') OR
                                                    ISNULL(T.DT_DECES, '1900-01-01') <> ISNULL(S.DT_DECES, '1900-01-01') OR
                                                    ISNULL(T.DT_PRESUME_DECES, '1900-01-01') <> ISNULL(S.DT_PRESUME_DECES, '1900-01-01') OR
                                                    ISNULL(T.DT_DEB_FONCTION, '1900-01-01') <> ISNULL(S.DT_DEB_FONCTION, '1900-01-01') OR
                                                    ISNULL(T.DT_FIN_FONCTION, '1900-01-01') <> ISNULL(S.DT_FIN_FONCTION, '1900-01-01') OR
                                                    ISNULL(T.DT_RECEP_DESIGNATION, '1900-01-01') <> ISNULL(S.DT_RECEP_DESIGNATION, '1900-01-01') OR
                                                    ISNULL(T.DT_ENR_DESIGNATION, '1900-01-01') <> ISNULL(S.DT_ENR_DESIGNATION, '1900-01-01')
                                            )
                                        THEN UPDATE SET 
                                                T.FIN_EFFECT_DT       = DATEADD(DAY, -1, S.DEB_EFFECT_DT),
		                                        T.ACTIF_IND           = 'N'

                                        -- Lignes à désactiver
                                        WHEN NOT MATCHED BY SOURCE AND T.ACTIF_IND = 'O'
                                        THEN UPDATE SET
                                                T.ACTIF_IND = 'N',
		                                        T.FIN_EFFECT_DT       = DATEADD(DAY, -1, @dtFinEffect),
                                                T.MODIF_DT  = @dtFinEffect; ";

                InsertTableLogChargement("TraiteCCQ", "TraiteDeltaDCEMP02()");

                using (SqlConnection conn = new SqlConnection(strServerBD))
                {
                    conn.Open();
                    SqlTransaction tran = conn.BeginTransaction();

                    try
                    {
                        // Delta des inserts updates
                        SqlCommand cmd = new SqlCommand(sqlDeltaInsUpdt, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCEMP02(sqlDeltaInsUpdt)", ex.Message);
                        }

                        // Delta des deletes
                        cmd = new SqlCommand(sqlDeltaDel, conn, tran);
                        cmd.CommandTimeout = 12000;

                        // Définition des paramètres 
                        cmd.Parameters.Add("@dtFinEffect", SqlDbType.DateTime);
                        cmd.Parameters["@dtFinEffect"].Value = dtTraitementSSIS;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCEMP02(sqlDeltaDel)", ex.Message);
                        }

                        // Traite une deuxième passe pour les insert non traité par la première passe
                        // Delta des inserts updates
                        cmd = new SqlCommand(sqlDeltaInsUpdt, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCEMP02(sqlDeltaInsUpdt2)", ex.Message);
                        }

                        tran.Commit();
                    }
                    catch (Exception ex)
                    {
                        blErreurExecution = true;
                        tran.Rollback();
                        statutDCEMP02 = "ERREUR";
                        InsertTableLogJob("TraiteDeltaDCEMP02", ex.Message);
                        throw;
                    }
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Traite delta DCSAL01
            ///
            /////////////////////////////////////////////////////////////////////
            void TraiteDeltaDCSAL01()
            {
                string sqlDeltaInsUpdt = @"MERGE INTO [SDEXT01].[CCQ].[SALAR_DOSS] AS T
                                            USING [SDEXT01].[CCQ].[SALAR_DOSS_tmp] AS S
                                                ON T.CLIENT_SAL_NO = S.CLIENT_SAL_NO
                                                AND T.ACTIF_IND = 'O'
                                                AND T.FIN_EFFECT_DT IS NULL

                                            WHEN MATCHED AND (
                                                    ISNULL(T.CERT2_ECH_DT, '1900-01-01') <> ISNULL(S.CERT2_ECH_DT, '1900-01-01') OR
                                                    ISNULL(T.DEB_INVAL_DT, '1900-01-01') <> ISNULL(S.DEB_INVAL_DT, '1900-01-01') OR
                                                    ISNULL(T.NOM, '') <> ISNULL(S.NOM, '') OR
                                                    ISNULL(T.PRENOM, '') <> ISNULL(S.PRENOM, '') OR
                                                    ISNULL(T.NAISS_DT, '1900-01-01') <> ISNULL(S.NAISS_DT, '1900-01-01') OR
                                                    ISNULL(T.NAISS_STATUT_CD, '') <> ISNULL(S.NAISS_STATUT_CD, '') OR
                                                    ISNULL(T.GENRE_CD, '') <> ISNULL(S.GENRE_CD, '') OR
                                                    ISNULL(T.CORR_ADR_L1, '') <> ISNULL(S.CORR_ADR_L1, '') OR
                                                    ISNULL(T.CORR_MUN_NM, '') <> ISNULL(S.CORR_MUN_NM, '') OR
                                                    ISNULL(T.CORR_REG_CD, '') <> ISNULL(S.CORR_REG_CD, '') OR
                                                    ISNULL(T.CORR_CP_CD, '') <> ISNULL(S.CORR_CP_CD, '') OR
                                                    ISNULL(T.CORR_PAYS_FR_DESC, '') <> ISNULL(S.CORR_PAYS_FR_DESC, '') OR
                                                    ISNULL(T.CORR_CHG_ADR_DT, '1900-01-01') <> ISNULL(S.CORR_CHG_ADR_DT, '1900-01-01') OR
                                                    ISNULL(T.CORR_NON_LIV_CD, '') <> ISNULL(S.CORR_NON_LIV_CD, '') OR
                                                    ISNULL(T.CORR_NON_LIV_DESC, '') <> ISNULL(S.CORR_NON_LIV_DESC, '') OR
                                                    ISNULL(T.DOM_ADR_L1, '') <> ISNULL(S.DOM_ADR_L1, '') OR
                                                    ISNULL(T.DOM_MUN_NM, '') <> ISNULL(S.DOM_MUN_NM, '') OR
                                                    ISNULL(T.DOM_PROV_CD, '') <> ISNULL(S.DOM_PROV_CD, '') OR
                                                    ISNULL(T.DOM_CP_CD, '') <> ISNULL(S.DOM_CP_CD, '') OR
                                                    ISNULL(T.DOM_PAYS_NM, '') <> ISNULL(S.DOM_PAYS_NM, '') OR
                                                    ISNULL(T.DOM_CHG_ADR_DT, '1900-01-01') <> ISNULL(S.DOM_CHG_ADR_DT, '1900-01-01') OR
                                                    ISNULL(T.TEL_PRINC_NO, '') <> ISNULL(S.TEL_PRINC_NO, '') OR
                                                    ISNULL(T.TEL_AUTRE_NO, '') <> ISNULL(S.TEL_AUTRE_NO, '') OR
                                                    ISNULL(T.REG_ADMIN_CD, '') <> ISNULL(S.REG_ADMIN_CD, '') OR
                                                    ISNULL(T.REG_TRAV_CD, '') <> ISNULL(S.REG_TRAV_CD, '') OR
                                                    ISNULL(T.REG_TRAV_NM, '') <> ISNULL(S.REG_TRAV_NM, '') OR
                                                    ISNULL(T.METIER_PRIO_CD, '') <> ISNULL(S.METIER_PRIO_CD, '') OR
                                                    ISNULL(T.METIER_PRIO_NM, '') <> ISNULL(S.METIER_PRIO_NM, '') OR
                                                    ISNULL(T.EMP_PRF_NO, '') <> ISNULL(S.EMP_PRF_NO, '') OR
                                                    ISNULL(T.CERT1_TYPE_CD, '') <> ISNULL(S.CERT1_TYPE_CD, '') OR
                                                    ISNULL(T.CERT1_ECH_DT, '1900-01-01') <> ISNULL(S.CERT1_ECH_DT, '1900-01-01') OR
                                                    ISNULL(T.CORR_PROV_CD, '') <> ISNULL(S.CORR_PROV_CD, '') OR
                                                    ISNULL(T.CORR_PAYS_NM, '') <> ISNULL(S.CORR_PAYS_NM, '') OR
                                                    ISNULL(T.REG_ADMIN_NM, '') <> ISNULL(S.REG_ADMIN_NM, '') OR
                                                    ISNULL(T.CERT2_TYPE_CD, '') <> ISNULL(S.CERT2_TYPE_CD, '') OR
                                                    ISNULL(T.DECES_PRESUME_DT, '1900-01-01') <> ISNULL(S.DECES_PRESUME_DT, '1900-01-01') OR
                                                    ISNULL(T.DECES_CONFIRME_DT, '1900-01-01') <> ISNULL(S.DECES_CONFIRME_DT, '1900-01-01') OR
                                                    ISNULL(T.ENREG_DT, '1900-01-01') <> ISNULL(S.ENREG_DT, '1900-01-01')
                                                )
                                            THEN UPDATE SET 
                                                    T.FIN_EFFECT_DT = DATEADD(DAY, -1, S.DEB_EFFECT_DT),
                                                    T.ACTIF_IND = 'N'

                                            WHEN NOT MATCHED BY TARGET
                                            THEN INSERT (
                                                    CLIENT_SAL_NO, DEB_EFFECT_DT, FIN_EFFECT_DT, ACTIF_IND,
                                                    CERT2_ECH_DT, DEB_INVAL_DT, NOM, PRENOM, NAISS_DT, NAISS_STATUT_CD,
                                                    GENRE_CD, CORR_ADR_L1, CORR_MUN_NM, CORR_REG_CD, CORR_CP_CD,
                                                    CORR_PAYS_FR_DESC, CORR_CHG_ADR_DT, CORR_NON_LIV_CD, CORR_NON_LIV_DESC,
                                                    DOM_ADR_L1, DOM_MUN_NM, DOM_PROV_CD, DOM_CP_CD, DOM_PAYS_NM,
                                                    DOM_CHG_ADR_DT, TEL_PRINC_NO, TEL_AUTRE_NO, REG_ADMIN_CD, REG_TRAV_CD,
                                                    REG_TRAV_NM, METIER_PRIO_CD, METIER_PRIO_NM, EMP_PRF_NO, CERT1_TYPE_CD,
                                                    CERT1_ECH_DT, CREAT_DT, CREAT_UTIL_ID, MODIF_DT, MODIF_UTIL_ID,
                                                    CORR_PROV_CD, CORR_PAYS_NM, REG_ADMIN_NM, CERT2_TYPE_CD,
                                                    DECES_PRESUME_DT, DECES_CONFIRME_DT, ENREG_DT)
                                            VALUES (
                                                    S.CLIENT_SAL_NO, S.DEB_EFFECT_DT, S.FIN_EFFECT_DT, S.ACTIF_IND,
                                                    S.CERT2_ECH_DT, S.DEB_INVAL_DT, S.NOM, S.PRENOM, S.NAISS_DT,
                                                    S.NAISS_STATUT_CD, S.GENRE_CD, S.CORR_ADR_L1, S.CORR_MUN_NM,
                                                    S.CORR_REG_CD, S.CORR_CP_CD, S.CORR_PAYS_FR_DESC, S.CORR_CHG_ADR_DT,
                                                    S.CORR_NON_LIV_CD, S.CORR_NON_LIV_DESC, S.DOM_ADR_L1, S.DOM_MUN_NM,
                                                    S.DOM_PROV_CD, S.DOM_CP_CD, S.DOM_PAYS_NM, S.DOM_CHG_ADR_DT,
                                                    S.TEL_PRINC_NO, S.TEL_AUTRE_NO, S.REG_ADMIN_CD, S.REG_TRAV_CD,
                                                    S.REG_TRAV_NM, S.METIER_PRIO_CD, S.METIER_PRIO_NM, S.EMP_PRF_NO,
                                                    S.CERT1_TYPE_CD, S.CERT1_ECH_DT, S.CREAT_DT, S.CREAT_UTIL_ID,
                                                    S.MODIF_DT, S.MODIF_UTIL_ID, S.CORR_PROV_CD, S.CORR_PAYS_NM,
                                                    S.REG_ADMIN_NM, S.CERT2_TYPE_CD, S.DECES_PRESUME_DT, S.DECES_CONFIRME_DT, S.ENREG_DT);";

                string sqlDeltaDel = @"MERGE INTO [SDEXT01].[CCQ].[SALAR_DOSS] AS T
                                        USING [SDEXT01].[CCQ].[SALAR_DOSS_tmp] AS S
                                            ON T.CLIENT_SAL_NO = S.CLIENT_SAL_NO

                                        -- Lignes modifiées
                                        WHEN MATCHED AND T.ACTIF_IND = 'O'
	                                        AND T.FIN_EFFECT_DT is null
                                        AND (
                                                    ISNULL(T.CERT2_ECH_DT, '1900-01-01') <> ISNULL(S.CERT2_ECH_DT, '1900-01-01') OR
                                                    ISNULL(T.DEB_INVAL_DT, '1900-01-01') <> ISNULL(S.DEB_INVAL_DT, '1900-01-01') OR
                                                    ISNULL(T.NOM, '') <> ISNULL(S.NOM, '') OR
                                                    ISNULL(T.PRENOM, '') <> ISNULL(S.PRENOM, '') OR
                                                    ISNULL(T.NAISS_DT, '1900-01-01') <> ISNULL(S.NAISS_DT, '1900-01-01') OR
                                                    ISNULL(T.NAISS_STATUT_CD, '') <> ISNULL(S.NAISS_STATUT_CD, '') OR
                                                    ISNULL(T.GENRE_CD, '') <> ISNULL(S.GENRE_CD, '') OR
                                                    ISNULL(T.CORR_ADR_L1, '') <> ISNULL(S.CORR_ADR_L1, '') OR
                                                    ISNULL(T.CORR_MUN_NM, '') <> ISNULL(S.CORR_MUN_NM, '') OR
                                                    ISNULL(T.CORR_REG_CD, '') <> ISNULL(S.CORR_REG_CD, '') OR
                                                    ISNULL(T.CORR_CP_CD, '') <> ISNULL(S.CORR_CP_CD, '') OR
                                                    ISNULL(T.CORR_PAYS_FR_DESC, '') <> ISNULL(S.CORR_PAYS_FR_DESC, '') OR
                                                    ISNULL(T.CORR_CHG_ADR_DT, '1900-01-01') <> ISNULL(S.CORR_CHG_ADR_DT, '1900-01-01') OR
                                                    ISNULL(T.CORR_NON_LIV_CD, '') <> ISNULL(S.CORR_NON_LIV_CD, '') OR
                                                    ISNULL(T.CORR_NON_LIV_DESC, '') <> ISNULL(S.CORR_NON_LIV_DESC, '') OR
                                                    ISNULL(T.DOM_ADR_L1, '') <> ISNULL(S.DOM_ADR_L1, '') OR
                                                    ISNULL(T.DOM_MUN_NM, '') <> ISNULL(S.DOM_MUN_NM, '') OR
                                                    ISNULL(T.DOM_PROV_CD, '') <> ISNULL(S.DOM_PROV_CD, '') OR
                                                    ISNULL(T.DOM_CP_CD, '') <> ISNULL(S.DOM_CP_CD, '') OR
                                                    ISNULL(T.DOM_PAYS_NM, '') <> ISNULL(S.DOM_PAYS_NM, '') OR
                                                    ISNULL(T.DOM_CHG_ADR_DT, '1900-01-01') <> ISNULL(S.DOM_CHG_ADR_DT, '1900-01-01') OR
                                                    ISNULL(T.TEL_PRINC_NO, '') <> ISNULL(S.TEL_PRINC_NO, '') OR
                                                    ISNULL(T.TEL_AUTRE_NO, '') <> ISNULL(S.TEL_AUTRE_NO, '') OR
                                                    ISNULL(T.REG_ADMIN_CD, '') <> ISNULL(S.REG_ADMIN_CD, '') OR
                                                    ISNULL(T.REG_TRAV_CD, '') <> ISNULL(S.REG_TRAV_CD, '') OR
                                                    ISNULL(T.REG_TRAV_NM, '') <> ISNULL(S.REG_TRAV_NM, '') OR
                                                    ISNULL(T.METIER_PRIO_CD, '') <> ISNULL(S.METIER_PRIO_CD, '') OR
                                                    ISNULL(T.METIER_PRIO_NM, '') <> ISNULL(S.METIER_PRIO_NM, '') OR
                                                    ISNULL(T.EMP_PRF_NO, '') <> ISNULL(S.EMP_PRF_NO, '') OR
                                                    ISNULL(T.CERT1_TYPE_CD, '') <> ISNULL(S.CERT1_TYPE_CD, '') OR
                                                    ISNULL(T.CERT1_ECH_DT, '1900-01-01') <> ISNULL(S.CERT1_ECH_DT, '1900-01-01') OR
                                                    ISNULL(T.CORR_PROV_CD, '') <> ISNULL(S.CORR_PROV_CD, '') OR
                                                    ISNULL(T.CORR_PAYS_NM, '') <> ISNULL(S.CORR_PAYS_NM, '') OR
                                                    ISNULL(T.REG_ADMIN_NM, '') <> ISNULL(S.REG_ADMIN_NM, '') OR
                                                    ISNULL(T.CERT2_TYPE_CD, '') <> ISNULL(S.CERT2_TYPE_CD, '') OR
                                                    ISNULL(T.DECES_PRESUME_DT, '1900-01-01') <> ISNULL(S.DECES_PRESUME_DT, '1900-01-01') OR
                                                    ISNULL(T.DECES_CONFIRME_DT, '1900-01-01') <> ISNULL(S.DECES_CONFIRME_DT, '1900-01-01')  OR
                                                    ISNULL(T.ENREG_DT, '1900-01-01') <> ISNULL(S.ENREG_DT, '1900-01-01')
                                            )
                                        THEN UPDATE SET 
                                                T.FIN_EFFECT_DT       = DATEADD(DAY, -1, S.DEB_EFFECT_DT),
		                                        T.ACTIF_IND           = 'N'

                                        -- Lignes à désactiver
                                        WHEN NOT MATCHED BY SOURCE AND T.ACTIF_IND = 'O'
                                        THEN UPDATE SET
                                                T.ACTIF_IND = 'N',
		                                        T.FIN_EFFECT_DT       =DATEADD(DAY, -1, @dtFinEffect),
                                                T.MODIF_DT  = @dtFinEffect; ";

                InsertTableLogChargement("TraiteCCQ", "TraiteDeltaDCSAL01()");

                using (SqlConnection conn = new SqlConnection(strServerBD))
                {
                    conn.Open();
                    SqlTransaction tran = conn.BeginTransaction();

                    try
                    {
                        // Delta des inserts updates
                        SqlCommand cmd = new SqlCommand(sqlDeltaInsUpdt, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCSAL01(sqlDeltaInsUpdt)", ex.Message);
                        }

                        // Delta des deletes
                        cmd = new SqlCommand(sqlDeltaDel, conn, tran);
                        cmd.CommandTimeout = 12000;

                        // Définition des paramètres 
                        cmd.Parameters.Add("@dtFinEffect", SqlDbType.DateTime);
                        cmd.Parameters["@dtFinEffect"].Value = dtTraitementSSIS;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCSAL01(sqlDeltaDel)", ex.Message);
                        }

                        // Traite une deuxième passe pour les insert non traité par la première passe
                        // Delta des inserts updates
                        cmd = new SqlCommand(sqlDeltaInsUpdt, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteDeltaDCSAL01(sqlDeltaInsUpdt2)", ex.Message);
                        }

                        tran.Commit();
                    }
                    catch (Exception ex)
                    {
                        blErreurExecution = true;
                        tran.Rollback();
                        statutDCSAL01 = "ERREUR";
                        InsertTableLogJob("TraiteDeltaDCSAL01", ex.Message);
                        throw;
                    }
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Traite les Updates et les Inserts RM01
            ///
            /////////////////////////////////////////////////////////////////////
            void TraiteUpdtInsRM01()
            {

                string sqlInsertDest = @"insert into [SDEXT01].[CCQ].[RAP_MENS_DET] ([ACT_SAP_CLE], [DEB_EFFECT_DT], [FIN_EFFECT_DT], [ACTIF_IND], [RAP_SAP_CLE], [CLIENT_EMP_NO], [CLIENT_SAL_NO], 
																					   [PER_ENV_DEB_DT], [PER_ENV_FIN_DT], [PERIODE_CD], [PRENOM], [NOM], [SEM_TRAV_NB], [METIER_CD], [METIER_NM], 
																					   [SECTEUR_CD], [SECTEUR_NM], [HRS_SAL_SOM], [STAT_SAL_CD], [TOT_AV_SOC_AMT], [CREAT_DT], [CREAT_UTIL_ID], 
																					   [MODIF_DT], [MODIF_UTIL_ID], [CD_ANNEXE_SAL], [ANNEXE_SAL_DESC], [EMP_CMEQ_IND], [EMP_CMMTQ_IND], 
                                                                                       [REG_ACTV_CD], [REG_ACTV_DESC])
                                                                            select [ACT_SAP_CLE], [DEB_EFFECT_DT], [FIN_EFFECT_DT], [ACTIF_IND], [RAP_SAP_CLE], [CLIENT_EMP_NO], [CLIENT_SAL_NO], 
																					   [PER_ENV_DEB_DT], [PER_ENV_FIN_DT], [PERIODE_CD], [PRENOM], [NOM], [SEM_TRAV_NB], [METIER_CD], [METIER_NM], 
																					   [SECTEUR_CD], [SECTEUR_NM], [HRS_SAL_SOM], [STAT_SAL_CD], [TOT_AV_SOC_AMT], [CREAT_DT], [CREAT_UTIL_ID], 
																					   [MODIF_DT], [MODIF_UTIL_ID], [CD_ANNEXE_SAL], [ANNEXE_SAL_DESC], [EMP_CMEQ_IND], [EMP_CMMTQ_IND], 
                                                                                       [REG_ACTV_CD], [REG_ACTV_DESC]
                                                                                        from [SDEXT01].[CCQ].[RAP_MENS_DET_tmp] where [AJOUT_MOD_IND] = 'A'";


                string sqlUpdateDest = @"UPDATE [SDEXT01].[CCQ].[RAP_MENS_DET]
								         SET FIN_EFFECT_DT = DATEADD(DAY, -1, S.DEB_EFFECT_DT),
                                             ACTIF_IND = 'N',
										     MODIF_DT = S.MODIF_DT
										 FROM [SDEXT01].[CCQ].[RAP_MENS_DET] T
										    JOIN [SDEXT01].[CCQ].[RAP_MENS_DET_tmp] S
											  ON T.ACT_SAP_CLE = S.ACT_SAP_CLE
											     AND T.FIN_EFFECT_DT is null
										  WHERE S.AJOUT_MOD_IND = 'M'";

                string sqlInsertModifDest = @"insert into [SDEXT01].[CCQ].[RAP_MENS_DET] ([ACT_SAP_CLE], [DEB_EFFECT_DT], [FIN_EFFECT_DT], [ACTIF_IND], [RAP_SAP_CLE], [CLIENT_EMP_NO], [CLIENT_SAL_NO], 
																					   [PER_ENV_DEB_DT], [PER_ENV_FIN_DT], [PERIODE_CD], [PRENOM], [NOM], [SEM_TRAV_NB], [METIER_CD], [METIER_NM], 
																					   [SECTEUR_CD], [SECTEUR_NM], [HRS_SAL_SOM], [STAT_SAL_CD], [TOT_AV_SOC_AMT], [CREAT_DT], [CREAT_UTIL_ID], 
																					   [MODIF_DT], [MODIF_UTIL_ID], [CD_ANNEXE_SAL], [ANNEXE_SAL_DESC], [EMP_CMEQ_IND], [EMP_CMMTQ_IND], 
                                                                                       [REG_ACTV_CD], [REG_ACTV_DESC])
                                                                            select [ACT_SAP_CLE], [DEB_EFFECT_DT], [FIN_EFFECT_DT], [ACTIF_IND], [RAP_SAP_CLE], [CLIENT_EMP_NO], [CLIENT_SAL_NO], 
																					   [PER_ENV_DEB_DT], [PER_ENV_FIN_DT], [PERIODE_CD], [PRENOM], [NOM], [SEM_TRAV_NB], [METIER_CD], [METIER_NM], 
																					   [SECTEUR_CD], [SECTEUR_NM], [HRS_SAL_SOM], [STAT_SAL_CD], [TOT_AV_SOC_AMT], [CREAT_DT], [CREAT_UTIL_ID], 
																					   [MODIF_DT], [MODIF_UTIL_ID], [CD_ANNEXE_SAL], [ANNEXE_SAL_DESC], [EMP_CMEQ_IND], [EMP_CMMTQ_IND], 
                                                                                       [REG_ACTV_CD], [REG_ACTV_DESC]
                                                                                        from [SDEXT01].[CCQ].[RAP_MENS_DET_tmp] where [AJOUT_MOD_IND] = 'M'";

                InsertTableLogChargement("TraiteCCQ", "TraiteUpdtInsRM01()");

                using (SqlConnection conn = new SqlConnection(strServerBD))
                {
                    conn.Open();
                    SqlTransaction tran = conn.BeginTransaction();

                    try
                    {
                        // Insertion
                        SqlCommand cmd = new SqlCommand(sqlInsertDest, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteUpdtInsRM01(sqlInsertDest)", ex.Message);
                        }

                        // Update
                        cmd = new SqlCommand(sqlUpdateDest, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteUpdtInsRM01(sqlUpdateDest)", ex.Message);
                        }

                        // Insert les nouvelles modif
                        cmd = new SqlCommand(sqlInsertModifDest, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteUpdtInsRM01(sqlInsertModifDest)", ex.Message);
                        }
                        tran.Commit();
                    }
                    catch (Exception ex)
                    {
                        blErreurExecution = true;
                        tran.Rollback();
                        statutRM01 = "ERREUR";
                        InsertTableLogJob("TraiteUpdtInsRM01", ex.Message);
                        throw;
                    }
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Traite les Updates et les Inserts RM02
            ///
            /////////////////////////////////////////////////////////////////////
            void TraiteUpdtInsRM02()
            {

                string sqlInsertDest = @"insert into [SDEXT01].[CCQ].[RAP_MENS_ENT] ([RAP_SAP_CLE], [DEB_EFFECT_DT], [FIN_EFFECT_DT], [CLIENT_EMP_NO], [ACTIF_IND], [PER_ENV_DEB_DT], [PER_ENV_FIN_DT], [FISC_DEB_DT], [FISC_FIN_DT]
																					, [RAPPORT_NO], [AMEND_NB], [RAP_STATUT_CD], [TYPE_RAP_CD], [ENTRP_NM], [TOT_RM_AMT], [SOLDE_RM_AMT], [TOT_AV_SOC_AMT], [MNT_NET_CARCAP], [AJOUT_MOD_IND]
																					, [SOUM_RM_DT], [TOT_HEURE_RM], [SOLDE_RECL_AMT], [DEB_PER_RECL_DT], [FIN_PER_RECL_DT], [NO_RECLAMATION], [EST_EMP_ENQUETE_IND], [EST_RAP_RETARD_IND]
																					, [DERN_CHG_DT], [CREAT_DT], [CREAT_UTIL_ID], [MODIF_DT], [MODIF_UTIL_ID])
                                                                            select [RAP_SAP_CLE], [DEB_EFFECT_DT], [FIN_EFFECT_DT], [CLIENT_EMP_NO], [ACTIF_IND], [PER_ENV_DEB_DT], [PER_ENV_FIN_DT], [FISC_DEB_DT], [FISC_FIN_DT]
																					, [RAPPORT_NO], [AMEND_NB], [RAP_STATUT_CD], [TYPE_RAP_CD], [ENTRP_NM], [TOT_RM_AMT], [SOLDE_RM_AMT], [TOT_AV_SOC_AMT], [MNT_NET_CARCAP], [AJOUT_MOD_IND]
																					, [SOUM_RM_DT], [TOT_HEURE_RM], [SOLDE_RECL_AMT], [DEB_PER_RECL_DT], [FIN_PER_RECL_DT], [NO_RECLAMATION], [EST_EMP_ENQUETE_IND], [EST_RAP_RETARD_IND]
																					, [DERN_CHG_DT], [CREAT_DT], [CREAT_UTIL_ID], [MODIF_DT], [MODIF_UTIL_ID]
                                                                                        from [SDEXT01].[CCQ].[RAP_MENS_ENT_tmp] where [AJOUT_MOD_IND] = 'A'";


                string sqlUpdateDest = @"UPDATE [SDEXT01].[CCQ].[RAP_MENS_ENT] 
								         SET FIN_EFFECT_DT = DATEADD(DAY, -1, S.DEB_EFFECT_DT), 
                                             ACTIF_IND = 'N',
										     MODIF_DT = S.MODIF_DT
										 FROM [SDEXT01].[CCQ].[RAP_MENS_ENT] T
										    JOIN [SDEXT01].[CCQ].[RAP_MENS_ENT_tmp] S
											  ON T.RAP_SAP_CLE = S.RAP_SAP_CLE
											     AND T.FIN_EFFECT_DT is null
										  WHERE S.AJOUT_MOD_IND = 'M'";

                string sqlInsertModifDest = @"insert into [SDEXT01].[CCQ].[RAP_MENS_ENT] ([RAP_SAP_CLE], [DEB_EFFECT_DT], [FIN_EFFECT_DT], [CLIENT_EMP_NO], [ACTIF_IND], [PER_ENV_DEB_DT], [PER_ENV_FIN_DT], [FISC_DEB_DT], [FISC_FIN_DT]
																					, [RAPPORT_NO], [AMEND_NB], [RAP_STATUT_CD], [TYPE_RAP_CD], [ENTRP_NM], [TOT_RM_AMT], [SOLDE_RM_AMT], [TOT_AV_SOC_AMT], [MNT_NET_CARCAP], [AJOUT_MOD_IND]
																					, [SOUM_RM_DT], [TOT_HEURE_RM], [SOLDE_RECL_AMT], [DEB_PER_RECL_DT], [FIN_PER_RECL_DT], [NO_RECLAMATION], [EST_EMP_ENQUETE_IND], [EST_RAP_RETARD_IND]
																					, [DERN_CHG_DT], [CREAT_DT], [CREAT_UTIL_ID], [MODIF_DT], [MODIF_UTIL_ID])
                                                                            select [RAP_SAP_CLE], [DEB_EFFECT_DT], [FIN_EFFECT_DT], [CLIENT_EMP_NO], [ACTIF_IND], [PER_ENV_DEB_DT], [PER_ENV_FIN_DT], [FISC_DEB_DT], [FISC_FIN_DT]
																					, [RAPPORT_NO], [AMEND_NB], [RAP_STATUT_CD], [TYPE_RAP_CD], [ENTRP_NM], [TOT_RM_AMT], [SOLDE_RM_AMT], [TOT_AV_SOC_AMT], [MNT_NET_CARCAP], [AJOUT_MOD_IND]
																					, [SOUM_RM_DT], [TOT_HEURE_RM], [SOLDE_RECL_AMT], [DEB_PER_RECL_DT], [FIN_PER_RECL_DT], [NO_RECLAMATION], [EST_EMP_ENQUETE_IND], [EST_RAP_RETARD_IND]
																					, [DERN_CHG_DT], [CREAT_DT], [CREAT_UTIL_ID], [MODIF_DT], [MODIF_UTIL_ID]
                                                                                        from [SDEXT01].[CCQ].[RAP_MENS_ENT_tmp] where [AJOUT_MOD_IND] = 'M'";

                InsertTableLogChargement("TraiteCCQ", "TraiteUpdtInsRM02()");

                using (SqlConnection conn = new SqlConnection(strServerBD))
                {
                    conn.Open();
                    SqlTransaction tran = conn.BeginTransaction();

                    try
                    {
                        // Insertion
                        SqlCommand cmd = new SqlCommand(sqlInsertDest, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteUpdtInsRM02(sqlInsertDest)", ex.Message);
                        }

                        // Insertion
                        cmd = new SqlCommand(sqlUpdateDest, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteUpdtInsRM02(sqlUpdateDest)", ex.Message);
                        }

                        // Insert les nouvelles modif
                        cmd = new SqlCommand(sqlInsertModifDest, conn, tran);
                        cmd.CommandTimeout = 12000;

                        try
                        {
                            cmd.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            InsertTableLogJob("TraiteUpdtInsRM02(sqlInsertModifDest)", ex.Message);
                        }

                        tran.Commit();
                    }
                    catch (Exception ex)
                    {
                        blErreurExecution = true;
                        tran.Rollback();
                        statutRM02 = "ERREUR";
                        InsertTableLogJob("TraiteUpdtInsRM02", ex.Message);
                        throw;
                    }
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute une instruction SQL
            ///
            /////////////////////////////////////////////////////////////////////
            void ExecuteSQL(string strCodeTraitement, string strSqlRequete)
            {
                string sqlCmd = strSqlRequete.ToString();

                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerBD))
                    {
                        mySQLConnection.Open();
                        using (var transaction = mySQLConnection.BeginTransaction())
                        {
                            SqlCommand SQLCommandExec = new SqlCommand(sqlCmd.ToString(), mySQLConnection, transaction);
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.ExecuteNonQuery();
                            transaction.Commit();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJob("ExecuteSQL(" + strCodeTraitement + ")", ex.Message.ToString());
                    blErreurExecution = true;
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Création du fichier rejet
            ///
            /////////////////////////////////////////////////////////////////////
            void CreerFichierRejet()
            {
                string sqlErreur = @"select JobName + '|' + ErrorMessage + '|' + replace(FORMAT(DateErreur, 'yyyy-MM-dd hh:mi:ss'), 'i', '') as resultat
                                     from   [SDEXT01].[CFG].[Log_Job_Connecteur]
                                     where  application = 'TraiteCCQ' 
                                     order by DateErreur ";

                string strpath = strCheminRejet + "Rejets_" + dtTraitementSSIS.ToString("yyyy_MM_dd") + ".csv";

                if (File.Exists(strpath))
                {
                    // Si le fichier existe le détruire
                    File.Delete(strpath);
                }

                StreamWriter sw = new StreamWriter(strpath, true, Encoding.Unicode);
                sw.WriteLine("Fonction(Code utile)|Erreur|Date exécution");

                // Lire les règles d'affaire
                using (SqlDataAdapter dataAdapterAfficheErreur = new SqlDataAdapter(sqlErreur, strServerBD))
                {
                    try
                    {
                        DataSet dataSetAfficheErreur = new DataSet();
                        dataAdapterAfficheErreur.SelectCommand.CommandTimeout = 600;
                        dataAdapterAfficheErreur.Fill(dataSetAfficheErreur, "AfficheErreur");

                        foreach (DataRow pRowRegleAfficheErreur in dataSetAfficheErreur.Tables["AfficheErreur"].Rows)
                        {
                            sw.WriteLine(pRowRegleAfficheErreur["resultat"].ToString().Replace(Environment.NewLine, "").Replace("\r", "").Replace("\n", ""));
                        }
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJob("CreerFichierRejet()", ex.Message.ToString());
                        blErreurExecution = true;
                    }
                }
                sw.Close();
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Création du fichier rejet
            ///
            /////////////////////////////////////////////////////////////////////
            void CCQ_Audit()
            {
                string sqlCmd = @"SELECT [CD_CONFIG]
                                          ,[ENTITE_TYPE]
                                          ,[REQ_SQL_AUDIT]
                                          ,[CATEGORIE]
                                          ,[SOUS_CATEGORIE]
                                          ,[EST_ACTIF]
                                          ,[RETENTION_JOURS]
                                      FROM [SDEXT01].[CCQ].[CCQ_AUDIT_CONFIG]
                                      WHERE [EST_ACTIF] = 'O'";

                // Lire la config des audits

                using (SqlDataAdapter dataAdapterAudit = new SqlDataAdapter(sqlCmd, strServerBD))
                {
                    try
                    {
                        DataSet dataSetAfficheErreur = new DataSet();
                        dataAdapterAudit.SelectCommand.CommandTimeout = 600;
                        dataAdapterAudit.Fill(dataSetAfficheErreur, "Audit");

                        foreach (DataRow pRowRegleAudit in dataSetAfficheErreur.Tables["Audit"].Rows)
                        {
                            var sqlAudit = pRowRegleAudit["REQ_SQL_AUDIT"].ToString();
                            var strCdConfig = pRowRegleAudit["CD_CONFIG"].ToString();
                            try
                            {
                                using (SqlConnection mySQLConnection = new SqlConnection(strServerBD))
                                {
                                    mySQLConnection.Open();
                                    using (var transaction = mySQLConnection.BeginTransaction())
                                    {
                                        SqlCommand SQLCommandExec = new SqlCommand(sqlAudit.ToString(), mySQLConnection, transaction);
                                        SQLCommandExec.CommandTimeout = 12000;
                                        SQLCommandExec.Parameters.Add("@dtDebEffect", SqlDbType.DateTime);
                                        SQLCommandExec.Parameters["@dtDebEffect"].Value = dtTraitementSSIS;
                                        SQLCommandExec.ExecuteNonQuery();
                                        transaction.Commit();
                                    }
                                }
                            }
                            catch (Exception ex)
                            {
                                //MessageBox.Show(ex.Message);
                                InsertTableLogJob("CCQ_Audit(" + strCdConfig + ")", ex.Message.ToString());
                                blErreurExecution = true;

                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJob("CCQ_Audit(SqlDataAdapter)", ex.Message.ToString());
                        blErreurExecution = true;
                    }
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Envois courriel
            ///
            /////////////////////////////////////////////////////////////////////
            void Email_Send()
            {
                String SQLString = tblAfficheErreur.ToString();
                String EnvoisCourrielPar = EnvoyePar.ToString();
                String EnvoisCourrielA = strEnvoisCourrielA; 
                String EnvoisCourrielSuject = "L'application (TraiteCCQ) a une ou des erreurs d'exécutions. ";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine +
                                             "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";

                string strpath = strCheminRejet + "Rejets_" + dtTraitementSSIS.ToString("yyyy_MM_dd") + ".csv";

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();
                System.Net.Mail.Attachment fileAttachment = null;

                String SmtpServer = FindConfigParm("COMMUN", "SmtpServer");

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    if (File.Exists(strpath))
                    {
                        fileAttachment = new System.Net.Mail.Attachment(strpath);

                        //Ajout de l'attachements
                        FormatCourrielHtml.Attachments.Add(fileAttachment);
                    }

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("SendMail()", ex.Message.ToString());
                }
            }
        }
        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
