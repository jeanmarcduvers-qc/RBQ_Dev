                        strGroupeLineImp[15],
                        strGroupeLineImp[16],
                        strGroupeLineImp[17],
                        decimal.TryParse(strGroupeLineImp[18], NumberStyles.Any, CultureInfo.InvariantCulture, out decimal c) ? c : (object)DBNull.Value,
                        strGroupeLineImp[19],
                        strGroupeLineImp[21],
                        strGroupeLineImp[22],
                        decimal.TryParse(strGroupeLineImp[23], NumberStyles.Any, CultureInfo.InvariantCulture, out decimal d) ? d : (object)DBNull.Value,
                        strGroupeLineImp[24],
                        strGroupeLineImp[25],
                        dtTraitementSSIS,
                        "ETL_CCQ_SSIS",
                        dtTraitementSSIS,
                        "ETL_CCQ_SSIS",
                        dtTraitementSSIS,
                        DBNull.Value,
                        "O",
                        CodeRegionTravail,
                        DescRegionTravail
                    );

                    // BULK toutes les 100 000 lignes
                    if (dtRM01.Rows.Count >= 100000)
