        Structure_ZK StructureZK = new Structure_ZK();

        public const string delLogChargement = "DELETE [SDEXT01].[CFG].[Log_Chargement_Connecteur] where Application = 'TraiteCCQ'";
        public const string delLogJobChargement = "DELETE [SDEXT01].[CFG].[Log_Job_Connecteur] where Application = 'TraiteCCQ'";
        public const string tblAfficheErreur = "SELECT * FROM [SDEXT01].[CFG].[Log_Job_Connecteur] where Application = 'TraiteCCQ'";


        public string newLine = Environment.NewLine;
        public bool blErreurExecution = false;
        public DateTime dtDateDebut = DateTime.Now;
        public string dtExecution = "";
        public string strTableName = "";  // Nom de la table d'insertion selon le type de fichier Hebdo ou Initial

        public void Main()
        {
            try
            {
                TraiteCCQ();

            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Script Task", ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }

            Dts.TaskResult = (int)ScriptResults.Success;
        }

        public void TraiteCCQ()
        {
            // Récupére les paramètres
            string EnvoyePar = FindConfigParm("COMMUN", "EnvoyePar");
            string strCheminIn = FindConfigParm("CCQ_ETL", "RepertoireIn");
            string strCheminFchArch = FindConfigParm("CCQ_ETL", "RepertoireArchive");
            string strCheminRejet = FindConfigParm("CCQ_ETL", "RepertoireRejet");
            strServerBD = FindConfigParm("CCQ_ETL", "ServerBD");
            string strEnvoisCourrielA = FindConfigParm("CCQ_ETL", "EnvoisCourrielA");

            string statutDCEMP01 = "EN_COURS";
            string statutDCEMP02 = "EN_COURS";
            string statutDCSAL01 = "EN_COURS";
            string statutRM02 = "EN_COURS";
            string statutRM01 = "EN_COURS";
            bool ifFirstline = true;
            int intLineCount = 0;

            string[] lines = new string[0];

            if (blErreurExecution != true)
            {
                // delete l'historique du dernier log de chargement
                // DeleteTableLogChargement();
                ExecuteSQL("CCQ", delLogJobChargement);


                InsertTableLogChargement("TraiteCCQ", "Début du traitement");

                // Valide qu'il y est seulement un fichier ZIP dans le répertoire sinon c'est une erreur
                DirectoryInfo d = new DirectoryInfo(strCheminIn);
                FileInfo[] FilesCCQzip = d.GetFiles("*ZK001BZ01*.zip");

                if (FilesCCQzip.Length > 1)
                {
                    InsertTableLogJob("TraiteConnecteur()", "Il existe plusieurs fichiers pour CCQ (....).");
                    blErreurExecution = true;
                }
                else if (FilesCCQzip.Length == 1)
                {
                    dtTraitementSSIS = FilesCCQzip[0].LastWriteTime.Date;
                    DecompresseFichier(strCheminIn, FilesCCQzip[0].Name);
                    fichierArchive = FilesCCQzip[0].Name;
                }

                try
                {

                    // Traite les fichiers
                    if (blErreurExecution != true)
                    {

                        if (dtTraitementSSIS == DateTime.Parse("2026-03-25"))
                        {
                            ExecuteSQL("CCQ", "delete [SDEXT01].[CCQ].[RAP_MENS_DET]");
                            ExecuteSQL("CCQ", "delete [SDEXT01].[CCQ].[RAP_MENS_ENT]");
                        }

                        // Lire le répertoire pour le fichier ZK Initial et Hebdo
                        var fichiers = new DirectoryInfo(strCheminIn).GetFiles("ZK*.TXT");
                        var encoding = Encoding.Default;

                        // Boucle sur le fichier
                        foreach (var fichier in fichiers)
                        {
                            string cheminComplet = fichier.FullName;
                            DateTime dateCreation = fichier.CreationTime;

                            // lire le contenu
                            lines = File.ReadAllLines(@fichier.FullName, encoding);

                            StructureZK = new Structure_ZK();
                            LoadFichierZK(lines);

                            if (fichier.Name.Contains("HEBDO"))
                            {
                                strTableName = "CTRL_HEBDO";
                            }
                            else
                            {
                                strTableName = "CTRL_INIT";
                            }

                            InsertBD_ZK(strTableName);
                            SupprimeFichier(@fichier.FullName);
                        }
                        if (blErreurExecution != true)
                        {
                            // Lire le répertoire pour le fichier DCEMP01
                            ifFirstline = true;
                            intLineCount = 0;
                            fichiers = new DirectoryInfo(strCheminIn).GetFiles("*DCEMP01*.TXT");

                            // Boucle sur le fichier
                            foreach (var fichier in fichiers)
                            {
                                string cheminComplet = fichier.FullName;
                                DateTime dateCreation = fichier.CreationTime;

                                UpdateCtrlHebdo(FilesCCQzip[0].Name, fichier.Name, statutDCEMP01, 0, 0, 0, 0, 0);

                                IfTableExists("[SDEXT01].[CCQ].[EMPL_DOSS_tmp]");
                                ExecuteSQL("CCQ", "select * into [SDEXT01].[CCQ].[EMPL_DOSS_tmp] from [SDEXT01].[CCQ].[EMPL_DOSS] where  1 = 0");
                                ExecuteSQL("CCQ", "CREATE UNIQUE INDEX IX_EMPL_DOSS_tmp ON SDEXT01.CCQ.EMPL_DOSS_tmp([CLIENT_EMP_NO], [DEB_EFFECT_DT])");
                                DataTable dtDCEMP01 = CreateDataTableDCEMP01();

                                InsertTableLogChargement("TraiteCCQ", "LoadFichierDCEMP01()");
                                SqlConnection conn_DCEMP01 = new SqlConnection(strServerBD);
                                conn_DCEMP01.Open();
                                SqlTransaction tran_DCEMP01 = conn_DCEMP01.BeginTransaction();

                                foreach (var line in File.ReadLines(fichier.FullName, encoding))
                                {
                                    if (ifFirstline)
                                    {
                                        ifFirstline = false;
                                    }
                                    else
                                    {
                                        intLineCount++;
                                        LoadFichierDCEMP01(line, intLineCount, dtDCEMP01, conn_DCEMP01, tran_DCEMP01, fichier.Name);
                                    }
                                }

                                if (dtDCEMP01.Rows.Count > 0)
                                {
                                    BulkInsertDCEMP01(dtDCEMP01, conn_DCEMP01, tran_DCEMP01);
                                    dtDCEMP01.Clear();
                                }

                                tran_DCEMP01.Commit();
                                UpdateRegionAdm("[SDEXT01].[CCQ].[EMPL_DOSS_tmp]", "[REG_ADMIN_CD]", "[AFF_CP_CD]");
                                ValideSiDoublon("[SDEXT01].[CCQ].[EMPL_DOSS_tmp]", "[CLIENT_EMP_NO], [DEB_EFFECT_DT]", fichier.Name, "[EMPL_DOSS_ID]", "InsertBD_DCEMP01()");
                                TraiteDeltaDCEMP01();
                                UpdateStatDCEMP01(FilesCCQzip[0].Name, fichier.Name, statutDCEMP01);
                                SupprimeFichier(@fichier.FullName);
                                IfTableExists("[SDEXT01].[CCQ].[EMPL_DOSS_tmp]");
                            }

                            // Lire le répertoire pour le fichier DCEMP02
                            ifFirstline = true;
                            intLineCount = 0;
                            fichiers = new DirectoryInfo(strCheminIn).GetFiles("DCEMP02*.TXT");

                            // Boucle sur le fichier
                            foreach (var fichier in fichiers)
                            {
                                string cheminComplet = fichier.FullName;
                                DateTime dateCreation = fichier.CreationTime;

                                UpdateCtrlHebdo(FilesCCQzip[0].Name, fichier.Name, statutDCEMP02, 0, 0, 0, 0, 0);

                                IfTableExists("[SDEXT01].[CCQ].[EMPL_REL_tmp]");
                                ExecuteSQL("CCQ", "select * into [SDEXT01].[CCQ].[EMPL_REL_tmp] from [SDEXT01].[CCQ].[EMPL_REL] where  1 = 0");
                                DataTable dtDCEMP02 = CreateDataTableDCEMP02();

                                InsertTableLogChargement("TraiteCCQ", "LoadFichierDCEMP02()");
                                SqlConnection conn_DCEMP02 = new SqlConnection(strServerBD);
                                conn_DCEMP02.Open();
                                SqlTransaction tran_DCEMP02 = conn_DCEMP02.BeginTransaction();

                                foreach (var line in File.ReadLines(fichier.FullName, encoding))
                                {
                                    if (ifFirstline)
                                    {
                                        ifFirstline = false;
                                    }
                                    else
                                    {
                                        intLineCount++;
