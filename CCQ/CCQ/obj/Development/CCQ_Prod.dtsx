                        (ValideDate(strGroupeLineImp[29], "DT_FIN_FONCTION", "LoadFichierDCEMP02()", noLine.ToString(), pFichierTXT) == false) ||
                        (ValideDate(strGroupeLineImp[30], "DT_RECEP_DESIGNATION", "LoadFichierDCEMP02()", noLine.ToString(), pFichierTXT) == false) ||
                        (ValideDate(strGroupeLineImp[31], "DT_ENR_DESIGNATION", "LoadFichierDCEMP02()", noLine.ToString(), pFichierTXT) == false))
                    {
                        blErreurExecution = true;
