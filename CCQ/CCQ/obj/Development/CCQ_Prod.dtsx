            ////////////////////////////////////////////////////////////////////////
            ///
            //     Insert dans la BD
            ///
            ///////////////////////////////////////////////////////////////////////
            void InsertBD_ZK(string pTableName)
            {
                string strcmdSql = @"insert into [SDEXT01].[CCQ].[" + pTableName.ToString() + @"] (IG_ABREV, FICH_ZIP_NM, FICHIER_NM, DESCR, ENVOI_DH, LIGNES_NB ) 
                                                                          values(@strAbrev_IG, @strNomFichierZIP, @strNomFichier, @strDescription, @dtEnvoiDateHeure, @intNombreLignes )";


                InsertTableLogChargement("TraiteCCQ", "InsertBD_ZK");
                DateTime dtEnvoiDateHeure;

                using (SqlConnection conn = new SqlConnection(strServerBD))
                {
                    conn.Open();
                    SqlTransaction tran = conn.BeginTransaction();

                    try
                    {
                        SqlCommand cmd = new SqlCommand(strcmdSql, conn, tran);
                        cmd.CommandTimeout = 12000;

                        // Définition des paramètres 
                        cmd.Parameters.Add("@strAbrev_IG", SqlDbType.VarChar);
                        cmd.Parameters.Add("@strNomFichierZIP", SqlDbType.VarChar);
                        cmd.Parameters.Add("@dtEnvoiDateHeure", SqlDbType.DateTime);
                        cmd.Parameters.Add("@strNomFichier", SqlDbType.VarChar);
                        cmd.Parameters.Add("@strDescription", SqlDbType.VarChar);
                        cmd.Parameters.Add("@intNombreLignes", SqlDbType.Int);

                        // boucle
                        for (int i = 0; i < StructureZK.intCleRapportCtrl.Count; i++)
                        {
                            dtEnvoiDateHeure = DateTime.ParseExact(StructureZK.strDateEnvoi[i] + StructureZK.strHeure[i], "yyyyMMdd HH:mm:ss", CultureInfo.InvariantCulture);

                            cmd.Parameters["@strAbrev_IG"].Value = StructureZK.strAbrev_IG[i];
                            cmd.Parameters["@strNomFichierZIP"].Value = StructureZK.strNomFichierZIP[i];
                            cmd.Parameters["@dtEnvoiDateHeure"].Value = dtEnvoiDateHeure;
                            cmd.Parameters["@strNomFichier"].Value = StructureZK.strNomFichier[i];
                            cmd.Parameters["@strDescription"].Value = StructureZK.strDescription[i];
                            cmd.Parameters["@intNombreLignes"].Value = StructureZK.intNombreLignes[i];

                            try
                            {
                                cmd.ExecuteNonQuery();
                            }
                            catch (Exception ex)
                            {
                                blErreurExecution = true;
                                InsertTableLogJob("InsertBD_ZK(" + pTableName + ")", ex.Message);
                            }
                        }

                        tran.Commit();
                    }
                    catch (Exception ex)
                    {
                        blErreurExecution = true;
                        tran.Rollback();
                        InsertTableLogJob("InsertBD_ZK(" + pTableName + ")", ex.Message);
                        throw;
                    }
                }
            }



            //////////////////////////////////////////////////////////////////////
            ///
            //     Traite delta DCEMP01
            ///
            /////////////////////////////////////////////////////////////////////
            void TraiteDeltaDCEMP01()
            {
                string sqlDeltaInsUpdt = @"MERGE INTO [SDEXT01].[CCQ].[EMPL_DOSS] AS T
                                            USING [SDEXT01].[CCQ].[EMPL_DOSS_tmp] AS S
                                                ON T.CLIENT_EMP_NO = S.CLIENT_EMP_NO
                                                AND T.ACTIF_IND = 'O'
                                                AND T.FIN_EFFECT_DT IS NULL

                                            -- Lignes modifiées
                                            WHEN MATCHED AND (
                                                ISNULL(T.REG_ADMIN_CD, '') <> ISNULL(S.REG_ADMIN_CD, '') OR
                                                ISNULL(T.CMEQ_IND, '') <> ISNULL(S.CMEQ_IND, '') OR
                                                ISNULL(T.CMMTQ_IND, '') <> ISNULL(S.CMMTQ_IND, '') OR
                                                ISNULL(T.INTERV_NO, '') <> ISNULL(S.INTERV_NO, '') OR
                                                ISNULL(T.ENTRP_NM, '') <> ISNULL(S.ENTRP_NM, '') OR
