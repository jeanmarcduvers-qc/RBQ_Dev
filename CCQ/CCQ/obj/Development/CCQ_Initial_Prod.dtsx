            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Job_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogJob(string pFonction, string pErreurMessage)
            {
                int lParametreErreurMessage;
                pErreurMessage = pErreurMessage.Replace("'", "''");
                lParametreErreurMessage = pErreurMessage.Length;

                if (pErreurMessage.Length > 250)
                {
                    pErreurMessage = pErreurMessage.Substring(0, 245);
                    pErreurMessage = pErreurMessage + "...";
                }

                string sqlInsCmd = "insert into [SDEXT01].[CFG].[Log_Job_Connecteur] values('TraiteCCQ_Initial', 'CCQ', null, '" + pFonction + "', 'Erreur', '" + pErreurMessage + "', 'CCQ', GETDATE())";

                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerBD))
                    {
                        mySQLConnection.Open();
                        SqlCommand SQLCommandJob = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                        SQLCommandJob.CommandType = CommandType.Text;
                        SQLCommandJob.ExecuteNonQuery();
                        blErreurExecution = true;
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogChargement("ERR", "Impossible d'insérer dans Log_Job_Connecteur");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Si la table existe
            ///
            ///////////////////////////////////////////////////////////////////////
            void IfTableExists(string pNomTableUtilise)
            {
                string sqlCmd = "IF OBJECT_ID('" + pNomTableUtilise.ToString() + "', 'U') IS NOT NULL drop table " + pNomTableUtilise.ToString();

                // Valide si la table existe
                using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                {
                    mySQLConnection.Open();
                    using (SqlCommand checkTableIfExistsCommand = new SqlCommand(sqlCmd, mySQLConnection))
                    {
                        checkTableIfExistsCommand.CommandTimeout = 12000;
                        checkTableIfExistsCommand.ExecuteNonQuery();
                    }
                    mySQLConnection.Close();
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Drop table en parametre
            ///
            ///////////////////////////////////////////////////////////////////////
            void DestructionTable(string pNomTableUtilise)
            {
                string sqlDelCmd = "drop table " + pNomTableUtilise.ToString();

                using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                {
                    mySQLConnection.Open();
                    SqlCommand SQLCommandDrop = new SqlCommand(sqlDelCmd.ToString(), mySQLConnection);
                    SQLCommandDrop.CommandType = CommandType.Text;
                    SqlDataReader readeDrop = SQLCommandDrop.ExecuteReader();
                    readeDrop.Read();
                    readeDrop.Close();
                    mySQLConnection.Close();
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Archive le fichier
            ///
            /////////////////////////////////////////////////////////////////////
            void ArchiveFichier(string de, string a, string pFichierSource, bool supprimeFichier)
            {
                try
                {
                    if (!System.IO.Directory.Exists(a))
                    {
                        System.IO.Directory.CreateDirectory(a);
                    }
                    if (System.IO.File.Exists(a + pFichierSource))
                    {
                        System.IO.File.SetAttributes(a + pFichierSource, FileAttributes.Archive);
                        System.IO.File.Delete(a + pFichierSource);
                    }

                    System.IO.File.Copy(de, a + pFichierSource, true);

                    if (supprimeFichier)
                    {
                        SupprimeFichier(de);
                    }
                }

                catch (IOException ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ArchiveFichier()", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Supprime le fichier
            ///
            /////////////////////////////////////////////////////////////////////
            void SupprimeFichier(string strFchier)
            {
                try
                {
                    if (System.IO.File.Exists(strFchier))
                    {
                        System.IO.File.SetAttributes(strFchier, FileAttributes.Archive);
                        System.IO.File.Delete(strFchier);
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("SupprimeFichier()", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Décompresser les fichiers
            ///
            /////////////////////////////////////////////////////////////////////
            void DecompresseFichier(string strpCheminFchIn, string strpFilename)
            {
                try
                {
                    ZipFile.ExtractToDirectory(strpCheminFchIn + strpFilename, strpCheminFchIn);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("DecompresseFichier()", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Load le fichier dans la BD DCEMP02_Init
            ///
            /////////////////////////////////////////////////////////////////////
            void LoadFichierDCEMP02_Init(string plines, int noLine, SqlConnection pconn_DCEMP02_Init, SqlTransaction ptran_DCEMP02_Init)
            {

                string[] strGroupeLineImp = new string[0];
                Structure_DCEMP02_Init item = new Structure_DCEMP02_Init();

                try
                {
                    if (plines.Count(c => c == '|') > 0)
                    {
                            strGroupeLineImp = new string[0];
                            strGroupeLineImp = plines.ToString().Split('|');

                        item.strNoClientEmployeur = strGroupeLineImp[0];
                        item.strRegionAdministrative = strGroupeLineImp[1];
                        item.strNomEntreprise = strGroupeLineImp[2];
                        item.strNoClientRelation = strGroupeLineImp[3];
                        item.strFonction = strGroupeLineImp[4];
                        item.strNom = strGroupeLineImp[5];
                        item.strPrenom = strGroupeLineImp[6];
                        item.strNomEntrepriseRelation = strGroupeLineImp[7];
                        item.strAutreNomEntrepriseRelation = strGroupeLineImp[8];
                        item.strAdresse = strGroupeLineImp[9];
                        item.strVille = strGroupeLineImp[10];

                        if (string.IsNullOrWhiteSpace(strGroupeLineImp[11]))
                        {
                            item.strProvince = strGroupeLineImp[11];
                        }
                        else
                        {
                            item.strProvince = strGroupeLineImp[11].Substring(0, 2);
                        }

                        item.strCodePostal = strGroupeLineImp[12];
                        item.strPays = strGroupeLineImp[13];
                        item.strTelephone = strGroupeLineImp[14];
                        item.strTelephoneAutre = strGroupeLineImp[15];
                        item.strFax = strGroupeLineImp[16];
                        item.strCourriel = strGroupeLineImp[17];

                        if (!string.IsNullOrWhiteSpace(strGroupeLineImp[18]))
                        {
                            item.dtDateDebutValidite = Convert.ToDateTime(strGroupeLineImp[18]);
                        }
                        else
                        {
                            item.dtDateDebutValidite = null;
                        }

                        if (!string.IsNullOrWhiteSpace(strGroupeLineImp[19]))
                        {
                            item.dtDateFinValidite = Convert.ToDateTime(strGroupeLineImp[19]);
                        }
                        else
                        {
                            item.dtDateFinValidite = null;
                        }

                        if (!string.IsNullOrWhiteSpace(strGroupeLineImp[20]))
                        {
                            item.dtDateInsolvabilite = Convert.ToDateTime(strGroupeLineImp[20]);
                        }
                        else
                        {
                            item.dtDateInsolvabilite = null;
                        }

                        if (!string.IsNullOrWhiteSpace(strGroupeLineImp[21]))
                        {
                            item.dtDateNaissance = Convert.ToDateTime(strGroupeLineImp[21]);
                        }
                        else
                        {
                            item.dtDateNaissance = null;
                        }

                        if (!string.IsNullOrWhiteSpace(strGroupeLineImp[22]))
                        {
                            item.dtDateDeces = Convert.ToDateTime(strGroupeLineImp[22]);
                        }
                        else
                        {
                            item.dtDateDeces = null;
                        }

                        if (!string.IsNullOrWhiteSpace(strGroupeLineImp[23]))
                        {
                            item.dtDatePresumeDeces = Convert.ToDateTime(strGroupeLineImp[23]);
                        }
                        else
                        {
                            item.dtDatePresumeDeces = null;
                        }

                        if (!string.IsNullOrWhiteSpace(strGroupeLineImp[24]))
                        {
                            item.dtDateDebutFonction = Convert.ToDateTime(strGroupeLineImp[24]);
                        }
                        else
                        {
                            item.dtDateDebutFonction = null;
                        }

                        if (!string.IsNullOrWhiteSpace(strGroupeLineImp[25]))
                        {
                            item.dtDateFinFonction = Convert.ToDateTime(strGroupeLineImp[25]);
                        }
                        else
                        {
                            item.dtDateFinFonction = null;
                        }

                        if (!string.IsNullOrWhiteSpace(strGroupeLineImp[26]))
                        {
                            item.dtDateReceptionDesignation = Convert.ToDateTime(strGroupeLineImp[26]);
                        }
                        else
                        {
                            item.dtDateReceptionDesignation = null;
                        }

                        if (!string.IsNullOrWhiteSpace(strGroupeLineImp[27]))
                        {
                            item.dtDateEnregistrementDesignation = Convert.ToDateTime(strGroupeLineImp[27]);
                        }
                        else
                        {
                            item.dtDateEnregistrementDesignation = null;
                        }

                        item.strStatutRelation = strGroupeLineImp[28];
                        
                        InsertBD_DCEMP02_Init(item, pconn_DCEMP02_Init, ptran_DCEMP02_Init);
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    statutDCEMP02 = "ERREUR";
                    InsertTableLogJob("LoadFichierDCEMP02_Init() - Ligne :: " + noLine.ToString(), ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Load le fichier dans la BD ZK initial et hebdo
            ///
            /////////////////////////////////////////////////////////////////////
            void LoadFichierZK(string[] plines)
            {
                InsertTableLogChargement("TraiteCCQ_Initial", "LoadFichierZK");

                bool ifFirstRow = true;
                int noLigne = 0;
                string[] strGroupeLineImp = new string[0];

                try
                {
                    foreach (string line in plines)
                    {
                        if (line.Count(c => c == '|') > 0 && !(ifFirstRow))
                        {
                            strGroupeLineImp = new string[0];
                            strGroupeLineImp = line.ToString().Split('|');
                            noLigne = noLigne + 1;

                            if (int.TryParse(strGroupeLineImp[0], NumberStyles.Any, CultureInfo.InvariantCulture, out int tmpCleRapportCtrl))
                                StructureZK.intCleRapportCtrl.Add(tmpCleRapportCtrl);

                            StructureZK.strAbrev_IG.Add(strGroupeLineImp[1]);
                            StructureZK.strNomFichierZIP.Add(strGroupeLineImp[2]);
                            StructureZK.strDateEnvoi.Add(strGroupeLineImp[3]);
                            StructureZK.strHeure.Add(strGroupeLineImp[4]);
                            StructureZK.strNomFichier.Add(strGroupeLineImp[5]);
                            StructureZK.strDescription.Add(strGroupeLineImp[6]);

                            if (int.TryParse(strGroupeLineImp[7], NumberStyles.Any, CultureInfo.InvariantCulture, out int tmpNombreLignes))
                                StructureZK.intNombreLignes.Add(tmpNombreLignes);
                        }
                        else if (ifFirstRow)
                        {
                            ifFirstRow = false;
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("LoadFichierZK() - Ligne :: " + noLigne.ToString(), ex.Message.ToString());
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Insert dans la BD
            ///
            ///////////////////////////////////////////////////////////////////////
            void InsertBD_DCEMP02_Init(Structure_DCEMP02_Init pitem, SqlConnection pconn_DCEMP02_Init, SqlTransaction ptran_DCEMP02_Init)
            {
                string strcmdSql = @"insert into [SDEXT01].[CCQ].[EMPL_REL_HISTORY_tmp] (CLIENT_REL_NO, CLIENT_EMP_NO, DEB_EFFECT_DT, FIN_EFFECT_DT, ACTIF_IND, REG_ADMIN_NM, ENTRP_NM, 
                                                                                         FONCTION_NM, NOM, PRENOM, ENTRP_REL_NM, ADR, VILLE_NM, PROV_CD, CP_CD, PAYS_NM, TEL_NO, COURRIEL_ADR, 
                                                                                         NAISS_DT, STATUT_REL_NM, AUTRE_NOM_ENTRP_REL, TEL_AUTRE_NO, FAX_NO, INSOLVAB_DT, 
                                                                                         DECES_DT, PRESUME_DECES_DT, DEB_FONCTION_DT, FIN_FONCTION_DT, RECEPT_DESIGN_DT, ENREG_DESIGN_DT, 
                                                                                         MIGRATION_FLAG, MIGRATION_DATE, CREAT_DT, CREAT_UTIL_ID, MODIF_DT, MODIF_UTIL_ID) 
                                                                                   values(@strNoClientRelation, @strNoClientEmployeur, @dtDebEffect, @dtFinEffect, @indActif, @strRegionAdministrative, @strNomEntreprise, @strFonction, 
                                                                                          @strNom, @strPrenom, @strNomEntrepriseRelation, @strAdresse, @strVille, @strProvince, @strCodePostal, @strPays, @strTelephone, @strCourriel, @dtDateNaissance, @strStatutRelation, 
                                                                                          @strAutreNomEntrepriseRelation, @strTelephoneAutre, @strFax, 
                                                                                          @dtDateInsolvabilite, @dtDateDeces, @dtDatePresumeDeces, @dtDateDebutFonction, @dtDateFinFonction, @dtDateReceptionDesignation, @dtDateEnregistrementDesignation, 
                                                                                          'Y', @dtMigration, @dtDebEffect, 'LEGACY', @dtDebEffect, 'LEGACY')";
                
                try
                {
                    SqlCommand SQLCommandExec = new SqlCommand(strcmdSql, pconn_DCEMP02_Init, ptran_DCEMP02_Init);
                    SQLCommandExec.CommandTimeout = 12000;

                    try
                    {
                        SQLCommandExec.Parameters.AddWithValue("@strNoClientRelation", pitem.strNoClientRelation);
                        SQLCommandExec.Parameters.AddWithValue("@strNoClientEmployeur", pitem.strNoClientEmployeur);
                        SQLCommandExec.Parameters.AddWithValue("@dtDebEffect", new DateTime(1950, 1, 1));
                        SQLCommandExec.Parameters.AddWithValue("@dtFinEffect", new DateTime(1950, 1, 1));
                        SQLCommandExec.Parameters.AddWithValue("@indActif", "N");
                        SQLCommandExec.Parameters.AddWithValue("@strRegionAdministrative", pitem.strRegionAdministrative); 
                        SQLCommandExec.Parameters.AddWithValue("@strNomEntreprise", pitem.strNomEntreprise);
                        SQLCommandExec.Parameters.AddWithValue("@strFonction", pitem.strFonction);
                        SQLCommandExec.Parameters.AddWithValue("@strNom", pitem.strNom);
                        SQLCommandExec.Parameters.AddWithValue("@strPrenom", pitem.strPrenom);
                        SQLCommandExec.Parameters.AddWithValue("@strNomEntrepriseRelation", pitem.strNomEntrepriseRelation);
                        SQLCommandExec.Parameters.AddWithValue("@strAdresse", pitem.strAdresse);
                        SQLCommandExec.Parameters.AddWithValue("@strVille", pitem.strVille);
                        SQLCommandExec.Parameters.AddWithValue("@strProvince", pitem.strProvince);
                        SQLCommandExec.Parameters.AddWithValue("@strCodePostal", pitem.strCodePostal);
                        SQLCommandExec.Parameters.AddWithValue("@strPays", pitem.strPays);
                        SQLCommandExec.Parameters.AddWithValue("@strTelephone", pitem.strTelephone);
                        SQLCommandExec.Parameters.AddWithValue("@strCourriel", pitem.strCourriel);
                        SQLCommandExec.Parameters.AddWithValue("@dtDateNaissance", pitem.dtDateNaissance ?? (object)DBNull.Value);
                        SQLCommandExec.Parameters.AddWithValue("@strStatutRelation", pitem.strStatutRelation);
                        SQLCommandExec.Parameters.AddWithValue("@strAutreNomEntrepriseRelation", pitem.strAutreNomEntrepriseRelation);
                        SQLCommandExec.Parameters.AddWithValue("@strTelephoneAutre", pitem.strTelephoneAutre);
                        SQLCommandExec.Parameters.AddWithValue("@strFax", pitem.strFax);
                        /* N'est pas dans la table 
                        SQLCommandExec.Parameters.AddWithValue("@dtDateDebutValidite", pitem.dtDateDebutValidite ?? (object)DBNull.Value);
                        SQLCommandExec.Parameters.AddWithValue("@dtDateFinValidite", pitem.dtDateFinValidite ?? (object)DBNull.Value);
                        */
                        SQLCommandExec.Parameters.AddWithValue("@dtDateInsolvabilite", pitem.dtDateInsolvabilite ?? (object)DBNull.Value);
                        SQLCommandExec.Parameters.AddWithValue("@dtDateDeces", pitem.dtDateDeces ?? (object)DBNull.Value);
                        SQLCommandExec.Parameters.AddWithValue("@dtDatePresumeDeces", pitem.dtDatePresumeDeces ?? (object)DBNull.Value);
                        SQLCommandExec.Parameters.AddWithValue("@dtDateDebutFonction", pitem.dtDateDebutFonction ?? (object)DBNull.Value);
                        SQLCommandExec.Parameters.AddWithValue("@dtDateFinFonction", pitem.dtDateFinFonction ?? (object)DBNull.Value);
                        SQLCommandExec.Parameters.AddWithValue("@dtDateReceptionDesignation", pitem.dtDateReceptionDesignation ?? (object)DBNull.Value);
                        SQLCommandExec.Parameters.AddWithValue("@dtDateEnregistrementDesignation", pitem.dtDateEnregistrementDesignation ?? (object)DBNull.Value);
                        SQLCommandExec.Parameters.AddWithValue("@dtMigration", new DateTime(2025, 12, 31)); 

                        SQLCommandExec.ExecuteNonQuery();
                    }
                    catch (Exception ex)
                    {
                        blErreurExecution = true;
                        InsertTableLogJob("InsertBD_DCEMP02_Init(" + pitem.strNoClientEmployeur + ")", ex.Message);
                    }
                }
                catch (Exception ex)
                {
                    blErreurExecution = true;
                    InsertTableLogJob("InsertBD_DCEMP02_Init", ex.Message);
                }
            }

