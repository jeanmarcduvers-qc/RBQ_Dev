        public const string delLogChargement = "DELETE [SDEXT01].[CFG].[Log_Chargement_Connecteur] where Application = 'TraiteCCQ_Initial'";
        public const string delLogJobChargement = "DELETE [SDEXT01].[CFG].[Log_Job_Connecteur] where Application = 'TraiteCCQ_Initial'";
        public const string tblAfficheErreur = "SELECT * FROM [SDEXT01].[CFG].[Log_Job_Connecteur] where Application = 'TraiteCCQ_Initial'";


        public string newLine = Environment.NewLine;
        public bool blErreurExecution = false;
        public DateTime dtDateDebut = DateTime.Now;
        public string dtExecution = "";
        public string strTableName = "";  // Nom de la table d'insertion selon le type de fichier Hebdo ou Initial

        public void Main()
        {
            // TODO: Add your code here
            TraiteCCQ_Initial();
            Dts.TaskResult = (int)ScriptResults.Success;

        }

        public void TraiteCCQ_Initial()
        {
            // Récupére les paramètres
            string EnvoyePar = FindConfigParm("COMMUN", "EnvoyePar");
            string strCheminIn = FindConfigParm("CCQ_ETL", "RepertoireIn");
            string strCheminFchArch = FindConfigParm("CCQ_ETL", "RepertoireArchive");
            string strCheminRejet = FindConfigParm("CCQ_ETL", "RepertoireRejet");
            strServerBD = FindConfigParm("CCQ_ETL", "ServerBD");
            string strEnvoisCourrielA = FindConfigParm("CCQ_ETL", "EnvoisCourrielA");

            string statutDCEMP02 = "EN_COURS";
            bool ifFirstline = true;
            int intLineCount = 0;

            //tableaux
            string[] lines = new string[0];


            if (blErreurExecution != true)
            {
                // delete l'historique du dernier log de chargement
                // DeleteTableLogChargement();
                ExecuteSQL("CCQ", delLogJobChargement);


                InsertTableLogChargement("TraiteCCQ_Initial", "Début du traitement");
                                
                // Valide qu'il y est seulement un fichier ZIP dans le répertoire sinon c'est une erreur
                DirectoryInfo d = new DirectoryInfo(strCheminIn);
                FileInfo[] FilesCCQzip = d.GetFiles("*ZK001BZ014*.zip");

                if (FilesCCQzip.Length > 1)
                {
                    InsertTableLogJob("TraiteConnecteur()", "Il existe plusieurs fichiers pour CCQ Initial (....).");
                    blErreurExecution = true;
                }
                else if (FilesCCQzip.Length == 1)
                {
                    DecompresseFichier(strCheminIn, FilesCCQzip[0].Name);
                    fichierArchive = FilesCCQzip[0].Name;
                }

                try
                {

                    // Traite les fichiers
                    if (blErreurExecution != true)
                    {
                        // Lire le répertoire pour le fichier ZK Initial et Hebdo
                        var fichiers = new DirectoryInfo(strCheminIn).GetFiles("ZK*INITIAL*.TXT");
                        var encoding = Encoding.Default;

                        // Boucle sur le fichier
                        foreach (var fichier in fichiers)
                        {
                            string cheminComplet = fichier.FullName;
                            DateTime dateCreation = fichier.CreationTime;

                            // lire le contenu
                            lines = File.ReadAllLines(@fichier.FullName, encoding);

                            StructureZK = new Structure_ZK();
                            LoadFichierZK(lines);

                            InsertBD_ZK();
                            SupprimeFichier(@fichier.FullName);
                        }

                        // Lire le répertoire pour le fichier DCEMP02_Initial
                        fichiers = new DirectoryInfo(strCheminIn).GetFiles("DCEMP02*Initial*.TXT");
                        encoding = Encoding.Default;

                        // Boucle sur le fichier
                        foreach (var fichier in fichiers)
                        {
                            string cheminComplet = fichier.FullName;
                            DateTime dateCreation = fichier.CreationTime;

                            UpdateCtrlHebdo(FilesCCQzip[0].Name, fichier.Name, statutDCEMP02);

                            IfTableExists("[SDEXT01].[CCQ].[EMPL_REL_HISTORY_tmp]");
                            ExecuteSQL("CCQ", "select * into [SDEXT01].[CCQ].[EMPL_REL_HISTORY_tmp] from [SDEXT01].[CCQ].[EMPL_REL_HISTORY] where  1 = 0");

                            InsertTableLogChargement("TraiteCCQ_Initial", "LoadFichierDCEMP02_Init()");
                            SqlConnection conn_DCEMP02_Init = new SqlConnection(strServerBD);
                            conn_DCEMP02_Init.Open();
                            SqlTransaction tran_DCEMP02_Init = conn_DCEMP02_Init.BeginTransaction();

                            foreach (var line in File.ReadLines(fichier.FullName, encoding))
                            {
                                if (ifFirstline)
                                {
                                    ifFirstline = false;
                                }
                                else
                                {
                                    intLineCount++;
                                    LoadFichierDCEMP02_Init(line, intLineCount, conn_DCEMP02_Init, tran_DCEMP02_Init);
                                }
                            }

                            InsertBD_Destination(conn_DCEMP02_Init, tran_DCEMP02_Init);
                            tran_DCEMP02_Init.Commit();

                            if (statutDCEMP02 != "ERREUR")
                            {
                                statutDCEMP02 = "CHARGE";
                            }
                            UpdateCtrlHebdo(FilesCCQzip[0].Name, fichier.Name, statutDCEMP02);
                            SupprimeFichier(@fichier.FullName);
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("TraiteCCQ_Initial()", ex.Message.ToString());
                }
            }

            if (blErreurExecution)
            {
                CreerFichierRejet();
                Email_Send();
            }
            else
            {
                if (fichierArchive.ToString() != "")
                {
                    ArchiveFichier(strCheminIn + fichierArchive, strCheminFchArch, fichierArchive, true);
                }
            }

            InsertTableLogChargement("TraiteCCQ_Initial", "Fin du traitement");

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Récupére les valeurs de la table config
            ///
            ///////////////////////////////////////////////////////////////////////
            string FindConfigParm(string pCdSystem, string pCdParm)
            {
                string sqlCmd = "SELECT parm.valeur_parm as ValeurParm " +
                                "FROM  [SDEXT01].[CFG].[CFG_CONFIG] co, " +
                                      "[SDEXT01].[CFG].[CFG_CONFIG_PARM] parm " +
                                "where co.[CD_SYSTEM] = '" + pCdSystem + "' " +
                                "and   co.[IND_ACTIF] = 'O' " +
                                "and parm.[CD_SYSTEM] = co.[CD_SYSTEM] " +
                                "and parm.[IND_ACTIF] = 'O' " +
                                "and parm.[CD_PARAM] = '" + pCdParm + "'";

                string valParm = "";

                try
                {
                    using (SqlConnection mySQLConnectionParm = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnectionParm.Open();

                        using (SqlCommand SQLCommandCfg = new SqlCommand(sqlCmd.ToString(), mySQLConnectionParm))
                        {

                            SQLCommandCfg.CommandType = CommandType.Text;
                            SqlDataReader readerCfg = SQLCommandCfg.ExecuteReader();
                            readerCfg.Read();
                            valParm = readerCfg["ValeurParm"].ToString();
                            readerCfg.Close();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "FindConfigParm(" + pCdSystem + "." + pCdParm + ")");
                }
                return valParm;
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Update région administrative
            ///
            ///////////////////////////////////////////////////////////////////////
            void UpdateRegionAdm(string ptable, string pColonne, string pCpCD)
            {
                string sqlCmd = "update " + ptable.ToString() + " " +
                                "set " + pColonne.ToString() + " = (select top 1 mun.DR_C_REGN_ADMN " +
                                                                   "from [SDGIC01].[DRT].[DR1_CODE_POST] cdp " +
                                                                         "inner join [SDGIC01].[DRT].[DR1_MUNC]  mun on mun.DR_C_MUNC = cdp.DR_C_MUNC " +
                                                                   "where cdp.DR_C_POST_MUNC = replace(" + ptable.ToString() + "." + pCpCD.ToString() + ", ' ', '')) ";

                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        SqlTransaction transaction = mySQLConnection.BeginTransaction();
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlCmd, mySQLConnection, transaction))
                        {
                            SQLCommandExec.CommandText = @sqlCmd.ToString();
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.ExecuteNonQuery();
                        }
                        transaction.Commit();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "UpdateRegionAdm(" + ptable + "." + pColonne + ")");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Update les stats
            ///
            ///////////////////////////////////////////////////////////////////////
            void UpdateCtrlHebdo(string pNomFichierZip, string pNomFichierTxt, string pStatut)
            {
                int intCmdTrait = 0;

                string sqlcmd = @"update [SDEXT01].[CCQ].[CTRL_INIT] 
                                  set    [CHARG_STATUT_CD] = @strStatut, 
                                         [CHARG_DT] = @dtCharge
                                  where [FICH_ZIP_NM] = @strZipNm 
                                  and   [FICHIER_NM]  = @strTxtNm ";

                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnection.Open();
                        SqlTransaction transaction = mySQLConnection.BeginTransaction();
                        
                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlcmd, mySQLConnection, transaction))
                        {
                            //SQLCommandExec.CommandText = sqlTrait.ToString();
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.Parameters.Add("@strStatut", SqlDbType.VarChar, 20);
                            SQLCommandExec.Parameters.Add("@dtCharge", SqlDbType.DateTime);
                            SQLCommandExec.Parameters.Add("@strZipNm", SqlDbType.VarChar, 100);
                            SQLCommandExec.Parameters.Add("@strTxtNm", SqlDbType.VarChar, 100);


                            SQLCommandExec.Parameters["@strStatut"].Value = pStatut;
                            SQLCommandExec.Parameters["@dtCharge"].Value = dtTraitementSSIS;
                            SQLCommandExec.Parameters["@strZipNm"].Value = pNomFichierZip.Substring(pNomFichierZip.IndexOf("ZK"));
                            SQLCommandExec.Parameters["@strTxtNm"].Value = pNomFichierTxt;

                            intCmdTrait = (int)SQLCommandExec.ExecuteNonQuery();

                            if (intCmdTrait == 0)
                            {
                                InsertTableLogJob("ERR", "Le nom du fichier ZIP ou TXT n’est pas identique au fichier de contrôle");
                            }
                        }
                        transaction.Commit();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "UpdateCtrlHebdo(" + pNomFichierTxt + ")");
                }
            }

