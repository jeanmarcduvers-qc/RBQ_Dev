    <DataSet Name="ComposantCBCS">
      <Query>
        <DataSourceName>ComposantsCBCS</DataSourceName>
        <CommandText>SELECT NomProprio, No_Intervenant, Adr_Intervenant, NomContact, CourrielContact, NoTelContact, NoCellContact, AutreProprio, CodeQualif, NoSite, NomSite, AdresseSite, Contact_Concierge, NoTelConcierge, NoCellConcierge, Contrainte, NoteInspecteur, AnConstruc, NbEtage, Aire, A1, A2, A3, A4, B1, B2, B3, C, D, E, F1, F2, F3, NbEtageSS, Type_Capacite, Maximum_Capacite, Agrandissement, AjoutEtage, ChgUsage, PresenceStationnement, NbEtageStationnement, Construction, Gicleur, MesureDifferente, Diff_AS, Diff_BA, Diff_EL, Diff_PB, Diff_GA, Nbr_ITRE, No_ITRE, Ascenseur, EscMecanique, MonteCharge, AscHandicape, AppLevage, NoCell_Intervenant, FournisseurGAS, NotePPA, Composante, CBCS
FROM ORGRE_Fiche_Inspecteur
WHERE Composante = 1;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
