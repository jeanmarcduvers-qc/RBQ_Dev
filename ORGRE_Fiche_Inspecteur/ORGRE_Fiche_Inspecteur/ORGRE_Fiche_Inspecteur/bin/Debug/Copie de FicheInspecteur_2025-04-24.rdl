                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>=iif(First(Fields!NbEtage.Value, "Fiche_Inspecteur") &gt; 11, chr(254),
iif(First(Fields!NbEtage.Value, "Fiche_Inspecteur") &gt; 5 And (( First(Fields!NbEtage.Value, "Fiche_Inspecteur") - 1) * First(Fields!Aire.Value, "Fiche_Inspecteur") / 28 / 3.96) &gt; 300 And GetChar(First(Fields!CodeQualif.Value, "Fiche_Inspecteur"), 1) = "F" , chr(254),
iif(First(Fields!NbEtage.Value, "Fiche_Inspecteur") &gt; 5 And (( First(Fields!NbEtage.Value, "Fiche_Inspecteur") - 1) * First(Fields!Aire.Value, "Fiche_Inspecteur") / 5.6 / 3.96) &gt; 300 And GetChar(First(Fields!CodeQualif.Value, "Fiche_Inspecteur"), 1) = "E" , chr(254),
iif(First(Fields!NbEtage.Value, "Fiche_Inspecteur") &gt; 5 And (( First(Fields!NbEtage.Value, "Fiche_Inspecteur") - 1) * First(Fields!Aire.Value, "Fiche_Inspecteur") / 9.3 / 3.96) &gt; 300 And GetChar(First(Fields!CodeQualif.Value, "Fiche_Inspecteur"), 1) = "D" , chr(254),
iif(First(Fields!NbEtage.Value, "Fiche_Inspecteur") &gt; 5 And (GetChar(First(Fields!CodeQualif.Value, "Fiche_Inspecteur"), 1) = "B" Or GetChar(First(Fields!CodeQualif.Value, "Fiche_Inspecteur"), 1) = "C") , chr(254),
iif(First(Fields!NbEtage.Value, "Fiche_Inspecteur") &gt; 3 And (GetChar(First(Fields!CodeQualif.Value, "Fiche_Inspecteur"), 1) = "B2" Or GetChar(First(Fields!CodeQualif.Value, "Fiche_Inspecteur"), 1) = "B3") , chr(254),
chr(111)))))))</Value>
                        <Style>
                          <FontFamily>Wingdings</FontFamily>
                          <FontSize>12pt</FontSize>
                          <Color>#333333</Color>
                        </Style>
