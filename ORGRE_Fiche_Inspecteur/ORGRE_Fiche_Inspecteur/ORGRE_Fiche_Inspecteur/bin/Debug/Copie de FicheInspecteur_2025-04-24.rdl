                                <Textbox Name="BatimentGrandHautPossible">
                                  <CanGrow>true</CanGrow>
                                  <KeepTogether>true</KeepTogether>
                                  <Paragraphs>
                                    <Paragraph>
                                      <TextRuns>
                                        <TextRun>
                                          <Value>=iif(Fields!NbEtage.Value &gt; 11, chr(254), iif(Fields!NbEtage.Value &gt; 5 And ((Fields!NbEtage.Value - 1) * Fields!Aire.Value / 28 / 3.96) &gt; 300 And GetChar(Fields!CodeQualif.Value, 1) = "F", chr(254), iif(Fields!NbEtage.Value &gt; 5 And ((Fields!NbEtage.Value - 1) * Fields!Aire.Value / 5.6 / 3.96) &gt; 300 And GetChar(Fields!CodeQualif.Value, 1) = "E", chr(254), iif(Fields!NbEtage.Value &gt; 5 And ((Fields!NbEtage.Value - 1) * Fields!Aire.Value / 9.3 / 3.96) &gt; 300 And GetChar(Fields!CodeQualif.Value, 1) = "D", chr(254), iif(Fields!NbEtage.Value &gt; 5 And (GetChar(Fields!CodeQualif.Value, 1) = "B" Or GetChar(Fields!CodeQualif.Value, 1) = "C"), chr(254), iif(Fields!NbEtage.Value &gt; 3 And (GetChar(Fields!CodeQualif.Value, 2) = "B2" Or GetChar(Fields!CodeQualif.Value, 2) = "B3"), chr(254), chr(111)))))))</Value>
                                          <Style>
                                            <FontFamily>Wingdings</FontFamily>
                                            <FontSize>12pt</FontSize>
                                            <Color>#333333</Color>
                                          </Style>
                                        </TextRun>
