    <DataSet Name="Fiche_Inspecteur_AS">
      <Query>
        <DataSourceName>DataSource</DataSourceName>
        <CommandText>SELECT        SiteParent, 
              SiteComposant, 
			  No_Id_SurLieu, 
			  Genre_Appareil, 
			  TypeMachine, 
			  cast(Nbre_Pallier as int) as Nbre_Pallier, 
			  NomFabricant, 
			  convert(char(10),DateMiseEnService, 120) as DateMiseEnService, 
			  Scelle, 
			  GI3_NM_ENDR, 
			  SousGenreApp, 
			  convert(char(10),Date_Dern_Insp, 120) as Date_Dern_Insp
FROM            dbo.ORGRE_Fiche_Inspecteur_AS</CommandText>
      </Query>
