    <DataSet Name="RM">
      <Query>
        <DataSourceName>DataSource</DataSourceName>
        <CommandText>SELECT dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS NoSite, 
       dbo_GI3_APPAREIL.GI3_N_IMMAT_APL AS No_Immatriculation, 
	   dbo_GI3_APPAREIL.GI3_N_APPR_LIEU_APL AS No_Id_SurLieu, 
	   dbo_GI3_VALEUR.GI3_DE_VALEUR AS Genre_Appareil, 
	   dbo_GI3_APPAREIL.GI3_NM_FABR_CONTR AS NomFabricant, 
	   convert(char(10),dbo_GI3_APPAREIL.GI3_D_INST, 120) AS DateMiseEnService, 
	   IIf(IsNull([dbo_GI3_APPAREIL_SCELLE].[GI3_C_ROWD_APPR], '') = '',' ',IIf(IsNull([dbo_GI3_APPAREIL_SCELLE].[GI3_D_FIN], '') = '','O','N')) AS Scelle, 
	   dbo_GI3_SITE_COMPOSANTE.GI3_NM_ENDR, 
	   IIf(IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') &lt;&gt; '' And IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') &lt;&gt; '',
	         IIf([Qry_Date_Dern_Activite].[DT_DERN_ACT]&gt;[Qry_Date_Dern_Activite].[DT_DERN_ACT],convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120),convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120)),
			 IIf(IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') &lt;&gt; '' And IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') = '',convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120),convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120))) AS Date_Dern_Insp
FROM (((([SDGIC01].[dbo].[GI3_APPAREIL] as dbo_GI3_APPAREIL 
         LEFT JOIN [SDGIC01].[dbo].[GI3_VALEUR] as dbo_GI3_VALEUR ON dbo_GI3_APPAREIL.GI3_C_GENR_APPR = dbo_GI3_VALEUR.GI3_NM_VALEUR) 
		 INNER JOIN [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_APPAREIL.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE) 
		 INNER JOIN [SDDMU01].[dbo].[ORGRE_Fiche_Inspecteur] insp on insp.NoSite = dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE and insp.Composante = 0
		 LEFT JOIN [SDGIC01].[dbo].[GI3_APPAREIL_SCELLE] as dbo_GI3_APPAREIL_SCELLE ON dbo_GI3_APPAREIL.GI3_C_ROWD_APPR = dbo_GI3_APPAREIL_SCELLE.GI3_C_ROWD_APPR) 
		 LEFT JOIN (SELECT dbo_GI3_ACTIVITE.GI3_C_ROWD_APPR AS CLE_APP_ACT, Max(dbo_GI3_ACTIVITE.GI3_D_FIN_ACTV) AS DT_DERN_ACT
					FROM [SDGIC01].[dbo].[GI3_ACTIVITE] as dbo_GI3_ACTIVITE 
					     INNER JOIN [SDGIC01].[dbo].[GI3_APPAREIL] as dbo_GI3_APPAREIL ON dbo_GI3_ACTIVITE.GI3_C_ROWD_APPR = dbo_GI3_APPAREIL.GI3_C_ROWD_APPR
					GROUP BY dbo_GI3_ACTIVITE.GI3_C_ROWD_APPR
					) Qry_Date_Dern_Activite ON dbo_GI3_APPAREIL.GI3_C_ROWD_APPR = Qry_Date_Dern_Activite.CLE_APP_ACT) 
		 LEFT JOIN (SELECT dbo_GI3_APPAREIL_XM.GI3_C_ROWD_APPR AS CLE_APP_XM, Max(dbo_GI3_APPAREIL_XM.GI3_D_INSP) AS DT_DERN_ASS
					FROM [SDGIC01].[dbo].[GI3_APPAREIL_XM] as dbo_GI3_APPAREIL_XM
					GROUP BY dbo_GI3_APPAREIL_XM.GI3_C_ROWD_APPR) Qry_Date_Dern_Inspection ON dbo_GI3_APPAREIL.GI3_C_ROWD_APPR = Qry_Date_Dern_Inspection.CLE_APP_XM
GROUP BY dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, 
         dbo_GI3_APPAREIL.GI3_N_IMMAT_APL, 
		 dbo_GI3_APPAREIL.GI3_N_APPR_LIEU_APL, 
		 dbo_GI3_VALEUR.GI3_DE_VALEUR, 
		 dbo_GI3_APPAREIL.GI3_NM_FABR_CONTR, 
		 convert(char(10),dbo_GI3_APPAREIL.GI3_D_INST, 120),
		 IIf(IsNull([dbo_GI3_APPAREIL_SCELLE].[GI3_C_ROWD_APPR], '') = '',' ',IIf(IsNull([dbo_GI3_APPAREIL_SCELLE].[GI3_D_FIN], '') = '','O','N')), 
		 dbo_GI3_SITE_COMPOSANTE.GI3_NM_ENDR, 
		 IIf(IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') &lt;&gt; '' And IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') &lt;&gt; '',IIf([Qry_Date_Dern_Activite].[DT_DERN_ACT]&gt;[Qry_Date_Dern_Activite].[DT_DERN_ACT],convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120),convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120)),IIf(IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') &lt;&gt; '' And IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') = '',convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120),convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120))), dbo_GI3_APPAREIL.GI3_C_TYPE_APPR, dbo_GI3_APPAREIL.GI3_S_APPR, dbo_GI3_VALEUR.GI3_I_ACTIF, dbo_GI3_VALEUR.GI3_C_VALEUR, dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP
HAVING (((dbo_GI3_APPAREIL.GI3_C_TYPE_APPR)='RM') AND ((dbo_GI3_APPAREIL.GI3_S_APPR)='ACTIF') AND ((dbo_GI3_VALEUR.GI3_I_ACTIF)='Y') AND ((dbo_GI3_VALEUR.GI3_C_VALEUR)='RBQ_GENRE_APPAREIL') AND ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP)='Actif' Or (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP)='Non exploite'))
ORDER BY dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, dbo_GI3_APPAREIL.GI3_N_APPR_LIEU_APL</CommandText>
      </Query>
      <Fields>
        <Field Name="NoSite">
          <DataField>NoSite</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="No_Immatriculation">
          <DataField>No_Immatriculation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="No_Id_SurLieu">
          <DataField>No_Id_SurLieu</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Genre_Appareil">
          <DataField>Genre_Appareil</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NomFabricant">
          <DataField>NomFabricant</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DateMiseEnService">
          <DataField>DateMiseEnService</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Scelle">
          <DataField>Scelle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GI3_NM_ENDR">
          <DataField>GI3_NM_ENDR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Date_Dern_Insp">
          <DataField>Date_Dern_Insp</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="JM">
      <Query>
        <DataSourceName>DataSource</DataSourceName>
        <CommandText>SELECT dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AS NoSite, 
       dbo_GI3_APPAREIL.GI3_N_IMMAT_APL AS No_Immatriculation, 
	   dbo_GI3_APPAREIL.GI3_N_APPR_LIEU_APL AS No_Id_SurLieu, 
	   dbo_GI3_VALEUR.GI3_DE_VALEUR AS Genre_Appareil, 
	   dbo_GI3_APPAREIL.GI3_NM_FABR_CONTR AS NomFabricant, 
	   convert(char(10),dbo_GI3_APPAREIL.GI3_D_INST, 120) AS DateMiseEnService, 
	   IIf(IsNull([dbo_GI3_APPAREIL_SCELLE].[GI3_C_ROWD_APPR], '') = '',' ',IIf(IsNull([dbo_GI3_APPAREIL_SCELLE].[GI3_D_FIN], '') = '','O','N')) AS Scelle, 
	   dbo_GI3_SITE_COMPOSANTE.GI3_NM_ENDR, 
	   IIf(IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') &lt;&gt; '' And IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') &lt;&gt; '',
	         IIf([Qry_Date_Dern_Activite].[DT_DERN_ACT]&gt;[Qry_Date_Dern_Activite].[DT_DERN_ACT],convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120),convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120)),
			 IIf(IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') &lt;&gt; '' And IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') = '',convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120),convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120))) AS Date_Dern_Insp
FROM (((([SDGIC01].[dbo].[GI3_APPAREIL] as dbo_GI3_APPAREIL 
         LEFT JOIN [SDGIC01].[dbo].[GI3_VALEUR] as dbo_GI3_VALEUR ON dbo_GI3_APPAREIL.GI3_C_GENR_APPR = dbo_GI3_VALEUR.GI3_NM_VALEUR) 
		 INNER JOIN [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_APPAREIL.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE) 
		 INNER JOIN [SDDMU01].[dbo].[ORGRE_Fiche_Inspecteur] insp on insp.NoSite = dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE and insp.Composante = 0
		 LEFT JOIN [SDGIC01].[dbo].[GI3_APPAREIL_SCELLE] as dbo_GI3_APPAREIL_SCELLE ON dbo_GI3_APPAREIL.GI3_C_ROWD_APPR = dbo_GI3_APPAREIL_SCELLE.GI3_C_ROWD_APPR) 
		 LEFT JOIN (SELECT dbo_GI3_ACTIVITE.GI3_C_ROWD_APPR AS CLE_APP_ACT, Max(dbo_GI3_ACTIVITE.GI3_D_FIN_ACTV) AS DT_DERN_ACT
					FROM [SDGIC01].[dbo].[GI3_ACTIVITE] as dbo_GI3_ACTIVITE 
					     INNER JOIN [SDGIC01].[dbo].[GI3_APPAREIL] as dbo_GI3_APPAREIL ON dbo_GI3_ACTIVITE.GI3_C_ROWD_APPR = dbo_GI3_APPAREIL.GI3_C_ROWD_APPR
					GROUP BY dbo_GI3_ACTIVITE.GI3_C_ROWD_APPR
					) Qry_Date_Dern_Activite ON dbo_GI3_APPAREIL.GI3_C_ROWD_APPR = Qry_Date_Dern_Activite.CLE_APP_ACT) 
		 LEFT JOIN (SELECT dbo_GI3_APPAREIL_XM.GI3_C_ROWD_APPR AS CLE_APP_XM, Max(dbo_GI3_APPAREIL_XM.GI3_D_INSP) AS DT_DERN_ASS
					FROM [SDGIC01].[dbo].[GI3_APPAREIL_XM] as dbo_GI3_APPAREIL_XM
					GROUP BY dbo_GI3_APPAREIL_XM.GI3_C_ROWD_APPR) Qry_Date_Dern_Inspection ON dbo_GI3_APPAREIL.GI3_C_ROWD_APPR = Qry_Date_Dern_Inspection.CLE_APP_XM
GROUP BY dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, 
         dbo_GI3_APPAREIL.GI3_N_IMMAT_APL, 
		 dbo_GI3_APPAREIL.GI3_N_APPR_LIEU_APL, 
		 dbo_GI3_VALEUR.GI3_DE_VALEUR, 
		 dbo_GI3_APPAREIL.GI3_NM_FABR_CONTR, 
		 convert(char(10),dbo_GI3_APPAREIL.GI3_D_INST, 120),
		 IIf(IsNull([dbo_GI3_APPAREIL_SCELLE].[GI3_C_ROWD_APPR], '') = '',' ',IIf(IsNull([dbo_GI3_APPAREIL_SCELLE].[GI3_D_FIN], '') = '','O','N')), 
		 dbo_GI3_SITE_COMPOSANTE.GI3_NM_ENDR, 
		 IIf(IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') &lt;&gt; '' And IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') &lt;&gt; '',IIf([Qry_Date_Dern_Activite].[DT_DERN_ACT]&gt;[Qry_Date_Dern_Activite].[DT_DERN_ACT],convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120),convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120)),IIf(IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') &lt;&gt; '' And IsNull([Qry_Date_Dern_Activite].[DT_DERN_ACT], '') = '',convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120),convert(char(10),[Qry_Date_Dern_Activite].[DT_DERN_ACT], 120))), dbo_GI3_APPAREIL.GI3_C_TYPE_APPR, dbo_GI3_APPAREIL.GI3_S_APPR, dbo_GI3_VALEUR.GI3_I_ACTIF, dbo_GI3_VALEUR.GI3_C_VALEUR, dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP
HAVING (((dbo_GI3_APPAREIL.GI3_C_TYPE_APPR)='JM') AND ((dbo_GI3_APPAREIL.GI3_S_APPR)='ACTIF') AND ((dbo_GI3_VALEUR.GI3_I_ACTIF)='Y') AND ((dbo_GI3_VALEUR.GI3_C_VALEUR)='RBQ_GENRE_APPAREIL') AND ((dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP)='Actif' Or (dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP)='Non exploite'))
ORDER BY dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, dbo_GI3_APPAREIL.GI3_N_APPR_LIEU_APL</CommandText>
      </Query>
      <Fields>
        <Field Name="NoSite">
          <DataField>NoSite</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="No_Immatriculation">
          <DataField>No_Immatriculation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="No_Id_SurLieu">
          <DataField>No_Id_SurLieu</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Genre_Appareil">
          <DataField>Genre_Appareil</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NomFabricant">
          <DataField>NomFabricant</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DateMiseEnService">
          <DataField>DateMiseEnService</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Scelle">
          <DataField>Scelle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GI3_NM_ENDR">
          <DataField>GI3_NM_ENDR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Date_Dern_Insp">
          <DataField>Date_Dern_Insp</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="GAZ">
      <Query>
        <DataSourceName>DataSource</DataSourceName>
        <CommandText>SELECT        sQry_Fiche_Inspecteur_GA.GI3_N_SITE AS NoSite, dbo_GI3_INTERVENANT.GI3_C_INTRVN, IIf(IsNull([dbo_GI3_INTERVENANT].[GI3_NM_INTRVN], '') = '', [NoIntrv_Gaz], LTrim([dbo_GI3_INTERVENANT].[GI3_NM_INTRVN])) 
                         AS Nom, IIf(IsNull([dbo_GI3_ADRESSE].[GI3_A_ADRS_LIGN_1], '') = '', '', [dbo_GI3_ADRESSE].[GI3_A_ADRS_LIGN_1] + ', ' + [dbo_GI3_ADRESSE].[GI3_A_ADRS_LIGN_2] + ', ' + [dbo_GI3_ADRESSE].[GI3_A_ADRS_LIGN_3]) 
                         AS Adresse
FROM            (([SDGIC01].[dbo].[GI3_INTERVENANT] AS dbo_GI3_INTERVENANT LEFT JOIN
                         [SDGIC01].[dbo].[GI3_LIEN_INTERVENANT_ADRESSE] AS dbo_GI3_LIEN_INTERVENANT_ADRESSE ON dbo_GI3_INTERVENANT.GI3_C_ROWD_INTRVN = dbo_GI3_LIEN_INTERVENANT_ADRESSE.GI3_C_ROWD_INTRVN) LEFT 
                         JOIN
                         [SDGIC01].[dbo].[GI3_ADRESSE] AS dbo_GI3_ADRESSE ON dbo_GI3_LIEN_INTERVENANT_ADRESSE.GI3_C_ROWD_ADRS = dbo_GI3_ADRESSE.GI3_C_ROWD_ADRS) RIGHT JOIN
                             (SELECT        dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, RTrim([dbo_GI3_NOTE_INTERVENTION_APPR_SITE].[GI3_DE_NOTE]) AS NoIntrv_Gaz
                               FROM            [SDGIC01].[dbo].[GI3_NOTE_INTERVENTION_APPR_SITE] AS dbo_GI3_NOTE_INTERVENTION_APPR_SITE INNER JOIN
                                                         [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] AS dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE INNER JOIN
                                                         [SDDMU01].[dbo].[ORGRE_Fiche_Inspecteur] AS insp ON insp.NoSite = dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE AND insp.Composante = 0
                               WHERE        dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SOUS_SUJT_NOTE = 'Alimentation en gaz' AND dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SUJT_NOTE_INTR = 'PPA' AND 
                                                         dbo_GI3_SITE_COMPOSANTE.GI3_DE_STAT_SITE_COMP IN ('Actif', 'Non exploite')) sQry_Fiche_Inspecteur_GA ON dbo_GI3_INTERVENANT.GI3_C_INTRVN = sQry_Fiche_Inspecteur_GA.NoIntrv_Gaz
WHERE        (((dbo_GI3_LIEN_INTERVENANT_ADRESSE.GI3_D_FIN) IS NULL) AND ((dbo_GI3_LIEN_INTERVENANT_ADRESSE.GI3_C_TYPE_UTIL) = 'Principale')) OR
                         (((dbo_GI3_LIEN_INTERVENANT_ADRESSE.GI3_C_ROWD_ADRS) IS NULL))</CommandText>
      </Query>
      <Fields>
        <Field Name="NoSite">
          <DataField>NoSite</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GI3_C_INTRVN">
          <DataField>GI3_C_INTRVN</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Nom">
          <DataField>Nom</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Adresse">
          <DataField>Adresse</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Fiche_Inspecteur_AS_Grp">
      <Query>
        <DataSourceName>DataSource</DataSourceName>
        <CommandText>SELECT        SiteComposant, SiteParent, GI3_NM_ENDR, count(1) AS nbRecord
FROM            ORGRE_Fiche_Inspecteur_AS
group by SiteComposant, SiteParent, GI3_NM_ENDR</CommandText>
      </Query>
      <Fields>
        <Field Name="SiteComposant">
          <DataField>SiteComposant</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SiteParent">
          <DataField>SiteParent</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GI3_NM_ENDR">
          <DataField>GI3_NM_ENDR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="nbRecord">
          <DataField>nbRecord</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
