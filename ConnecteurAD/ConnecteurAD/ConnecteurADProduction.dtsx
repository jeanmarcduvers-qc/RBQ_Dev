        public const string UpdateRBQutilisateur2 = "update[SDDMU01].[dbo].[RBQ_UTILISATEUR] set ACTIF_UTIL = 'O' where exists(select 1 from[SDDMU01].[dbo].[RBQ_UTILISATEUR_TMP] b where b.CODE_UTILISATEUR = [SDDMU01].[dbo].[RBQ_UTILISATEUR].CODE_UTILISATEUR and b.ACTIF_UTIL = 'O')";
