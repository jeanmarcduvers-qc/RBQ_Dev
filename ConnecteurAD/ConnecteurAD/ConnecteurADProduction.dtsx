                    readerRBQ.Read();
                    readerRBQ.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogChargement("ERR", "CreerTableRBQutilisateurTmp()");
                }
            }

