                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dans la table RBQ_AD_GROUP_UTILISATEUR
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableRBQUtilisateurgroup()
            {
                string sqlInsCmd = "insert into [SDDMU01].[dbo].[RBQ_AD_GROUP_UTILISATEUR]([ID_GROUP], [CODE_UTILISATEUR], [D_CRET], [C_UTIL_CRET]) values(";
                string sqlInsVal = "";
                string sqlInsStatment = "";

                for (int rowNum = 0; rowNum <= UtilisateurGroups.Count - 1; rowNum++)
                {
                    sqlInsVal = UtilisateurGroups[rowNum].IdGroup + ", '" +
                                UtilisateurGroups[rowNum].CodeUtilisateur.Replace("'", "''").ToString() + "', " +
                                "GETDATE(), 'Auto01')";

                    sqlInsStatment = sqlInsCmd.ToString() + sqlInsVal.ToString();

                    try
                    {
                        SqlCommand SQLCommandRBQ = new SqlCommand(sqlInsStatment.ToString(), mySQLConnection);
                        SQLCommandRBQ.CommandType = CommandType.Text;
                        SqlDataReader readerRBQ = SQLCommandRBQ.ExecuteReader();
                        readerRBQ.Read();
                        readerRBQ.Close();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        if (ex.Message.Contains("Violation de la contrainte PRIMARY KEY") != true)
                        {
                            blErreurExecution = true;
                            InsertTableLogJobConnecteur("InsertTableRBQUtilisateurgroup(" + groupAD.strNomGroup[rowNum].ToString() + ")", ex.Message.ToString());
                        }

                    }
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     envois courriel
            ///
            /////////////////////////////////////////////////////////////////////
            void Email_Send()
            {
                String strAfficheErreur = "";
                String EnvoisCourrielPar = Dts.Variables["User::EnvoyePar"].Value.ToString();
                String EnvoisCourrielA = "centre.de.pilotage@rbq.gouv.qc.ca"; //"centre.de.pilotage@rbq.gouv.qc.ca"; // "yves.mcduff-ext@rbq.gouv.qc.ca";
                String EnvoisCourrielSuject = "L'application (Connecteur AD) c'est terminé en erreur ";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine +
                                             "Voir les erreurs dans la table Log_Job_Connecteur" + newLine + newLine +
                                             "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boîte Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";
                // Lire les erreurs
                strAfficheErreur = strAfficheErreur.ToString() + "Une ou des tables de l'AD n'ont pas été chargées." + newLine;

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + strAfficheErreur.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();

                String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("Email_Send()", ex.Message.ToString());
                }
            }

            Dts.TaskResult = (int)ScriptResults.Success;

        }
        public List<GroupPrincipal> GetGroups(string userName)
        {
            List<GroupPrincipal> result = new List<GroupPrincipal>();
            PrincipalContext yourDomain = new PrincipalContext(ContextType.Domain, "MTR");

            // find your user
            UserPrincipal user = UserPrincipal.FindByIdentity(yourDomain, userName);

            // if found - grab its groups
            if (user != null)
            {
                PrincipalSearchResult<Principal> groups = user.GetAuthorizationGroups();

                // iterate over all groups
                foreach (Principal p in groups)
                {
                    // make sure to add only group principals
                    if (p is GroupPrincipal)
                    {
                        result.Add((GroupPrincipal)p);
                    }
                }
            }

            return result;
        }
        public static string GetProperty(DirectoryEntry searchResult, string PropertyName)
        {
            if (searchResult.Properties.Contains(PropertyName))
            {
                return searchResult.Properties[PropertyName][0].ToString();
            }
            else
            {
                return string.Empty;
            }
        }

        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion

    }
}]]></ProjectItem>
