                string sqlInsCmd = "insert into [SDDMU01].[dbo].[RBQ_AD_GROUP]([ID_GROUP], [NOM_GROUP], [DESCRIPTION_GROUP], [INFO_USER_PRINC], [D_CRET], [C_UTIL_CRET]) values(";
