                {
                    SqlCommand SQLCommandRBQ = new SqlCommand(sqlStatment.ToString(), mySQLConnection);
                    SQLCommandRBQ.CommandType = CommandType.Text;
                    SqlDataReader readerRBQ = SQLCommandRBQ.ExecuteReader();
                    readerRBQ.Read();
                    readerRBQ.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("MenageTableRBQmembreOf(delDoublonMembreof)", ex.Message.ToString());

                }

                sqlStatment = insertMembreOf;
                try
                {
                    SqlCommand SQLCommandRBQ = new SqlCommand(sqlStatment.ToString(), mySQLConnection);
                    SQLCommandRBQ.CommandType = CommandType.Text;
                    SqlDataReader readerRBQ = SQLCommandRBQ.ExecuteReader();
                    readerRBQ.Read();
                    readerRBQ.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("MenageTableRBQmembreOf(insertMembreOf)", ex.Message.ToString());

                }

                sqlStatment = dropMembreOf;
                try
                {
                    SqlCommand SQLCommandRBQ = new SqlCommand(sqlStatment.ToString(), mySQLConnection);
                    SQLCommandRBQ.CommandType = CommandType.Text;
                    SqlDataReader readerRBQ = SQLCommandRBQ.ExecuteReader();
