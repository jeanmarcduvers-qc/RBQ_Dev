            {
                string sqlDelCmdRBQ = CreerRBQutilisateurTmp.ToString();

                try
                {
                    SqlCommand DelCmdRBQ = new SqlCommand(sqlDelCmdRBQ.ToString(), mySQLConnection);
                    DelCmdRBQ.CommandType = CommandType.Text;
                    SqlDataReader readerRBQ = DelCmdRBQ.ExecuteReader();
                    readerRBQ.Read();
                    readerRBQ.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogChargement("ERR", "CreerRBQutilisateurTmp()");
                }
            }

