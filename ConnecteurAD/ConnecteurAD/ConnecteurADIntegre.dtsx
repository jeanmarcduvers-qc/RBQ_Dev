        public const string CreerRBQutilisateurTmp = "select * into [SDDMU01].[dbo].[RBQ_UTILISATEUR_TMP] from [SDDMU01].[dbo].[RBQ_UTILISATEUR] where [CODE_UTILISATEUR] is null";
        public const string delRBQgroup = "DELETE [SDDMU01].[dbo].[RBQ_AD_GROUP]";
        public const string delRBQmembreof = "DELETE [SDDMU01].[dbo].[RBQ_AD_MEMBRE_OF]";
        public const string delRBQgroupUtilisateur = "DELETE [SDDMU01].[dbo].[RBQ_AD_GROUP_UTILISATEUR]";
        public const string UpdateRBQutilisateur = "update[SDDMU01].[dbo].[RBQ_UTILISATEUR] set ACTIF_UTIL = 'N' where not exists(select 1 from[SDDMU01].[dbo].[RBQ_UTILISATEUR_TMP] b where b.CODE_UTILISATEUR = [SDDMU01].[dbo].[RBQ_UTILISATEUR].CODE_UTILISATEUR)";
        public const string UpdateRBQutilisateur2 = "update[SDDMU01].[dbo].[RBQ_UTILISATEUR] set ACTIF_UTIL = 'O' where exists(select 1 from[SDDMU01].[dbo].[RBQ_UTILISATEUR_TMP] b where b.CODE_UTILISATEUR = [SDDMU01].[dbo].[RBQ_UTILISATEUR].CODE_UTILISATEUR and b.ACTIF_UTIL = 'O')";
        public const string UpdateRBQutilisateur3 = "UPDATE util " +
                                                    "SET util.[NOM] = util2.[NOM] " +
                                                    ", util.[COURRIEL] = util2.[COURRIEL] " +
                                                    ", util.[NUMERO_TELEPHONE] = util2.[NUMERO_TELEPHONE] " +
                                                    ", util.[MUNICIPALITE_BUREAU] = util2.[MUNICIPALITE_BUREAU] " +
                                                    ", util.[ADRESSE_BUREAU] = util2.[ADRESSE_BUREAU] " +
                                                    ", util.[CP_BUREAU] = util2.[CP_BUREAU] " +
                                                    ", util.[MO] = util2.[MO] " +
                                                    ", util.[VP] = util2.[VP] " +
                                                    ", util.[DIRECTION] = util2.[DIRECTION] " +
                                                    ", util.[SERVICE] = util2.[SERVICE] " +
                                                    ", util.[CR] = util2.[CR] " +
                                                    ", util.[DATE_DERN_CONNEXION] = util2.[DATE_DERN_CONNEXION] " +
                                                    "FROM[SDDMU01].[dbo].[RBQ_UTILISATEUR] util " +
                                                    "INNER JOIN [SDDMU01].[dbo].[RBQ_UTILISATEUR_TMP] util2 ON util2.[CODE_UTILISATEUR] = util.[CODE_UTILISATEUR] ";
        public const string dropRBQutilisateur = "DROP TABLE [SDDMU01].[dbo].[RBQ_UTILISATEUR_TMP]";
        public const string InsertRBQutilisateur = "insert into [SDDMU01].[dbo].[RBQ_UTILISATEUR] select * from [SDDMU01].[dbo].[RBQ_UTILISATEUR_TMP] b where not exists (select 1 from [SDDMU01].[dbo].[RBQ_UTILISATEUR] c where c.CODE_UTILISATEUR = b.CODE_UTILISATEUR)";
        public const string netRBQgroup = "delete gp from [SDDMU01].[dbo].[RBQ_AD_GROUP] gp where gp.ID_GROUP not in (select gp.ID_GROUP  from   [SDDMU01].[dbo].[RBQ_AD_GROUP_UTILISATEUR] gus where gp.ID_GROUP  = gus.ID_GROUP)";
        public const string DoublonMembreOf = "select * into [SDDMU01].[dbo].[RBQ_AD_MEMBRE_TMP] from (select nom_groupe,  nom_membre_of from [SDDMU01].[dbo].[RBQ_AD_MEMBRE_OF] group by nom_groupe, nom_membre_of having count(1) > 1) Doublon";
        public const string delDoublonMembreof = "delete [SDDMU01].[dbo].[RBQ_AD_MEMBRE_OF] where nom_groupe + nom_membre_of in (select nom_groupe + nom_membre_of from [SDDMU01].[dbo].[RBQ_AD_MEMBRE_TMP])";
        public const string insertMembreOf = "insert into [SDDMU01].[dbo].[RBQ_AD_MEMBRE_OF] (nom_groupe, nom_membre_of, d_creat, c_util_creat) select nom_groupe, nom_membre_of, GETDATE(), 'Auto01' from [SDDMU01].[dbo].[RBQ_AD_MEMBRE_TMP]";
        public const string dropMembreOf = "DROP TABLE [SDDMU01].[dbo].[RBQ_AD_MEMBRE_TMP]";
        public const string updateMembreOf = "update[SDDMU01].[dbo].[RBQ_AD_MEMBRE_OF] set id_group = (select top(1) b.id_group from[SDDMU01].[dbo].[RBQ_AD_GROUP] b where b.nom_group = nom_groupe), id_membre_of = (select top(1) c.id_group from[SDDMU01].[dbo].[RBQ_AD_GROUP] c where c.nom_group = nom_membre_of )";

        public int etape = 0;
        public string struser = "";
        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        public void Main()
        {
            // TODO: Add your code here
            string[] arrfieldInternalNameGroup = new string[0];
            string[] separatingGroup = { "," };

            String date = DateTime.Now.ToString("yyyy-MM-dd hh:mm:ss");
            String EnvoyePar = Dts.Variables["User::EnvoyePar"].Value.ToString();
            string ServerNameSql = @Dts.Variables["User::ServerName"].Value.ToString();
            SqlConnection mySQLConnection = Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction) as SqlConnection;

            int intRecord = 1;
            int position = 0;

            List<ADUtilisateur> users = new List<ADUtilisateur>();
            List<ADUtilisateurGroup> UtilisateurGroups = new List<ADUtilisateurGroup>();

            try
            {
                // delete l'historique du dernier log de chargement
                DeleteTableLogChargement();
                DeleteTableLogJobChargement();

                InsertTableLogChargement("ConnecteurAD", "Début du traitement");

                PrincipalContext AD = new PrincipalContext(ContextType.Domain, "MTR.INTRA");
                GroupPrincipal theGroup = new GroupPrincipal(AD);
                PrincipalSearcher gps = new PrincipalSearcher(theGroup);

                foreach (var found in gps.FindAll())
                {
                    etape = 1;
                    struser = "";
                    DirectoryEntry obj = (DirectoryEntry)found.GetUnderlyingObject();
                    var owner = obj.Properties["info"];
                    var MemberOf = obj.Properties["memberOf"];

                    if (MemberOf.Count != 0)
                    {
                        foreach (object memberOf in obj.Properties["memberOf"])
                        {
                            arrfieldInternalNameGroup = memberOf.ToString().Split(separatingGroup, System.StringSplitOptions.RemoveEmptyEntries);
                            MembreOfGroup.strGroup.Add(found.Name);
                            MembreOfGroup.strMembreOf.Add(arrfieldInternalNameGroup[0].Substring(3, arrfieldInternalNameGroup[0].Length - 3));
                        }
                    }

                    if (groupAD.strNomGroup.Contains(found.Name.ToString()) != true)
                    {
                        groupAD.intIdGroup.Add(intRecord++);
                        groupAD.strNomGroup.Add(found.Name.ToString());

                        if (found.Description == null)
                        {
                            groupAD.strDescriptionGroup.Add("");
                        }
                        else
                        {
                            groupAD.strDescriptionGroup.Add(found.Description.ToString());
                        }

                        if (owner.Value == null)
                        {
                            groupAD.strUserPrincipalName.Add("");
                        }
                        else
                        {
                            groupAD.strUserPrincipalName.Add(owner.Value.ToString());
                        }

                    }
                    else
                    {
                        position = groupAD.strNomGroup.FindIndex(x => x.ToString() == found.Name.ToString());

                        if (position != -1 && owner.Value != null)
                        {
                            groupAD.strUserPrincipalName[position] = owner.Value.ToString();
                        }

                    }
                }


                using (var context = new PrincipalContext(ContextType.Domain, "MTR.INTRA"))
                {
                    UserPrincipal principal = new UserPrincipal(context);
                    principal.Enabled = true;
                    using (var searcher = new PrincipalSearcher(principal))
                    {
                        foreach (var result in searcher.FindAll())
                        {
                            DirectoryEntry de = result.GetUnderlyingObject() as DirectoryEntry;

                            if ((GetProperty(de, "physicalDeliveryOfficeName").ToUpper() != "" && GetProperty(de, "physicalDeliveryOfficeName").Substring(0, 3).ToUpper() == "RBQ" && GetProperty(de, "SamAccountName").ToUpper() != "") ||
                                (GetProperty(de, "userPrincipalName").ToUpper().Contains("MTR.INTRA") && GetProperty(de, "SamAccountName").ToUpper() != ""))
                            {
                                try
                                {
                                    var user = new ADUtilisateur();
                                    blInsertUser = true;
                                    //if (GetProperty(de, "SamAccountName") == "MCDY01" || GetProperty(de, "SamAccountName") == "mcdy01")
                                    //{
                                    //    MessageBox.Show("Code utilisateur: " + GetProperty(de, "SamAccountName"));
                                    //    MessageBox.Show("Nom: " + GetProperty(de, "DisplayName"));
                                    //    MessageBox.Show("Numéro de téléphone: " + GetProperty(de, "telephoneNumber"));
                                    //    MessageBox.Show("Courriel: " + GetProperty(de, "mail"));
                                    //    MessageBox.Show("Municipalité du bureau: " + GetProperty(de, "l"));
                                    //    MessageBox.Show("Adresse du bureau: " + GetProperty(de, "StreetAddress"));
                                    //    MessageBox.Show("Code postal du bureau: " + GetProperty(de, "PostalCode"));
                                    //    MessageBox.Show("MO: " + GetProperty(de, "physicalDeliveryOfficeName"));
                                    //    MessageBox.Show("VP: " + GetProperty(de, "Title"));
                                    //    MessageBox.Show("Direction: " + GetProperty(de, "company"));
                                    //    MessageBox.Show("Service: " + GetProperty(de, "department"));
                                    //    MessageBox.Show("CR: " + GetProperty(de, "postOfficeBox"));
                                    //}
                                    etape = 2;
                                    struser = GetProperty(de, "SamAccountName").ToUpper();

                                    user.CodeUtilisateur = GetProperty(de, "SamAccountName").ToUpper();
                                    user.Nom = GetProperty(de, "DisplayName");
                                    user.NumeroTelephone = GetProperty(de, "telephoneNumber");
                                    user.Courriel = GetProperty(de, "mail");
                                    user.MunicipaliteBureau = GetProperty(de, "l");
                                    user.AdresseBureau = GetProperty(de, "StreetAddress");
                                    user.CpBureau = GetProperty(de, "PostalCode");
                                    user.Mo = GetProperty(de, "physicalDeliveryOfficeName");
                                    user.Vp = GetProperty(de, "Title");
                                    user.Direction = GetProperty(de, "company");
                                    user.Service = GetProperty(de, "department");
                                    user.Cr = GetProperty(de, "postOfficeBox");

                                    var auth = result as AuthenticablePrincipal;
                                    if (auth != null)
                                    {
                                        user.DateDernConnexion = auth.LastLogon.ToString();
                                    }

                                    if (user.CodeUtilisateur.ToString() != "")
                                    {
                                        try
                                        {
                                            UserPrincipal utilisateurgroup = UserPrincipal.FindByIdentity(context, IdentityType.SamAccountName, GetProperty(de, "SamAccountName"));

                                            if (utilisateurgroup != null)
                                            {
                                                foreach (var resultUserGroup in utilisateurgroup.GetGroups(context))
                                                {
                                                    var UtilisateurGroupAD = new ADUtilisateurGroup();
                                                    if (groupAD.strNomGroup.Contains(resultUserGroup.Name.ToString()))
                                                    {
                                                        position = groupAD.strNomGroup.FindIndex(x => x.ToString() == resultUserGroup.Name.ToString());
                                                        etape = 3;
                                                        struser = user.CodeUtilisateur.ToString();
                                                        UtilisateurGroupAD.CodeUtilisateur = user.CodeUtilisateur.ToString();
                                                        UtilisateurGroupAD.IdGroup = groupAD.intIdGroup[position];
                                                        UtilisateurGroups.Add(UtilisateurGroupAD);
                                                    }
                                                }
                                            }
                                        }
                                        catch (Exception ex)
                                        {
                                            //MessageBox.Show(ex.Message);
                                            blInsertUser = false;
                                        }
                                    }

                                    if (blInsertUser)
                                    {
                                        users.Add(user);
                                    }
                                }
                                catch (Exception ex)
                                {
                                    //MessageBox.Show(ex.Message);
                                    blErreurExecution = true;
                                    InsertTableLogChargement("ERR", "Construire la liste users");
                                    InsertTableLogChargement("ERR", ex.Message.ToString());
                                }
                            }

                        }
                    }

                    // vide la table RBQ_Utilisateur, RBQ_AD_GROUP et RBQ_GROUP_UTILISATEUR
                    CreerTableRBQutilisateurTmp();
                    DeleteTableRBQgroup();
                    DeleteTableRBQmembreof();
                    DeleteTableRBQgroupUtilisateur();

                    // insert dans la table RBQ_Utilisateur, RBQ_AD_GROUP, RBQ_AD_MEMBRE_OF et RBQ_GROUP_UTILISATEUR
                    InsertTableRBQutilisateur(users);
                    UpdateTableRBQutilisateur();
                    InsertTableRBQgroup();
                    InsertTableRBQmembreOf();
                    InsertTableRBQUtilisateurgroup();
                    MenageTableRBQmembreOf();

                    // Nettoyer la table des goupes inutiles
                    // NettoyerTableRBQgroup();  YvesMcDuff ne plus utiliser

                    if (blErreurExecution)
                    {
                        InsertTableLogChargement("ConnecteurAD", "Erreur traitement");
                        Email_Send();
                    }
                    else
                    {
                        InsertTableLogChargement("ConnecteurAD", "Fin du traitement");
                    }
                }
            }
            catch (Exception ex)
            {
                // Log SSIS + SQL Job
                Dts.Events.FireError(0, "ConnecteurAD", ex.ToString(), "", 0);

                // Log dans ta table (optionnel mais recommandé)
                InsertTableLogChargement("ERR_FATAL", ex.ToString());

                // Retourner une erreur à SSIS
                Dts.TaskResult = (int)ScriptResults.Failure;
                return;
            }

            // Si tout est OK
            Dts.TaskResult = (int)ScriptResults.Success;

