            /////////////////////////////////////////////////////////////////////
            void InsertTableLogChargement(string strIndSystem, string strSqlTable)
            {
                string sqlInsCmd = "insert into[SDDMU01].[dbo].[Log_Chargement_Connecteur] values('ConnecteurAD', '" + strIndSystem + "', '" + strSqlTable + "', GETDATE(), 'Auto01', 'Tâche Automatisée')";

                try
                {
                    SqlCommand SQLCommandLog = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandLog.CommandType = CommandType.Text;
                    SqlDataReader readerLog = SQLCommandLog.ExecuteReader();
                    readerLog.Read();
                    readerLog.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("InsertTableLogChargement()", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dans la table Log_Job_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogJobConnecteur(string pFonction, string pErreurMessage)
            {
                int lParametreErreurMessage;
                pErreurMessage = pErreurMessage.Replace("'", "''");
                lParametreErreurMessage = pErreurMessage.Length;

                if (pErreurMessage.Length > 250)
                {
                    pErreurMessage = pErreurMessage.Substring(0, 245);
                    pErreurMessage = pErreurMessage + "...";
                }

                string sqlInsCmd = "insert into[SDDMU01].[dbo].[Log_Job_Connecteur] values('ConnecteurAD', '" + "AD" + "', '" + "Load Active Directory" + "', '" + pFonction + "', 'Erreur', '" + pErreurMessage + "', 'Auto01', GETDATE())";

                try
                {
                    SqlCommand SQLCommandJob = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandJob.CommandType = CommandType.Text;
                    SqlDataReader readerErreur = SQLCommandJob.ExecuteReader();
                    readerErreur.Read();
                    readerErreur.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogChargement("ERR", "Impossible d'insérer dans Log_Job_Connecteur");
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dans la table RBQ_UTILISATEUR
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableRBQutilisateur(List<ADUtilisateur> pUser)
            {
                string sqlInsCmd = "insert into [SDDMU01].[dbo].[RBQ_UTILISATEUR_TMP]([CODE_UTILISATEUR], [NOM], [NUMERO_TELEPHONE], [COURRIEL], [MUNICIPALITE_BUREAU], " +
                                   "[ADRESSE_BUREAU], [CP_BUREAU], [MO], [VP], [DIRECTION], [SERVICE], [CR], [DATE_DERN_CONNEXION], [D_CRET], [C_UTIL_CRET], [ACTIF_UTIL]) values('";
                string sqlInsVal = "";
                string sqlInsStatment = "";

                for (int rowNum = 0; rowNum <= pUser.Count - 1; rowNum++)
                {
                    
                    sqlInsVal = pUser[rowNum].CodeUtilisateur.Replace("'", "''").ToString() + "', '" +
                                pUser[rowNum].Nom.Replace("'", "''").ToString() + "', '" +
                                pUser[rowNum].NumeroTelephone.Replace("'", "''").ToString() + "', '" +
                                pUser[rowNum].Courriel.Replace("'", "''").ToString() + "', '" +
                                pUser[rowNum].MunicipaliteBureau.Replace("'", "''").ToString() + "', '" +
                                pUser[rowNum].AdresseBureau.Replace("'", "''").ToString() + "', '" +
                                pUser[rowNum].CpBureau.Replace("'", "''").ToString() + "', '" +
                                pUser[rowNum].Mo.Replace("'", "''").ToString() + "', '" +
                                pUser[rowNum].Vp.Replace("'", "''").ToString() + "', '" +
                                pUser[rowNum].Direction.Replace("'", "''").ToString() + "', '" +
                                pUser[rowNum].Service.Replace("'", "''").ToString() + "', '" +
                                pUser[rowNum].Cr.Replace("'", "''").ToString() + "', convert(datetime,'" +
                                pUser[rowNum].DateDernConnexion.ToString() + "', 120), " +
                                "GETDATE(), 'Auto01', " +
                                "'O')";

                    sqlInsStatment = sqlInsCmd.ToString() + sqlInsVal.ToString();

                    try
                    {
                        SqlCommand SQLCommandRBQ = new SqlCommand(sqlInsStatment.ToString(), mySQLConnection);
                        SQLCommandRBQ.CommandType = CommandType.Text;
                        SqlDataReader readerRBQ = SQLCommandRBQ.ExecuteReader();
                        readerRBQ.Read();
                        readerRBQ.Close();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        blErreurExecution = true;
                        InsertTableLogJobConnecteur("InsertTableRBQutilisateur(" + pUser[rowNum].CodeUtilisateur.ToString() + ")", ex.Message.ToString());
                        
                    }
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dans la table RBQ_AD_GROUP
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableRBQgroup()
            {
                string sqlInsCmd = "insert into [SDDMU01].[dbo].[RBQ_AD_GROUP]([ID_GROUP], [NOM_GROUP], [DESCRIPTION_GROUP], [INFO_USER_PRINC], [D_CRET], [C_UTIL_CRET]) values(";
                string sqlInsVal = "";
                string sqlInsStatment = "";

                for (int rowNum = 0; rowNum <= groupAD.intIdGroup.Count - 1; rowNum++)
                {
                    sqlInsVal = groupAD.intIdGroup[rowNum] + ", '" +
                                groupAD.strNomGroup[rowNum].Replace("'", "''").ToString() + "', '" +
                                groupAD.strDescriptionGroup[rowNum].Replace("'", "''").ToString() + "', '" +
                                groupAD.strUserPrincipalName[rowNum].Replace("'", "''").ToString() + "', " +
                                "GETDATE(), 'Auto01')";

                    sqlInsStatment = sqlInsCmd.ToString() + sqlInsVal.ToString();

                    try
                    {
                        SqlCommand SQLCommandRBQ = new SqlCommand(sqlInsStatment.ToString(), mySQLConnection);
                        SQLCommandRBQ.CommandType = CommandType.Text;
                        SqlDataReader readerRBQ = SQLCommandRBQ.ExecuteReader();
                        readerRBQ.Read();
                        readerRBQ.Close();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        blErreurExecution = true;
                        InsertTableLogJobConnecteur("InsertTableRBQgroup(" + groupAD.strNomGroup[rowNum].ToString() + ")", ex.Message.ToString());

                    }
                }
            }

