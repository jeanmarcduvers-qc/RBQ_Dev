            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute la requête "req_S_Intrvt" de l'ancien système 
            ///
            /////////////////////////////////////////////////////////////////////
            void req_S_Intrvt()
            {

                string strSqlRequete;
                string sqlCmdSelect = "SELECT distinct dbo_GI3_INTERVENTION.GI3_N_INTRVT, isnull([S_INTRVT_DNC],[dbo_GI3_INTERVENTION].[GI3_S_INTRVT]) AS Le_S_INTRVT_Inter, DNC_Intervention.Intervention_DNC, Isnull(DNC.GI3_S_INTRVT, [dbo_GI3_INTERVENTION].[GI3_S_INTRVT]) as DNC_S_INTRVT, dnc.GI3_C_JUST_NON_CONF Conclusion " +
                                      "FROM   ([SDGIC01].[dbo].[GI3_INTERVENTION] as dbo_GI3_INTERVENTION " +
                                            "LEFT JOIN [SDDMU01].[dbo].[SAIS_DNC_Intervention] AS DNC_Intervention ON dbo_GI3_INTERVENTION.GI3_N_INTRVT = DNC_Intervention.GI3_N_INTRVT) " +
                                            "LEFT JOIN  [SDGIC01].[dbo].[GI3_INTERVENTION] as DNC on dnc.GI3_N_INTRVT = DNC_Intervention.Intervention_DNC " +
                                            "LEFT JOIN [SDDMU01].[dbo].[SAIS_S_INTRVT_Interv_DNC] AS S_INTRVT_Interv_DNC ON DNC_Intervention.Intervention_DNC = S_INTRVT_Interv_DNC.GI3_N_INTRVT " +
                                      "WHERE (((dbo_GI3_INTERVENTION.GI3_S_INTRVT) <> 'Terminée' " +
                                      "And     (dbo_GI3_INTERVENTION.GI3_S_INTRVT) <> 'Termine' " +
                                      "And     (dbo_GI3_INTERVENTION.GI3_S_INTRVT) <> 'Annulé' " +
                                      "And     (dbo_GI3_INTERVENTION.GI3_S_INTRVT) <> 'Terminé') " +
                                      "And    ((dbo_GI3_INTERVENTION.GI3_C_ASSIGNE_A) = 'SADMIN') " +
                                      "And    ((Right(dbo_GI3_INTERVENTION.GI3_N_INTRVT, 2)) <> '-*')) " +
                                      "Or    (((dbo_GI3_INTERVENTION.GI3_S_INTRVT)Is Null) " +
                                      "And    ((dbo_GI3_INTERVENTION.GI3_C_ASSIGNE_A) = 'SADMIN') " +
                                      "And    ((Right(dbo_GI3_INTERVENTION.GI3_N_INTRVT, 2)) <> '-*')) " +
                                      "Or    (((dbo_GI3_INTERVENTION.GI3_C_ASSIGNE_A) = 'SADMIN') " +
                                      "And    ((Right(dbo_GI3_INTERVENTION.GI3_N_INTRVT, 2)) = '-*') " +
                                      "And    ((S_INTRVT_Interv_DNC.S_INTRVT_DNC) = 'En cours' Or(S_INTRVT_Interv_DNC.S_INTRVT_DNC) Is Null))";

                string Etape = "Select";

                InsertTableLogPlanificateur("SaisLot", "req_S_Intrvt");

                majSAIS_DNC_Intervention();
                majSAIS_S_INTRVT_Interv_DNC();

                SqlConnection mySQLConnectionMaj = Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction) as SqlConnection;
                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                {
                    conn.Open();
                    using (OleDbTransaction transaction = conn.BeginTransaction())
                    {
                        try
                        {
                            SqlCommand commandDataReader = new SqlCommand(sqlCmdSelect, mySQLConnectionMaj);
                            SqlDataReader ValueReader = commandDataReader.ExecuteReader();
                            OleDbCommand SQLCommandExec = new OleDbCommand("INSERT", conn, transaction);

                            Etape = "Insert";

                            while (ValueReader.Read())
                            {
                                strSqlRequete = "insert into Interv_S_INTRVT ( GI3_N_INTRVT, Le_S_INTRVT, Intervention_DNC, DNC_S_INTRVT, Conclusion ) values('" + ValueReader["GI3_N_INTRVT"].ToString().TrimEnd() + "', '" + ValueReader["Le_S_INTRVT_Inter"].ToString().TrimEnd() + "', '" + ValueReader["Intervention_DNC"].ToString().TrimEnd() + "', '" + ValueReader["DNC_S_INTRVT"].ToString().TrimEnd() + "', '" + ValueReader["Conclusion"].ToString().Replace("'", "''").TrimEnd() + "')";
                                SQLCommandExec.CommandType = CommandType.Text;
                                SQLCommandExec.CommandText = strSqlRequete.ToString();
                                SQLCommandExec.CommandTimeout = 12000;
                                SQLCommandExec.ExecuteNonQuery();
                            }

                            transaction.Commit();
                            ValueReader.Close();
                        }
                        catch (Exception ex)
                        {
                            //MessageBox.Show(ex.Message);
                            InsertTableLogJobPlanificateur("req_S_Intrvt(" + Etape + ")", ex.Message.ToString());
                            LoadTableErreur = true;
                        }
                    }
                    conn.Close();
                }

                mySQLConnectionMaj.Close();
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute la requête "req_DNC" de l'ancien système 
            ///
            /////////////////////////////////////////////////////////////////////
            void req_DNC()
            {
                string strIntrvt = "";
                int intCount = 0;
                string strSqlDelete = "DELETE * FROM DNC_Delai";
                string strSqlRequete = "insert into DNC_Delai ( GI3_C_ROWD_INTRVT, MaxDeGI3_D_CRET, GI3_V_DELA ) values(?, ?, ?)";
                string sqlCmdSelect = "SELECT dbo_GI3_DOSSIER_NON_CONFORMITES.GI3_C_ROWD_INTRVT, " +
                                             "Max(convert(datetime, dbo_GI3_DOSSIER_NON_CONFORMITES.GI3_D_CRET, 120)) AS MaxDeGI3_D_CRET, " +
                                             "dbo_GI3_DOSSIER_NON_CONFORMITES.GI3_V_DELA " +
                                      "FROM  [SDGIC01].[dbo].[GI3_DOSSIER_NON_CONFORMITES] as dbo_GI3_DOSSIER_NON_CONFORMITES " +
                                             "INNER JOIN( " +
                                                         "SELECT dbo_GI3_DOSSIER_NON_CONFORMITES.GI3_C_ROWD_INTRVT, " +
                                                                "Max(dbo_GI3_DOSSIER_NON_CONFORMITES.GI3_V_DELA) AS MaxDeGI3_V_DELA " +
                                                         "FROM   [SDGIC01].[dbo].[GI3_DOSSIER_NON_CONFORMITES] as dbo_GI3_DOSSIER_NON_CONFORMITES " +
                                                         "GROUP BY dbo_GI3_DOSSIER_NON_CONFORMITES.GI3_C_ROWD_INTRVT " +
                                                         ") req_DNC_Delai ON (dbo_GI3_DOSSIER_NON_CONFORMITES.GI3_V_DELA = req_DNC_Delai.MaxDeGI3_V_DELA) AND (dbo_GI3_DOSSIER_NON_CONFORMITES.GI3_C_ROWD_INTRVT = req_DNC_Delai.GI3_C_ROWD_INTRVT) " +
                                      "GROUP BY dbo_GI3_DOSSIER_NON_CONFORMITES.GI3_C_ROWD_INTRVT, dbo_GI3_DOSSIER_NON_CONFORMITES.GI3_V_DELA";

                string Etape = "Select";

                InsertTableLogPlanificateur("SaisLot", "req_DNC");
                ExecuteSQL("req_DNC", strSqlDelete.ToString());

