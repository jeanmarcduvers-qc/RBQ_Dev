            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute la requête "Qry_Interv_N_ATT_DICC_Critère_Creer" de l'ancien système 
            ///
            /////////////////////////////////////////////////////////////////////
            void Qry_Interv_N_ATT_DICC_Critère_Creer()
            {

                string strSqlRequete;
                string sqlCmdSelect = "SELECT INTERVENTION_N_ATT.N_INTRVT, INTERVENTION_N_ATT.N_SITE, INTERVENTION_N_ATT.N_DEMN, " +
                                                "INTERVENTION_N_ATT.C_INTRVN, INTERVENTION_N_ATT.C_INTRVT, INTERVENTION_N_ATT.D_CRET, " +
                                                "INTERVENTION_N_ATT.D_OUVE_INTRVT, INTERVENTION_N_ATT.C_CODE_INTRVT, INTERVENTION_N_ATT.C_TYPE_INTRVT, " +
                                                "INTERVENTION_N_ATT.C_DE_TYPE_INTRVT, INTERVENTION_N_ATT.N_REGR, INTERVENTION_N_ATT.C_DE_REGR, " +
                                                "INTERVENTION_N_ATT.S_INTRVT, INTERVENTION_N_ATT.C_RISQ, INTERVENTION_N_ATT.DE_DOMN_INTRVT, " +
                                                "INTERVENTION_N_ATT.CATEGORIE, INTERVENTION_N_ATT.D_CRET_DEMN, INTERVENTION_N_ATT.D_RECEPTION_DEMN, " +
                                                "INTERVENTION_N_ATT.D_CRET_NOTE, INTERVENTION_N_ATT.C_SUJT_NOTE_INTR, INTERVENTION_N_ATT.C_SOUS_SUJT_NOTE, " +
                                                "INTERVENTION_N_ATT.DE_NOTE, INTERVENTION_N_ATT.C_ADRE_SITE, INTERVENTION_N_ATT.C_CODPOST_SITE, " +
                                                "INTERVENTION_N_ATT.C_COD_QUALF_SITE, INTERVENTION_N_ATT.C_DESC_COD_QUALF_SITE, " +
                                                "INTERVENTION_N_ATT.C_VILLE_SITE, INTERVENTION_N_ATT.REGION, INTERVENTION_N_ATT.SOUS_REGION, " +
                                                "INTERVENTION_N_ATT.[Q_ ETAG_BATM], INTERVENTION_N_ATT.V_AIRE_BATM, INTERVENTION_N_ATT.V_CAPC_MAXM_BATM, " +
                                                "INTERVENTION_N_ATT.NM_INTRVN, INTERVENTION_N_ATT.C_ETAP_ACTL, INTERVENTION_N_ATT.CRITICITE_INTRVT, " +
                                                "INTERVENTION_N_ATT.CRITICITE_SITE, INTERVENTION_N_ATT.CRITICITE_INTRVN, INTERVENTION_N_ATT.D_CRET_NON_CONFORMITE, " +
                                                "iif(isnull(INTERVENTION_N_ATT.V_DELA), 0, INTERVENTION_N_ATT.V_DELA) as V_DELA, INTERVENTION_N_ATT.D_ATTRIBUTION_INTRVT, INTERVENTION_N_ATT.CRITICITE_CODE_QUALIF_SITE, " +
                                                "INTERVENTION_N_ATT.SELECT_DOSSIER, INTERVENTION_N_ATT.NM_ENDR, INTERVENTION_N_ATT.N_INTRL, " +
                                                "INTERVENTION_N_ATT.D_CONFIRMATION_ATTRIB, 'DICC' AS DIRECTION, INTERVENTION_N_ATT.USER_ATTRIB, " +
                                                "iIf(Not IsNull([D_CRET_NON_CONFORMITE]), DateAdd('d',[V_DELA],[D_CRET_NON_CONFORMITE])) AS Date_Ech_Non_Conf " +
                                        "FROM INTERVENTION_N_ATT " +
                                        "WHERE (((S_INTRVT = 'Non débutée' and C_CODE_INTRVT = 'Construction') " +
                                        "or      (S_INTRVT = 'En cours' and iif(Isnull([C_ETAP_ACTL]), 'NULL', [C_ETAP_ACTL]) in ('Visite', 'CV à effectuer', 'NULL'))) " +
                                        "and   (((INTERVENTION_N_ATT.DE_DOMN_INTRVT) <> 'AP - Appareil sous-pression') " +
                                        "AND   ((([C_CODE_INTRVT]) = 'Sécurité' " +
                                        "Or      ([C_CODE_INTRVT]) = 'Loi' " +
                                        "Or      ([C_CODE_INTRVT]) Is Null) = False ) " +
                                        "AND   ((([C_CODE_INTRVT]) = 'Règlement' " +
                                        "And     ([DE_DOMN_INTRVT]) <> 'AP - Appareil sous-pression') = False) " +
                                        "AND   ((([D_CRET]) <#4/1/2016# " +
                                        "And     ([DE_DOMN_INTRVT]) = 'AP - Appareil sous-pression') = False) " +
                                        "AND   ((([DE_DOMN_INTRVT]) = 'AP - Appareil sous-pression' " +
                                        "And    (([C_TYPE_INTRVT]) = '02' " +
                                        "Or      ([C_TYPE_INTRVT]) = '03' " +
                                        "Or      ([C_TYPE_INTRVT]) = '04' " +
                                        "Or      ([C_TYPE_INTRVT]) = '05' " +
                                        "Or      ([C_TYPE_INTRVT]) = '08' " +
                                        "Or      ([C_TYPE_INTRVT]) = '09' " +
                                        "Or      ([C_TYPE_INTRVT]) = '10' " +
                                        "Or      ([C_TYPE_INTRVT]) = '13')) = False) " +
                                        "AND  (((([C_TYPE_INTRVT]) = '11' " +
                                        "Or      ([C_TYPE_INTRVT]) = '12') " +
                                        "And     (Val(iif(Isnull([N_REGR]), 0, [N_REGR])) >= 170 " +
                                        "And      Val(iif(Isnull([N_REGR]),0, [N_REGR])) <= 173)) = False) " +
                                        "AND   ((([DE_DOMN_INTRVT]) = 'QT - Qualité de travaux') = False) " +
                                        "AND    ((iif(isnull(Left([DE_NOTE], 10)), True, IsDate(Mid([DE_NOTE],9,2) & '/' & Mid([DE_NOTE],6,2) & '/' & Left([DE_NOTE],4)))) = True)) " +
                                        "OR    (((INTERVENTION_N_ATT.DE_DOMN_INTRVT) <> 'AP - Appareil sous-pression') " +
                                        "AND    ((INTERVENTION_N_ATT.DE_NOTE) Is Null) " +
                                        "AND   ((([C_CODE_INTRVT]) = 'Sécurité' " +
                                        "Or      ([C_CODE_INTRVT]) = 'Loi' " +
                                        "Or      ([C_CODE_INTRVT]) Is Null) = False) " +
                                        "AND   ((([C_CODE_INTRVT]) = 'Règlement' " +
                                        "And     ([DE_DOMN_INTRVT]) <> 'AP - Appareil sous-pression') = False) " +
                                        "AND   ((([D_CRET]) <#4/1/2016# " +
                                        "And     ([DE_DOMN_INTRVT]) = 'AP - Appareil sous-pression') = False) " +
                                        "AND   ((([DE_DOMN_INTRVT]) = 'AP - Appareil sous-pression' " +
                                        "And    (([C_TYPE_INTRVT]) = '02' " +
                                        "Or      ([C_TYPE_INTRVT]) = '03' " +
                                        "Or      ([C_TYPE_INTRVT]) = '04' " +
                                        "Or      ([C_TYPE_INTRVT]) = '05' " +
                                        "Or      ([C_TYPE_INTRVT]) = '08' " +
                                        "Or      ([C_TYPE_INTRVT]) = '09' " +
                                        "Or      ([C_TYPE_INTRVT]) = '10' " +
                                        "Or      ([C_TYPE_INTRVT]) = '13')) = False) " +
                                        "AND  (((([C_TYPE_INTRVT]) = '11' " +
                                        "Or      ([C_TYPE_INTRVT]) = '12') " +
                                        "And     (Val(iif(Isnull([N_REGR]), 0, [N_REGR])) >= 170 " +
                                        "And      Val(iif(Isnull([N_REGR]),0, [N_REGR])) <= 173)) = False) " +
                                        "AND   ((([DE_DOMN_INTRVT]) = 'QT - Qualité de travaux') = False) " +
                                        "AND    ((INTERVENTION_N_ATT.C_ETAP_ACTL) <> 'Itération terminée' Or (INTERVENTION_N_ATT.C_ETAP_ACTL) Is Null) " +
                                        "and     not exists (select 1 from Interv_S_INTRVT as t where t.GI3_N_INTRVT = INTERVENTION_N_ATT.N_INTRVT and t.DNC_S_INTRVT = 'Annulé')))";

                string sqlCmdInsert = "INSERT INTO INTERVENTION_N_ATT_DICC_Critères ( N_INTRVT, N_SITE, N_DEMN, C_INTRVN, C_INTRVT, D_CRET, " +
                                                                                        "D_OUVE_INTRVT, C_CODE_INTRVT, C_TYPE_INTRVT, C_DE_TYPE_INTRVT, " +
                                                                                        "N_REGR, C_DE_REGR, S_INTRVT, C_RISQ, DE_DOMN_INTRVT, CATEGORIE, " +
                                                                                        "D_CRET_DEMN, D_RECEPTION_DEMN, D_CRET_NOTE, C_SUJT_NOTE_INTR, C_SOUS_SUJT_NOTE, " +
                                                                                        "DE_NOTE, C_ADRE_SITE, C_CODPOST_SITE, C_COD_QUALF_SITE, " +
                                                                                        "C_DESC_COD_QUALF_SITE, C_VILLE_SITE, REGION, SOUS_REGION, " +
                                                                                        "[Q_ ETAG_BATM], V_AIRE_BATM, V_CAPC_MAXM_BATM, NM_INTRVN, " +
                                                                                        "C_ETAP_ACTL, CRITICITE_INTRVT, CRITICITE_SITE, CRITICITE_INTRVN, " +
                                                                                        "D_CRET_NON_CONFORMITE, V_DELA, D_ATTRIBUTION_INTRVT, CRITICITE_CODE_QUALIF_SITE, " +
                                                                                        "SELECT_DOSSIER, NM_ENDR, N_INTRL, D_CONFIRMATION_ATTRIB, DIRECTION, " +
                                                                                        "USER_ATTRIB, Aj_30, Aj_365, Date_Ech_Non_Conf) " +
                                                                                "values (?, ?, ?, ?, ?, ?, " +
                                                                                        "?, ?, ?, ?, " +
                                                                                        "?, ?, ?, ?, ?, ?, " +
                                                                                        "?, ?, ?, ?, ?, " +
                                                                                        "?, ?, ?, ?, " +
                                                                                        "?, ?, ?, ?, " +
                                                                                        "?, ?, ?, ?, " +
                                                                                        "?, ?, ?, ?, " +
                                                                                        "?, ?, ?, ?, " +
                                                                                        "?, ?, ?, ?, ?, " +
                                                                                        "?, ?, ?, ?) ";

                InsertTableLogPlanificateur("SaisLot", "Qry_Interv_N_ATT_DICC_Critère_Creer");

                try
                {
                    using (var conn = new OleDbConnection(strConnectBdAccess))
                    {
                        conn.Open();

                        // Transaction unique
                        using (var transaction = conn.BeginTransaction())
                        {
                            // Commande SELECT
                            using (var selectCmd = new OleDbCommand(sqlCmdSelect, conn, transaction))
                            using (var reader = selectCmd.ExecuteReader())
                            {
                                // Commande INSERT préparée
                                using (var insertCmd = new OleDbCommand(sqlCmdInsert, conn, transaction))
                                {
                                    // Crée les paramètres UNE SEULE FOIS
                                    for (int i = 0; i < 53; i++)
                                        insertCmd.Parameters.Add(new OleDbParameter());

                                    while (reader.Read())
                                    {
                                        int intAj30, intAj365;

                                        if (reader["DE_NOTE"] == DBNull.Value || string.IsNullOrEmpty(reader["DE_NOTE"].ToString()))
                                        {
                                            intAj30 = -1;
                                            intAj365 = 1;
                                        }
                                        else
                                        {
                                            intAj30 = AjDate(reader["DE_NOTE"].ToString(), 30, reader["N_INTRVT"].ToString());
                                            intAj365 = AjDate(reader["DE_NOTE"].ToString(), -365, reader["N_INTRVT"].ToString());
                                        }

                                        // Réaffecte juste les valeurs
                                        insertCmd.Parameters[0].Value = reader["N_INTRVT"];
                                        insertCmd.Parameters[1].Value = reader["N_SITE"];
                                        insertCmd.Parameters[2].Value = reader["N_DEMN"];
                                        insertCmd.Parameters[3].Value = reader["C_INTRVN"];
                                        insertCmd.Parameters[4].Value = reader["C_INTRVT"];
                                        insertCmd.Parameters[5].Value = reader["D_CRET"];
                                        insertCmd.Parameters[6].Value = reader["D_OUVE_INTRVT"];
                                        insertCmd.Parameters[7].Value = reader["C_CODE_INTRVT"];
                                        insertCmd.Parameters[8].Value = reader["C_TYPE_INTRVT"];
                                        insertCmd.Parameters[9].Value = reader["C_DE_TYPE_INTRVT"];
                                        insertCmd.Parameters[10].Value = reader["N_REGR"];
                                        insertCmd.Parameters[11].Value = reader["C_DE_REGR"];
                                        insertCmd.Parameters[12].Value = reader["S_INTRVT"];
                                        insertCmd.Parameters[13].Value = reader["C_RISQ"];
                                        insertCmd.Parameters[14].Value = reader["DE_DOMN_INTRVT"];
                                        insertCmd.Parameters[15].Value = reader["CATEGORIE"];
                                        insertCmd.Parameters[16].Value = reader["D_CRET_DEMN"];
                                        insertCmd.Parameters[17].Value = reader["D_RECEPTION_DEMN"];
                                        insertCmd.Parameters[18].Value = reader["D_CRET_NOTE"];
                                        insertCmd.Parameters[19].Value = reader["C_SUJT_NOTE_INTR"];
                                        insertCmd.Parameters[20].Value = reader["C_SOUS_SUJT_NOTE"];
                                        insertCmd.Parameters[21].Value = reader["DE_NOTE"];
                                        insertCmd.Parameters[22].Value = reader["C_ADRE_SITE"];
                                        insertCmd.Parameters[23].Value = reader["C_CODPOST_SITE"];
                                        insertCmd.Parameters[24].Value = reader["C_COD_QUALF_SITE"];
                                        insertCmd.Parameters[25].Value = reader["C_DESC_COD_QUALF_SITE"];
                                        insertCmd.Parameters[26].Value = reader["C_VILLE_SITE"];
                                        insertCmd.Parameters[27].Value = reader["REGION"];
                                        insertCmd.Parameters[28].Value = reader["SOUS_REGION"];
                                        insertCmd.Parameters[29].Value = reader["Q_ ETAG_BATM"];
                                        insertCmd.Parameters[30].Value = reader["V_AIRE_BATM"];
                                        insertCmd.Parameters[31].Value = reader["V_CAPC_MAXM_BATM"];
                                        insertCmd.Parameters[32].Value = reader["NM_INTRVN"];
                                        insertCmd.Parameters[33].Value = reader["C_ETAP_ACTL"];
                                        insertCmd.Parameters[34].Value = reader["CRITICITE_INTRVT"];
                                        insertCmd.Parameters[35].Value = reader["CRITICITE_SITE"];
                                        insertCmd.Parameters[36].Value = reader["CRITICITE_INTRVN"];
                                        insertCmd.Parameters[37].Value = reader["D_CRET_NON_CONFORMITE"];
                                        insertCmd.Parameters[38].Value = reader["V_DELA"];
                                        insertCmd.Parameters[39].Value = reader["D_ATTRIBUTION_INTRVT"];
                                        insertCmd.Parameters[40].Value = reader["CRITICITE_CODE_QUALIF_SITE"];
                                        insertCmd.Parameters[41].Value = reader["SELECT_DOSSIER"];
                                        insertCmd.Parameters[42].Value = reader["NM_ENDR"];
                                        insertCmd.Parameters[43].Value = reader["N_INTRL"];
                                        insertCmd.Parameters[44].Value = reader["D_CONFIRMATION_ATTRIB"];
                                        insertCmd.Parameters[45].Value = reader["DIRECTION"];
                                        insertCmd.Parameters[46].Value = reader["USER_ATTRIB"];
                                        insertCmd.Parameters[47].Value = intAj30;
                                        insertCmd.Parameters[48].Value = intAj365;
                                        insertCmd.Parameters[49].Value = reader["Date_Ech_Non_Conf"];

                                        insertCmd.ExecuteNonQuery();
                                    }
                                }
                            }

                            transaction.Commit();
                        }
                    }
                }
                catch (Exception ex)
                {
                    InsertTableLogJobPlanificateur("Qry_Interv_N_ATT_DICC_Critère_Creer(Insert)", ex.Message);
                    LoadTableErreur = true;
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Calcul_Criticite_DICC
            ///
            /////////////////////////////////////////////////////////////////////
            void Calcul_Criticite_DICC()
            {
                string sqlCmd;
                string Etape = "";
                DateTime? Ref_Min_P1_DICC = null;
                DateTime? Ref_Max_P1_DICC = null;
                DateTime? Ref_Min_P3_DICC = null;
                DateTime? Ref_Max_P3_DICC = null;
                DateTime? Ref_Min_P4_DICC = null;
                DateTime? Ref_Max_P4_DICC = null;
                DateTime? Date_ref = null;
                DateTime? Ref_Min_DICC = null;
                DateTime? Ref_Max_DICC = null;
                double Calcul_Crit_intervention, Crit_Interv, Crit_Site = 0;
                int Val_Crit_Categ = 0;
                long Delai_Ref_Min = 0, Delai_Ref_Max = 0;
                double Val_Mediane = 0;
                DateTime dtDepart = DateTime.Parse("2017-10-20");

                string trace = "";

                InsertTableLogPlanificateur("SaisLot", "Calcul_Criticite_DICC");
                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                {
                    conn.Open();
                    try
                    {
                        Etape = "req_P1_DICC_Min_Max";
                        sqlCmd = RequetesSQL.req_P1_DICC_Min_Max;
                        OleDbCommand commandDataReader = new OleDbCommand(sqlCmd, conn);
                        OleDbDataReader ValueReader = commandDataReader.ExecuteReader();

                        while (ValueReader.Read())
                        {
                            Ref_Min_P1_DICC = (DateTime)ValueReader["Min_P1"];
                            Ref_Max_P1_DICC = (DateTime)ValueReader["Max_P1"];
                        }

                        ValueReader.Close();

                        Etape = "req_P3_DICC_Min_Max";
                        sqlCmd = RequetesSQL.req_P3_DICC_Min_Max;
                        commandDataReader = new OleDbCommand(sqlCmd, conn);
                        ValueReader = commandDataReader.ExecuteReader();

                        while (ValueReader.Read())
                        {
                            Ref_Min_P3_DICC = (DateTime)ValueReader["Min_P3"];
                            Ref_Max_P3_DICC = (DateTime)ValueReader["Max_P3"];
                        }

                        ValueReader.Close();

                        Etape = "req_P4_DICC_Min_Max";
                        sqlCmd = RequetesSQL.req_P4_DICC_Min_Max;
                        commandDataReader = new OleDbCommand(sqlCmd, conn);
                        ValueReader = commandDataReader.ExecuteReader();

                        while (ValueReader.Read())
                        {
                            Ref_Min_P4_DICC = (DateTime)ValueReader["Min_P4"];
                            Ref_Max_P4_DICC = (DateTime)ValueReader["Max_P4"];
                        }

                        ValueReader.Close();

                        Etape = "updtDate_Ref_Min_Max_DICC";
                        sqlCmd = "UPDATE Date_Ref_Min_Max_DICC " +
                                "set P1_Date_Min = '" + Ref_Min_P1_DICC.ToString() + "', " +
                                    "P1_Date_Max = '" + Ref_Max_P1_DICC.ToString() + "', " +
                                    "P3_Date_Min = '" + Ref_Min_P3_DICC.ToString() + "', " +
                                    "P3_Date_Max = '" + Ref_Max_P3_DICC.ToString() + "', " +
                                    "P4_Date_Min = '" + Ref_Min_P4_DICC.ToString() + "', " +
                                    "P4_Date_Max = '" + Ref_Max_P4_DICC.ToString() + "'";
                        sqlCmd = sqlCmd.Replace("''", "null").Replace("''", "null");


                        OleDbCommand SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                        SQLCommandExec.CommandType = CommandType.Text;
                        SQLCommandExec.CommandTimeout = 12000;
                        SQLCommandExec.ExecuteNonQuery();
                        //OleDbDataReader readerExecSQL = SQLCommandExec.ExecuteReader();
                        //readerExecSQL.Read();
                        //readerExecSQL.Close();

                        Etape = "req_Delai_Ref_Min_Max_DICC";
                        sqlCmd = RequetesSQL.req_Delai_Ref_Min_Max_DICC;
                        commandDataReader = new OleDbCommand(sqlCmd, conn);
                        ValueReader = commandDataReader.ExecuteReader();

                        while (ValueReader.Read())
                        {
                            Delai_Ref_Min = long.Parse(ValueReader["Min_Delai_Ref"].ToString());
                            Delai_Ref_Max = long.Parse(ValueReader["Max_Delai_Ref"].ToString());
                        }

                        ValueReader.Close();

                        //
                        // Criticité de l'intervenant, Criticité du code de qualification du site et criticité de l'intervention de la DICC.
                        //
                        Etape = "req_INTERVENTION_N_ATT_DICC";
                        sqlCmd = RequetesSQL.req_INTERVENTION_N_ATT_DICC;
                        OleDbCommand commandDataReader_INTERVENTION_N_ATT_DICC = new OleDbCommand(sqlCmd, conn);
                        OleDbDataReader ValueReader_INTERVENTION_N_ATT_DICC = commandDataReader_INTERVENTION_N_ATT_DICC.ExecuteReader();

                        while (ValueReader_INTERVENTION_N_ATT_DICC.Read())
                        {
                            trace = ValueReader_INTERVENTION_N_ATT_DICC["N_INTRVT"].ToString();

                            Crit_Interv = double.Parse(ValueReader_INTERVENTION_N_ATT_DICC["Resultat_Interv"].ToString());
                            Crit_Site = double.Parse(ValueReader_INTERVENTION_N_ATT_DICC["Resultat_Site"].ToString());

                            Etape = "updtINTERVENTION_N_ATT_DICC";
                            sqlCmd = "UPDATE INTERVENTION_N_ATT_DICC " +
                                     "set CRITICITE_INTRVN = Round(" + Crit_Interv.ToString().Replace(",", ".") + ", 15), " +
                                        " CRITICITE_CODE_QUALIF_SITE = Round(" + Crit_Site.ToString().Replace(",", ".") + ", 15) " +
                                     "where N_INTRVT = '" + ValueReader_INTERVENTION_N_ATT_DICC["N_INTRVT"].ToString() + "' " +
                                     "and   C_INTRVN = '" + ValueReader_INTERVENTION_N_ATT_DICC["C_INTRVN"].ToString() + "' ";
                            sqlCmd = sqlCmd.Replace("''", "null").Replace("''", "null");


                            SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                            SQLCommandExec.CommandType = CommandType.Text;
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.ExecuteNonQuery();
                            //readerExecSQL = SQLCommandExec.ExecuteReader();
                            //readerExecSQL.Read();
                            //readerExecSQL.Close();

                            //Criticité de l'intervention.
                            Calcul_Crit_intervention = 0;
                            Val_Crit_Categ = 0;

                            if ((ValueReader_INTERVENTION_N_ATT_DICC["CATEGORIE"].ToString() == "P1") ||
                                (ValueReader_INTERVENTION_N_ATT_DICC["CATEGORIE"].ToString() == "P3") ||
                                (ValueReader_INTERVENTION_N_ATT_DICC["CATEGORIE"].ToString() == "P4"))
                            {
                                if (string.IsNullOrEmpty(ValueReader_INTERVENTION_N_ATT_DICC["D_RECEPTION_DEMN"].ToString()))
                                {
                                    Date_ref = (DateTime?)ValueReader_INTERVENTION_N_ATT_DICC["D_CRET"];
                                }
                                else
                                {
                                    Date_ref = (DateTime?)ValueReader_INTERVENTION_N_ATT_DICC["D_RECEPTION_DEMN"];
                                }

                                if (ValueReader_INTERVENTION_N_ATT_DICC["CATEGORIE"].ToString() == "P1") // Criticité de la catégorie.
                                {
                                    Val_Crit_Categ = 4;
                                    Ref_Min_DICC = Ref_Min_P1_DICC;
                                    Ref_Max_DICC = Ref_Max_P1_DICC;
                                }
                                else if (ValueReader_INTERVENTION_N_ATT_DICC["CATEGORIE"].ToString() == "P3")
                                {
                                    Val_Crit_Categ = 2;
                                    Ref_Min_DICC = Ref_Min_P3_DICC;
                                    Ref_Max_DICC = Ref_Max_P3_DICC;
                                }
                                else if (ValueReader_INTERVENTION_N_ATT_DICC["CATEGORIE"].ToString() == "P4")
                                {
                                    Val_Crit_Categ = 1;
                                    Ref_Min_DICC = Ref_Min_P4_DICC;
                                    Ref_Max_DICC = Ref_Max_P4_DICC;
                                }

                                if (string.IsNullOrEmpty(ValueReader_INTERVENTION_N_ATT_DICC["D_CRET_NON_CONFORMITE"].ToString()) && Ref_Min_DICC != Ref_Max_DICC)
                                {
                                    Calcul_Crit_intervention = Val_Crit_Categ + 1 - ((Ref_Min_DICC - Date_ref).Value.TotalDays / (Ref_Min_DICC - Ref_Max_DICC).Value.TotalDays);
                                }
                                else
                                {
                                    Calcul_Crit_intervention = Val_Crit_Categ + 1;
                                }
                            }
                            else if (ValueReader_INTERVENTION_N_ATT_DICC["CATEGORIE"].ToString() == "P2")
                            {
                                if (Delai_Ref_Max == 0)
                                {
                                    Calcul_Crit_intervention = 3;
                                }
                                else
                                {
                                    if ((Delai_Ref_Max - Delai_Ref_Min) == 0)
                                    {
                                        Calcul_Crit_intervention = 3;
                                    }
                                    else
                                    {
                                        if (!((DateTime?)ValueReader_INTERVENTION_N_ATT_DICC["D_CRET_NON_CONFORMITE"]).HasValue)
                                        {
                                            Calcul_Crit_intervention = 3 + ((0 - Delai_Ref_Min) / (Delai_Ref_Max - Delai_Ref_Min));
                                            if (Calcul_Crit_intervention < 0)
                                            {
                                                Calcul_Crit_intervention = 3;
                                            }
                                        }
                                        else
                                        {
                                            Calcul_Crit_intervention = 3 + (((((DateTime?)ValueReader_INTERVENTION_N_ATT_DICC["D_CRET_NON_CONFORMITE"]).Value.AddDays(int.Parse(ValueReader_INTERVENTION_N_ATT_DICC["V_DELA"].ToString())) - dtDepart).TotalDays - Delai_Ref_Min) / (Delai_Ref_Max - Delai_Ref_Min));
                                            if (Calcul_Crit_intervention < 0)
                                            {
                                                Calcul_Crit_intervention = 3;
                                            }
                                        }
                                    }
                                }
                            }
                            else if (ValueReader_INTERVENTION_N_ATT_DICC["CATEGORIE"].ToString() == "P5")
                            {
                                Calcul_Crit_intervention = (0.4 * Crit_Interv) + (0.6 * Crit_Site);
                            }

                            Etape = "updtCRITICITE_INTRVT";
                            sqlCmd = "UPDATE INTERVENTION_N_ATT_DICC " +
                                     "set CRITICITE_INTRVT = " + Calcul_Crit_intervention.ToString() + " " +
                                     "where N_INTRVT = '" + ValueReader_INTERVENTION_N_ATT_DICC["N_INTRVT"].ToString() + "' " +
                                     "and   C_INTRVN = '" + ValueReader_INTERVENTION_N_ATT_DICC["C_INTRVN"].ToString() + "' ";
                            sqlCmd = sqlCmd.Replace("''", "null").Replace("''", "null").Replace(",", ".");


                            SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                            SQLCommandExec.CommandType = CommandType.Text;
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.ExecuteNonQuery();
                        }

                        ValueReader_INTERVENTION_N_ATT_DICC.Close();

                        Etape = "Val_Mediane";

                        // Calcul de la médiane de l'intervenant
                        Val_Mediane = LaMediane("INTERVENTION_N_ATT_DICC", "CRITICITE_INTRVN");
                        // Remplacer le zero par la médiane
                        sqlCmd = "UPDATE INTERVENTION_N_ATT_DICC SET INTERVENTION_N_ATT_DICC.CRITICITE_INTRVN = " + Val_Mediane.ToString().Replace(",", ".") + " WHERE ((INTERVENTION_N_ATT_DICC.CRITICITE_INTRVN) = 0)";
                        SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                        SQLCommandExec.CommandType = CommandType.Text;
                        SQLCommandExec.CommandTimeout = 12000;
                        SQLCommandExec.ExecuteNonQuery();

                        // Calcul de la médiane du code de qualification du site
                        Val_Mediane = LaMediane("INTERVENTION_N_ATT_DICC", "CRITICITE_CODE_QUALIF_SITE");
                        // Remplacer le zero par la médiane
                        sqlCmd = "UPDATE INTERVENTION_N_ATT_DICC SET INTERVENTION_N_ATT_DICC.CRITICITE_CODE_QUALIF_SITE = " + Val_Mediane.ToString().Replace(",", ".") + " WHERE ((INTERVENTION_N_ATT_DICC.CRITICITE_CODE_QUALIF_SITE) = 0)";
                        SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                        SQLCommandExec.CommandType = CommandType.Text;
                        SQLCommandExec.CommandTimeout = 12000;
                        SQLCommandExec.ExecuteNonQuery();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("Calcul_Criticite_DICC(" + Etape + ")", ex.Message.ToString());
                        //InsertTableLogJobPlanificateur("Calcul_Criticite_DICC(" + trace + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                    }
                    conn.Close();
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Calcul_Criticite_DESP
            ///
            /////////////////////////////////////////////////////////////////////
            void Calcul_Criticite_DESP()
            {
                string sqlCmd;
                string Etape = "";
                DateTime? Ref_Min_P1_DESP = null;
                DateTime? Ref_Max_P1_DESP = null;
                DateTime? Ref_Min_P3_DESP = null;
                DateTime? Ref_Max_P3_DESP = null;
                DateTime? Ref_Min_P4_DESP = null;
                DateTime? Ref_Max_P4_DESP = null;
                DateTime? Date_ref = null;
                DateTime? Ref_Min_DESP = null;
                DateTime? Ref_Max_DESP = null;
                double Calcul_Crit_intervention, Crit_Interv, Crit_Site = 0;
                int Val_Crit_Categ = 0;
                long Delai_Ref_Min = 0, Delai_Ref_Max = 0;
                double Val_Mediane = 0;
                DateTime dtDepart = DateTime.Parse("2017-10-20");

                InsertTableLogPlanificateur("SaisLot", "Calcul_Criticite_DESP");

                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                {
                    conn.Open();
                    try
                    {
                        Etape = "Qry_P1_DESP_Min_Max";
                        sqlCmd = RequetesSQL.Qry_P1_DESP_Min_Max;
                        OleDbCommand commandDataReader = new OleDbCommand(sqlCmd, conn);
                        OleDbDataReader ValueReader = commandDataReader.ExecuteReader();

                        while (ValueReader.Read())
                        {
                            Ref_Min_P1_DESP = (DateTime)ValueReader["Min_P1"];
                            Ref_Max_P1_DESP = (DateTime)ValueReader["Max_P1"];
                        }

                        ValueReader.Close();

                        Etape = "Qry_P3_DESP_Min_Max";
                        sqlCmd = RequetesSQL.Qry_P3_DESP_Min_Max;
                        commandDataReader = new OleDbCommand(sqlCmd, conn);
                        ValueReader = commandDataReader.ExecuteReader();

                        while (ValueReader.Read())
                        {
                            Ref_Min_P3_DESP = (DateTime)ValueReader["Min_P3"];
                            Ref_Max_P3_DESP = (DateTime)ValueReader["Max_P3"];
                        }

                        ValueReader.Close();

                        Etape = "Qry_P4_DESP_Min_Max";
                        sqlCmd = RequetesSQL.Qry_P4_DESP_Min_Max;
                        commandDataReader = new OleDbCommand(sqlCmd, conn);
                        ValueReader = commandDataReader.ExecuteReader();

                        while (ValueReader.Read())
                        {
                            Ref_Min_P4_DESP = (DateTime)ValueReader["Min_P4"];
                            Ref_Max_P4_DESP = (DateTime)ValueReader["Max_P4"];
                        }

                        ValueReader.Close();

                        Etape = "updtDate_Ref_Min_Max_DESP";
                        sqlCmd = "UPDATE Date_Ref_Min_Max_DESP " +
                                "set P1_Date_Min = '" + Ref_Min_P1_DESP.ToString() + "', " +
                                    "P1_Date_Max = '" + Ref_Max_P1_DESP.ToString() + "', " +
                                    "P3_Date_Min = '" + Ref_Min_P3_DESP.ToString() + "', " +
                                    "P3_Date_Max = '" + Ref_Max_P3_DESP.ToString() + "', " +
                                    "P4_Date_Min = '" + Ref_Min_P4_DESP.ToString() + "', " +
                                    "P4_Date_Max = '" + Ref_Max_P4_DESP.ToString() + "'";
                        sqlCmd = sqlCmd.Replace("''", "null").Replace("''", "null");


                        OleDbCommand SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                        SQLCommandExec.CommandType = CommandType.Text;
                        SQLCommandExec.CommandTimeout = 12000;
                        SQLCommandExec.ExecuteNonQuery();

                        Etape = "Qry_Delai_Ref_Min_Max_DESP";
                        sqlCmd = RequetesSQL.Qry_Delai_Ref_Min_Max_DESP;
                        commandDataReader = new OleDbCommand(sqlCmd, conn);
                        ValueReader = commandDataReader.ExecuteReader();

                        while (ValueReader.Read())
                        {
                            if (string.IsNullOrEmpty(ValueReader["Min_Delai_Ref"].ToString()))
                            {
                                Delai_Ref_Min = 0;
                            }
                            else
                            {
                                Delai_Ref_Min = long.Parse(ValueReader["Min_Delai_Ref"].ToString());
                            }

                            if (string.IsNullOrEmpty(ValueReader["Max_Delai_Ref"].ToString()))
                            {
                                Delai_Ref_Max = 0;
                            }
                            else
                            {
                                Delai_Ref_Max = long.Parse(ValueReader["Max_Delai_Ref"].ToString());
                            }
                        }

                        ValueReader.Close();

                        //
                        // Criticité de l'intervenant, Criticité du code de qualification du site et criticité de l'intervention de la DESP.
                        //
                        Etape = "req_INTERVENTION_N_ATT_DESP";
                        sqlCmd = RequetesSQL.req_INTERVENTION_N_ATT_DESP;
                        OleDbCommand commandDataReader_INTERVENTION_N_ATT_DESP = new OleDbCommand(sqlCmd, conn);
                        OleDbDataReader ValueReader_INTERVENTION_N_ATT_DESP = commandDataReader_INTERVENTION_N_ATT_DESP.ExecuteReader();

                        while (ValueReader_INTERVENTION_N_ATT_DESP.Read())
                        {
                            Etape = "Crit_Interv";
                            Crit_Interv = 0;
                            sqlCmd = "SELECT No_INTRVN, Resultat FROM Crit_Intervenant_DICC WHERE No_INTRVN = '" + ValueReader_INTERVENTION_N_ATT_DESP["C_INTRVN"].ToString() + "'";
                            commandDataReader = new OleDbCommand(sqlCmd, conn);
                            ValueReader = commandDataReader.ExecuteReader();

                            while (ValueReader.Read())
                            {
                                Crit_Interv = (double)ValueReader["Resultat"];
                            }
                            ValueReader.Close();

                            Etape = "Crit_Site";
                            Crit_Site = 0;
                            sqlCmd = "SELECT CQ, Resultat FROM Crit_Site_DICC WHERE CQ = '" + ValueReader_INTERVENTION_N_ATT_DESP["C_COD_QUALF_SITE"].ToString() + "'";
                            commandDataReader = new OleDbCommand(sqlCmd, conn);
                            ValueReader = commandDataReader.ExecuteReader();

                            while (ValueReader.Read())
                            {
                                Crit_Site = (double)ValueReader["Resultat"];
                            }
                            ValueReader.Close();

                            Etape = "updtINTERVENTION_N_ATT_DESP";
                            sqlCmd = "UPDATE INTERVENTION_N_ATT_DESP " +
                                     "set CRITICITE_INTRVN = Round(" + Crit_Interv.ToString().Replace(",", ".") + ", 15), " +
                                        " CRITICITE_CODE_QUALIF_SITE = Round(" + Crit_Site.ToString().Replace(",", ".") + ", 15) " +
                                     "where N_INTRVT = '" + ValueReader_INTERVENTION_N_ATT_DESP["N_INTRVT"].ToString() + "' " +
                                     "and   C_INTRVN = '" + ValueReader_INTERVENTION_N_ATT_DESP["C_INTRVN"].ToString() + "' ";
                            sqlCmd = sqlCmd.Replace("''", "null").Replace("''", "null");


                            SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                            SQLCommandExec.CommandType = CommandType.Text;
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.ExecuteNonQuery();

                            //Criticité de l'intervention.
                            Calcul_Crit_intervention = 0;
                            Val_Crit_Categ = 0;

                            if ((ValueReader_INTERVENTION_N_ATT_DESP["CATEGORIE"].ToString() == "P1") ||
                                (ValueReader_INTERVENTION_N_ATT_DESP["CATEGORIE"].ToString() == "P3") ||
                                (ValueReader_INTERVENTION_N_ATT_DESP["CATEGORIE"].ToString() == "P4"))
                            {
                                if (string.IsNullOrEmpty(ValueReader_INTERVENTION_N_ATT_DESP["D_RECEPTION_DEMN"].ToString()))
                                {
                                    Date_ref = (DateTime?)ValueReader_INTERVENTION_N_ATT_DESP["D_CRET"];
                                }
                                else
                                {
                                    Date_ref = (DateTime?)ValueReader_INTERVENTION_N_ATT_DESP["D_RECEPTION_DEMN"];
                                }

                                if (ValueReader_INTERVENTION_N_ATT_DESP["CATEGORIE"].ToString() == "P1") // Criticité de la catégorie.
                                {
                                    Val_Crit_Categ = 4;
                                    Ref_Min_DESP = Ref_Min_P1_DESP;
                                    Ref_Max_DESP = Ref_Max_P1_DESP;
                                }
                                else if (ValueReader_INTERVENTION_N_ATT_DESP["CATEGORIE"].ToString() == "P3")
                                {
                                    Val_Crit_Categ = 2;
                                    Ref_Min_DESP = Ref_Min_P3_DESP;
                                    Ref_Max_DESP = Ref_Max_P3_DESP;
                                }
                                else if (ValueReader_INTERVENTION_N_ATT_DESP["CATEGORIE"].ToString() == "P4")
                                {
                                    Val_Crit_Categ = 1;
                                    Ref_Min_DESP = Ref_Min_P4_DESP;
                                    Ref_Max_DESP = Ref_Max_P4_DESP;
                                }

                                if (string.IsNullOrEmpty(ValueReader_INTERVENTION_N_ATT_DESP["D_CRET_NON_CONFORMITE"].ToString()) && Ref_Min_DESP != Ref_Max_DESP)
                                {
                                    Calcul_Crit_intervention = Val_Crit_Categ + 1 - ((Ref_Min_DESP - Date_ref).Value.TotalDays / (Ref_Min_DESP - Ref_Max_DESP).Value.TotalDays);
                                }
                                else
                                {
                                    Calcul_Crit_intervention = Val_Crit_Categ + 1;
                                }
                            }
                            else if (ValueReader_INTERVENTION_N_ATT_DESP["CATEGORIE"].ToString() == "P2")
                            {
                                if (Delai_Ref_Max == 0)
                                {
                                    Calcul_Crit_intervention = 3;
                                }
                                else
                                {
                                    if ((Delai_Ref_Max - Delai_Ref_Min) == 0)
                                    {
                                        Calcul_Crit_intervention = 3;
                                    }
                                    else
                                    {
                                        if (!((DateTime?)ValueReader_INTERVENTION_N_ATT_DESP["D_CRET_NON_CONFORMITE"]).HasValue)
                                        {
                                            Calcul_Crit_intervention = 3 + ((0 - Delai_Ref_Min) / (Delai_Ref_Max - Delai_Ref_Min));
                                            if (Calcul_Crit_intervention < 0)
                                            {
                                                Calcul_Crit_intervention = 3;
                                            }
                                        }
                                        else
                                        {
                                            Calcul_Crit_intervention = 3 + (((((DateTime?)ValueReader_INTERVENTION_N_ATT_DESP["D_CRET_NON_CONFORMITE"]).Value.AddDays(int.Parse(ValueReader_INTERVENTION_N_ATT_DESP["V_DELA"].ToString())) - dtDepart).TotalDays - Delai_Ref_Min) / (Delai_Ref_Max - Delai_Ref_Min));
                                            if (Calcul_Crit_intervention < 0)
                                            {
                                                Calcul_Crit_intervention = 3;
                                            }
                                        }
                                    }
                                }
                            }
                            else if (ValueReader_INTERVENTION_N_ATT_DESP["CATEGORIE"].ToString() == "P5")
                            {
                                Calcul_Crit_intervention = (0.4 * Crit_Interv) + (0.6 * Crit_Site);
                            }

                            Etape = "updtCRITICITE_INTRVT";
                            sqlCmd = "UPDATE INTERVENTION_N_ATT_DESP " +
                                     "set CRITICITE_INTRVT = " + Calcul_Crit_intervention.ToString() + " " +
                                     "where N_INTRVT = '" + ValueReader_INTERVENTION_N_ATT_DESP["N_INTRVT"].ToString() + "' " +
                                     "and   C_INTRVN = '" + ValueReader_INTERVENTION_N_ATT_DESP["C_INTRVN"].ToString() + "' ";
                            sqlCmd = sqlCmd.Replace("''", "null").Replace("''", "null").Replace(",", ".");


                            SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                            SQLCommandExec.CommandType = CommandType.Text;
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.ExecuteNonQuery();
                        }

                        ValueReader_INTERVENTION_N_ATT_DESP.Close();

                        Etape = "Val_Mediane";

                        // Calcul de la médiane de l'intervenant
                        Val_Mediane = LaMediane("INTERVENTION_N_ATT_DESP", "CRITICITE_INTRVN");
                        // Remplacer le zero par la médiane
                        sqlCmd = "UPDATE INTERVENTION_N_ATT_DESP SET INTERVENTION_N_ATT_DESP.CRITICITE_INTRVN = " + Val_Mediane.ToString().Replace(",", ".") + " WHERE ((INTERVENTION_N_ATT_DESP.CRITICITE_INTRVN) = 0)";
                        SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                        SQLCommandExec.CommandType = CommandType.Text;
                        SQLCommandExec.CommandTimeout = 12000;
                        SQLCommandExec.ExecuteNonQuery();

                        // Calcul de la médiane du code de qualification du site
                        Val_Mediane = LaMediane("INTERVENTION_N_ATT_DESP", "CRITICITE_CODE_QUALIF_SITE");
                        // Remplacer le zero par la médiane
                        sqlCmd = "UPDATE INTERVENTION_N_ATT_DESP SET INTERVENTION_N_ATT_DESP.CRITICITE_CODE_QUALIF_SITE = " + Val_Mediane.ToString().Replace(",", ".") + " WHERE ((INTERVENTION_N_ATT_DESP.CRITICITE_CODE_QUALIF_SITE) = 0)";
                        SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                        SQLCommandExec.CommandType = CommandType.Text;
                        SQLCommandExec.CommandTimeout = 12000;
                        SQLCommandExec.ExecuteNonQuery();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("Calcul_Criticite_DESP(" + Etape + ")", ex.Message.ToString());
                        //InsertTableLogJobPlanificateur("Calcul_Criticite_DESP(" + trace + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                    }
                    conn.Close();
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Calcul_Criticite_DIS
            ///
            /////////////////////////////////////////////////////////////////////
            void Calcul_Criticite_DIS()
            {
                string sqlCmd;
                string Etape = "";
                DateTime? Ref_Min_P1_DIS = null;
                DateTime? Ref_Max_P1_DIS = null;
                DateTime? Ref_Min_P3_DIS = null;
                DateTime? Ref_Max_P3_DIS = null;
                DateTime? Ref_Min_P4_DIS = null;
                DateTime? Ref_Max_P4_DIS = null;
                DateTime? Date_ref = null;
                DateTime? Ref_Min_DIS = null;
                DateTime? Ref_Max_DIS = null;
                double Calcul_Crit_intervention, Crit_Code_Site, Crit_Interv, Crit_Site = 0;
                int Val_Crit_Categ = 0;
                long Delai_Ref_Min = 0, Delai_Ref_Max = 0;
                double Val_Mediane = 0;
                DateTime dtDepart = DateTime.Parse("2017-10-20");

                InsertTableLogPlanificateur("SaisLot", "Calcul_Criticite_DIS");

                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                {
                    conn.Open();
                    try
                    {
                        Etape = "req_P1_DIS_Min_Max";
                        sqlCmd = RequetesSQL.req_P1_DIS_Min_Max;
                        OleDbCommand commandDataReader = new OleDbCommand(sqlCmd, conn);
                        OleDbDataReader ValueReader = commandDataReader.ExecuteReader();

                        while (ValueReader.Read())
                        {
                            Ref_Min_P1_DIS = (DateTime)ValueReader["Min_P1"];
                            Ref_Max_P1_DIS = (DateTime)ValueReader["Max_P1"];
                        }

                        ValueReader.Close();

                        Etape = "req_P3_DIS_Min_Max";
                        sqlCmd = RequetesSQL.req_P3_DIS_Min_Max;
                        commandDataReader = new OleDbCommand(sqlCmd, conn);
                        ValueReader = commandDataReader.ExecuteReader();

                        while (ValueReader.Read())
                        {
                            Ref_Min_P3_DIS = (DateTime)ValueReader["Min_P3"];
                            Ref_Max_P3_DIS = (DateTime)ValueReader["Max_P3"];
                        }

                        ValueReader.Close();

                        Etape = "req_P4_DIS_Min_Max";
                        sqlCmd = RequetesSQL.req_P4_DIS_Min_Max;
                        commandDataReader = new OleDbCommand(sqlCmd, conn);
                        ValueReader = commandDataReader.ExecuteReader();

                        while (ValueReader.Read())
                        {
                            Ref_Min_P4_DIS = (DateTime)ValueReader["Min_P4"];
                            Ref_Max_P4_DIS = (DateTime)ValueReader["Max_P4"];
                        }

                        ValueReader.Close();

                        Etape = "updtDate_Ref_Min_Max_DIS";
                        sqlCmd = "UPDATE Date_Ref_Min_Max_DIS " +
                                "set P1_Date_Min = '" + Ref_Min_P1_DIS.ToString() + "', " +
                                    "P1_Date_Max = '" + Ref_Max_P1_DIS.ToString() + "', " +
                                    "P3_Date_Min = '" + Ref_Min_P3_DIS.ToString() + "', " +
                                    "P3_Date_Max = '" + Ref_Max_P3_DIS.ToString() + "', " +
                                    "P4_Date_Min = '" + Ref_Min_P4_DIS.ToString() + "', " +
                                    "P4_Date_Max = '" + Ref_Max_P4_DIS.ToString() + "'";
                        sqlCmd = sqlCmd.Replace("''", "null").Replace("''", "null");


                        OleDbCommand SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                        SQLCommandExec.CommandType = CommandType.Text;
                        SQLCommandExec.CommandTimeout = 12000;
                        SQLCommandExec.ExecuteNonQuery();

                        Etape = "req_Delai_Ref_Min_Max_DIS";
                        sqlCmd = RequetesSQL.req_Delai_Ref_Min_Max_DIS;
                        commandDataReader = new OleDbCommand(sqlCmd, conn);
                        ValueReader = commandDataReader.ExecuteReader();

                        while (ValueReader.Read())
                        {
                            if (string.IsNullOrEmpty(ValueReader["Min_Delai_Ref"].ToString()))
                            {
                                Delai_Ref_Min = 0;
                            }
                            else
                            {
                                Delai_Ref_Min = long.Parse(ValueReader["Min_Delai_Ref"].ToString());
                            }

                            if (string.IsNullOrEmpty(ValueReader["Max_Delai_Ref"].ToString()))
                            {
                                Delai_Ref_Max = 0;
                            }
                            else
                            {
                                Delai_Ref_Max = long.Parse(ValueReader["Max_Delai_Ref"].ToString());
                            }
                        }

                        ValueReader.Close();

                        //
                        // Criticité de l'intervenant, Criticité du code de qualification du site et criticité de l'intervention de la DIS.
                        //
                        Etape = "req_INTERVENTION_N_ATT_DIS";
                        sqlCmd = RequetesSQL.req_INTERVENTION_N_ATT_DIS;
                        OleDbCommand commandDataReader_INTERVENTION_N_ATT_DIS = new OleDbCommand(sqlCmd, conn);
                        OleDbDataReader ValueReader_INTERVENTION_N_ATT_DIS = commandDataReader_INTERVENTION_N_ATT_DIS.ExecuteReader();

                        while (ValueReader_INTERVENTION_N_ATT_DIS.Read())
                        {
                            Crit_Interv = 0;
                            if (ValueReader_INTERVENTION_N_ATT_DIS["CRITICITE_CODE_QUALIF_SITE"] != DBNull.Value)
                            {
                                Crit_Interv = (double)ValueReader_INTERVENTION_N_ATT_DIS["CRITICITE_CODE_QUALIF_SITE"];
                            }

                            Crit_Site = 0;
                            if (ValueReader_INTERVENTION_N_ATT_DIS["CRITICITE_CODE_QUALIF_SITE"] != DBNull.Value)
                            {
                                Crit_Site = (double)ValueReader_INTERVENTION_N_ATT_DIS["CRITICITE_CODE_QUALIF_SITE"];
                            }

                            Crit_Code_Site = 0;
                            if (ValueReader_INTERVENTION_N_ATT_DIS["CRITICITE_CODE_QUALIF_SITE"] != DBNull.Value)
                            {
                                Crit_Code_Site = (double)ValueReader_INTERVENTION_N_ATT_DIS["CRITICITE_CODE_QUALIF_SITE"];
                            }

                            //Criticité de l'intervention.
                            Calcul_Crit_intervention = 0;
                            Val_Crit_Categ = 0;

                            if ((ValueReader_INTERVENTION_N_ATT_DIS["CATEGORIE"].ToString() == "P1") ||
                                (ValueReader_INTERVENTION_N_ATT_DIS["CATEGORIE"].ToString() == "P3") ||
                                (ValueReader_INTERVENTION_N_ATT_DIS["CATEGORIE"].ToString() == "P4"))
                            {
                                if (string.IsNullOrEmpty(ValueReader_INTERVENTION_N_ATT_DIS["D_RECEPTION_DEMN"].ToString()))
                                {
                                    Date_ref = (DateTime?)ValueReader_INTERVENTION_N_ATT_DIS["D_CRET"];
                                }
                                else
                                {
                                    Date_ref = (DateTime?)ValueReader_INTERVENTION_N_ATT_DIS["D_RECEPTION_DEMN"];
                                }

                                if (ValueReader_INTERVENTION_N_ATT_DIS["CATEGORIE"].ToString() == "P1") // Criticité de la catégorie.
                                {
                                    Val_Crit_Categ = 4;
                                    Ref_Min_DIS = Ref_Min_P1_DIS;
                                    Ref_Max_DIS = Ref_Max_P1_DIS;
                                }
                                else if (ValueReader_INTERVENTION_N_ATT_DIS["CATEGORIE"].ToString() == "P3")
                                {
                                    Val_Crit_Categ = 2;
                                    Ref_Min_DIS = Ref_Min_P3_DIS;
                                    Ref_Max_DIS = Ref_Max_P3_DIS;
                                }
                                else if (ValueReader_INTERVENTION_N_ATT_DIS["CATEGORIE"].ToString() == "P4")
                                {
                                    Val_Crit_Categ = 1;
                                    Ref_Min_DIS = Ref_Min_P4_DIS;
                                    Ref_Max_DIS = Ref_Max_P4_DIS;
                                }

                                if (string.IsNullOrEmpty(ValueReader_INTERVENTION_N_ATT_DIS["D_CRET_NON_CONFORMITE"].ToString()) && Ref_Min_DIS != Ref_Max_DIS)
                                {
                                    Calcul_Crit_intervention = Val_Crit_Categ + 1 - ((Ref_Min_DIS - Date_ref).Value.TotalDays / (Ref_Min_DIS - Ref_Max_DIS).Value.TotalDays);
                                }
                                else
                                {
                                    Calcul_Crit_intervention = Val_Crit_Categ + 1;
                                }
                            }
                            else if (ValueReader_INTERVENTION_N_ATT_DIS["CATEGORIE"].ToString() == "P2")
                            {
                                if (Delai_Ref_Max == 0)
                                {
                                    Calcul_Crit_intervention = 3;
                                }
                                else
                                {
                                    if ((Delai_Ref_Max - Delai_Ref_Min) == 0)
                                    {
                                        Calcul_Crit_intervention = 3;
                                    }
                                    else
                                    {
                                        if (!((DateTime?)ValueReader_INTERVENTION_N_ATT_DIS["D_CRET_NON_CONFORMITE"]).HasValue)
                                        {
                                            Calcul_Crit_intervention = 3 + ((0 - Delai_Ref_Min) / (Delai_Ref_Max - Delai_Ref_Min));
                                            if (Calcul_Crit_intervention < 0)
                                            {
                                                Calcul_Crit_intervention = 3;
                                            }
                                        }
                                        else
                                        {
                                            Calcul_Crit_intervention = 3 + (((((DateTime?)ValueReader_INTERVENTION_N_ATT_DIS["D_CRET_NON_CONFORMITE"]).Value.AddDays(int.Parse(ValueReader_INTERVENTION_N_ATT_DIS["V_DELA"].ToString())) - dtDepart).TotalDays - Delai_Ref_Min) / (Delai_Ref_Max - Delai_Ref_Min));
                                            if (Calcul_Crit_intervention < 0)
                                            {
                                                Calcul_Crit_intervention = 3;
                                            }
                                        }
                                    }
                                }
                            }
                            else if (ValueReader_INTERVENTION_N_ATT_DIS["CATEGORIE"].ToString() == "P5")
                            {
                                Calcul_Crit_intervention = (0.4 * Crit_Interv) + (0.6 * Crit_Site);
                            }

                            Etape = "updtCRITICITE_INTRVT";
                            sqlCmd = "UPDATE INTERVENTION_N_ATT_DIS " +
                                     "set CRITICITE_INTRVT = " + Calcul_Crit_intervention.ToString() + " " +
                                     "where N_INTRVT = '" + ValueReader_INTERVENTION_N_ATT_DIS["N_INTRVT"].ToString() + "' " +
                                     "and   C_INTRVN = '" + ValueReader_INTERVENTION_N_ATT_DIS["C_INTRVN"].ToString() + "' ";
                            sqlCmd = sqlCmd.Replace("''", "null").Replace("''", "null").Replace(",", ".");


                            SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                            SQLCommandExec.CommandType = CommandType.Text;
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.ExecuteNonQuery();
                        }

                        ValueReader_INTERVENTION_N_ATT_DIS.Close();

                        Etape = "Val_Mediane";

                        // Calcul de la médiane de l'intervenant
                        Val_Mediane = LaMediane("INTERVENTION_N_ATT_DIS", "CRITICITE_INTRVN");
                        // Remplacer le zero par la médiane
                        sqlCmd = "UPDATE INTERVENTION_N_ATT_DIS SET INTERVENTION_N_ATT_DIS.CRITICITE_INTRVN = " + Val_Mediane.ToString().Replace(",", ".") + " WHERE ((INTERVENTION_N_ATT_DIS.CRITICITE_INTRVN) = 0)";
                        SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                        SQLCommandExec.CommandType = CommandType.Text;
                        SQLCommandExec.CommandTimeout = 12000;
                        SQLCommandExec.ExecuteNonQuery();

                        // Calcul de la médiane du code de qualification du site
                        Val_Mediane = LaMediane("INTERVENTION_N_ATT_DIS", "CRITICITE_CODE_QUALIF_SITE");
                        // Remplacer le zero par la médiane
                        sqlCmd = "UPDATE INTERVENTION_N_ATT_DIS SET INTERVENTION_N_ATT_DIS.CRITICITE_CODE_QUALIF_SITE = " + Val_Mediane.ToString().Replace(",", ".") + " WHERE ((INTERVENTION_N_ATT_DIS.CRITICITE_CODE_QUALIF_SITE) = 0)";
                        SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                        SQLCommandExec.CommandType = CommandType.Text;
                        SQLCommandExec.CommandTimeout = 12000;
                        SQLCommandExec.ExecuteNonQuery();

                        // Calcul de la médiane du code de qualification du site
                        Val_Mediane = LaMediane("INTERVENTION_N_ATT_DIS", "CRITICITE_SITE");
                        // Remplacer le zero par la médiane
                        sqlCmd = "UPDATE INTERVENTION_N_ATT_DIS SET INTERVENTION_N_ATT_DIS.CRITICITE_SITE = " + Val_Mediane.ToString().Replace(",", ".") + " WHERE ((INTERVENTION_N_ATT_DIS.CRITICITE_SITE) = 0)";
                        SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn);
                        SQLCommandExec.CommandType = CommandType.Text;
                        SQLCommandExec.CommandTimeout = 12000;
                        SQLCommandExec.ExecuteNonQuery();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("Calcul_Criticite_DIS(" + Etape + ")", ex.Message.ToString());
                        //InsertTableLogJobPlanificateur("Calcul_Criticite_DIS(" + trace + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                    }
                    conn.Close();
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute la fonction "AjDate"
            ///
            /////////////////////////////////////////////////////////////////////
            int AjDate(string strNote, int nbJour, string strIntrvt)
            {
                int intAjDate = 0;
                int intValeurPositive = 1;
                DateTime dtValue;

                if (nbJour < 0)
                {
                    intValeurPositive = -1;
                }

                if (strNote.Length >= 10)
                {
                    try
                    {
                        if (DateTime.TryParse(strNote.Trim().Substring(0, 10), out dtValue))
                        {
                            TimeSpan difference = (DateTime.Today - dtValue.AddDays(nbJour));
                            intAjDate = difference.Days;
                        }
                        else
                        {
                            InsertTableLogJobPlanificateur("AjDate(" + strNote.ToString() + ")", "La date n'est pas valide pour l'intervention :: " + strIntrvt.ToString() + " - " + strNote.ToString());
                            LoadTableErreur = true;
                        }
                        return (intAjDate * intValeurPositive);
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("AjDate(" + nbJour.ToString() + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                        return (intAjDate * intValeurPositive);
                    }
                }
                else
                {
                    InsertTableLogJobPlanificateur("AjDate(" + strNote.ToString() + ")", "La date n'est pas valide pour l'intervention :: " + strIntrvt.ToString() + " - " + strNote.ToString());
                    LoadTableErreur = true;
                    return (intAjDate * intValeurPositive);
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute la fonction "LaMediane" de l'ancien système 
            ///
            /////////////////////////////////////////////////////////////////////
            double LaMediane(string LaTable, string LeChamp)
            {
                double Val1, Val2, dbLaMediane;
                long NbEnreg, Position;
                string strSqlRequete;
                string sqlCmdSelect = "SELECT " + LeChamp + " AS Crit " +
                                      "FROM " + LaTable + " " +
                                      "WHERE (((" + LeChamp + ") <> 0)) " +
                                      "ORDER BY + " + LeChamp + " DESC ";

                Val1 = 0;
                Val2 = 0;
                dbLaMediane = 0;

                InsertTableLogPlanificateur("SaisLot", "LaMediane");

                string Etape = "Select";

                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                {
                    conn.Open();
                    try
                    {
                        DataSet dataSetMediane = new DataSet();
                        OleDbCommand commandDataReader = new OleDbCommand(sqlCmdSelect, conn);
                        OleDbDataAdapter dataAdapterMediane = new OleDbDataAdapter(sqlCmdSelect, conn);
                        dataAdapterMediane.Fill(dataSetMediane, "Mediane");
                        OleDbDataReader ValueReader = commandDataReader.ExecuteReader();

                        NbEnreg = dataSetMediane.Tables["Mediane"].Rows.Count;

                        Etape = "Cacul la médiane";

                        if (NbEnreg > 0)
                        {
                            Position = (long)(NbEnreg / 2);

                            if ((int)(NbEnreg % 2) != 0)
                            {
                                // Impair
                                dbLaMediane = (double)dataSetMediane.Tables[0].Rows[((int)Position)][0];
                            }
                            else
                            {
                                // Pair
                                Val1 = (double)dataSetMediane.Tables[0].Rows[((int)Position)][0];
                                Val2 = (double)dataSetMediane.Tables[0].Rows[((int)(Position + 1))][0];
                                dbLaMediane = (Val1 + Val2) / 2;
                            }
                        }

                        ValueReader.Close();
                        return dbLaMediane;
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("LaMediane(" + Etape + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                        return dbLaMediane;
                    }
                    conn.Close();
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Mise à jour de la table SAIS_DNC_Delai
            ///
            /////////////////////////////////////////////////////////////////////
            void majSAIS_DNC_Delai()
            {
                string sqlCmdDelete = "DELETE [SDDMU01].[dbo].[SAIS_DNC_Delai]";
                string sqlCmdSelect = "SELECT * " +
                                      "FROM DNC_Delai";

                string Etape = "";

                InsertTableLogPlanificateur("SaisLot", "majSAIS_DNC_Delai");

                SqlConnection mySQLConnectionMaj =
                Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                as SqlConnection;

                Etape = "Delete SAIS_DNC_Delai";
                try
                {
                    SqlCommand CmdDel = new SqlCommand(sqlCmdDelete.ToString(), mySQLConnectionMaj);
                    CmdDel.CommandType = CommandType.Text;
                    SqlDataReader readerDel = CmdDel.ExecuteReader();
                    readerDel.Read();
                    readerDel.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobPlanificateur("majSAIS_DNC_Delai(" + Etape + ")", ex.Message.ToString());
                    LoadTableErreur = true;
                }

                Etape = "Select DNC_Delai";
                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                {
                    conn.Open();
                    try
                    {
                        OleDbCommand cmdBulkCopy = new OleDbCommand(sqlCmdSelect, conn);
                        using (var bulkCopy = new SqlBulkCopy(mySQLConnectionMaj))
                        {
                            Etape = "commandSourceData.ExecuteReader";
