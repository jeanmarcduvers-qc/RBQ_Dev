							"INTERVENTION_N_ATT_DICC_Critères.D_ATTRIBUTION_INTRVT, INTERVENTION_N_ATT_DICC_Critères.CRITICITE_CODE_QUALIF_SITE, " +
							"INTERVENTION_N_ATT_DICC_Critères.SELECT_DOSSIER, INTERVENTION_N_ATT_DICC_Critères.NM_ENDR, INTERVENTION_N_ATT_DICC_Critères.N_INTRL, " +
							"INTERVENTION_N_ATT_DICC_Critères.D_CONFIRMATION_ATTRIB, INTERVENTION_N_ATT_DICC_Critères.DIRECTION, INTERVENTION_N_ATT_DICC_Critères.USER_ATTRIB " +
					"FROM   INTERVENTION_N_ATT_DICC_Critères " +
					"WHERE (((INTERVENTION_N_ATT_DICC_Critères.C_TYPE_INTRVT)<>'11') " +
					"And    ((IIf(Not IsNull(INTERVENTION_N_ATT_DICC_Critères.Date_Ech_Non_Conf) " +
					"And    Right(INTERVENTION_N_ATT_DICC_Critères.N_INTRVT,2) = '-1', INTERVENTION_N_ATT_DICC_Critères.Date_Ech_Non_Conf>Date())) = False " +
					"Or     (IIf(Not IsNull(INTERVENTION_N_ATT_DICC_Critères.Date_Ech_Non_Conf) " +
					"And     Right(INTERVENTION_N_ATT_DICC_Critères.N_INTRVT,2) = '-1',INTERVENTION_N_ATT_DICC_Critères.Date_Ech_Non_Conf>Date())) Is Null))";
		// ne pas utiser car il ne ramasse pas les anciens "And    (([Aj_30]>0)=False) " +
		public const string req_Regrp_Categ_DICC_P2_DNC = "UPDATE INTERVENTION_N_ATT_DICC SET INTERVENTION_N_ATT_DICC.CATEGORIE = 'P2' " +
														  "WHERE  (((INTERVENTION_N_ATT_DICC.CATEGORIE) Is Null) " +
															"AND ((Right([N_INTRVT],2)) = '-' " +
															"Or   (Right([N_INTRVT],2)) = '-2' " +
															"Or   (Right([N_INTRVT],2)) = '-3') " +
															"AND ((INTERVENTION_N_ATT_DICC.S_INTRVT) = 'En cours') " +
															"AND ((INTERVENTION_N_ATT_DICC.C_ETAP_ACTL) = 'Délai échu / CV' " +
															"Or   (INTERVENTION_N_ATT_DICC.C_ETAP_ACTL) = 'CV suppl à effectuer' " +
															"Or   (INTERVENTION_N_ATT_DICC.C_ETAP_ACTL) = 'CV à effectuer'))";
		public const string req_Regrp_Categ_DICC_P2 = "UPDATE INTERVENTION_N_ATT_DICC SET INTERVENTION_N_ATT_DICC.CATEGORIE = 'P2' " +
													  "WHERE  (((INTERVENTION_N_ATT_DICC.CATEGORIE) Is Null) " +
													  "AND     ((INTERVENTION_N_ATT_DICC.S_INTRVT) Not Like 'Non débutée%'))";
		public const string req_Regrp_Categ_DICC_P1 = "UPDATE INTERVENTION_N_ATT_DICC SET INTERVENTION_N_ATT_DICC.CATEGORIE = 'P1' " +
													  "WHERE  (((INTERVENTION_N_ATT_DICC.CATEGORIE) Is Null) AND ((INTERVENTION_N_ATT_DICC.C_TYPE_INTRVT)= '05'))";
		public const string req_Regrp_Categ_DICC_P3 = "UPDATE INTERVENTION_N_ATT_DICC SET INTERVENTION_N_ATT_DICC.CATEGORIE = 'P3' " +
													  "WHERE  (((INTERVENTION_N_ATT_DICC.CATEGORIE) Is Null) AND ((INTERVENTION_N_ATT_DICC.C_TYPE_INTRVT)= '03'))";
		public const string req_Regrp_Categ_DICC_P4 = "UPDATE INTERVENTION_N_ATT_DICC SET INTERVENTION_N_ATT_DICC.CATEGORIE = 'P4' " +
													  "WHERE  (((INTERVENTION_N_ATT_DICC.CATEGORIE) Is Null) " +
													  "AND     ((INTERVENTION_N_ATT_DICC.C_TYPE_INTRVT) = '04' " +
													  "Or       (INTERVENTION_N_ATT_DICC.C_TYPE_INTRVT) = '11' " +
													  "Or       (INTERVENTION_N_ATT_DICC.C_TYPE_INTRVT) = '12'))";
		public const string req_Regrp_Categ_DICC_P5_Sans_Categ = "UPDATE INTERVENTION_N_ATT_DICC SET INTERVENTION_N_ATT_DICC.CATEGORIE = 'P5' " +
																 "WHERE  (((INTERVENTION_N_ATT_DICC.CATEGORIE) Is Null))";

		public const string req_Supp_Crit_Intervenant_DICC = "DELETE Crit_Intervenant_DICC.No_INTRVN FROM Crit_Intervenant_DICC";

		public const string req_Crit_Intervenant_DICC = "INSERT INTO Crit_Intervenant_DICC ( No_INTRVN, Resultat ) " +
														"SELECT Left([no_licence],9) AS No_INTRVN, Max(NOTE_INTERVENANT_DICC.[calcul normalisé de la note de criticité]) AS Resultat " +
														"FROM   NOTE_INTERVENANT_DICC " +
														"GROUP BY Left([no_licence],9)";

		public const string req_Supp_Crit_Site_DICC = "DELETE Crit_Site_DICC.CQ FROM Crit_Site_DICC";

		public const string req_Crit_Site_DICC = "INSERT INTO Crit_Site_DICC ( CQ, Resultat ) " +
													"SELECT NOTE_CODE_QUALIF_DICC.CQ, Round([calcul normalisé de la note de criticité],15) AS Resultat " +
													"FROM NOTE_CODE_QUALIF_DICC ";

		public const string req_P1_DICC_Min_Max = "SELECT Min(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Min_P1, Max(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Max_P1 " +
													"FROM INTERVENTION_N_ATT_DICC " +
													"GROUP BY INTERVENTION_N_ATT_DICC.CATEGORIE " +
													"HAVING(((INTERVENTION_N_ATT_DICC.CATEGORIE)= 'P1'))";

		public const string req_P3_DICC_Min_Max = "SELECT Min(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Min_P3, Max(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Max_P3 " +
													"FROM INTERVENTION_N_ATT_DICC " +
													"GROUP BY INTERVENTION_N_ATT_DICC.CATEGORIE " +
													"HAVING(((INTERVENTION_N_ATT_DICC.CATEGORIE)= 'P3'))";

		public const string req_P4_DICC_Min_Max = "SELECT Min(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Min_P4, Max(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Max_P4 " +
													"FROM INTERVENTION_N_ATT_DICC " +
													"GROUP BY INTERVENTION_N_ATT_DICC.CATEGORIE " +
													"HAVING(((INTERVENTION_N_ATT_DICC.CATEGORIE)= 'P4'))";

		public const string req_INTERVENTION_N_ATT_DICC = "SELECT INTERVENTION_N_ATT_DICC.N_INTRVT, " +
																 "INTERVENTION_N_ATT_DICC.C_INTRVN, " +
																	"INTERVENTION_N_ATT_DICC.D_CRET, " +
																	"INTERVENTION_N_ATT_DICC.CRITICITE_INTRVN, " +
																	"INTERVENTION_N_ATT_DICC.CRITICITE_CODE_QUALIF_SITE, " +
																	"INTERVENTION_N_ATT_DICC.CRITICITE_INTRVT, " +
																	"INTERVENTION_N_ATT_DICC.CATEGORIE, " +
																	"INTERVENTION_N_ATT_DICC.D_RECEPTION_DEMN, " +
																	"INTERVENTION_N_ATT_DICC.C_COD_QUALF_SITE, " +
																	"IIf(IsNull(INTERVENTION_N_ATT_DICC.V_DELA), 0, INTERVENTION_N_ATT_DICC.V_DELA) as V_DELA, " +
																	"INTERVENTION_N_ATT_DICC.D_CRET_NON_CONFORMITE, " +
																	"IIf(IsNull(Round(Crit_Intervenant_DICC.Resultat,15)),0,Round(Crit_Intervenant_DICC.Resultat,15)) AS Resultat_Interv, " +
																	"iif(isnull(Round(Crit_Site_DICC.Resultat, 15)), 0, Round(Crit_Site_DICC.Resultat, 15))  as Resultat_Site " +
															"FROM (INTERVENTION_N_ATT_DICC " +
																 "LEFT JOIN Crit_Intervenant_DICC ON INTERVENTION_N_ATT_DICC.C_INTRVN = Crit_Intervenant_DICC.No_INTRVN) " +
																 "LEFT JOIN Crit_Site_DICC ON INTERVENTION_N_ATT_DICC.C_COD_QUALF_SITE = Crit_Site_DICC.CQ";

		public const string req_Delai_Ref_Min_Max_DICC = "SELECT IIf(IsNull(Min(IIf(Not IsNull([D_CRET_NON_CONFORMITE]), DateDiff('d',#10/20/2017#,DateAdd('d',iif(isnull([V_DELA]), 0, [V_DELA]), [D_CRET_NON_CONFORMITE]))))), 0, Min(IIf(Not IsNull([D_CRET_NON_CONFORMITE]), DateDiff('d',#10/20/2017#,DateAdd('d',iif(isnull([V_DELA]), 0, [V_DELA]), [D_CRET_NON_CONFORMITE]))))) AS Min_Delai_Ref, " +
																"IIf(IsNull(Max(IIf(Not IsNull([D_CRET_NON_CONFORMITE]) ,DateDiff('d',#10/20/2017#,DateAdd('d',iif(isnull([V_DELA]), 0, [V_DELA]), [D_CRET_NON_CONFORMITE]))))), 0, Max(IIf(Not IsNull([D_CRET_NON_CONFORMITE]) ,DateDiff('d',#10/20/2017#,DateAdd('d',iif(isnull([V_DELA]), 0, [V_DELA]), [D_CRET_NON_CONFORMITE]))))) AS Max_Delai_Ref " +
														  "FROM  INTERVENTION_N_ATT_DICC";

		public const string Qry_Supp_INTERVENTION_N_ATT_DESP = "DELETE INTERVENTION_N_ATT_DESP.N_INTRVT FROM INTERVENTION_N_ATT_DESP";

		public const string Qry_Supp_INTERVENTION_N_ATT_DESP_Critères = "DELETE INTERVENTION_N_ATT_DESP_Critères.N_INTRVT FROM INTERVENTION_N_ATT_DESP_Critères";

		public const string Qry_Interv_N_ATT_DESP_Critère_Creer = "INSERT INTO INTERVENTION_N_ATT_DESP_Critères ( N_INTRVT, N_SITE, N_DEMN, C_INTRVN, C_INTRVT, " +
																												 "D_CRET, D_OUVE_INTRVT, C_CODE_INTRVT, C_TYPE_INTRVT, " +
																												 "C_DE_TYPE_INTRVT, N_REGR, C_DE_REGR, S_INTRVT, C_RISQ, " +
																												 "DE_DOMN_INTRVT, CATEGORIE, D_CRET_DEMN, D_RECEPTION_DEMN, " +
																												 "D_CRET_NOTE, C_SUJT_NOTE_INTR, C_SOUS_SUJT_NOTE, DE_NOTE, " +
																												 "C_ADRE_SITE, C_CODPOST_SITE, C_COD_QUALF_SITE, " +
																												 "C_DESC_COD_QUALF_SITE, C_VILLE_SITE, REGION, SOUS_REGION, " +
																												 "[Q_ ETAG_BATM], V_AIRE_BATM, V_CAPC_MAXM_BATM, NM_INTRVN, " +
																												 "C_ETAP_ACTL, CRITICITE_INTRVT, CRITICITE_SITE, " +
																												 "CRITICITE_INTRVN, D_CRET_NON_CONFORMITE, V_DELA, " +
																												 "D_ATTRIBUTION_INTRVT, CRITICITE_CODE_QUALIF_SITE, " +
																												 "SELECT_DOSSIER, NM_ENDR, N_INTRL, D_CONFIRMATION_ATTRIB, " +
																												 "DIRECTION, USER_ATTRIB, Aj_30, Aj_365, Date_Ech_Non_Conf ) " +
																  "SELECT INTERVENTION_N_ATT.N_INTRVT, INTERVENTION_N_ATT.N_SITE, INTERVENTION_N_ATT.N_DEMN, " +
																		 "INTERVENTION_N_ATT.C_INTRVN, INTERVENTION_N_ATT.C_INTRVT, INTERVENTION_N_ATT.D_CRET, " +
																		 "INTERVENTION_N_ATT.D_OUVE_INTRVT, INTERVENTION_N_ATT.C_CODE_INTRVT, INTERVENTION_N_ATT.C_TYPE_INTRVT, " +
																		 "INTERVENTION_N_ATT.C_DE_TYPE_INTRVT, INTERVENTION_N_ATT.N_REGR, INTERVENTION_N_ATT.C_DE_REGR, " +
																		 "INTERVENTION_N_ATT.S_INTRVT, INTERVENTION_N_ATT.C_RISQ, INTERVENTION_N_ATT.DE_DOMN_INTRVT, " +
																		 "INTERVENTION_N_ATT.CATEGORIE, INTERVENTION_N_ATT.D_CRET_DEMN, INTERVENTION_N_ATT.D_RECEPTION_DEMN, " +
																		 "INTERVENTION_N_ATT.D_CRET_NOTE, INTERVENTION_N_ATT.C_SUJT_NOTE_INTR, INTERVENTION_N_ATT.C_SOUS_SUJT_NOTE, " +
																		 "INTERVENTION_N_ATT.DE_NOTE, INTERVENTION_N_ATT.C_ADRE_SITE, INTERVENTION_N_ATT.C_CODPOST_SITE, " +
																		 "INTERVENTION_N_ATT.C_COD_QUALF_SITE, INTERVENTION_N_ATT.C_DESC_COD_QUALF_SITE, INTERVENTION_N_ATT.C_VILLE_SITE, " +
																		 "INTERVENTION_N_ATT.REGION, INTERVENTION_N_ATT.SOUS_REGION, INTERVENTION_N_ATT.[Q_ ETAG_BATM], " +
																		 "INTERVENTION_N_ATT.V_AIRE_BATM, INTERVENTION_N_ATT.V_CAPC_MAXM_BATM, INTERVENTION_N_ATT.NM_INTRVN, " +
																		 "INTERVENTION_N_ATT.C_ETAP_ACTL, INTERVENTION_N_ATT.CRITICITE_INTRVT, INTERVENTION_N_ATT.CRITICITE_SITE, " +
																		 "INTERVENTION_N_ATT.CRITICITE_INTRVN, INTERVENTION_N_ATT.D_CRET_NON_CONFORMITE, INTERVENTION_N_ATT.V_DELA, " +
																		 "INTERVENTION_N_ATT.D_ATTRIBUTION_INTRVT, INTERVENTION_N_ATT.CRITICITE_CODE_QUALIF_SITE, " +
																		 "INTERVENTION_N_ATT.SELECT_DOSSIER, INTERVENTION_N_ATT.NM_ENDR, INTERVENTION_N_ATT.N_INTRL, " +
																		 "INTERVENTION_N_ATT.D_CONFIRMATION_ATTRIB, 'DESP' AS DIRECTION, INTERVENTION_N_ATT.USER_ATTRIB, " +
																		 "IIf(IsNull([DE_NOTE]),-1, DateDiff('d', DateAdd('d',30, Date()),CDate(Mid([DE_NOTE],6,2) + '/' + Right(Left([DE_NOTE],10),2) + '/' + Left([DE_NOTE],4)))) AS Aj_30, " +
																		 "IIf(IsNull([DE_NOTE]),1, DateDiff('d', DateAdd('d', -365, Date()), CDate(Mid([DE_NOTE], 6, 2) + '/' + Right(Left([DE_NOTE], 10), 2) + '/' + Left([DE_NOTE],4)))) AS Aj_365, " +
																		 "IIf(Not IsNull([D_CRET_NON_CONFORMITE]), DateAdd('d',[V_DELA],[D_CRET_NON_CONFORMITE])) AS Date_Ech_Non_Conf " +
																  "FROM   INTERVENTION_N_ATT " +
																  "WHERE  (((INTERVENTION_N_ATT.DE_DOMN_INTRVT)= 'AP - Appareil sous-pression' " +
																  "AND    IIf(IsNull([DE_NOTE]),true,isdate(Mid([DE_NOTE],6,2) + '/' + Right(Left([DE_NOTE],10),2) + '/' + Left([DE_NOTE],4))) = true))";

