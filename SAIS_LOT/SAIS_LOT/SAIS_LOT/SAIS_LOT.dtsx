                                       "FROM ([SDGIC01].[dbo].[GI3_INTERVENTION] as dbo_GI3_INTERVENTION " +
                                              "LEFT JOIN (SELECT dbo_GI3_ACTIVITE.GI3_C_ROWD_INTRVT, dbo_GI3_ACTIVITE.GI3_C_TYP, dbo_GI3_ACTIVITE.GI3_C_ETAT, dbo_GI3_ACTIVITE.GI3_DE_ACTV, Min(dbo_GI3_ACTIVITE.GI3_D_DEBT) AS MinDeGI3_D_DEBT " +
