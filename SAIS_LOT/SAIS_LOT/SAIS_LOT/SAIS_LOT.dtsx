        //////////////////////////////////////////////////////////////////////
        ///
        //     insert les informations dant la table Log_Job_Planificateur
        ///
        /////////////////////////////////////////////////////////////////////
        private void InsertTableLogJobPlanificateur(string pfonction, string pErreurMessage)
        {
            int lParametreErreurMessage;
            pErreurMessage = pfonction + " - " + pErreurMessage;
            pErreurMessage = pErreurMessage.Replace("'", "''");
            lParametreErreurMessage = pErreurMessage.Length;

            if (pErreurMessage.Length > 250)
            {
                pErreurMessage = pErreurMessage.Substring(0, 245);
                pErreurMessage = pErreurMessage + "...";
            }

            if (strCodeTraitement.Length > 39)
            {
                strCodeTraitement = strCodeTraitement.Substring(0, 39);
            }

            string sqlInsCmd = "insert into [SDDMU01].[dbo].[Log_Job_Planificateur] values('" + strIndSystem + "', '" + strCodeTraitement + "', '" + strTypeTraitement + "', '" + pErreurMessage + "', 'Auto01', GETDATE())";

            try
            {
                SqlCommand SQLCommandJobErr = new SqlCommand(sqlInsCmd.ToString(), mySQLConnectionLog);
                SQLCommandJobErr.CommandType = CommandType.Text;
                SqlDataReader readerErreur = SQLCommandJobErr.ExecuteReader();
                readerErreur.Read();
                readerErreur.Close();
            }
            catch (Exception ex)
            {
                // Ignore error
            }
        }

        //////////////////////////////////////////////////////////////////////
        ///
        //     insert les informations dant la table Log_Planificateur
        ///
        /////////////////////////////////////////////////////////////////////
        private void InsertTableLogPlanificateur(string strIndSystem, string strCodeTraitement)
        {
            if (strCodeTraitement.Length > 39)
            {
                strCodeTraitement = strCodeTraitement.Substring(0, 39);
            }

            string sqlInsCmd = "insert into [SDDMU01].[dbo].[Log_Planificateur] values('" + strIndSystem + "', '" + strCodeTraitement + "', GETDATE(), 'Auto01', 'Tâche Automatisée')";

            try
            {
                SqlCommand SQLCommandLog = new SqlCommand(sqlInsCmd.ToString(), mySQLConnectionLog);
                SQLCommandLog.CommandType = CommandType.Text;

                SqlDataReader readerLog = SQLCommandLog.ExecuteReader();
                readerLog.Read();
                readerLog.Close();
            }
            catch (Exception ex)
            {
                // Ignore error
            }
        }

        void Log_DatesInvalides()
        {
            try
            {
                if (strConnectBdAccess == null)
                {
                    InsertTableLogJobPlanificateur("Log_DatesInvalides", "strConnectBdAccess est null");
                    LoadTableErreur = true;
                    return;
                }

                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                {
                    conn.Open();

                    string sqlSelect = @"
                SELECT N_INTRVT, DE_NOTE 
                FROM INTERVENTION_N_ATT 
                WHERE DE_NOTE IS NOT NULL 
                  AND IsDate(Mid([DE_NOTE],9,2) & '/' & Mid([DE_NOTE],6,2) & '/' & Left([DE_NOTE],4)) = False";

                    using (OleDbCommand cmdSelect = new OleDbCommand(sqlSelect, conn))
                    using (OleDbDataReader reader = cmdSelect.ExecuteReader())
                    {
                        while (reader.Read())
                        {
                            string deNote = reader["DE_NOTE"]?.ToString();
                            string dateStr = !string.IsNullOrEmpty(deNote) && deNote.Length >= 10
                                ? deNote.Substring(0, 10)
                                : deNote;

                            string msg = "Date cible invalide pour intervention: "
                                         + reader["N_INTRVT"].ToString()
                                         + " - " + dateStr;

                            InsertTableLogJobPlanificateur("DateInvalide", msg);
                        }
                    }
                }

                InsertTableLogPlanificateur("SaisLot", "Log_DatesInvalides terminé");
            }
            catch (Exception ex)
            {
                InsertTableLogJobPlanificateur("Log_DatesInvalides", ex.ToString());
                LoadTableErreur = true;
            }
        }


        // Email confirmation rétablissement (détecte automatiquement plantage OU erreurs métier)
        private void SendMailConfirmation()
        {
            try
            {
                // Chercher la dernière entrée problématique
                string sqlCheck = "SELECT TOP 1 IndSystem " +
                                  "FROM [SDDMU01].[dbo].[Log_Job_Planificateur] " +
                                  "WHERE IndSystem IN ('PLANTAGE_FATAL', 'SaisLot') " +
                                  "AND DateErreur < GETDATE() " +
                                  "ORDER BY DateErreur DESC";

                using (SqlCommand cmd = new SqlCommand(sqlCheck, mySQLConnectionLog))
                {
                    object result = cmd.ExecuteScalar();

                    if (result != null)
                    {
                        string dernierProbleme = result.ToString();

                        // Envoyer email SEULEMENT si dernier était un problème
                        if (dernierProbleme == "PLANTAGE_FATAL" || dernierProbleme == "SaisLot")
                        {
                            string newLine = Environment.NewLine;
                            string strDate = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
                            string EnvoisCourrielA = "centre.de.pilotage@rbq.gouv.qc.ca";
                            string EnvoisCourrielCC = "alertage.etl.app@rbq.gouv.qc.ca";
                            string EnvoisCourrielSuject = "✅ Service SAIS - Rétabli";

                            // Message adaptatif selon le type de problème résolu
                            string problemeResolu = (dernierProbleme == "PLANTAGE_FATAL")
                                ? "Interruption du service"
                                : "Erreurs de traitement";

                            string messageDetail = (dernierProbleme == "PLANTAGE_FATAL")
                                ? "Les données sont maintenant à jour."
                                : "Les données sont maintenant complètes dans la base Access.";

                            // SECTION SIMPLE SEULEMENT (pas de section technique pour confirmation)
                            string EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                "Le service de mise à jour SAIS en PROD fonctionne à nouveau normalement." + newLine + newLine +
                                "Problème résolu : " + problemeResolu + newLine +
                                "Date/Heure rétablissement : " + strDate + newLine + newLine +
                                messageDetail + newLine + newLine +
                                "..." + newLine +
                                "Direction des technologies de l'information" + newLine +
                                "Régie du bâtiment du Québec";

                            string SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                            MailMessage mail = new MailMessage(Dts.Variables["User::EnvoyePar"].Value.ToString(), EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);
                            mail.CC.Add(EnvoisCourrielCC);

                            SmtpClient smtp = new SmtpClient(SmtpServer);
                            smtp.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                            smtp.Send(mail);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                // Ignore error
            }
        }

        // Email alerte plantage fatal (section pilotage + section technique)
        private void SendMailPlantage(Exception ex)
        {
            string newLine = Environment.NewLine;
            string strDate = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            string EnvoisCourrielA = "centre.de.pilotage@rbq.gouv.qc.ca";
            string EnvoisCourrielCC = "alertage.etl.app@rbq.gouv.qc.ca";
            string EnvoisCourrielSuject = "⚠️ Service SAIS - Interruption détectée";

            // SECTION SIMPLE (pour centre de pilotage)
            string sectionSimple = "Bonjour," + newLine + newLine +
                                   "Le service de mise à jour SAIS en PROD a rencontré un problème technique et ne fonctionne pas actuellement." + newLine + newLine +
                                   "Date/Heure : " + strDate + newLine +
                                   "Impact : Les données SAIS ne sont pas mises à jour" + newLine + newLine +
                                   "L'équipe informatique intervient pour régler la situation." + newLine +
                                   "Vous recevrez une confirmation une fois le service rétabli." + newLine + newLine +
                                   "...";

            // SECTION TECHNIQUE (pour équipe IT)
            string sectionTechnique = newLine + newLine +
                                      "---------------------------------------------------------------------" + newLine +
                                      "INFORMATIONS TECHNIQUES (pour equipe ETL)" + newLine +
                                      "---------------------------------------------------------------------" + newLine + newLine +
                                      "Package SSIS : SAIS_Lot (PRODUCTION)" + newLine +
                                      "Erreur : " + ex.Message + newLine +
                                      "StackTrace : " + (ex.StackTrace != null ? ex.StackTrace.Substring(0, Math.Min(500, ex.StackTrace.Length)) : "Non disponible") + newLine + newLine +
                                      "Pour investigation :" + newLine +
                                      "- Table logs : [SDDMU01].[dbo].[Log_Job_Planificateur]" + newLine +
                                      "- Filtre : IndSystem = 'PLANTAGE_FATAL'" + newLine +
                                      "- Date : >= '" + strDate + "'" + newLine + newLine;

            string EnvoisCourrielCorps = sectionSimple + sectionTechnique +
                                         "Direction des technologies de l'information" + newLine +
                                         "Régie du bâtiment du Québec";

            string SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

            try
            {
                MailMessage mail = new MailMessage(Dts.Variables["User::EnvoyePar"].Value.ToString(), EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);
                mail.CC.Add(EnvoisCourrielCC);

                SmtpClient smtp = new SmtpClient(SmtpServer);
                smtp.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                smtp.Send(mail);
            }
            catch (Exception exMail)
            {
                // Ignore error
            }
        }

        private bool defined()
        {
            throw new NotImplementedException();
        }

        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion

    }
}]]></ProjectItem>
