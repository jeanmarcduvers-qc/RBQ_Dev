																							"CRITICITE_SITE, CRITICITE_INTRVN, D_CRET_NON_CONFORMITE, V_DELA, " +
																							"D_ATTRIBUTION_INTRVT, CRITICITE_CODE_QUALIF_SITE, SELECT_DOSSIER, NM_ENDR, " +
