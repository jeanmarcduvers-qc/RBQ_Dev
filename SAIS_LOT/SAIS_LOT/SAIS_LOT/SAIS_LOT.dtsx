		public const string Qry_Add_InterventionsGIC_DESP = "INSERT INTO tbl_INTERVENTIONS ( N_INTRVT, N_SITE, NM_ENDR, N_DEMN, C_INTRVN, C_INTRVT, D_CRET, D_OUVE_INTRVT, C_CODE_INTRVT, " +
																							"C_TYPE_INTRVT, C_DE_TYPE_INTRVT, N_REGR, C_DE_REGR, S_INTRVT, C_RISQ, DE_DOMN_INTRVT, " +
																							"CATEGORIE, D_CRET_DEMN, D_RECEPTION_DEMN, D_CRET_NOTE, C_SUJT_NOTE_INTR, C_SOUS_SUJT_NOTE, " +
																							"DE_NOTE, C_ADRE_SITE, C_CODPOST_SITE, C_COD_QUALF_SITE, C_DESC_COD_QUALF_SITE, C_VILLE_SITE, " +
																							"REGION, V_AIRE_BATM, V_CAPC_MAXM_BATM, NM_INTRVN, C_ETAP_ACTL, CRITICITE_INTRVT, CRITICITE_SITE, " +
																							"CRITICITE_INTRVN, D_CRET_NON_CONFORMITE, V_DELA, D_ATTRIBUTION_INTRVT, CRITICITE_CODE_QUALIF_SITE, " +
																							"SOUS_REGION, N_INTRL, D_CONFIRMATION_ATTRIB, DIRECTION, USER_ATTRIB ) " +
															"SELECT  tbl_Intervention_GIC.N_INTRVT, tbl_Intervention_GIC.N_SITE, tbl_Intervention_GIC.NM_ENDR, tbl_Intervention_GIC.N_DEMN, " +
																	"tbl_Intervention_GIC.C_INTRVN, tbl_Intervention_GIC.C_INTRVT, tbl_Intervention_GIC.D_CRET, tbl_Intervention_GIC.D_OUVE_INTRVT, " +
																	"tbl_Intervention_GIC.C_CODE_INTRVT, tbl_Intervention_GIC.C_TYPE_INTRVT, tbl_Intervention_GIC.C_DE_TYPE_INTRVT, " +
																	"tbl_Intervention_GIC.N_REGR, tbl_Intervention_GIC.C_DE_REGR, tbl_Intervention_GIC.S_INTRVT, tbl_Intervention_GIC.C_RISQ, " +
																	"tbl_Intervention_GIC.DE_DOMN_INTRVT, tbl_Intervention_GIC.CATEGORIE, tbl_Intervention_GIC.D_CRET_DEMN, tbl_Intervention_GIC.D_RECEPTION_DEMN, " +
																	"tbl_Intervention_GIC.D_CRET_NOTE, tbl_Intervention_GIC.C_SUJT_NOTE_INTR, tbl_Intervention_GIC.C_SOUS_SUJT_NOTE, " +
																	"tbl_Intervention_GIC.DE_NOTE, tbl_Intervention_GIC.C_ADRE_SITE, tbl_Intervention_GIC.C_CODPOST_SITE, " +
																	"tbl_Intervention_GIC.C_COD_QUALF_SITE, tbl_Intervention_GIC.C_DESC_COD_QUALF_SITE, tbl_Intervention_GIC.C_VILLE_SITE, " +
																	"tbl_Intervention_GIC.REGION, tbl_Intervention_GIC.V_AIRE_BATM, tbl_Intervention_GIC.V_CAPC_MAXM_BATM, " +
																	"tbl_Intervention_GIC.NM_INTRVN, tbl_Intervention_GIC.C_ETAP_ACTL, tbl_Intervention_GIC.CRITICITE_INTRVT, " +
																	"tbl_Intervention_GIC.CRITICITE_SITE, tbl_Intervention_GIC.CRITICITE_INTRVN, tbl_Intervention_GIC.D_CRET_NON_CONFORMITE, " +
																	"tbl_Intervention_GIC.V_DELA, tbl_Intervention_GIC.D_ATTRIBUTION_INTRVT, tbl_Intervention_GIC.CRITICITE_CODE_QUALIF_SITE, " +
																	"tbl_Intervention_GIC.SOUS_REGION, tbl_Intervention_GIC.N_INTRL, tbl_Intervention_GIC.D_CONFIRMATION_ATTRIB, " +
																	"tbl_Intervention_GIC.DIRECTION, tbl_Intervention_GIC.USER_ATTRIB " +
															"FROM	tbl_Intervention_GIC " +
															"WHERE	(((tbl_Intervention_GIC.C_TYPE_INTRVT) = '02') " +
															"AND	 ((tbl_Intervention_GIC.S_INTRVT) Not Like 'Terminé%' " +
															"And	  (tbl_Intervention_GIC.S_INTRVT) Not Like 'Annulé%' " +
															"And	  (tbl_Intervention_GIC.S_INTRVT) Not Like 'Ouvert') " +
															"AND	 ((tbl_Intervention_GIC.DE_DOMN_INTRVT) Like 'AP%')) " +
															"OR     (((tbl_Intervention_GIC.C_TYPE_INTRVT) = '01' " +
															"Or		  (tbl_Intervention_GIC.C_TYPE_INTRVT) = '03' " +
															"Or		  (tbl_Intervention_GIC.C_TYPE_INTRVT) = '04' " +
															"Or		  (tbl_Intervention_GIC.C_TYPE_INTRVT) = '05' " +
															"Or		  (tbl_Intervention_GIC.C_TYPE_INTRVT) = '10' " +
															"Or		  (tbl_Intervention_GIC.C_TYPE_INTRVT) = '11' " +
															"Or		  (tbl_Intervention_GIC.C_TYPE_INTRVT) = '12' " +
															"Or		  (tbl_Intervention_GIC.C_TYPE_INTRVT) = '128') " +
															"AND	 ((tbl_Intervention_GIC.S_INTRVT) Like 'Non débuté%') " +
															"AND	 ((tbl_Intervention_GIC.DE_DOMN_INTRVT) Like 'AP%'))";



		public const string Qry_MAJ_SousRegion_tbl_Interventions = "UPDATE (( (select N_INTRVT, Left([C_CODPOST_SITE],3) AS PrefixeCP, REGION " +
																				"from tbl_INTERVENTIONS) sQry_INTERVENTION_PrefixeCodePostal " +
																		"INNER JOIN tbl_INTERVENTIONS ON sQry_INTERVENTION_PrefixeCodePostal.N_INTRVT = tbl_INTERVENTIONS.N_INTRVT) " +
																		"LEFT JOIN tbl_SousRegionMontreal ON sQry_INTERVENTION_PrefixeCodePostal.PrefixeCP = tbl_SousRegionMontreal.PrefixeCP) " +
																		"LEFT JOIN tbl_Regions ON sQry_INTERVENTION_PrefixeCodePostal.PrefixeCP = tbl_Regions.PrefixeCP " +
																	"SET tbl_INTERVENTIONS.SOUS_REGION = IIf(IsNull([sQry_INTERVENTION_PrefixeCodePostal]![REGION]),[tbl_Regions]![Région],[sQry_INTERVENTION_PrefixeCodePostal]![REGION] & IIf(Not IsNull([tbl_SousRegionMontreal]![PrefixeCP]),' - ' + [tbl_SousRegionMontreal]![DivisionRBQ],''))";

		public const string Qry_MAJ_SousRegion_ERREUR_tbl_Interventions = "UPDATE tbl_INTERVENTIONS " +
																					"LEFT JOIN tbl_Regions ON tbl_INTERVENTIONS.SOUS_REGION = tbl_Regions.Région " +
																			"SET    tbl_INTERVENTIONS.SOUS_REGION = 'ERREUR' " +
																			"WHERE  (((tbl_INTERVENTIONS.SOUS_REGION) Is Null " +
																			"Or       (tbl_INTERVENTIONS.SOUS_REGION) = '')) " +
																			"OR     (((tbl_Regions.Région) Is Null))";

		public const string Qry_Sup_GI3_INTERVENTION = "DELETE GI3_INTERVENTION.* FROM GI3_INTERVENTION";

		public const string Qry_Sup_Interv_Annulé = "DELETE tbl_INTERVENTIONS.S_INTRVT, tbl_INTERVENTIONS.D_ATTRIBUTION_INTRVT, tbl_INTERVENTIONS.D_CONFIRMATION_ATTRIB " +
													"FROM   tbl_INTERVENTIONS " +
													"WHERE  (((tbl_INTERVENTIONS.S_INTRVT) = 'Annulé') " +
													"AND     ((tbl_INTERVENTIONS.D_ATTRIBUTION_INTRVT) Is Null)) " +
													"OR     (((tbl_INTERVENTIONS.S_INTRVT) = 'Annulé') " +
													"AND     ((tbl_INTERVENTIONS.D_CONFIRMATION_ATTRIB) Is Null))";

