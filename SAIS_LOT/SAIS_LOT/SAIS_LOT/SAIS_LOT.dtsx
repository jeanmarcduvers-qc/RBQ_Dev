                {
                    conn.Open();
                    OleDbTransaction transaction = conn.BeginTransaction();
                    try
                    {
                        SqlCommand commandDataReader = new SqlCommand(sqlCmdSelect, mySQLConnectionMaj);
                        SqlDataReader ValueReader = commandDataReader.ExecuteReader();
                        OleDbCommand SQLCommandExec = new OleDbCommand(strSqlRequete, conn, transaction);
                        SQLCommandExec.CommandTimeout = 12000;

                        // Crée les paramètres UNE SEULE FOIS
                        for (int i = 0; i < 3; i++)
                            SQLCommandExec.Parameters.Add(new OleDbParameter());

                        Etape = "Insert";

                        while (ValueReader.Read())
                        {
                            strIntrvt = ValueReader["GI3_C_ROWD_INTRVT"].ToString();
                            intCount++;
                            SQLCommandExec.Parameters[0].Value = ValueReader["GI3_C_ROWD_INTRVT"];
                            SQLCommandExec.Parameters[1].Value = ValueReader["MaxDeGI3_D_CRET"];
                            SQLCommandExec.Parameters[2].Value = ValueReader["GI3_V_DELA"];
                            SQLCommandExec.ExecuteNonQuery();

                            //if (intCount % 1000 == 0)
                            //{
                            //    transaction.Commit();
                            //    transaction.Dispose();

                            //    // redémarre une transaction propre
                            //    // redémarrer une transaction propre
                            //    transaction = conn.BeginTransaction();
                            //    SQLCommandExec.Transaction = transaction;
                            //}
                        }

                        transaction.Commit();
                        ValueReader.Close();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("req_DNC(" + Etape + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                    }
                    conn.Close();
                }
                mySQLConnectionMaj.Close();
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute la requête "req_Note_Inter_pour_Ajout" de l'ancien système 
            ///
            /////////////////////////////////////////////////////////////////////
            void req_Note_Inter_pour_Ajout()
            {
                string strSqlDelete = "DELETE * FROM NOTE_INTERVENTION";
                string strSqlRequete;
                string sqlCmdSelect = "select resultat.*, SUBSTRING(dbo_GI3_NOTE_INTERVENTION_APPR_SITE_II.GI3_DE_NOTE, 1, 250) GI3_DE_NOTE " +
                                      "from  (SELECT dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_ROWD_INTRVT, " +
                                                     "dbo_GI3_INTERVENTION.GI3_N_INTRVT, " +
                                                     "Max(dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_D_CRET) AS GI3_D_CRET, " +
                                                     "dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SUJT_NOTE_INTR, " +
                                                     "dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SOUS_SUJT_NOTE " +
                                             "FROM  [SDGIC01].[dbo].[GI3_NOTE_INTERVENTION_APPR_SITE] as dbo_GI3_NOTE_INTERVENTION_APPR_SITE " +
                                                    "INNER JOIN [SDGIC01].[dbo].[GI3_INTERVENTION] as dbo_GI3_INTERVENTION ON dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_ROWD_INTRVT = dbo_GI3_INTERVENTION.GI3_C_ROWD_INTRVT " +
                                             "WHERE (((dbo_GI3_INTERVENTION.GI3_S_INTRVT) <> 'Terminée' " +
                                             "And     (dbo_GI3_INTERVENTION.GI3_S_INTRVT) <> 'Termine' " +
                                             "And     (dbo_GI3_INTERVENTION.GI3_S_INTRVT) <> 'Annulé' " +
                                             "And     (dbo_GI3_INTERVENTION.GI3_S_INTRVT) <> 'Terminé') " +
                                             "AND    ((dbo_GI3_INTERVENTION.GI3_C_ASSIGNE_A) = 'SADMIN')) " +
                                             "GROUP BY dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_ROWD_INTRVT, " +
                                                      "dbo_GI3_INTERVENTION.GI3_N_INTRVT, " +
                                                      "dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SUJT_NOTE_INTR, " +
                                                      "dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SOUS_SUJT_NOTE " +
                                             "HAVING  (((dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SUJT_NOTE_INTR) = 'PPA') AND ((dbo_GI3_NOTE_INTERVENTION_APPR_SITE.GI3_C_SOUS_SUJT_NOTE) = 'Date cible intervention'))) resultat, " +
                                            "[SDGIC01].[dbo].[GI3_NOTE_INTERVENTION_APPR_SITE] as dbo_GI3_NOTE_INTERVENTION_APPR_SITE_II " +
                                      "where dbo_GI3_NOTE_INTERVENTION_APPR_SITE_II.GI3_C_ROWD_INTRVT = resultat.GI3_C_ROWD_INTRVT " +
                                      "AND   dbo_GI3_NOTE_INTERVENTION_APPR_SITE_II.GI3_D_CRET = (select min(dbo_GI3_NOTE_INTERVENTION_APPR_SITE_III.GI3_D_CRET) " +
                                                                                                 "from   [SDGIC01].[dbo].[GI3_NOTE_INTERVENTION_APPR_SITE] as dbo_GI3_NOTE_INTERVENTION_APPR_SITE_III " +
                                                                                                 "where  dbo_GI3_NOTE_INTERVENTION_APPR_SITE_III.GI3_C_ROWD_INTRVT = resultat.GI3_C_ROWD_INTRVT " +
                                                                                                 "and  (((dbo_GI3_NOTE_INTERVENTION_APPR_SITE_III.GI3_C_SUJT_NOTE_INTR) = 'PPA') AND((dbo_GI3_NOTE_INTERVENTION_APPR_SITE_III.GI3_C_SOUS_SUJT_NOTE) = 'Date cible intervention'))) " +
                                      "and   dbo_GI3_NOTE_INTERVENTION_APPR_SITE_II.GI3_C_SUJT_NOTE_INTR = resultat.GI3_C_SUJT_NOTE_INTR " +
                                      "and   dbo_GI3_NOTE_INTERVENTION_APPR_SITE_II.GI3_C_SOUS_SUJT_NOTE = resultat.GI3_C_SOUS_SUJT_NOTE " +
                                      "ORDER BY resultat.GI3_N_INTRVT";

                string Etape = "Select";

                InsertTableLogPlanificateur("SaisLot", "req_Note_Inter_pour_Ajout");
                ExecuteSQL("req_Note_Inter_pour_Ajout", strSqlDelete.ToString());

                SqlConnection mySQLConnectionMaj = Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction) as SqlConnection;

                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                {
                    conn.Open();
                    using (OleDbTransaction transaction = conn.BeginTransaction())
                    {
                        try
                        {
                            SqlCommand commandDataReader = new SqlCommand(sqlCmdSelect, mySQLConnectionMaj);
                            SqlDataReader ValueReader = commandDataReader.ExecuteReader();
                            OleDbCommand SQLCommandExec = new OleDbCommand("INSERT", conn, transaction);

                            Etape = "Insert";

                            while (ValueReader.Read())
                            {
                                strSqlRequete = "insert into NOTE_INTERVENTION ( GI3_C_ROWD_INTRVT, GI3_N_INTRVT, GI3_D_CRET, GI3_C_SUJT_NOTE_INTR, GI3_C_SOUS_SUJT_NOTE, GI3_DE_NOTE ) " +
                                                "values('" + ValueReader["GI3_C_ROWD_INTRVT"].ToString().TrimEnd() + "', '" +
                                                             ValueReader["GI3_N_INTRVT"].ToString() + "', '" +
                                                             ValueReader["GI3_D_CRET"].ToString() + "', '" +
                                                             ValueReader["GI3_C_SUJT_NOTE_INTR"].ToString() + "', '" +
                                                             ValueReader["GI3_C_SOUS_SUJT_NOTE"].ToString() + "', '" +
                                                             ValueReader["GI3_DE_NOTE"].ToString().Replace("'", "''") + "')";
                                SQLCommandExec.CommandType = CommandType.Text;
                                SQLCommandExec.CommandText = strSqlRequete.ToString();
                                SQLCommandExec.CommandTimeout = 12000;
                                SQLCommandExec.ExecuteNonQuery();
                            }

                            transaction.Commit();
                            ValueReader.Close();
                        }
                        catch (Exception ex)
                        {
                            //MessageBox.Show(ex.Message);
                            InsertTableLogJobPlanificateur("req_Note_Inter_pour_Ajout(" + Etape + ")", ex.Message.ToString());
                            LoadTableErreur = true;
                        }
                    }
                    conn.Close();
                }
                mySQLConnectionMaj.Close();
            }

