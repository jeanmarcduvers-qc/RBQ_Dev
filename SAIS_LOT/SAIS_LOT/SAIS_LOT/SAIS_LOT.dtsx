                                                         "AND((dbo_GI3_ACTIVITE.GI3_DE_ACTV) = 'Saisir les efforts (Pour fin de facturation ou non)'))) sQry_GI3_Activite_Visite ON dbo_GI3_INTERVENTION.GI3_C_ROWD_INTRVT = sQry_GI3_Activite_Visite.GI3_C_ROWD_INTRVT) " +
