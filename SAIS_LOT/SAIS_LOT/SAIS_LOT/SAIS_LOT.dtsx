            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute la requête "req_SITE_Ajout" de l'ancien système 
            ///
            /////////////////////////////////////////////////////////////////////
            void req_SITE_Ajout()
            {
                string strSqlDelete = "DELETE * FROM Site_Ajout";
                string strSqlRequete;
                string strSql;
                string sqlCmdSelect = "SELECT distinct " +
                                             "dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE, " +
                                             "dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, " +
                                             "sQry_Site_CodeQualif.CodeQualif AS GI3_C_QUAL, " +
                                             "sQry_Site_NbEtage.NbEtage AS GI3_Q_ETAG_BATM, " +
                                             "sQry_Site_Aire.Aire AS GI3_V_AIRE_BATM, " +
                                             "sQry_Site_Capacite.Maximum_Capacite AS GI3_V_CAPC_MAXM_BATM, " +
                                             "dbo_GI3_ADRESSE.GI3_A_ADRS_LIGN_1 AS GI3_A_ADRS_LIGN_1, " +
                                             "dbo_GI3_ADRESSE.GI3_NM_REG_ADMN AS GI3_NM_REG_ADMN, " +
                                             "dbo_GI3_ADRESSE.GI3_C_POST AS GI3_C_POST, " +
                                             "dbo_GI3_ADRESSE.GI3_NM_MUNC AS GI3_NM_MUNC " +
                                      "FROM   ((((([SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] as dbo_GI3_SITE_COMPOSANTE " +
                                              "LEFT JOIN ([SDGIC01].[dbo].[GI3_ADRESSE] as dbo_GI3_ADRESSE " +
                                              "RIGHT JOIN [SDDMU01].[dbo].[SAIS_Lien_Site_Adresse_Principale] as Lien_Site_Adresse_Principale ON dbo_GI3_ADRESSE.GI3_C_ROWD_ADRS = Lien_Site_Adresse_Principale.[GI3_C_ROWD_ADRS]) " +
                                                     "ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = Lien_Site_Adresse_Principale.GI3_C_ROWD_SITE) " +
                                              "INNER JOIN [SDDMU01].[dbo].[SAIS_Intervention_Maitre_SADMIN] as Intervention_Maitre_SADMIN ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = Intervention_Maitre_SADMIN.GI3_C_ROWD_SITE) " +
                                              "INNER JOIN (SELECT dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE, " +
                                                                 "dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_D_FIN, " +
                                                                 "dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR, " +
                                                                 "dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_V_NUMR_ATTR AS Aire " +
                                                          "FROM (([SDGIC01].[dbo].[GI3_ATTRIBUTS_SITE_COMP_VALEURS] as dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS " +
                                                                  "INNER JOIN[SDGIC01].[dbo].[GI3_ATTRIBUTS_SITE_COMPOSANTE] as dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE ON dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_C_ROWD_ATTR_SITE_COMP = dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_ATTR_SITE_COMP) " +
                                                                  "INNER JOIN[SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE) " +
                                                                  "INNER JOIN[SDDMU01].[dbo].[SAIS_Intervention_Maitre_SADMIN] as Intervention_Maitre_SADMIN ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = Intervention_Maitre_SADMIN.GI3_C_ROWD_SITE " +
                                                          "WHERE  (((dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_D_FIN)Is Null) AND((dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR) = 'Aire (m2)'))) sQry_Site_Aire ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = sQry_Site_Aire.GI3_C_ROWD_SITE) " +
                                              "INNER JOIN(SELECT dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE, " +
                                                                "dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_D_FIN, " +
                                                                "dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR, " +
                                                                "dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_V_NUMR_ATTR AS Maximum_Capacite " +
                                                         "FROM (([SDGIC01].[dbo].[GI3_ATTRIBUTS_SITE_COMP_VALEURS] as dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS " +
                                                                 "INNER JOIN [SDGIC01].[dbo].[GI3_ATTRIBUTS_SITE_COMPOSANTE] as dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE ON dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_C_ROWD_ATTR_SITE_COMP = dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_ATTR_SITE_COMP) " +
                                                                 "INNER JOIN [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE) " +
                                                                 "INNER JOIN [SDDMU01].[dbo].[SAIS_Intervention_Maitre_SADMIN] as Intervention_Maitre_SADMIN ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = Intervention_Maitre_SADMIN.GI3_C_ROWD_SITE " +
                                                         "WHERE  (((dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_D_FIN)Is Null) AND((dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR) = 'Capacité'))) sQry_Site_Capacite ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = sQry_Site_Capacite.GI3_C_ROWD_SITE) " +
                                              "INNER JOIN(SELECT dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE, " +
                                                                "dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_D_FIN, " +
                                                                "dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR, " +
                                                                "dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_V_TEXT_ATTR AS CodeQualif " +
                                                         "FROM (([SDGIC01].[dbo].[GI3_ATTRIBUTS_SITE_COMP_VALEURS] as dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS " +
                                                                 "INNER JOIN [SDGIC01].[dbo].[GI3_ATTRIBUTS_SITE_COMPOSANTE] as dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE ON dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_C_ROWD_ATTR_SITE_COMP = dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_ATTR_SITE_COMP) " +
                                                                 "INNER JOIN [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE) " +
                                                                 "INNER JOIN [SDDMU01].[dbo].[SAIS_Intervention_Maitre_SADMIN] as Intervention_Maitre_SADMIN ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = Intervention_Maitre_SADMIN.GI3_C_ROWD_SITE " +
                                                         "WHERE  (((dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_D_FIN)Is Null) AND((dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR) = 'Code de qualification' Or(dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR) = 'Code de qualification principal')) " +
                                                         ") sQry_Site_CodeQualif ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = sQry_Site_CodeQualif.GI3_C_ROWD_SITE) " +
                                              "INNER JOIN(SELECT dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE, " +
                                                                "dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_D_FIN, " +
                                                                "dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR, " +
                                                                "dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_V_NUMR_ATTR AS NbEtage " +
                                                          "FROM (([SDGIC01].[dbo].[GI3_ATTRIBUTS_SITE_COMP_VALEURS] as dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS " +
                                                                "INNER JOIN [SDGIC01].[dbo].[GI3_ATTRIBUTS_SITE_COMPOSANTE] as dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE ON dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_C_ROWD_ATTR_SITE_COMP = dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_ATTR_SITE_COMP) " +
                                                                "INNER JOIN [SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] as dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_C_ROWD_SITE = dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE) " +
                                                                "INNER JOIN [SDDMU01].[dbo].[SAIS_Intervention_Maitre_SADMIN] as Intervention_Maitre_SADMIN ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = Intervention_Maitre_SADMIN.GI3_C_ROWD_SITE " +
                                                          "WHERE(((dbo_GI3_ATTRIBUTS_SITE_COMPOSANTE.GI3_D_FIN)Is Null) AND((dbo_GI3_ATTRIBUTS_SITE_COMP_VALEURS.GI3_NM_ATTR) = 'Nb étages'))) sQry_Site_NbEtage ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = sQry_Site_NbEtage.GI3_C_ROWD_SITE " +
                                      "where dbo_GI3_ADRESSE.GI3_D_CRET = (select max(GI3_D_CRET) as GI3_D_CRET " +
                                                                          "from   [SDGIC01].[dbo].[GI3_ADRESSE] as rest, " +
                                                                                 "[SDDMU01].[dbo].[SAIS_Lien_Site_Adresse_Principale] as Lien " +
                                                                          "where lien.GI3_C_ROWD_SITE = Lien_Site_Adresse_Principale.GI3_C_ROWD_SITE " +
                                                                          "and   rest.[GI3_C_ROWD_ADRS] = lien.[GI3_C_ROWD_ADRS]) " +
                                      "or  0 = ( select count(1) " +
                                                "from [SDGIC01].[dbo].[GI3_ADRESSE] as rest, " +
                                                    "[SDDMU01].[dbo].[SAIS_Lien_Site_Adresse_Principale] as Lien " +
                                                "where lien.GI3_C_ROWD_SITE = Lien_Site_Adresse_Principale.GI3_C_ROWD_SITE " +
                                                "and   rest.[GI3_C_ROWD_ADRS] = lien.[GI3_C_ROWD_ADRS]) " +
                                      "order by 1";

                string Etape = "Select";

                InsertTableLogPlanificateur("SaisLot", "req_SITE_Ajout");

                majSAIS_Intervention_Maitre_SADMIN();
                majSAIS_Lien_Site_Adresse_Principale();
                ExecuteSQL("req_SITE_Ajout", strSqlDelete.ToString());

                SqlConnection mySQLConnectionMaj = Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction) as SqlConnection;
                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                {
                    conn.Open();
                    using (OleDbTransaction transaction = conn.BeginTransaction())
                    {
                        try
                        {

                            SqlCommand commandDataReader = new SqlCommand(sqlCmdSelect, mySQLConnectionMaj);
                            commandDataReader.CommandTimeout = 12000;
                            SqlDataReader ValueReader = commandDataReader.ExecuteReader();
                            OleDbCommand SQLCommandExec = new OleDbCommand("INSERT", conn, transaction);

                            Etape = "Insert";

                            while (ValueReader.Read())
                            {
                                strSql = "insert into Site_Ajout ( GI3_C_ROWD_SITE, GI3_N_SITE, GI3_C_QUAL, GI3_Q_ETAG_BATM, GI3_V_AIRE_BATM, GI3_V_CAPC_MAXM_BATM, GI3_A_ADRS_LIGN_1, GI3_NM_REG_ADMN, GI3_C_POST, GI3_NM_MUNC ) " +
                                                "values('" + ValueReader["GI3_C_ROWD_SITE"].ToString() + "', '" +
                                                             ValueReader["GI3_N_SITE"].ToString() + "', '" +
                                                             ValueReader["GI3_C_QUAL"].ToString() + "', '" +
                                                             ValueReader["GI3_Q_ETAG_BATM"].ToString() + "', '" +
                                                             ValueReader["GI3_V_AIRE_BATM"].ToString() + "', '" +
                                                             ValueReader["GI3_V_CAPC_MAXM_BATM"].ToString() + "', '" +
                                                             ValueReader["GI3_A_ADRS_LIGN_1"].ToString().Replace("'", "''") + "', '" +
                                                             ValueReader["GI3_NM_REG_ADMN"].ToString().Replace("'", "''") + "', '" +
                                                             ValueReader["GI3_C_POST"].ToString() + "', '" +
                                                             ValueReader["GI3_NM_MUNC"].ToString().Replace("'", "''") + "')";
                                strSqlRequete = strSql.ToString().Replace(", '',", ", null,").Replace(", '',", ", null,");
                                SQLCommandExec.CommandType = CommandType.Text;
                                SQLCommandExec.CommandText = strSqlRequete.ToString();
                                SQLCommandExec.CommandTimeout = 12000;
                                SQLCommandExec.ExecuteNonQuery();
                            }

                            transaction.Commit();
                            ValueReader.Close();
                        }
                        catch (Exception ex)
                        {
                            //MessageBox.Show(ex.Message);
                            InsertTableLogJobPlanificateur("req_SITE_Ajout(" + Etape + ")", ex.Message.ToString());
                            LoadTableErreur = true;
                        }
                    }
                    conn.Close();
                }

                mySQLConnectionMaj.Close();
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute la requête "req_Intervention_Ajout" de l'ancien système 
