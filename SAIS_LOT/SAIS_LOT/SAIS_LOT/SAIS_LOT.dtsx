														   "WHERE  (((tbl_INTERVENTIONS.DE_DOMN_INTRVT) = 'AP - Appareil sous-pression'))";

		public const string Qry_DICC_Rouge = "UPDATE tbl_INTERVENTIONS SET tbl_INTERVENTIONS.Couleur = 255 " +
											 "WHERE  (((tbl_INTERVENTIONS.DIRECTION) = 'DICC' " +
											 "Or       (tbl_INTERVENTIONS.DIRECTION) = 'DESP') " +
											 "AND     ((tbl_INTERVENTIONS.C_TYPE_INTRVT) = '05')) " +
											 "OR     (((tbl_INTERVENTIONS.DIRECTION) = 'DICC' " +
											 "Or       (tbl_INTERVENTIONS.DIRECTION) = 'DESP') " +
											 "AND     ((tbl_INTERVENTIONS.C_COTE_PRIR_INTR) = '1'))";

		public const string Qry_DICC_Jaune = "UPDATE tbl_INTERVENTIONS SET tbl_INTERVENTIONS.Couleur = 65535 " +
											 "WHERE  (((tbl_INTERVENTIONS.DIRECTION) = 'DICC' " +
											  "Or      (tbl_INTERVENTIONS.DIRECTION) = 'DESP') " +
											  "AND    ((Right([N_INTRVT],2)) = '-1' " +
											  "Or      (Right([N_INTRVT],2)) = '-2' " +
											  "Or      (Right([N_INTRVT],2)) = '-3')) " +
											  "OR    (((tbl_INTERVENTIONS.DIRECTION) = 'DICC' " +
											  "Or      (tbl_INTERVENTIONS.DIRECTION) = 'DESP') " +
											  "AND    ((tbl_INTERVENTIONS.C_COTE_PRIR_INTR) <> '1') " +
											  "AND    ((tbl_INTERVENTIONS.C_TYPE_INTRVT) = '03' " +
											  "Or      (tbl_INTERVENTIONS.C_TYPE_INTRVT) = '04' " +
											  "Or      (tbl_INTERVENTIONS.C_TYPE_INTRVT) = '14'))";

