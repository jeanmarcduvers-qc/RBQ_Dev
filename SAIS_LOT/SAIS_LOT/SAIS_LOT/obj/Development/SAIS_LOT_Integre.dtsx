                        commandDataReader = new OleDbCommand(sqlCmd, conn);
                        ValueReader = commandDataReader.ExecuteReader();

                        while (ValueReader.Read())
                        {
                            if (string.IsNullOrEmpty(ValueReader["Min_Delai_Ref"].ToString()))
                            {
                                Delai_Ref_Min = 0;
                            }
                            else
                            {
                                Delai_Ref_Min = long.Parse(ValueReader["Min_Delai_Ref"].ToString());
                            }

                            if (string.IsNullOrEmpty(ValueReader["Max_Delai_Ref"].ToString()))
                            {
