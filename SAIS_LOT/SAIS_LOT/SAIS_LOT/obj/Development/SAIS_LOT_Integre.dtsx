																 "INTERVENTION_N_ATT_DESP_Critères.C_VILLE_SITE, INTERVENTION_N_ATT_DESP_Critères.REGION, INTERVENTION_N_ATT_DESP_Critères.SOUS_REGION, " +
																 "INTERVENTION_N_ATT_DESP_Critères.[Q_ ETAG_BATM], INTERVENTION_N_ATT_DESP_Critères.V_AIRE_BATM, INTERVENTION_N_ATT_DESP_Critères.V_CAPC_MAXM_BATM, " +
																 "INTERVENTION_N_ATT_DESP_Critères.NM_INTRVN, INTERVENTION_N_ATT_DESP_Critères.C_ETAP_ACTL, INTERVENTION_N_ATT_DESP_Critères.CRITICITE_INTRVT, " +
