							"INTERVENTION_N_ATT_DICC_Critères.S_INTRVT, INTERVENTION_N_ATT_DICC_Critères.C_RISQ, INTERVENTION_N_ATT_DICC_Critères.DE_DOMN_INTRVT, " +
							"INTERVENTION_N_ATT_DICC_Critères.CATEGORIE, INTERVENTION_N_ATT_DICC_Critères.D_CRET_DEMN, INTERVENTION_N_ATT_DICC_Critères.D_RECEPTION_DEMN, " +
