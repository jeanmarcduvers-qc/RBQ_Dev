            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute la requête "Qry_MAJ_SousRegion_tbl_Interventions" de l'ancien système 
            ///
            /////////////////////////////////////////////////////////////////////
            void Qry_MAJ_SousRegion_tbl_Interventions()
            {
                string strRegion = "";
                string strSqlRequete;
                string sqlCmdSelectRegion = "Select distinct region as region from tbl_INTERVENTIONS where region is not null ";
                string sqlCmdUpdate = "UPDATE (( (select N_INTRVT, Left([C_CODPOST_SITE],3) AS PrefixeCP, REGION " +
                                                                                "from tbl_INTERVENTIONS " +
                                                                                "where region = 'strRegion') sQry_INTERVENTION_PrefixeCodePostal " +
                                                                        "INNER JOIN tbl_INTERVENTIONS ON sQry_INTERVENTION_PrefixeCodePostal.N_INTRVT = tbl_INTERVENTIONS.N_INTRVT) " +
                                                                        "LEFT JOIN tbl_SousRegionMontreal ON sQry_INTERVENTION_PrefixeCodePostal.PrefixeCP = tbl_SousRegionMontreal.PrefixeCP) " +
                                                                        "LEFT JOIN tbl_Regions ON sQry_INTERVENTION_PrefixeCodePostal.PrefixeCP = tbl_Regions.PrefixeCP " +
                                                                    "SET tbl_INTERVENTIONS.SOUS_REGION = IIf(IsNull([sQry_INTERVENTION_PrefixeCodePostal].[REGION]),[tbl_Regions].[Région],[sQry_INTERVENTION_PrefixeCodePostal].[REGION] + IIf(Not IsNull([tbl_SousRegionMontreal].[PrefixeCP]),' - ' + [tbl_SousRegionMontreal].[DivisionRBQ],''))";

                string Etape = "Select";

                InsertTableLogPlanificateur("SaisLot", "Qry_MAJ_SousRegion_tbl_Interventions");

                using (var connRegion = new OleDbConnection(strConnectBdAccess.ToString()))
                {
                    connRegion.Open();

                    try
                    {
                        OleDbCommand commandDataReader = new OleDbCommand(sqlCmdSelectRegion, connRegion);
                        OleDbDataReader ValueReader = commandDataReader.ExecuteReader();

                        Etape = "Update";

                        while (ValueReader.Read())
                        {
                            using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                            {
                                conn.Open();
                                using (OleDbTransaction transaction = conn.BeginTransaction())
                                {
                                    OleDbCommand OleDbCommandExec = new OleDbCommand("UPDATE", conn, transaction);
                                    strRegion = ValueReader["region"].ToString();
                                    strSqlRequete = sqlCmdUpdate.ToString().Replace("strRegion", ValueReader["region"].ToString());
                                    OleDbCommandExec.CommandType = CommandType.Text;
                                    OleDbCommandExec.CommandText = strSqlRequete.ToString();
                                    OleDbCommandExec.CommandTimeout = 12000;
                                    OleDbCommandExec.ExecuteNonQuery();
                                    transaction.Commit();
                                    conn.Close();
                                }
                            }
                        }
                        ValueReader.Close();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("Qry_MAJ_SousRegion_tbl_Interventions(" + Etape + " :: " + strRegion.ToString() + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                    }
                    connRegion.Close();
                }
            }

