		public const string Qry_Regrp_Categ_DESP_P2_DNC = "UPDATE INTERVENTION_N_ATT_DESP SET INTERVENTION_N_ATT_DESP.CATEGORIE = 'P2' " +
														  "WHERE  (((INTERVENTION_N_ATT_DESP.CATEGORIE) Is Null) " +
														  "AND     ((Right([N_INTRVT],2)) = '-1' " +
														  "Or       (Right([N_INTRVT],2)) = '-2' " +
														  "Or       (Right([N_INTRVT],2)) = '-3') " +
														  "AND     ((INTERVENTION_N_ATT_DESP.S_INTRVT) = 'En cours') " +
														  "AND     ((INTERVENTION_N_ATT_DESP.C_ETAP_ACTL) = 'Délai échu / CV' " +
														  "Or       (INTERVENTION_N_ATT_DESP.C_ETAP_ACTL) = 'CV suppl à effectuer' " +
														  "Or       (INTERVENTION_N_ATT_DESP.C_ETAP_ACTL) = 'CV à effectuer'))";

		public const string Qry_Regrp_Categ_DESP_P2 = "UPDATE INTERVENTION_N_ATT_DESP SET INTERVENTION_N_ATT_DESP.CATEGORIE = 'P2' " +
													  "WHERE  (((INTERVENTION_N_ATT_DESP.CATEGORIE) Is Null) " +
													  "AND     ((INTERVENTION_N_ATT_DESP.S_INTRVT) <> 'Non débutée'))";

		public const string Qry_Regrp_Categ_DESP_P1 = "UPDATE INTERVENTION_N_ATT_DESP SET INTERVENTION_N_ATT_DESP.CATEGORIE = 'P1' " +
													  "WHERE  (((INTERVENTION_N_ATT_DESP.CATEGORIE) Is Null) " +
													  "AND     ((INTERVENTION_N_ATT_DESP.C_TYPE_INTRVT) = '05'))";

		public const string Qry_Regrp_Categ_DESP_P3_1 = "UPDATE INTERVENTION_N_ATT_DESP SET INTERVENTION_N_ATT_DESP.CATEGORIE = 'P3' " +
														"WHERE  (((INTERVENTION_N_ATT_DESP.CATEGORIE) Is Null) " +
														"AND     ((INTERVENTION_N_ATT_DESP.C_TYPE_INTRVT) = '03' " +
														"Or       (INTERVENTION_N_ATT_DESP.C_TYPE_INTRVT) = '01') " +
														"AND     ((INTERVENTION_N_ATT_DESP.DE_DOMN_INTRVT) = 'AP - Appareil sous-pression') " +
														"AND     ((INTERVENTION_N_ATT_DESP.N_REGR) = '001' " +
														"Or       (INTERVENTION_N_ATT_DESP.N_REGR) = '020' " +
														"Or       (INTERVENTION_N_ATT_DESP.N_REGR) = '021' " +
														"Or       (INTERVENTION_N_ATT_DESP.N_REGR) = '050'))";

		public const string Qry_Regrp_Categ_DESP_P3_2 = "UPDATE INTERVENTION_N_ATT_DESP INNER JOIN tbl_Condition_DESP " +
																"ON  (INTERVENTION_N_ATT_DESP.N_REGR = tbl_Condition_DESP.Regroupement) " +
																"AND (INTERVENTION_N_ATT_DESP.C_TYPE_INTRVT = tbl_Condition_DESP.Type_Intrvt) " +
														"SET   INTERVENTION_N_ATT_DESP.CATEGORIE = 'P3' " +
														"WHERE (((INTERVENTION_N_ATT_DESP.CATEGORIE) Is Null) " +
														"AND ((INTERVENTION_N_ATT_DESP.C_TYPE_INTRVT) = '03' " +
														"Or   (INTERVENTION_N_ATT_DESP.C_TYPE_INTRVT) = '01') " +
														"AND ((INTERVENTION_N_ATT_DESP.DE_DOMN_INTRVT) = 'AP - Appareil sous-pression') " +
														"AND ((INTERVENTION_N_ATT_DESP.N_REGR) = '001' " +
														"Or   (INTERVENTION_N_ATT_DESP.N_REGR) = '020' " +
														"Or   (INTERVENTION_N_ATT_DESP.N_REGR) = '021' " +
														"Or   (INTERVENTION_N_ATT_DESP.N_REGR) = '029' " +
														"Or   (INTERVENTION_N_ATT_DESP.N_REGR) = '032'))";

		public const string Qry_Regrp_Categ_DESP_P4 = "UPDATE INTERVENTION_N_ATT_DESP INNER JOIN tbl_Condition_DESP " +
															  "ON  (INTERVENTION_N_ATT_DESP.N_REGR = tbl_Condition_DESP.Regroupement) " +
															  "AND (INTERVENTION_N_ATT_DESP.C_TYPE_INTRVT = tbl_Condition_DESP.Type_Intrvt) " +
													  "SET    INTERVENTION_N_ATT_DESP.CATEGORIE = 'P4' " +
													  "WHERE  (((INTERVENTION_N_ATT_DESP.CATEGORIE) Is Null) " +
													  "AND     ((INTERVENTION_N_ATT_DESP.C_TYPE_INTRVT) = '04' " +
													  "Or       (INTERVENTION_N_ATT_DESP.C_TYPE_INTRVT) = '11' " +
													  "Or       (INTERVENTION_N_ATT_DESP.C_TYPE_INTRVT) = '12' " +
													  "Or       (INTERVENTION_N_ATT_DESP.C_TYPE_INTRVT) = '01' " +
													  "Or       (INTERVENTION_N_ATT_DESP.C_TYPE_INTRVT) = '02' " +
													  "Or       (INTERVENTION_N_ATT_DESP.C_TYPE_INTRVT) = '10') " +
													  "AND     ((INTERVENTION_N_ATT_DESP.DE_DOMN_INTRVT) = 'AP - Appareil sous-pression'))";

		public const string req_Regrp_Categ_DESP_P5_Sans_Categ = "UPDATE INTERVENTION_N_ATT_DESP SET INTERVENTION_N_ATT_DESP.CATEGORIE = 'P5' " +
																 "WHERE  (((INTERVENTION_N_ATT_DESP.CATEGORIE) Is Null))";

		public const string Qry_P1_DESP_Min_Max = "SELECT Min(IIf(IsNull([D_RECEPTION_DEMN]), [D_CRET], [D_RECEPTION_DEMN])) AS Min_P1, " +
														 "Max(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Max_P1 " +
												  "FROM  INTERVENTION_N_ATT_DESP " +
												  "GROUP BY INTERVENTION_N_ATT_DESP.CATEGORIE " +
												  "HAVING (((INTERVENTION_N_ATT_DESP.CATEGORIE) = 'P1'))";

		public const string Qry_P3_DESP_Min_Max = "SELECT Min(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Min_P3, " +
														 "Max(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Max_P3 " +
												  "FROM  INTERVENTION_N_ATT_DESP " +
												  "GROUP BY INTERVENTION_N_ATT_DESP.CATEGORIE " +
												  "HAVING  (((INTERVENTION_N_ATT_DESP.CATEGORIE) = ' P3'))";

		public const string Qry_P4_DESP_Min_Max = "SELECT Min(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Min_P4, " +
														 "Max(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Max_P4 " +
												  "FROM  INTERVENTION_N_ATT_DESP " +
												  "GROUP BY INTERVENTION_N_ATT_DESP.CATEGORIE " +
												  "HAVING   (((INTERVENTION_N_ATT_DESP.CATEGORIE) = 'P4'))";

		public const string Qry_Delai_Ref_Min_Max_DESP = "SELECT Min(IIf(Not IsNull([D_CRET_NON_CONFORMITE]), DateDiff('d',#10/20/2017#, DateAdd('d',iif(isnull([V_DELA]), 0, [V_DELA]), [D_CRET_NON_CONFORMITE])))) AS Min_Delai_Ref, " +
																"Max(IIf(Not IsNull([D_CRET_NON_CONFORMITE]), DateDiff('d',#10/20/2017#, DateAdd('d',iif(isnull([V_DELA]), 0, [V_DELA]), [D_CRET_NON_CONFORMITE])))) AS Max_Delai_Ref " +
														 "FROM   INTERVENTION_N_ATT_DESP";

		public const string req_INTERVENTION_N_ATT_DESP = "SELECT N_INTRVT, C_INTRVN, D_CRET, CRITICITE_INTRVN, CRITICITE_CODE_QUALIF_SITE, CRITICITE_INTRVT, CATEGORIE, D_RECEPTION_DEMN, " +
																 "C_COD_QUALF_SITE, V_DELA, D_CRET_NON_CONFORMITE FROM INTERVENTION_N_ATT_DESP";

		public const string req_Supp_INTERVENTION_N_ATT_DIS_Critères = "DELETE INTERVENTION_N_ATT_DIS_Critères.N_INTRVT FROM INTERVENTION_N_ATT_DIS_Critères";
		//visite
		public const string req_Interv_N_ATT_DIS_Critère_Creer = "INSERT INTO INTERVENTION_N_ATT_DIS_Critères (N_INTRVT, N_SITE, N_DEMN, C_INTRVN, " +
																												"C_INTRVT, D_CRET, D_OUVE_INTRVT, C_CODE_INTRVT, " +
																												"C_TYPE_INTRVT, C_DE_TYPE_INTRVT, N_REGR, " +
																												"C_DE_REGR, S_INTRVT, C_RISQ, DE_DOMN_INTRVT, " +
																												"CATEGORIE, D_CRET_DEMN, D_RECEPTION_DEMN, " +
																												"D_CRET_NOTE, C_SUJT_NOTE_INTR, C_SOUS_SUJT_NOTE, " +
																												"DE_NOTE, C_ADRE_SITE, C_CODPOST_SITE, " +
																												"C_COD_QUALF_SITE, C_DESC_COD_QUALF_SITE, C_VILLE_SITE, " +
																												"REGION, SOUS_REGION, [Q_ ETAG_BATM], " +
																												"V_AIRE_BATM, V_CAPC_MAXM_BATM, NM_INTRVN, " +
																												"C_ETAP_ACTL, CRITICITE_INTRVT, CRITICITE_SITE, " +
																												"CRITICITE_INTRVN, D_CRET_NON_CONFORMITE, V_DELA, " +
																												"D_ATTRIBUTION_INTRVT, CRITICITE_CODE_QUALIF_SITE, SELECT_DOSSIER, " +
																												"NM_ENDR, N_INTRL, D_CONFIRMATION_ATTRIB, " +
																												"DIRECTION, USER_ATTRIB, Aj_30, Date_Ech_Non_Conf )" +
																  "SELECT INTERVENTION_N_ATT.N_INTRVT, INTERVENTION_N_ATT.N_SITE, INTERVENTION_N_ATT.N_DEMN, INTERVENTION_N_ATT.C_INTRVN, " +
																		"INTERVENTION_N_ATT.C_INTRVT, INTERVENTION_N_ATT.D_CRET, INTERVENTION_N_ATT.D_OUVE_INTRVT, INTERVENTION_N_ATT.C_CODE_INTRVT, " +
																		"INTERVENTION_N_ATT.C_TYPE_INTRVT, INTERVENTION_N_ATT.C_DE_TYPE_INTRVT, INTERVENTION_N_ATT.N_REGR, " +
																		"INTERVENTION_N_ATT.C_DE_REGR, INTERVENTION_N_ATT.S_INTRVT, INTERVENTION_N_ATT.C_RISQ, INTERVENTION_N_ATT.DE_DOMN_INTRVT, " +
																		"INTERVENTION_N_ATT.CATEGORIE, INTERVENTION_N_ATT.D_CRET_DEMN, INTERVENTION_N_ATT.D_RECEPTION_DEMN, " +
																		"INTERVENTION_N_ATT.D_CRET_NOTE, INTERVENTION_N_ATT.C_SUJT_NOTE_INTR, INTERVENTION_N_ATT.C_SOUS_SUJT_NOTE, " +
																		"INTERVENTION_N_ATT.DE_NOTE, INTERVENTION_N_ATT.C_ADRE_SITE, INTERVENTION_N_ATT.C_CODPOST_SITE, " +
																		"INTERVENTION_N_ATT.C_COD_QUALF_SITE, INTERVENTION_N_ATT.C_DESC_COD_QUALF_SITE, INTERVENTION_N_ATT.C_VILLE_SITE, " +
																		"INTERVENTION_N_ATT.REGION, INTERVENTION_N_ATT.SOUS_REGION, INTERVENTION_N_ATT.[Q_ ETAG_BATM], " +
																		"INTERVENTION_N_ATT.V_AIRE_BATM, INTERVENTION_N_ATT.V_CAPC_MAXM_BATM, INTERVENTION_N_ATT.NM_INTRVN, " +
																		"INTERVENTION_N_ATT.C_ETAP_ACTL, INTERVENTION_N_ATT.CRITICITE_INTRVT, INTERVENTION_N_ATT.CRITICITE_SITE, " +
																		"INTERVENTION_N_ATT.CRITICITE_INTRVN, INTERVENTION_N_ATT.D_CRET_NON_CONFORMITE, INTERVENTION_N_ATT.V_DELA, " +
																		"INTERVENTION_N_ATT.D_ATTRIBUTION_INTRVT, INTERVENTION_N_ATT.CRITICITE_CODE_QUALIF_SITE, INTERVENTION_N_ATT.SELECT_DOSSIER, " +
																		"INTERVENTION_N_ATT.NM_ENDR, INTERVENTION_N_ATT.N_INTRL, INTERVENTION_N_ATT.D_CONFIRMATION_ATTRIB, " +
																		"'DIS' AS DIRECTION, INTERVENTION_N_ATT.USER_ATTRIB, " +
																		"IIf(IsNull([INTERVENTION_N_ATT].[DE_NOTE]), -1, DateDiff('d', DateAdd('d', 30, Date()), CDate(Mid([INTERVENTION_N_ATT].[DE_NOTE],6,2) + '/' + Right(Left([INTERVENTION_N_ATT].[DE_NOTE],10),2) + '/' + Left([INTERVENTION_N_ATT].[DE_NOTE],4)))) AS Aj_30, " +
																		"IIf(Not IsNull([INTERVENTION_N_ATT].[D_CRET_NON_CONFORMITE]), DateAdd('d', [INTERVENTION_N_ATT].[V_DELA], [INTERVENTION_N_ATT].[D_CRET_NON_CONFORMITE])) AS Date_Ech_Non_Conf " +
																  "FROM INTERVENTION_N_ATT " +
																  "WHERE ((S_INTRVT = 'Non débutée' and C_CODE_INTRVT = 'Sécurité') " +
																	"or     (S_INTRVT = 'En cours' and [C_ETAP_ACTL] = 'Visite')) " +
																	"and   (((INTERVENTION_N_ATT.DE_DOMN_INTRVT) <> 'AP - Appareil sous-pression') " +
																	"And     ((INTERVENTION_N_ATT.C_ETAP_ACTL) = 'Visite' Or (INTERVENTION_N_ATT.C_ETAP_ACTL) Is Null) " +
																	"And    (((INTERVENTION_N_ATT.C_CODE_INTRVT) = 'Construction') = False) " +
																	"And    (((INTERVENTION_N_ATT.D_CRET) < #4/1/2016# " +
																	"And      (INTERVENTION_N_ATT.DE_DOMN_INTRVT) = 'AP - Appareil sous-pression') = False) " +
																	"And (((INTERVENTION_N_ATT.DE_DOMN_INTRVT) = 'AP - Appareil sous-pression' " +
																	"And  ((INTERVENTION_N_ATT.C_TYPE_INTRVT) = '01' " +
																	"Or    (INTERVENTION_N_ATT.C_TYPE_INTRVT) = '08' " +
																	"Or    (INTERVENTION_N_ATT.C_TYPE_INTRVT) = '09' " +
																	"Or    (INTERVENTION_N_ATT.C_TYPE_INTRVT) = '11' " +
																	"Or    (INTERVENTION_N_ATT.C_TYPE_INTRVT) = '12' " +
																	"Or    (INTERVENTION_N_ATT.C_TYPE_INTRVT) = '13')) = False) " +
																	"And  ((IsDate(Mid([INTERVENTION_N_ATT].[DE_NOTE],9,2) & '/' & Mid([INTERVENTION_N_ATT].[DE_NOTE],6,2) & '/' & Left([INTERVENTION_N_ATT].[DE_NOTE],4)) " +
																	"Or     IsNull(INTERVENTION_N_ATT.DE_NOTE)) = True) " +
																	"And (((INTERVENTION_N_ATT.DE_DOMN_INTRVT) = 'QT - Qualité de travaux') = False) " +
																	"And (((INTERVENTION_N_ATT.D_CRET) < #4/1/2016# " +
																	"And   (INTERVENTION_N_ATT.S_INTRVT) = 'En cours') = False))";

		public const string req_Supp_INTERVENTION_N_ATT_DIS = "DELETE INTERVENTION_N_ATT_DIS.N_INTRVT FROM INTERVENTION_N_ATT_DIS";

