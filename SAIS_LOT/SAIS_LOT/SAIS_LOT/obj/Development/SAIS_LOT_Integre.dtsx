                                    }
                                    else
                                    {
                                        if (!((DateTime?)ValueReader_INTERVENTION_N_ATT_DESP["D_CRET_NON_CONFORMITE"]).HasValue)
                                        {
                                            Calcul_Crit_intervention = 3 + ((0 - Delai_Ref_Min) / (Delai_Ref_Max - Delai_Ref_Min));
                                            if (Calcul_Crit_intervention < 0)
                                            {
                                                Calcul_Crit_intervention = 3;
                                            }
                                        }
                                        else
                                        {
                                            Calcul_Crit_intervention = 3 + (((((DateTime?)ValueReader_INTERVENTION_N_ATT_DESP["D_CRET_NON_CONFORMITE"]).Value.AddDays(int.Parse(ValueReader_INTERVENTION_N_ATT_DESP["V_DELA"].ToString())) - dtDepart).TotalDays - Delai_Ref_Min) / (Delai_Ref_Max - Delai_Ref_Min));
                                            if (Calcul_Crit_intervention < 0)
