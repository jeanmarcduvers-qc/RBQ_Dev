namespace ST_d85998d1ca1542b0be56049d27ad3490
{
	class RequetesSQL
	{
		public const string delLogJobChargement = "DELETE [SDDMU01].[dbo].[Log_Job_Planificateur] " +
												  "WHERE [IndSystem] = 'SaisLot'";

		public const string tblAfficheErreur = "SELECT [IndSystem], " +
											  "[CodeTraitement], " +
											  "[TypeTraitement], " +
											  "[ErrorMessage] " +
										 "FROM [SDDMU01].[dbo].[Log_Job_Planificateur] " +
										 "WHERE [IndSystem] = 'SaisLot'";

		public const string req_Supp_Intervention_N_ATT = "DELETE INTERVENTION_N_ATT.N_INTRVT FROM INTERVENTION_N_ATT";

		public const string req_Supp_DNC_Intervention = "DELETE DNC_Intervention.GI3_N_INTRVT FROM DNC_Intervention";

		public const string req_SUPP_S_INTRVT_Interv_DNC = "DELETE S_INTRVT_Interv_DNC.GI3_N_INTRVT FROM S_INTRVT_Interv_DNC";

		public const string req_Supp_Interv_S_INTRVT = "DELETE Interv_S_INTRVT.GI3_N_INTRVT FROM Interv_S_INTRVT";

		public const string req_MAJ_Donnees_Debut = "INSERT INTO tbDateDebutFinMAJ ( [Date-Hres_Debut_MAJ] ) " +
															"SELECT Now() AS Ladate " +
															"FROM   tbDateDebutFinMAJ " +
															"GROUP BY Now()";

		public const string Qry_ValidDateCible = @"INSERT INTO tbl_SystemeEvent ( DateEvent, Etape, Description, Erreur ) 
														 select query.DateEvent, query.N_INTRVT, query.description, query.erreur 
														  from  (select Now() AS DateEvent, 
																		INTERVENTION_N_ATT.N_INTRVT, 
																		[C_SOUS_SUJT_NOTE] + 'invalide' AS Description, INTERVENTION_N_ATT.DE_NOTE as Erreur 
																	FROM  INTERVENTION_N_ATT 
																	WHERE (((([C_CODE_INTRVT]) = 'Sécurité' 
																	Or       ([C_CODE_INTRVT]) = 'Loi' 
																	Or       ([C_CODE_INTRVT]) Is Null) = False) 
																	AND   ((([C_CODE_INTRVT]) = 'Règlement' 
																	And     ([DE_DOMN_INTRVT]) <> 'AP - Appareil sous-pression') = False) 
																	AND   ((([D_CRET]) < #4/1/2016# 
																	And     ([DE_DOMN_INTRVT]) = 'AP - Appareil sous-pression') = False) 
																	AND   ((([DE_DOMN_INTRVT]) = 'AP - Appareil sous-pression' 
																	And    (([C_TYPE_INTRVT])  = '02' 
																	Or      ([C_TYPE_INTRVT])  = '03' 
																	Or      ([C_TYPE_INTRVT]) = '04' 
																	Or      ([C_TYPE_INTRVT]) = '05' 
																	Or      ([C_TYPE_INTRVT]) = '08' 
																	Or      ([C_TYPE_INTRVT]) = '09' 
																	Or      ([C_TYPE_INTRVT]) = '10' 
																	Or      ([C_TYPE_INTRVT]) = '13')) = False) 
																	AND  (((([C_TYPE_INTRVT]) = '11' 
																	Or      ([C_TYPE_INTRVT]) = '12') 
																	And     (Val(iif(Isnull([N_REGR]),0, [N_REGR])) >= 170 
																	And      Val(iif(Isnull([N_REGR]),0, [N_REGR]))) <= 173)) = False) 
																	AND  ((([DE_DOMN_INTRVT]) = 'QT - Qualité de travaux') = False) 
																	AND ((iif( isnull(Left([DE_NOTE],10)), True, IsDate(Mid([DE_NOTE],9,2) & '/' & Mid([DE_NOTE],6,2) & '/' & Left([DE_NOTE],4))) = False)) 
																	OR   (((INTERVENTION_N_ATT.DE_NOTE) Is Null) 
																	AND  ((([C_CODE_INTRVT]) = 'Sécurité' 
																	Or     ([C_CODE_INTRVT]) = 'Loi' Or ([C_CODE_INTRVT]) Is Null) = False) 
																	AND  ((([C_CODE_INTRVT]) = 'Règlement' 
																	And    ([DE_DOMN_INTRVT]) <> 'AP - Appareil sous-pression') = False) 
																	AND  ((([D_CRET]) < #4/1/2016# 
																	And    ([DE_DOMN_INTRVT]) = 'AP - Appareil sous-pression') = False) 
																	AND  ((([DE_DOMN_INTRVT]) = 'AP - Appareil sous-pression' 
																	And   (([C_TYPE_INTRVT]) = '02' 
																	Or     ([C_TYPE_INTRVT]) = '03' 
																	Or     ([C_TYPE_INTRVT]) = '04' 
																	Or     ([C_TYPE_INTRVT]) = '05' 
																	Or     ([C_TYPE_INTRVT]) = '08' 
																	Or     ([C_TYPE_INTRVT]) = '09' 
																	Or     ([C_TYPE_INTRVT]) = '10' 
																	Or     ([C_TYPE_INTRVT]) = '13')) = False) 
																	AND (((([C_TYPE_INTRVT]) = '11' 
																	Or     ([C_TYPE_INTRVT]) = '12') 
																	And    (Val(iif(Isnull([N_REGR]),0, [N_REGR])) >= 170 
																	And     Val(iif(Isnull([N_REGR]),0, [N_REGR])) <= 173)) = False) 
																	AND ((([DE_DOMN_INTRVT]) = 'QT - Qualité de travaux') = False))) query 
														   where Erreur is not null";

		public const string req_Supp_INTERVENTION_N_ATT_DICC = "DELETE INTERVENTION_N_ATT_DICC.N_INTRVT FROM INTERVENTION_N_ATT_DICC";
		public const string req_Supp_INTERVENTION_N_ATT_DICC_Critères = "DELETE INTERVENTION_N_ATT_DICC_Critères.N_INTRVT FROM INTERVENTION_N_ATT_DICC_Critères";

		public const string Qry_Interv_N_ATT_DICC_Critère_Creer = "INSERT INTO INTERVENTION_N_ATT_DICC_Critères ( N_INTRVT, N_SITE, N_DEMN, C_INTRVN, C_INTRVT, D_CRET, " +
																												 "D_OUVE_INTRVT, C_CODE_INTRVT, C_TYPE_INTRVT, C_DE_TYPE_INTRVT, " +
																												 "N_REGR, C_DE_REGR, S_INTRVT, C_RISQ, DE_DOMN_INTRVT, CATEGORIE, " +
																												 "D_CRET_DEMN, D_RECEPTION_DEMN, D_CRET_NOTE, C_SUJT_NOTE_INTR, C_SOUS_SUJT_NOTE, " +
																												 "DE_NOTE, C_ADRE_SITE, C_CODPOST_SITE, C_COD_QUALF_SITE, " +
																												 "C_DESC_COD_QUALF_SITE, C_VILLE_SITE, REGION, SOUS_REGION, " +
																												 "[Q_ ETAG_BATM], V_AIRE_BATM, V_CAPC_MAXM_BATM, NM_INTRVN, " +
																												 "C_ETAP_ACTL, CRITICITE_INTRVT, CRITICITE_SITE, CRITICITE_INTRVN, " +
																												 "D_CRET_NON_CONFORMITE, V_DELA, D_ATTRIBUTION_INTRVT, CRITICITE_CODE_QUALIF_SITE, " +
																												 "SELECT_DOSSIER, NM_ENDR, N_INTRL, D_CONFIRMATION_ATTRIB, DIRECTION, " +
																												 "USER_ATTRIB, Aj_30, Aj_365, Date_Ech_Non_Conf" +
																												 " ) " +
																		  "SELECT INTERVENTION_N_ATT.N_INTRVT, INTERVENTION_N_ATT.N_SITE, INTERVENTION_N_ATT.N_DEMN, " +
																		  "INTERVENTION_N_ATT.C_INTRVN, INTERVENTION_N_ATT.C_INTRVT, INTERVENTION_N_ATT.D_CRET, " +
																		  "INTERVENTION_N_ATT.D_OUVE_INTRVT, INTERVENTION_N_ATT.C_CODE_INTRVT, INTERVENTION_N_ATT.C_TYPE_INTRVT, " +
																		  "INTERVENTION_N_ATT.C_DE_TYPE_INTRVT, INTERVENTION_N_ATT.N_REGR, INTERVENTION_N_ATT.C_DE_REGR, " +
																		  "INTERVENTION_N_ATT.S_INTRVT, INTERVENTION_N_ATT.C_RISQ, INTERVENTION_N_ATT.DE_DOMN_INTRVT, " +
																		  "INTERVENTION_N_ATT.CATEGORIE, INTERVENTION_N_ATT.D_CRET_DEMN, INTERVENTION_N_ATT.D_RECEPTION_DEMN, " +
																		  "INTERVENTION_N_ATT.D_CRET_NOTE, INTERVENTION_N_ATT.C_SUJT_NOTE_INTR, INTERVENTION_N_ATT.C_SOUS_SUJT_NOTE, " +
																		  "INTERVENTION_N_ATT.DE_NOTE, INTERVENTION_N_ATT.C_ADRE_SITE, INTERVENTION_N_ATT.C_CODPOST_SITE, " +
																		  "INTERVENTION_N_ATT.C_COD_QUALF_SITE, INTERVENTION_N_ATT.C_DESC_COD_QUALF_SITE, " +
																		  "INTERVENTION_N_ATT.C_VILLE_SITE, INTERVENTION_N_ATT.REGION, INTERVENTION_N_ATT.SOUS_REGION, " +
																		  "INTERVENTION_N_ATT.[Q_ ETAG_BATM], INTERVENTION_N_ATT.V_AIRE_BATM, INTERVENTION_N_ATT.V_CAPC_MAXM_BATM, " +
																		  "INTERVENTION_N_ATT.NM_INTRVN, INTERVENTION_N_ATT.C_ETAP_ACTL, INTERVENTION_N_ATT.CRITICITE_INTRVT, " +
																		  "INTERVENTION_N_ATT.CRITICITE_SITE, INTERVENTION_N_ATT.CRITICITE_INTRVN, INTERVENTION_N_ATT.D_CRET_NON_CONFORMITE, " +
																		  "INTERVENTION_N_ATT.V_DELA, INTERVENTION_N_ATT.D_ATTRIBUTION_INTRVT, INTERVENTION_N_ATT.CRITICITE_CODE_QUALIF_SITE, " +
																		  "INTERVENTION_N_ATT.SELECT_DOSSIER, INTERVENTION_N_ATT.NM_ENDR, INTERVENTION_N_ATT.N_INTRL, " +
																		  "INTERVENTION_N_ATT.D_CONFIRMATION_ATTRIB, 'DICC' AS DIRECTION, INTERVENTION_N_ATT.USER_ATTRIB, " +
																		  "IIf(IsNull(ltrim([DE_NOTE])),-1, DateDiff('d', DateAdd('d',30, Date()),CDate(Mid(ltrim([DE_NOTE]),6,2) + '/' + Right(Left(ltrim([DE_NOTE]),10),2) + '/' + Left(ltrim([DE_NOTE]),4)))) AS Aj_30, " +
																		  "iIf(IsNull(ltrim([DE_NOTE])),1, DateDiff('d', DateAdd('d', -365, Date()), CDate(Mid(ltrim([DE_NOTE]), 6, 2) + '/' + Right(Left(ltrim([DE_NOTE]), 10), 2) + '/' + Left(ltrim([DE_NOTE]),4)))) AS Aj_365, " +
																		  "iIf(Not IsNull([D_CRET_NON_CONFORMITE]), DateAdd('d',[V_DELA],[D_CRET_NON_CONFORMITE])) AS Date_Ech_Non_Conf " +
																	"FROM  INTERVENTION_N_ATT " +
																	"WHERE (((INTERVENTION_N_ATT.DE_DOMN_INTRVT) <> 'AP - Appareil sous-pression') " +
																	"AND   ((([C_CODE_INTRVT]) = 'Sécurité' " +
																	"Or      ([C_CODE_INTRVT]) = 'Loi' " +
																	"Or      ([C_CODE_INTRVT]) Is Null) = False ) " +
																	"AND   ((([C_CODE_INTRVT]) = 'Règlement' " +
																	"And     ([DE_DOMN_INTRVT]) <> 'AP - Appareil sous-pression') = False) " +
																	"AND   ((([D_CRET])<#4/1/2016# " +
																	"And     ([DE_DOMN_INTRVT]) = 'AP - Appareil sous-pression') = False) " +
																	"AND ((([DE_DOMN_INTRVT]) = 'AP - Appareil sous-pression' " +
																	"And  (([C_TYPE_INTRVT]) = '02' " +
																	"Or    ([C_TYPE_INTRVT]) = '03' " +
																	"Or    ([C_TYPE_INTRVT]) = '04' " +
																	"Or    ([C_TYPE_INTRVT]) = '05' " +
																	"Or    ([C_TYPE_INTRVT]) = '08' " +
																	"Or    ([C_TYPE_INTRVT]) = '09' " +
																	"Or    ([C_TYPE_INTRVT]) = '10' " +
																	"Or    ([C_TYPE_INTRVT]) = '13')) = False) " +
																	"AND (((([C_TYPE_INTRVT]) = '11' " +
																	"Or     ([C_TYPE_INTRVT]) = '12') " +
																	"And    (Val(iif(Isnull([N_REGR]),0, [N_REGR])) >= 170 " +
																	"And Val(iif(Isnull([N_REGR]),0, [N_REGR])) <= 173)) = False) " +
																	"AND ((([DE_DOMN_INTRVT]) = 'QT - Qualité de travaux') = False) " +
																	"AND ((iif(isnull(Left([DE_NOTE],10)), True, IsDate(Mid([DE_NOTE],9,2) & '/' & Mid([DE_NOTE],6,2) & '/' & Left([DE_NOTE],4)))) = True) " +
																	"And     ((INTERVENTION_N_ATT.C_ETAP_ACTL) <> 'Itération terminée' Or (INTERVENTION_N_ATT.C_ETAP_ACTL) Is Null) " +
																	"OR  (((INTERVENTION_N_ATT.DE_DOMN_INTRVT) <> 'AP - Appareil sous-pression') " +
																	"AND  ((INTERVENTION_N_ATT.DE_NOTE) Is Null) " +
																	"AND ((([C_CODE_INTRVT]) = 'Sécurité' " +
																	"Or    ([C_CODE_INTRVT]) = 'Loi' " +
																	"Or    ([C_CODE_INTRVT]) Is Null) = False) " +
																	"AND ((([C_CODE_INTRVT]) = 'Règlement' " +
																	"And   ([DE_DOMN_INTRVT]) <> 'AP - Appareil sous-pression') = False) " +
																	"AND ((([D_CRET])<#4/1/2016# " +
																	"And   ([DE_DOMN_INTRVT]) = 'AP - Appareil sous-pression') = False) " +
																	"AND ((([DE_DOMN_INTRVT]) = 'AP - Appareil sous-pression' " +
																	"And (([C_TYPE_INTRVT]) = '02' " +
																	"Or   ([C_TYPE_INTRVT]) = '03' " +
																	"Or   ([C_TYPE_INTRVT]) = '04' " +
																	"Or   ([C_TYPE_INTRVT]) = '05' " +
																	"Or   ([C_TYPE_INTRVT]) = '08' " +
																	"Or   ([C_TYPE_INTRVT]) = '09' " +
																	"Or   ([C_TYPE_INTRVT]) = '10' " +
																	"Or   ([C_TYPE_INTRVT]) = '13')) = False) " +
																	"AND (((([C_TYPE_INTRVT]) = '11' " +
																	"Or     ([C_TYPE_INTRVT])= '12') " +
																	"And  (Val(iif(Isnull([N_REGR]),0, [N_REGR])) >= 170 " +
																	"And   Val(iif(Isnull([N_REGR]),0, [N_REGR])) <= 173)) = False) " +
																	"AND  ((([DE_DOMN_INTRVT])= 'QT - Qualité de travaux') = False) " +
																	"AND   ((INTERVENTION_N_ATT.C_ETAP_ACTL) <> 'Itération terminée' Or (INTERVENTION_N_ATT.C_ETAP_ACTL) Is Null))";

		public const string req_Interv_N_ATT_DICC_Ajout = "INSERT INTO INTERVENTION_N_ATT_DICC ( N_INTRVT, N_SITE, N_DEMN, C_INTRVN, C_INTRVT, D_CRET, D_OUVE_INTRVT, " +
			"C_CODE_INTRVT, C_TYPE_INTRVT, C_DE_TYPE_INTRVT, N_REGR, C_DE_REGR, S_INTRVT, C_RISQ, DE_DOMN_INTRVT, CATEGORIE, D_CRET_DEMN, D_RECEPTION_DEMN, " +
