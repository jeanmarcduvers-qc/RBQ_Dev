                            LoadTableErreur = true;
                        }
                    }
                    conn.Close();
                }

                mySQLConnectionMaj.Close();
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute la requête "req_Intervention_Ajout" de l'ancien système 
            ///
            /////////////////////////////////////////////////////////////////////

            void req_Intervention_Ajout()
            {
                string strSqlRequete;
                string strSql;

                InsertTableLogPlanificateur("SaisLot", "req_Intervention_Ajout");

                majSAIS_Interv_S_INTRVT();
                majSAIS_NOTE_INTERVENTION();
                majSAIS_Site_Ajout();
                majSAIS_DNC_Delai();

                // NOUVEAU: Créer table temporaire avec les parents "En cours"
                SqlConnection mySQLConnectionMaj = Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction) as SqlConnection;

                string sqlCreateTemp = "IF OBJECT_ID('tempdb..#ParentsEnCours') IS NOT NULL DROP TABLE #ParentsEnCours; " +
                                       "SELECT DISTINCT GI3_N_INTRVT INTO #ParentsEnCours " +
                                       "FROM [SDDMU01].[dbo].[SAIS_S_INTRVT_Interv_DNC] " +
                                       "WHERE S_INTRVT_DNC LIKE 'En cours%' OR S_INTRVT_DNC LIKE 'Non débutée%'";

                try
                {
                    SqlCommand cmdTemp = new SqlCommand(sqlCreateTemp, mySQLConnectionMaj);
                    cmdTemp.ExecuteNonQuery();
                    InsertTableLogPlanificateur("SaisLot", "Table #ParentsEnCours created successfully");

                }
                catch (Exception ex)
                {
                    InsertTableLogJobPlanificateur("req_Intervention_Ajout(CreateTemp)", ex.Message.ToString());
                    LoadTableErreur = true;
                    mySQLConnectionMaj.Close();
                    return;
                }

                string Etape = "Select";

                // MODIFIÉ: sqlCmdSelect avec EXISTS sur #ParentsEnCours
                // REQUÊTE avec UNION: Interventions principales + Itérations
                string sqlCmdSelect = @"
                --Interventions principales(blocs 1 & 2)
                SELECT distinct sreq.GI3_N_INTRVT, 
                       dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, 
                       dbo_GI3_DEMANDE_DECLARATION.GI3_N_DEMN, 
                       dbo_GI3_INTERVENANT.GI3_C_INTRVN, 
                       sreq.GI3_C_INTRVT, sreq.D_CRET, sreq.GI3_D_OUVE_INTRVT, 
                       sreq.GI3_C_CODE_INTRVT, sreq.GI3_C_TYPE_INTRVT, sreq.GI3_DE_TYPE_INTRVT, 
                       sreq.GI3_N_REGR, sreq.GI3_DE_REGR, sreq.Le_S_INTRVT, sreq.GI3_C_RISQ, 
                       sreq.GI3_DE_DOMN_INTRVT, sreq.GI3_C_ETAP_ACTL, 
                       dbo_GI3_DEMANDE_DECLARATION.GI3_D_CRET, dbo_GI3_DEMANDE_DECLARATION.GI3_D_RECEPTION, 
                       sreq.D_CRET_NOTE, sreq.GI3_C_SUJT_NOTE_INTR, sreq.GI3_C_SOUS_SUJT_NOTE, sreq.GI3_DE_NOTE, 
                       dbo_GI3_SITE_COMPOSANTE.GI3_NM_ENDR, Site_Ajout.GI3_A_ADRS_LIGN_1, Site_Ajout.GI3_C_POST, 
                       SUBSTRING(Site_Ajout.GI3_C_QUAL, 1, 30) GI3_C_QUAL, Site_Ajout.GI3_NM_MUNC, 
                       Site_Ajout.GI3_NM_REG_ADMN, Site_Ajout.GI3_Q_ETAG_BATM, Site_Ajout.GI3_V_AIRE_BATM, 
                       Site_Ajout.GI3_V_CAPC_MAXM_BATM, dbo_GI3_INTERVENANT.GI3_NM_INTRVN, 
                       DNC_Delai.GI3_V_DELA, sreq.GI3_C_ROWD_SITE
                        FROM((([SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] as dbo_GI3_SITE_COMPOSANTE
                       LEFT JOIN[SDDMU01].[dbo].[SAIS_Site_Ajout] as Site_Ajout ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = Site_Ajout.GI3_C_ROWD_SITE)
                       RIGHT JOIN([SDGIC01].[dbo].[GI3_DEMANDE_DECLARATION] as dbo_GI3_DEMANDE_DECLARATION
                       RIGHT JOIN(
                           SELECT i.GI3_C_ROWD_INTRVT, i.GI3_C_ROWD_DEMN_DECL, i.GI3_C_ROWD_INTRVN, i.GI3_C_ROWD_SITE,
                                  i.GI3_N_INTRVT, i.GI3_C_INTRVT, i.GI3_D_CRET AS D_CRET, i.GI3_D_OUVE_INTRVT,
                                  i.GI3_C_CODE_INTRVT, i.GI3_C_TYPE_INTRVT, i.GI3_DE_TYPE_INTRVT, i.GI3_N_REGR, i.GI3_DE_REGR,
                                  s.Le_S_INTRVT, i.GI3_C_RISQ, i.GI3_DE_DOMN_INTRVT, i.GI3_C_ETAP_ACTL,
                                  n.GI3_D_CRET AS D_CRET_NOTE, n.GI3_C_SUJT_NOTE_INTR, n.GI3_C_SOUS_SUJT_NOTE, n.GI3_DE_NOTE
                           FROM ([SDGIC01].[dbo].[GI3_INTERVENTION] i
                                 LEFT JOIN[SDDMU01].[dbo].[SAIS_Interv_S_INTRVT] s ON i.GI3_N_INTRVT = s.GI3_N_INTRVT)
                                 LEFT JOIN[SDDMU01].[dbo].[SAIS_NOTE_INTERVENTION] n ON i.GI3_C_ROWD_INTRVT = n.GI3_C_ROWD_INTRVT
                           WHERE((i.GI3_C_INTRVT Not Like 'Maitre%')
                                  AND(i.GI3_C_ETAP_ACTL <> 'Transfert DPCP' Or i.GI3_C_ETAP_ACTL Is Null)
                                  AND(iif(n.GI3_DE_NOTE is not null, SUBSTRING(n.GI3_DE_NOTE, 11, 1), null) <> '?' Or iif(n.GI3_DE_NOTE is not null, SUBSTRING(n.GI3_DE_NOTE, 11, 1), null) Is Null)
                                  AND(i.GI3_S_INTRVT <> 'Terminée' And i.GI3_S_INTRVT <> 'Terminé')
                                  AND(Right(i.GI3_N_INTRVT, 2) Not Like '-%')
                                  AND(i.GI3_C_ASSIGNE_A = 'SADMIN')) 
                           OR((i.GI3_C_INTRVT Is Null)
                                  AND(i.GI3_C_ETAP_ACTL <> 'Transfert DPCP' Or i.GI3_C_ETAP_ACTL Is Null)
                                  AND(iif(n.GI3_DE_NOTE is not null, SUBSTRING(n.GI3_DE_NOTE, 11, 1), null) <> '?' Or iif(n.GI3_DE_NOTE is not null, SUBSTRING(n.GI3_DE_NOTE, 11, 1), null) Is Null)
                                  AND(i.GI3_S_INTRVT <> 'Terminée' And i.GI3_S_INTRVT <> 'Terminé')
                                  AND(Right(i.GI3_N_INTRVT, 2) Not Like '-%')
                                  AND(i.GI3_C_ASSIGNE_A = 'SADMIN'))
                       ) as sreq ON dbo_GI3_DEMANDE_DECLARATION.GI3_C_ROWD_DEMN_DECL = sreq.GI3_C_ROWD_DEMN_DECL) 
                      ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = sreq.GI3_C_ROWD_SITE) 
                      LEFT JOIN[SDGIC01].[dbo].[GI3_INTERVENANT] dbo_GI3_INTERVENANT ON sreq.GI3_C_ROWD_INTRVN = dbo_GI3_INTERVENANT.GI3_C_ROWD_INTRVN) 
                      LEFT JOIN[SDDMU01].[dbo].[SAIS_DNC_Delai] DNC_Delai ON sreq.GI3_C_ROWD_INTRVT = DNC_Delai.GI3_C_ROWD_INTRVT

                UNION ALL

                --Itérations(blocs 3 & 4)
                SELECT distinct sreq.GI3_N_INTRVT, 
                       dbo_GI3_SITE_COMPOSANTE.GI3_N_SITE, 
                       NULL as GI3_N_DEMN, 
                       dbo_GI3_INTERVENANT.GI3_C_INTRVN, 
                       sreq.GI3_C_INTRVT, sreq.D_CRET, sreq.GI3_D_OUVE_INTRVT, 
                       sreq.GI3_C_CODE_INTRVT, sreq.GI3_C_TYPE_INTRVT, sreq.GI3_DE_TYPE_INTRVT, 
                       sreq.GI3_N_REGR, sreq.GI3_DE_REGR, sreq.Le_S_INTRVT, sreq.GI3_C_RISQ, 
                       sreq.GI3_DE_DOMN_INTRVT, sreq.GI3_C_ETAP_ACTL, 
                       NULL as GI3_D_CRET, NULL as GI3_D_RECEPTION, 
                       sreq.D_CRET_NOTE, sreq.GI3_C_SUJT_NOTE_INTR, sreq.GI3_C_SOUS_SUJT_NOTE, sreq.GI3_DE_NOTE, 
                       dbo_GI3_SITE_COMPOSANTE.GI3_NM_ENDR, Site_Ajout.GI3_A_ADRS_LIGN_1, Site_Ajout.GI3_C_POST, 
                       SUBSTRING(Site_Ajout.GI3_C_QUAL, 1, 30) GI3_C_QUAL, Site_Ajout.GI3_NM_MUNC, 
                       Site_Ajout.GI3_NM_REG_ADMN, Site_Ajout.GI3_Q_ETAG_BATM, Site_Ajout.GI3_V_AIRE_BATM, 
                       Site_Ajout.GI3_V_CAPC_MAXM_BATM, dbo_GI3_INTERVENANT.GI3_NM_INTRVN, 
                       DNC_Delai.GI3_V_DELA, sreq.GI3_C_ROWD_SITE
                FROM((
                       SELECT i.GI3_C_ROWD_INTRVT, i.GI3_C_ROWD_INTRVN, i.GI3_C_ROWD_SITE,
                              i.GI3_N_INTRVT, i.GI3_C_INTRVT, i.GI3_D_CRET AS D_CRET, i.GI3_D_OUVE_INTRVT,
                              i.GI3_C_CODE_INTRVT, i.GI3_C_TYPE_INTRVT, i.GI3_DE_TYPE_INTRVT, i.GI3_N_REGR, i.GI3_DE_REGR,
                              s.Le_S_INTRVT, i.GI3_C_RISQ, i.GI3_DE_DOMN_INTRVT, i.GI3_C_ETAP_ACTL,
                              n.GI3_D_CRET AS D_CRET_NOTE, n.GI3_C_SUJT_NOTE_INTR, n.GI3_C_SOUS_SUJT_NOTE, n.GI3_DE_NOTE
                       FROM([SDGIC01].[dbo].[GI3_INTERVENTION] i
                             LEFT JOIN[SDDMU01].[dbo].[SAIS_Interv_S_INTRVT] s ON i.GI3_N_INTRVT = s.GI3_N_INTRVT)
                             LEFT JOIN[SDDMU01].[dbo].[SAIS_NOTE_INTERVENTION] n ON i.GI3_C_ROWD_INTRVT = n.GI3_C_ROWD_INTRVT
                       WHERE((i.GI3_C_INTRVT Not Like 'Maitre%')
                              AND exists(select 1 from #ParentsEnCours t where t.GI3_N_INTRVT = LEFT(i.GI3_N_INTRVT, LEN(i.GI3_N_INTRVT) - 2)) 
                             AND (RTRIM(i.GI3_C_ETAP_ACTL) = 'Visite' OR i.GI3_C_ETAP_ACTL Is Null)
                              AND(iif(n.GI3_DE_NOTE is not null, SUBSTRING(n.GI3_DE_NOTE, 11, 1), null) <> '?' Or iif(n.GI3_DE_NOTE is not null, SUBSTRING(n.GI3_DE_NOTE, 11, 1), null) Is Null)
                              AND(Right(i.GI3_N_INTRVT, 2) Like '-%')
                              AND(i.GI3_C_ASSIGNE_A = 'SADMIN')) 
                       OR((i.GI3_C_INTRVT Is Null)
                              AND exists(select 1 from #ParentsEnCours t where t.GI3_N_INTRVT = LEFT(i.GI3_N_INTRVT, LEN(i.GI3_N_INTRVT) - 2)) 
                              AND (RTRIM(i.GI3_C_ETAP_ACTL) = 'Visite' OR i.GI3_C_ETAP_ACTL Is Null) 
                              AND(iif(n.GI3_DE_NOTE is not null, SUBSTRING(n.GI3_DE_NOTE, 11, 1), null) <> '?' Or iif(n.GI3_DE_NOTE is not null, SUBSTRING(n.GI3_DE_NOTE, 11, 1), null) Is Null)
                              AND(Right(i.GI3_N_INTRVT, 2) Like '-%')
                              AND(i.GI3_C_ASSIGNE_A = 'SADMIN'))
                       ) as sreq
                      LEFT JOIN[SDGIC01].[dbo].[GI3_SITE_COMPOSANTE] dbo_GI3_SITE_COMPOSANTE ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = sreq.GI3_C_ROWD_SITE) 
                      LEFT JOIN[SDDMU01].[dbo].[SAIS_Site_Ajout] Site_Ajout ON dbo_GI3_SITE_COMPOSANTE.GI3_C_ROWD_SITE = Site_Ajout.GI3_C_ROWD_SITE
                      LEFT JOIN[SDGIC01].[dbo].[GI3_INTERVENANT] dbo_GI3_INTERVENANT ON sreq.GI3_C_ROWD_INTRVN = dbo_GI3_INTERVENANT.GI3_C_ROWD_INTRVN
                      LEFT JOIN[SDDMU01].[dbo].[SAIS_DNC_Delai] DNC_Delai ON sreq.GI3_C_ROWD_INTRVT = DNC_Delai.GI3_C_ROWD_INTRVT";

                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                {
                    conn.Open();
                    using (OleDbTransaction transaction = conn.BeginTransaction())
                    {
                        try
                        {
                            SqlCommand commandDataReader = new SqlCommand(sqlCmdSelect, mySQLConnectionMaj);
                            SqlDataReader ValueReader = commandDataReader.ExecuteReader();

                            InsertTableLogPlanificateur("SaisLot", "ValueReader.HasRows = " + ValueReader.HasRows.ToString());

                            OleDbCommand SQLCommandExec = new OleDbCommand("INSERT", conn, transaction);

                            Etape = "Insert";

                            int compteur = 0;
                            int compteurIterations = 0;

                            while (ValueReader.Read())
                            {
                                compteur++;
                                // NOUVEAU - Compter les itérations
                                string nIntrvt = ValueReader["GI3_N_INTRVT"].ToString();
                                if (nIntrvt.Length > 2 && nIntrvt.Substring(nIntrvt.Length - 2, 1) == "-")
                                {
                                    compteurIterations++;
                                }
                                strSql = "INSERT INTO INTERVENTION_N_ATT ( N_INTRVT, N_SITE, N_DEMN, C_INTRVN, C_INTRVT, D_CRET, D_OUVE_INTRVT, C_CODE_INTRVT, C_TYPE_INTRVT, C_DE_TYPE_INTRVT, " +
                                                                                    "N_REGR, C_DE_REGR, S_INTRVT, C_RISQ, DE_DOMN_INTRVT, C_ETAP_ACTL, D_CRET_DEMN, D_RECEPTION_DEMN, D_CRET_NOTE, " +
                                                                                    "C_SUJT_NOTE_INTR, C_SOUS_SUJT_NOTE, DE_NOTE, NM_ENDR, C_ADRE_SITE, C_CODPOST_SITE, C_COD_QUALF_SITE, C_VILLE_SITE, " +
                                                                                    "REGION, [Q_ ETAG_BATM], V_AIRE_BATM, V_CAPC_MAXM_BATM, NM_INTRVN, V_DELA, GI3_C_ROWD_SITE ) " +
                                                "values('" + ValueReader["GI3_N_INTRVT"].ToString() + "', '" +
                                                                ValueReader["GI3_N_SITE"].ToString() + "', '" +
                                                                ValueReader["GI3_N_DEMN"].ToString() + "', '" +
                                                                ValueReader["GI3_C_INTRVN"].ToString() + "', '" +
                                                                ValueReader["GI3_C_INTRVT"].ToString() + "', '" +
                                                                ValueReader["D_CRET"].ToString() + "', '" +
                                                                ValueReader["GI3_D_OUVE_INTRVT"].ToString() + "', '" +
                                                                ValueReader["GI3_C_CODE_INTRVT"].ToString() + "', '" +
                                                                ValueReader["GI3_C_TYPE_INTRVT"].ToString() + "', '" +
                                                                ValueReader["GI3_DE_TYPE_INTRVT"].ToString().Replace("'", "''") + "', '" +
                                                                ValueReader["GI3_N_REGR"].ToString() + "', '" +
                                                                ValueReader["GI3_DE_REGR"].ToString().Replace("'", "''") + "', '" +
                                                                ValueReader["Le_S_INTRVT"].ToString() + "', '" +
                                                                ValueReader["GI3_C_RISQ"].ToString() + "', '" +
                                                                ValueReader["GI3_DE_DOMN_INTRVT"].ToString() + "', '" +
                                                                ValueReader["GI3_C_ETAP_ACTL"].ToString() + "', '" +
                                                                ValueReader["GI3_D_CRET"].ToString() + "', '" +
                                                                ValueReader["GI3_D_RECEPTION"].ToString() + "', '" +
                                                                ValueReader["D_CRET_NOTE"].ToString() + "', '" +
                                                                ValueReader["GI3_C_SUJT_NOTE_INTR"].ToString() + "', '" +
                                                                ValueReader["GI3_C_SOUS_SUJT_NOTE"].ToString() + "', '" +
                                                                ValueReader["GI3_DE_NOTE"].ToString().Replace("'", "''") + "', '" +
                                                                ValueReader["GI3_NM_ENDR"].ToString().Replace("'", "''") + "', '" +
                                                                ValueReader["GI3_A_ADRS_LIGN_1"].ToString().Replace("'", "''") + "', '" +
                                                                ValueReader["GI3_C_POST"].ToString().Replace(" ", "") + "', '" +
                                                                ValueReader["GI3_C_QUAL"].ToString() + "', '" +
                                                                ValueReader["GI3_NM_MUNC"].ToString().Replace("'", "''") + "', '" +
                                                                ValueReader["GI3_NM_REG_ADMN"].ToString().Replace("'", "''") + "', '" +
                                                                ValueReader["GI3_Q_ETAG_BATM"].ToString() + "', '" +
                                                                ValueReader["GI3_V_AIRE_BATM"].ToString() + "', '" +
                                                                ValueReader["GI3_V_CAPC_MAXM_BATM"].ToString() + "', '" +
                                                                ValueReader["GI3_NM_INTRVN"].ToString().Replace("'", "''") + "', '" +
                                                                ValueReader["GI3_V_DELA"].ToString() + "', '" +
                                                                ValueReader["GI3_C_ROWD_SITE"].ToString() + "')";
                                strSqlRequete = strSql.ToString().Replace(", '',", ", null,").Replace(", '',", ", null,");
                                SQLCommandExec.CommandType = CommandType.Text;
                                SQLCommandExec.CommandText = strSqlRequete.ToString();
                                SQLCommandExec.CommandTimeout = 12000;
                                SQLCommandExec.ExecuteNonQuery();
                                if (nIntrvt.Contains("-") && nIntrvt.LastIndexOf('-') > nIntrvt.IndexOf('-'))
                                {
                                    InsertTableLogPlanificateur("SaisLot", "DEBUG_ITER_INSERT: " + nIntrvt);
                                }
                            }

                            InsertTableLogPlanificateur("SaisLot", "Inserted " + compteur + " rows into INTERVENTION_N_ATT");
                            InsertTableLogPlanificateur("SaisLot", "Iterations inserees: " + compteurIterations.ToString());

                            transaction.Commit();

                            ValueReader.Close();
                        }
                        catch (Exception ex)
                        {
                            InsertTableLogJobPlanificateur("req_Intervention_Ajout(" + Etape + ")", ex.Message.ToString());
                            LoadTableErreur = true;
                        }
                    }
                    conn.Close();
                }

                mySQLConnectionMaj.Close(); // Ceci supprime automatiquement #ParentsEnCours
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute la requête "Qry_Add_InterventionsGIC" de l'ancien système 
            ///
            /////////////////////////////////////////////////////////////////////
            void Qry_Add_InterventionsGIC()
            {

                string strSqlRequete;
                string sqlCmdSelect = "SELECT tbl_Intervention_GIC.N_INTRVT, tbl_Intervention_GIC.N_SITE, tbl_Intervention_GIC.NM_ENDR, tbl_Intervention_GIC.N_DEMN, " +
                "tbl_Intervention_GIC.C_INTRVN, tbl_Intervention_GIC.C_INTRVT, tbl_Intervention_GIC.D_CRET, tbl_Intervention_GIC.D_OUVE_INTRVT, " +
                "tbl_Intervention_GIC.C_CODE_INTRVT, tbl_Intervention_GIC.C_TYPE_INTRVT, tbl_Intervention_GIC.C_DE_TYPE_INTRVT, tbl_Intervention_GIC.N_REGR, " +
                "tbl_Intervention_GIC.C_DE_REGR, tbl_Intervention_GIC.S_INTRVT, tbl_Intervention_GIC.C_RISQ, tbl_Intervention_GIC.DE_DOMN_INTRVT, " +
                "tbl_Intervention_GIC.CATEGORIE, tbl_Intervention_GIC.D_CRET_DEMN, tbl_Intervention_GIC.D_RECEPTION_DEMN, " +
                "tbl_Intervention_GIC.D_CRET_NOTE, tbl_Intervention_GIC.C_SUJT_NOTE_INTR, tbl_Intervention_GIC.C_SOUS_SUJT_NOTE, " +
                "tbl_Intervention_GIC.DE_NOTE, tbl_Intervention_GIC.C_ADRE_SITE, tbl_Intervention_GIC.C_CODPOST_SITE, " +
                "tbl_Intervention_GIC.C_COD_QUALF_SITE, tbl_Intervention_GIC.C_DESC_COD_QUALF_SITE, tbl_Intervention_GIC.C_VILLE_SITE, " +
                "tbl_Intervention_GIC.REGION, tbl_Intervention_GIC.V_AIRE_BATM, tbl_Intervention_GIC.V_CAPC_MAXM_BATM, " +
                "tbl_Intervention_GIC.NM_INTRVN, tbl_Intervention_GIC.C_ETAP_ACTL, tbl_Intervention_GIC.CRITICITE_INTRVT, " +
                "tbl_Intervention_GIC.CRITICITE_SITE, tbl_Intervention_GIC.CRITICITE_INTRVN, tbl_Intervention_GIC.D_CRET_NON_CONFORMITE, " +
                "tbl_Intervention_GIC.V_DELA, tbl_Intervention_GIC.D_ATTRIBUTION_INTRVT, tbl_Intervention_GIC.CRITICITE_CODE_QUALIF_SITE, " +
                "tbl_Intervention_GIC.SOUS_REGION, iif([tbl_Intervention_GIC].[N_INTRL] is null, 'SADMIN', [tbl_Intervention_GIC].[N_INTRL]) as N_INTRL, " +
                "tbl_Intervention_GIC.D_CONFIRMATION_ATTRIB, tbl_Intervention_GIC.DIRECTION, tbl_Intervention_GIC.USER_ATTRIB, dbo_GI3_INTERVENTION.GI3_C_COTE_PRIR_INTR " +
                "FROM [SDGIC01].[dbo].[GI3_INTERVENTION] as dbo_GI3_INTERVENTION " +
                "INNER JOIN ([SDDMU01].[dbo].[SAIS_INTERVENTIONS] as tbl_INTERVENTIONS " +
                "RIGHT JOIN [SDDMU01].[dbo].[SAIS_Intervention_GIC] as tbl_Intervention_GIC ON tbl_INTERVENTIONS.N_INTRVT = tbl_Intervention_GIC.N_INTRVT) " +
                "ON dbo_GI3_INTERVENTION.GI3_N_INTRVT = tbl_Intervention_GIC.N_INTRVT " +
                "WHERE (tbl_Intervention_GIC.DE_DOMN_INTRVT NOT LIKE 'AP%') " +
                "AND (tbl_INTERVENTIONS.N_INTRVT IS NULL " +
                "OR (LEN(tbl_Intervention_GIC.N_INTRVT) - LEN(REPLACE(tbl_Intervention_GIC.N_INTRVT, '-', ''))) > 2)";






                string Etape = "Select";

                InsertTableLogPlanificateur("SaisLot", "Qry_Add_InterventionsGIC");

                majSAIS_INTERVENTIONS();
                majSAIS_Intervention_GIC();

                SqlConnection mySQLConnectionMaj = Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction) as SqlConnection;
                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                {
                    conn.Open();
                    using (OleDbTransaction transaction = conn.BeginTransaction())
                    {
                        try
                        {
                            SqlCommand commandDataReader = new SqlCommand(sqlCmdSelect, mySQLConnectionMaj);
                            SqlDataReader ValueReader = commandDataReader.ExecuteReader();
                            OleDbCommand SQLCommandExec = new OleDbCommand("INSERT", conn, transaction);

                            Etape = "Insert";

                            while (ValueReader.Read())
                            {
                                strSqlRequete = "INSERT INTO tbl_INTERVENTIONS ( N_INTRVT, N_SITE, NM_ENDR, N_DEMN, C_INTRVN, C_INTRVT, D_CRET, D_OUVE_INTRVT, C_CODE_INTRVT, " +
                                                                                "C_TYPE_INTRVT, C_DE_TYPE_INTRVT, N_REGR, C_DE_REGR, S_INTRVT, C_RISQ, DE_DOMN_INTRVT, CATEGORIE, " +
                                                                                "D_CRET_DEMN, D_RECEPTION_DEMN, D_CRET_NOTE, C_SUJT_NOTE_INTR, C_SOUS_SUJT_NOTE, DE_NOTE, " +
                                                                                "C_ADRE_SITE, C_CODPOST_SITE, C_COD_QUALF_SITE, C_DESC_COD_QUALF_SITE, C_VILLE_SITE, REGION, " +
                                                                                "V_AIRE_BATM, V_CAPC_MAXM_BATM, NM_INTRVN, C_ETAP_ACTL, CRITICITE_INTRVT, CRITICITE_SITE, " +
                                                                                "CRITICITE_INTRVN, D_CRET_NON_CONFORMITE, V_DELA, D_ATTRIBUTION_INTRVT, CRITICITE_CODE_QUALIF_SITE, " +
                                                                                "SOUS_REGION, N_INTRL, D_CONFIRMATION_ATTRIB, DIRECTION, USER_ATTRIB, C_COTE_PRIR_INTR ) " +
                                                "values ('" + ValueReader["N_INTRVT"].ToString().Replace("'", "''") + "', '" + ValueReader["N_SITE"].ToString().Replace("'", "''") + "', '" +
                                                              ValueReader["NM_ENDR"].ToString().Replace("'", "''") + "', '" + ValueReader["N_DEMN"].ToString().Replace("'", "''") + "', '" +
                                                              ValueReader["C_INTRVN"].ToString().Replace("'", "''") + "', '" + ValueReader["C_INTRVT"].ToString().Replace("'", "''") + "', '" +
                                                              ValueReader["D_CRET"].ToString().Replace("'", "''") + "', '" + ValueReader["D_OUVE_INTRVT"].ToString().Replace("'", "''") + "', '" +
                                                              ValueReader["C_CODE_INTRVT"].ToString().Replace("'", "''") + "', '" + ValueReader["C_TYPE_INTRVT"].ToString().Replace("'", "''") + "', '" +
                                                              ValueReader["C_DE_TYPE_INTRVT"].ToString().Replace("'", "''") + "', '" + ValueReader["N_REGR"].ToString().Replace("'", "''") + "', '" +
                                                              ValueReader["C_DE_REGR"].ToString().Replace("'", "''") + "', '" + ValueReader["S_INTRVT"].ToString().Replace("'", "''") + "', '" +
                                                              ValueReader["C_RISQ"].ToString().Replace("'", "''") + "', '" + ValueReader["DE_DOMN_INTRVT"].ToString().Replace("'", "''") + "', '" +
                                                              ValueReader["CATEGORIE"].ToString().Replace("'", "''") + "', '" + ValueReader["D_CRET_DEMN"].ToString().Replace("'", "''") + "', '" +
                                                              ValueReader["D_RECEPTION_DEMN"].ToString().Replace("'", "''") + "', '" + ValueReader["D_CRET_NOTE"].ToString().Replace("'", "''") + "', '" +
                                                              ValueReader["C_SUJT_NOTE_INTR"].ToString().Replace("'", "''") + "', '" + ValueReader["C_SOUS_SUJT_NOTE"].ToString().Replace("'", "''") + "', '" +
                                                              ValueReader["DE_NOTE"].ToString().Replace("'", "''") + "', '" + ValueReader["C_ADRE_SITE"].ToString().Replace("'", "''") + "', '" +
                                                              ValueReader["C_CODPOST_SITE"].ToString().Replace("'", "''") + "', '" + ValueReader["C_COD_QUALF_SITE"].ToString().Replace("'", "''") + "', '" +
