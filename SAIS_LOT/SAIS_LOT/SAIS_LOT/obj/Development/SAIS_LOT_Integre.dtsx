											"Or       (tbl_INTERVENTIONS.C_COTE_PRIR_INTR) = '01'))";

		public const string Qry_DIS_Violet = "UPDATE tbl_INTERVENTIONS SET tbl_INTERVENTIONS.Couleur = 12731860 " +
											 "WHERE  (((tbl_INTERVENTIONS.DIRECTION) = 'DIS') " +
											 "AND     ((tbl_INTERVENTIONS.C_TYPE_INTRVT) = '28') " +
											 "AND     ((tbl_INTERVENTIONS.N_REGR) = '200')) " +
											 "OR     (((tbl_INTERVENTIONS.DIRECTION) = 'DIS') " +
											 "AND     ((tbl_INTERVENTIONS.C_TYPE_INTRVT) = '28') " +
											 "AND     ((tbl_INTERVENTIONS.N_REGR) = '201')) " +
											 "OR     (((tbl_INTERVENTIONS.DIRECTION) = 'DIS') " +
											 "AND     ((tbl_INTERVENTIONS.C_TYPE_INTRVT) = '28') " +
											 "AND     ((tbl_INTERVENTIONS.N_REGR) = '203')) " +
											 "OR     (((tbl_INTERVENTIONS.DIRECTION) = 'DIS') " +
											 "AND     ((tbl_INTERVENTIONS.C_TYPE_INTRVT) = '22') " +
											 "AND     ((tbl_INTERVENTIONS.N_REGR) = '205'))";

		public const string Qry_DIS_Jaune = "UPDATE tbl_INTERVENTIONS SET tbl_INTERVENTIONS.Couleur = 13696253 " +
											"WHERE  (((tbl_INTERVENTIONS.DIRECTION) = 'DIS') " +
											"AND     ((Right([N_INTRVT],2)) = '-1' " +
											"Or       (Right([N_INTRVT],2)) = '-2' " +
											"Or       (Right([N_INTRVT],2)) = '-3'))";

		public const string Qry_DIS_Bleu = "UPDATE tbl_INTERVENTIONS SET tbl_INTERVENTIONS.Couleur = 12632160 " +
										   "WHERE  (((tbl_INTERVENTIONS.DIRECTION) = 'DIS') " +
										   "AND     ((tbl_INTERVENTIONS.N_REGR) = '154'))";

		public const string Qry_DIS_Blanc = "UPDATE tbl_INTERVENTIONS SET tbl_INTERVENTIONS.Couleur = 16777215 " +
											"WHERE  (((tbl_INTERVENTIONS.Couleur) Is Null) " +
											"AND     ((tbl_INTERVENTIONS.DIRECTION) = 'DIS')) " +
											"OR     (((tbl_INTERVENTIONS.Couleur) = 0) " +
											"AND     ((tbl_INTERVENTIONS.DIRECTION) = 'DIS'))";

		public const string Qry_Sup_INTERVENTIONS_NonAttribuées_Dbl = "DELETE tbl_INTERVENTIONS.N_INTRVT, tbl_INTERVENTIONS.D_ATTRIBUTION_INTRVT, " +
																			 "tbl_INTERVENTIONS.D_CONFIRMATION_ATTRIB " +
																	  "FROM   tbl_INTERVENTIONS " +
																	  "WHERE  (((tbl_INTERVENTIONS.N_INTRVT) In (SELECT N_INTRVT " +
																												"FROM   tbl_INTERVENTIONS " +
																												 "GROUP BY N_INTRVT " +
																												 "HAVING COUNT(*) > 1 )) " +
																	  "AND     ((tbl_INTERVENTIONS.D_ATTRIBUTION_INTRVT) Is Null) " +
																	  "AND     ((tbl_INTERVENTIONS.D_CONFIRMATION_ATTRIB) Is Null))";

		public const string Maj_IterationNonPriseEnChargeIntervFermee = "UPDATE GI3_INTERVENTION " +
																			   "INNER JOIN tbl_INTERVENTIONS ON GI3_INTERVENTION.GI3_N_INTRVT = tbl_INTERVENTIONS.N_INTRVT " +
																		"SET    GI3_INTERVENTION.GI3_S_INTRVT = 'Terminée' " +
																		"WHERE  (((GI3_INTERVENTION.GI3_S_INTRVT) <> 'Terminée') " +
																		"AND     ((tbl_INTERVENTIONS.N_INTRVT) Like '%-%-%') " +
																		"AND     ((tbl_INTERVENTIONS.N_INTRL) <> 'SADMIN') " +
																		"AND     ((tbl_INTERVENTIONS.S_INTRVT) <> 'En cours'))";

		public const string Maj_IterationNonPriseEnChargeIntervFermee2 = "UPDATE GI3_INTERVENTION " +
																				"INNER JOIN tbl_INTERVENTIONS ON GI3_INTERVENTION.GI3_N_INTRVT = tbl_INTERVENTIONS.N_INTRVT " +
																		 "SET    GI3_INTERVENTION.GI3_C_ASSIGNE_A = tbl_INTERVENTIONS.USER_ATTRIB " +
																		 "WHERE  (((GI3_INTERVENTION.GI3_C_ASSIGNE_A) = 'SADMIN') " +
																		 "AND     ((tbl_INTERVENTIONS.N_INTRVT) Like '%-%-%') " +
																		 "AND     ((tbl_INTERVENTIONS.S_INTRVT) Not Like 'Terminé%') " +
																		 "AND     ((GI3_INTERVENTION.GI3_D_CLOT_INTRVT) Is Not Null) " +
																		 "AND     ((tbl_INTERVENTIONS.USER_ATTRIB) Is Not Null))";

		public const string tbl_SystemeEvent_fin = "INSERT INTO tbl_SystemeEvent(DateEvent, Etape ) SELECT Now(), 'Fin de traitement'";
		public const string tbl_SystemeEvent_debut = "INSERT INTO tbl_SystemeEvent(DateEvent, Etape ) SELECT Now(), 'Début de traitement'";

	}
}]]></ProjectItem>
