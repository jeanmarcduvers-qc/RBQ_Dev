         * 
         * Example of firing a warning event:
         *  Dts.Events.FireWarning(14, "Process Values", "No values received for input", "", 0);
         * */
        #endregion

        #region Help:  Using Integration Services connection managers in a script
        /* Some types of connection managers can be used in this script task.  See the topic 
         * "Working with Connection Managers Programatically" for details.
         * 
         * Example of using an ADO.Net connection manager:
         *  object rawConnection = Dts.Connections["Sales DB"].AcquireConnection(Dts.Transaction);
         *  SqlConnection myADONETConnection = (SqlConnection)rawConnection;
         *  //Use the connection in some code here, then release the connection
         *  Dts.Connections["Sales DB"].ReleaseConnection(rawConnection);
         *
         * Example of using a File connection manager
         *  object rawConnection = Dts.Connections["Prices.zip"].AcquireConnection(Dts.Transaction);
         *  string filePath = (string)rawConnection;
         *  //Use the connection in some code here, then release the connection
         *  Dts.Connections["Prices.zip"].ReleaseConnection(rawConnection);
         * */
        #endregion


        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        /// 
        public string newLine = Environment.NewLine;
        public string oUserCode = "auto01";
        public string userlogin = Environment.UserName.ToString();
        public string UserName = "Tâche Automatisée";
        public string SchemasUser;

        public string strConnectBdAccess;
        public string strLigneIntruction;
        public string strIndSystem = "SaisLot";
        public string strTypeTraitement = "TraitEnLot";
        public string strCodeTraitement = "QryAccess";

        private SqlConnection mySQLConnectionLog;

        public void Main()
        {
            SaisLot();
            Dts.TaskResult = (int)ScriptResults.Success;
        }

        public void SaisLot()
        {
            string sqlCmdMaj;
            bool succesLoadTable = true;
            bool LoadTableErreur = false;
            string strMessageSql = "";
            SchemasUser = "MTR.";

            string date = DateTime.Now.ToString("yyyy-MM-dd hh:mm:ss");
            DateTime dtJour = DateTime.Now;
            string EnvoyePar = Dts.Variables["User::EnvoyePar"].Value.ToString();
            InsertTableLogPlanificateur("DEBUG1", "Avant assignation");
            strConnectBdAccess = Dts.Variables["User::bdAccess"].Value.ToString();
            InsertTableLogPlanificateur("DEBUG2", "Apres: " + strConnectBdAccess);

            SqlConnection mySQLConnection = null;
            SqlConnection mySQLConnectionII = null;

            try
            {

                mySQLConnection =
                    Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                    as SqlConnection;

                mySQLConnectionII =
                    Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                    as SqlConnection;

                mySQLConnectionLog =
                    Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                    as SqlConnection;

                InsertTableLogPlanificateur("SaisLot", "Début du traitement");

                ExecuteSQL("tbl_SystemeEvent_debut", RequetesSQL.tbl_SystemeEvent_debut);

                ExecuteSQL("req_Supp_Intervention_N_ATT", RequetesSQL.req_Supp_Intervention_N_ATT);
                ExecuteSQL("req_Supp_DNC_Intervention", RequetesSQL.req_Supp_DNC_Intervention);
                ExecuteSQL("req_SUPP_S_INTRVT_Interv_DNC", RequetesSQL.req_SUPP_S_INTRVT_Interv_DNC);
                ExecuteSQL("req_Supp_Interv_S_INTRVT", RequetesSQL.req_Supp_Interv_S_INTRVT);
                req_S_INTRVT_Interv_DNC();

                ExecuteSQL("req_MAJ_Donnees_Debut", RequetesSQL.req_MAJ_Donnees_Debut);
                req_DNC_Intervention();
                req_S_Intrvt();
                req_DNC();
                req_Note_Inter_pour_Ajout();
                req_Intervention_Maitre_SADMIN();
                req_Lien_Site_Adresse_Principale();
                req_SITE_Ajout();
                req_Intervention_Ajout();
                Log_DatesInvalides();

                //Validation des dates cible de la DICC
                ExecuteSQL("Qry_ValidDateCible", RequetesSQL.Qry_ValidDateCible);

                ExecuteSQL("req_Supp_INTERVENTION_N_ATT_DICC", RequetesSQL.req_Supp_INTERVENTION_N_ATT_DICC);
                ExecuteSQL("req_Supp_INTERVENTION_N_ATT_DICC_Critères", RequetesSQL.req_Supp_INTERVENTION_N_ATT_DICC_Critères);

                Qry_Interv_N_ATT_DICC_Critère_Creer();

                ExecuteSQL("req_Interv_N_ATT_DICC_Ajout", RequetesSQL.req_Interv_N_ATT_DICC_Ajout);
                ExecuteSQL("req_Supp_INTERVENTION_N_ATT_DICC_Critères", RequetesSQL.req_Supp_INTERVENTION_N_ATT_DICC_Critères);
                ExecuteSQL("req_Regrp_Categ_DICC_P2_DNC", RequetesSQL.req_Regrp_Categ_DICC_P2_DNC);
                ExecuteSQL("req_Regrp_Categ_DICC_P2", RequetesSQL.req_Regrp_Categ_DICC_P2);
                ExecuteSQL("req_Regrp_Categ_DICC_P1", RequetesSQL.req_Regrp_Categ_DICC_P1);
                ExecuteSQL("req_Regrp_Categ_DICC_P3", RequetesSQL.req_Regrp_Categ_DICC_P3);
                ExecuteSQL("req_Regrp_Categ_DICC_P4", RequetesSQL.req_Regrp_Categ_DICC_P4);
                ExecuteSQL("req_Regrp_Categ_DICC_P5_Sans_Categ", RequetesSQL.req_Regrp_Categ_DICC_P5_Sans_Categ);
                ExecuteSQL("req_Supp_Crit_Intervenant_DICC", RequetesSQL.req_Supp_Crit_Intervenant_DICC);
                ExecuteSQL("req_Crit_Intervenant_DICC", RequetesSQL.req_Crit_Intervenant_DICC);
                ExecuteSQL("req_Supp_Crit_Site_DICC", RequetesSQL.req_Supp_Crit_Site_DICC);
                ExecuteSQL("req_Crit_Site_DICC", RequetesSQL.req_Crit_Site_DICC);

                Calcul_Criticite_DICC();

                // DESP
                ExecuteSQL("Qry_Supp_INTERVENTION_N_ATT_DESP", RequetesSQL.Qry_Supp_INTERVENTION_N_ATT_DESP);
                ExecuteSQL("Qry_Supp_INTERVENTION_N_ATT_DESP_Critères", RequetesSQL.Qry_Supp_INTERVENTION_N_ATT_DESP_Critères);
                ExecuteSQL("Qry_Interv_N_ATT_DESP_Critère_Creer", RequetesSQL.Qry_Interv_N_ATT_DESP_Critère_Creer);
                ExecuteSQL("Qry_Interv_N_ATT_DESP_Ajout", RequetesSQL.Qry_Interv_N_ATT_DESP_Ajout);
                ExecuteSQL("Qry_Supp_INTERVENTION_N_ATT_DESP_Critères", RequetesSQL.Qry_Supp_INTERVENTION_N_ATT_DESP_Critères);
                ExecuteSQL("Qry_Regrp_Categ_DESP_P2_DNC", RequetesSQL.Qry_Regrp_Categ_DESP_P2_DNC);
                ExecuteSQL("Qry_Regrp_Categ_DESP_P2", RequetesSQL.Qry_Regrp_Categ_DESP_P2);
                ExecuteSQL("Qry_Regrp_Categ_DESP_P1", RequetesSQL.Qry_Regrp_Categ_DESP_P1);
                ExecuteSQL("Qry_Regrp_Categ_DESP_P3_1", RequetesSQL.Qry_Regrp_Categ_DESP_P3_1);
                ExecuteSQL("Qry_Regrp_Categ_DESP_P3_2", RequetesSQL.Qry_Regrp_Categ_DESP_P3_2);
                ExecuteSQL("Qry_Regrp_Categ_DESP_P4", RequetesSQL.Qry_Regrp_Categ_DESP_P4);
                ExecuteSQL("req_Regrp_Categ_DESP_P5_Sans_Categ", RequetesSQL.req_Regrp_Categ_DESP_P5_Sans_Categ);

                Calcul_Criticite_DESP();

                // DIS
                ExecuteSQL("req_Supp_INTERVENTION_N_ATT_DIS_Critères", RequetesSQL.req_Supp_INTERVENTION_N_ATT_DIS_Critères);
                ExecuteSQL("Delete_Interv_N_ATT_DIS_Critère_Creer", "DELETE * FROM INTERVENTION_N_ATT_DIS_Critères");

                // DEBUG - Avant req_Interv_N_ATT_DIS_Critère_Creer
                try
                {
                    using (var connDebug = new OleDbConnection(strConnectBdAccess.ToString()))
                    {
                        connDebug.Open();

                        // 1. Total dans INTERVENTION_N_ATT
                        OleDbCommand cmd1 = new OleDbCommand("SELECT COUNT(*) FROM INTERVENTION_N_ATT", connDebug);
                        InsertTableLogPlanificateur("SaisLot", "DEBUG1 - Total INTERVENTION_N_ATT: " + Convert.ToInt32(cmd1.ExecuteScalar()).ToString());

                        // 2. Valeurs distinctes S_INTRVT
                        OleDbCommand cmd2 = new OleDbCommand("SELECT DISTINCT S_INTRVT FROM INTERVENTION_N_ATT", connDebug);
                        OleDbDataReader reader2 = cmd2.ExecuteReader();
                        string valS = "";
                        while (reader2.Read()) { valS += "[" + reader2[0].ToString() + "] "; }
                        reader2.Close();
                        InsertTableLogPlanificateur("SaisLot", "DEBUG2 - S_INTRVT valeurs: " + valS);

                        // 3. Valeurs distinctes C_CODE_INTRVT
                        OleDbCommand cmd3 = new OleDbCommand("SELECT DISTINCT C_CODE_INTRVT FROM INTERVENTION_N_ATT", connDebug);
                        OleDbDataReader reader3 = cmd3.ExecuteReader();
                        string valC = "";
                        while (reader3.Read()) { valC += "[" + reader3[0].ToString() + "] "; }
                        reader3.Close();
                        InsertTableLogPlanificateur("SaisLot", "DEBUG3 - C_CODE_INTRVT valeurs: " + valC);

                        // 4. Valeurs distinctes C_ETAP_ACTL
                        OleDbCommand cmd4 = new OleDbCommand("SELECT DISTINCT C_ETAP_ACTL FROM INTERVENTION_N_ATT", connDebug);
                        OleDbDataReader reader4 = cmd4.ExecuteReader();
                        string valE = "";
                        while (reader4.Read()) { valE += "[" + reader4[0].ToString() + "] "; }
                        reader4.Close();
                        InsertTableLogPlanificateur("SaisLot", "DEBUG4 - C_ETAP_ACTL valeurs: " + valE);

                        // 5. Count S_INTRVT = 'Non débutée'
                        OleDbCommand cmd5 = new OleDbCommand("SELECT COUNT(*) FROM INTERVENTION_N_ATT WHERE S_INTRVT = 'Non débutée'", connDebug);
                        InsertTableLogPlanificateur("SaisLot", "DEBUG5 - S_INTRVT='Non débutée': " + Convert.ToInt32(cmd5.ExecuteScalar()).ToString());

                        // 6. Count S_INTRVT = 'En cours'
                        OleDbCommand cmd6 = new OleDbCommand("SELECT COUNT(*) FROM INTERVENTION_N_ATT WHERE S_INTRVT = 'En cours'", connDebug);
                        InsertTableLogPlanificateur("SaisLot", "DEBUG6 - S_INTRVT='En cours': " + Convert.ToInt32(cmd6.ExecuteScalar()).ToString());

                        // 7. Count C_ETAP_ACTL = 'Visite'
                        OleDbCommand cmd7 = new OleDbCommand("SELECT COUNT(*) FROM INTERVENTION_N_ATT WHERE C_ETAP_ACTL = 'Visite'", connDebug);
                        InsertTableLogPlanificateur("SaisLot", "DEBUG7 - C_ETAP_ACTL='Visite': " + Convert.ToInt32(cmd7.ExecuteScalar()).ToString());

                        // 8. Count itérations (N_INTRVT LIKE '%-_')
                        OleDbCommand cmd8 = new OleDbCommand("SELECT COUNT(*) FROM INTERVENTION_N_ATT WHERE N_INTRVT LIKE '*-?'", connDebug);
                        InsertTableLogPlanificateur("SaisLot", "DEBUG8 - Iterations: " + Convert.ToInt32(cmd8.ExecuteScalar()).ToString());

                        // 9. DIS potentielles
                        OleDbCommand cmd9 = new OleDbCommand("SELECT COUNT(*) FROM INTERVENTION_N_ATT WHERE ((S_INTRVT = 'Non débutée' AND C_CODE_INTRVT = 'Sécurité') OR (S_INTRVT = 'En cours' AND C_ETAP_ACTL = 'Visite'))", connDebug);
                        InsertTableLogPlanificateur("SaisLot", "DEBUG9 - DIS potentielles: " + Convert.ToInt32(cmd9.ExecuteScalar()).ToString());

                        connDebug.Close();
                    }
                }
                catch (Exception ex)
                {
                    InsertTableLogPlanificateur("SaisLot", "DEBUG ERROR: " + ex.Message);
                }

                ExecuteSQL("req_Interv_N_ATT_DIS_Critère_Creer", RequetesSQL.req_Interv_N_ATT_DIS_Critère_Creer);
                // ExecuteSQL("req_Supp_Intervention_N_ATT", RequetesSQL.req_Supp_Intervention_N_ATT);
                ExecuteSQL("req_Supp_INTERVENTION_N_ATT_DIS", RequetesSQL.req_Supp_INTERVENTION_N_ATT_DIS);
                ExecuteSQL("req_Interv_N_ATT_DIS_Ajout", RequetesSQL.req_Interv_N_ATT_DIS_Ajout);
                ExecuteSQL("req_Supp_INTERVENTION_N_ATT_DIS_Critères", RequetesSQL.req_Supp_INTERVENTION_N_ATT_DIS_Critères);
                ExecuteSQL("req_Regrp_Categ_DIS_P2_DNC", RequetesSQL.req_Regrp_Categ_DIS_P2_DNC);
                ExecuteSQL("req_Regrp_Categ_DIS_P2", RequetesSQL.req_Regrp_Categ_DIS_P2);
                ExecuteSQL("req_Regrp_Categ_DIS_P1", RequetesSQL.req_Regrp_Categ_DIS_P1);
                ExecuteSQL("req_Regrp_Categ_DIS_P3", RequetesSQL.req_Regrp_Categ_DIS_P3);
                ExecuteSQL("req_Regrp_Categ_DIS_P4", RequetesSQL.req_Regrp_Categ_DIS_P4);

                // Les itérations DIS héritent la catégorie selon leur type (même que le parent confirmé par Gerson)
                // Type 05→P1, Type 03→P3, Type 04→P4, Types 01/02/10+AP→P4, autres→P2
                ExecuteSQL("req_Categ_Iterations_DIS", RequetesSQL.req_Categ_Iterations_DIS);
                Calcul_Criticite_DIS();

                ExecuteSQL("req_Regrp_Categ_DIS_P5_Sans_Categ", RequetesSQL.req_Regrp_Categ_DIS_P5_Sans_Categ);
                ExecuteSQL("req_MAJ_Criticite_Intervenant_DIS", RequetesSQL.req_MAJ_Criticite_Intervenant_DIS);
                ExecuteSQL("req_MAJ_CRITICITE_CODE_QUALIF_SITE_DIS", RequetesSQL.req_MAJ_CRITICITE_CODE_QUALIF_SITE_DIS);
                ExecuteSQL("req_MAJ_CRITICITE_SITE_DIS", RequetesSQL.req_MAJ_CRITICITE_SITE_DIS);





                ExecuteSQL("req_Supp_tbl_Intervention_GIC", RequetesSQL.req_Supp_tbl_Intervention_GIC);
                ExecuteSQL("req_Creer_dbl_Intervention_GIC_DICC", RequetesSQL.req_Creer_dbl_Intervention_GIC_DICC);
                ExecuteSQL("req_Supp_INTERVENTION_N_ATT_DICC", RequetesSQL.req_Supp_INTERVENTION_N_ATT_DICC);
                ExecuteSQL("req_Creer_dbl_Intervention_GIC_DIS", RequetesSQL.req_Creer_dbl_Intervention_GIC_DIS);
                ExecuteSQL("req_Supp_INTERVENTION_N_ATT_DIS", RequetesSQL.req_Supp_INTERVENTION_N_ATT_DIS);
                ExecuteSQL("Qry_Creer_dbl_Intervention_GIC_DESP", RequetesSQL.Qry_Creer_dbl_Intervention_GIC_DESP);
                ExecuteSQL("Qry_Supp_INTERVENTION_N_ATT_DESP", RequetesSQL.Qry_Supp_INTERVENTION_N_ATT_DESP);
                ExecuteSQL("req_MAJ_Donnees_Fin", RequetesSQL.req_MAJ_Donnees_Fin);
                Qry_Maj_Intervt_Attrib_NonConfirm();
                ExecuteSQL("Qry_Sup_INTERVENTIONS_NonAttribuées", RequetesSQL.Qry_Sup_INTERVENTIONS_NonAttribuées);
                Qry_Add_InterventionsGIC();
                ExecuteSQL("Qry_Add_InterventionsGIC_DESP", RequetesSQL.Qry_Add_InterventionsGIC_DESP);
                Qry_MAJ_État_InterventionGIC();
                Qry_MAJ_CodePostal_Interv_CBCS();
                Qry_MAJ_SousRegion_tbl_Interventions();
                ExecuteSQL("Qry_MAJ_SousRegion_ERREUR_tbl_Interventions", RequetesSQL.Qry_MAJ_SousRegion_ERREUR_tbl_Interventions);
                Qry_Ajout_Site_Note_Contacts_Entrepreneurs();

                ExecuteSQL("Qry_Sup_GI3_INTERVENTION", RequetesSQL.Qry_Sup_GI3_INTERVENTION);
                Qry_Add_GI3_INTERVENTION();
                Qry_Add_GI3_INTERVENTION_DESP();
                ExecuteSQL("Qry_Sup_Interv_Annulé", RequetesSQL.Qry_Sup_Interv_Annulé);
                ExecuteSQL("Qry_MAJ_Internetions_AP_DESP", RequetesSQL.Qry_MAJ_Internetions_AP_DESP);
                ExecuteSQL("Qry_DICC_Rouge", RequetesSQL.Qry_DICC_Rouge);
                ExecuteSQL("Qry_DICC_Jaune", RequetesSQL.Qry_DICC_Jaune);
                ExecuteSQL("Qry_DICC_Vert", RequetesSQL.Qry_DICC_Vert);
                ExecuteSQL("Qry_DIS_Rouge", RequetesSQL.Qry_DIS_Rouge);
                ExecuteSQL("Qry_DIS_Violet", RequetesSQL.Qry_DIS_Violet);
                ExecuteSQL("Qry_DIS_Jaune", RequetesSQL.Qry_DIS_Jaune);
                ExecuteSQL("Qry_DIS_Bleu", RequetesSQL.Qry_DIS_Bleu);
                ExecuteSQL("Qry_DIS_Blanc", RequetesSQL.Qry_DIS_Blanc);
                ExecuteSQL("Qry_Sup_INTERVENTIONS_NonAttribuées_Dbl", RequetesSQL.Qry_Sup_INTERVENTIONS_NonAttribuées_Dbl);
                //  ExecuteSQL("Maj_IterationNonPriseEnChargeIntervFermee", RequetesSQL.Maj_IterationNonPriseEnChargeIntervFermee);
                //  ExecuteSQL("Maj_IterationNonPriseEnChargeIntervFermee2", RequetesSQL.Maj_IterationNonPriseEnChargeIntervFermee2);

                ExecuteSQL("tbl_SystemeEvent_fin", RequetesSQL.tbl_SystemeEvent_fin);

                if (succesLoadTable == false)
                {
                    LoadTableErreur = true;
                }


                if (LoadTableErreur == true)
                {
                    // Envois un courriel si erreur de programmation (SQL ou autre)
                    SendMailErreurMetier(EnvoyePar);
                }

                InsertTableLogPlanificateur("SaisLot", "Fin du traitement");


                SendMailConfirmation();

                // delete l'historique du dernier log de chargement
                DeleteTableLogJobChargement();
                mySQLConnection.Close();

            } //SAISLOT end of try 
            catch (Exception ex)
            {
                InsertTableLogJobPlanificateur("PLANTAGE_FATAL", "Erreur: " + ex.Message + " | StackTrace: " + (ex.StackTrace != null ? ex.StackTrace.Substring(0, Math.Min(200, ex.StackTrace.Length)) : ""));
                SendMailPlantage(ex);  // ← Nouveau nom
                Dts.TaskResult = (int)ScriptResults.Failure;
            }


            //     Détruit les informations dant la table Log_Job_Planificateur
            void DeleteTableLogJobChargement()
            {
                string sqlDelCmdCharg = RequetesSQL.delLogJobChargement.ToString();

                try
                {
                    SqlCommand DelCmdCharg = new SqlCommand(sqlDelCmdCharg.ToString(), mySQLConnection);
                    DelCmdCharg.CommandType = CommandType.Text;
                    SqlDataReader readerCharg = DelCmdCharg.ExecuteReader();
                    readerCharg.Read();
                    readerCharg.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogPlanificateur("ERR", "DeleteTableLogJobChargement()");
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute une instruction SQL
            ///
            /////////////////////////////////////////////////////////////////////
            void ExecuteSQL(string strCodeTraitement, string strSqlRequete)
            {
                string sqlCmd = strSqlRequete.ToString();
                InsertTableLogPlanificateur("SaisLot", strCodeTraitement);

                try
                {
                    using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                    {
                        conn.Open();
                        using (var transaction = conn.BeginTransaction())
                        {
                            OleDbCommand SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), conn, transaction);
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.ExecuteNonQuery();

                            transaction.Commit();
                        }
                        conn.Close();
                    }
                }
                catch (Exception ex)
                {

                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobPlanificateur("ExecuteSQL(" + strCodeTraitement + ")", ex.Message.ToString());
                    LoadTableErreur = true;
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute la requête "req_S_INTRVT_Interv_DNC" de l'ancien système 
            ///
            /////////////////////////////////////////////////////////////////////
            void req_S_INTRVT_Interv_DNC()
            {

                string strSqlRequete;
                string sqlCmdSelect = @"SELECT dbo_GI3_INTERVENTION.GI3_N_INTRVT, 
                                                                   dbo_GI3_INTERVENTION.GI3_S_INTRVT AS S_INTRVT_DNC 
                                                              FROM [SDGIC01].[dbo].[GI3_INTERVENTION] as dbo_GI3_INTERVENTION 
                                                              WHERE (((dbo_GI3_INTERVENTION.GI3_S_INTRVT) Like 'En cours%' OR (dbo_GI3_INTERVENTION.GI3_S_INTRVT) Like 'Non débutée%') 
                                                              AND    ((Right([GI3_N_INTRVT],2)) Not Like '-%'))";

                string Etape = "Select";

                InsertTableLogPlanificateur("SaisLot", "req_S_INTRVT_Interv_DNC");

                SqlConnection mySQLConnectionMaj = Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction) as SqlConnection;
                using (var conn = new OleDbConnection(strConnectBdAccess.ToString()))
                {
                    conn.Open();
                    using (OleDbTransaction transaction = conn.BeginTransaction())
                    {
                        try
                        {
                            SqlCommand commandDataReader = new SqlCommand(sqlCmdSelect, mySQLConnectionMaj);
                            SqlDataReader ValueReader = commandDataReader.ExecuteReader();
                            InsertTableLogPlanificateur("SaisLot", "ValueReader.HasRows = " + ValueReader.HasRows.ToString());
                            OleDbCommand SQLCommandExec = new OleDbCommand("INSERT", conn, transaction);

                            Etape = "Insert";

                            while (ValueReader.Read())
                            {
                                strSqlRequete = "insert into S_INTRVT_Interv_DNC ( GI3_N_INTRVT, S_INTRVT_DNC ) values('" + ValueReader["GI3_N_INTRVT"].ToString().TrimEnd() + "', '" + ValueReader["S_INTRVT_DNC"].ToString() + "')";
                                SQLCommandExec.CommandType = CommandType.Text;
                                SQLCommandExec.CommandText = strSqlRequete.ToString();
                                SQLCommandExec.CommandTimeout = 12000;
                                SQLCommandExec.ExecuteNonQuery();
                            }

                            transaction.Commit();
                            ValueReader.Close();
                        }
                        catch (Exception ex)
                        {
                            //MessageBox.Show(ex.Message);
                            InsertTableLogJobPlanificateur("req_S_INTRVT_Interv_DNC(" + Etape + ")", ex.Message.ToString());
                            LoadTableErreur = true;
                        }
                    }
                    conn.Close();
                }

                mySQLConnectionMaj.Close();
            }

