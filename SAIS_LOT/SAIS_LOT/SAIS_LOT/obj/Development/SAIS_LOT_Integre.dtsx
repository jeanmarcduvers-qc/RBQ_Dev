                        OleDbDataReader ValueReader_INTERVENTION_N_ATT_DESP = commandDataReader_INTERVENTION_N_ATT_DESP.ExecuteReader();

                        while (ValueReader_INTERVENTION_N_ATT_DESP.Read())
                        {
                            Etape = "Crit_Interv";
                            Crit_Interv = 0;
                            sqlCmd = "SELECT No_INTRVN, Resultat FROM Crit_Intervenant_DICC WHERE No_INTRVN = '" + ValueReader_INTERVENTION_N_ATT_DESP["C_INTRVN"].ToString() + "'";
                            commandDataReader = new OleDbCommand(sqlCmd, conn);
                            ValueReader = commandDataReader.ExecuteReader();

                            while (ValueReader.Read())
                            {
                                Crit_Interv = (double)ValueReader["Resultat"];
                            }
                            ValueReader.Close();

                            Etape = "Crit_Site";
                            Crit_Site = 0;
