																		"INTERVENTION_N_ATT_DIS_Critères.N_DEMN, INTERVENTION_N_ATT_DIS_Critères.C_INTRVN, " +
																		"INTERVENTION_N_ATT_DIS_Critères.C_INTRVT, INTERVENTION_N_ATT_DIS_Critères.D_CRET, " +
																		"INTERVENTION_N_ATT_DIS_Critères.D_OUVE_INTRVT, INTERVENTION_N_ATT_DIS_Critères.C_CODE_INTRVT, " +
																		"INTERVENTION_N_ATT_DIS_Critères.C_TYPE_INTRVT, INTERVENTION_N_ATT_DIS_Critères.C_DE_TYPE_INTRVT, " +
																		"INTERVENTION_N_ATT_DIS_Critères.N_REGR, INTERVENTION_N_ATT_DIS_Critères.C_DE_REGR, " +
																		"INTERVENTION_N_ATT_DIS_Critères.S_INTRVT, INTERVENTION_N_ATT_DIS_Critères.C_RISQ, " +
																		"INTERVENTION_N_ATT_DIS_Critères.DE_DOMN_INTRVT, INTERVENTION_N_ATT_DIS_Critères.CATEGORIE, " +
																		"INTERVENTION_N_ATT_DIS_Critères.D_CRET_DEMN, INTERVENTION_N_ATT_DIS_Critères.D_RECEPTION_DEMN, " +
																		"INTERVENTION_N_ATT_DIS_Critères.D_CRET_NOTE, INTERVENTION_N_ATT_DIS_Critères.C_SUJT_NOTE_INTR, " +
																		"INTERVENTION_N_ATT_DIS_Critères.C_SOUS_SUJT_NOTE, INTERVENTION_N_ATT_DIS_Critères.DE_NOTE, " +
																		"INTERVENTION_N_ATT_DIS_Critères.C_ADRE_SITE, INTERVENTION_N_ATT_DIS_Critères.C_CODPOST_SITE, " +
																		"INTERVENTION_N_ATT_DIS_Critères.C_COD_QUALF_SITE, INTERVENTION_N_ATT_DIS_Critères.C_DESC_COD_QUALF_SITE, " +
																		"INTERVENTION_N_ATT_DIS_Critères.C_VILLE_SITE, INTERVENTION_N_ATT_DIS_Critères.REGION, " +
																		"INTERVENTION_N_ATT_DIS_Critères.SOUS_REGION, INTERVENTION_N_ATT_DIS_Critères.V_AIRE_BATM, " +
																		"INTERVENTION_N_ATT_DIS_Critères.V_CAPC_MAXM_BATM, INTERVENTION_N_ATT_DIS_Critères.NM_INTRVN, " +
																		"INTERVENTION_N_ATT_DIS_Critères.C_ETAP_ACTL, INTERVENTION_N_ATT_DIS_Critères.CRITICITE_INTRVT, " +
																		"INTERVENTION_N_ATT_DIS_Critères.CRITICITE_SITE, INTERVENTION_N_ATT_DIS_Critères.CRITICITE_INTRVN, " +
																		"INTERVENTION_N_ATT_DIS_Critères.D_CRET_NON_CONFORMITE, INTERVENTION_N_ATT_DIS_Critères.V_DELA, " +
																		"INTERVENTION_N_ATT_DIS_Critères.D_ATTRIBUTION_INTRVT, INTERVENTION_N_ATT_DIS_Critères.CRITICITE_CODE_QUALIF_SITE, " +
																		"INTERVENTION_N_ATT_DIS_Critères.SELECT_DOSSIER, INTERVENTION_N_ATT_DIS_Critères.NM_ENDR, " +
																		"INTERVENTION_N_ATT_DIS_Critères.N_INTRL, INTERVENTION_N_ATT_DIS_Critères.D_CONFIRMATION_ATTRIB, " +
																		"INTERVENTION_N_ATT_DIS_Critères.DIRECTION, INTERVENTION_N_ATT_DIS_Critères.USER_ATTRIB, " +
																		"INTERVENTION_N_ATT_DIS_Critères.[Q_ ETAG_BATM] " +
																"FROM   INTERVENTION_N_ATT_DIS_Critères " +
																"WHERE  (([Aj_30] > 0) = False) " +
																"AND    ((IIf(Not IsNull(INTERVENTION_N_ATT_DIS_Critères.Date_Ech_Non_Conf) " +
																"        AND (Right(INTERVENTION_N_ATT_DIS_Critères.N_INTRVT, 2) = '-1' " +
																"             OR Right(INTERVENTION_N_ATT_DIS_Critères.N_INTRVT, 2) = '-2' " +
																"             OR Right(INTERVENTION_N_ATT_DIS_Critères.N_INTRVT, 2) = '-3'), " +
																"        INTERVENTION_N_ATT_DIS_Critères.Date_Ech_Non_Conf > Date())) = False " +
																"       OR (IIf(Not IsNull(INTERVENTION_N_ATT_DIS_Critères.Date_Ech_Non_Conf) " +
																"              AND (Right(INTERVENTION_N_ATT_DIS_Critères.N_INTRVT, 2) = '-1' " +
																"                   OR Right(INTERVENTION_N_ATT_DIS_Critères.N_INTRVT, 2) = '-2' " +
																"                   OR Right(INTERVENTION_N_ATT_DIS_Critères.N_INTRVT, 2) = '-3'), " +
																"              INTERVENTION_N_ATT_DIS_Critères.Date_Ech_Non_Conf > Date())) Is Null)";

		public const string req_Regrp_Categ_DIS_P2_DNC = "UPDATE INTERVENTION_N_ATT_DIS SET INTERVENTION_N_ATT_DIS.CATEGORIE = 'P2' " +
														 "WHERE  (((INTERVENTION_N_ATT_DIS.CATEGORIE) Is Null) " +
														 "AND	  ((Right([N_INTRVT], 2)) = '-1' " +
														 "Or	   (Right([N_INTRVT], 2)) = '-2' " +
														 "Or	   (Right([N_INTRVT], 2)) = '-3') " +
														 "AND     ((INTERVENTION_N_ATT_DIS.S_INTRVT) Like 'En cours') " +
														 "AND     ((INTERVENTION_N_ATT_DIS.C_ETAP_ACTL) = 'Délai échu / CV' " +
														 "Or	   (INTERVENTION_N_ATT_DIS.C_ETAP_ACTL) = 'CV suppl à effectuer' " +
														 "Or	   (INTERVENTION_N_ATT_DIS.C_ETAP_ACTL) = 'CV à effectuer'))";

		public const string req_Regrp_Categ_DIS_P2 = "UPDATE INTERVENTION_N_ATT_DIS SET INTERVENTION_N_ATT_DIS.CATEGORIE = 'P2' " +
													 "WHERE  (((INTERVENTION_N_ATT_DIS.CATEGORIE) Is Null) " +
													 "AND     ((INTERVENTION_N_ATT_DIS.S_INTRVT) Not Like 'Non débutée*'))";

		public const string req_Regrp_Categ_DIS_P1 = "UPDATE INTERVENTION_N_ATT_DIS SET INTERVENTION_N_ATT_DIS.CATEGORIE = 'P1' " +
													 "WHERE  (((INTERVENTION_N_ATT_DIS.CATEGORIE) Is Null) " +
													 "AND     ((INTERVENTION_N_ATT_DIS.C_TYPE_INTRVT) = '05'))";

		public const string req_Regrp_Categ_DIS_P3 = "UPDATE INTERVENTION_N_ATT_DIS SET INTERVENTION_N_ATT_DIS.CATEGORIE = 'P3' " +
													 "WHERE  (((INTERVENTION_N_ATT_DIS.CATEGORIE) Is Null) " +
													 "AND     ((INTERVENTION_N_ATT_DIS.C_TYPE_INTRVT) = '03'))";

		public const string req_Regrp_Categ_DIS_P4 = "UPDATE INTERVENTION_N_ATT_DIS SET INTERVENTION_N_ATT_DIS.CATEGORIE = 'P4' " +
													 "WHERE  (((INTERVENTION_N_ATT_DIS.CATEGORIE) Is Null) " +
													 "AND     ((INTERVENTION_N_ATT_DIS.C_TYPE_INTRVT) = '01' " +
													 "Or       (INTERVENTION_N_ATT_DIS.C_TYPE_INTRVT) = '02' " +
													 "Or       (INTERVENTION_N_ATT_DIS.C_TYPE_INTRVT) = '10') " +
													 "AND     ((Left([DE_DOMN_INTRVT], 2)) = 'AP')) " +
													 "OR     (((INTERVENTION_N_ATT_DIS.CATEGORIE) Is Null) " +
													 "AND     ((INTERVENTION_N_ATT_DIS.C_TYPE_INTRVT) = '04' " +
													 "Or       (INTERVENTION_N_ATT_DIS.C_TYPE_INTRVT) = '11' " +
													 "Or       (INTERVENTION_N_ATT_DIS.C_TYPE_INTRVT) = '12'))";

		public const string req_Categ_Iterations_DIS = "UPDATE INTERVENTION_N_ATT_DIS " +
														"SET CATEGORIE = IIF([C_TYPE_INTRVT]='05','P1', " +
														"IIF([C_TYPE_INTRVT]='03','P3', " +
														"IIF([C_TYPE_INTRVT]='04','P4', " +
														"IIF([C_TYPE_INTRVT] IN ('01','02','10') AND Left([DE_DOMN_INTRVT],2)='AP','P4','P2')))) " +
														"WHERE [CATEGORIE] = 'P2' " +
														"AND [C_CODE_INTRVT] = 'Sécurité'";

		public const string req_Regrp_Categ_DIS_P5_Sans_Categ = "UPDATE INTERVENTION_N_ATT_DIS SET INTERVENTION_N_ATT_DIS.CATEGORIE = 'P5' " +
																"WHERE  (((INTERVENTION_N_ATT_DIS.CATEGORIE) Is Null))";

		public const string req_MAJ_Criticite_Intervenant_DIS = "UPDATE INTERVENTION_N_ATT_DIS " +
																	"LEFT JOIN NOTE_INTERVENANT_DIS ON INTERVENTION_N_ATT_DIS.C_INTRVN = NOTE_INTERVENANT_DIS.No_intervenant " +
																"SET INTERVENTION_N_ATT_DIS.CRITICITE_INTRVN = [NOTE_INTERVENANT_DIS].[Total Intervenant]";

		public const string req_MAJ_CRITICITE_CODE_QUALIF_SITE_DIS = "UPDATE INTERVENTION_N_ATT_DIS " +
																		"LEFT JOIN NOTE_CODE_QUALIF_DIS ON INTERVENTION_N_ATT_DIS.C_COD_QUALF_SITE = NOTE_CODE_QUALIF_DIS.Code " +
																	 "SET INTERVENTION_N_ATT_DIS.CRITICITE_CODE_QUALIF_SITE = [NOTE_CODE_QUALIF_DIS].[Total code de qualif]";

		public const string req_MAJ_CRITICITE_SITE_DIS = "UPDATE INTERVENTION_N_ATT_DIS " +
															"LEFT JOIN NOTE_SITE ON INTERVENTION_N_ATT_DIS.N_SITE = NOTE_SITE.No_site " +
														 "SET INTERVENTION_N_ATT_DIS.CRITICITE_SITE = [NOTE_SITE].[Total Site]";

		public const string req_P1_DIS_Min_Max = "SELECT Min(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Min_P1, " +
														"Max(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Max_P1 " +
												 "FROM   INTERVENTION_N_ATT_DIS " +
												 "GROUP BY INTERVENTION_N_ATT_DIS.CATEGORIE " +
												 "HAVING(((INTERVENTION_N_ATT_DIS.CATEGORIE) = 'P1'))";

		public const string req_P3_DIS_Min_Max = "SELECT Min(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Min_P3, " +
														"Max(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Max_P3 " +
												 "FROM   INTERVENTION_N_ATT_DIS " +
												 "GROUP BY INTERVENTION_N_ATT_DIS.CATEGORIE " +
												 "HAVING(((INTERVENTION_N_ATT_DIS.CATEGORIE) = 'P3'))";

		public const string req_P4_DIS_Min_Max = "SELECT Min(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Min_P4, " +
														"Max(IIf(IsNull([D_RECEPTION_DEMN]),[D_CRET],[D_RECEPTION_DEMN])) AS Max_P4 " +
												 "FROM   INTERVENTION_N_ATT_DIS " +
												 "GROUP BY INTERVENTION_N_ATT_DIS.CATEGORIE " +
												 "HAVING (((INTERVENTION_N_ATT_DIS.CATEGORIE) = 'P4'))";

		public const string req_Delai_Ref_Min_Max_DIS = "SELECT Min(IIf(Not IsNull([D_CRET_NON_CONFORMITE]), DateDiff('d', DateAdd('d', iif(isnull([V_DELA]), 0, [V_DELA]), [D_CRET_NON_CONFORMITE]), #10/20/2017#))) AS Min_Delai_Ref, " +
																"Max(IIf(Not IsNull([D_CRET_NON_CONFORMITE]),DateDiff('d', DateAdd('d', iif(isnull([V_DELA]), 0, [V_DELA]), [D_CRET_NON_CONFORMITE]),#10/20/2017#))) AS Max_Delai_Ref " +
