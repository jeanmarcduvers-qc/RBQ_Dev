                                            "WHERE StatutActif = True " +
                                            //"AND   IndSystem = 'RECLAMATION' " +
                                            //"AND   LoadSort in (1) " +
                                            //"AND   SqlTable in ('BGP_Plaintes', 'SV_Dossier') " +
