        public const string tblLoadTable = "SELECT IndSystem, " +
                                                  "SqlTable, " +
                                                  "AccesTable,  " +
                                                  "TypeFichier,  " +
                                                  "OngletACharger,  " +
                                                  "NbrColonnes,  " +
