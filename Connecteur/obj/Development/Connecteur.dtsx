                    SqlCommand checkTableIfExistsCommand = new SqlCommand("IF OBJECT_ID('" + pNomTableSysObjects.ToString() + "', 'U') IS NOT NULL drop table " + pNomTableSysObjects.ToString(), mySQLConnection);
                    checkTableIfExistsCommand.CommandType = CommandType.Text;
                    SqlDataReader readerIfExists = checkTableIfExistsCommand.ExecuteReader();
                    readerIfExists.Read();
                    readerIfExists.Close();

                    Etape = "createTableBuilder";
                    var createTableBuilder = new StringBuilder("CREATE TABLE " + pNomTableUtiliseUser.ToString());
                    createTableBuilder.AppendLine("(");

                    // Sélectionner chacune des colonnes de la table source pour créer la table destination
                    foreach (DataColumn dc in dataReader.Columns)
                    {
                        switch (dc.DataType.Name)
                        {
                            case "String":
                                if ((dc.MaxLength > 4000) || (dc.MaxLength == -1))
                                {
                                    createTableBuilder.AppendLine(String.Format("[{0}] VARCHAR(MAX),",
                                      dc.ColumnName));
                                }
                                else
                                {
                                    createTableBuilder.AppendLine(String.Format("[{0}] varchar(4000),",
                                      dc.ColumnName));
                                }
                                break;
                            case "Money":
                            case "Decimal":
                                createTableBuilder.AppendLine(String.Format("[{0}] decimal(35,10),",
                                     dc.ColumnName));
                                break;
                            case "DateTime":
                                createTableBuilder.AppendLine(String.Format("[{0}] datetime,",
                                     dc.ColumnName));
                                break;
                            case "Int32":
                                createTableBuilder.AppendLine(String.Format("[{0}] int,",
                                     dc.ColumnName));
                                break;
                            case "Boolean":
                                createTableBuilder.AppendLine(String.Format("[{0}] bit,",
                                     dc.ColumnName));
                                break;
                            case "Single":
                                createTableBuilder.AppendLine(String.Format("[{0}] real,",
                                     dc.ColumnName));
                                break;
                            case "Byte":
                                createTableBuilder.AppendLine(String.Format("[{0}] tinyint,",
                                     dc.ColumnName));
                                break;
                            case "Int16":
                                createTableBuilder.AppendLine(String.Format("[{0}] smallint,",
                                     dc.ColumnName));
                                break;
                            case "Double":
                                createTableBuilder.AppendLine(String.Format("[{0}] float,",
                                     dc.ColumnName));
                                break;
                            default:
                                //MessageBox.Show(String.Format("{0}.[{1}] {2}",
                                //  pNomTableAccessUtilise,
                                //  dc.ColumnName,
                                //  dc.DataType.Name
                                //));
                                InsertTableLogJobConnecteur("TransferTableToSqlServer(AppendLine)", String.Format("{0}.[{1}] {2}",
                                  pNomTableAccessUtilise,
                                  dc.ColumnName,
                                  dc.DataType.Name));
                                succesLoadTable = false;
                                break;
                        }
                    }

                    // Valide si la table existe
                    Etape = "checkTableIfExistsCommand :: " + pNomTableUtiliseUser.ToString();
                    checkTableIfExistsCommand = new SqlCommand("IF OBJECT_ID('" + pNomTableUtiliseUser.ToString() + "', 'U') IS NOT NULL drop table " + pNomTableUtiliseUser.ToString(), mySQLConnection);
                    checkTableIfExistsCommand.CommandType = CommandType.Text;
                    checkTableIfExistsCommand.CommandTimeout = 12000;
                    readerIfExists = checkTableIfExistsCommand.ExecuteReader();
                    readerIfExists.Read();
                    readerIfExists.Close();

                    createTableBuilder.Remove(createTableBuilder.Length - 2, 2).ToString();
                    createTableBuilder.AppendLine(")");
                    createTableBuilder.Replace(",)", ")");
                    try
                    {
                        var createTableCommand = new SqlCommand(createTableBuilder.ToString(), mySQLConnection);
                        createTableCommand.ExecuteNonQuery();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show("ex.Message ::  " + ex.Message);
                        InsertTableLogJobConnecteur("TransferTableToSqlServer(createTableBuilder)", ex.Message.ToString());
                        succesLoadTable = false;
                    }

                    try
                    {
                        using (var bulkCopy = new SqlBulkCopy(mySQLConnection))
                        {
                            Etape = "commandSourceData.ExecuteReader";
                            commandSourceData.CommandTimeout = 18000;
                            SqlDataReader readers = commandDataReader.ExecuteReader(CommandBehavior.KeyInfo);
                            bulkCopy.BulkCopyTimeout = 0;
                            bulkCopy.DestinationTableName = pNomTableUtiliseUser.ToString();
                            bulkCopy.WriteToServer(readers);
                        }
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show("ex.Message ::  " + ex.Message);
                        InsertTableLogJobConnecteur("TransferTableToSqlServer(bulkCopy)", ex.Message.ToString());
                        succesLoadTable = false;
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobConnecteur("TransferTableToSqlServer(" + Etape.ToString() + ")", ex.Message.ToString());
                    succesLoadTable = false;
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Transfert la table temporaire dans la table maitre de SQL Server
            ///
            ///////////////////////////////////////////////////////////////////////
            void TransferTableSqlVersDBO(string pNomTableSource, string pNomTableDestination)
            {
                string sqlCmd = "SELECT * INTO " + pNomTableDestination.ToString() + " FROM " + pNomTableSource.ToString();
                string sqlCmd2 = "drop table " + pNomTableSource.ToString();


                // Valide si la table existe
                SqlCommand checkTableIfExistsCommand = new SqlCommand("IF OBJECT_ID('" + pNomTableDestination.ToString() + "', 'U') IS NOT NULL drop table " + pNomTableDestination.ToString(), mySQLConnection);
                checkTableIfExistsCommand.CommandType = CommandType.Text;
                SqlDataReader readerIfExists = checkTableIfExistsCommand.ExecuteReader();
                readerIfExists.Read();
                readerIfExists.Close();

                try
                {
                    // Copy la table dans le bon shéma
                    SqlCommand SQLCommandVers = new SqlCommand(sqlCmd.ToString(), mySQLConnection);
                    SQLCommandVers.CommandType = CommandType.Text;
                    SqlDataReader readerVers = SQLCommandVers.ExecuteReader();
                    readerVers.Read();
                    readerVers.Close();

                    // Détruire la table source
                    DestructionTable(pNomTableSource.ToString());
                }
                catch (Exception ex)
                {
                    //MessageBox.Show("ex.Message ::  " + ex.Message);
                    InsertTableLogJobConnecteur("TransferTableSqlVersDBO()", ex.Message.ToString());
                    succesLoadTable = false;
                    LoadTableErreur = true;
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute une instruction SQL
            ///
            /////////////////////////////////////////////////////////////////////
            void ExecuteSQL(string strIndSystem, string strSqlRequete)
            {
                InsertTableLogChargement(strIndSystem.ToString(), "ExecuteSQL");
                string sqlInsCmd = strSqlRequete.ToString();
                DestructionTable(oATable.ToString());

                try
                {
                    SqlCommand SQLCommandExec = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandExec.CommandType = CommandType.Text;
                    SQLCommandExec.CommandTimeout = 12000;
                    SqlDataReader readerExec = SQLCommandExec.ExecuteReader();
                    readerExec.Read();
                    readerExec.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobConnecteur("ExecuteSQL()", ex.Message.ToString());
                    LoadTableErreur = true;
                }
            }

