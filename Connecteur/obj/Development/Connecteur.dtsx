        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        public void Main()
        {
            TraiteConnecteur();
            Dts.TaskResult = (int)ScriptResults.Success;
        }


        public void TraiteConnecteur()
        {
            bool succesLoadTable = true;
            bool LoadTableErreur = false;
            bool TraiteLaSuite = true;
            string strMessageSql = "";
            if (userlogin.ToString() != "ce_366_gic_Info_it")
            {
                SchemasUser = "[MTR\\" + userlogin.ToString() + "].";
            }
            else
            {
                SchemasUser = "MTR.";
            }

            string date = DateTime.Now.ToString("yyyy-MM-dd hh:mm:ss");
            string EnvoyePar = Dts.Variables["User::EnvoyePar"].Value.ToString();
            string ConnectStringAccess = @Dts.Variables["User::ConnectStringAccess"].Value.ToString();

            SqlConnection mySQLConnection =
                Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                as SqlConnection;

            SqlConnection mySQLConnectionSupp =
                Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                as SqlConnection;

            SqlConnection mySQLConnection2 =
                Dts.Connections["ConnectBD_SQL_RBQ_Donnees"].AcquireConnection(Dts.Transaction)
                as SqlConnection;

            OleDbConnection connectionAccess = new OleDbConnection(ConnectStringAccess);

            // delete l'historique du dernier log de chargement
            DeleteTableLogChargement();
            DeleteTableLogJobChargement();
            InsertTableLogChargement("Connecteur", "Début du traitement");

            // Connecter à la BD   
            try
            {
                connectionAccess.Open();
            }
            catch (Exception ex)
            {
                //MessageBox.Show(ex.Message);
                InsertTableLogJobConnecteur("TraiteConnecteur(connectionAccess.Open())", ex.Message.ToString());
            }

            // Creation de la commande
            OleDbCommand command = new OleDbCommand(tblLoadTable.ToString(), connectionAccess);

            // Exécute la requete
            try
            {

                // Exécute la commande  
                using (OleDbDataReader reader = command.ExecuteReader())
                {
                    // Lire les occurrences de la table LoadTable
                    while (reader.Read())
                    {
                        succesLoadTable = true;
                        TraiteLaSuite = true;

                        oSystem = reader["IndSystem"].ToString();
                        oNomTableUtilise = reader["SqlTable"].ToString();
                        oSqlTable = reader["SqlTable"].ToString();
                        oAccesTable = reader["AccesTable"].ToString();
                        oAccesFonction = reader["AccesTable"].ToString();
                        oStatutActif = bool.Parse(reader["StatutActif"].ToString());
                        oNomTableSharePoint = reader["NomTableSharePoint"].ToString();
                        oLienSharePoint = reader["LienSharePoint"].ToString();
                        oNomColonneSharePoint = reader["NomColonneSharePoint"].ToString();
                        oNomColonneSqlServer = reader["NomColonneSqlServer"].ToString();
                        oTypeFichier = reader["TypeFichier"].ToString();
                        oCheminFichier = reader["CheminFichier"].ToString();
                        oNomDuFichier = reader["NomDuFichier"].ToString();
                        oSQLConnect = reader["SQLConnect"].ToString();

                        if (oStatutActif)
                        {
                            switch (oSystem.ToString())
                            {
                                case "VPE":
                                    oNomTableSysObjects = "SDDMUVPE." + oNomTableUtilise;
                                    oNomTableUtiliseSystem = "[SDDMU01].[SDDMUVPE].[" + oNomTableUtilise + "]";
                                    oNomTableUtiliseUser = "[SDDMU01].[SDDMUVPE].[" + oNomTableUtilise + "_tmp]";
                                    break;
                                case "PLAINTESGEN":
                                    oNomTableSysObjects = "PlaintesGen." + oNomTableUtilise;
                                    oNomTableUtiliseSystem = "[SDDMU01].[PlaintesGen].[" + oNomTableUtilise + "]";
                                    oNomTableUtiliseUser = "[SDDMU01].[PlaintesGen].[" + oNomTableUtilise + "_tmp]";
                                    break;
                                case "RECLAMATION":
                                    oNomTableSysObjects = "Reclamation." + oNomTableUtilise;
                                    oNomTableUtiliseSystem = "[SDDMU01].[Reclamation].[" + oNomTableUtilise + "]";
                                    oNomTableUtiliseUser = "[SDDMU01].[Reclamation].[" + oNomTableUtilise + "_tmp]";
                                    break;
                                default:
                                    oNomTableSysObjects = "dbo." + oNomTableUtilise;
                                    oNomTableUtiliseSystem = "[SDDMU01].[dbo].[" + oNomTableUtilise + "]";
                                    oNomTableUtiliseUser = "[SDDMU01].[dbo].[" + oNomTableUtilise + "_tmp]";
                                    break;
                            }

                            oNomTableSource = SchemasUser.ToString() + "[" + oNomTableUtilise.ToString() + "]";
                            oNomTableDestination = oNomTableUtilise.ToString();

                            switch (oTypeFichier.ToString())
                            {
                                case "Access":
                                case "SqlServer":
                                case "Excel":
                                    if (oSQLConnect.ToString() == "" && oTypeFichier.ToString() == "Access")
                                    {
                                        TransferTableToSqlServer(oAccesTable, oNomTableUtiliseUser.ToString(), oNomTableUtiliseSystem.ToString(), oNomTableSysObjects.ToString(), oSQLConnect.ToString());
                                    }
                                    else
                                    {
                                        TransferSqlServerToSqlServer(oAccesTable, oNomTableUtiliseUser.ToString(), oNomTableUtiliseSystem.ToString(), oNomTableSysObjects.ToString(), oSQLConnect.ToString()); ;
                                    }
                                    break;
                                case "SharePointUserInfo":
                                    TransferUserInfoSharePointToSqlServer(oNomTableSharePoint, oNomTableUtiliseUser.ToString(), oNomTableUtiliseSystem.ToString(), oNomTableSysObjects.ToString(), oLienSharePoint.ToString(), oNomColonneSharePoint.ToString(), oNomColonneSqlServer.ToString());
                                    break;
                                case "SharePoint":
                                    TransferTableSharePointToSqlServer(oNomTableSharePoint, oNomTableUtiliseUser.ToString(), oNomTableUtiliseSystem.ToString(), oNomTableSysObjects.ToString(), oLienSharePoint.ToString(), oNomColonneSharePoint.ToString(), oNomColonneSqlServer.ToString());
                                    break;
                                case "MacroAccess":
                                    CallStoredProcedure(oCheminFichier.ToString(), oAccesFonction.ToString());
                                    TraiteLaSuite = false;
                                    break;
                                default:
                                    InsertTableLogJobConnecteur("TraiteConnecteur(default)", "Ce type de fichier " + oTypeFichier.ToString() + " n'est pas traité par le Connecteur (SSIS).");
                                    succesLoadTable = false;
                                    break;
                            }

                            if (succesLoadTable != false && TraiteLaSuite != false)
                            {
                                DestructionTable(oNomTableUtiliseSystem);
                            }

                            if (succesLoadTable != false && TraiteLaSuite != false)
                            {
                                TransferTableSqlVersDBO(oNomTableUtiliseUser.ToString(), oNomTableUtiliseSystem.ToString());
                            }


                            if (succesLoadTable != false)
                            {
                                InsertTableLogChargement(oSystem.ToString(), oSqlTable.ToString());
                            }
                            else
                            {
                                LoadTableErreur = true;
                            }
                        }
                    }
                    reader.Close();
                }
            }
            catch (Exception ex)
            {
                //MessageBox.Show(ex.Message);
                InsertTableLogJobConnecteur("TraiteConnecteur()", ex.Message.ToString());
                succesLoadTable = false;
                LoadTableErreur = true;
            }

            
            if (LoadTableErreur != true)
            {
                // Traite tache supplementaire dans SQL Server
                TacheSupplementaire();
            }

            if (LoadTableErreur == true)
            {
                // Envois un courriel si erreur de programmation (SQL ou autre)
                SendMailMessageError(EnvoyePar);
            }

            InsertTableLogChargement("Connecteur", "Fin du traitement");
            mySQLConnection.Close();
            connectionAccess.Close();

            //////////////////////////////////////////////////////////////////////
            ///
            //     Traite tache supplementaire dans SQL Server
            ///
            /////////////////////////////////////////////////////////////////////
            void TacheSupplementaire()
            {
                InsertTableLogChargement("TacheSupplementaire", "Début du traitement");

                // Creation de la commande
                SqlCommand SQLCommandSup = new SqlCommand(tblTacheSupplementaire.ToString(), mySQLConnectionSupp);

                // Exécute la requete
                try
                {

                    // Exécute la commande  
                    using (SqlDataReader readerSQLsup = SQLCommandSup.ExecuteReader())
                    {
                        // Lire les occurrences de la table LoadTable
                        while (readerSQLsup.Read())
                        {
                            oSystem = readerSQLsup["IndSystem"].ToString();
                            oSqlTable = readerSQLsup["ATable"].ToString();
                            oDeTable = readerSQLsup["DeTable"].ToString();
                            oATable = readerSQLsup["ATable"].ToString();
                            oRequete = readerSQLsup["Requete"].ToString();
                            oActionType = readerSQLsup["ActionType"].ToString();
                            oLoadSort = readerSQLsup["LoadSort"].ToString();
                            oStrStatutActif = readerSQLsup["StatutActif"].ToString();

                            if (oStrStatutActif.ToUpper() == "OUI")
                            {

                                switch (oActionType.ToString())
                                {
                                    case "Requête":
                                        ExecuteSQL(oSystem.ToString(), oRequete.ToString());
                                        break;
                                    case "StoreProc":
                                        ExecuteStoreProc(oSystem.ToString(), oRequete.ToString());
                                        break;
                                    case "Supprimer table":
                                        InsertTableLogChargement(oSystem, "DestructionTable()");
                                        DestructionTable(oDeTable.ToString());
                                        break;
                                    case "Renommer":
                                        InsertTableLogChargement(oSystem, "TransferTableSqlVersDBO()");
                                        TransferTableSqlVersDBO(oDeTable.ToString(), oATable.ToString());
                                        break;
                                    default:
                                        InsertTableLogJobConnecteur("TacheSupplementaire()", "Ce type de fichier " + oTypeFichier.ToString() + " n'est pas traité par le Connecteur (SSIS).");
                                        succesLoadTable = false;
                                        break;
                                }
                            }
                        }
                        readerSQLsup.Close();
                    }
                    InsertTableLogChargement("TacheSupplementaire", "Fin du traitement");
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobConnecteur("TacheSupplementaire( " + oTypeFichier.ToString() + " - Ordre :: " + oLoadSort.ToString() + " )", ex.Message.ToString());
                    succesLoadTable = false;
                    LoadTableErreur = true;
                }
            }

