            void InsertTableLogChargement(string strIndSystem, string strSqlTable)
            {
                string sqlInsCmd = "insert into[SDDMU01].[dbo].[Log_Chargement_Connecteur] values('Connecteur', '" + strIndSystem + "', '" + strSqlTable + "', GETDATE(), 'Auto01', 'Tâche Automatisée')";

                try
