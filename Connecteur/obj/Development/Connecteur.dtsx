                                            "AND   Ucase(TraiteLundi) = 'O') " +
                                            "OR    (Weekday(now()) = 3 " +
                                            "AND   Ucase(TraiteMardi) = 'O') " + "" +
                                            "OR    (Weekday(now()) = 4 " +
                                            "AND   Ucase(TraiteMercredi) = 'O') " +
                                            "OR    (Weekday(now()) = 5 " +
                                            "AND   Ucase(TraiteJeudi) = 'O') " +
                                            "OR    (Weekday(now()) = 6 " +
                                            "AND   Ucase(TraiteVendredi) = 'O') " +
                                            "OR    (Weekday(now()) = 7 " +
                                            "AND   Ucase(TraiteSamedi) = 'O') " +
                                            "OR    (Weekday(now()) = 1 " +
                                            "AND   Ucase(TraiteDimanche) = 'O') " +
                                            "OR    (Ucase(TraiteSemaine) = 'O') " +
                                            "OR    ([TraiteLaJournée] = day(now())))  " +
