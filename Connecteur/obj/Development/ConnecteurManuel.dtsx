                    SqlCommand checkTableIfExistsCommand = new SqlCommand("IF OBJECT_ID('" + pNomTableSysObjects.ToString() + "', 'U') IS NOT NULL drop table " + pNomTableSysObjects.ToString(), mySQLConnection);
                    checkTableIfExistsCommand.CommandType = CommandType.Text;
                    SqlDataReader readerIfExists = checkTableIfExistsCommand.ExecuteReader();
                    readerIfExists.Read();
                    readerIfExists.Close();

                    Etape = "createTableBuilder";
                    var createTableBuilder = new StringBuilder("CREATE TABLE " + pNomTableUtiliseUser.ToString());
                    createTableBuilder.AppendLine("(");

                    // Sélectionner chacune des colonnes de la table source pour créer la table destination
                    foreach (DataColumn dc in dataReader.Columns)
                    {
                        switch (dc.DataType.Name)
                        {
                            case "String":
                                if ((dc.MaxLength > 4000) || (dc.MaxLength == -1))
                                {
                                    createTableBuilder.AppendLine(String.Format("[{0}] VARCHAR(MAX),",
                                      dc.ColumnName));
                                }
                                else
                                {
                                    createTableBuilder.AppendLine(String.Format("[{0}] varchar(4000),",
                                      dc.ColumnName));
                                }
                                break;
                            case "Money":
                            case "Decimal":
                                createTableBuilder.AppendLine(String.Format("[{0}] decimal(35,10),",
                                     dc.ColumnName));
                                break;
                            case "DateTime":
                                createTableBuilder.AppendLine(String.Format("[{0}] datetime,",
                                     dc.ColumnName));
                                break;
                            case "Int32":
                                createTableBuilder.AppendLine(String.Format("[{0}] int,",
                                     dc.ColumnName));
                                break;
                            case "Boolean":
                                createTableBuilder.AppendLine(String.Format("[{0}] bit,",
                                     dc.ColumnName));
                                break;
                            case "Single":
                                createTableBuilder.AppendLine(String.Format("[{0}] real,",
                                     dc.ColumnName));
                                break;
                            case "Byte":
                                createTableBuilder.AppendLine(String.Format("[{0}] tinyint,",
                                     dc.ColumnName));
                                break;
                            case "Int16":
                                createTableBuilder.AppendLine(String.Format("[{0}] smallint,",
                                     dc.ColumnName));
                                break;
                            case "Double":
                                createTableBuilder.AppendLine(String.Format("[{0}] float,",
                                     dc.ColumnName));
                                break;
                            default:
                                //MessageBox.Show(String.Format("{0}.[{1}] {2}",
                                //  pNomTableAccessUtilise,
                                //  dc.ColumnName,
                                //  dc.DataType.Name
                                //));
                                InsertTableLogJobConnecteur("TransferTableToSqlServer(AppendLine)", String.Format("{0}.[{1}] {2}",
                                  pNomTableAccessUtilise,
                                  dc.ColumnName,
                                  dc.DataType.Name));
                                succesLoadTable = false;
                                break;
                        }
                    }

                    // Valide si la table existe
                    Etape = "checkTableIfExistsCommand :: " + pNomTableUtiliseUser.ToString();
                    checkTableIfExistsCommand = new SqlCommand("IF OBJECT_ID('" + pNomTableUtiliseUser.ToString() + "', 'U') IS NOT NULL drop table " + pNomTableUtiliseUser.ToString(), mySQLConnection);
                    checkTableIfExistsCommand.CommandType = CommandType.Text;
                    checkTableIfExistsCommand.CommandTimeout = 12000;
                    readerIfExists = checkTableIfExistsCommand.ExecuteReader();
                    readerIfExists.Read();
                    readerIfExists.Close();

                    createTableBuilder.Remove(createTableBuilder.Length - 2, 2).ToString();
                    createTableBuilder.AppendLine(")");
                    createTableBuilder.Replace(",)", ")");
                    try
                    {
                        var createTableCommand = new SqlCommand(createTableBuilder.ToString(), mySQLConnection);
                        createTableCommand.ExecuteNonQuery();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show("ex.Message ::  " + ex.Message);
                        InsertTableLogJobConnecteur("TransferTableToSqlServer(createTableBuilder)", ex.Message.ToString());
                        succesLoadTable = false;
                    }

                    try
                    {
                        using (var bulkCopy = new SqlBulkCopy(mySQLConnection))
                        {
                            Etape = "commandSourceData.ExecuteReader";
                            commandSourceData.CommandTimeout = 18000;
                            SqlDataReader readers = commandDataReader.ExecuteReader(CommandBehavior.KeyInfo);
                            bulkCopy.BulkCopyTimeout = 0;
                            bulkCopy.DestinationTableName = pNomTableUtiliseUser.ToString();
                            bulkCopy.WriteToServer(readers);
                        }
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show("ex.Message ::  " + ex.Message);
                        InsertTableLogJobConnecteur("TransferTableToSqlServer(bulkCopy)", ex.Message.ToString());
                        succesLoadTable = false;
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobConnecteur("TransferTableToSqlServer(" + Etape.ToString() + ")", ex.Message.ToString());
                    succesLoadTable = false;
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Transfert la table temporaire dans la table maitre de SQL Server
            ///
            ///////////////////////////////////////////////////////////////////////
            void TransferTableSqlVersDBO(string pNomTableSource, string pNomTableDestination)
            {
                string sqlCmd = "SELECT * INTO " + pNomTableDestination.ToString() + " FROM " + pNomTableSource.ToString();
                string sqlCmd2 = "drop table " + pNomTableSource.ToString();


                // Valide si la table existe
                SqlCommand checkTableIfExistsCommand = new SqlCommand("IF OBJECT_ID('" + pNomTableDestination.ToString() + "', 'U') IS NOT NULL drop table " + pNomTableDestination.ToString(), mySQLConnection);
                checkTableIfExistsCommand.CommandType = CommandType.Text;
                SqlDataReader readerIfExists = checkTableIfExistsCommand.ExecuteReader();
                readerIfExists.Read();
                readerIfExists.Close();

                try
                {
                    // Copy la table dans le bon shéma
                    SqlCommand SQLCommandVers = new SqlCommand(sqlCmd.ToString(), mySQLConnection);
                    SQLCommandVers.CommandType = CommandType.Text;
                    SqlDataReader readerVers = SQLCommandVers.ExecuteReader();
                    readerVers.Read();
                    readerVers.Close();

                    // Détruire la table source
                    DestructionTable(pNomTableSource.ToString());
                }
                catch (Exception ex)
                {
                    //MessageBox.Show("ex.Message ::  " + ex.Message);
                    InsertTableLogJobConnecteur("TransferTableSqlVersDBO()", ex.Message.ToString());
                    succesLoadTable = false;
                    LoadTableErreur = true;
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute une instruction SQL
            ///
            /////////////////////////////////////////////////////////////////////
            void ExecuteSQL(string strIndSystem, string strSqlRequete)
            {
                InsertTableLogChargement(strIndSystem.ToString(), "ExecuteSQL");
                string sqlInsCmd = strSqlRequete.ToString();
                DestructionTable(oATable.ToString());

                try
                {
                    SqlCommand SQLCommandExec = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandExec.CommandType = CommandType.Text;
                    SQLCommandExec.CommandTimeout = 12000;
                    SqlDataReader readerExec = SQLCommandExec.ExecuteReader();
                    readerExec.Read();
                    readerExec.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobConnecteur("ExecuteSQL()", ex.Message.ToString());
                    LoadTableErreur = true;
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute une instruction SQL
            ///
            /////////////////////////////////////////////////////////////////////
            void ExecuteStoreProc(string strIndSystem, string strSqlRequete)
            {
                InsertTableLogChargement(strIndSystem.ToString(), "ExecuteStoreProc");
                string sqlInsCmd = strSqlRequete.ToString();

                try
                {
                    SqlCommand SQLCommandExec = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandExec.CommandType = CommandType.StoredProcedure;
                    SqlDataReader readerExec = SQLCommandExec.ExecuteReader();
                    readerExec.Read();
                    readerExec.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobConnecteur("ExecuteStoreProc()", ex.Message.ToString());
                    LoadTableErreur = true;
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Traite la procédure Access
            ///
            ///////////////////////////////////////////////////////////////////////
            void CallStoredProcedure(string ConnectionString, string FonctionName)
            {
                InsertTableLogChargement("ConnectionString()", "Nom de la fonction :: " + FonctionName);
                //Microsoft.Office.Interop.Access.Application AccessApp =
                //  new Microsoft.Office.Interop.Access.Application();

                try
                {
                    Access.Application oAccess = new Access.Application();
                    //oAccess.OpenCurrentDatabase(@ConnectionString.ToString(), false, null);
                    oAccess.OpenCurrentDatabase(ConnectionString, false);
                    //oAccess.Run(FonctionName.ToString());
                    oAccess.Run(FonctionName);
                    //oAccess.CloseCurrentDatabase();
                    //oAccess.Quit();
                    oAccess.Quit(Microsoft.Office.Interop.Access.AcQuitOption.acQuitSaveNone);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show("ex.Message ::  " + ex.Message);
                    //oAccess.CloseCurrentDatabase();
                    //oAccess.Quit();
                    InsertTableLogJobConnecteur("CallStoredProcedure()", ex.Message.ToString());
                    succesLoadTable = false;
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Envois le courriel s'il y a une ou des erreurs
            ///
            ///////////////////////////////////////////////////////////////////////
            void SendMailMessageError(string EnvoisCourrielPar)
            {
                int recCount = 0;
                String strAfficheErreur = "";
                String SQLString = tblAfficheErreur.ToString();
                String EnvoisCourrielA = "yves.mcduff-ext@rbq.gouv.qc.ca"; // "centre.de.pilotage@rbq.gouv.qc.ca"; 
                String EnvoisCourrielSuject = "L'application (Connecteur) a une ou plusieurs erreurs d'exécutions ";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine +
                                             "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";


                // Lire les erreurs
                using (SqlDataAdapter dataAdapterAfficheErreur = new SqlDataAdapter(SQLString, mySQLConnection))
                {
                    // create the DataSet 
                    try
                    {
                        DataSet dataSetAfficheErreur = new DataSet();
                        dataAdapterAfficheErreur.SelectCommand.CommandTimeout = 180;
                        dataAdapterAfficheErreur.Fill(dataSetAfficheErreur, "AfficheErreur");
                        recCount = 0;

                        foreach (DataRow pRowRegleAfficheErreur in dataSetAfficheErreur.Tables["AfficheErreur"].Rows)
                        {

                            if (recCount < 16)
                            {
                                strAfficheErreur = strAfficheErreur.ToString() + newLine + pRowRegleAfficheErreur["IndSystem"].ToString() + " - " +
                                                                                           pRowRegleAfficheErreur["JobName"].ToString() + " - " +
                                                                                           pRowRegleAfficheErreur["NomTable"].ToString() + " - " +
                                                                                           pRowRegleAfficheErreur["ErrorMessage"].ToString() + newLine;
                            }

                            recCount++;

                        }
                    }
                    catch (Exception ex)
                    {
                        ///
                        strMessageSql = "Fonction SendMailMessageError (dataSetAfficheErreur) Erreur SQL ";
                        InsertTableLogJobConnecteur("MAIL", strMessageSql.ToString());
                        succesLoadTable = false;
                    }
                }

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + strAfficheErreur.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();

                String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message.ToString();
                    strMessageSql = "Fonction SendMailMessageError (SmtpClient) Erreur SQL ";
                    InsertTableLogJobConnecteur("MAIL", strMessageSql.ToString());
                    succesLoadTable = false;
                }
                InsertTableLogChargement("Mail", "Mail Envoyé");
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Transfert User Info de SharePoint dans la table temporaire de SQL Server
            ///
            ///////////////////////////////////////////////////////////////////////
            void TransferUserInfoSharePointToSqlServer(string pNomTableSharePointUtilise, string pNomTableUtiliseUser, string pNomTableUtiliseSystem, string pNomTableSysObjects, string pLienSharePoint, string pNomColonneSharePoint, string pNomColonneSqlServer)
            {
                string Etape = "";
                string sqlInsCmd = "";
                string strEnteSql = "INSERT INTO " + pNomTableUtiliseUser.ToString() + " values(";
                string strBodySql = "";
                string strDelimit = "";
                string strGetValeur = "";
                int position = 0;
                int intLongueur = 0;

                // Information sur les colonnes et leurs définitions
                string[] arrfieldInternalName = new string[0];
                string[] arrfieldSqlServer = new string[0];
                arrfieldInternalName = pNomColonneSharePoint.Split(';');
                arrfieldSqlServer = pNomColonneSqlServer.Split(';');

                SharePointColumnsInfo = new share_pointColumnsInfo()
                {
                    strTitle = new List<string>(),
                    strInternalName = new List<string>(),
                    strFieldType = new List<string>(),
                    intMaxLength = new List<int>(),
                    strPropriete = new List<string>(),
                    strSqlFieldName = new List<string>(),
                    strSqlColone = new List<string>(),
                    strValeur = new List<string>()
                };

                string newLine = Environment.NewLine;

                // Valide si le nombre de colonnes de InternalName est identique au nombre de champs SQL Server à créer
                if (arrfieldInternalName.Count() != arrfieldSqlServer.Count())
                {
                    InsertTableLogJobConnecteur("TransferUserInfoSharePointToSqlServer(Valide si le nombre de colonnes est identique)", String.Format("{0} :: Nb SharePoint[{1}] - Nb création de la table{2}",
                                              "Le nombre de colonnes SharePoint est différent de la création de la table",
                                              arrfieldInternalName.Count().ToString(),
                                              arrfieldSqlServer.Count().ToString()));
                    succesLoadTable = false;
                    return;
                }

                try
                {
                    ClientContext clientcontext = new ClientContext(pLienSharePoint);
                    List targetList = clientcontext.Web.SiteUserInfoList;
                    FieldCollection oFieldCollection = targetList.Fields;
                    clientcontext.Load(oFieldCollection);
                    clientcontext.ExecuteQuery();

                    Microsoft.SharePoint.Client.CamlQuery camlQuery = new CamlQuery();
                    camlQuery.ViewXml = @"<View Scope='RecursiveAll'> " +
                                          "</View>";

                    ListItemCollection listItems = clientcontext.Web.SiteUserInfoList.GetItems(camlQuery);
                    clientcontext.Load(listItems);
                    clientcontext.ExecuteQuery();

                    List targetListItem = clientcontext.Web.SiteUserInfoList;


                    if (arrfieldInternalName.Count() > 0)
                    {
                        // Valide si la table existe
                        Etape = "checkTableIfExistsCommand :: " + pNomTableSysObjects.ToString();

                        SqlCommand checkTableIfExistsCommand = new SqlCommand("IF OBJECT_ID('" + pNomTableSysObjects.ToString() + "', 'U') IS NOT NULL drop table " + pNomTableSysObjects.ToString(), mySQLConnection);
                        checkTableIfExistsCommand.CommandType = CommandType.Text;
                        SqlDataReader readerIfExists = checkTableIfExistsCommand.ExecuteReader();
                        readerIfExists.Read();
                        readerIfExists.Close();

                        // Récupère les colonnes à utiliser
                        for (int columnNum = 0; columnNum <= arrfieldInternalName.Count() - 1; columnNum++)
                        {
                            SharePointColumnsInfo.strTitle.Add("");
                            SharePointColumnsInfo.strInternalName.Add(arrfieldInternalName[columnNum].ToString());
                            SharePointColumnsInfo.strFieldType.Add("");
                            SharePointColumnsInfo.intMaxLength.Add(0);
                            SharePointColumnsInfo.strPropriete.Add("");
                            SharePointColumnsInfo.strSqlFieldName.Add(arrfieldSqlServer[columnNum].ToString());
                            SharePointColumnsInfo.strSqlColone.Add("");
                            SharePointColumnsInfo.strValeur.Add("");
                        }

                        foreach (Field oField in oFieldCollection)
                        {

                            if (arrfieldInternalName.Contains(oField.InternalName.ToString()))
                            {
                                position = SharePointColumnsInfo.strInternalName.FindIndex(x => x.ToString() == oField.InternalName.ToString());

                                SharePointColumnsInfo.strTitle[position] = oField.Title.ToString();
                                SharePointColumnsInfo.strFieldType[position] = oField.FieldTypeKind.ToString();
                                SharePointColumnsInfo.strPropriete[position] = oField.ToString();

                                if (oField.FieldTypeKind.ToString().ToUpper() == "TEXT")
                                {
                                    intLongueur = ((Microsoft.SharePoint.Client.FieldText)oField.TypedObject.TypedObject).MaxLength;
                                }
                                else
                                {
                                    intLongueur = 0;
                                }

                                resultSQL returnDefiniColonneSQL = DefiniColonneSQL(oField.FieldTypeKind.ToString(), intLongueur, SharePointColumnsInfo.strSqlFieldName[position].ToString(), pNomTableSharePointUtilise);

                                SharePointColumnsInfo.strSqlColone[position] = returnDefiniColonneSQL.definition.ToString();
                                SharePointColumnsInfo.intMaxLength[position] = returnDefiniColonneSQL.longueur;
                            }
                        }
                        // Valide si la table existe
                        Etape = "checkTableIfExistsCommand :: " + pNomTableUtiliseUser.ToString();

                        checkTableIfExistsCommand = new SqlCommand("IF OBJECT_ID('" + pNomTableUtiliseUser.ToString() + "', 'U') IS NOT NULL drop table " + pNomTableUtiliseUser.ToString(), mySQLConnection);
                        checkTableIfExistsCommand.CommandType = CommandType.Text;
                        readerIfExists = checkTableIfExistsCommand.ExecuteReader();
                        readerIfExists.Read();
                        readerIfExists.Close();

                        // Création de la table SQL Server
                        var createTableBuilder = new StringBuilder("CREATE TABLE " + pNomTableUtiliseUser.ToString());
                        createTableBuilder.AppendLine("(");
                        // Récupère les colonnes à utiliser

                        for (int columnNum = 0; columnNum <= SharePointColumnsInfo.strTitle.Count() - 1; columnNum++)
                        {
                            if (SharePointColumnsInfo.strSqlColone[columnNum].ToString() == "" && SharePointColumnsInfo.strInternalName[columnNum].ToString() != "")
                            {
                                SharePointColumnsInfo.strTitle[columnNum] = SharePointColumnsInfo.strInternalName[columnNum].ToString();
                                SharePointColumnsInfo.strSqlColone[columnNum] = String.Format("[{0}] VARCHAR(8),", SharePointColumnsInfo.strSqlFieldName[columnNum].ToString());
                                SharePointColumnsInfo.strFieldType[columnNum] = "_Id";
                            }

                            if (SharePointColumnsInfo.strSqlColone[columnNum].ToString() != "")
                            {
                                createTableBuilder.AppendLine(SharePointColumnsInfo.strSqlColone[columnNum].ToString());
                            }
                        }

                        createTableBuilder.AppendLine(")");
                        try
                        {
                            var createTableCommand = new SqlCommand(createTableBuilder.ToString(), mySQLConnection);
                            createTableCommand.ExecuteNonQuery();
                        }
                        catch (Exception ex)
                        {
                            //MessageBox.Show("ex.Message ::  " + ex.Message);
                            InsertTableLogJobConnecteur("TransferUserInfoSharePointToSqlServer(createTableBuilder)", ex.Message.ToString());
                            succesLoadTable = false;
                        }
                    }

                    Etape = "Insert into";
                    foreach (ListItem item in listItems)
                    {
                        strBodySql = "";
                        strDelimit = "";

                        for (int columnNum = 0; columnNum <= SharePointColumnsInfo.strTitle.Count() - 1; columnNum++)
                        {
                            if (SharePointColumnsInfo.strSqlColone[columnNum].ToString() != "" && SharePointColumnsInfo.strInternalName[columnNum].ToString() != "")
                            {
                                try
                                {

                                    strGetValeur = getColonneValueSQL(SharePointColumnsInfo.strFieldType[columnNum], SharePointColumnsInfo.strInternalName[columnNum], item);

                                    // Initialise la variable SQL
                                    strBodySql = strBodySql.ToString() + strDelimit.ToString() + strGetValeur.ToString();
                                    strDelimit = ", ";
                                }
                                catch (Exception ex)
                                {
                                    //MessageBox.Show(ex.Message + " :: " + SharePointColumnsInfo.strInternalName[columnNum].ToString());f
                                    InsertTableLogJobConnecteur("TransferUserInfoSharePointToSqlServer(Création Body) :: " + SharePointColumnsInfo.strInternalName[columnNum].ToString(), ex.Message.ToString());
                                }
                            }
                        }

                        try
                        {
                            sqlInsCmd = strEnteSql + strBodySql.Replace("&#39;", "''") + ")";
                            SqlCommand SQLCommandExec = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                            SQLCommandExec.CommandType = CommandType.Text;
                            SqlDataReader readerExec = SQLCommandExec.ExecuteReader();
                            readerExec.Read();
                            readerExec.Close();
                        }
                        catch (Exception ex)
                        {
                            //MessageBox.Show(ex.Message);
                            InsertTableLogJobConnecteur("TransferUserInfoSharePointToSqlServer(Insert into))", ex.Message.ToString());
                            LoadTableErreur = true;
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobConnecteur("TransferUserInfoSharePointToSqlServer(" + Etape.ToString() + ")", ex.Message.ToString());
                    succesLoadTable = false;
                }
            }
            ////////////////////////////////////////////////////////////////////////
            ///
            //     Transfert la table SharePoint dans la table temporaire de SQL Server
            ///
            ///////////////////////////////////////////////////////////////////////
            void TransferTableSharePointToSqlServer(string pNomTableSharePointUtilise, string pNomTableUtiliseUser, string pNomTableUtiliseSystem, string pNomTableSysObjects, string pLienSharePoint, string pNomColonneSharePoint, string pNomColonneSqlServer)
            {
                string Etape = "";
                string sqlInsCmd = "";
                string strEnteSql = "INSERT INTO " + pNomTableUtiliseUser.ToString() + " values(";
                string strBodySql = "";
                string strDelimit = "";
                string strGetValeur = "";
                int position = 0;
                int intLongueur = 0;

                // Information sur les colonnes et leurs définitions
                string[] arrfieldInternalName = new string[0];
                string[] arrfieldSqlServer = new string[0];
                arrfieldInternalName = pNomColonneSharePoint.Split(';');
                arrfieldSqlServer = pNomColonneSqlServer.Split(';');

                SharePointColumnsInfo = new share_pointColumnsInfo()
                {
                    strTitle = new List<string>(),
                    strInternalName = new List<string>(),
                    strFieldType = new List<string>(),
                    intMaxLength = new List<int>(),
                    strPropriete = new List<string>(),
                    strSqlFieldName = new List<string>(),
                    strSqlColone = new List<string>(),
                    strValeur = new List<string>()
                };

                string newLine = Environment.NewLine;

                // Valide si le nombre de colonnes de InternalName est identique au nombre de champs SQL Server à créer
                if (arrfieldInternalName.Count() != arrfieldSqlServer.Count())
                {
                    InsertTableLogJobConnecteur("TransferTableToSqlServer(Valide si le nombre de colonnes est identique)", String.Format("{0} :: Nb SharePoint[{1}] - Nb création de la table{2}",
                                              "Le nombre de colonnes SharePoint est différent de la création de la table",
                                              arrfieldInternalName.Count().ToString(),
                                              arrfieldSqlServer.Count().ToString()));
                    succesLoadTable = false;
                    return;
                }

                try
                {
                    Etape = "TransferTableSharePointToSqlServer.ClientContext";

                    ClientContext ctx = new ClientContext(pLienSharePoint);
                    var timeout =  -1;

                    ctx.ExecutingWebRequest += new EventHandler<WebRequestEventArgs>(ctx_MixedAuthRequest);
                    // Initialise l'authentification
                    ctx.AuthenticationMode = ClientAuthenticationMode.Default;
                    ctx.Credentials = System.Net.CredentialCache.DefaultCredentials;

                    List DemandeRv = ctx.Web.Lists.GetByTitle(pNomTableSharePointUtilise.ToString());

                    ctx.RequestTimeout = timeout;
                    ctx.PendingRequest.RequestExecutor.RequestKeepAlive = false;
                    ctx.PendingRequest.RequestExecutor.WebRequest.KeepAlive = false;
                    ctx.PendingRequest.RequestExecutor.WebRequest.Timeout = timeout;
                    ctx.PendingRequest.RequestExecutor.WebRequest.ReadWriteTimeout = timeout;
                    //////////////////////////
                    ///
                    ctx.Load(DemandeRv);
                    ctx.ExecuteQuery();

                    if (DemandeRv != null && DemandeRv.ItemCount > 0)
                    {
                        InsertTableLogChargement("TransferTableSharePointToSqlServer()", "ctx.Load(listItems)");
                        Etape = "ctx.Load(listItems)";

                        Microsoft.SharePoint.Client.CamlQuery camlQuery = new CamlQuery();
                        camlQuery.ViewXml = @"<View Scope='RecursiveAll'> " +
                                              "</View>";

                        ListItemCollection listItems = DemandeRv.GetItems(camlQuery);
                        ctx.RequestTimeout = timeout;
                        ctx.PendingRequest.RequestExecutor.RequestKeepAlive = false;
                        ctx.PendingRequest.RequestExecutor.WebRequest.KeepAlive = false;
                        ctx.PendingRequest.RequestExecutor.WebRequest.Timeout = timeout;
                        ctx.PendingRequest.RequestExecutor.WebRequest.ReadWriteTimeout = timeout;
                        ctx.Load(listItems);
                        ctx.ExecuteQuery();

                        Etape = "ctx.Load(web)";
                        var web = ctx.Web;
                        ctx.Load(web);
                        List listEventSource = web.Lists.GetByTitle(pNomTableSharePointUtilise);
                        FieldCollection fields = listEventSource.Fields;
                        IEnumerable<Field> fieldsColl = ctx.LoadQuery(fields);
                        ctx.ExecuteQuery();


                        if (arrfieldInternalName.Count() > 0)
                        {
                            // Valide si la table existe
                            Etape = "checkTableIfExistsCommand :: " + pNomTableSysObjects.ToString();

                            SqlCommand checkTableIfExistsCommand = new SqlCommand("IF OBJECT_ID('" + pNomTableSysObjects.ToString() + "', 'U') IS NOT NULL drop table " + pNomTableSysObjects.ToString(), mySQLConnection);
                            checkTableIfExistsCommand.CommandType = CommandType.Text;
                            SqlDataReader readerIfExists = checkTableIfExistsCommand.ExecuteReader();
                            readerIfExists.Read();
                            readerIfExists.Close();

                            // Récupère les colonnes à utiliser
                            for (int columnNum = 0; columnNum <= arrfieldInternalName.Count() - 1; columnNum++)
                            {
                                SharePointColumnsInfo.strTitle.Add("");
                                SharePointColumnsInfo.strInternalName.Add(arrfieldInternalName[columnNum].ToString());
                                SharePointColumnsInfo.strFieldType.Add("");
                                SharePointColumnsInfo.intMaxLength.Add(0);
                                SharePointColumnsInfo.strPropriete.Add("");
                                SharePointColumnsInfo.strSqlFieldName.Add(arrfieldSqlServer[columnNum].ToString());
                                SharePointColumnsInfo.strSqlColone.Add("");
                                SharePointColumnsInfo.strValeur.Add("");
                            }

                            // Créer la requete de la structure de la table
                            foreach (Field itemCol in fieldsColl)
                            {

                                if (arrfieldInternalName.Contains(itemCol.InternalName.ToString()))
                                {
                                    position = SharePointColumnsInfo.strInternalName.FindIndex(x => x.ToString() == itemCol.InternalName.ToString());

                                    SharePointColumnsInfo.strTitle[position] = itemCol.Title.ToString();
                                    SharePointColumnsInfo.strFieldType[position] = itemCol.FieldTypeKind.ToString();
                                    SharePointColumnsInfo.strPropriete[position] = itemCol.ToString();

                                    if (itemCol.FieldTypeKind.ToString().ToUpper() == "TEXT")
                                    {
                                        intLongueur = ((Microsoft.SharePoint.Client.FieldText)itemCol.TypedObject.TypedObject).MaxLength;
                                    }
                                    else
                                    {
                                        intLongueur = 0;
                                    }

                                    resultSQL returnDefiniColonneSQL = DefiniColonneSQL(itemCol.FieldTypeKind.ToString(), intLongueur, SharePointColumnsInfo.strSqlFieldName[position].ToString(), pNomTableSharePointUtilise);

                                    SharePointColumnsInfo.strSqlColone[position] = returnDefiniColonneSQL.definition.ToString();
                                    SharePointColumnsInfo.intMaxLength[position] = returnDefiniColonneSQL.longueur;
                                }
                            }

                            // Valide si la table existe
                            Etape = "checkTableIfExistsCommand :: " + pNomTableUtiliseUser.ToString();

                            checkTableIfExistsCommand = new SqlCommand("IF OBJECT_ID('" + pNomTableUtiliseUser.ToString() + "', 'U') IS NOT NULL drop table " + pNomTableUtiliseUser.ToString(), mySQLConnection);
                            checkTableIfExistsCommand.CommandType = CommandType.Text;
                            readerIfExists = checkTableIfExistsCommand.ExecuteReader();
                            readerIfExists.Read();
                            readerIfExists.Close();

                            // Création de la table SQL Server
                            var createTableBuilder = new StringBuilder("CREATE TABLE " + pNomTableUtiliseUser.ToString());
                            createTableBuilder.AppendLine("(");
                            // Récupère les colonnes à utiliser

                            for (int columnNum = 0; columnNum <= SharePointColumnsInfo.strTitle.Count() - 1; columnNum++)
                            {
                                if (SharePointColumnsInfo.strSqlColone[columnNum].ToString() == "" && SharePointColumnsInfo.strInternalName[columnNum].ToString() != "")
                                {
                                    SharePointColumnsInfo.strTitle[columnNum] = SharePointColumnsInfo.strInternalName[columnNum].ToString();
                                    SharePointColumnsInfo.strSqlColone[columnNum] = String.Format("[{0}] VARCHAR(8),", SharePointColumnsInfo.strSqlFieldName[columnNum].ToString());
                                    SharePointColumnsInfo.strFieldType[columnNum] = "_Id";
                                }

                                if (SharePointColumnsInfo.strSqlColone[columnNum].ToString() != "")
                                {
                                    createTableBuilder.AppendLine(SharePointColumnsInfo.strSqlColone[columnNum].ToString());
                                }
                            }

                            createTableBuilder.AppendLine(")");
                            try
                            {
                                var createTableCommand = new SqlCommand(createTableBuilder.ToString(), mySQLConnection);
                                createTableCommand.ExecuteNonQuery();
                            }
                            catch (Exception ex)
                            {
                                //MessageBox.Show("ex.Message ::  " + ex.Message);
                                InsertTableLogJobConnecteur("TransferTableToSqlServer(createTableBuilder)", ex.Message.ToString());
                                succesLoadTable = false;
                            }
                        }

                        Etape = "Insert into";
                        foreach (ListItem item in listItems)
                        {
                            strBodySql = "";
                            strDelimit = "";

                            for (int columnNum = 0; columnNum <= SharePointColumnsInfo.strTitle.Count() - 1; columnNum++)
                            {
                                if (SharePointColumnsInfo.strSqlColone[columnNum].ToString() != "" && SharePointColumnsInfo.strInternalName[columnNum].ToString() != "")
                                {
                                    try
                                    {

                                        strGetValeur = getColonneValueSQL(SharePointColumnsInfo.strFieldType[columnNum], SharePointColumnsInfo.strInternalName[columnNum], item);

                                        // Initialise la variable SQL
                                        strBodySql = strBodySql.ToString() + strDelimit.ToString() + strGetValeur.ToString();
                                        strDelimit = ", ";
                                    }
                                    catch (Exception ex)
                                    {
                                        //MessageBox.Show(ex.Message + " :: " + SharePointColumnsInfo.strInternalName[columnNum].ToString());f
                                        InsertTableLogJobConnecteur("TransferTableToSqlServer(Création Body) :: " + SharePointColumnsInfo.strInternalName[columnNum].ToString(), ex.Message.ToString());
                                    }
                                }
                            }
                            try
                            {
                                sqlInsCmd = strEnteSql + strBodySql.Replace("&#39;", "''") + ")";
                                SqlCommand SQLCommandExec = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                                SQLCommandExec.CommandType = CommandType.Text;
                                SqlDataReader readerExec = SQLCommandExec.ExecuteReader();
                                readerExec.Read();
                                readerExec.Close();
                            }
                            catch (Exception ex)
                            {
                                //MessageBox.Show(ex.Message);
                                InsertTableLogJobConnecteur("TransferTableSharePointToSqlServer(Insert into))", ex.Message.ToString());
                                LoadTableErreur = true;
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobConnecteur("TransferTableSharePointToSqlServer(" + Etape.ToString() + ")", ex.Message.ToString());
                    succesLoadTable = false;
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Retourne la définition de colonne pour la table temporaire de SQL Server
            ///
            ///////////////////////////////////////////////////////////////////////
            resultSQL DefiniColonneSQL(string pstrFieldType, int pintLongueur, string pstrSqlFieldName, string pNomTableSharePointUtilise)
            {
                resultSQL resValue = new resultSQL();

                switch (pstrFieldType.ToString().ToUpper())
                {
                    case "STRING":
                    case "TEXT":
                        resValue.longueur = pintLongueur;
                        if (resValue.longueur > 4000)
                        {
                            resValue.definition = String.Format("[{0}] nvarchar(MAX),", pstrSqlFieldName.ToString());
                        }
                        else
                        {
                            resValue.definition = String.Format("[{0}] nvarchar({1}),", pstrSqlFieldName.ToString(), resValue.longueur.ToString());
                        }
                        break;
                    case "ATTACHMENTS":
                        resValue.definition = String.Format("[{0}] ntext,", pstrSqlFieldName.ToString());
                        break;
                    case "LOOKUP":
                    case "USER":
                    case "CHOICE":
                    case "COMPUTED":
                    case "GUID":
                        resValue.definition = String.Format("[{0}] nvarchar(255),", pstrSqlFieldName.ToString());
                        break;
                    case "INVALID":
                    case "CALCULATED":
                    case "NOTE":
                        resValue.definition = String.Format("[{0}] nvarchar(MAX),", pstrSqlFieldName.ToString());
                        break;
                    case "MONEY":
                    case "DECIMAL":
                    case "NUMBER":
                        resValue.definition = String.Format("[{0}] decimal(35,10),", pstrSqlFieldName.ToString());
                        break;
                    case "DATETIME":
                        resValue.definition = String.Format("[{0}] datetime,", pstrSqlFieldName.ToString());
                        break;
                    case "INT32":
                    case "INTEGER":
                    case "COUNTER":
                        resValue.definition = String.Format("[{0}] int,", pstrSqlFieldName.ToString());
                        break;
                    case "BOOLEAN":
                        resValue.definition = String.Format("[{0}]  VARCHAR(1),", pstrSqlFieldName.ToString());
                        break;
                    case "SINGLE":
                        resValue.definition = String.Format("[{0}] real,", pstrSqlFieldName.ToString());
                        break;
                    case "BYTE":
                        resValue.definition = String.Format("[{0}] tinyint,", pstrSqlFieldName.ToString());
                        break;
                    case "INT16":
                        resValue.definition = String.Format("[{0}] smallint,", pstrSqlFieldName.ToString());
                        break;
                    case "DOUBLE":
                        resValue.definition = String.Format("[{0}] float,", pstrSqlFieldName.ToString());
                        break;
                    default:
                        //MessageBox.Show(String.Format("{0}.[{1}] {2}",
                        //  pNomTableSharePointUtilise,
                        //  SharePointColumnsInfo.strTitle[position].ToString(),
                        //  SharePointColumnsInfo.strFieldType[position].ToString()));
                        InsertTableLogJobConnecteur("TransferTableToSqlServer(AppendLine)", String.Format("{0}.[{1}] {2}",
                          pNomTableSharePointUtilise,
                          pstrSqlFieldName.ToString(),
                          pstrFieldType.ToString()));
                        succesLoadTable = false;
                        break;
                }

                return resValue;
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Retourne la valeur de la colonne pour la table temporaire de SQL Server
            ///
            ///////////////////////////////////////////////////////////////////////
            string getColonneValueSQL(string pstrFieldType, string pstrInternalName, ListItem pItem)
            {
                string strGetValeur = "";
                string strValue = "";

                if (pstrFieldType != "_Id")
                {
                    if (pItem[pstrInternalName.ToString()] != null)
                    {

                        switch (pItem[pstrInternalName.ToString()].ToString())
                        {
                            case "System.Collections.Generic.Dictionary`2[System.String,System.Object]":
                                var listValeur = (((System.Collections.Generic.Dictionary<string, object>)pItem[pstrInternalName.ToString()]));
                                if (listValeur.Count() != 4)
                                {
                                    strGetValeur = "NULL";
                                }
                                else
                                {
                                    strGetValeur = "'" + listValeur["WssId"].ToString() + ";" + listValeur["Label"].ToString().Replace("'", "`") + "'";
                                }
                                break;
                            case "Microsoft.SharePoint.Client.FieldLookup":
                            case "Microsoft.SharePoint.Client.FieldLookupValue":
                                if ((pItem[pstrInternalName.ToString()] as FieldLookupValue).LookupValue != null)
                                {
                                    strGetValeur = "'" + (pItem[pstrInternalName.ToString()] as FieldLookupValue).LookupValue.ToString().Replace("'", "`") + "'";
                                }
                                else
                                {
                                    strGetValeur = "NULL";
                                }
                                break;
                            case "Microsoft.SharePoint.Client.FieldUser":
                                strGetValeur = "'" + ((Microsoft.SharePoint.Client.FieldUser)pItem[pstrInternalName.ToString()]).ToString().Replace("'", "`") + "'";
                                break;
                            case "Microsoft.SharePoint.Client.FieldUserValue":
                                if ((FieldUserValue)pItem[pstrInternalName.ToString()] != null)
                                {
                                    FieldUserValue fuv = (FieldUserValue)pItem[pstrInternalName.ToString()];
                                    strGetValeur = "'" + fuv.LookupValue.ToString().Replace("'", "`") + "'";
                                }
                                else
                                {
                                    strGetValeur = "NULL";
                                }
                                break;
                            case "Microsoft.SharePoint.Client.FieldUserValue[]":
                                if ((FieldUserValue[])pItem[pstrInternalName.ToString()] != null)
                                {
                                    FieldUserValue[] multValue = (FieldUserValue[])pItem[pstrInternalName.ToString()];
                                    foreach (FieldUserValue fieldUserValue in multValue)
                                    {
                                        strGetValeur = "'" + fieldUserValue.LookupValue.ToString().Replace("'", "`") + "'";
                                    }
                                }
                                else
                                {
                                    strGetValeur = "NULL";
                                }
                                break;
                            case "Microsoft.SharePoint.Client.FieldChoice":
                                strGetValeur = "'" + pItem[pstrInternalName.ToString()].ToString().Replace("'", "`") + "'";
                                break;
                            case "Microsoft.SharePoint.Client.FieldDateTime":
                                strGetValeur = "convert(datetime, convert(datetime, '" + pItem[pstrInternalName.ToString()].ToString() + "', 120) at time zone 'UTC' at time zone 'Eastern Standard Time')";
                                break;
                            case "Microsoft.SharePoint.Client.FieldMultiLineText":
                            case "Microsoft.SharePoint.Client.FieldText":
                            case "Microsoft.SharePoint.Client.Field":
                                strGetValeur = "'" + pItem[pstrInternalName].ToString().Replace("'", "`") + "'";
                                break;
                            default:
                                if (pstrFieldType.ToString() != "Boolean")
                                {
                                    switch (pstrFieldType.ToString().ToUpper())
                                    {
                                        case "DATETIME":
                                            strGetValeur = "convert(datetime, convert(datetime, '" + pItem[pstrInternalName.ToString()].ToString() + "', 120) at time zone 'UTC' at time zone 'Eastern Standard Time')";
                                            break;
                                        case "NUMBER":
                                            strGetValeur = "'" + pItem[pstrInternalName].ToString().Replace(",", ".") + "'";
                                            break;
                                        default:
                                            strGetValeur = "'" + pItem[pstrInternalName].ToString().Replace("'", "`") + "'";
                                            break;
                                    }
                                }
                                else
                                {
                                    if (pItem[pstrInternalName.ToString()].ToString().ToUpper() != "FALSE")
                                    {
                                        strGetValeur = "'O'";
                                    }
                                    else
                                    {
                                        strGetValeur = "'N'";
                                    }
                                }
                                break;
                        }
                    }
                    else
                    {
                        if (pstrFieldType.ToString() != "Boolean")
                        {
                            strGetValeur = "NULL";
                        }
                        else
                        {
                            strGetValeur = "'N'";
                        }
                    }
                }
                else
                {
                    // Récupère la valeur du id
                    strValue = pstrInternalName.Substring(0, (pstrInternalName.Length - 2)).ToString();

                    if (pItem[strValue.ToString()] != null)
                    {
                        switch (pItem[strValue.ToString()].ToString())
                        {
                            case "Microsoft.SharePoint.Client.FieldLookup":
                            case "Microsoft.SharePoint.Client.FieldLookupValue":
                                strGetValeur = "'" + (pItem[strValue.ToString()] as FieldLookupValue).LookupId.ToString().Replace("'", "`") + "'";
                                break;
                            case "Microsoft.SharePoint.Client.FieldUserValue":
                                FieldUserValue fuv = (FieldUserValue)pItem[strValue.ToString()];
                                strGetValeur = "'" + fuv.LookupId.ToString().Replace("'", "`") + "'";
                                break;
                            case "Microsoft.SharePoint.Client.FieldUserValue[]":
                                FieldUserValue[] multValue = (FieldUserValue[])pItem[strValue.ToString()];
                                foreach (FieldUserValue fieldUserValue in multValue)
                                {
                                    strGetValeur = "'" + fieldUserValue.LookupId.ToString().Replace("'", "`") + "'";
                                }
                                break;
                            default:
                                //MessageBox.Show("Non Defini :: " + strGetValeur.ToString() + " -- " + item[strValue.ToString()].ToString()); 
                                InsertTableLogJobConnecteur("TransferTableSharePointToSqlServer(Non Defini) ", strGetValeur.ToString() + " -- " + pItem[strValue.ToString()].ToString());
                                break;
                        }
                    }
                    else
                    {
                        if (pstrFieldType.ToString() != "Boolean")
                        {
                            strGetValeur = "NULL";
                        }
                        else
                        {
                            strGetValeur = "'N'";
                        }

                    }
                }
                return strGetValeur;
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Authentification
            ///
            ///////////////////////////////////////////////////////////////////////
            void ctx_MixedAuthRequest(object sender, WebRequestEventArgs e)
            {
                try
                {
                    //Add the header that tells SharePoint to use Windows authentication.
                    e.WebRequestExecutor.RequestHeaders.Add(
                    "X-FORMS_BASED_AUTH_ACCEPTED", "f");
                }
                catch (Exception ex)
                {
                    //MessageBox.Show("Error setting authentication header: " + ex.Message);
                    succesLoadTable = false;
                    InsertTableLogJobConnecteur("ctx_MixedAuthRequest()", ex.Message.ToString());
                }
            }
        }

        private bool defined()
        {
            throw new NotImplementedException();
        }
        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = DTSExecResult.Success,
            Failure = DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
