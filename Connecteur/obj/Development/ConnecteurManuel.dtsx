        public const string tblLoadTable = "SELECT IndSystem, " +
                                                  "SqlTable, " +
                                                  "AccesTable,  " +
                                                  "TypeFichier,  " +
                                                  "OngletACharger,  " +
                                                  "NbrColonnes,  " +
                                                  "CheminFichier,  " +
                                                  "NomDuFichier,  " +
                                                  "StatutActif,  " +
                                                  "LoadSort, " +
                                                  "NomTableSharePoint, " +
                                                  "LienSharePoint, " +
                                                  "NomColonneSharePoint, " +
                                                  "NomColonneSqlServer, " +
                                                  "SQLConnect " +
                                            "FROM  LoadTable " +
                                            "WHERE StatutActif = True " +
                                            "AND   IndSystem = 'BIL' " +
                                            //"AND   LoadSort in (1) " +
                                            //"AND   SqlTable in ('REGP_Plaintes', 'SAR_AppelCourriel') " +
                                            "AND   SqlTable = 'BIL_VersionFicheIndicateur' " +
                                            //"AND   SqlTable in ('SGMED_Mesures_Tous', 'REGP_Intermediaire', 'VPE_Penale_Stat') " +
                                            //"AND   SqlTable in ('REGP_Intermediaire', 'VPE_Penale_Stat') " +
                                            "AND   ((Weekday(now()) = 2 " +
                                            "AND   Ucase(TraiteLundi) = 'O') " +
                                            "OR    (Weekday(now()) = 3 " +
                                            "AND   Ucase(TraiteMardi) = 'O') " + "" +
                                            "OR    (Weekday(now()) = 4 " +
                                            "AND   Ucase(TraiteMercredi) = 'O') " +
                                            "OR    (Weekday(now()) = 5 " +
                                            "AND   Ucase(TraiteJeudi) = 'O') " +
                                            "OR    (Weekday(now()) = 6 " +
                                            "AND   Ucase(TraiteVendredi) = 'O') " +
                                            "OR    (Weekday(now()) = 7 " +
                                            "AND   Ucase(TraiteSamedi) = 'O') " +
                                            "OR    (Weekday(now()) = 1 " +
                                            "AND   Ucase(TraiteDimanche) = 'O') " +
                                            "OR    (Ucase(TraiteSemaine) = 'O') " +
                                            "OR    ([TraiteLaJournée] = day(now())))  " +
                                            "AND   SqlTable <> 'Log_Chargement' " +
                                            "ORDER BY LoadSort ";


