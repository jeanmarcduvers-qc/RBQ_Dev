#region Help:  Introduction to the script task
/* The Script Task allows you to perform virtually any operation that can be accomplished in
 * a .Net application within the context of an Integration Services control flow. 
 * 
 * Expand the other regions which have "Help" prefixes for examples of specific ways to use
 * Integration Services features within this script task. */
#endregion


#region Namespaces
using System;
using System.Data;
using System.Linq;
using Microsoft.SqlServer.Dts.Runtime;
using System.Data.OleDb;
using System.Data.SqlClient;
using System.Text;
using System.Net.Mail;


using System.Windows.Forms;
using Microsoft.SharePoint.Client;
using System.Collections.Generic;

#endregion

namespace ST_602cb7aef8de490c92fd7d8a05d52ae2
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
    /// 	

    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        #region Help:  Using Integration Services variables and parameters in a script
        /* To use a variable in this script, first ensure that the variable has been added to 
         * either the list contained in the ReadOnlyVariables property or the list contained in 
         * the ReadWriteVariables property of this script task, according to whether or not your
         * code needs to write to the variable.  To add the variable, save this script, close this instance of
         * Visual Studio, and update the ReadOnlyVariables and 
         * ReadWriteVariables properties in the Script Transformation Editor window.
         * To use a parameter in this script, follow the same steps. Parameters are always read-only.
         * 
         * Example of reading from a variable:
         *  DateTime startTime = (DateTime) Dts.Variables["System::StartTime"].Value;
         * 
         * Example of writing to a variable:
         *  Dts.Variables["User::myStringVariable"].Value = "new value";
         * 
         * Example of reading from a package parameter:
         *  int batchId = (int) Dts.Variables["$Package::batchId"].Value;
         *  
         * Example of reading from a project parameter:
         *  int batchId = (int) Dts.Variables["$Project::batchId"].Value;
         * 
         * Example of reading from a sensitive project parameter:
         *  int batchId = (int) Dts.Variables["$Project::batchId"].GetSensitiveValue();
         * */

        #endregion

        #region Help:  Firing Integration Services events from a script
        /* This script task can fire events for logging purposes.
         * 
         * Example of firing an error event:
         *  Dts.Events.FireError(18, "Process Values", "Bad value", "", 0);
         * 
         * Example of firing an information event:
         *  Dts.Events.FireInformation(3, "Process Values", "Processing has started", "", 0, ref fireAgain)
         * 
         * Example of firing a warning event:
         *  Dts.Events.FireWarning(14, "Process Values", "No values received for input", "", 0);
         * */
        #endregion

        #region Help:  Using Integration Services connection managers in a script
        /* Some types of connection managers can be used in this script task.  See the topic 
         * "Working with Connection Managers Programatically" for details.
         * 
         * Example of using an ADO.Net connection manager:
         *  object rawConnection = Dts.Connections["Sales DB"].AcquireConnection(Dts.Transaction);
         *  SqlConnection myADONETConnection = (SqlConnection)rawConnection;
         *  //Use the connection in some code here, then release the connection
         *  Dts.Connections["Sales DB"].ReleaseConnection(rawConnection);
         *
         * Example of using a File connection manager
         *  object rawConnection = Dts.Connections["Prices.zip"].AcquireConnection(Dts.Transaction);
         *  string filePath = (string)rawConnection;
         *  //Use the connection in some code here, then release the connection
         *  Dts.Connections["Prices.zip"].ReleaseConnection(rawConnection);
         * */
        #endregion


        public const string tblLoadTable = "SELECT IndSystem, " +
                                                  "SqlTable, " +
                                                  "AccesTable,  " +
                                                  "TypeFichier,  " +
                                                  "OngletACharger,  " +
                                                  "NbrColonnes,  " +
                                                  "CheminFichier,  " +
                                                  "NomDuFichier,  " +
                                                  "StatutActif,  " +
                                                  "LoadSort, " +
                                                  "NomTableSharePoint, " +
                                                  "LienSharePoint, " +
                                                  "NomColonneSharePoint " +
                                            "FROM  LoadTable " +
                                            "WHERE StatutActif = True " +
                                            //"AND   LoadSort in (1) " +
                                            //"AND   SqlTable = 'BGP_Plaintes_Yves' " +
                                            "AND   SqlTable <> 'Log_Chargement' " +
                                            "ORDER BY LoadSort ";


        
        public string newLine = Environment.NewLine;

        public string oSystem;
        public string oNomTableUtilise;

        public string oSqlTable;
        public string oAccesTable;
        public string oAccesFonction;
        public bool oStatutActif;
        public string oNomTableSharePoint;
        public string oLienSharePoint;
        public string oNomColonneSharePoint;
        public string oTypeFichier;
        public string oCheminFichier;
        public string oNomDuFichier;
        
        public class share_pointColumnsInfo
        {
            private List<String> Title;
            private List<String> InternalName;
            private List<String> FieldType;
            private List<String> Propriete;
            public List<String> strTitle { get { return Title; } set { Title = value; } }
            public List<String> strInternalName { get { return InternalName; } set { InternalName = value; } }
            public List<String> strFieldType { get { return FieldType; } set { FieldType = value; } }
            public List<string> strPropriete { get { return Propriete; } set { Propriete = value; } }
        }

        share_pointColumnsInfo SharePointColumnsInfo = new share_pointColumnsInfo()
        {
            strTitle = new List<string>(),
            strInternalName = new List<string>(),
            strFieldType = new List<string>(),
            strPropriete = new List<string>(),
        };

        public class share_pointTableName
        {
            private List<String> Title;
            private List<int>    NbReord;
            public List<String> strTitle { get { return Title; } set { Title = value; } }
            public List<int> intNbReord { get { return NbReord; } set { NbReord = value; } }
        }

        share_pointTableName SharePointTableName = new share_pointTableName()
        {
            strTitle = new List<string>(),
            intNbReord = new List<int>()
        };

        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        public void Main()
        {
            TraiteStructureInfo();
            Dts.TaskResult = (int)ScriptResults.Success;
        }


        public void TraiteStructureInfo()
        {
        
            string date = DateTime.Now.ToString("yyyy-MM-dd hh:mm:ss");
            string EnvoyePar = Dts.Variables["User::EnvoyePar"].Value.ToString();
            string ConnectStringAccess = @Dts.Variables["User::ConnectStringAccess"].Value.ToString();

            OleDbConnection connectionAccess = new OleDbConnection(ConnectStringAccess);

            // Connecter à la BD   
            try
            {
                connectionAccess.Open();
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }

            // Creation de la commande
            OleDbCommand command = new OleDbCommand(tblLoadTable.ToString(), connectionAccess);

            // Exécute la requete
            try
            {

                // Exécute la commande  
                using (OleDbDataReader reader = command.ExecuteReader())
                {
                    // Lire les occurrences de la table LoadTable
                    while (reader.Read())
                    {
                        oSystem = reader["IndSystem"].ToString();
                        oNomTableUtilise = reader["SqlTable"].ToString();
                        oSqlTable = reader["SqlTable"].ToString();
                        oAccesTable = reader["AccesTable"].ToString();
                        oAccesFonction = reader["AccesTable"].ToString();
                        oStatutActif = bool.Parse(reader["StatutActif"].ToString());
                        oNomTableSharePoint = reader["NomTableSharePoint"].ToString();
                        oLienSharePoint = reader["LienSharePoint"].ToString();
                        oNomColonneSharePoint = reader["NomColonneSharePoint"].ToString();
                        oTypeFichier = reader["TypeFichier"].ToString();
                        oCheminFichier = reader["CheminFichier"].ToString();
                        oNomDuFichier = reader["NomDuFichier"].ToString();

                        if (oStatutActif)
                        {
                            switch (oTypeFichier.ToString())
                            {
                                case "SharePoint":
                                    TransferTableSharePointToSqlServer(oNomTableSharePoint, oLienSharePoint.ToString());
                                    break;
                                default:
                                    break;
                            }
                        }
                    }
                    reader.Close();

                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }

            // Envois un courriel si erreur de programmation (SQL ou autre)
            SendMailMessage(EnvoyePar);

            connectionAccess.Close();

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Envois le courriel la définition de la structure
            ///
            ///////////////////////////////////////////////////////////////////////
            void SendMailMessage(string EnvoisCourrielPar)
            {
                String strAfficheErreur = "";
                String EnvoisCourrielSuject = "";
                String EnvoisCourrielA = "yves.mcduff-ext@rbq.gouv.qc.ca"; // "centre.de.pilotage@rbq.gouv.qc.ca";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";



                //if (bTableName)
                //{
                    //EnvoisCourrielSuject = "Résultat des nom des tables SharePoint";
                    EnvoisCourrielSuject = "Résultat des informations de SharePoint";
                    strAfficheErreur = "Title;NbRecord";
                    // Récupère les noms de tables
                    for (int columnNum = 0; columnNum <= SharePointTableName.strTitle.Count() - 1; columnNum++)
                    {

                        strAfficheErreur = strAfficheErreur.ToString() + newLine + SharePointTableName.strTitle[columnNum].ToString() + ";" +
                                                                                    SharePointTableName.intNbReord[columnNum].ToString() + ";";
                    }
                //}
                //else
                //{
                    //EnvoisCourrielSuject = "Résultat struture de la table SharePoint (" + oNomTableSharePoint + ")";
                    strAfficheErreur = strAfficheErreur.ToString() + newLine + newLine + "Title;InternalName;FieldType;Property";
                    // Récupère les colonnes à utiliser
                    for (int columnNum = 0; columnNum <= SharePointColumnsInfo.strInternalName.Count() - 1; columnNum++)
                    {
                        strAfficheErreur = strAfficheErreur.ToString() + newLine + SharePointColumnsInfo.strTitle[columnNum].ToString() + ";" +
                                                                                    SharePointColumnsInfo.strInternalName[columnNum].ToString() + ";" +
                                                                                    SharePointColumnsInfo.strFieldType[columnNum].ToString() + ";" +
                                                                                    SharePointColumnsInfo.strPropriete[columnNum].ToString() + ";";

                    }
                //}

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + strAfficheErreur.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();

                String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    MessageBox.Show(ex.Message.ToString());
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Transfert la table SharePoint dans la table temporaire de SQL Server
            ///
            ///////////////////////////////////////////////////////////////////////
            void TransferTableSharePointToSqlServer(string pNomTableSharePointUtilise, string pLienSharePoint)
            {
                SharePointColumnsInfo = new share_pointColumnsInfo()
                {
                    strTitle = new List<string>(),
                    strInternalName = new List<string>(),
                    strFieldType = new List<string>(),
                    strPropriete = new List<string>()
                };

                SharePointTableName = new share_pointTableName()
                {
                    strTitle = new List<string>(),
                    intNbReord = new List<int>()
                };

                string newLine = Environment.NewLine;

                try
                {

                    ClientContext ctx = new ClientContext(pLienSharePoint);
                    ctx.ExecutingWebRequest += new EventHandler<WebRequestEventArgs>(ctx_MixedAuthRequest);
                    // Initialise l'authentification
                    ctx.AuthenticationMode = ClientAuthenticationMode.Default;
                    ctx.Credentials = System.Net.CredentialCache.DefaultCredentials;

                    ////
                    /// Récupère les noms des tables
                    /// 
                    Web web2 = ctx.Web;
                    ListCollection listColl = web2.Lists;
                    ctx.Load(listColl);
                    ctx.ExecuteQuery();

                    foreach (Microsoft.SharePoint.Client.List oList in listColl)
                    {
                        //MessageBox.Show("Title: {" + oList.Title.ToString() + "} Created: {" + oList.Created.ToString() + "}");
                        SharePointTableName.strTitle.Add(oList.Title);
                        SharePointTableName.intNbReord.Add(oList.ItemCount);
                    }
                    
                    List DemandeRv = ctx.Web.Lists.GetByTitle(pNomTableSharePointUtilise);

                    //////////////////////////
                    /// Récupère les noms de colonnes
                    /// 
                    ctx.Load(DemandeRv);
                    ctx.ExecuteQuery();

                    if (DemandeRv != null && DemandeRv.ItemCount > 0)
                    {
                        Microsoft.SharePoint.Client.CamlQuery camlQuery = new CamlQuery();
                        camlQuery.ViewXml = @"<View Scope='RecursiveAll'> " +
                                              "</View>";

                        ListItemCollection listItems = DemandeRv.GetItems(camlQuery);
                        ctx.Load(listItems);
                        ctx.ExecuteQuery();

                        var web = ctx.Web;
                        ctx.Load(web);
                        List listEventSource = web.Lists.GetByTitle(pNomTableSharePointUtilise);
                        FieldCollection fields = listEventSource.Fields;
                        IEnumerable<Field> fieldsColl = ctx.LoadQuery(fields);
                        ctx.ExecuteQuery();


                        // Créer la requete de la structure de la table
                        foreach (Field itemCol in fieldsColl)
                        {

                            SharePointColumnsInfo.strTitle.Add(itemCol.Title.ToString());
                            SharePointColumnsInfo.strInternalName.Add(itemCol.InternalName.ToString());
                            SharePointColumnsInfo.strFieldType.Add(itemCol.FieldTypeKind.ToString());
                            SharePointColumnsInfo.strPropriete.Add(itemCol.ToString());
                        }
                    }
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Error : " + ex.Message);
                }
            }

            void ctx_MixedAuthRequest(object sender, WebRequestEventArgs e)
            {
                try
                {
                    //Add the header that tells SharePoint to use Windows authentication.
                    e.WebRequestExecutor.RequestHeaders.Add(
                    "X-FORMS_BASED_AUTH_ACCEPTED", "f");
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Error setting authentication header: " + ex.Message);
                }
            }
        }

        private bool defined()
        {
            throw new NotImplementedException();
        }
        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = DTSExecResult.Success,
            Failure = DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
