    <DataSet Name="Code_qualif">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT     CQ.EX_CO_QUAL_RBQ AS Valeur, CQ.EX_CO_QUAL_RBQ AS ETIQUETTE
FROM        [EXT2].[EX2_QUALIFICATION_RBQ] CQ
UNION
SELECT     'Tous' AS Valeur, '(Aucun filtre)' AS Etiquette
ORDER BY 2</CommandText>
      </Query>
      <Fields>
        <Field Name="Valeur">
          <DataField>Valeur</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ETIQUETTE">
          <DataField>ETIQUETTE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Municipalite">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGION">
            <Value>=Parameters!REGION.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MRC">
            <Value>=Parameters!MRC.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT MUN_ROLE.EX_NM_MUNC AS ETIQUETTE, MUN_ROLE.EX_CO_GEOG_MUNC AS VALEUR
FROM        EXT2.EX2_ROLE_EVAL_FONCIER AS MUN_ROLE  
inner  JOIN   SDGIC01.AEB.AE1_MUNP AS AEB_MUN 
   ON AEB_MUN.AE_NM_MUNC = MUN_ROLE.EX_NM_MUNC 
left  JOIN   SDGIC01.AEB.AE1_REGN_ADMN AS REG_ADM 
   ON REG_ADM.AE_C_REGN_ADMN = AEB_MUN.AE_C_REGN_ADMN
left join SDGIC01.[AEB].[AE1_MRC] MRC
   on MRC.AE_C_MRC = AEB_MUN.AE_C_MRC


WHERE     (@REGION = 'Tous' or ( REG_ADM.AE_NM_REGN_ADMN = @REGION) OR
          (MUN_ROLE.EX_NM_MUNC = 'Courcelles') AND (@REGION = 'Chaudière-Appalaches') OR
          (MUN_ROLE.EX_NM_MUNC = 'Dollard-Des Ormeaux') AND (@REGION = 'Montréal') OR
          (MUN_ROLE.EX_NM_MUNC = 'Gouvernement régional d''Eeyou Istchee Baie-James') AND (@REGION = 'Non déterminé') OR
          (MUN_ROLE.EX_NM_MUNC = 'Toponyme à venir') AND (@REGION = 'Non déterminé') OR
          (MUN_ROLE.EX_NM_MUNC = 'Non déterminé') AND (@REGION = 'Non déterminé') OR
          (MUN_ROLE.EX_NM_MUNC = 'Ristigouche-Partie-Sud-Est') AND (@REGION = 'Gaspésie–Îles-de-la-Madeleine') OR
          (MUN_ROLE.EX_NM_MUNC = 'Saint-Évariste-de-Forsyth') AND (@REGION = 'Chaudière-Appalaches') OR
          (MUN_ROLE.EX_NM_MUNC = 'Saint-Faustin--Lac-Carré') AND (@REGION = 'Laurentides') OR
          (MUN_ROLE.EX_NM_MUNC = 'Saint-Georges-de-Clarenceville') AND (@REGION = 'Montérégie') OR
          (MUN_ROLE.EX_NM_MUNC = 'Saint-Germain') AND (@REGION = 'Bas-Saint-Laurent') OR
          (MUN_ROLE.EX_NM_MUNC = 'Whitworth') AND (@REGION = 'Bas-Saint-Laurent'))

 and ('Tous' in (@MRC) or MRC.AE_NM_MRC in (@MRC))

ORDER BY ETIQUETTE</CommandText>
      </Query>
      <Fields>
        <Field Name="Valeur">
          <DataField>VALEUR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ETIQUETTE">
          <DataField>ETIQUETTE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Region_administrative">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT     AE_NM_REGN_ADMN AS Valeur, AE_NM_REGN_ADMN AS Etiquette
FROM        SDGIC01.AEB.AE1_REGN_ADMN AS ADR
UNION
SELECT     'Non déterminé' AS Valeur, 'Non déterminé' AS Etiquette
UNION
SELECT     'Tous' AS Valeur, '(Aucun filtre)' AS Etiquette
ORDER BY 2</CommandText>
      </Query>
      <Fields>
        <Field Name="Valeur">
          <DataField>Valeur</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Etiquette">
          <DataField>Etiquette</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CUBF">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT     Valeur, Affichage
FROM        (SELECT     '000' AS Valeur, '(Aucun filtre)' AS Affichage
                   UNION
                   SELECT     str(EX_CO_USAG_BIEN_FONC,4,0) AS Valeur, str(EX_CO_USAG_BIEN_FONC,4,0) AS Affichage
                   FROM        [EXT2].[EX2_UNITE_EVALUATION]) AS s
ORDER BY Valeur</CommandText>
      </Query>
      <Fields>
        <Field Name="Valeur">
          <DataField>Valeur</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Affichage">
          <DataField>Affichage</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Code_geographique">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT     Valeur, Affichage
FROM        (SELECT     '000' AS Valeur, '(Aucun filtre)' AS Affichage
                   UNION
                   SELECT     EX_CO_GEOG_MUNC AS Valeur, EX_CO_GEOG_MUNC AS Affichage
                   FROM        [EXT2].[EX2_ROLE_EVAL_FONCIER]) AS s
ORDER BY Valeur</CommandText>
      </Query>
      <Fields>
        <Field Name="Valeur">
          <DataField>Valeur</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Affichage">
          <DataField>Affichage</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MRC">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGION">
            <Value>=Parameters!REGION.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT MRC.AE_NM_MRC AS ETIQUETTE, MRC.AE_NM_MRC AS VALEUR  
 
FROM  SDGIC01.[AEB].[AE1_REGN_ADMN]  REG_ADM

inner join SDGIC01.[AEB].[AE1_MUNP] MUN
  on MUN.AE_C_REGN_ADMN = REG_ADM.AE_C_REGN_ADMN

left  JOIN  SDGIC01.[AEB].[AE1_MRC] MRC  
   ON MRC.AE_C_MRC = MUN.AE_C_MRC



WHERE     (@REGION = 'Tous' or  REG_ADM.AE_NM_REGN_ADMN = @REGION)


union 

select '(Aucun filtre)' AS ETIQUETTE, 'Tous' AS VALEUR  

ORDER BY ETIQUETTE</CommandText>
      </Query>
      <Fields>
        <Field Name="Valeur">
          <DataField>VALEUR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Etiquette">
          <DataField>ETIQUETTE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Annee_role_eval">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT     str(RE.EX_AN_ROLE_EVAL,4,0) AS Valeur, str(RE.EX_AN_ROLE_EVAL,4,0) AS ETIQUETTE
FROM        [EXT2].[EX2_ROLE_EVAL_FONCIER] RE
UNION
SELECT     'Tous' AS Valeur, '(Aucun filtre)' AS Etiquette
ORDER BY 2</CommandText>
      </Query>
      <Fields>
        <Field Name="Valeur">
          <DataField>Valeur</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ETIQUETTE">
          <DataField>ETIQUETTE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
