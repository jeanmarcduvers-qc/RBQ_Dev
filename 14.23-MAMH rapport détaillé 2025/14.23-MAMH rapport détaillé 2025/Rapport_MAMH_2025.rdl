  <Code>function listerType(prmType() as object) as string
	dim i as integer
	listerType = ""
	for i = 0 to ubound(prmType)
		listerType = iif(listerType &lt;&gt; "", listerType &amp; ", ", "") &amp; trim(prmType(i))
	next
end function
</Code>
