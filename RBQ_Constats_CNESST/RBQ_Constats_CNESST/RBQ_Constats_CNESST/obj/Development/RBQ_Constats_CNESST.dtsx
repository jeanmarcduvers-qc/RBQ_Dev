        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>

        public const string delLogChargement = "DELETE [SDDMU01].[dbo].[Log_Chargement_Connecteur] where Application = 'TraiteConstatsCNESST'";
        public const string delLogJobChargement = "DELETE [SDDMU01].[dbo].[Log_Job_Connecteur] where Application = 'TraiteConstatsCNESST'";
        public const string tblAfficheErreur = "SELECT * FROM [SDDMU01].[dbo].[Log_Job_Connecteur] where Application = 'TraiteConstatsCNESST'";

        public const string strFiltreConstatsCNESST = "*.xlsx";
        public const string strFichierXLSX_bd = "RBQ_Constats_CNESST.xlsx";
        public string newLine = Environment.NewLine;
        public bool blErreurExecution = false;
        public DateTime dtDateDebut = DateTime.Now;
        public string dtExecution = "";
        public string strAnneeExecution = "";

        public void Main()
        {
            // TODO: Add your code here
            TraiteConstatsCNESST();
            Dts.TaskResult = (int)ScriptResults.Success;

        }

        public void TraiteConstatsCNESST()
        {

            String EnvoyePar = Dts.Variables["User::EnvoyePar"].Value.ToString();
            string ServerNameSql = @Dts.Variables["User::ServerName"].Value.ToString();
            string ConnectStringAccess = @Dts.Variables["User::ConnectStringAccess"].Value.ToString();
            string strCheminIn = @Dts.Variables["User::RepertoireIn"].Value.ToString();
            string strCheminFchDB = @Dts.Variables["User::RepertoireBD"].Value.ToString();

            SqlConnection mySQLConnection = Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction) as SqlConnection;
            OleDbConnection connectionAccess = new OleDbConnection(ConnectStringAccess);
            OleDbConnection connectionIn = new OleDbConnection(ConnectStringAccess);

            // Connecter à la BD   
            try
            {
                connectionAccess.Open();
            }
            catch (Exception ex)
            {
                //MessageBox.Show(ex.Message);
                blErreurExecution = true;
                InsertTableLogJob("connectionAccess.Open()", ex.Message.ToString());
            }

            if (blErreurExecution != true)
            {
                // delete l'historique du dernier log de chargement
                // DeleteTableLogChargement();   On garde l'historique
                DeleteTableLogJobChargement();

                InsertTableLogChargement("TraiteConstatsCNESST", "Début du traitement");

                // Lire le répertoire 
                DirectoryInfo d = new DirectoryInfo(strCheminIn);
                try
                {
                    FileInfo[] FilesRBQ_Constats_CNESST = d.GetFiles(strFiltreConstatsCNESST);
                    var encoding = Encoding.Default;

                    // Traite les fichiers
                    if (blErreurExecution != true)
                    {

                        for (int rowNum = 0; rowNum <= FilesRBQ_Constats_CNESST.Length - 1; rowNum++)
                        {
                            if (ValideFichier(FilesRBQ_Constats_CNESST[rowNum].Name))
                            {
                                CopieFichier(FilesRBQ_Constats_CNESST[rowNum].FullName, strCheminFchDB, strFichierXLSX_bd, false);
                                InsertBD(FilesRBQ_Constats_CNESST[rowNum].Name);
                                
                                strAnneeExecution = FilesRBQ_Constats_CNESST[rowNum].Name.Substring(FilesRBQ_Constats_CNESST[rowNum].Name.Length - 9, 4);
                                CopieFichier(FilesRBQ_Constats_CNESST[rowNum].FullName, strCheminIn + "\\" + strAnneeExecution + "\\", FilesRBQ_Constats_CNESST[rowNum].Name, true);
                            }
                            else
                            {
                                InsertTableLogJob("TraiteConstatsCNESST()", "Le fichier des constats CNESST (" + FilesRBQ_Constats_CNESST[rowNum].Name + ") a déjà été traité.");
                                blErreurExecution = true;
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("TraiteConstatsCNESST()", ex.Message.ToString());
                }
            }

            if (blErreurExecution)
            {
                Email_Send();
            }

            InsertTableLogChargement("TraiteConstatsCNESST", "Fin du traitement");

            connectionAccess.Close();

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Valide si le fichier a été loadé
            ///
            ///////////////////////////////////////////////////////////////////////
            bool ValideFichier(string strFichierValide)
            {
                string sqlCmd = "SELECT count(1) as nbRecord " +
                                "FROM   [SDDMU01].[dbo].[Log_Chargement_Connecteur] " +
                                "where  [Application] = 'TraiteConstatsCNESST' " +
                                "and    [NomTable] = '" + strFichierValide + "'";
                bool blValideFichier = true;

                SqlCommand commandDataReader = new SqlCommand(sqlCmd, mySQLConnection);

                try
                {
                    using (SqlDataReader readerCorr = commandDataReader.ExecuteReader())
                    {
                        // Lire l'occurrences de la table Document_TMP
                        while (readerCorr.Read())
                        {
                            if (int.Parse(readerCorr["nbRecord"].ToString()) > 0)
                            {
                                blValideFichier = false;
                            }
                        }
                        readerCorr.Close();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogChargement("ERR", "ValideFichier()");
                }

                return blValideFichier;
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute une instruction SQL
            ///
            /////////////////////////////////////////////////////////////////////
            void ExecuteSQL(string strCodeTraitement, string strSqlRequete)
            {

                string sqlInsCmd = strSqlRequete.ToString();
                

                if (connectionIn.State.ToString() == "Closed")
                {
                    // Connecter à la BD In
                    connectionIn = new OleDbConnection(ConnectStringAccess.ToString());
                    connectionIn.Open();
                }

                try
                {
                    OleDbCommand SQLCommandExec = new OleDbCommand(sqlInsCmd.ToString(), connectionIn);
                    SQLCommandExec.CommandType = CommandType.Text;
                    SQLCommandExec.CommandTimeout = 12000;
                    OleDbDataReader readerExecSQL = SQLCommandExec.ExecuteReader();
                    readerExecSQL.Read();
                    readerExecSQL.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogChargement("ExecuteSQL(" + strCodeTraitement + ")", ex.Message.ToString());
                    blErreurExecution = true;
                }

                connectionIn.Close();
            }
            ////////////////////////////////////////////////////////////////////////
            ///
            //     Détruit les informations dant la table Log_Chargement_Connecteur
            ///
            ///////////////////////////////////////////////////////////////////////
            void DeleteTableLogChargement()
            {
                string sqlDelCmd = delLogChargement.ToString();

                try
                {
                    SqlCommand SQLCommandDel = new SqlCommand(sqlDelCmd.ToString(), mySQLConnection);
                    SQLCommandDel.CommandType = CommandType.Text;
                    SqlDataReader readerDel = SQLCommandDel.ExecuteReader();
                    readerDel.Read();
                    readerDel.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogChargement("ERR", "DeleteTableLogChargement()");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Détruit les informations dant la table Log_Job_Connecteur
            ///
            ///////////////////////////////////////////////////////////////////////
            void DeleteTableLogJobChargement()
            {
                string sqlDelCmdCharg = delLogJobChargement.ToString();

                try
                {
                    SqlCommand DelCmdCharg = new SqlCommand(sqlDelCmdCharg.ToString(), mySQLConnection);
                    DelCmdCharg.CommandType = CommandType.Text;
                    SqlDataReader readerCharg = DelCmdCharg.ExecuteReader();
                    readerCharg.Read();
                    readerCharg.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogChargement("ERR", "DeleteTableLogJobChargement()");
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Chargement_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogChargement(string strIndSystem, string strSqlTable)
            {
                string sqlInsCmd = "insert into[SDDMU01].[dbo].[Log_Chargement_Connecteur] values('TraiteConstatsCNESST', '" + strIndSystem + "', '" + strSqlTable + "', GETDATE(), 'Auto01', 'Tâche Automatisée')";

                try
                {
                    SqlCommand SQLCommandLog = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandLog.CommandType = CommandType.Text;
                    SqlDataReader readerLog = SQLCommandLog.ExecuteReader();
                    readerLog.Read();
                    readerLog.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("InsertTableLogChargement()", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Job_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogJob(string pFonction, string pErreurMessage)
            {
                int lParametreErreurMessage;
                pErreurMessage = pErreurMessage.Replace("'", "''");
                lParametreErreurMessage = pErreurMessage.Length;

                if (pErreurMessage.Length > 250)
                {
                    pErreurMessage = pErreurMessage.Substring(0, 245);
                    pErreurMessage = pErreurMessage + "...";
                }

                string sqlInsCmd = "insert into[SDDMU01].[dbo].[Log_Job_Connecteur] values('TraiteConstatsCNESST', 'ConstatsCNESST', null, '" + pFonction + "', 'Erreur', '" + pErreurMessage + "', 'Auto01', GETDATE())";

                try
                {
                    SqlCommand SQLCommandJob = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandJob.CommandType = CommandType.Text;
                    SqlDataReader readerErreur = SQLCommandJob.ExecuteReader();
                    readerErreur.Read();
                    readerErreur.Close();
                    blErreurExecution = true;
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogChargement("ERR", "Impossible d'insérer dans Log_Job_Connecteur");
                }
            }

  
            //////////////////////////////////////////////////////////////////////
            ///
            //     Copie le fichier
            ///
            /////////////////////////////////////////////////////////////////////
            void CopieFichier(string de, string a, string pFichierSource, bool supprimeFichier)
            {
                try
                {
                    if (!System.IO.Directory.Exists(a))
                    {
                        System.IO.Directory.CreateDirectory(a);
                    }
                    if (System.IO.File.Exists(a + pFichierSource))
                    {
                        System.IO.File.SetAttributes(a + pFichierSource, FileAttributes.Archive);
                        System.IO.File.Delete(a + pFichierSource);
                    }

                    System.IO.File.Copy(de, a + pFichierSource, true);

                    if (supprimeFichier)
                    {
                        SupprimeFichier(de);
                    }
                }

                catch (IOException ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("CopieFichier()", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Supprime le fichier
            ///
            /////////////////////////////////////////////////////////////////////
            void SupprimeFichier(string strFchier)
            {
                try
                {
                    if (System.IO.File.Exists(strFchier))
                    {
                        System.IO.File.SetAttributes(strFchier, FileAttributes.Archive);
                        System.IO.File.Delete(strFchier);
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("SupprimeFichier()", ex.Message.ToString());
                }
            }


            ////////////////////////////////////////////////////////////////////////
            ///
            //     Insert dans la BD
            ///
            ///////////////////////////////////////////////////////////////////////
            void InsertBD(string strFichierTraite)
            {
                string sqlInsCmd = "insert into TbCSSTinfra (NoNEQ, DAT_INFRAC, NO_CONST_INFRAC, COD_STAT_CONST_INF, " +
                                                             "DESC_LIBEL_CONST, DAT_STAT_CONST_INF ) values('%1', '%2', '%3', '%4', '%5', '%6')";

                string sqlSelect = "SELECT [Constats SAEP 001].F1 AS NO_NEQ, " +
                                          "[Constats SAEP 001].F8 AS DESC_LIBEL_CONST, " +
                                          "[Constats SAEP 001].F13 AS NO_CONST_INFRAC, " +
                                          "[Constats SAEP 001].F14 AS DAT_INFRAC, " +
                                          "[Constats SAEP 001].F15 AS COD_STAT_CONST_INF, " +
                                          "[Constats SAEP 001].F16 AS DAT_STAT_CONST_INF " +
                                   "FROM  [Constats SAEP 001] " +
                                   "WHERE [Constats SAEP 001].F13 Is Not Null " + 
                                   "AND   [Constats SAEP 001]![F13] <> 'NO_CONST_INFRAC'";

                string sqlCmd = "";

                if (connectionAccess.State.ToString() == "Closed")
                {
                    // Connecter à la BD In
                    connectionAccess = new OleDbConnection(ConnectStringAccess.ToString());
                    connectionAccess.Open();
                }

                // Récupère les constats
                OleDbCommand commandDataReader = new OleDbCommand(sqlSelect, connectionAccess);
                OleDbDataReader ValueReader = commandDataReader.ExecuteReader();
                while (ValueReader.Read())
                {
                    sqlCmd = sqlInsCmd.Replace("%1", ValueReader["NO_NEQ"].ToString());
                    sqlCmd = sqlCmd.Replace("%2", ValueReader["DAT_INFRAC"].ToString());
                    sqlCmd = sqlCmd.Replace("%3", ValueReader["NO_CONST_INFRAC"].ToString());
                    sqlCmd = sqlCmd.Replace("%4", ValueReader["COD_STAT_CONST_INF"].ToString());
                    sqlCmd = sqlCmd.Replace("%5", ValueReader["DESC_LIBEL_CONST"].ToString().Replace("'", "''"));
                    sqlCmd = sqlCmd.Replace("%6", ValueReader["DAT_STAT_CONST_INF"].ToString());
                    sqlCmd = sqlCmd.Replace("'',", "null,").Replace("'')", "null)");
                    ExecuteSQL("TbCSSTinfra", sqlCmd);
                }

                ValueReader.Close();
                InsertTableLogChargement("FichierChargé", strFichierTraite);
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Envois courriel
            ///
            /////////////////////////////////////////////////////////////////////
            void Email_Send()
            {
                String strAfficheErreur = "";
                String SQLString = tblAfficheErreur.ToString();
                String EnvoisCourrielPar = Dts.Variables["User::EnvoyePar"].Value.ToString();
                String EnvoisCourrielA = "yves.mcduff-ext@rbq.gouv.qc.ca"; // "centre.de.pilotage@rbq.gouv.qc.ca"; // "yves.mcduff-ext@rbq.gouv.qc.ca";
                String EnvoisCourrielSuject = "L'application (TraiteConstatsCNESST) a une ou des erreurs d'exécutions. ";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine +
                                             "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";

                // Lire les erreurs
                using (SqlDataAdapter dataAdapterAfficheErreur = new SqlDataAdapter(SQLString, mySQLConnection))
                {
                    // create the DataSet 
                    try
                    {
                        DataSet dataSetAfficheErreur = new DataSet();
                        dataAdapterAfficheErreur.SelectCommand.CommandTimeout = 600;
                        dataAdapterAfficheErreur.Fill(dataSetAfficheErreur, "AfficheErreur");

                        foreach (DataRow pRowRegleAfficheErreur in dataSetAfficheErreur.Tables["AfficheErreur"].Rows)
                        {


                            strAfficheErreur = strAfficheErreur.ToString() + newLine +
                                                                             pRowRegleAfficheErreur["JobName"].ToString() + " - " +
                                                                             pRowRegleAfficheErreur["ErrorMessage"].ToString() + newLine;


                        }
                    }
                    catch (Exception ex)
                    {
                        InsertTableLogJob("SendMail()", "Fonction Email_Send (dataSetAfficheErreur) Erreur SQL ");
                    }
                }

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + strAfficheErreur.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();

                String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("SendMail()", ex.Message.ToString());
                }
            }
        }
        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion

    }
}]]></ProjectItem>
