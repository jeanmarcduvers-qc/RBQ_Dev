            ////////////////////////////////////////////////////////////////////////
            ///
            //     Lire le fichier texte et mettre à jour les tables de chargement
            ///
            ///////////////////////////////////////////////////////////////////////
            void ImporterRapportVerification(string spFile, string spCodeDocument, string strFileName)
            {
                string strBalise = "";
                string strValue = "";
                string strValeurChamps = "";
                string strChampDocument = "";
                string strNomTable = "";
                char[] separators = new char[] { '<', '>', '/' };
                var encoding = Encoding.Default;
                int position = 0;

                InsertTableLogChargement("ImporterRapportVerification()", "Début du chargement des tables temporaires");
                using (StreamReader file = new StreamReader(spFile, encoding))
                //using (StreamReader file = new StreamReader(spFile))
                {
                    string ln;

                    while ((ln = file.ReadLine()) != null)
                    {
                        if (ln.ToString() != "")
                        {
                            switch (ln.Substring(0, 1))
                            {
                                case "<":
                                    switch (ln)
                                    {
                                        case "</Dossier>":
                                        case "</Site>":
                                        case "</PersonnePhysiqueMorale>":
                                        case "</SousDossier>":
                                        case "</Conclusion>":
                                        case "</Verificateur>":
                                            // Fermer enregistrement courant
                                            InsertTableTMP(strNomTable);
                                            strBalise = "";
                                            break;
                                        case "<Dossier>":
                                        case "<Site>":
                                        case "<PersonnePhysiqueMorale>":
                                        case "<SousDossier>":
                                        case "<Conclusion>":
                                        case "<Verificateur>":
                                            // Ouverture enregistrement courant

                                            strValue = ln;
                                            foreach (var RepChar in separators)
                                            {
                                                strValue = strValue.Replace(RepChar.ToString(), "");
                                            }
                                            strBalise = strValue;
                                            LoadCorrespondance(strBalise, spCodeDocument);
                                            strNomTable = strBalise + "_TMP";

                                            break;
                                    }
                                    break;
                                case "[":
                                    // Valeur des champs
                                    var pos = ln.IndexOf(']');
                                    strValeurChamps = ln.Substring((pos + 1), ln.Length - (pos + 1));
                                    strChampDocument = ln.Substring(1, (pos - 1));

                                    if ((checkMesCorrespondances.strChamp_Document.Contains(strChampDocument.ToString())))
                                    {
                                        position = checkMesCorrespondances.strChamp_Document.FindIndex(x => x.ToString() == strChampDocument.ToString());
                                        checkMesCorrespondances.strValeur[position] = ForcerFormatValeurChamp(strValeurChamps.ToString());
                                    }

                                    break;

                            }
                        }
                    }
                    file.Close();
                }
                InsertTableLogChargement("ImporterRapportVerification()", "Fin du chargement des tables temporaires");
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Load correspondance
            ///
            ///////////////////////////////////////////////////////////////////////
            void LoadCorrespondance(string strBalise, string spCodeDocument)
            {
                checkMesCorrespondances = new MesCorrespondances()
                {
                    strBalise = new List<string>(),
                    strChamp_Document = new List<string>(),
                    strNom_Table = new List<string>(),
                    strNom_Champ = new List<string>(),
                    strValeur = new List<string>()
                };

                string sqlCorrCmd = tblCorrespondance.ToString() + strBalise + "'";
                OleDbCommand commandDataReader = new OleDbCommand(sqlCorrCmd, connectionAccess);

                checkMesCorrespondances.strBalise.Add(strBalise.ToString());
                checkMesCorrespondances.strChamp_Document.Add("CodeDocument");
                checkMesCorrespondances.strNom_Table.Add(strBalise + "_TMP");
                checkMesCorrespondances.strNom_Champ.Add("CodeDocument");
                checkMesCorrespondances.strValeur.Add("'" + spCodeDocument + "'");


                try
                {
                    using (OleDbDataReader readerCorr = commandDataReader.ExecuteReader())
                    {
                        // Lire les occurrences de la table Correspondance
                        while (readerCorr.Read())
                        {
                            checkMesCorrespondances.strBalise.Add(readerCorr["Balise"].ToString());
                            checkMesCorrespondances.strChamp_Document.Add(readerCorr["Champ_Document"].ToString());
                            checkMesCorrespondances.strNom_Table.Add(readerCorr["Nom_Table"].ToString());
                            checkMesCorrespondances.strNom_Champ.Add(readerCorr["Nom_Champ"].ToString());
                            checkMesCorrespondances.strValeur.Add("NULL");
                        }
                        readerCorr.Close();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("LoadCorrespondance()", "Étape 1", ex.Message.ToString());
                }

                checkMesCorrespondances.strBalise.Add(strBalise.ToString());
                checkMesCorrespondances.strChamp_Document.Add("FinLigneImportation");
                checkMesCorrespondances.strNom_Table.Add(strBalise + "_TMP");
                checkMesCorrespondances.strNom_Champ.Add("FinLigneImportation");
                checkMesCorrespondances.strValeur.Add("True");
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Load correspondance
            ///
            ///////////////////////////////////////////////////////////////////////
            string ObtenirListeChamp(string strBalise)
            {

                string strChamps = "CodeDocument";
                string sqlCorrCmd = "select NOM_CHAMP from correspondance where BALISE = '" + strBalise + "'";
                OleDbCommand commandDataReader = new OleDbCommand(sqlCorrCmd, connectionAccess);

                try
                {
                    using (OleDbDataReader readerCorr = commandDataReader.ExecuteReader())
                    {
                        // Lire les occurrences de la table Correspondance
                        while (readerCorr.Read())
                        {
                            strChamps = strChamps + ", " + readerCorr["Nom_Champ"].ToString();
                        }
                        readerCorr.Close();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("ObtenirListeChamp()", "Étape 1", ex.Message.ToString());
                }

                return strChamps;
            }
            ////////////////////////////////////////////////////////////////////////
            ///
            //     Insert dans la table temporaire
            ///
            ///////////////////////////////////////////////////////////////////////
            void InsertTableTMP(string strTableName)
            {
                string strEnteSql = "insert into " + strTableName + " ( ";
                string strBodySql = " ) values( ";
                string sqlInsCmd = "";
                string strDelimit = "";

                for (int columnNum = 0; columnNum <= checkMesCorrespondances.strBalise.Count() - 1; columnNum++)
                {
                    if (checkMesCorrespondances.strBalise[columnNum].ToString() != "" && checkMesCorrespondances.strValeur[columnNum].ToString() != "")
                    {
                        try
                        {
                            // Initialise les variables SQL
                            strEnteSql = strEnteSql.ToString() + strDelimit.ToString() + checkMesCorrespondances.strNom_Champ[columnNum].ToString();
                            strBodySql = strBodySql.ToString() + strDelimit.ToString() + checkMesCorrespondances.strValeur[columnNum].ToString();
                            strDelimit = ", ";
                        }
                        catch (Exception ex)
                        {
                            //MessageBox.Show(ex.Message + " :: " + SharePointColumnsInfo.strInternalName[columnNum].ToString());
                            InsertTableLogJobConnecteur("InsertTableTMP(Création Body) :: " + checkMesCorrespondances.strNom_Champ[columnNum].ToString(), null, ex.Message.ToString());
                            LoadTableErreur = true;
                            blErreurExecution = true;
                        }
                    }
                }

                try
                {
                    if (blErreurExecution != true)
                    {
                        sqlInsCmd = strEnteSql + strBodySql + ")";
                        OleDbCommand cmd = new OleDbCommand(sqlInsCmd, connectionAccess);
                        cmd.CommandType = CommandType.Text;
                        cmd.ExecuteNonQuery();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message); // Yves Mc Duff
                    InsertTableLogJobConnecteur("InsertTableTMP(Insert into))", "Document :: " + strCodeDocument, ex.Message.ToString());
                    LoadTableErreur = true;
                    blErreurExecution = true;
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Mettre à jour les tables BD
            ///
            ///////////////////////////////////////////////////////////////////////
            void MettreAJourBD(string spCodeDocument)
            {
                InsertTableLogChargement("MettreAJourBD()", spCodeDocument);

                DateTime dlDateExportationDossierTMP;
                DateTime dlDateExportationDernierChargement;
                string cmdSql = "";

                dlDateExportationDossierTMP = ValideDateExportation(spCodeDocument);

                InsertTableLogChargement("ValideDateExportation()", dlDateExportationDossierTMP.ToString("yyyyMMddHHmmss"));
                if (dlDateExportationDossierTMP.ToString("yyyyMMddHHmmss") != "19500601000000")
                {
                    dlDateExportationDernierChargement = ValideDateChargement(spCodeDocument);

                    InsertTableLogChargement("ValideDateChargement()", dlDateExportationDernierChargement.ToString("yyyyMMddHHmmss"));
                    if (dlDateExportationDernierChargement.ToString("yyyyMMddHHmmss") != "19500601000000")
                    {
                        if (dlDateExportationDossierTMP == dlDateExportationDernierChargement)
                        {
                            InsertTableLogChargement("MettreAJourBD()", "Mise à jour de la base de données --> OK (Rapport existant - Exportation : " + dlDateExportationDernierChargement.ToString());
                        }
                        else
                        {
                            // Mettre à jour la date d'exportation
                            cmdSql = "update Chargement set DateExportation ='" + dlDateExportationDossierTMP + "' where CodeDocument ='" + spCodeDocument + "'";
                            ExecuteAccessQuery(cmdSql);

                            // Vider les tables officielles pour y insérer le nouveau chargement
                            DeleteTableProduction(spCodeDocument);
                            InsertTableProduction();
                        }
                    }
                    else
                    {
                        //premiere importation du rapport
                        //lancer le début de transaction
                        cmdSql = "insert into Chargement (CodeDocument, DateExportation) values ('" + spCodeDocument + "', '" + dlDateExportationDossierTMP + "')";
                        ExecuteAccessQuery(cmdSql);
                        InsertTableProduction();
                    }
                }
                else
                {
                    InsertTableLogChargement("MettreAJourBD()", "La date d''exportation n''est pas initialisée pour le document :: " + spCodeDocument);
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Valide s'il y a une date d'exportation dans la table Dossier_TMP
            ///
            ///////////////////////////////////////////////////////////////////////
            DateTime ValideDateExportation(string spCodeDocument)
            {

                string sqlCorrCmd = "Select DateExportation from Dossier_TMP where CodeDocument = '" + spCodeDocument + "'";
                string dtDateExportation = "";
                OleDbCommand commandDataReader = new OleDbCommand(sqlCorrCmd, connectionAccess);

                try
                {
                    using (OleDbDataReader readerCorr = commandDataReader.ExecuteReader())
                    {
                        // Lire l'occurrences de la table Document_TMP
                        while (readerCorr.Read())
                        {
                            dtDateExportation = readerCorr["DateExportation"].ToString();
                        }
                        readerCorr.Close();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("ValideDateExportation()", "Étape 1", ex.Message.ToString());
                }

                if (dtDateExportation.ToString() != "")
                {
                    return Convert.ToDateTime(dtDateExportation);
                }
                else
                {
                    return Convert.ToDateTime("1950-06-01");
                }

            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Valide s'il y a une date du chargement
            ///
            ///////////////////////////////////////////////////////////////////////
            DateTime ValideDateChargement(string spCodeDocument)
            {

                string sqlCorrCmd = "Select DateExportation from Chargement where CodeDocument = '" + spCodeDocument + "'";
                string strDateExportationChargement = "";
                OleDbCommand commandDataReader = new OleDbCommand(sqlCorrCmd, connectionAccess);

                try
                {
                    using (OleDbDataReader readerCorr = commandDataReader.ExecuteReader())
                    {
                        // Lire l'occurrences de la table Document_TMP
                        while (readerCorr.Read())
                        {
                            strDateExportationChargement = readerCorr["DateExportation"].ToString();
                        }
                        readerCorr.Close();
                    }
                }
                catch (Exception ex)

                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("ValideDateChargement()", "Étape 1", ex.Message.ToString());
                }

                if (strDateExportationChargement != "")
                {
                    return Convert.ToDateTime(strDateExportationChargement);
                }
                else
                {
                    return Convert.ToDateTime("1950-06-01");
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     déplace le fichier
            ///
            /////////////////////////////////////////////////////////////////////
            void DeplacerFichier(string de, string a)
            {
                try
                {
                    if (System.IO.File.Exists(a))
                    {
                        System.IO.File.Delete(a);
                    }
                    System.IO.File.Move(de, a);
                }
                catch (IOException ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("DeplacerFichier()", "Null", ex.Message.ToString());
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Envois le courriel s'il y a une ou des erreurs
            ///
            ///////////////////////////////////////////////////////////////////////
            void SendMailMessageError(string EnvoisCourrielPar)
            {
                int recCount = 0;
                String strAfficheErreur = "";
                String SQLString = tblAfficheErreur.ToString();
                String EnvoisCourrielA = "centre.de.pilotage@rbq.gouv.qc.ca";  //"yves.mcduff-ext@rbq.gouv.qc.ca"; //"centre.de.pilotage@rbq.gouv.qc.ca";
                String EnvoisCourrielSuject = "L'application (ServiceVerificationEnquete) a une ou plusieurs erreurs d'exécutions ";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine +
                                             "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";


                // Lire les erreurs
                using (SqlDataAdapter dataAdapterAfficheErreur = new SqlDataAdapter(SQLString, mySQLConnection))
                {
                    // create the DataSet 
                    try
                    {
                        DataSet dataSetAfficheErreur = new DataSet();
                        dataAdapterAfficheErreur.SelectCommand.CommandTimeout = 180;
                        dataAdapterAfficheErreur.Fill(dataSetAfficheErreur, "AfficheErreur");
                        recCount = 0;

                        foreach (DataRow pRowRegleAfficheErreur in dataSetAfficheErreur.Tables["AfficheErreur"].Rows)
                        {

                            if (recCount < 16)
                            {
                                strAfficheErreur = strAfficheErreur.ToString() + newLine + pRowRegleAfficheErreur["IndSystem"].ToString() + " - " +
                                                                                           pRowRegleAfficheErreur["JobName"].ToString() + " - " +
                                                                                           pRowRegleAfficheErreur["NomTable"].ToString() + " - " +
                                                                                           pRowRegleAfficheErreur["ErrorMessage"].ToString() + newLine;
                            }

                            recCount++;

                        }
                    }
                    catch (Exception ex)
                    {
                        ///
                        strMessageSql = "Fonction SendMailMessageError (dataSetAfficheErreur) Erreur SQL ";
                        InsertTableLogJobConnecteur("MAIL", "Étape 1", strMessageSql.ToString());
                        succesLoadTable = false;
                    }
                }

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + strAfficheErreur.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();

                String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message.ToString();
                    strMessageSql = "Fonction SendMailMessageError (SmtpClient) Erreur SQL ";
                    InsertTableLogJobConnecteur("MAIL", "Étape 2", strMessageSql.ToString());
                    succesLoadTable = false;
                }
                InsertTableLogChargement("Mail", "Mail Envoyé");
            }


        }

        private bool defined()
        {
            throw new NotImplementedException();
        }
        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
