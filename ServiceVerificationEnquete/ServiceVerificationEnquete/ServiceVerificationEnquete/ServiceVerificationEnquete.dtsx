       public class MesCorrespondances
        {
            private List<String> Balise;
            private List<String> Champ_Document;
            private List<String> Nom_Table;
            private List<String> Nom_Champ;
            private List<String> Valeur;
            public List<String> strBalise { get { return Balise; } set { Balise = value; } }
            public List<String> strChamp_Document { get { return Champ_Document; } set { Champ_Document = value; } }
            public List<String> strNom_Table { get { return Nom_Table; } set { Nom_Table = value; } }
            public List<string> strNom_Champ { get { return Nom_Champ; } set { Nom_Champ = value; } }
            public List<string> strValeur { get { return Valeur; } set { Valeur = value; } }
        }

        MesCorrespondances checkMesCorrespondances = new MesCorrespondances()
        {
            strBalise = new List<string>(),
            strChamp_Document = new List<string>(),
            strNom_Table = new List<string>(),
            strNom_Champ = new List<string>(),
            strValeur = new List<string>()
        };


        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        public void Main()
        {
            ServiceVerificationEnquete();
            Dts.TaskResult = (int)ScriptResults.Success;
        }


        public void ServiceVerificationEnquete()
        {
            bool succesLoadTable = true;
            bool blErreurExecution = false;
            bool LoadTableErreur = false;
            string strMessageSql = "";
            string strEtape = "";
            string strRepertoireChargement = "";
            string strCodeDocument = "";

            string date = DateTime.Now.ToString("yyyy-MM-dd hh:mm:ss");
            string EnvoyePar = Dts.Variables["User::EnvoyePar"].Value.ToString();
            string ConnectStringAccess = @Dts.Variables["User::ConnectStringAccess"].Value.ToString();

            strEtape = "Début";

            SqlConnection mySQLConnection =
                Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                as SqlConnection;

            OleDbConnection connectionAccess = new OleDbConnection(ConnectStringAccess);

            // delete l'historique du dernier log de chargement
            DeleteTableLogChargement();
            DeleteTableLogJobChargement();
            InsertTableLogChargement("ServiceVerificationEnquete", "Début du traitement");

            strEtape = "Connecter à la BD";
            // Connecter à la BD   
            try
            {
                connectionAccess.Open();
            }
            catch (Exception ex)
            {
                //MessageBox.Show(ex.Message);
                InsertTableLogJobConnecteur("ServiceVerificationEnquete(connectionAccess.Open())", strEtape, ex.Message.ToString());
                LoadTableErreur = true;
            }

            // Load les variables paramètres
            strEtape = "Obtenir les paramètre";
            LoadParametres();

            if (LoadTableErreur != true)
            {
                strRepertoireChargement = ObtenirRepertoire("DOSSIER_EXPORTATION");

                strEtape = "Traitement des fichiers ...";


                if (strRepertoireChargement != "")
                {
                    // Lire le répertoire 
                    DirectoryInfo d = new DirectoryInfo(@strRepertoireChargement);
                    try
                    {

                        FileInfo[] Files = d.GetFiles("*.rbq");

                        foreach (FileInfo file in Files)
                        {
                            blErreurExecution = false;
                            InsertTableLogChargement("Traite le fichier", file.Name);
                            InitialiserTablesImportation();

                            strCodeDocument = file.Name.Substring(0, file.Name.Length - 4);

                            ImporterRapportVerification(file.FullName, strCodeDocument, file.Name);

                            if (blErreurExecution != true)
                            {
                                MettreAJourBD(strCodeDocument);
                            }

                            if (blErreurExecution)
                            {
                                DeplacerFichier(@file.FullName, strRepertoireChargement + "Echecs\\" + file.Name);
                                InsertTableLogChargement("ServiceVerificationEnquete", "Erreur fichier :: " + file.Name.ToString());
                                InsertTableLogJobConnecteur("DeplacerFichier()", null, "Erreur fichier :: " + file.Name.ToString());
                                LoadTableErreur = true;
                            }
                            else
                            {
                                DeplacerFichier(@file.FullName, strRepertoireChargement + "Succes\\" + file.Name);
                                InsertTableLogChargement("ServiceVerificationEnquete", "Fin du traitement fichier :: " + file.Name.ToString());
                            }

                            InsertTableLogChargement("Fichier complété", file.Name);
                        }

                        CorrigerChampResultat();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        blErreurExecution = true;
                        InsertTableLogJobConnecteur("ServiceVerificationEnquete()", strEtape, ex.Message.ToString());
                    }
                }
            }

            InsertExcel();

            if (LoadTableErreur == true)
            {
                // Envois un courriel si erreur de programmation (SQL ou autre)
                SendMailMessageError(EnvoyePar);
            }

            InsertTableLogChargement("ServiceVerificationEnquete", "Fin du traitement");
            mySQLConnection.Close();
            connectionAccess.Close();

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Chargement_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogChargement(string strIndSystem, string strSqlTable)
            {
                string sqlInsCmd = "insert into[SDDMU01].[dbo].[Log_Chargement_Connecteur] values('ServiceVerificationEnquete', '" + strIndSystem + "', '" + strSqlTable + "', GETDATE(), 'Auto01', 'Tâche Automatisée')";

                try
                {
                    SqlCommand SQLCommandLog = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandLog.CommandType = CommandType.Text;
                    SqlDataReader readerLog = SQLCommandLog.ExecuteReader();
                    readerLog.Read();
                    readerLog.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobConnecteur("InsertTableLogChargement()", "Étape 1", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Job_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogJobConnecteur(string pFonction, string pEtape, string pErreurMessage)
            {
                int lParametreErreurMessage;
                pErreurMessage = pErreurMessage.Replace("'", "''");
                pFonction = pFonction.Replace("'", "''");

                lParametreErreurMessage = pErreurMessage.Length;

                if (pErreurMessage.Length > 250)
                {
                    pErreurMessage = pErreurMessage.Substring(0, 245);
                    pErreurMessage = pErreurMessage + "...";
                }

                string sqlInsCmd = "insert into[SDDMU01].[dbo].[Log_Job_Connecteur] values('ServiceVerificationEnquete', '" + oSystem + "', '" + pEtape + "', '" + pFonction + "', 'Erreur', '" + pErreurMessage + "', 'Auto01', GETDATE())";

                try
                {
                    SqlCommand SQLCommandJob = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandJob.CommandType = CommandType.Text;
                    SqlDataReader readerErreur = SQLCommandJob.ExecuteReader();
                    readerErreur.Read();
                    readerErreur.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogChargement("ERR", "Impossible d''insérer dans Log_Job_Connecteur ::: " + ex.Message);
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Détruit les informations dant la table Log_Chargement_Connecteur
            ///
            ///////////////////////////////////////////////////////////////////////
            void DeleteTableLogChargement()
            {
                string sqlDelCmd = delLogChargement.ToString();

                try
                {
                    SqlCommand SQLCommandDel = new SqlCommand(sqlDelCmd.ToString(), mySQLConnection);
                    SQLCommandDel.CommandType = CommandType.Text;
                    SqlDataReader readerDel = SQLCommandDel.ExecuteReader();
                    readerDel.Read();
                    readerDel.Close();
                }
