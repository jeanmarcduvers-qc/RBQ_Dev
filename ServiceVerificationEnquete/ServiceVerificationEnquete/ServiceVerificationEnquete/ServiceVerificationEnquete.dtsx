            ////////////////////////////////////////////////////////////////////////
            ///
            //     Insert les résultats dans le fichier Excel
            ///
            ///////////////////////////////////////////////////////////////////////
            void InsertExcel()
            {
                InsertTableLogChargement("ServiceVerificationEnquete", "InsertExcel");

                string sqlCmd = "SSIS_ExtractionExcel";
                //string strNomFichier = oPathEnvironnement + oDossierExcel + "ExtractionExcel.xlsx";

                try
                {
                    strEtape = "Connection BD (" + connectionAccess.ConnectionString + ")";
                    OleDbCommand cmd = new OleDbCommand();
                    cmd.Connection = connectionAccess;
                    cmd.CommandType = CommandType.StoredProcedure;
                    cmd.CommandText = sqlCmd;
                    cmd.Parameters.AddWithValue("@DOSSIER_RAPPORTS", @oPathEnvironnement + @oDossierExcel);

                    OleDbDataAdapter adapter = new OleDbDataAdapter(cmd);
                    DataSet daSet = new DataSet();
                    adapter.Fill(daSet);

                    strEtape = "Création du fichier Excel (" + @oPathEnvironnement + @oDossierExcel + "ExtractionExcel.xml )";
                    string excelFile = @oPathEnvironnement + @oDossierExcel + "ExtractionExcel.xml";

                    using (ExcelWriter writer = new ExcelWriter(excelFile))
                    {
                        writer.WriteStartDocument();
                        foreach (DataTable table in daSet.Tables)
                        {
                            writer.WriteStartWorksheet("ExtractionExcel");
                            writer.WriteStartRow(); //Écrire l'entête
                            foreach (DataColumn col in table.Columns)
                            {
                                writer.WriteExcelUnstyledCell(col.Caption);
                            }
                            writer.WriteEndRow();
                            foreach (DataRow row in table.Rows) // Écrire le data
                            {
                                writer.WriteStartRow();
                                foreach (object o in row.ItemArray)
                                {
                                    writer.WriteExcelAutoStyledCell(o);
                                }
                                writer.WriteEndRow();
                            }
                            writer.WriteEndWorksheet(); // Ferme le document
                        }
                        writer.WriteEndDocument();
                        writer.Close();
                    }

                }

                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobConnecteur("InsertExcel()", strEtape, ex.Message.ToString());
                    LoadTableErreur = true;
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Récupère le chemin complet d'un dossier
            ///
            /////////////////////////////////////////////////////////////////////
            string ObtenirRepertoire(string sp)
            {

                string xlDossier = "";
                string xlPath = oPathEnvironnement;
                string pathValue = "";

                switch (sp)
                {
                    case "DOSSIER_EXCEL":
                        xlDossier = oDossierExcel;
                        break;
                    case "DOSSIER_RAPPORTS":
                        xlDossier = oDossierRapports;
                        break;
                    case "DOSSIER_EXPORTATION":
                        xlDossier = oDossierExportation;
                        break;
                    case "DOSSIER_REPERTOIRES":
                        xlPath = oPathDirect;
                        xlDossier = oDossierRepertoires;
                        break;
                }

                if (Directory.Exists(xlPath + xlDossier) && (xlPath != "" && xlDossier != ""))
                {
                    pathValue = xlPath + xlDossier;
                }
                else
                {
                    pathValue = "";
                    InsertTableLogJobConnecteur("ObtenirRepertoire(" + xlPath + xlDossier + ")", "Obtenir le chemin complet pour " + sp, "Valeur manquante");
                }

                return pathValue;
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Force le format de la vaaleur
            ///
            /////////////////////////////////////////////////////////////////////
            string ForcerFormatValeurChamp(string strValeur)
            {
                string strReturnValeur = "";

                switch (strValeur)
                {
                    case "Vrai":
                        strReturnValeur = "True";
                        break;
                    case "Faux":
                        strReturnValeur = "False";
                        break;
                    default:
                        if (strValeur != "")
                        {
                            strReturnValeur = "'" + strValeur.Replace("'", "''") + "'";
                        }
                        else
                        {
                            strReturnValeur = "NULL";
                        }

                        break;
                }
                return strReturnValeur;
            }
