        public const string tblDocumentRegle = "SELECT [AQ_C_SYSTEM], " +
                                                      "[AQ_NM_DOCUMENT], " +
                                                      "[AQ_N_ROWD_REGLE_AFFAIRE], " +
                                                      "[AQ_C_REGLE], " +
                                                      "[AQ_DE_SQL], " +
                                                      "[AQ_DE_MESSAGE], " +
                                                      "[AQ_NB_ERREUR_MAX_TRAN], " +
                                                      "[AQ_DE_PERIODE], " +
                                                      "[AQ_DE_COLN_FICH], " +
                                                      "[AQ_A_COURRIEL_A], " +
                                                      "[AQ_A_COURRIEL_CC], " +
                                                      "[AQ_DE_REGLE_AFFAIRE], " +
                                                      "[AQ_NM_ENTT_COLN_FICH] " +
                                                 "FROM [AQT].[AQ1_DOCUMENT] doc " +
                                                 "inner join [AQT].[AQ1_REGLE_AFFAIRE] raff on raff.[AQ_N_ROWD_DOCUMENT] = doc.[AQ_N_ROWD_DOCUMENT] and[AQ_I_ACTF_REGL_AFFR] = 'O' " +
                                                 "WHERE [AQ_I_ACTF_DOCM] = 'O' " +
                                                 "order by doc.[AQ_N_ROWD_DOCUMENT], AQ_N_ROWD_REGLE_AFFAIRE ";
        //"AND   [AQ_C_REGLE]  in ('INT_EXAM_NON_REF')"; //, 'FORM_DOUB'
        //"AND   [AQ_C_SYSTEM] = 'GSR' ";
        //"AND   raff.AQ_N_ROWD_REGLE_AFFAIRE in (295) ";

        public const string delRegleErreur = "DELETE [AQT].[AQ1_REGLE_ERREUR] where [AQ_D_CRET_OCCR_ERR] is null ";
        public const string delRegleErreurToDay = "DELETE [AQT].[AQ1_REGLE_ERREUR] where AQ_D_CRET >=  CAST(FLOOR(CAST(GETDATE() AS FLOAT)) AS smallDateTime) ";

        public const string tblRegleErreur = "INSERT INTO [AQT].[AQ1_REGLE_ERREUR] ([AQ_N_ROWD_REGLE_AFFAIRE], [AQ_DE_ERREUR], [AQ_DE_VALR_OCCR_ERR], [AQ_C_UTIL_CRET_OCCR_ERR], [AQ_D_CRET_OCCR_ERR], [AQ_D_CRITERE], [AQ_RESPONSABLE_ERREUR], [AQ_ID_ELEMENT]) VALUES ( '";

        public const string tblHistoriqueExecution = "INSERT INTO [AQT].[AQ1_HISTORIQUE_EXECUTION] ([AQ_N_ROWD_REGLE_AFFAIRE], [AQ_DE_PERIODE], [AQ_D_EXECUTION], [AQ_NB_ERREUR_EXECUTION], [AQ_NB_ERREUR_MAX_TRAN]) VALUES('";

        public const string tblAfficheErreur = "SELECT  [AQ_DE_ERREUR], " +
                                                       "[AQ_DE_VALR_OCCR_ERR] " +
                                               "FROM    [AQT].[AQ1_REGLE_ERREUR] " +
                                               "where   AQ_D_CRET >=  CAST(FLOOR(CAST(GETDATE() AS FLOAT)) AS smallDateTime) " +
                                               "and     [AQ_N_ROWD_REGLE_AFFAIRE] = ";

        public const string tblAfficheErreurConception = "SELECT distinct [AQ_C_SYSTEM] " +
                                                                        ",[AQ_NM_DOCUMENT] " +
                                                                        ",[AQ_C_REGLE] " +
                                                                        ",[AQ_DE_REGLE_AFFAIRE] " +
                                                                        ",[AQ_DE_ERREUR] " +
                                                                        "FROM [SDGIC01].[AQT].[AQ1_REGLE_ERREUR] err " +
                                                                        "inner join[SDGIC01].[AQT].[AQ1_REGLE_AFFAIRE] raff on raff.[AQ_N_ROWD_REGLE_AFFAIRE] = err.[AQ_N_ROWD_REGLE_AFFAIRE] " +
                                                                        "inner join[SDGIC01].[AQT].[AQ1_DOCUMENT] doc on doc.AQ_N_ROWD_DOCUMENT = raff.AQ_N_ROWD_DOCUMENT " +
                                                                        "where [AQ_D_CRET_OCCR_ERR] is null ";

        public string newLine = Environment.NewLine;
        public bool boolErreurProgram = false;

        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        public void Main()
        {
            TraiteTableAQ();
            Dts.TaskResult = (int)ScriptResults.Success;
        }


        public void TraiteTableAQ()
        {
            bool succesDocument = true;
            int recCount = 0;
            string strMessageSql = "";
            String date = DateTime.Now.ToString("yyyy-MM-dd hh:mm:ss");
            String EnvoyePar = Dts.Variables["User::EnvoyePar"].Value.ToString();

            SqlConnection myAQConnection =
                Dts.Connections["ConnectBD_AQ"].AcquireConnection(Dts.Transaction)
                as SqlConnection;

            // Détruire les erreurs de la règle d'affaire
            DeleteTableRegleErreur();
            DeleteTableRegleErreurToDay();

            using (SqlDataAdapter dataAdapter = new SqlDataAdapter(tblDocumentRegle.ToString(), myAQConnection))
            {
                // Création du DataSet 
                DataSet dataSetDocumentRegle = new DataSet();
                dataAdapter.SelectCommand.CommandTimeout = 600;
                dataAdapter.Fill(dataSetDocumentRegle, "Regle");

                foreach (DataRow pRowDocumentRegle in dataSetDocumentRegle.Tables["Regle"].Rows)
                {
                    // Lire les règles d'affaire document
                    using (SqlDataAdapter dataAdapterRegleAffaireValidation = new SqlDataAdapter(pRowDocumentRegle["AQ_DE_SQL"].ToString(), myAQConnection))
                    {
                        // Création du DataSet règle
                        try
                        {
                            DataSet dataSetRegleAffaireValidation = new DataSet();
                            dataAdapterRegleAffaireValidation.SelectCommand.CommandTimeout = 12000;
                            dataAdapterRegleAffaireValidation.Fill(dataSetRegleAffaireValidation, "Validation");
                            recCount = 0;

                            foreach (DataRow pRowRegleAffaireValidation in dataSetRegleAffaireValidation.Tables["Validation"].Rows)
                            {
                                if (recCount == 0)
                                {
                                    // Insertion des historiques d'exécutions
                                    InsertTableHistoriqueExecution(pRowDocumentRegle, pRowRegleAffaireValidation.Table.Rows.Count);
                                }
                                // Insertion des règles d'affaire en erreur
                                InsertTableRegleErreur(pRowDocumentRegle, pRowRegleAffaireValidation);

                                // En cas d'erreurs ne pas poursuivre ou le nombre d'erreur maximum est atteint
                                if ((succesDocument == false) ||
                                    ((pRowDocumentRegle["AQ_NB_ERREUR_MAX_TRAN"].ToString() != "0") && ((recCount + 1) >= Int64.Parse(pRowDocumentRegle["AQ_NB_ERREUR_MAX_TRAN"].ToString()))))
                                {
                                    break;
                                }

                                recCount++;

                            }

                            if (recCount == 0) // Il n'y avait pas d'erreurs
                            {
                                // Insertion des historiques d'exécutions
                                InsertTableHistoriqueExecution(pRowDocumentRegle, 0);
                            }

                            if ((pRowDocumentRegle["AQ_A_COURRIEL_A"].ToString() != "") && (recCount != 0))
                            {
                                // Envoyer le courriel
                                SendMailMessage(EnvoyePar, pRowDocumentRegle);
                            }
                        }
                        catch (Exception ex)
                        {
                            //MessageBox.Show(ex.Message.ToString() + "\n\nCode de la règle : " + pRowDocumentRegle["AQ_C_REGLE"].ToString());
                            strMessageSql = "(dataAdapterRegleAffaireValidation) Erreur SQL :: " + ex.Message.ToString() + " - Code de la règle : " + pRowDocumentRegle["AQ_C_REGLE"].ToString();
                            boolErreurProgram = true;
                            InsertTableErreurSQL(pRowDocumentRegle, strMessageSql);
                        }
                    }

                    // Fin de Règle d'affaire validation
                }

                // Envois un courriel si erreur de programmation (SQL ou autre)
                if (boolErreurProgram)
                {
                    SendMailMessageErrorProgramme(EnvoyePar);
                }

                myAQConnection.Close();
                Dts.TaskResult = (int)ScriptResults.Success;
            }

            void DeleteTableRegleErreur()
            {
                string sqlDelCmd = delRegleErreur.ToString();
                try
                {
                    SqlCommand SQLCommand = new SqlCommand(sqlDelCmd.ToString(), myAQConnection);
                    SQLCommand.CommandType = CommandType.Text;
                    SqlDataReader reader = SQLCommand.ExecuteReader();
                    reader.Read();
                    reader.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    //MessageBox.Show("Erreur delete dans la table AQ_REGLE_ERREUR :: " + sqlDelCmd.ToString());
                    //strMessageSql = "(DeleteTableRegleErreur) Erreur SQL :: " + ex.Message.ToString();
                    //InsertTableErreurSQL(ppRowRegle, strMessageSql);
                    succesDocument = false;
                }
            }

            void DeleteTableRegleErreurToDay()
            {
                string sqlDelCmd = delRegleErreurToDay.ToString();
                try
                {
                    SqlCommand SQLCommand = new SqlCommand(sqlDelCmd.ToString(), myAQConnection);
                    SQLCommand.CommandType = CommandType.Text;
                    SqlDataReader reader = SQLCommand.ExecuteReader();
                    reader.Read();
                    reader.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    //MessageBox.Show("Erreur delete dans la table AQ_REGLE_ERREUR :: " + sqlDelCmd.ToString());
                    //strMessageSql = "(DeleteTableRegleErreur) Erreur SQL :: " + ex.Message.ToString();
                    //InsertTableErreurSQL(ppRowRegle, strMessageSql);
                    succesDocument = false;
                }
            }

            void InsertTableRegleErreur(DataRow ppRowRegle, DataRow ppRowValidation)
            {
                string strDateCreeSQL = "";
                string strmessage = GetMessage(ppRowValidation, ppRowRegle["AQ_DE_MESSAGE"].ToString());
                string strmessageCSV = GetMessage(ppRowValidation, ppRowRegle["AQ_DE_COLN_FICH"].ToString());
                string strUtilCree = GetColumn(ppRowValidation, "GI3_C_UTIL_CRET");
                string strDateCree = GetColumn(ppRowValidation, "GI3_D_CRET");
                string strDateCritere = GetColumn(ppRowValidation, "AQ_D_CRITERE");
                string strResponsableErreur = GetColumn(ppRowValidation, "AQ_RESPONSABLE_ERREUR");
                string strIdErreur = GetColumn(ppRowValidation, "AQ_ID_ELEMENT");

                if (strDateCree.ToString() != "")
                {
                    strDateCreeSQL = "Cast('" + strDateCree + "' as date)";
                }
                else
                {
                    strDateCreeSQL = "Cast('1950-01-01' as date)";
                }

                if (strDateCritere.ToString() != "")
                {
                    strDateCritere = "Cast('" + strDateCritere + "' as date)";
                }
                else
                {
                    strDateCritere = "null";
                }

                if (strResponsableErreur.ToString() != "")
                {
                    strResponsableErreur = "'" + strResponsableErreur + "'";
                }
                else
                {
                    strResponsableErreur = "null";
                }

                if (strIdErreur.ToString() != "")
                {
                    strIdErreur = "'" + strIdErreur + "'";
                }
                else
                {
                    strIdErreur = "null";
                }

                string sqlCmd = tblRegleErreur.ToString() + ppRowRegle["AQ_N_ROWD_REGLE_AFFAIRE"] +
                                                 "', '" + strmessage +
                                                 "', '" + strmessageCSV +
                                                 "', '" + strUtilCree +
                                                 "', " + strDateCreeSQL +
                                                 ", " + strDateCritere +
                                                 ", " + strResponsableErreur +
                                                 ", " + strIdErreur + ")";

                try
                {
                    SqlCommand SQLCommand = new SqlCommand(sqlCmd.ToString(), myAQConnection);
                    SQLCommand.CommandType = CommandType.Text;
                    SqlDataReader reader = SQLCommand.ExecuteReader();
                    reader.Read();
                    reader.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    //MessageBox.Show("Erreur d'insertion dans la table AQ_REGLE_ERREUR :: " + sqlCmd.ToString());
                    strMessageSql = "(InsertTableRegleErreur) Erreur SQL :: " + ex.Message.ToString() + " - Code de la règle : " + ppRowRegle["AQ_C_REGLE"].ToString();
                    boolErreurProgram = true;
                    InsertTableErreurSQL(ppRowRegle, strMessageSql);
                }
            }

            void InsertTableErreurSQL(DataRow ppRowRegle, string pmessage)
            {
                string strMessage = pmessage.Replace("'", "''").ToString();
                string sqlCmd = tblRegleErreur.ToString() + ppRowRegle["AQ_N_ROWD_REGLE_AFFAIRE"] +
                                                 "', '" + strMessage + "', null, null, null, null, null, null)";
                try
                {
                    SqlCommand SQLCommand = new SqlCommand(sqlCmd.ToString(), myAQConnection);
                    SQLCommand.CommandType = CommandType.Text;
                    SqlDataReader reader = SQLCommand.ExecuteReader();
                    reader.Read();
                    reader.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    //MessageBox.Show("Erreur d'insertion dans la table AQ_REGLE_ERREUR :: " + sqlCmd.ToString());
                    strMessageSql = "(InsertTableErreurSQL) Erreur SQL :: " + ex.Message.ToString() + " - Code de la règle : " + ppRowRegle["AQ_C_REGLE"].ToString();
                    boolErreurProgram = true;
                    InsertTableErreurSQL(ppRowRegle, strMessageSql);
                    succesDocument = false;
                }
            }

            void InsertTableHistoriqueExecution(DataRow ppRowRegle, int nbErreur)
            {
                string sqlCmd = tblHistoriqueExecution.ToString() + ppRowRegle["AQ_N_ROWD_REGLE_AFFAIRE"] +
                                                 "', '" + ppRowRegle["AQ_DE_PERIODE"] +
                                                 "', cast('" + date.ToString() +
                                                 "' as date), '" + nbErreur.ToString() +
                                                 "', '" + ppRowRegle["AQ_NB_ERREUR_MAX_TRAN"] + "')";
                try
                {
                    SqlCommand SQLCommand = new SqlCommand(sqlCmd.ToString(), myAQConnection);
                    SQLCommand.CommandType = CommandType.Text;
                    SqlDataReader reader = SQLCommand.ExecuteReader();
                    reader.Read();
                    reader.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    //MessageBox.Show("Erreur d'insertion dans la table AQ1_HISTORIQUE_EXECUTION :: " + sqlCmd.ToString());
                    strMessageSql = "(InsertTableHistoriqueExecution) Erreur SQL :: " + ex.Message.ToString() + " - Code de la règle : " + ppRowRegle["AQ_C_REGLE"].ToString() + " - " + sqlCmd.ToString();
                    boolErreurProgram = true;
                    InsertTableErreurSQL(ppRowRegle, strMessageSql);
                    succesDocument = false;
                }
            }

            void SendMailMessage(string EnvoisCourrielPar, DataRow pRowRegle)
            {
                String strAfficheErreur = "";
                String SQLString = tblAfficheErreur + pRowRegle["AQ_N_ROWD_REGLE_AFFAIRE"].ToString();
                String EnvoisCourrielA = pRowRegle["AQ_A_COURRIEL_A"].ToString();
                String EnvoisCourrielCC = pRowRegle["AQ_A_COURRIEL_CC"].ToString();
                String EnvoisCourrielSuject = "Le système (" + pRowRegle["AQ_C_SYSTEM"].ToString() + ") dont la règle de validation :: " + pRowRegle["AQ_C_REGLE"].ToString() + " - " + pRowRegle["AQ_DE_REGLE_AFFAIRE"].ToString();
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine + "« " +
                                             EnvoisCourrielSuject + " » a une ou plusieurs erreurs possibles." + newLine + newLine +
                                             "Merci d’appliquer les correctifs si c’est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "En pièce jointe, un fichier CSV contenant la totalité des erreurs." + newLine + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boîte Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l’information" + newLine +
                                                 "Régie du bâtiment du Québec";
                // String strpath = "\\S366R03C01PAR1\\RBQ_Collectif\\DGSO\\Pilotage\\999 -Info de gestion source\\RBQ_Dev\\Reports\\Assurance Qualité\\Attachements_CSV\\" + pRowRegle["AQ_C_REGLE"].ToString() + ".csv";
                String strpath = Dts.Variables["User::csvDirectory"].Value.ToString() + pRowRegle["AQ_C_REGLE"].ToString() + ".csv";

                if (File.Exists(strpath))
                {
                    // Si le fichier existe le détruire
                    File.Delete(strpath);
                }

                StreamWriter sw = new StreamWriter(strpath, true, Encoding.Unicode);
                sw.WriteLine(pRowRegle["AQ_NM_ENTT_COLN_FICH"].ToString());

                // Lire les règles d'affaire
                using (SqlDataAdapter dataAdapterAfficheErreur = new SqlDataAdapter(SQLString, myAQConnection))
                {
                    // create the DataSet 
                    try
                    {
                        DataSet dataSetAfficheErreur = new DataSet();
                        dataAdapterAfficheErreur.SelectCommand.CommandTimeout = 600;
                        dataAdapterAfficheErreur.Fill(dataSetAfficheErreur, "AfficheErreur");
                        recCount = 0;

                        foreach (DataRow pRowRegleAfficheErreur in dataSetAfficheErreur.Tables["AfficheErreur"].Rows)
                        {

                            if (recCount < 16)
                            {
                                strAfficheErreur = strAfficheErreur.ToString() + newLine + pRowRegleAfficheErreur["AQ_DE_ERREUR"].ToString() + newLine;
                            }

                            sw.WriteLine(pRowRegleAfficheErreur["AQ_DE_VALR_OCCR_ERR"].ToString());
                            recCount++;

                        }
                    }
                    catch (Exception ex)
                    {
                        ///
                        strMessageSql = "Fonction SendMailMessage (dataSetAfficheErreur) Erreur SQL :: " + ex.Message.ToString() + " - Code de la règle : " + pRowRegle["AQ_C_REGLE"].ToString();
                        boolErreurProgram = true;
                        InsertTableErreurSQL(pRowRegle, strMessageSql);
                    }
                }

                sw.Close();

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + strAfficheErreur.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();
                string file_attachment = strpath.ToString();
                String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                try
                {
                    // Création de l'attachement
                    System.Net.Mail.Attachment fileAttachment;
                    fileAttachment = new System.Net.Mail.Attachment(file_attachment);

                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);
                    if (EnvoisCourrielCC.ToString() != "")
                    {
                        FormatCourrielHtml.CC.Add(EnvoisCourrielCC.ToString());
                    }
                    //FormatCourrielHtml.IsBodyHtml = true;
                    //Ajout de l'attachements
                    FormatCourrielHtml.Attachments.Add(fileAttachment);

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message.ToString() + "\n\nCode de la règle : " + pRowRegle["AQ_C_REGLE"].ToString());
                    strMessageSql = "Fonction SendMailMessage - SMTP Erreur :: " + ex.Message.ToString() + " - Code de la règle : " + pRowRegle["AQ_C_REGLE"].ToString();
                    boolErreurProgram = true;
                    InsertTableErreurSQL(pRowRegle, strMessageSql);
                }
            }
            void SendMailMessageErrorProgramme(string EnvoisCourrielPar)
            {
                String strAfficheErreur = "";
                String SQLString = tblAfficheErreurConception.ToString();
                String EnvoisCourrielA = "centre.de.pilotage@rbq.gouv.qc.ca"; //"yves.mcduff-ext@rbq.gouv.qc.ca"; // 
                String EnvoisCourrielSuject = "L'application (Assurance Qualité) a une ou plusieurs erreurs d'exécutions ";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine +
                                             "Merci d’appliquer les correctifs si c’est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boîte Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l’information" + newLine +
                                                 "Régie du bâtiment du Québec";


                // Lire les règles d'affaire
                using (SqlDataAdapter dataAdapterAfficheErreur = new SqlDataAdapter(SQLString, myAQConnection))
                {
                    // create the DataSet 
                    try
                    {
                        DataSet dataSetAfficheErreur = new DataSet();
                        dataAdapterAfficheErreur.SelectCommand.CommandTimeout = 600;
                        dataAdapterAfficheErreur.Fill(dataSetAfficheErreur, "AfficheErreur");
                        recCount = 0;

                        foreach (DataRow pRowRegleAfficheErreur in dataSetAfficheErreur.Tables["AfficheErreur"].Rows)
                        {

                            if (recCount < 16)
                            {
                                strAfficheErreur = strAfficheErreur.ToString() + newLine +
                                                                                 pRowRegleAfficheErreur["AQ_NM_DOCUMENT"].ToString() + " - " +
                                                                                 pRowRegleAfficheErreur["AQ_C_REGLE"].ToString() + " - " +
                                                                                 pRowRegleAfficheErreur["AQ_DE_ERREUR"].ToString() + newLine;
                            }

                            recCount++;

                        }
                    }
                    catch (Exception ex)
                    {
                        ///
                        boolErreurProgram = true;
                        strMessageSql = "Fonction SendMailMessageErrorProgramme (dataSetAfficheErreur) Erreur SQL ";
                    }
                }

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + strAfficheErreur.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();

                String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message.ToString() + "\n\nCode de la règle : " + pRowRegle["AQ_C_REGLE"].ToString());
                    boolErreurProgram = true;
                    strMessageSql = "Fonction SendMailMessageErrorProgramme (dataSetAfficheErreur) Erreur SQL ";
                }
            }

        }

        public string GetMessage(DataRow ppRowValidation, string pmessage)
        {
            string strMessage = pmessage.Replace("   ", ""); // On enleve le surplus d'Espaces
            strMessage = strMessage.Replace("  ", "");        // On enleve le surplus d'Espaces
            string strMessageRemplace = "";
            string strReplace = "";
            string strReplace2 = "";
            string strList = "";

            int count = Regex.Matches(strMessage, "%").Count;
            int countPoint;

            for (int i = 1; i < (count + 1); i++)
            {
                try
                {
                    countPoint = Regex.Matches(strMessage, ";").Count - i;

                    if (countPoint > 0)
                    {
                        strReplace = "%" + i.ToString() + " ;"; //%1..%100
                        strReplace2 = "%" + i.ToString() + ";"; //%1..%100
                        strList = ppRowValidation[i - 1].ToString() + "; ";
                    }
                    else
                    {
                        strReplace = "%" + i.ToString() + " "; //%1..%100
                        strReplace2 = "%" + i.ToString(); //%1..%100
                        strList = ppRowValidation[i - 1].ToString();
                    }

                    strMessageRemplace = strMessage.Replace(strReplace.ToString(), strList.ToString() + " ");
                    strMessageRemplace = strMessageRemplace.Replace(strReplace2.ToString(), strList.ToString() + " ");
                    strMessage = strMessageRemplace.ToString();

                    strMessageRemplace = strMessage.Replace("'", "`");
                    strMessage = strMessageRemplace.ToString();
                }
                catch (Exception)
                {
                    return strMessage.ToString();
                }
            }

            return strMessage.ToString();
        }

        public string GetColumn(DataRow ppRowValidation, string pcolumn)
        {
            string strColumnValue = "";
            int count = ppRowValidation.Table.Columns.Count;

            for (int i = 0; i < count; i++)
            {
                try
                {
                    if (ppRowValidation.Table.Columns[i].ColumnName == pcolumn.ToString())
                    {
                        strColumnValue = ppRowValidation.ItemArray[i].ToString();
                    }
                }
                catch (Exception)
                {
                    return strColumnValue.ToString();
                }
            }

            return strColumnValue.ToString();
        }

        #region ScriptResults declaration
