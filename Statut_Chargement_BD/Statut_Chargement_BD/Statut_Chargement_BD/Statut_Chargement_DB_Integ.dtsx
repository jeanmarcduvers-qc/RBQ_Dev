        public const string delLogChargement = "DELETE [SDDMU01].[dbo].[Log_Chargement_Connecteur] where Application = 'StatutChargementBD'";
        public const string delLogJobChargement = "DELETE [SDDMU01].[dbo].[Log_Job_Connecteur] where Application = 'StatutChargementBD'";
        public const string tblAfficheErreur = "SELECT * FROM [SDDMU01].[dbo].[Log_Job_Connecteur] where Application = 'StatutChargementBD'";
        
        public const string tblLogChargementTable = "SELECT [IndSystem] " +
                                                          ",[NomTable] " +
                                                          ",[NomChamp] " +
                                                          ",[DelaisRetention] " +
                                                          ",[DateTraitement] " +
                                                          ",[IndActif] " +
                                                    "FROM  [SDDMU01].[dbo].[Log_chargements_tables] " +
                                                    "WHERE [IndActif] = 'O'";

        public const string tblNonConforme = "select [IndSystem] " +
                                                    ",[NomTable] " +
                                                    ",[NomChamp] " +
                                                    ",[DelaisRetention] " +
                                                    ",DATEDIFF(day, [DateTraitement], getdate()) as Depassement " +
                                                    ",[DateTraitement] " +
                                              "from  [SDDMU01].[dbo].[Log_chargements_tables]" +
                                              "where DATEDIFF(day, [DateTraitement], getdate()) > [DelaisRetention]";

        public string newLine = Environment.NewLine;
        public bool blErreurExecution = false;
        public DateTime dtDateDebut = DateTime.Now;
        public string dtExecution = "";
        public string strAnneeExecution = "";

        public void Main()
        {
            // TODO: Add your code here
            StatutChargementBD();
            Dts.TaskResult = (int)ScriptResults.Success;

        }

        public void StatutChargementBD()
        {

            string EnvoyePar = Dts.Variables["User::EnvoyePar"].Value.ToString();
            string ServerNameSql = @Dts.Variables["User::ServerName"].Value.ToString();
            string strFichierCSV = Dts.Variables["User::FichierCSV"].Value.ToString();
            string strSqlUpdate = "";

            SqlConnection mySQLConnection = Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction) as SqlConnection;
            SqlConnection conn = Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction) as SqlConnection;
            SqlConnection connEnfant = Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction) as SqlConnection;

            object rawConnection = Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction);
            object rawConnectionEnfant = Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction);

            if (blErreurExecution != true)
            {
                // delete l'historique du dernier log de chargement
                DeleteTableLogChargement(); 
                DeleteTableLogJobChargement();

                InsertTableLogChargement("StatutChargementBD", "Début du traitement");

                // Lire la table Log_chargements_tables
                try
                {
                    ValideSqlConnection(conn);
                    using (SqlCommand cmdLogChargementTable = new SqlCommand(tblLogChargementTable, conn))
                    {
                        using (SqlDataReader readerLogChargement = cmdLogChargementTable.ExecuteReader())
                        {
                            // Lire l'occurrences de la table Log_Chargement_Table
                            while (readerLogChargement.Read())
                            {
                                ValideSqlConnection(connEnfant);
                                using (SqlCommand cmd = new SqlCommand("SELECT max("+ readerLogChargement["NomChamp"].ToString() + ") FROM " + readerLogChargement["NomTable"].ToString(), connEnfant))
                                {
                                    var MaxDate = cmd.ExecuteScalar();
                                    strSqlUpdate = "update [SDDMU01].[dbo].[Log_chargements_tables] " +
                                                    "Set   DateTraitement = convert(date, convert(datetime, '" + MaxDate.ToString() + "', 120)) " +
                                                    "where IndActif = 'O' " +
                                                    "and   NomTable = '" + readerLogChargement["NomTable"].ToString() + "'";
                                            
                                    ExecuteSQL(readerLogChargement["NomTable"].ToString(), strSqlUpdate);
                                }
                            }
                            readerLogChargement.Close();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("StatutChargementBD()", ex.Message.ToString());
                }
            }

            if (!blErreurExecution)
            {
                GenereCSV();
            }

            if (blErreurExecution)
            {
                Email_Send_Erreur();
            }

            InsertTableLogChargement("StatutChargementBD", "Fin du traitement");

            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute une instruction SQL
            ///
            /////////////////////////////////////////////////////////////////////
            void ExecuteSQL(string strCodeTraitement, string strSqlRequete)
            {
                ValideSqlConnection(mySQLConnection);
                string sqlInsCmd = strSqlRequete.ToString();

                try
                {
                    SqlCommand SQLCommandExec = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandExec.CommandType = CommandType.Text;
                    SQLCommandExec.CommandTimeout = 12000;
                    SqlDataReader readerExecSQL = SQLCommandExec.ExecuteReader();
                    readerExecSQL.Read();
                    readerExecSQL.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJob("StatutChargementBD()", ex.Message.ToString());
                    blErreurExecution = true;
                }

                mySQLConnection.Close();
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Détruit les informations dant la table Log_Chargement_Connecteur
            ///
            ///////////////////////////////////////////////////////////////////////
            void DeleteTableLogChargement()
            {
                ValideSqlConnection(mySQLConnection);
                string sqlDelCmd = delLogChargement.ToString();

                try
                {
                    SqlCommand SQLCommandDel = new SqlCommand(sqlDelCmd.ToString(), mySQLConnection);
                    SQLCommandDel.CommandType = CommandType.Text;
                    SqlDataReader readerDel = SQLCommandDel.ExecuteReader();
                    readerDel.Read();
                    readerDel.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogChargement("ERR", "DeleteTableLogChargement()");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Détruit les informations dant la table Log_Job_Connecteur
            ///
            ///////////////////////////////////////////////////////////////////////
            void DeleteTableLogJobChargement()
            {
                ValideSqlConnection(mySQLConnection);
                string sqlDelCmdCharg = delLogJobChargement.ToString();

                try
                {
                    SqlCommand DelCmdCharg = new SqlCommand(sqlDelCmdCharg.ToString(), mySQLConnection);
                    DelCmdCharg.CommandType = CommandType.Text;
                    SqlDataReader readerCharg = DelCmdCharg.ExecuteReader();
                    readerCharg.Read();
                    readerCharg.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogChargement("ERR", "DeleteTableLogJobChargement()");
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Chargement_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogChargement(string strIndSystem, string strSqlTable)
            {
                ValideSqlConnection(mySQLConnection);
                string sqlInsCmd = "insert into[SDDMU01].[dbo].[Log_Chargement_Connecteur] values('StatutChargementBD', '" + strIndSystem + "', '" + strSqlTable + "', GETDATE(), 'Auto01', 'T�che Automatis�e')";

                try
                {
                    SqlCommand SQLCommandLog = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandLog.CommandType = CommandType.Text;
                    SqlDataReader readerLog = SQLCommandLog.ExecuteReader();
                    readerLog.Read();
                    readerLog.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("InsertTableLogChargement()", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Job_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogJob(string pFonction, string pErreurMessage)
            {
                ValideSqlConnection(mySQLConnection);
                int lParametreErreurMessage;
                pErreurMessage = pErreurMessage.Replace("'", "''");
                lParametreErreurMessage = pErreurMessage.Length;

                if (pErreurMessage.Length > 250)
                {
                    pErreurMessage = pErreurMessage.Substring(0, 245);
                    pErreurMessage = pErreurMessage + "...";
                }

                string sqlInsCmd = "insert into[SDDMU01].[dbo].[Log_Job_Connecteur] values('StatutChargementBD', 'StatutChargement', null, '" + pFonction + "', 'Erreur', '" + pErreurMessage + "', 'Auto01', GETDATE())";

                try
                {
                    SqlCommand SQLCommandJob = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandJob.CommandType = CommandType.Text;
                    SqlDataReader readerErreur = SQLCommandJob.ExecuteReader();
                    readerErreur.Read();
                    readerErreur.Close();
                    blErreurExecution = true;
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogChargement("ERR", "Impossible d'insérer dans Log_Job_Connecteur");
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Valide d'il faut ouvrir la connection (SQL Server)
            ///
            /////////////////////////////////////////////////////////////////////
            void ValideSqlConnection(SqlConnection SqlServerConnection)
            {
                try
                {
                    if (SqlServerConnection.State.ToString() == "Closed")
                    {
                        // Connecter à la BD
                        SqlServerConnection.Open();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJob("ValideSqlConnection()", ex.Message.ToString());
                    blErreurExecution = true;
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Création du fichier CSV
            ///
            /////////////////////////////////////////////////////////////////////
            void GenereCSV()
            {
                string strpath = strFichierCSV;
                string EnteteColon = "Ind System;Nom Table;Nom Champ;Delais de Rétention;Dépassement;Date Dernier Traitement;";
                string strSQL = tblNonConforme.ToString();
                int recCount = 0;


                if (File.Exists(strpath))
                {
                    // Si le fichier existe le détruire
                    File.Delete(strpath);
                }

                StreamWriter sw = new StreamWriter(strpath, true, Encoding.Unicode);
                sw.WriteLine(EnteteColon.ToString());

                // Lire les non-conformes
                using (SqlDataAdapter dataAdapterAfficheErreur = new SqlDataAdapter(strSQL, mySQLConnection))
                {
                    // create the DataSet 
                    try
                    {
                        DataSet dataSetAfficheErreur = new DataSet();
                        dataAdapterAfficheErreur.SelectCommand.CommandTimeout = 600;
                        dataAdapterAfficheErreur.Fill(dataSetAfficheErreur, "AfficheErreur");
                        recCount = 0;

                        foreach (DataRow pRowAfficheErreur in dataSetAfficheErreur.Tables["AfficheErreur"].Rows)
                        {
                            sw.WriteLine(pRowAfficheErreur["IndSystem"].ToString() + ";" +
                                         pRowAfficheErreur["NomTable"].ToString() + ";" +
                                         pRowAfficheErreur["NomChamp"].ToString() + ";" +
                                         pRowAfficheErreur["DelaisRetention"].ToString() + ";" +
                                         pRowAfficheErreur["Depassement"].ToString() + ";" +
                                         pRowAfficheErreur["DateTraitement"].ToString() + ";" );
                            recCount++;
                        }

                        sw.Close();

                        if (recCount > 0)
                        {
                            SendMailMessage();
                        }
                    }
                    catch (Exception ex)
                    {
                        InsertTableLogJob("GenereCSV()", ex.Message.ToString());
                        blErreurExecution = true;
                    }
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Envois courriel des erreurs
            ///
            /////////////////////////////////////////////////////////////////////
            void Email_Send_Erreur()
            {
                String strAfficheErreur = "";
                String SQLString = tblAfficheErreur.ToString();
                String EnvoisCourrielPar = Dts.Variables["User::EnvoyePar"].Value.ToString();
                String EnvoisCourrielA = "yves.mcduff-ext@rbq.gouv.qc.ca"; // "centre.de.pilotage@rbq.gouv.qc.ca"; // "yves.mcduff-ext@rbq.gouv.qc.ca";
                String EnvoisCourrielSuject = "L'application (StatutChargementBD) a une ou des erreurs d'exécutions. ";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine +
                                             "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";

                ValideSqlConnection(mySQLConnection);

                // Lire les erreurs
                using (SqlDataAdapter dataAdapterAfficheErreur = new SqlDataAdapter(SQLString, mySQLConnection))
                {
                    // create the DataSet 
                    try
                    {
                        DataSet dataSetAfficheErreur = new DataSet();
                        dataAdapterAfficheErreur.SelectCommand.CommandTimeout = 600;
                        dataAdapterAfficheErreur.Fill(dataSetAfficheErreur, "AfficheErreur");

                        foreach (DataRow pRowRegleAfficheErreur in dataSetAfficheErreur.Tables["AfficheErreur"].Rows)
                        {


                            strAfficheErreur = strAfficheErreur.ToString() + newLine +
                                                                             pRowRegleAfficheErreur["JobName"].ToString() + " - " +
                                                                             pRowRegleAfficheErreur["ErrorMessage"].ToString() + newLine;


                        }
                    }
                    catch (Exception ex)
                    {
                        InsertTableLogJob("SendMail()", "Fonction Email_Send_Erreur (dataSetAfficheErreur) Erreur SQL ");
                    }
                }

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + strAfficheErreur.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();

                String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("SendMailErreur()", ex.Message.ToString());
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Envois le courriel s'il y a une ou des erreurs
            ///
            ///////////////////////////////////////////////////////////////////////
            void SendMailMessage()
            {

                String SQLString = tblAfficheErreur.ToString();
                String EnvoisCourrielPar = Dts.Variables["User::EnvoyePar"].Value.ToString();
                String EnvoisCourrielA = "yves.mcduff-ext@rbq.gouv.qc.ca"; // "centre.de.pilotage@rbq.gouv.qc.ca"; // "yves.mcduff-ext@rbq.gouv.qc.ca";
                string file_attachment = strFichierCSV.ToString();
                String EnvoisCourrielSuject = "L'application (StatutChargementBD) a une ou des erreurs de chargements. ";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine +
                                             "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();

                String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                try
                {

                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    // Création de l'attachement
                    System.Net.Mail.Attachment fileAttachment;
                    fileAttachment = new System.Net.Mail.Attachment(file_attachment);
                    FormatCourrielHtml.Attachments.Add(fileAttachment);
                
                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message.ToString();
                    blErreurExecution = true;
                    InsertTableLogJob("SendMailMessage()", ex.Message.ToString());
                }

                InsertTableLogChargement("StatutChargementBD", "Mail confirmation envoyé");
            }
        }
        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion

    }
}]]></ProjectItem>
