                  <ProjectItem
                    Name="ScriptMain.cs"
                    Encoding="UTF8"><![CDATA[// UPDATED: Refonte SQL Set-Based - Suppression boucle C# char-par-char - 2026-03-30
/*
 * ═══════════════════════════════════════════════════════════════════════════
 * RIPQUAR - Phase 1 STG - TW_REPONSE
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Objectif:    Charger les réponses individuelles des candidats par question
 * Source:      CX_INSC_EXAM.X_GI_V_VECT_REPN_CAND_EXAM (vecteur caractères)
 * Destination: SDGIC01.STG.TW_REPONSE
 *
 * REFONTE SET-BASED:
 *   Ancienne logique C#:
 *     - Boucle char-par-char sur le vecteur (for i = 0..n)
 *     - Dictionary<(examId, position), questionUuid> en mémoire
 *     - List<ReponseData> accumulée puis insérée ligne par ligne
 *     - CalculateHash() MD5 en C#
 *
 *   Nouvelle logique SQL:
 *     - Tally CTE pour découper le vecteur en lignes (1 char = 1 ligne)
 *     - JOIN direct sur TW_COPIE, TW_PARTIE_EXAMEN, TW_INDEX_PARTIE
 *     - HASHBYTES('MD5') pour le hash de ligne
 *     - 1 seul INSERT set-based → zéro List, zéro Dictionary, zéro boucle C#
 *
 * Colonnes principales:
 *   - TW_C_REPN_ID   : {ROW_ID}_Q{position+1}
 *   - TW_C_URI_QUES  : /api/questions/{uuid}
 *   - TW_DE_REPN_TEXT: caractère du vecteur (A/B/C/D/X)
 *   - TW_DE_CHOI_JSON: [{"position":N}] ou NULL si réponse invalide (X)
 *   - TW_C_EMPR_LIGN : MD5({rowId}{position}{char})
 * ═══════════════════════════════════════════════════════════════════════════
 */

#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.Data.SqlClient;
using System.IO;
#endregion

namespace ST_ParseJSONReponse
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private string _logFile;
        private string _scriptName;
        private string _lotETL;

        public void Main()
        {
            bool fireAgain = false;
            string _logDir = System.IO.Path.GetDirectoryName(Dts.Variables["User::LogFile"].Value.ToString());
            _logFile = System.IO.Path.Combine(_logDir, $"RIPQUAR_{DateTime.Now:yyyyMMdd_HHmmss}.log");
            _scriptName = Dts.Variables["System::TaskName"].Value.ToString();
            _lotETL = "RIPQUAR_" + DateTime.Now.ToString("yyyyMMdd_HHmmss");

            try
            {
                SafeLog($"\n=== DÉBUT {_scriptName} - {DateTime.Now} ===\n");

                Dts.Events.FireInformation(0, "Parse JSON Réponse", "Démarrage du parsing...", "", 0, ref fireAgain);

                string serverSource = Dts.Variables["User::ServerSource"].Value.ToString();
                string serverDest = Dts.Variables["User::ServerDest"].Value.ToString();
                Dts.Events.FireInformation(0, "Parse JSON Réponse",
                    $"Source: {serverSource} → Destination: {serverDest}", "", 0, ref fireAgain);

                // 1. Nettoyer la table staging
                TruncateStagingTable();

                // 2. Récupérer les données sources (JSON CORR)
                DataTable dtSource = GetSourceData();
                Dts.Events.FireInformation(0, "Parse JSON Réponse",
                    $"Récupéré {dtSource.Rows.Count} ligne(s) source", "", 0, ref fireAgain);

                LogInfo($"Lot ETL: {_lotETL}");

                // 3. Parser et charger
                int nbProcessed = 0;
                int nbErrors = 0;
                int nbCopiesSansReponses = 0;
                int totalReponsesInserees = 0;

                foreach (DataRow row in dtSource.Rows)
                {
                    try
                    {
                        int nbReponses = ParseAndLoadReponses(row);
                        if (nbReponses == 0)
                        {
                            nbCopiesSansReponses++;
                        }
                        else
                        {
                            nbProcessed++;
                            totalReponsesInserees += nbReponses;
                        }
                    }
                    catch (Exception ex)
                    {
                        nbErrors++;
                        string errorDetail = $"\n--- ERREUR PARSING ROW_ID: {row["ROW_ID"]} ---\n";
                        errorDetail += $"Message: {ex.Message}\n";
                        errorDetail += $"Stack: {ex.StackTrace}\n";
                        SafeLog(errorDetail);
                    }
                }

                // 4. Statistiques finales
                LogInfo("");
                LogInfo("═══════════════════════════════════════════════════════════");
                LogInfo("STATISTIQUES FINALES:");
                LogInfo($"  - Tentatives lues:           {dtSource.Rows.Count}");
                LogInfo($"  - Copies traitées (≥1 rép):  {nbProcessed}");
                LogInfo($"  - Copies sans réponses:      {nbCopiesSansReponses}");
                LogInfo($"  - Copies en erreur:          {nbErrors}");
                LogInfo($"  - Total réponses insérées:   {totalReponsesInserees}");
                LogInfo($"  - Lot ETL:                   {_lotETL}");
                LogInfo("═══════════════════════════════════════════════════════════");

                Dts.Events.FireInformation(0, "Parse JSON Réponse",
                    $"Traitement terminé - Copies: {nbProcessed}, Réponses: {totalReponsesInserees}, Erreurs: {nbErrors}",
                    "", 0, ref fireAgain);

                // 5. Contrôle de cohérence : alerte si taux de succès anormalement bas
                decimal tauxSucces = dtSource.Rows.Count > 0
                    ? (decimal)nbProcessed / dtSource.Rows.Count * 100
                    : 0;

                if (tauxSucces < 50 && dtSource.Rows.Count > 0)
                {
                    string alerte = $"ALERTE: Taux de succès anormalement bas ({tauxSucces:F1}%). " +
                                    $"Possible évolution du format JSON TestWe. " +
                                    $"({nbProcessed}/{dtSource.Rows.Count} copies traitées)";
                    LogInfo($"🚨 {alerte}");
                    Dts.Events.FireWarning(0, "Parse JSON Réponse", alerte, "", 0);
                }
                else
                {
                    LogInfo($"✓ Taux de succès: {tauxSucces:F1}%");
                }

                SafeLog($"=== FIN {_scriptName} SUCCESS - {DateTime.Now} ===\n");
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                try
                {
                    string errorLog = "\n" + new string('=', 80) + "\n";
                    errorLog += $"DATE: {DateTime.Now:yyyy-MM-dd HH:mm:ss}\n";
                    errorLog += $"SCRIPT: {_scriptName}\n";
                    errorLog += $"ERREUR: {ex.Message}\n";
                    errorLog += $"\nSTACK TRACE:\n{ex.StackTrace}\n";
                    errorLog += new string('=', 80) + "\n";
                    SafeLog(errorLog);
                }
                catch { }

                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // LOGGING
        // ─────────────────────────────────────────────────────────────────────

        private void SafeLog(string message)
        {
            try
            {
                using (FileStream fs = new FileStream(_logFile, FileMode.Append, FileAccess.Write, FileShare.ReadWrite))
                using (StreamWriter sw = new StreamWriter(fs))
                {
                    sw.Write(message);
                }
            }
            catch { }
        }

        private void LogInfo(string message)
        {
            SafeLog($"[{DateTime.Now:HH:mm:ss}] {message}\n");
        }

        // ─────────────────────────────────────────────────────────────────────
        // CONNECTION STRINGS
        // ─────────────────────────────────────────────────────────────────────

        private string BuildSourceConnectionString()
        {
            string server = Dts.Variables["User::ServerSource"].Value.ToString();
            string database = Dts.Variables["User::BDSource"].Value.ToString();
            return $"Data Source={server};Initial Catalog={database};Integrated Security=True;";
        }

        private string BuildDestinationConnectionString()
        {
            string server = Dts.Variables["User::ServerDest"].Value.ToString();
            string database = Dts.Variables["User::BDDest"].Value.ToString();
            return $"Data Source={server};Initial Catalog={database};Integrated Security=True;";
        }

        // ─────────────────────────────────────────────────────────────────────
        // STAGING : NETTOYAGE
        // ─────────────────────────────────────────────────────────────────────

        private void TruncateStagingTable()
        {
            bool fireAgain = false;
            string connString = BuildDestinationConnectionString();

            Dts.Events.FireInformation(0, "Parse JSON Réponse",
                "Nettoyage table staging TW_REPONSE...", "", 0, ref fireAgain);

            using (SqlConnection conn = new SqlConnection(connString))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand("DELETE FROM [SDGIC01].[STG].[TW_REPONSE]", conn))
                {
                    int rowsDeleted = cmd.ExecuteNonQuery();
                    Dts.Events.FireInformation(0, "Parse JSON Réponse",
                        $"{rowsDeleted} ligne(s) supprimée(s)", "", 0, ref fireAgain);
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // EXTRACTION SOURCE
        // ─────────────────────────────────────────────────────────────────────

        /// <summary>
        /// Récupère les données sources (JSON CORR TestWe) depuis Siebel
        /// </summary>
        private DataTable GetSourceData()
        {
            DataTable dt = new DataTable();
            string connString = BuildSourceConnectionString();

            string query = @"
                SELECT
                    ROW_ID,
                    CONVERT(NVARCHAR(MAX), X_GI_V_VECT_CORR_EXAM) AS JSON_CORR
                FROM [dbo].[CX_INSC_EXAM]
                WHERE X_GI_V_VECT_EXAM      IS NOT NULL
                  AND X_GI_V_VECT_CORR_EXAM IS NOT NULL
            ";

            using (SqlConnection conn = new SqlConnection(connString))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand(query, conn))
                {
                    cmd.CommandTimeout = 3600; // 60 min - table Siebel volumineuse
                    using (SqlDataAdapter adapter = new SqlDataAdapter(cmd))
                    {
                        adapter.Fill(dt);
                    }
                }
            }

            return dt;
        }

        // ─────────────────────────────────────────────────────────────────────
        // PARSING ET CHARGEMENT — OPENJSON (sans Newtonsoft.Json)
        // ─────────────────────────────────────────────────────────────────────

        /// <summary>
        /// Parse le JSON CORR d'une tentative et charge toutes ses réponses
        /// dans STG_TW_REPONSE.
        /// 
        /// Le JSON brut est passé directement en paramètre SQL.
        /// SQL Server effectue tout le parsing via OPENJSON.
        /// Aucune dépendance à Newtonsoft.Json.
        /// 
        /// Structure JSON attendue :
        ///   $.RespBody.studentAnswers[]
        ///     → @id (URI réponse)
        ///     → question (URI question)
        ///     → givenAnswer (texte libre)
        ///     → givenChoices (tableau JSON)
        /// 
        /// Retourne le nombre de réponses insérées pour cette tentative.
        /// </summary>
        private int ParseAndLoadReponses(DataRow sourceRow)
        {
            string rowId = sourceRow["ROW_ID"].ToString();
            string jsonCorrRaw = sourceRow["JSON_CORR"].ToString();

            bool fireAgain = false;
            Dts.Events.FireInformation(0, "Parse JSON Réponse",
                $"ROW_ID {rowId}: JSON CORR taille = {jsonCorrRaw.Length:N0} caractères",
                "", 0, ref fireAgain);

            string connString = BuildDestinationConnectionString();

            // ------------------------------------------------------------------
            // T-SQL : OPENJSON parcourt le tableau studentAnswers[] et 
            //         génère une ligne par réponse, qu'on insère directement.
            //
            // Chemin du tableau :
            //   $.RespBody.studentAnswers
            //
            // Pour givenChoices (qui est lui-même un tableau JSON), on utilise
            // JSON_QUERY pour récupérer le sous-tableau complet en tant que JSON
            // (et non comme valeur scalaire).
            //
            // TW_C_EMPR_LIGN = SHA256 calculé en SQL via HASHBYTES.
            // ------------------------------------------------------------------
            string insertQuery = @"
                INSERT INTO [STG].[TW_REPONSE]
                (
                    TW_C_REPN_ID,
                    TW_N_COPI_ID,
                    TW_C_URI_QUES,
                    TW_DE_REPN_TEXT,
                    TW_DE_CHOI_JSON,
                    TW_DH_CHARG_ETL,
                    TW_C_SYST_SRCE,
                    TW_C_LOT_ETL,
                    TW_C_EMPR_LIGN
                )
                SELECT
                    -- URI complète de la réponse (PK)
                    a.RepnId,
 
                    -- ROW_ID Siebel = identifiant de la copie (FK vers TW_COPIE)
                    @RowId,
 
                    -- URI de la question
                    a.QuestionUri,
 
                    -- Texte de réponse libre (NULL si vide)
                    NULLIF(a.GivenAnswer, N''),
 
                    -- Tableau JSON des choix (NULL si pas de choix)
                    a.GivenChoices,
 
                    -- Horodatage ETL
                    GETDATE(),
 
                    -- Système source
                    N'TestWe',
 
                    -- Lot ETL
                    @LotETL,
 
                    -- Empreinte SHA256 pour audit (RepnId + RowId + QuestionUri)
                    LOWER(CONVERT(NVARCHAR(64),
                        HASHBYTES('SHA2_256',
                            ISNULL(a.RepnId, N'') +
                            @RowId +
                            ISNULL(a.QuestionUri, N'')
                        ), 2))
 
                FROM OPENJSON(@Json, N'$.RespBody.studentAnswers')
                WITH (
                    RepnId       NVARCHAR(255) N'$.""@id""',
                    QuestionUri  NVARCHAR(255) N'$.question',
                    GivenAnswer  NVARCHAR(MAX) N'$.givenAnswer',
                    GivenChoices NVARCHAR(MAX) N'$.givenChoices' AS JSON
                ) a
                WHERE a.RepnId IS NOT NULL;
            ";

            int rowsInserted = 0;

            using (SqlConnection conn = new SqlConnection(connString))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand(insertQuery, conn))
                {
                    cmd.CommandTimeout = 300;
                    cmd.Parameters.Add("@Json", SqlDbType.NVarChar, -1).Value = jsonCorrRaw;
                    cmd.Parameters.Add("@RowId", SqlDbType.VarChar, 36).Value = rowId;
                    cmd.Parameters.Add("@LotETL", SqlDbType.VarChar, 50).Value = _lotETL;

                    rowsInserted = cmd.ExecuteNonQuery();
                }
            }

            return rowsInserted;
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
