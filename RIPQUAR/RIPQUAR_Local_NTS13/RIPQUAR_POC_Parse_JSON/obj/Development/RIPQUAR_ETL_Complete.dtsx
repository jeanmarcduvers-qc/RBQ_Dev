              <ProjectItem
                Name="ScriptMain.cs"
                Encoding="UTF8"><![CDATA[// UPDATED: Refonte OPENJSON - Suppression dépendance Newtonsoft.Json - 2026-03-30
/*
 * RIPQUAR - Phase 3 FACT - FACT_REPONSE_QUESTION
 *
 * REFONTE: Suppression Newtonsoft.Json (usage mineur)
 *          L'original utilisait JArray.Parse(choiJson) pour extraire la position
 *          du choix depuis la colonne TW_DE_CHOI_JSON = "[{"position":0}]"
 *
 *          SOLUTION: JSON_VALUE et CASE injectés directement dans le SELECT SQL
 *          → position et libellé calculés en base, plus de parsing C#
 *
 * Aucune autre modification fonctionnelle.
 *
 * Variables SSIS requises:
 * - ServerDest, BDDest
 */

#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.Data.SqlClient;
using System.Collections.Generic;
using System.IO;
#endregion

namespace ST_FACT_REPONSE_QUESTION
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private string _logFile;
        private string _scriptName;

        public void Main()
        {
            string _logDir = System.IO.Path.GetDirectoryName(Dts.Variables["User::LogFile"].Value.ToString());
            _logFile = System.IO.Path.Combine(_logDir, $"RIPQUAR_{DateTime.Now:yyyyMMdd_HHmmss}.log");
            _scriptName = Dts.Variables["System::TaskName"].Value.ToString();

            try
            {
                SafeLog($"\n=== DÉBUT {_scriptName} - {DateTime.Now} ===\n");
                Log("Script démarre");

                string serverDest = Dts.Variables["User::ServerDest"].Value.ToString();
                string bdDest = Dts.Variables["User::BDDest"].Value.ToString();
                Log($"Destination: {serverDest} / {bdDest}");

                string connStrDest = $"Data Source={serverDest};Initial Catalog={bdDest};Integrated Security=True;MultipleActiveResultSets=True;";

                // ─────────────────────────────────────────────────────────────
                // 1. CHARGEMENT LOOKUPS EN MÉMOIRE
                // ─────────────────────────────────────────────────────────────
                Log("Chargement lookups...");

                Dictionary<string, ResultatInfo> lkpResultat = new Dictionary<string, ResultatInfo>();
                Dictionary<string, int> lkpQuestions = new Dictionary<string, int>();
                Dictionary<int, int> lkpDates = new Dictionary<int, int>();

                using (SqlConnection conn = new SqlConnection(connStrDest))
                {
                    conn.Open();

                    Log("  - FACT_RESULTAT_EXAMEN...");
                    string sqlResultat = $@"
                        SELECT TW_N_COPI_ID, DW_N_RESU_ID, DW_N_CAND_ID,
                               DW_N_EXAM_ID, DW_N_DATE_CORR_ID
                        FROM [{bdDest}].[DWH].[FACT_RESULTAT_EXAMEN];";

                    using (SqlCommand cmd = new SqlCommand(sqlResultat, conn))
                    using (SqlDataReader rdr = cmd.ExecuteReader())
                    {
                        while (rdr.Read())
                        {
                            lkpResultat[rdr["TW_N_COPI_ID"].ToString()] = new ResultatInfo
                            {
                                ResuSK = rdr.GetInt32(rdr.GetOrdinal("DW_N_RESU_ID")),
                                CandSK = rdr.GetInt32(rdr.GetOrdinal("DW_N_CAND_ID")),
                                ExamSK = rdr.GetInt32(rdr.GetOrdinal("DW_N_EXAM_ID")),
                                DateCorrSK = rdr.IsDBNull(rdr.GetOrdinal("DW_N_DATE_CORR_ID"))
                                    ? (int?)null
                                    : rdr.GetInt32(rdr.GetOrdinal("DW_N_DATE_CORR_ID"))
                            };
                        }
                    }
                    Log($"    {lkpResultat.Count} résultats chargés");

                    Log("  - DIM_QUESTION...");
                    string sqlQuestions = $@"
                        SELECT TW_N_QUES_ID, DW_N_QUES_ID
                        FROM [{bdDest}].[DWH].[DIM_QUESTION]
                        WHERE DW_I_COUR = 1
                          AND TW_N_QUES_ID IS NOT NULL;";

                    using (SqlCommand cmd = new SqlCommand(sqlQuestions, conn))
                    using (SqlDataReader rdr = cmd.ExecuteReader())
                    {
                        while (rdr.Read())
                            lkpQuestions[rdr["TW_N_QUES_ID"].ToString()] =
                                rdr.GetInt32(rdr.GetOrdinal("DW_N_QUES_ID"));
                    }
                    Log($"    {lkpQuestions.Count} questions chargées");

                    Log("  - DIM_DATE...");
                    string sqlDates = $"SELECT DW_N_DATE_ID FROM [{bdDest}].[DWH].[DIM_DATE];";
                    using (SqlCommand cmd = new SqlCommand(sqlDates, conn))
                    using (SqlDataReader rdr = cmd.ExecuteReader())
                    {
                        while (rdr.Read()) { int id = rdr.GetInt32(0); lkpDates[id] = id; }
                    }
                    Log($"    {lkpDates.Count} dates chargées");
                }

                if (lkpResultat.Count == 0)
                {
                    Log("ERREUR: FACT_RESULTAT_EXAMEN est vide!");
                    Dts.TaskResult = (int)ScriptResults.Failure;
                    return;
                }

                // ─────────────────────────────────────────────────────────────
                // 2. VIDER TABLE DESTINATION
                // ─────────────────────────────────────────────────────────────
                Log("DELETE table destination...");
                using (SqlConnection conn = new SqlConnection(connStrDest))
                {
                    conn.Open();
                    using (SqlCommand cmd = new SqlCommand($"DELETE FROM [{bdDest}].[DWH].[FACT_REPONSE_QUESTION];", conn))
                        Log($"DELETE OK: {cmd.ExecuteNonQuery()} lignes");
                }

                // ─────────────────────────────────────────────────────────────
                // 3. LECTURE TW_REPONSE + TW_CORRECTION ET INSERTION
                //
                // REFONTE : la position et le libellé du choix sont maintenant
                // calculés directement dans le SELECT via JSON_VALUE et CASE.
                // Plus de JArray.Parse en C#.
                //
                // TW_DE_CHOI_JSON = "[{"position":X}]"
                //   JSON_VALUE(r.TW_DE_CHOI_JSON, '$[0].position') → position (INT)
                //   CASE position WHEN 0 THEN 'A' WHEN 1 THEN 'B' ... → libellé
                //   (SELECT COUNT(*) FROM OPENJSON(r.TW_DE_CHOI_JSON)) > 1 → plusieurs choix
                // ─────────────────────────────────────────────────────────────
                Log("Traitement TW_REPONSE + TW_CORRECTION...");

                int totalInseres = 0;
                int totalSkipped = 0;
                int totalCopyNonTrouvee = 0;
                int totalQuesNonTrouvee = 0;
                int totalUriInvalide = 0;

                string insertSql = $@"
                    INSERT INTO [{bdDest}].[DWH].[FACT_REPONSE_QUESTION]
                    (DW_N_CAND_ID, DW_N_RESU_ID, DW_N_EXAM_ID, DW_N_QUES_ID,
                     DW_N_DATE_REPN_ID, TW_C_URI_REPN, DW_M_PTS_OBTE, DW_I_CORR,
                     DW_N_POSI_CHOI_DONN, DW_C_LIBE_CHOI_DONN, DW_I_REPN,
                     DW_I_AUCU_REPN, DW_I_REPN_PLUS_CHOI, DW_DH_CHARG_ETL,
                     DW_C_SYST_SRCE, DW_C_LOT_ETL)
                    VALUES
                    (@CandId, @ResuId, @ExamId, @QuesId, @DateId, @UriRepn,
                     @PtsObte, @Corr, @PosiChoi, @LibeChoi, @Repn, @AucuRepn,
                     @PlusChoi, GETDATE(), 'TestWe', @Lot);";

                // SELECT enrichi : position/libellé/plusieursChoix calculés en SQL
                string sqlReponses = $@"
                    SELECT
                        r.TW_C_REPN_ID,
                        r.TW_N_COPI_ID,
                        r.TW_C_URI_QUES,
                        r.TW_DE_REPN_TEXT,
                        r.TW_DE_CHOI_JSON,
                        c.TW_M_NOTE,

                        -- Position du choix : JSON_VALUE sur TW_DE_CHOI_JSON = '[{{""position"":X}}]'
                        TRY_CAST(
                            JSON_VALUE(r.TW_DE_CHOI_JSON, '$[0].position') AS INT
                        ) AS ChoiPosition,

                        -- Libellé : conversion position → lettre
                        CASE TRY_CAST(JSON_VALUE(r.TW_DE_CHOI_JSON, '$[0].position') AS INT)
                            WHEN 0 THEN 'A'
                            WHEN 1 THEN 'B'
                            WHEN 2 THEN 'C'
                            WHEN 3 THEN 'D'
                            ELSE NULL
                        END AS ChoiLibelle,

                        -- Plusieurs choix : plus d'un élément dans le tableau JSON
                        CASE
                            WHEN r.TW_DE_CHOI_JSON IS NOT NULL
                             AND (SELECT COUNT(*) FROM OPENJSON(r.TW_DE_CHOI_JSON)) > 1
                            THEN 1 ELSE 0
                        END AS PlusieursChoix

                    FROM [{bdDest}].[STG].[TW_REPONSE] r
                    LEFT JOIN [{bdDest}].[STG].[TW_CORRECTION] c
                        ON r.TW_C_REPN_ID = c.TW_C_REPN_ID;";

                using (SqlConnection conn = new SqlConnection(connStrDest))
                {
                    conn.Open();

                    using (SqlCommand cmdRead = new SqlCommand(sqlReponses, conn))
                    {
                        cmdRead.CommandTimeout = 600;

                        using (SqlDataReader rdr = cmdRead.ExecuteReader())
                        {
                            while (rdr.Read())
                            {
                                string repnId = rdr["TW_C_REPN_ID"].ToString();
                                string copyId = rdr["TW_N_COPI_ID"].ToString();
                                string uriQues = rdr.IsDBNull(rdr.GetOrdinal("TW_C_URI_QUES")) ? null : rdr["TW_C_URI_QUES"].ToString();
                                string repnText = rdr.IsDBNull(rdr.GetOrdinal("TW_DE_REPN_TEXT")) ? null : rdr["TW_DE_REPN_TEXT"].ToString();
                                decimal? ptsObte = rdr.IsDBNull(rdr.GetOrdinal("TW_M_NOTE")) ? (decimal?)null : rdr.GetDecimal(rdr.GetOrdinal("TW_M_NOTE"));

                                // Valeurs déjà calculées par SQL (remplacent JArray.Parse)
                                int? position = rdr.IsDBNull(rdr.GetOrdinal("ChoiPosition")) ? (int?)null : rdr.GetInt32(rdr.GetOrdinal("ChoiPosition"));
                                string libelle = rdr.IsDBNull(rdr.GetOrdinal("ChoiLibelle")) ? null : rdr["ChoiLibelle"].ToString();
                                bool plusieursChoix = rdr.GetInt32(rdr.GetOrdinal("PlusieursChoix")) == 1;

                                // Vérifier copie
                                if (!lkpResultat.ContainsKey(copyId))
                                {
                                    totalCopyNonTrouvee++;
                                    totalSkipped++;
                                    continue;
                                }

                                ResultatInfo resInfo = lkpResultat[copyId];

                                // Valider URI
                                if (string.IsNullOrEmpty(uriQues) || uriQues.Length < 36)
                                {
                                    totalUriInvalide++;
                                    totalSkipped++;
                                    continue;
                                }

                                // Extraire UUID depuis URI (36 derniers chars)
                                string questionUuid = uriQues.Substring(uriQues.Length - 36);

                                if (!lkpQuestions.ContainsKey(questionUuid))
                                {
                                    totalQuesNonTrouvee++;
                                    totalSkipped++;
                                    continue;
                                }

                                int quesSK = lkpQuestions[questionUuid];
                                bool estCorr = ptsObte.HasValue && ptsObte.Value > 0;
                                // DW_I_REPN : toujours 1 si la ligne existe
                                bool aRepondu = !string.IsNullOrEmpty(repnText);

                                // DW_I_AUCU_REPN : aucune réponse si TW_DE_CHOI_JSON ET TW_DE_REPN_TEXT sont NULL
                                string choiJson = rdr.IsDBNull(rdr.GetOrdinal("TW_DE_CHOI_JSON")) ? null : rdr["TW_DE_CHOI_JSON"].ToString();
                                bool aucuneRepn = string.IsNullOrEmpty(choiJson) && string.IsNullOrEmpty(repnText);

                                using (SqlCommand cmdIns = new SqlCommand(insertSql, conn))
                                {
                                    cmdIns.Parameters.AddWithValue("@CandId", resInfo.CandSK);
                                    cmdIns.Parameters.AddWithValue("@ResuId", resInfo.ResuSK);
                                    cmdIns.Parameters.AddWithValue("@ExamId", resInfo.ExamSK);
                                    cmdIns.Parameters.AddWithValue("@QuesId", quesSK);
                                    cmdIns.Parameters.AddWithValue("@DateId", resInfo.DateCorrSK ?? (object)DBNull.Value);
                                    cmdIns.Parameters.AddWithValue("@UriRepn", repnId);
                                    cmdIns.Parameters.AddWithValue("@PtsObte", ptsObte ?? (object)DBNull.Value);
                                    cmdIns.Parameters.AddWithValue("@Corr", estCorr ? 1 : 0);
                                    cmdIns.Parameters.AddWithValue("@PosiChoi", position ?? (object)DBNull.Value);
                                    cmdIns.Parameters.AddWithValue("@LibeChoi", libelle ?? (object)DBNull.Value);
                                    cmdIns.Parameters.AddWithValue("@Repn", aRepondu ? 1 : 0);
                                    cmdIns.Parameters.AddWithValue("@AucuRepn", aucuneRepn ? 1 : 0);
                                    cmdIns.Parameters.AddWithValue("@PlusChoi", plusieursChoix ? 1 : 0);
                                    cmdIns.Parameters.AddWithValue("@Lot", copyId);

                                    cmdIns.ExecuteNonQuery();
                                    totalInseres++;
                                }

                                if (totalInseres % 100 == 0)
                                    Log($"  Inséré: {totalInseres} réponses...");
                            }
                        }
                    }
                }

                // ─────────────────────────────────────────────────────────────
                // 4. STATISTIQUES FINALES
                // ─────────────────────────────────────────────────────────────
                Log("");
                Log("═══════════════════════════════════════════════════════════");
                Log("STATISTIQUES FINALES:");
                Log($"  - Réponses insérées:              {totalInseres}");
                Log($"  - Réponses skippées:              {totalSkipped}");
                if (totalCopyNonTrouvee > 0) Log($"    • Copie non trouvée:          {totalCopyNonTrouvee}");
                if (totalQuesNonTrouvee > 0) Log($"    • Question UUID non trouvée:  {totalQuesNonTrouvee}");
                if (totalUriInvalide > 0) Log($"    • URI invalide:               {totalUriInvalide}");
                Log($"  - Lookup: RIGHT(TW_C_URI_QUES, 36) → DIM_QUESTION");
                Log("═══════════════════════════════════════════════════════════");
                Log("=== SUCCÈS ===");

                SafeLog($"=== FIN {_scriptName} SUCCESS - {DateTime.Now} ===\n");
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                try
                {
                    string errorLog = "\n" + new string('=', 80) + "\n";
                    errorLog += $"DATE: {DateTime.Now:yyyy-MM-dd HH:mm:ss}\n";
                    errorLog += $"SCRIPT: {_scriptName}\n";
                    errorLog += $"ERREUR: {ex.Message}\n";
                    errorLog += $"\nSTACK TRACE:\n{ex.StackTrace}\n";
                    errorLog += new string('=', 80) + "\n";
                    SafeLog(errorLog);
                }
                catch { }

                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        #region Helper Methods

        private void Log(string message) { SafeLog($"[{DateTime.Now:HH:mm:ss}] {message}\n"); }

        private void SafeLog(string message)
        {
            try
            {
                using (FileStream fs = new FileStream(_logFile, FileMode.Append, FileAccess.Write, FileShare.ReadWrite))
                using (StreamWriter sw = new StreamWriter(fs))
                    sw.Write(message);
            }
            catch { }
        }

        #endregion

        public class ResultatInfo
        {
            public int ResuSK { get; set; }
            public int CandSK { get; set; }
            public int ExamSK { get; set; }
            public int? DateCorrSK { get; set; }
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
