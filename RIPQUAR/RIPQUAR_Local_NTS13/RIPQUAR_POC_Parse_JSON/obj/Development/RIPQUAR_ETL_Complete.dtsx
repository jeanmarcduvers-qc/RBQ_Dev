                  <ProjectItem
                    Name="ScriptMain.cs"
                    Encoding="UTF8"><![CDATA[// UPDATED: Refonte OPENJSON - Suppression dépendance Newtonsoft.Json - 2026-03-30
/*
 * RIPQUAR - Script Task : Parse JSON CORR TestWe → STG_TW_CORRECTION
 *
 * Charge les corrections (notes par réponse) émises par les correcteurs.
 * Parsing JSON effectué en T-SQL natif (OPENJSON), aucune dépendance externe.
 *
 * Source     : CX_INSC_EXAM.X_GI_V_VECT_CORR_EXAM (Siebel)
 * Destination: SDGIC01.STG.TW_CORRECTION
 *
 * Structure JSON attendue :
 *   $.RespBody.studentAnswers[].corrections[]
 *     → id          : UUID correction       → TW_N_CORR_ID
 *     → note        : note attribuée        → TW_M_NOTE
 *     → bonusPoints : points bonus          → TW_M_PTS_BONU
 *     → isFlagged   : flag de signalement   → TW_I_SIGN
 *     → updatedAt   : date modification     → TW_DH_MODI
 *
 * La FK TW_C_REPN_ID pointe vers studentAnswers[].@id (URI complète),
 * cohérent avec TW_REPONSE.TW_C_REPN_ID.
 *
 * Variables SSIS requises:
 * - ServerSource, BDSource, ServerDest, BDDest, LogFile
 */

#region Namespaces
using System;
using System.Data;
using System.Collections.Generic;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.Data.SqlClient;
using System.IO;
#endregion

namespace ST_TW_CORRECTION
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private string _logFile;
        private string _scriptName;
        private string _lotETL;

        public void Main()
        {
            string _logDir = System.IO.Path.GetDirectoryName(Dts.Variables["User::LogFile"].Value.ToString());
            _logFile = System.IO.Path.Combine(_logDir, $"RIPQUAR_{DateTime.Now:yyyyMMdd_HHmmss}.log");
            _scriptName = Dts.Variables["System::TaskName"].Value.ToString();
            _lotETL = "RIPQUAR_" + DateTime.Now.ToString("yyyyMMdd_HHmmss");

            try
            {
                SafeLog($"\n=== DÉBUT {_scriptName} - {DateTime.Now} ===\n");

                Log("Script démarre - Parsing corrections TestWe");

                string serverSource = Dts.Variables["User::ServerSource"].Value.ToString();
                string bdSource = Dts.Variables["User::BDSource"].Value.ToString();
                string serverDest = Dts.Variables["User::ServerDest"].Value.ToString();
                string bdDest = Dts.Variables["User::BDDest"].Value.ToString();

                Log($"Source: {serverSource} / {bdSource}");
                Log($"Dest:   {serverDest}   / {bdDest}");
                Log($"Lot ETL: {_lotETL}");

                string connStrSource = $"Data Source={serverSource};Initial Catalog={bdSource};Integrated Security=True;";
                string connStrDest = $"Data Source={serverDest};Initial Catalog={bdDest};Integrated Security=True;";

                // 1. Vider la table destination
                using (SqlConnection conn = new SqlConnection(connStrDest))
                {
                    conn.Open();
                    using (SqlCommand cmd = new SqlCommand($"DELETE FROM [{bdDest}].[STG].[TW_CORRECTION];", conn))
                    {
                        int deleted = cmd.ExecuteNonQuery();
                        Log($"DELETE OK: {deleted} lignes supprimées");
                    }
                }

                // 2. Charger les URIs de réponses valides depuis TW_REPONSE (filtre FK)
                HashSet<string> reponsesExistantes = new HashSet<string>(System.StringComparer.OrdinalIgnoreCase);
                using (SqlConnection conn = new SqlConnection(connStrDest))
                {
                    conn.Open();
                    using (SqlCommand cmd = new SqlCommand($"SELECT TW_C_REPN_ID FROM [{bdDest}].[STG].[TW_REPONSE];", conn))
                    using (SqlDataReader rdr = cmd.ExecuteReader())
                    {
                        while (rdr.Read())
                        {
                            string id = rdr["TW_C_REPN_ID"]?.ToString();
                            if (!string.IsNullOrWhiteSpace(id))
                                reponsesExistantes.Add(id);
                        }
                    }
                }

                Log($"✓ {reponsesExistantes.Count} réponses chargées depuis TW_REPONSE");

                if (reponsesExistantes.Count == 0)
                {
                    Log("ATTENTION: Aucune réponse dans TW_REPONSE - rien à corréler!");
                    Dts.TaskResult = (int)ScriptResults.Failure;
                    return;
                }

                // 3. Lire données source
                string querySource = @"
                    SELECT 
                        ROW_ID,
                        CONVERT(NVARCHAR(MAX), X_GI_V_VECT_CORR_EXAM) AS JSONCorrections
                    FROM [dbo].[CX_INSC_EXAM]
                    WHERE X_GI_V_VECT_CORR_EXAM IS NOT NULL
                      AND LEN(X_GI_V_VECT_CORR_EXAM) > 0;
                ";

                int totalExamens = 0;
                int totalInserted = 0;
                int totalErrors = 0;

                using (SqlConnection connSource = new SqlConnection(connStrSource))
                {
                    connSource.Open();

                    using (SqlCommand cmdSrc = new SqlCommand(querySource, connSource))
                    {
                        cmdSrc.CommandTimeout = 300;

                        using (SqlDataReader rdrSrc = cmdSrc.ExecuteReader())
                        {
                            while (rdrSrc.Read())
                            {
                                string rowId = rdrSrc["ROW_ID"]?.ToString();
                                string jsonCorrections = rdrSrc["JSONCorrections"]?.ToString();

                                if (string.IsNullOrWhiteSpace(jsonCorrections)) continue;

                                totalExamens++;

                                try
                                {
                                    int nb = InsertCorrections(rowId, jsonCorrections, bdDest, connStrDest);
                                    totalInserted += nb;
                                }
                                catch (Exception ex)
                                {
                                    totalErrors++;
                                    Log($"Erreur JSON {rowId}: {ex.Message}");
                                }

                                if (totalExamens % 50 == 0)
                                    Log($"Traité: {totalExamens} examens, {totalInserted} corrections");
                            }
                        }
                    }
                }

                // 4. Statistiques finales
                Log("");
                Log("═══════════════════════════════════════════════════════════");
                Log("STATISTIQUES FINALES:");
                Log($"  - Réponses disponibles:        {reponsesExistantes.Count}");
                Log($"  - Examens traités:             {totalExamens}");
                Log($"  - Corrections insérées:        {totalInserted}");
                Log($"  - Erreurs parsing:             {totalErrors}");
                Log("═══════════════════════════════════════════════════════════");

                // 5. Contrôle de cohérence
                if (totalInserted < reponsesExistantes.Count * 0.5)
                {
                    string alerte = $"ALERTE: Seulement {totalInserted} corrections pour {reponsesExistantes.Count} réponses. " +
                                    "Possible évolution du format JSON TestWe.";
                    Log($"🚨 {alerte}");
                    Dts.Events.FireWarning(0, _scriptName, alerte, "", 0);
                }

                SafeLog($"=== FIN {_scriptName} SUCCESS - {DateTime.Now} ===\n");
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                try
                {
                    string errorLog = "\n" + new string('=', 80) + "\n";
                    errorLog += $"DATE: {DateTime.Now:yyyy-MM-dd HH:mm:ss}\n";
                    errorLog += $"SCRIPT: {_scriptName}\n";
                    errorLog += $"ERREUR: {ex.Message}\n";
                    errorLog += $"\nSTACK TRACE:\n{ex.StackTrace}\n";
                    errorLog += new string('=', 80) + "\n";
                    SafeLog(errorLog);
                }
                catch { }

                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        /// <summary>
        /// Insère les corrections pour un examen via OPENJSON.
        ///
        /// Structure JSON:
        ///   $.RespBody.studentAnswers[]   (chaque réponse)
        ///     → @id          : URI de la réponse (= TW_C_REPN_ID dans TW_REPONSE)
        ///     → corrections[] (1 ou plusieurs corrections par réponse)
        ///         → id          : UUID correction
        ///         → note        : décimal
        ///         → bonusPoints : décimal
        ///         → isFlagged   : 'true'/'false'
        ///         → updatedAt   : ISO 8601
        ///
        /// La jointure se fait via sa.@id (URI réponse).
        /// Filtre WHERE EXISTS sur TW_REPONSE pour respecter la FK.
        /// </summary>
        private int InsertCorrections(string rowId, string jsonCorrections, string bdDest, string connStrDest)
        {
            string insertQuery = $@"
                INSERT INTO [{bdDest}].[STG].[TW_CORRECTION]
                (
                    TW_N_CORR_ID,
                    TW_C_REPN_ID,
                    TW_M_NOTE,
                    TW_M_PTS_BONU,
                    TW_I_SIGN,
                    TW_DE_APPR,
                    TW_DH_MODI,
                    TW_DH_CHARG_ETL,
                    TW_C_SYST_SRCE,
                    TW_C_LOT_ETL,
                    TW_C_EMPR_LIGN
                )
                SELECT
                    -- UUID de la correction (PK)
                    JSON_VALUE(corr.value, '$.id'),

                    -- TW_C_REPN_ID = URI de la réponse (FK vers TW_REPONSE)
                    sa.RepnId,

                    -- Note attribuée
                    TRY_CAST(JSON_VALUE(corr.value, '$.note')        AS DECIMAL(10,2)),

                    -- Points bonus
                    TRY_CAST(JSON_VALUE(corr.value, '$.bonusPoints') AS DECIMAL(10,2)),

                    -- isFlagged → BIT (signalée par correcteur)
                    CASE WHEN JSON_VALUE(corr.value, '$.isFlagged') = 'true' THEN 1 ELSE 0 END,

                    -- TW_DE_APPR : appréciation non présente dans le JSON actuel
                    NULL,

                    -- ISO 8601 avec timezone → DATETIMEOFFSET → DATETIME
                    CONVERT(DATETIME, TRY_CONVERT(DATETIMEOFFSET, JSON_VALUE(corr.value, '$.updatedAt'))),

                    -- Audit ETL
                    GETDATE(),
                    N'TestWe',
                    @LotETL,

                    -- Empreinte SHA256 (id correction + URI réponse)
                    LOWER(CONVERT(NVARCHAR(64),
                        HASHBYTES('SHA2_256',
                            ISNULL(JSON_VALUE(corr.value, '$.id'), N'') + 
                            ISNULL(sa.RepnId, N'')
                        ), 2))

                -- Parcours des réponses (avec extraction de @id en colonne typée)
                FROM OPENJSON(@Json, '$.RespBody.studentAnswers')
                WITH (
                    RepnId       NVARCHAR(255) N'$.""@id""',
                    Corrections  NVARCHAR(MAX) N'$.corrections' AS JSON
                ) AS sa

                -- Pour chaque réponse, parcours du tableau corrections[]
                CROSS APPLY OPENJSON(sa.Corrections) AS corr

                -- Filtre FK : ne pas insérer si la réponse parente n'existe pas
                WHERE EXISTS (
                    SELECT 1
                    FROM [{bdDest}].[STG].[TW_REPONSE] r
                    WHERE r.TW_C_REPN_ID = sa.RepnId
                )
                AND JSON_VALUE(corr.value, '$.id') IS NOT NULL;
            ";

            using (SqlConnection conn = new SqlConnection(connStrDest))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand(insertQuery, conn))
                {
                    cmd.CommandTimeout = 120;
                    cmd.Parameters.Add("@Json", SqlDbType.NVarChar, -1).Value = jsonCorrections;
                    cmd.Parameters.Add("@LotETL", SqlDbType.NVarChar, 50).Value = _lotETL;

                    int rowsInserted = cmd.ExecuteNonQuery();
                    return rowsInserted;
                }
            }
        }

        #region Helper Methods

        private void SafeLog(string message)
        {
            try
            {
                using (FileStream fs = new FileStream(_logFile, FileMode.Append, FileAccess.Write, FileShare.ReadWrite))
                using (StreamWriter sw = new StreamWriter(fs))
                {
                    sw.Write(message);
                }
            }
            catch { }
        }

        private void Log(string message)
        {
            SafeLog($"[{DateTime.Now:HH:mm:ss}] {message}\n");
        }

        #endregion

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
