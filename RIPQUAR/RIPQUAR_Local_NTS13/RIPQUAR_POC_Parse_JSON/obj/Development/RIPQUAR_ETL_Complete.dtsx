              <ProjectItem
                Name="ScriptMain.cs"
                Encoding="UTF8"><![CDATA[// UPDATED: Refonte complète selon mapping spec - 2026-03-31
/*
 * ═══════════════════════════════════════════════════════════════════════════
 * RIPQUAR - Phase 3 FACT - FACT_RESULTAT_EXAMEN
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Grain:    Une ligne par copie d'examen (passation)
 * Sources:  STG.TW_COPIE + STG.TW_CORRECTION + DBO.CX_INSC_EXAM (GIC)
 *
 * Colonnes ajoutées vs version précédente :
 *   GI_N_ROW_ID_INSC  : ROW_ID depuis CX_INSC_EXAM (clé métier GIC)
 *   DW_M_SEUI_REUS    : Seuil de passage depuis DIM_EXAMEN
 *   DW_I_REUS         : IIF(DW_M_NOTE_PCNT >= DW_M_SEUI_REUS AND DW_I_ABSE=0, 1, 0)
 *   DW_I_ABSE         : IIF(TW_C_STAT IN ('absent','not_started') OR TW_DH_SOUM NULL, 1, 0)
 *   DW_Q_NB_QUES_TOTA : Nombre de questions depuis DIM_EXAMEN
 *   DW_I_REPR         : IIF(CX_INSC_EXAM.X_GI_I_REPR_EXAM = 'Y', 1, 0)
 *
 * Gestion cas particuliers :
 *   - Absent          : charger quand meme, DW_M_NOTE_PCNT=0, DW_I_REUS=0
 *   - TW_DH_CORR NULL : FK_DATE_CORR_ID pointe vers 19000101 (date inconnue)
 *   - Reprise         : nouvelle ligne independante
 *   - Doublon COPI_ID : rejeter avec log
 * ═══════════════════════════════════════════════════════════════════════════
 */

#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.Data.SqlClient;
using System.Collections.Generic;
using System.IO;
#endregion

namespace ST_FACT_RESULTAT_EXAMEN
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private string _logFile;
        private string _scriptName;

        public void Main()
        {
            _scriptName = Dts.Variables["System::TaskName"].Value.ToString();
            string _logDir = System.IO.Path.GetDirectoryName(Dts.Variables["User::LogFile"].Value.ToString());
            _logFile = System.IO.Path.Combine(_logDir, $"RIPQUAR_{DateTime.Now:yyyyMMdd_HHmmss}.log");

            try
            {
                SafeLog($"\n=== DEBUT {_scriptName} - {DateTime.Now} ===\n");
                Log("Script demarre");

                // ─────────────────────────────────────────────────────────────
                // 1. VARIABLES SSIS
                // ─────────────────────────────────────────────────────────────
                string serverSource = Dts.Variables["User::ServerSource"].Value.ToString();
                string bdSource = Dts.Variables["User::BDSource"].Value.ToString();
                string serverDest = Dts.Variables["User::ServerDest"].Value.ToString();
                string bdDest = Dts.Variables["User::BDDest"].Value.ToString();

                Log($"Source: {serverSource} / {bdSource}");
                Log($"Dest:   {serverDest} / {bdDest}");

                string connStrSource = $"Data Source={serverSource};Initial Catalog={bdSource};Integrated Security=True;";
                string connStrDest = $"Data Source={serverDest};Initial Catalog={bdDest};Integrated Security=True;MultipleActiveResultSets=True;";

                // ─────────────────────────────────────────────────────────────
                // 2. CHARGEMENT LOOKUPS EN MEMOIRE
                // ─────────────────────────────────────────────────────────────
                Log("Chargement lookups...");

                // LKP 1 : DIM_EXAMEN
                Log("  - DIM_EXAMEN...");
                var lkpExamens = new Dictionary<string, ExamenInfo>();
                using (var conn = new SqlConnection(connStrDest))
                {
                    conn.Open();
                    string sql = $@"
                        SELECT TW_N_EXAM_ID, DW_N_EXAM_ID,
                               DW_M_SEUI_PASS, DW_Q_NB_QUES
                        FROM [{bdDest}].[DWH].[DIM_EXAMEN]
                        WHERE DW_I_COUR = 1;";
                    using (var cmd = new SqlCommand(sql, conn))
                    using (var rdr = cmd.ExecuteReader())
                        while (rdr.Read())
                            lkpExamens[rdr.GetString(0)] = new ExamenInfo
                            {
                                SK = rdr.GetInt32(1),
                                Seuil = rdr.IsDBNull(2) ? (decimal?)null : rdr.GetDecimal(2),
                                NbQuestions = rdr.IsDBNull(3) ? (int?)null : rdr.GetInt32(3)
                            };
                }
                Log($"    {lkpExamens.Count} examens charges");

                // LKP 2 : DIM_CANDIDAT
                Log("  - DIM_CANDIDAT...");
                var lkpCandidats = new Dictionary<string, int>();
                using (var conn = new SqlConnection(connStrDest))
                {
                    conn.Open();
                    string sql = $@"
                        SELECT TW_N_UTIL_ID, DW_N_CAND_ID
                        FROM [{bdDest}].[DWH].[DIM_CANDIDAT]
                        WHERE DW_I_COUR = 1;";
                    using (var cmd = new SqlCommand(sql, conn))
                    using (var rdr = cmd.ExecuteReader())
                        while (rdr.Read())
                            lkpCandidats[rdr.GetString(0)] = rdr.GetInt32(1);
                }
                Log($"    {lkpCandidats.Count} candidats charges");

                // LKP 3 : DIM_DATE
                Log("  - DIM_DATE...");
                var lkpDates = new Dictionary<string, int>();
                int dateInconnuSK = 19000101;
                using (var conn = new SqlConnection(connStrDest))
                {
                    conn.Open();
                    string sql = $@"
                        SELECT DW_N_DATE_ID,
                               CONVERT(VARCHAR(10), DW_D_DATE, 120) AS DateKey
                        FROM [{bdDest}].[DWH].[DIM_DATE];";
                    using (var cmd = new SqlCommand(sql, conn))
                    using (var rdr = cmd.ExecuteReader())
                        while (rdr.Read())
                            lkpDates[rdr.GetString(1)] = rdr.GetInt32(0);
                }
                Log($"    {lkpDates.Count} dates chargees");

                // LKP 4 : GIC (bureau + ROW_ID_INSC + reprise)
                Log("  - GIC (bureau + ROW_ID_INSC + reprise)...");
                var lkpGic = new Dictionary<string, GicInfo>();
                using (var conn = new SqlConnection(connStrSource))
                {
                    conn.Open();
                    string sql = $@"
                        SELECT
                            ie.ROW_ID                  AS CopyID,
                            ie.ROW_ID                  AS GiRowIdInsc,
                            se.X_GI_NO_SALL_EXAM       AS CodeBureau,
                            CASE WHEN ie.X_GI_I_REPR_EXAM = 'Y' THEN 1 ELSE 0 END AS IsRepr
                        FROM [{bdSource}].[dbo].[CX_INSC_EXAM] ie
                        LEFT JOIN [{bdSource}].[dbo].[CX_INSC_SEAN_EX] ise
                            ON ise.PAR_ROW_ID__CXINSC_EXAM = ie.ROW_ID
                        LEFT JOIN [{bdSource}].[dbo].[CX_SEANCE_EXAM] sxe
                            ON sxe.ROW_ID = ise.PAR_ROW_ID__CXSEANCE_EXAM
                        LEFT JOIN [{bdSource}].[dbo].[CX_SALLE_EXAMEN] se
                            ON se.ROW_ID = sxe.PAR_ROW_ID_CXSALLE_EXAMEN;";
                    using (var cmd = new SqlCommand(sql, conn))
                    using (var rdr = cmd.ExecuteReader())
                        while (rdr.Read())
                        {
                            string copyId = rdr["CopyID"].ToString();
                            if (!lkpGic.ContainsKey(copyId))
                                lkpGic[copyId] = new GicInfo
                                {
                                    GiRowIdInsc = rdr["GiRowIdInsc"].ToString(),
                                    CodeBureau = rdr.IsDBNull(rdr.GetOrdinal("CodeBureau"))
                                                  ? null : rdr["CodeBureau"].ToString(),
                                    IsRepr = rdr.GetInt32(3) == 1
                                };
                        }
                }
                Log($"    {lkpGic.Count} lignes GIC chargees");

                // LKP 5 : DIM_BUREAU
                Log("  - DIM_BUREAU...");
                var lkpBureau = new Dictionary<string, int>();
                using (var conn = new SqlConnection(connStrDest))
                {
                    conn.Open();
                    string sql = $"SELECT DW_C_BURE, DW_N_BURE_ID FROM [{bdDest}].[DWH].[DIM_BUREAU];";
                    using (var cmd = new SqlCommand(sql, conn))
                    using (var rdr = cmd.ExecuteReader())
                        while (rdr.Read())
                            lkpBureau[rdr.GetString(0)] = rdr.GetInt32(1);
                }
                Log($"    {lkpBureau.Count} bureaux charges");

                // ─────────────────────────────────────────────────────────────
                // 3. DELETE TABLE DESTINATION
                // ─────────────────────────────────────────────────────────────
                Log("DELETE table destination...");
                using (var conn = new SqlConnection(connStrDest))
                {
                    conn.Open();
                    using (var cmd = new SqlCommand($"DELETE FROM [{bdDest}].[DWH].[FACT_RESULTAT_EXAMEN];", conn))
                        Log($"DELETE OK: {cmd.ExecuteNonQuery()} lignes");
                }

                // ─────────────────────────────────────────────────────────────
                // 4. LECTURE + INSERTION
                // ─────────────────────────────────────────────────────────────
                Log("Traitement TW_COPIE...");

                string sqlCopies = $@"
                    SELECT
                        c.TW_N_COPI_ID,
                        c.TW_N_FK_EXAM_ID   AS ExamId,
                        c.TW_N_FK_UTIL_ID   AS UtilId,
                        c.TW_DH_SOUM,
                        c.TW_DH_FIN,
                        c.TW_DH_CORR,
                        c.TW_C_STAT,
                        c.TW_M_PCNT,
                        c.TW_M_TOTA_PTS,
                        c.TW_Q_DURE_SEC
                    FROM [{bdDest}].[STG].[TW_COPIE] c;";

                string insertSql = $@"
                    INSERT INTO [{bdDest}].[DWH].[FACT_RESULTAT_EXAMEN]
                    (
                        DW_N_CAND_ID, DW_N_EXAM_ID, DW_N_BURE_ID,
                        DW_N_DATE_EXAM_ID, DW_N_DATE_CORR_ID,
                        GI_N_ROW_ID_INSC, TW_N_COPI_ID,
                        DW_M_NOTE_PCNT, DW_M_NOTE_BRUT,
                        DW_M_SEUI_REUS, DW_I_REUS, DW_I_ABSE,
                        DW_Q_NB_QUES_TOTA, DW_Q_DURE_PASS_SEC,
                        DW_I_REPR, DW_DH_SEAN, DW_DH_CORR,
                        DW_DH_CHARG_ETL, DW_C_SYST_SRCE, DW_C_LOT_ETL
                    )
                    VALUES
                    (
                        @CandSK, @ExamSK, @BureSK,
                        @DateExamSK, @DateCorrSK,
                        @GiRowIdInsc, @CopyId,
                        @NotePcnt, @NoteBrut,
                        @Seuil, @IsReus, @IsAbse,
                        @NbQuestions, @DureeSec,
                        @IsRepr, @DhSean, @DhCorr,
                        GETDATE(), 'TestWe', @CopyId
                    );";

                int totalInseres = 0;
                int totalSkipped = 0;
                int totalDoublons = 0;
                var copiesDejaVues = new HashSet<string>();

                using (var connDest = new SqlConnection(connStrDest))
                {
                    connDest.Open();
                    using (var cmdRead = new SqlCommand(sqlCopies, connDest))
                    {
                        cmdRead.CommandTimeout = 600;
                        using (var rdr = cmdRead.ExecuteReader())
                        {
                            while (rdr.Read())
                            {
                                string copyId = rdr["TW_N_COPI_ID"].ToString();
                                string examId = rdr["ExamId"].ToString();
                                string utilId = rdr["UtilId"].ToString();

                                // Deduplication
                                if (copiesDejaVues.Contains(copyId))
                                {
                                    Log($"  DOUBLON ignore: {copyId}");
                                    totalDoublons++; totalSkipped++; continue;
                                }
                                copiesDejaVues.Add(copyId);

                                // Lookup DIM_EXAMEN
                                if (!lkpExamens.ContainsKey(examId))
                                {
                                    Log($"  SKIP: examen non trouve {examId}");
                                    totalSkipped++; continue;
                                }
                                var examInfo = lkpExamens[examId];

                                // Lookup DIM_CANDIDAT
                                if (!lkpCandidats.ContainsKey(utilId))
                                {
                                    Log($"  SKIP: candidat non trouve {utilId}");
                                    totalSkipped++; continue;
                                }
                                int candSK = lkpCandidats[utilId];

                                // Dates
                                DateTime? dhSean = rdr.IsDBNull(rdr.GetOrdinal("TW_DH_SOUM"))
                                    ? (DateTime?)null : rdr.GetDateTime(rdr.GetOrdinal("TW_DH_SOUM"));
                                if (!dhSean.HasValue && !rdr.IsDBNull(rdr.GetOrdinal("TW_DH_FIN")))
                                    dhSean = rdr.GetDateTime(rdr.GetOrdinal("TW_DH_FIN"));

                                DateTime? dhCorr = rdr.IsDBNull(rdr.GetOrdinal("TW_DH_CORR"))
                                    ? (DateTime?)null : rdr.GetDateTime(rdr.GetOrdinal("TW_DH_CORR"));

                                int dateExamSK = dateInconnuSK;
                                if (dhSean.HasValue)
                                {
                                    string key = dhSean.Value.ToString("yyyy-MM-dd");
                                    if (lkpDates.ContainsKey(key)) dateExamSK = lkpDates[key];
                                }

                                int dateCorrSK = dateInconnuSK;
                                if (dhCorr.HasValue)
                                {
                                    string key = dhCorr.Value.ToString("yyyy-MM-dd");
                                    if (lkpDates.ContainsKey(key)) dateCorrSK = lkpDates[key];
                                }

                                // GIC
                                string giRowIdInsc = null;
                                int? bureSK = null;
                                bool isRepr = false;
                                if (lkpGic.ContainsKey(copyId))
                                {
                                    var gic = lkpGic[copyId];
                                    giRowIdInsc = gic.GiRowIdInsc;
                                    isRepr = gic.IsRepr;
                                    if (!string.IsNullOrEmpty(gic.CodeBureau) && lkpBureau.ContainsKey(gic.CodeBureau))
                                        bureSK = lkpBureau[gic.CodeBureau];
                                }

                                // Notes
                                decimal? notePcnt = rdr.IsDBNull(rdr.GetOrdinal("TW_M_PCNT")) ? (decimal?)null : rdr.GetDecimal(rdr.GetOrdinal("TW_M_PCNT"));
                                decimal? noteBrut = rdr.IsDBNull(rdr.GetOrdinal("TW_M_TOTA_PTS")) ? (decimal?)null : rdr.GetDecimal(rdr.GetOrdinal("TW_M_TOTA_PTS"));
                                int? dureeSec = rdr.IsDBNull(rdr.GetOrdinal("TW_Q_DURE_SEC")) ? (int?)null : rdr.GetInt32(rdr.GetOrdinal("TW_Q_DURE_SEC"));
                                string statut = rdr.IsDBNull(rdr.GetOrdinal("TW_C_STAT")) ? null : rdr["TW_C_STAT"].ToString();

                                // Indicateurs
                                bool isAbse = !dhSean.HasValue ||
                                              (statut != null && (
                                                  statut.ToLower() == "absent" ||
                                                  statut.ToLower() == "not_started"));

                                bool isReus = false;
                                if (!isAbse && notePcnt.HasValue && examInfo.Seuil.HasValue)
                                    isReus = notePcnt.Value >= examInfo.Seuil.Value;

                                if (isAbse) { notePcnt = 0; noteBrut = 0; }

                                // INSERT
                                using (var cmdIns = new SqlCommand(insertSql, connDest))
                                {
                                    cmdIns.Parameters.AddWithValue("@CandSK", candSK);
                                    cmdIns.Parameters.AddWithValue("@ExamSK", examInfo.SK);
                                    cmdIns.Parameters.AddWithValue("@BureSK", bureSK ?? (object)DBNull.Value);
                                    cmdIns.Parameters.AddWithValue("@DateExamSK", dateExamSK);
                                    cmdIns.Parameters.AddWithValue("@DateCorrSK", dateCorrSK);
                                    cmdIns.Parameters.AddWithValue("@GiRowIdInsc", giRowIdInsc ?? (object)DBNull.Value);
                                    cmdIns.Parameters.AddWithValue("@CopyId", copyId);
                                    cmdIns.Parameters.AddWithValue("@NotePcnt", notePcnt ?? (object)DBNull.Value);
                                    cmdIns.Parameters.AddWithValue("@NoteBrut", noteBrut ?? (object)DBNull.Value);
                                    cmdIns.Parameters.AddWithValue("@Seuil", examInfo.Seuil ?? (object)DBNull.Value);
                                    cmdIns.Parameters.AddWithValue("@IsReus", isReus ? 1 : 0);
                                    cmdIns.Parameters.AddWithValue("@IsAbse", isAbse ? 1 : 0);
                                    cmdIns.Parameters.AddWithValue("@NbQuestions", examInfo.NbQuestions ?? (object)DBNull.Value);
                                    cmdIns.Parameters.AddWithValue("@DureeSec", dureeSec ?? (object)DBNull.Value);
                                    cmdIns.Parameters.AddWithValue("@IsRepr", isRepr ? 1 : 0);
                                    cmdIns.Parameters.AddWithValue("@DhSean", dhSean ?? (object)DBNull.Value);
                                    cmdIns.Parameters.AddWithValue("@DhCorr", dhCorr ?? (object)DBNull.Value);

                                    cmdIns.ExecuteNonQuery();
                                    totalInseres++;
                                }

                                if (totalInseres % 10 == 0)
                                    Log($"  Insere: {totalInseres} resultats...");
                            }
                        }
                    }
                }

                // ─────────────────────────────────────────────────────────────
                // 5. STATISTIQUES FINALES
                // ─────────────────────────────────────────────────────────────
                Log("");
                Log("═══════════════════════════════════════════════════════════");
                Log("STATISTIQUES FINALES:");
                Log($"  - Resultats inseres:  {totalInseres}");
                Log($"  - Skippes:            {totalSkipped}");
                Log($"  - Doublons rejetes:   {totalDoublons}");
                Log("═══════════════════════════════════════════════════════════");

                SafeLog($"=== FIN {_scriptName} SUCCESS - {DateTime.Now} ===\n");
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                try
                {
                    string errorLog = "\n" + new string('=', 80) + "\n";
                    errorLog += $"DATE: {DateTime.Now:yyyy-MM-dd HH:mm:ss}\n";
                    errorLog += $"SCRIPT: {_scriptName}\n";
                    errorLog += $"ERREUR: {ex.Message}\n";
                    errorLog += $"\nSTACK TRACE:\n{ex.StackTrace}\n";
                    errorLog += new string('=', 80) + "\n";
                    SafeLog(errorLog);
                }
                catch { }
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        #region Helper Classes

        private class ExamenInfo
        {
            public int SK { get; set; }
            public decimal? Seuil { get; set; }
            public int? NbQuestions { get; set; }
        }

        private class GicInfo
        {
            public string GiRowIdInsc { get; set; }
            public string CodeBureau { get; set; }
            public bool IsRepr { get; set; }
        }

        #endregion

        #region Logging

        private void Log(string message) { SafeLog($"[{DateTime.Now:HH:mm:ss}] {message}\n"); }

        private void SafeLog(string message)
        {
            try
            {
                using (FileStream fs = new FileStream(_logFile, FileMode.Append, FileAccess.Write, FileShare.ReadWrite))
                using (StreamWriter sw = new StreamWriter(fs))
                    sw.Write(message);
            }
            catch { }
        }

        #endregion

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
