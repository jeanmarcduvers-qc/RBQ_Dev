                  <ProjectItem
                    Name="ScriptMain.cs"
                    Encoding="UTF8"><![CDATA[// UPDATED: Refonte OPENJSON - Suppression dépendance Newtonsoft.Json - 2026-03-30
/*
 * RIPQUAR - Script Task TW_CHOIX
 * Parse JSON question[].questionBank[].choices[] → STG.TW_CHOIX
 *
 * REFONTE: Parsing JSON déplacé du C# vers T-SQL natif (OPENJSON / JSON_VALUE)
 *          Aucune dépendance externe - Compatible migration SQL Server 2025
 *
 * NOTE: TW_DE_CHOI = varchar(1) - Premier caractère du name seulement
 *       IF NOT EXISTS conservé : un même choix peut apparaître dans plusieurs examens
 *
 * Variables SSIS requises:
 * - ServerSource, BDSource, ServerDest, BDDest
 */

#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.Data.SqlClient;
using System.IO;
#endregion

namespace ST_Load_TW_CHOIX
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private string _logFile;
        private string _scriptName;

        public void Main()
        {
            string _logDir = System.IO.Path.GetDirectoryName(Dts.Variables["User::LogFile"].Value.ToString());
            _logFile = System.IO.Path.Combine(_logDir, $"RIPQUAR_{DateTime.Now:yyyyMMdd_HHmmss}.log");
            _scriptName = Dts.Variables["System::TaskName"].Value.ToString();

            try
            {
                SafeLog($"\n=== DÉBUT {_scriptName} - {DateTime.Now} ===\n");

                string serverSource = Dts.Variables["User::ServerSource"].Value.ToString();
                string serverDest = Dts.Variables["User::ServerDest"].Value.ToString();
                LogInfo($"Source: {serverSource} → Destination: {serverDest}");

                LoadTable();

                SafeLog($"=== FIN {_scriptName} SUCCESS - {DateTime.Now} ===\n");
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                try
                {
                    string errorLog = "\n" + new string('=', 80) + "\n";
                    errorLog += $"DATE: {DateTime.Now:yyyy-MM-dd HH:mm:ss}\n";
                    errorLog += $"SCRIPT: {_scriptName}\n";
                    errorLog += $"ERREUR: {ex.Message}\n";
                    errorLog += $"\nSTACK TRACE:\n{ex.StackTrace}\n";
                    errorLog += new string('=', 80) + "\n";
                    SafeLog(errorLog);
                }
                catch { }

                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // TEMPLATE COMMUN
        // ─────────────────────────────────────────────────────────────────────

        private string BuildSourceConnectionString()
        {
            string server = Dts.Variables["User::ServerSource"].Value.ToString();
            string database = Dts.Variables["User::BDSource"].Value.ToString();
            return $"Data Source={server};Initial Catalog={database};Integrated Security=True;";
        }

        private string BuildDestinationConnectionString()
        {
            string server = Dts.Variables["User::ServerDest"].Value.ToString();
            string database = Dts.Variables["User::BDDest"].Value.ToString();
            return $"Data Source={server};Initial Catalog={database};Integrated Security=True;";
        }

        private void SafeLog(string message)
        {
            try
            {
                using (FileStream fs = new FileStream(_logFile, FileMode.Append, FileAccess.Write, FileShare.ReadWrite))
                using (StreamWriter sw = new StreamWriter(fs))
                {
                    sw.Write(message);
                }
            }
            catch { }
        }

        private void LogInfo(string message)
        {
            SafeLog($"[{DateTime.Now:HH:mm:ss}] {message}\n");
        }

        private void LogWarning(string message)
        {
            Dts.Events.FireWarning(0, "TW_CHOIX", message, "", 0);
        }

        private void ClearTable(string fullTableName)
        {
            LogInfo($"Nettoyage table {fullTableName}...");
            using (SqlConnection conn = new SqlConnection(BuildDestinationConnectionString()))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand($"DELETE FROM {fullTableName}", conn))
                {
                    int rowsDeleted = cmd.ExecuteNonQuery();
                    LogInfo($"{rowsDeleted} ligne(s) supprimée(s)");
                }
            }
        }

        private DataTable GetExamSourceData()
        {
            DataTable dt = new DataTable();
            string query = @"
                SELECT
                    ROW_ID,
                    CONVERT(NVARCHAR(MAX), X_GI_V_VECT_EXAM) AS JSON_EXAM
                FROM [dbo].[CX_INSC_EXAM]
                WHERE X_GI_V_VECT_EXAM IS NOT NULL
                ORDER BY LAST_UPD DESC;
            ";

            using (SqlConnection conn = new SqlConnection(BuildSourceConnectionString()))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand(query, conn))
                {
                    cmd.CommandTimeout = 300;
                    using (SqlDataAdapter adapter = new SqlDataAdapter(cmd))
                        adapter.Fill(dt);
                }
            }

            LogInfo($"Récupéré {dt.Rows.Count} examen(s) source");
            return dt;
        }

        // ─────────────────────────────────────────────────────────────────────
        // LOGIQUE SPÉCIFIQUE TW_CHOIX
        // ─────────────────────────────────────────────────────────────────────

        private void LoadTable()
        {
            ClearTable("[SDGIC01].[STG].[TW_CHOIX]");

            DataTable dtSource = GetExamSourceData();
            int nbChoixProcessed = 0;
            int nbErrors = 0;

            foreach (DataRow row in dtSource.Rows)
            {
                try
                {
                    int nb = ParseAndLoadChoix(row);
                    nbChoixProcessed += nb;
                }
                catch (Exception ex)
                {
                    nbErrors++;
                    LogWarning($"Erreur examen {row["ROW_ID"]}: {ex.Message}");
                }
            }

            LogInfo($"Traitement terminé - Choix chargés: {nbChoixProcessed}, Erreurs: {nbErrors}");
        }

        /// <summary>
        /// Insère tous les choix d'un examen via OPENJSON (5 niveaux).
        ///
        /// Navigation: examParts[] → partIndexes[] → question[] → questionBank[] → choices[]
        ///
        /// IF NOT EXISTS : un choix peut apparaître dans plusieurs copies du même examen,
        ///                 la clé TW_N_CHOI_ID garantit l'unicité.
        ///
        /// TW_N_FK_QUES_ID : id de la question parente (de question[])
        /// TW_DE_CHOI      : varchar(1) → LEFT(name, 1)
        /// TW_N_POSI       : position JSON du choix ($.position) ou index dans choices[]
        /// </summary>
        private int ParseAndLoadChoix(DataRow sourceRow)
        {
            string rowId = sourceRow["ROW_ID"].ToString();
            string jsonExamRaw = sourceRow["JSON_EXAM"].ToString();
            string lotETL = "RIPQUAR_" + DateTime.Now.ToString("yyyyMMdd_HHmmss");

            string insertQuery = @"
                INSERT INTO [SDGIC01].[STG].[TW_CHOIX]
                (
                    TW_N_CHOI_ID,
                    TW_N_FK_QUES_ID,
                    TW_DE_CHOI,
                    TW_I_CORR,
                    TW_N_POSI,
                    TW_DH_CHARG_ETL,
                    TW_C_SYST_SRCE,
                    TW_C_LOT_ETL
                )
                SELECT
                    JSON_VALUE(ch.value,  '$.id'),
                    JSON_VALUE(q.value,   '$.id'),              -- FK → question parente

                    -- varchar(1) : premier caractère du libellé du choix
                    LEFT(JSON_VALUE(ch.value, '$.name'), 1),

                    -- Indicateur bonne réponse
                    CASE
                        WHEN JSON_VALUE(ch.value, '$.correct') = 'true' THEN 1
                        ELSE 0
                    END,

                    -- Position : valeur JSON en priorité, sinon index dans choices[]
                    COALESCE(
                        TRY_CAST(JSON_VALUE(ch.value, '$.position') AS INT),
                        CAST(ch.[key] AS INT)
                    ),

                    GETDATE(),
                    N'TestWe',
                    @LotETL

                FROM OPENJSON(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].examParts')
                     AS parts

                CROSS APPLY OPENJSON(parts.value, '$.partIndexes')
                     AS idx

                CROSS APPLY OPENJSON(idx.value, '$.question')
                     AS q

                -- questionBank[0] : OUTER APPLY + TOP 1 ORDER BY key
                -- Evite le WHERE intermédiaire qui brise la chaîne des CROSS APPLY
                OUTER APPLY (
                    SELECT TOP 1 qb_inner.value AS qbValue
                    FROM OPENJSON(q.value, '$.questionBank') AS qb_inner
                    ORDER BY CAST(qb_inner.[key] AS INT)
                ) AS qb0

                -- choices[] de questionBank[0]
                CROSS APPLY OPENJSON(qb0.qbValue, '$.choices')
                     AS ch

                -- Déduplication : ne pas insérer si l'ID existe déjà
                WHERE JSON_VALUE(ch.value, '$.id') IS NOT NULL
                  AND qb0.qbValue IS NOT NULL
                  AND NOT EXISTS (
                    SELECT 1
                    FROM [SDGIC01].[STG].[TW_CHOIX] existing
                    WHERE existing.TW_N_CHOI_ID = JSON_VALUE(ch.value, '$.id')
                );
            ";

            using (SqlConnection conn = new SqlConnection(BuildDestinationConnectionString()))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand(insertQuery, conn))
                {
                    cmd.Parameters.Add("@Json", SqlDbType.NVarChar, -1).Value = jsonExamRaw;
                    cmd.Parameters.Add("@LotETL", SqlDbType.NVarChar, 50).Value = lotETL;

                    int rowsInserted = cmd.ExecuteNonQuery();
                    LogInfo($"ROW_ID {rowId}: {rowsInserted} choix chargé(s)");
                    return rowsInserted;
                }
            }
        }

        #region ScriptResults
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
