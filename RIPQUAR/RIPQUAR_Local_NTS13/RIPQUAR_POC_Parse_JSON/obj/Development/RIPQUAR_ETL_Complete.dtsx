                    Encoding="UTF8"><![CDATA[// UPDATED: Refonte OPENJSON - Suppression dépendance Newtonsoft.Json - 2026-03-30
/*
 * RIPQUAR - Script Task TW_COPIE
 * Parse JSON CORR RespBody → STG.TW_COPIE
 *
 * REFONTE: Parsing JSON déplacé du C# vers T-SQL natif (JSON_VALUE)
 *          Aucune dépendance externe - Compatible migration SQL Server 2025
 *
 * Structure CORR JSON: RespBody = OBJET direct (pas de tableau, pas de wrapper)
 *   → JSON_VALUE(@Json, '$.RespBody.studentPaperId')
 *
 * Extraction UUID examen depuis URL: /v1/exams/{UUID}
 *   → RIGHT(JSON_VALUE(..., '$.RespBody.exam."@id"'), 36)
 *
 * Variables SSIS requises:
 * - ServerSource, BDSource, ServerDest, BDDest
 */

#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.Data.SqlClient;
using System.IO;
#endregion

namespace ST_Load_TW_COPIE
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private string _logFile;
        private string _scriptName;

        public void Main()
        {
            string _logDir = System.IO.Path.GetDirectoryName(Dts.Variables["User::LogFile"].Value.ToString());
            _logFile = System.IO.Path.Combine(_logDir, $"RIPQUAR_{DateTime.Now:yyyyMMdd_HHmmss}.log");
            _scriptName = Dts.Variables["System::TaskName"].Value.ToString();

            try
            {
                SafeLog($"\n=== DÉBUT {_scriptName} - {DateTime.Now} ===\n");

                string serverSource = Dts.Variables["User::ServerSource"].Value.ToString();
                string serverDest = Dts.Variables["User::ServerDest"].Value.ToString();
                LogInfo($"Source: {serverSource} → Destination: {serverDest}");

                LoadTable();

                SafeLog($"=== FIN {_scriptName} SUCCESS - {DateTime.Now} ===\n");
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                try
                {
                    string errorLog = "\n" + new string('=', 80) + "\n";
                    errorLog += $"DATE: {DateTime.Now:yyyy-MM-dd HH:mm:ss}\n";
                    errorLog += $"SCRIPT: {_scriptName}\n";
                    errorLog += $"ERREUR: {ex.Message}\n";
                    errorLog += $"\nSTACK TRACE:\n{ex.StackTrace}\n";
                    errorLog += new string('=', 80) + "\n";
                    SafeLog(errorLog);
                }
                catch { }

                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // TEMPLATE COMMUN
        // ─────────────────────────────────────────────────────────────────────

        private string BuildSourceConnectionString()
        {
            string server = Dts.Variables["User::ServerSource"].Value.ToString();
            string database = Dts.Variables["User::BDSource"].Value.ToString();
            return $"Data Source={server};Initial Catalog={database};Integrated Security=True;";
        }

        private string BuildDestinationConnectionString()
        {
            string server = Dts.Variables["User::ServerDest"].Value.ToString();
            string database = Dts.Variables["User::BDDest"].Value.ToString();
            return $"Data Source={server};Initial Catalog={database};Integrated Security=True;";
        }

        private void SafeLog(string message)
        {
            try
            {
                using (FileStream fs = new FileStream(_logFile, FileMode.Append, FileAccess.Write, FileShare.ReadWrite))
                using (StreamWriter sw = new StreamWriter(fs))
                {
                    sw.Write(message);
                }
            }
            catch { }
        }

        private void LogInfo(string message)
        {
            SafeLog($"[{DateTime.Now:HH:mm:ss}] {message}\n");
        }

        private void LogWarning(string message)
        {
            Dts.Events.FireWarning(0, "TW_COPIE", message, "", 0);
        }

        private void ClearTable(string fullTableName)
        {
            LogInfo($"Nettoyage table {fullTableName}...");
            using (SqlConnection conn = new SqlConnection(BuildDestinationConnectionString()))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand($"DELETE FROM {fullTableName}", conn))
                {
                    int rowsDeleted = cmd.ExecuteNonQuery();
                    LogInfo($"{rowsDeleted} ligne(s) supprimée(s)");
                }
            }
        }

        private DataTable GetCorrSourceData()
        {
            DataTable dt = new DataTable();
            string query = @"
                SELECT
                    ROW_ID,
                    CONVERT(NVARCHAR(MAX), X_GI_V_VECT_CORR_EXAM) AS JSON_CORR
                FROM [dbo].[CX_INSC_EXAM]
                WHERE X_GI_V_VECT_CORR_EXAM IS NOT NULL
                ORDER BY LAST_UPD DESC;
            ";

            using (SqlConnection conn = new SqlConnection(BuildSourceConnectionString()))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand(query, conn))
                {
                    cmd.CommandTimeout = 300;
                    using (SqlDataAdapter adapter = new SqlDataAdapter(cmd))
                        adapter.Fill(dt);
                }
            }

            LogInfo($"Récupéré {dt.Rows.Count} copie(s) source");
            return dt;
        }

        // ─────────────────────────────────────────────────────────────────────
        // LOOKUP UTILISATEUR (inchangé - pas de Newtonsoft)
        // ─────────────────────────────────────────────────────────────────────

        private string LookupUtilisateurUUID(string userId)
        {
            if (string.IsNullOrEmpty(userId))
                return null;

            string query = @"
                SELECT TW_N_UTIL_ID
                FROM [SDGIC01].[STG].[TW_UTILISATEUR]
                WHERE TW_N_UTIL_ID_INTR = @UserId;
            ";

            using (SqlConnection conn = new SqlConnection(BuildDestinationConnectionString()))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    object result = cmd.ExecuteScalar();

                    if (result == null)
                        LogWarning($"Lookup utilisateur: userId={userId} NOT FOUND");
                    else
                        LogInfo($"Lookup utilisateur: userId={userId} → UUID={result}");

                    return result?.ToString();
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // LOGIQUE SPÉCIFIQUE TW_COPIE
        // ─────────────────────────────────────────────────────────────────────

        private void LoadTable()
        {
            ClearTable("[SDGIC01].[STG].[TW_COPIE]");

            DataTable dtSource = GetCorrSourceData();
            int nbCopiesLoaded = 0;
            int nbErrors = 0;

            LogInfo("Chargement des copies...");

            foreach (DataRow row in dtSource.Rows)
            {
                try
                {
                    InsertCopie(row);
                    nbCopiesLoaded++;
                }
                catch (Exception ex)
                {
                    nbErrors++;
                    LogWarning($"Erreur copie {row["ROW_ID"]}: {ex.Message}");
                }
            }

            LogInfo($"Traitement terminé - Copies chargées: {nbCopiesLoaded}, Erreurs: {nbErrors}");
        }

        /// <summary>
        /// Insère une copie depuis CORR JSON via JSON_VALUE.
        ///
        /// Structure CORR JSON (Stratégie active): RespBody = objet direct à la racine
        ///   → JSON_VALUE(@Json, '$.RespBody.studentPaperId')
        ///   → JSON_VALUE(@Json, '$.RespBody.student.userId')
        ///   → JSON_VALUE(@Json, '$.RespBody.exam."@id"')  -- clé avec @
        ///
        /// UUID examen: RIGHT(url, 36) depuis "/v1/exams/{UUID}"
        ///
        /// UUID utilisateur: lookup TW_UTILISATEUR via studentUserId
        ///
        /// Dates: TRY_CONVERT(DATETIME, ...) gère format ISO directement
        /// </summary>
        private void InsertCopie(DataRow sourceRow)
        {
            string rowId = sourceRow["ROW_ID"].ToString();
            string jsonCorrRaw = sourceRow["JSON_CORR"].ToString();
            string lotETL = "RIPQUAR_" + DateTime.Now.ToString("yyyyMMdd_HHmmss");

            // Extraire les champs scalaires via JSON_VALUE (en SQL)
            string extractQuery = @"
                SELECT
                    -- ID interne de la copie TestWe (studentPaperId)
                    JSON_VALUE(@Json, '$.RespBody.studentPaperId')        AS StudentPaperId,

                    -- Étudiant
                    JSON_VALUE(@Json, '$.RespBody.student.userId')        AS StudentUserId,
                    JSON_VALUE(@Json, '$.RespBody.student.firstName')     AS FirstName,
                    JSON_VALUE(@Json, '$.RespBody.student.lastName')      AS LastName,

                    -- UUID examen: extraire les 36 derniers caractères de l'URL
                    -- Format: /v1/exams/{UUID-36-chars}
                    RIGHT(
                        JSON_VALUE(@Json, N'$.RespBody.exam.""@id""'),
                        36
                    )                                                     AS ExamId,

                    -- Dates ISO 8601 avec timezone (ex: 2026-02-02T20:50:26+00:00)
                    -- TRY_CONVERT(DATETIME) seul ne gere pas le +00:00
                    -- Solution : passer par DATETIMEOFFSET puis convertir en DATETIME UTC
                    CONVERT(DATETIME,
                        TRY_CONVERT(DATETIMEOFFSET, JSON_VALUE(@Json, '$.RespBody.endDate')))     AS EndDate,
                    CONVERT(DATETIME,
                        TRY_CONVERT(DATETIMEOFFSET, JSON_VALUE(@Json, '$.RespBody.submitDate')))  AS SubmitDate,
                    CONVERT(DATETIME,
                        TRY_CONVERT(DATETIMEOFFSET, JSON_VALUE(@Json, '$.RespBody.gradingDate'))) AS GradingDate,

                    -- Flag
                    CASE WHEN JSON_VALUE(@Json, '$.RespBody.hasFlaggedAnswer') = 'true' THEN 1 ELSE 0 END
                                                                          AS HasFlaggedAnswer;
            ";

            string studentUserId = null;
            string studentPaperId = null;
            string examId = null;
            string studentFullName = null;
            object endDate = DBNull.Value;
            object submitDate = DBNull.Value;
            object gradingDate = DBNull.Value;
            object hasFlagged = DBNull.Value;

            using (SqlConnection conn = new SqlConnection(BuildDestinationConnectionString()))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand(extractQuery, conn))
                {
                    cmd.Parameters.Add("@Json", SqlDbType.NVarChar, -1).Value = jsonCorrRaw;

                    using (SqlDataReader rdr = cmd.ExecuteReader())
                    {
                        if (rdr.Read())
                        {
                            studentPaperId = rdr.IsDBNull(0) ? null : rdr.GetString(0);
                            studentUserId = rdr.IsDBNull(1) ? null : rdr.GetString(1);
                            string firstName = rdr.IsDBNull(2) ? null : rdr.GetString(2);
                            string lastName = rdr.IsDBNull(3) ? null : rdr.GetString(3);
                            studentFullName = $"{firstName} {lastName}".Trim();
                            examId = rdr.IsDBNull(4) ? null : rdr.GetString(4);
                            endDate = rdr.IsDBNull(5) ? (object)DBNull.Value : rdr.GetDateTime(5);
                            submitDate = rdr.IsDBNull(6) ? (object)DBNull.Value : rdr.GetDateTime(6);
                            gradingDate = rdr.IsDBNull(7) ? (object)DBNull.Value : rdr.GetDateTime(7);
                            hasFlagged = rdr.IsDBNull(8) ? (object)DBNull.Value : rdr.GetInt32(8);
                        }
                    }
                }
            }

            if (string.IsNullOrEmpty(examId))
                LogWarning($"ROW_ID {rowId}: exam @id non trouvé - INSERT avec NULL");

            // Lookup utilisateur UUID
            string utilisateurUUID = LookupUtilisateurUUID(studentUserId);
            if (string.IsNullOrEmpty(utilisateurUUID))
                LogWarning($"ROW_ID {rowId}: userId={studentUserId} non trouvé dans TW_UTILISATEUR - INSERT avec NULL");

            // INSERT final
            string insertQuery = @"
                INSERT INTO [SDGIC01].[STG].[TW_COPIE]
                (
                    TW_N_COPI_ID,
                    TW_N_COPI_ID_INTR,
                    TW_N_EXAM_ID,
                    TW_N_UTIL_ID,
                    TW_N_FK_EXAM_ID,
                    TW_N_FK_UTIL_ID,
                    TW_NM_ETUD,
                    TW_DH_FIN,
                    TW_DH_SOUM,
                    TW_DH_CORR,
                    TW_I_REPN_SIGN,
                    TW_DH_CHARG_ETL,
                    TW_C_SYST_SRCE,
                    TW_C_LOT_ETL
                )
                VALUES
                (
                    @CopieId,
                    @StudentPaperId,
                    @ExamId,
                    @UtilisateurUUID,
                    @ExamId,
                    @UtilisateurUUID,
                    @StudentFullName,
                    @EndDate,
                    @SubmitDate,
                    @GradingDate,
                    @HasFlaggedAnswer,
                    GETDATE(),
                    N'TestWe',
                    @LotETL
                );
            ";

            using (SqlConnection conn = new SqlConnection(BuildDestinationConnectionString()))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand(insertQuery, conn))
                {
                    cmd.Parameters.AddWithValue("@CopieId", rowId);
                    cmd.Parameters.AddWithValue("@StudentPaperId",
                        string.IsNullOrEmpty(studentPaperId) ? (object)DBNull.Value : (object)int.Parse(studentPaperId));
                    cmd.Parameters.AddWithValue("@ExamId", (object)examId ?? DBNull.Value);
                    cmd.Parameters.AddWithValue("@UtilisateurUUID", (object)utilisateurUUID ?? DBNull.Value);
                    cmd.Parameters.AddWithValue("@StudentFullName", (object)studentFullName ?? DBNull.Value);
                    cmd.Parameters.AddWithValue("@EndDate", endDate);
                    cmd.Parameters.AddWithValue("@SubmitDate", submitDate);
                    cmd.Parameters.AddWithValue("@GradingDate", gradingDate);
                    cmd.Parameters.AddWithValue("@HasFlaggedAnswer", hasFlagged);
                    cmd.Parameters.AddWithValue("@LotETL", lotETL);

                    cmd.ExecuteNonQuery();
                    LogInfo($"ROW_ID {rowId}: copie insérée (examId={examId ?? "NULL"})");
                }
            }
        }

        #region ScriptResults
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
