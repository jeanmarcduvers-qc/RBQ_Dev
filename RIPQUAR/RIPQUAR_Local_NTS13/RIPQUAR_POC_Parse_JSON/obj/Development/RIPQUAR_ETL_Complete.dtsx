                  <ProjectItem
                    Name="ScriptMain.cs"
                    Encoding="UTF8"><![CDATA[// UPDATED: Refonte OPENJSON - Suppression dépendance Newtonsoft.Json - 2026-03-30
/*
 * RIPQUAR - Script Task TW_UTILISATEUR
 * Parse JSON students[] + graders[] → STG.TW_UTILISATEUR (avec DÉDUPLICATION + FUSION RÔLES)
 *
 * REFONTE: Parsing JSON déplacé du C# vers T-SQL natif (OPENJSON / JSON_VALUE)
 *          Aucune dépendance externe - Compatible migration SQL Server 2025
 *
 * STRATÉGIE:
 *   - L'extraction JSON se fait via SQL (JSON_VALUE / OPENJSON) par examen
 *   - La déduplication et la fusion des rôles restent en C# (Dictionary<userId>)
 *   - Ce choix préserve la logique métier tout en éliminant Newtonsoft
 *
 * Student (JSON_CORR):  stratégie COALESCE sur plusieurs chemins possibles
 * Graders (JSON_EXAM):  OPENJSON sur studentPapersDistributions[].grader[0]
 *
 * Variables SSIS requises:
 * - ServerSource, BDSource, ServerDest, BDDest
 */

#region Namespaces
using System;
using System.Data;
using System.Collections.Generic;
using System.Linq;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.Data.SqlClient;
using System.IO;
#endregion

namespace ST_Load_TW_UTILISATEUR
{
    public class UtilisateurData
    {
        public string UserId { get; set; }
        public string FirstName { get; set; }
        public string LastName { get; set; }
        public string FullName { get; set; }
        public string Email { get; set; }
        public HashSet<string> Roles { get; set; }
        public bool? Blocked { get; set; }

        public UtilisateurData() { Roles = new HashSet<string>(); }
    }

    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private string _logFile;
        private string _scriptName;

        public void Main()
        {
            string _logDir = System.IO.Path.GetDirectoryName(Dts.Variables["User::LogFile"].Value.ToString());
            _logFile = System.IO.Path.Combine(_logDir, $"RIPQUAR_{DateTime.Now:yyyyMMdd_HHmmss}.log");
            _scriptName = Dts.Variables["System::TaskName"].Value.ToString();

            try
            {
                SafeLog($"\n=== DÉBUT {_scriptName} - {DateTime.Now} ===\n");

                string serverSource = Dts.Variables["User::ServerSource"].Value.ToString();
                string serverDest = Dts.Variables["User::ServerDest"].Value.ToString();
                LogInfo($"Source: {serverSource} → Destination: {serverDest}");

                LoadTable();

                SafeLog($"=== FIN {_scriptName} SUCCESS - {DateTime.Now} ===\n");
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                try
                {
                    string errorLog = "\n" + new string('=', 80) + "\n";
                    errorLog += $"DATE: {DateTime.Now:yyyy-MM-dd HH:mm:ss}\n";
                    errorLog += $"SCRIPT: {_scriptName}\n";
                    errorLog += $"ERREUR: {ex.Message}\n";
                    errorLog += $"\nSTACK TRACE:\n{ex.StackTrace}\n";
                    errorLog += new string('=', 80) + "\n";
                    SafeLog(errorLog);
                }
                catch { }

                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // TEMPLATE COMMUN
        // ─────────────────────────────────────────────────────────────────────

        private string BuildSourceConnectionString()
        {
            string server = Dts.Variables["User::ServerSource"].Value.ToString();
            string database = Dts.Variables["User::BDSource"].Value.ToString();
            return $"Data Source={server};Initial Catalog={database};Integrated Security=True;";
        }

        private string BuildDestinationConnectionString()
        {
            string server = Dts.Variables["User::ServerDest"].Value.ToString();
            string database = Dts.Variables["User::BDDest"].Value.ToString();
            return $"Data Source={server};Initial Catalog={database};Integrated Security=True;";
        }

        private void SafeLog(string message)
        {
            try
            {
                using (FileStream fs = new FileStream(_logFile, FileMode.Append, FileAccess.Write, FileShare.ReadWrite))
                using (StreamWriter sw = new StreamWriter(fs))
                {
                    sw.Write(message);
                }
            }
            catch { }
        }

        private void LogInfo(string message)
        {
            SafeLog($"[{DateTime.Now:HH:mm:ss}] {message}\n");
        }

        private void LogWarning(string message)
        {
            Dts.Events.FireWarning(0, "TW_UTILISATEUR", message, "", 0);
        }

        private void ClearTable(string fullTableName)
        {
            LogInfo($"Nettoyage table {fullTableName}...");
            using (SqlConnection conn = new SqlConnection(BuildDestinationConnectionString()))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand($"DELETE FROM {fullTableName}", conn))
                {
                    int rowsDeleted = cmd.ExecuteNonQuery();
                    LogInfo($"{rowsDeleted} ligne(s) supprimée(s)");
                }
            }
        }

        private DataTable GetExamSourceData()
        {
            DataTable dt = new DataTable();
            string query = @"
                SELECT
                    ROW_ID,
                    CONVERT(NVARCHAR(MAX), X_GI_V_VECT_EXAM)      AS JSON_EXAM,
                    CONVERT(NVARCHAR(MAX), X_GI_V_VECT_CORR_EXAM) AS JSON_CORR
                FROM [dbo].[CX_INSC_EXAM]
                WHERE X_GI_V_VECT_EXAM      IS NOT NULL
                  AND X_GI_V_VECT_CORR_EXAM IS NOT NULL
                ORDER BY LAST_UPD DESC;
            ";

            using (SqlConnection conn = new SqlConnection(BuildSourceConnectionString()))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand(query, conn))
                {
                    cmd.CommandTimeout = 300;
                    using (SqlDataAdapter adapter = new SqlDataAdapter(cmd))
                        adapter.Fill(dt);
                }
            }

            LogInfo($"Récupéré {dt.Rows.Count} examen(s) source (EXAM + CORR)");
            return dt;
        }

        // ─────────────────────────────────────────────────────────────────────
        // LOGIQUE SPÉCIFIQUE TW_UTILISATEUR
        // ─────────────────────────────────────────────────────────────────────

        private void LoadTable()
        {
            ClearTable("[SDGIC01].[STG].[TW_UTILISATEUR]");

            DataTable dtSource = GetExamSourceData();

            // Dictionary de déduplication : userId → UtilisateurData (logique C# préservée)
            Dictionary<string, UtilisateurData> utilisateurs =
                new Dictionary<string, UtilisateurData>(StringComparer.OrdinalIgnoreCase);

            int nbExamsProcessed = 0;
            int nbErrors = 0;

            LogInfo("Extraction utilisateurs (étudiants + correcteurs)...");

            foreach (DataRow row in dtSource.Rows)
            {
                try
                {
                    ExtractUtilisateursFromExam(row, utilisateurs);
                    nbExamsProcessed++;
                }
                catch (Exception ex)
                {
                    nbErrors++;
                    LogWarning($"Erreur examen {row["ROW_ID"]}: {ex.Message}");
                }
            }

            LogInfo($"{nbExamsProcessed} examen(s) traité(s), {utilisateurs.Count} utilisateur(s) unique(s)");

            // Insertion des utilisateurs uniques
            int nbUtilLoaded = 0;
            foreach (UtilisateurData util in utilisateurs.Values)
            {
                try
                {
                    InsertUtilisateur(util);
                    nbUtilLoaded++;
                }
                catch (Exception ex)
                {
                    LogWarning($"Erreur insertion userId={util.UserId}: {ex.Message}");
                }
            }

            LogInfo($"Traitement terminé - Utilisateurs chargés: {nbUtilLoaded}, Erreurs: {nbErrors}");
        }

        /// <summary>
        /// Extrait les utilisateurs (student + graders) via JSON_VALUE / OPENJSON.
        /// Met à jour le Dictionary avec déduplication et fusion de rôles.
        ///
        /// STUDENT (JSON_CORR):
        ///   COALESCE sur 4 chemins possibles (multi-stratégie de l'original)
        ///   Stratégie active : $.RespBody.student.* ou $.student.*
        ///
        /// GRADERS (JSON_EXAM):
        ///   OPENJSON sur studentPapersDistributions[].grader[]
        ///   WHERE grader.[key] = '0' → seulement graders[0] par distribution
        /// </summary>
        private void ExtractUtilisateursFromExam(
            DataRow sourceRow,
            Dictionary<string, UtilisateurData> utilisateurs)
        {
            string rowId = sourceRow["ROW_ID"].ToString();
            string jsonExamRaw = sourceRow["JSON_EXAM"].ToString();
            string jsonCorrRaw = sourceRow["JSON_CORR"].ToString();

            string connStrDest = BuildDestinationConnectionString();

            // ─────────────────────────────────────────────────────────────────
            // A) STUDENT depuis JSON_CORR
            // ─────────────────────────────────────────────────────────────────
            string sqlStudent = @"
                SELECT
                    -- Multi-stratégie : tenter plusieurs chemins dans l'ordre
                    COALESCE(
                        JSON_VALUE(@JsonCorr, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].student.userId'),
                        JSON_VALUE(@JsonCorr, N'$.Resp200.RespBody[0].student.userId'),
                        JSON_VALUE(@JsonCorr, N'$.RespBody.student.userId'),
                        JSON_VALUE(@JsonCorr, N'$.student.userId')
                    ) AS UserId,
                    COALESCE(
                        JSON_VALUE(@JsonCorr, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].student.firstName'),
                        JSON_VALUE(@JsonCorr, N'$.RespBody.student.firstName'),
                        JSON_VALUE(@JsonCorr, N'$.student.firstName')
                    ) AS FirstName,
                    COALESCE(
                        JSON_VALUE(@JsonCorr, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].student.lastName'),
                        JSON_VALUE(@JsonCorr, N'$.RespBody.student.lastName'),
                        JSON_VALUE(@JsonCorr, N'$.student.lastName')
                    ) AS LastName,
                    COALESCE(
                        JSON_VALUE(@JsonCorr, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].student.fullName'),
                        JSON_VALUE(@JsonCorr, N'$.RespBody.student.fullName'),
                        JSON_VALUE(@JsonCorr, N'$.student.fullName')
                    ) AS FullName,
                    COALESCE(
                        JSON_VALUE(@JsonCorr, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].student.email'),
                        JSON_VALUE(@JsonCorr, N'$.RespBody.student.email'),
                        JSON_VALUE(@JsonCorr, N'$.student.email')
                    ) AS Email;
            ";

            using (SqlConnection conn = new SqlConnection(connStrDest))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand(sqlStudent, conn))
                {
                    cmd.Parameters.Add("@JsonCorr", SqlDbType.NVarChar, -1).Value = jsonCorrRaw;

                    using (SqlDataReader rdr = cmd.ExecuteReader())
                    {
                        if (rdr.Read())
                        {
                            string userId = rdr.IsDBNull(0) ? null : rdr.GetString(0);
                            if (!string.IsNullOrEmpty(userId))
                            {
                                if (!utilisateurs.ContainsKey(userId))
                                {
                                    utilisateurs[userId] = new UtilisateurData
                                    {
                                        UserId = userId,
                                        FirstName = rdr.IsDBNull(1) ? null : rdr.GetString(1),
                                        LastName = rdr.IsDBNull(2) ? null : rdr.GetString(2),
                                        FullName = rdr.IsDBNull(3) ? null : rdr.GetString(3),
                                        Email = rdr.IsDBNull(4) ? null : rdr.GetString(4)
                                    };
                                }
                                utilisateurs[userId].Roles.Add("Etudiant");
                            }
                        }
                    }
                }
            }

            // ─────────────────────────────────────────────────────────────────
            // B) GRADERS depuis JSON_EXAM
            //    OPENJSON sur studentPapersDistributions[].grader[0]
            // ─────────────────────────────────────────────────────────────────
            string sqlGraders = @"
                SELECT
                    JSON_VALUE(grader.value, '$.userId')    AS UserId,
                    JSON_VALUE(grader.value, '$.firstName') AS FirstName,
                    JSON_VALUE(grader.value, '$.lastName')  AS LastName,
                    JSON_VALUE(grader.value, '$.fullName')  AS FullName,
                    CASE WHEN JSON_VALUE(grader.value, '$.blocked') = 'true' THEN 1 ELSE 0 END AS Blocked

                FROM OPENJSON(@JsonExam, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].studentPapersDistributions')
                     AS dist

                CROSS APPLY OPENJSON(dist.value, '$.grader') AS grader

                -- Seulement graders[0] par distribution (cohérent avec logique originale)
                WHERE grader.[key] = '0'
                  AND JSON_VALUE(grader.value, '$.userId') IS NOT NULL;
            ";

            using (SqlConnection conn = new SqlConnection(connStrDest))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand(sqlGraders, conn))
                {
                    cmd.Parameters.Add("@JsonExam", SqlDbType.NVarChar, -1).Value = jsonExamRaw;

                    using (SqlDataReader rdr = cmd.ExecuteReader())
                    {
                        while (rdr.Read())
                        {
                            string userId = rdr.IsDBNull(0) ? null : rdr.GetString(0);
                            if (string.IsNullOrEmpty(userId)) continue;

                            bool blocked = rdr.IsDBNull(4) ? false : rdr.GetInt32(4) == 1;

                            if (!utilisateurs.ContainsKey(userId))
                            {
                                utilisateurs[userId] = new UtilisateurData
                                {
                                    UserId = userId,
                                    FirstName = rdr.IsDBNull(1) ? null : rdr.GetString(1),
                                    LastName = rdr.IsDBNull(2) ? null : rdr.GetString(2),
                                    FullName = rdr.IsDBNull(3) ? null : rdr.GetString(3),
                                    Blocked = blocked
                                };
                            }
                            else
                            {
                                // Mettre à jour Blocked seulement si pas encore défini
                                if (utilisateurs[userId].Blocked == null)
                                    utilisateurs[userId].Blocked = blocked;
                            }

                            utilisateurs[userId].Roles.Add("Correcteur");
                        }
                    }
                }
            }
        }

        /// <summary>
        /// Insère un utilisateur unique dans TW_UTILISATEUR.
        /// Fusion des rôles : "Etudiant", "Correcteur", ou "Etudiant,Correcteur"
        /// </summary>
        private void InsertUtilisateur(UtilisateurData util)
        {
            string roles = string.Join(",", util.Roles.OrderBy(r => r));
            string lotETL = "RIPQUAR_" + DateTime.Now.ToString("yyyyMMdd_HHmmss");

            string insertQuery = @"
                INSERT INTO [SDGIC01].[STG].[TW_UTILISATEUR]
                (
                    TW_N_UTIL_ID,
                    TW_N_UTIL_ID_INTR,
                    TW_NM_UTIL,
                    TW_NM_PREN,
                    TW_NM_NOM,
                    TW_A_COUR,
                    TW_C_ROLE,
                    TW_I_BLOQ,
                    TW_DH_CHARG_ETL,
                    TW_C_SYST_SRCE,
                    TW_C_LOT_ETL
                )
                VALUES
                (
                    NEWID(),
                    @UserId,
                    @FullName,
                    @FirstName,
                    @LastName,
                    @Email,
                    @Roles,
                    @Blocked,
                    GETDATE(),
                    N'TestWe',
                    @LotETL
                );
            ";

            using (SqlConnection conn = new SqlConnection(BuildDestinationConnectionString()))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand(insertQuery, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", util.UserId ?? (object)DBNull.Value);
                    cmd.Parameters.AddWithValue("@FullName", util.FullName ?? (object)DBNull.Value);
                    cmd.Parameters.AddWithValue("@FirstName", util.FirstName ?? (object)DBNull.Value);
                    cmd.Parameters.AddWithValue("@LastName", util.LastName ?? (object)DBNull.Value);
                    cmd.Parameters.AddWithValue("@Email", util.Email ?? (object)DBNull.Value);
                    cmd.Parameters.AddWithValue("@Roles", roles);
                    cmd.Parameters.AddWithValue("@Blocked", util.Blocked ?? (object)DBNull.Value);
                    cmd.Parameters.AddWithValue("@LotETL", lotETL);

                    cmd.ExecuteNonQuery();
                }
            }
        }

        #region ScriptResults
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
