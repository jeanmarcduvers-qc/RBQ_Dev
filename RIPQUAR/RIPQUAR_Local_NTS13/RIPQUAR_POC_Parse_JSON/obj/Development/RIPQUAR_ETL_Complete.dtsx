                  <ProjectItem
                    Name="ScriptMain.cs"
                    Encoding="UTF8"><![CDATA[// UPDATED: Refonte OPENJSON - Suppression dépendance Newtonsoft.Json - 2026-03-30
/*
 * RIPQUAR - POC Script Task avec Variables SSIS
 * Parse JSON TestWe → STG_TW_EXAMEN
 * 
 * REFONTE: Parsing JSON déplacé du C# vers T-SQL natif (OPENJSON / JSON_VALUE)
 *          Aucune dépendance externe - Compatible migration SQL Server 2025
 * 
 * Variables SSIS requises:
 * - ServerSource (String): Serveur source GIC/Siebel
 * - BDSource (String): Base de données source
 * - ServerDest (String): Serveur destination InfoGestion
 * - BDDest (String): Base de données destination
 */

#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.Data.SqlClient;
using System.IO;
#endregion

namespace ST_ParseJSONTestWe
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private string _logFile;
        private string _scriptName;

        public void Main()
        {
            bool fireAgain = false;
            string _logDir = System.IO.Path.GetDirectoryName(Dts.Variables["User::LogFile"].Value.ToString());
            _logFile = System.IO.Path.Combine(_logDir, $"RIPQUAR_{DateTime.Now:yyyyMMdd_HHmmss}.log");
            _scriptName = Dts.Variables["System::TaskName"].Value.ToString();

            try
            {
                SafeLog($"\n=== DÉBUT {_scriptName} - {DateTime.Now} ===\n");

                Dts.Events.FireInformation(0, "POC Parse JSON", "Démarrage du POC...", "", 0, ref fireAgain);

                // Afficher les serveurs utilisés (pour debug)
                string serverSource = Dts.Variables["User::ServerSource"].Value.ToString();
                string serverDest = Dts.Variables["User::ServerDest"].Value.ToString();
                Dts.Events.FireInformation(0, "POC Parse JSON",
                    $"Source: {serverSource} → Destination: {serverDest}", "", 0, ref fireAgain);

                // 1. Nettoyer la table staging
                TruncateStagingTable();

                // 2. Récupérer les données sources avec JSON
                DataTable dtSource = GetSourceData();
                Dts.Events.FireInformation(0, "POC Parse JSON",
                    $"Récupéré {dtSource.Rows.Count} ligne(s) source", "", 0, ref fireAgain);

                // 3. Parser et charger
                int nbProcessed = 0;
                int nbErrors = 0;

                foreach (DataRow row in dtSource.Rows)
                {
                    try
                    {
                        ParseAndLoadExam(row);
                        nbProcessed++;
                    }
                    catch (Exception ex)  // ← CATCH INTERNE par ligne
                    {
                        nbErrors++;

                        string errorDetail = $"\n--- ERREUR PARSING ROW_ID: {row["ROW_ID"]} ---\n";
                        errorDetail += $"Message: {ex.Message}\n";
                        errorDetail += $"Stack: {ex.StackTrace}\n";
                        SafeLog(errorDetail);
                    }
                }

                Dts.Events.FireInformation(0, "POC Parse JSON",
                    $"Traitement terminé - Succès: {nbProcessed}, Erreurs: {nbErrors}", "", 0, ref fireAgain);

                SafeLog($"=== FIN {_scriptName} SUCCESS - {DateTime.Now} ===\n");
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                try
                {
                    string errorLog = "\n" + new string('=', 80) + "\n";
                    errorLog += $"DATE: {DateTime.Now:yyyy-MM-dd HH:mm:ss}\n";
                    errorLog += $"SCRIPT: {_scriptName}\n";
                    errorLog += $"ERREUR: {ex.Message}\n";
                    errorLog += $"\nSTACK TRACE:\n{ex.StackTrace}\n";
                    errorLog += new string('=', 80) + "\n";

                    SafeLog(errorLog);
                }
                catch { }

                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // LOGGING
        // ─────────────────────────────────────────────────────────────────────

        private void SafeLog(string message)
        {
            try
            {
                using (FileStream fs = new FileStream(_logFile, FileMode.Append, FileAccess.Write, FileShare.ReadWrite))
                using (StreamWriter sw = new StreamWriter(fs))
                {
                    sw.Write(message);
                }
            }
            catch { }
        }

        private void LogInfo(string message)
        {
            SafeLog($"[{DateTime.Now:HH:mm:ss}] {message}\n");
        }

        // ─────────────────────────────────────────────────────────────────────
        // CONNECTION STRINGS
        // ─────────────────────────────────────────────────────────────────────

        /// <summary>
        /// Construit la connection string SOURCE depuis les variables SSIS
        /// </summary>
        private string BuildSourceConnectionString()
        {
            string server = Dts.Variables["User::ServerSource"].Value.ToString();
            string database = Dts.Variables["User::BDSource"].Value.ToString();
            return $"Data Source={server};Initial Catalog={database};Integrated Security=True;";
        }

        /// <summary>
        /// Construit la connection string DESTINATION depuis les variables SSIS
        /// </summary>
        private string BuildDestinationConnectionString()
        {
            string server = Dts.Variables["User::ServerDest"].Value.ToString();
            string database = Dts.Variables["User::BDDest"].Value.ToString();
            return $"Data Source={server};Initial Catalog={database};Integrated Security=True;";
        }

        // ─────────────────────────────────────────────────────────────────────
        // STAGING : NETTOYAGE
        // ─────────────────────────────────────────────────────────────────────

        /// <summary>
        /// Vide la table staging avant chargement
        /// </summary>
        private void TruncateStagingTable()
        {
            bool fireAgain = false;
            string connString = BuildDestinationConnectionString();

            Dts.Events.FireInformation(0, "POC Parse JSON",
                "Nettoyage table staging...", "", 0, ref fireAgain);

            using (SqlConnection conn = new SqlConnection(connString))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand("DELETE FROM [SDGIC01].[STG].[TW_EXAMEN]", conn))
                {
                    int rowsDeleted = cmd.ExecuteNonQuery();
                    Dts.Events.FireInformation(0, "POC Parse JSON",
                        $"{rowsDeleted} ligne(s) supprimée(s)", "", 0, ref fireAgain);
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // EXTRACTION SOURCE
        // ─────────────────────────────────────────────────────────────────────

        /// <summary>
        /// Récupère les données sources (GIC + JSON TestWe) depuis InfoGestion
        /// </summary>
        private DataTable GetSourceData()
        {
            DataTable dt = new DataTable();
            string connString = BuildSourceConnectionString();

            string query = @"
                SELECT
                    ROW_ID,
                    PAR_ROW_ID__CXEXAMEN,
                    PAR_ROW_ID__SCONTACT,
                    CONVERT(NVARCHAR(MAX), X_GI_V_VECT_EXAM)      AS JSON_EXAM,
                    CONVERT(NVARCHAR(MAX), X_GI_V_VECT_CORR_EXAM) AS JSON_CORR,
                    CREATED,
                    LAST_UPD
                FROM [dbo].[CX_INSC_EXAM]
                WHERE X_GI_V_VECT_EXAM      IS NOT NULL
                  AND X_GI_V_VECT_CORR_EXAM IS NOT NULL
            ";

            using (SqlConnection conn = new SqlConnection(connString))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand(query, conn))
                {
                    cmd.CommandTimeout = 3600; // 60 min - table Siebel volumineuse
                    using (SqlDataAdapter adapter = new SqlDataAdapter(cmd))
                    {
                        adapter.Fill(dt);
                    }
                }
            }

            return dt;
        }

        // ─────────────────────────────────────────────────────────────────────
        // PARSING ET CHARGEMENT  — REFONTE OPENJSON (sans Newtonsoft.Json)
        // ─────────────────────────────────────────────────────────────────────

        /// <summary>
        /// Parse une ligne source et charge dans STG_TW_EXAMEN.
        /// 
        /// REFONTE: Le JSON brut est passé directement en paramètre SQL.
        ///          SQL Server effectue tout le parsing via JSON_VALUE / OPENJSON.
        ///          Aucune dépendance à Newtonsoft.Json.
        /// 
        /// Structure JSON attendue (wrapper Siebel) :
        ///   "ListOfRes107TestWeAPI:res"
        ///     → Resp200
        ///       → RespBody[0]   ← données TestWe (examen)
        ///         → examParts[0] ← 1ère partie pour flags aléatoires
        /// </summary>
        private void ParseAndLoadExam(DataRow sourceRow)
        {
            string rowId = sourceRow["ROW_ID"].ToString();
            string jsonExamRaw = sourceRow["JSON_EXAM"].ToString();

            bool fireAgain = false;
            Dts.Events.FireInformation(0, "POC Parse JSON",
                $"ROW_ID {rowId}: JSON taille = {jsonExamRaw.Length:N0} caractères", "", 0, ref fireAgain);

            string lotETL = "RIPQUAR_" + DateTime.Now.ToString("yyyyMMdd_HHmmss");
            string connString = BuildDestinationConnectionString();

            // ------------------------------------------------------------------
            // T-SQL : JSON_VALUE extrait chaque champ directement du payload.
            //
            // Chemin de base :
            //   $."ListOfRes107TestWeAPI:res".Resp200.RespBody[0]
            //   (les guillemets doubles permettent d'échapper le ":" dans la clé)
            //
            // Conversions de type :
            //   TRY_CAST     → INT / DECIMAL  (retourne NULL si invalide)
            //   TRY_CONVERT  → DATETIME style 101 = MM/dd/yyyy [HH:mm:ss]
            //
            // Logique COALESCE pour TW_C_CODE_PUBL :
            //   examCode ?? accessCode ?? publicKey  (fidèle à l'ancienne logique C#)
            //
            // Logique CASE pour flags aléatoires :
            //   NULL si examParts[0] absent, 1/0 sinon
            // ------------------------------------------------------------------
            string insertQuery = @"
                INSERT INTO [STG].[TW_EXAMEN]
                (
                    TW_N_EXAM_ID,
                    TW_C_EXAM,
                    TW_Q_DURE_SEC,
                    TW_Q_PTS_MAX,
                    TW_DH_DEBU,
                    TW_DH_FIN,
                    TW_DH_MODI,
                    TW_Q_NB_ETUD,
                    TW_Q_NB_COPI_RECU,
                    TW_Q_NB_COPI_CORR,
                    TW_C_FUSE_HORA,
                    TW_DH_CREA,
                    TW_DH_VALI,
                    TW_DH_CHARG_ETL,
                    TW_C_SYST_SRCE,
                    TW_C_STAT,
                    TW_C_CODE_PUBL,
                    TW_I_QUES_ALEA,
                    TW_I_CHOI_ALEA,
                    TW_C_LOT_ETL
                )
                SELECT
                    -- Identifiant examen TestWe
                    JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].id'),

                    -- Clé publique (code court)
                    JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].publicKey'),

                    -- Durée en secondes
                    TRY_CAST(
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].duration')
                        AS INT),

                    -- Points maximum
                    TRY_CAST(
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].maxPoints')
                        AS DECIMAL(10,2)),

                    -- Début (= createdAt dans l'ancienne logique)
                    TRY_CONVERT(DATETIME,
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].createdAt'),
                        101),

                    -- Fin (= validatedAt dans l'ancienne logique)
                    TRY_CONVERT(DATETIME,
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].validatedAt'),
                        101),

                    -- Dernière modification
                    TRY_CONVERT(DATETIME,
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].updatedAt'),
                        101),

                    -- Nombre d'étudiants
                    TRY_CAST(
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].nbStudents')
                        AS INT),

                    -- Copies reçues
                    TRY_CAST(
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].nbCopiesReceived')
                        AS INT),

                    -- Copies corrigées
                    TRY_CAST(
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].nbCopiesCorrected')
                        AS INT),

                    -- Fuseau horaire
                    JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].timezone'),

                    -- Date création (TW_DH_CREA)
                    TRY_CONVERT(DATETIME,
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].createdAt'),
                        101),

                    -- Date validation (TW_DH_VALI)
                    TRY_CONVERT(DATETIME,
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].validatedAt'),
                        101),

                    -- Horodatage ETL
                    GETDATE(),

                    -- Système source (constant)
                    N'TestWe',

                    -- Statut de l'examen : tenter plusieurs noms de champs possibles
                    -- TW_C_STAT était 100% NULL → le champ 'status' n'existe pas ou est nommé autrement
                    COALESCE(
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].status'),
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].examStatus'),
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].state'),
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].examState')
                    ),

                    -- Code public : examCode ?? accessCode ?? publicKey
                    COALESCE(
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].examCode'),
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].accessCode'),
                        JSON_VALUE(@Json, N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].publicKey')
                    ),

                    -- Questions aléatoires (NULL si examParts absent, 1/0 sinon)
                    CASE
                        WHEN JSON_VALUE(@Json,
                             N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].examParts[0].randomPartIndexes')
                             IS NULL THEN NULL
                        WHEN JSON_VALUE(@Json,
                             N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].examParts[0].randomPartIndexes')
                             = N'true' THEN 1
                        ELSE 0
                    END,

                    -- Choix aléatoires : randomizeChoices OR shuffleAnswers
                    CASE
                        WHEN JSON_VALUE(@Json,
                             N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].examParts[0].randomizeChoices')
                             IS NULL
                         AND JSON_VALUE(@Json,
                             N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].examParts[0].shuffleAnswers')
                             IS NULL THEN NULL
                        WHEN JSON_VALUE(@Json,
                             N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].examParts[0].randomizeChoices')
                             = N'true'
                          OR JSON_VALUE(@Json,
                             N'$.""ListOfRes107TestWeAPI:res"".Resp200.RespBody[0].examParts[0].shuffleAnswers')
                             = N'true' THEN 1
                        ELSE 0
                    END,

                    -- Identifiant du lot ETL
                    @LotETL;
            ";

            using (SqlConnection conn = new SqlConnection(connString))
            {
                conn.Open();
                using (SqlCommand cmd = new SqlCommand(insertQuery, conn))
                {
                    // JSON brut passé en paramètre — SQL Server fait tout le parsing
                    cmd.Parameters.Add("@Json", SqlDbType.NVarChar, -1).Value = jsonExamRaw;
                    cmd.Parameters.Add("@LotETL", SqlDbType.NVarChar, 50).Value = lotETL;

                    cmd.ExecuteNonQuery();
                }
            }
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
