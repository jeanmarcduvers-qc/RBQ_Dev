          SQLTask:SqlStatementSource="SELECT &#xA;    MAX(CASE WHEN CD_PARAM = 'EnvoyePar'       AND CD_SYSTEM = 'COMMUN'  THEN VALEUR_PARM END) AS EnvoyePar,&#xA;    MAX(CASE WHEN CD_PARAM = 'SmtpServer'      AND CD_SYSTEM = 'COMMUN'  THEN VALEUR_PARM END) AS SmtpServer,&#xA;    MAX(CASE WHEN CD_PARAM = 'EnvoisCourrielA' AND CD_SYSTEM = 'RIPQUAR' THEN VALEUR_PARM END) AS EnvoisCourrielA&#xA;FROM [SDEXT01].[CFG].[CFG_CONFIG_PARM]&#xA;WHERE IND_ACTIF = 'O'&#xA;  AND (&#xA;        (CD_PARAM IN ('EnvoyePar', 'SmtpServer') AND CD_SYSTEM = 'COMMUN')&#xA;     OR (CD_PARAM = 'EnvoisCourrielA'            AND CD_SYSTEM = 'RIPQUAR')&#xA;      );"
