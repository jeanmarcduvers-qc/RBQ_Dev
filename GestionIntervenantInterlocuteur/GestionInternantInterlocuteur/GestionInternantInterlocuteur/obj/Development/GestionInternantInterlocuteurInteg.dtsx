        public const string tblIntervenant = "SELECT inter.[GI3_C_ROWD_INTRVN] " +
                                                      ",inter.[GI3_C_INTRVN] " +
                                                      ",inter.[GI3_N_NEQ]  " +
                                                      ",inter.[GI3_NM_INTRVN] " +
                                                      ",iif(inter2.[GI3_C_ROWD_INTRVN] is null, 'Insert', 'Update') as Action " +
                                                "FROM [SDGIC01].[dbo].[GI3_INTERVENANT] inter " +
                                                       "left join [SDDMU01].[dbo].[GIC_GI3_INTERVENANT] inter2 on inter2.[GI3_C_ROWD_INTRVN] = inter.[GI3_C_ROWD_INTRVN] " +
                                                "WHERE  not exists(select 1 " +
                                                                  "FROM   [SDDMU01].[dbo].[GIC_GI3_INTERVENANT] inter3 " +
                                                                  "where  inter3.[GI3_C_ROWD_INTRVN] = inter.[GI3_C_ROWD_INTRVN] " +
                                                                  "and    isnull(inter3.[GI3_C_INTRVN], '') = isnull(inter.[GI3_C_INTRVN], '') " +
                                                                  "and    isnull(inter3.[GI3_N_NEQ], '') = isnull(inter.[GI3_N_NEQ], '') " +
                                                                  "and    replace(inter3.[GI3_NM_INTRVN],'''', '`') = replace(inter.[GI3_NM_INTRVN],'''', '`'))";

        public const string tblInterlocuteur = "SELECT inter.[GI3_C_ROWD_INTRL] " +
                                                      ",inter.[GI3_N_INTRL] " +
                                                      ",inter.[GI3_NM_FAML] " +
                                                      ",inter.[GI3_NM_PREN_INTRL] " +
                                                      ",inter.[GI3_D_NAIS] " +
                                                      ",iif(inter2.[GI3_C_ROWD_INTRL] is null, 'Insert', 'Update') as Action " +
                                                  "FROM [SDGIC01].[dbo].[GI3_INTERLOCUTEUR] inter " +
                                                        "left join[SDDMU01].[dbo].[GIC_GI3_INTERLOCUTEUR] inter2 on inter2.[GI3_C_ROWD_INTRL] = inter.[GI3_C_ROWD_INTRL] " +
                                                  "WHERE  not exists(select 1 " +
                                                                    "FROM   [SDDMU01].[dbo].[GIC_GI3_INTERLOCUTEUR] inter3 " +
                                                                    "where  inter3.[GI3_C_ROWD_INTRL] = inter.[GI3_C_ROWD_INTRL] " +
                                                                    "and isnull(inter3.[GI3_N_INTRL], '') = isnull(inter.[GI3_N_INTRL], '') " +
                                                                    "and replace(inter3.[GI3_NM_FAML],'''', '`') = replace(inter.[GI3_NM_FAML],'''', '`') " +
                                                                    "and replace(inter3.[GI3_NM_PREN_INTRL],'''', '`') = replace(inter.[GI3_NM_PREN_INTRL],'''', '`') " +
                                                                    "and isnull(inter3.[GI3_D_NAIS], '') = isnull(inter.[GI3_D_NAIS], ''))";

        public const string inserttIntervenant = "insert into GI3_INTERVENANT (GI3_C_ROWD_INTRVN, GI3_C_INTRVN, GI3_N_NEQ, GI3_NM_INTRVN) values( '%1', '%2', '%3', '%4') ";
