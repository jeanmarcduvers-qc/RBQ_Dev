        public const string updtIntervenant = "UPDATE GI3_INTERVENANT " +
                                                "SET GI3_C_INTRVN = '%2', " +
                                                    "GI3_N_NEQ = '%3', " +
                                                    "GI3_NM_INTRVN = '%4' " +
