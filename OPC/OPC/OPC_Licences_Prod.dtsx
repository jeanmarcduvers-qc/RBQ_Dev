                        SqlCommand SQLCommandLog = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                        SQLCommandLog.CommandType = CommandType.Text;
                        SQLCommandLog.ExecuteNonQuery();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("InsertTableLogChargement()", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Job_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogJob(string pFonction, string pErreurMessage)
            {
                int lParametreErreurMessage;
                pErreurMessage = pErreurMessage.Replace("'", "''");
                lParametreErreurMessage = pErreurMessage.Length;

                if (pErreurMessage.Length > 250)
                {
                    pErreurMessage = pErreurMessage.Substring(0, 245);
                    pErreurMessage = pErreurMessage + "...";
                }

                string sqlInsCmd = "insert into [SDEXT01].[CFG].[Log_Job_Connecteur] values('TraiteOPC', 'CCQ', null, '" + pFonction + "', 'Erreur', '" + pErreurMessage + "', 'CCQ', GETDATE())";

                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerBD_OPC))
                    {
                        mySQLConnection.Open();
                        SqlCommand SQLCommandJob = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                        SQLCommandJob.CommandType = CommandType.Text;
                        SQLCommandJob.ExecuteNonQuery();
                        blErreurExecution = true;
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogChargement("ERR", "Impossible d'insérer dans Log_Job_Connecteur");
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Compresse les fichiers CSV
            ///
            /////////////////////////////////////////////////////////////////////
            void ZipFichier(string dossierSource, string dossierDestination)
            {
                try
                {
                    string zipDestination = dossierDestination + strZipFileNameLicences;

                    if (File.Exists(zipDestination))
                    {
                        // Si le fichier existe le détruire
                        File.Delete(zipDestination);
                    }
                    using (ZipArchive zip = ZipFile.Open(zipDestination, ZipArchiveMode.Create)) 
                    { 
                        foreach (string fichier in Directory.GetFiles(dossierSource, "*.csv")) 
                        { 
                            string nomDansZip = Path.GetFileName(fichier); 
                            zip.CreateEntryFromFile(fichier, nomDansZip); 
                        } 
                    }


                    string folder = dossierSource;

                    foreach (string file in Directory.GetFiles(folder, "*.csv"))
                    {
                        File.Delete(file);
                    }
                }

                catch (IOException ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ZipFichier()", ex.Message.ToString());
                }
            }
            //////////////////////////////////////////////////////////////////////
            ///
            //     Archive le fichier
            ///
            /////////////////////////////////////////////////////////////////////
            void ArchiveFichier(string dossierSource, string dossierDestination, bool supprimeFichier)
            {
                string strdossierSource = dossierSource + strZipFileNameLicences;
                string strdossierDestination = dossierDestination + strZipFileNameLicences;

                try
                {
                    string destinationFolder = Path.GetDirectoryName(strdossierDestination); 
                    if (!Directory.Exists(destinationFolder)) 
                    { 
                        Directory.CreateDirectory(destinationFolder); 
                    }

                    System.IO.File.Copy(strdossierSource, strdossierDestination, true);

                    if (supprimeFichier)
                    {
                        SupprimeFichier(strdossierSource);
                    }
                }

                catch (IOException ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ArchiveFichier()", ex.Message.ToString());
                }
            }
            //////////////////////////////////////////////////////////////////////
            ///
            //     Supprime le fichier
            ///
            /////////////////////////////////////////////////////////////////////
            void SupprimeFichier(string strFchier)
            {
                try
                {
                    if (System.IO.File.Exists(strFchier))
                    {
                        System.IO.File.SetAttributes(strFchier, FileAttributes.Archive);
                        System.IO.File.Delete(strFchier);
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("SupprimeFichier()", ex.Message.ToString());
                }
            }


            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute une instruction SQL
            ///
            /////////////////////////////////////////////////////////////////////
            void ExecuteSQL(string strCodeTraitement, string strSqlRequete)
            {
                string sqlCmd = strSqlRequete.ToString();

                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerBD_OPC))
                    {
                        mySQLConnection.Open();
                        using (var transaction = mySQLConnection.BeginTransaction())
                        {
                            SqlCommand SQLCommandExec = new SqlCommand(sqlCmd.ToString(), mySQLConnection, transaction);
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.ExecuteNonQuery();
                            transaction.Commit();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJob("ExecuteSQL(" + strCodeTraitement + ")", ex.Message.ToString());
                    blErreurExecution = true;
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Envois courriel
            ///
            /////////////////////////////////////////////////////////////////////
            void Email_Send()
            {
                String SQLString = tblAfficheErreur.ToString();
                String EnvoisCourrielPar = EnvoyePar.ToString();
                String EnvoisCourrielA = strEnvoisCourrielA;
                String EnvoisCourrielSuject = "L'application (TraiteOPC) a une ou des erreurs d'exécutions. ";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine +
                                             "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";

                string strpath = ""; // yves strCheminRejet + "Rejets_" + dtTraitementSSIS.ToString("yyyy_MM_dd") + ".csv";

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();
                System.Net.Mail.Attachment fileAttachment = null;

                String SmtpServer = FindConfigParm("COMMUN", "SmtpServer");

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    if (File.Exists(strpath))
                    {
                        fileAttachment = new System.Net.Mail.Attachment(strpath);

                        //Ajout de l'attachements
                        FormatCourrielHtml.Attachments.Add(fileAttachment);
                    }

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("SendMail()", ex.Message.ToString());
                }
            }
        }
        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
