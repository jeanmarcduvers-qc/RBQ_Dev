          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Help:  Introduction to the script task
/* The Script Task allows you to perform virtually any operation that can be accomplished in
 * a .Net application within the context of an Integration Services control flow. 
 * 
 * Expand the other regions which have "Help" prefixes for examples of specific ways to use
 * Integration Services features within this script task. */
#endregion


#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.Data.SqlClient;
using System.IO;
using System.IO.Compression;
using System.Net.Mail;
using System.Linq;
using System.Text;
#endregion

namespace ST_e6a2da0a20464cd4b9edd8aadac48281
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
	[Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
	public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
	{
        #region Help:  Using Integration Services variables and parameters in a script
        /* To use a variable in this script, first ensure that the variable has been added to 
         * either the list contained in the ReadOnlyVariables property or the list contained in 
         * the ReadWriteVariables property of this script task, according to whether or not your
         * code needs to write to the variable.  To add the variable, save this script, close this instance of
         * Visual Studio, and update the ReadOnlyVariables and 
         * ReadWriteVariables properties in the Script Transformation Editor window.
         * To use a parameter in this script, follow the same steps. Parameters are always read-only.
         * 
         * Example of reading from a variable:
         *  DateTime startTime = (DateTime) Dts.Variables["System::StartTime"].Value;
         * 
         * Example of writing to a variable:
         *  Dts.Variables["User::myStringVariable"].Value = "new value";
         * 
         * Example of reading from a package parameter:
         *  int batchId = (int) Dts.Variables["$Package::batchId"].Value;
         *  
         * Example of reading from a project parameter:
         *  int batchId = (int) Dts.Variables["$Project::batchId"].Value;
         * 
         * Example of reading from a sensitive project parameter:
         *  int batchId = (int) Dts.Variables["$Project::batchId"].GetSensitiveValue();
         * */

        #endregion

        #region Help:  Firing Integration Services events from a script
        /* This script task can fire events for logging purposes.
         * 
         * Example of firing an error event:
         *  Dts.Events.FireError(18, "Process Values", "Bad value", "", 0);
         * 
         * Example of firing an information event:
         *  Dts.Events.FireInformation(3, "Process Values", "Processing has started", "", 0, ref fireAgain)
         * 
         * Example of firing a warning event:
         *  Dts.Events.FireWarning(14, "Process Values", "No values received for input", "", 0);
         * */
        #endregion

        #region Help:  Using Integration Services connection managers in a script
        /* Some types of connection managers can be used in this script task.  See the topic 
         * "Working with Connection Managers Programatically" for details.
         * 
         * Example of using an ADO.Net connection manager:
         *  object rawConnection = Dts.Connections["Sales DB"].AcquireConnection(Dts.Transaction);
         *  SqlConnection myADONETConnection = (SqlConnection)rawConnection;
         *  //Use the connection in some code here, then release the connection
         *  Dts.Connections["Sales DB"].ReleaseConnection(rawConnection);
         *
         * Example of using a File connection manager
         *  object rawConnection = Dts.Connections["Prices.zip"].AcquireConnection(Dts.Transaction);
         *  string filePath = (string)rawConnection;
         *  //Use the connection in some code here, then release the connection
         *  Dts.Connections["Prices.zip"].ReleaseConnection(rawConnection);
         * */
        #endregion


        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        public string strServerSDEXT01 = " Server=W367P002RPT1,60800;Database=SDEXT01;Integrated Security=True;";
        public string strServerBD_OPC = "";
        public DateTime dtTraitementSSIS = DateTime.Now.Date;
        public int nbRowLicencesActives = 0;
        public int nbRowHistoNomEntrepreneur = 0;
        public int nbRowDirigeantsIntervenants = 0;
        public int nbRowHistoAdresseEntrepreneur = 0;
        public int nbRowAutresNoms = 0;
        public int nbRowCategorieHabilitation = 0;
        public int nbRowCtrlHebdo = 0;

        public const string delLogChargement = "DELETE [SDEXT01].[CFG].[Log_Chargement_Connecteur] where Application = 'TraiteOPC'";
        public const string delLogJobChargement = "DELETE [SDEXT01].[CFG].[Log_Job_Connecteur] where Application = 'TraiteOPC'";
        public const string tblAfficheErreur = "SELECT * FROM [SDEXT01].[CFG].[Log_Job_Connecteur] where Application = 'TraiteOPC'";


        public string newLine = Environment.NewLine;
        public bool blErreurExecution = false;

        public void Main()
        {
            try
            {
                TraiteOPC();

            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Script Task", ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }

            Dts.TaskResult = (int)ScriptResults.Success;
        }

        public void TraiteOPC()
        {
            // Récupére les paramêtres
            strServerBD_OPC = FindConfigParm("OPC_ETL", "ServerBD_OPC");
            string strServerBD_SIEBEL = FindConfigParm("OPC_ETL", "ServerBD_SIEBEL");
            string EnvoyePar = FindConfigParm("COMMUN", "EnvoyePar");
            string strEnvoisCourrielA = FindConfigParm("OPC_ETL", "EnvoisCourrielA");
            string strCheminOut = FindConfigParm("OPC_ETL", "RepertoireOut");
            string strCheminFchArch = FindConfigParm("OPC_ETL", "RepertoireArchive");
            string strZipFileNameLicences = FindConfigParm("OPC_ETL", "ZipFileNameLicences") + dtTraitementSSIS.ToString("yyyyMMdd") + ".zip";




            string[] lines = new string[0];

            if (blErreurExecution != true)
            {
                // delete l'historique du dernier log de chargement
                // DeleteTableLogChargement();
                ExecuteSQL("OPC", delLogJobChargement);

                InsertTableLogChargement("TraiteOPC", "Début du traitement");

                try
                {
                    // Licences actives, terminées, suspendues et annulées
                    TraiteLicences();

                    // Histo des noms d'entrepreneurs
                    HistoNomEntrepreneur();

                    // Dirigeants et intervenants
                    DirigeantsIntervenants();

                    // Historique des adresses entrepreneurs
                    HistoAdresseEntrepreneur();

                    // Autres noms
                    AutresNoms();

                    // Categories et habilitations
                    CategorieHabilitation();

                    // Fichier de contrôle
                    CtrlHebdo();

                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("TraiteOPC()", ex.Message.ToString());
                }
            }

            if (blErreurExecution)
            {
                Email_Send();
            }

            if ((strZipFileNameLicences.ToString() != "") && (!blErreurExecution))
            {
                ZipFichier(strCheminOut, strCheminOut);
                ArchiveFichier(strCheminOut, strCheminFchArch, false);
            }

            InsertTableLogChargement("TraiteOPC", "Fin du traitement");


            ////////////////////////////////////////////////////////////////////////
            ///
            //     Traite licences actives, terminées, suspendues et annulées
            ///
            ///////////////////////////////////////////////////////////////////////
            void TraiteLicences()
            {
                string sqlCmd = @"SELECT lic.AGREE_NUM			AS NoLicence 
								        ,lic.STAT_CD            AS Statut
										,suivi.X_RAISON_FIN     AS Raison
										,suivi.X_GI_C_SOUS_RAIS_FIN AS SousRaison
										,CONVERT(varchar(10), suivi.EFF_START_DT, 23)     AS DateDebutEffective
										,CONVERT(varchar(10), suivi.EFF_END_DT, 23)       AS DateFinEffective
	                                    ,interv.NAME			AS NomEntrepreneur 
	                                    ,juri.VAL				AS FormeJuridique 
                                        ,a2.ADDR_NUM			AS NoCivique 
                                        ,artere.VAL				AS TypeArtere 
                                        ,a2.ADDR				AS NomRue 
                                        ,a2.ADDR_LINE_3			AS NoAppartement 
                                        ,a2.CITY				AS Municipalite 
                                        ,prov.NAME				AS Province 
                                        ,a2.COUNTRY				AS Pays 
                                        ,a2.ZIPCODE				AS CodePostal 
	                                    ,CAST(FORMAT(lic.APPR_DT,'yyyy-MM-dd') AS VARCHAR(10))			AS DateDelivrance
	                                    , con.LAST_NAME + ' ' + con.FST_NAME as Repondant
	                                    ,lic.X_CATEGORIE            AS Categorie
	                                    ,interv.X_NEQ			AS NEQ 
                                    FROM  [siebeldb].[dbo].S_ORG_EXT interv 
                                            INNER JOIN  [siebeldb].[dbo].S_DOC_AGREE lic ON interv.ROW_ID = lic.TARGET_OU_ID AND lic.AGREE_CD = 'Entrepreneur' 
                                            INNER JOIN  [siebeldb].[dbo].S_ENTLMNT suivi ON suivi.ROW_ID = lic.X_PR_ENTLMNT_ID AND (suivi.X_RAISON_FIN is null or suivi.X_RAISON_FIN NOT IN ('Erreur administrative'))
                                            LEFT OUTER JOIN  [siebeldb].[dbo].S_CON_ADDR a1 ON interv.ROW_ID = a1.ACCNT_ID AND a1.ADDR_TYPE_CD = 'Principale' AND a1.END_DT IS NULL 
	                                        LEFT OUTER JOIN  [siebeldb].[dbo].S_CONTACT con on con.ROW_ID = lic.X_REP_MAS_ID
	                                        INNER JOIN  [siebeldb].[dbo].S_ADDR_PER a2 ON a1.ADDR_PER_ID = a2.ROW_ID 
                                            LEFT OUTER JOIN  [siebeldb].[dbo].S_LST_OF_VAL artere ON a2.X_ARTERE = artere.NAME AND artere.TYPE = 'ADDR_ARTERE'  
	                                        LEFT OUTER JOIN  [siebeldb].[dbo].S_LST_OF_VAL prov ON a2.STATE = prov.NAME AND prov.TYPE = 'RBQ_ADR_PROV' 
	                                        LEFT OUTER JOIN  [siebeldb].[dbo].S_LST_OF_VAL juri ON interv.OU_TYPE_CD = juri.NAME AND juri.TYPE = 'ACCOUNT_TYPE' AND juri.LANG_ID = 'FRA' 
								    ORDER BY lic.AGREE_NUM ASC  ";

                try
                {
                    nbRowLicencesActives = CreerCSV(sqlCmd, "Licences_");
                    UpdateCtrl("Licences_" + dtTraitementSSIS.ToString("yyyy_MM_dd") + ".csv", "Liste des licences actives, inactives et autres statuts", nbRowLicencesActives);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "TraiteLicences()");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Histo des noms d'entrepreneurs
            ///
            ///////////////////////////////////////////////////////////////////////
            void HistoNomEntrepreneur()
            {
                string sqlCmd = @"Select t.NoLicence, t.DateChangement, REPLACE(t.EntrepreneurHisto, CHAR(9), '') as EntrepreneurHisto 
                                  from   (SELECT lic.AGREE_NUM			AS NoLicence,
                                                CONVERT(varchar(10), histo.LAST_UPD, 23) AS DateChangement,
	                                            CASE 
			                                        WHEN RIGHT(histo.AUDIT_LOG, CHARINDEX('*', REVERSE(histo.AUDIT_LOG)) - 1) = '' 
			                                        THEN RIGHT(
					                                        LEFT(histo.AUDIT_LOG, LEN(histo.AUDIT_LOG) - CHARINDEX('*', REVERSE(histo.AUDIT_LOG)) - 1) ,
					                                        CHARINDEX('*', REVERSE(LEFT(histo.AUDIT_LOG, LEN(histo.AUDIT_LOG) - CHARINDEX('*', REVERSE(histo.AUDIT_LOG)) - 1))) -1
				                                            )
			                                        ELSE RIGHT(histo.AUDIT_LOG, CHARINDEX('*', REVERSE(histo.AUDIT_LOG)) - 1)
		                                        END AS	EntrepreneurHisto
                                        FROM  [siebeldb].[dbo].S_ORG_EXT interv 
                                                INNER JOIN  [siebeldb].[dbo].S_DOC_AGREE lic ON interv.ROW_ID = lic.TARGET_OU_ID AND lic.AGREE_CD = 'Entrepreneur' 
                                                INNER JOIN  [siebeldb].[dbo].S_ENTLMNT suivi ON suivi.ROW_ID = lic.X_PR_ENTLMNT_ID AND (suivi.X_RAISON_FIN is null or suivi.X_RAISON_FIN NOT IN ('Erreur administrative'))
											    JOIN  [siebeldb].[dbo].[S_AUDIT_ITEM] histo ON histo.TBL_RECORD_ID = interv.ROW_ID and histo.TBL_NAME = 'S_ORG_EXT' and   histo.AUDIT_LOG like '%NAME%'
											    where histo.AUDIT_LOG not like '%No Match Row%'
								        ) t 
									where t.EntrepreneurHisto not in ('0', '')
									order by 1    ";

                try
                {
                    nbRowHistoNomEntrepreneur = CreerCSV(sqlCmd, "HistoNomEntrepreneur_");
                    UpdateCtrl("HistoNomEntrepreneur_" + dtTraitementSSIS.ToString("yyyy_MM_dd") + ".csv", "Historique des noms d'entrepreneurs", nbRowHistoNomEntrepreneur);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "HistoNomEntrepreneur()");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Dirigeants et Intervenants
            ///
            ///////////////////////////////////////////////////////////////////////
            void DirigeantsIntervenants()
            {
                string sqlCmd = @"SELECT lic.AGREE_NUM			AS NoLicence
								           ,rel.REL_TYPE_CD as Role
								           ,rel.X_FONTION_CD as Fonction
								           ,cont.FST_NAME as Prenom
								           ,cont.LAST_NAME as Nom
								           ,CAST(CAST(rel.PERCENT_OWNED AS int) AS varchar(10)) + '%' AS PourcAction
							               ,CONVERT(varchar(10), rel.START_DT, 23) as DateDebut
							               ,CONVERT(varchar(10), rel.END_DT, 23) as DateFin
							               ,rel.X_RAISON_FIN as RaisonFin 
								           ,a2.ADDR_NUM			AS NoCivique 
                                           ,artere.VAL			AS TypeArtere 
                                           ,a2.ADDR				AS NomRue 
                                           ,a2.ADDR_LINE_3		AS NoAppartement 
                                           ,a2.CITY				AS Municipalite 
                                           ,prov.NAME			AS Province 
                                           ,a2.COUNTRY			AS Pays 
                                           ,a2.ZIPCODE			AS CodePostal 
                                            FROM  [siebeldb].[dbo].S_ORG_EXT interv 
                                                    INNER JOIN  [siebeldb].[dbo].S_DOC_AGREE lic ON interv.ROW_ID = lic.TARGET_OU_ID AND lic.AGREE_CD = 'Entrepreneur' 
                                                    INNER JOIN  [siebeldb].[dbo].S_ENTLMNT suivi ON suivi.ROW_ID = lic.X_PR_ENTLMNT_ID AND (suivi.X_RAISON_FIN is null or suivi.X_RAISON_FIN NOT IN ('Erreur administrative'))
											        JOIN   [siebeldb].[dbo].S_PARTY_REL rel ON rel.PARTY_ID = interv.ROW_ID
											        JOIN  [siebeldb].[dbo].S_CONTACT cont on cont.ROW_ID = rel.REL_PARTY_ID and (rel.X_RAISON_FIN not like '%Erreur%' and upper(cont.LAST_NAME) not like '%DOUBLON%' and upper(cont.LAST_NAME) not like '%ANNULÉ%')
											        INNER JOIN  [siebeldb].[dbo].S_ADDR_PER a2 ON a2.ROW_ID  = cont.PR_PER_ADDR_ID
                                                    LEFT OUTER JOIN  [siebeldb].[dbo].S_LST_OF_VAL artere ON a2.X_ARTERE = artere.NAME AND artere.TYPE = 'ADDR_ARTERE'  
	                                                LEFT OUTER JOIN  [siebeldb].[dbo].S_LST_OF_VAL prov ON a2.STATE = prov.NAME AND prov.TYPE = 'RBQ_ADR_PROV' 
								            ORDER BY lic.AGREE_NUM ASC   ";

                try
                {
                    nbRowDirigeantsIntervenants = CreerCSV(sqlCmd, "DirigeantsIntervenants_");
                    UpdateCtrl("DirigeantsIntervenants_" + dtTraitementSSIS.ToString("yyyy_MM_dd") + ".csv", "Historique des dirigeants et des intervenants", nbRowDirigeantsIntervenants);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "DirigeantsIntervenants()");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Histo des adresses d'entrepreneurs
            ///
            ///////////////////////////////////////////////////////////////////////
            void HistoAdresseEntrepreneur()
            {
                string sqlCmd = @"SELECT lic.AGREE_NUM			AS NoLicence 
                                        ,a2.ADDR_NUM			AS NoCivique 
                                        ,artere.VAL				AS TypeArtere 
                                        ,a2.ADDR				AS NomRue 
                                        ,a2.ADDR_LINE_3			AS NoAppartement 
                                        ,a2.CITY				AS Municipalite 
                                        ,prov.NAME				AS Province 
                                        ,a2.COUNTRY				AS Pays 
                                        ,a2.ZIPCODE				AS CodePostal 
										,CAST(FORMAT(a1.START_DT,'yyyy-MM-dd') AS VARCHAR(10))			AS DateDebut
	                                    ,CAST(FORMAT(a1.END_DT,'yyyy-MM-dd') AS VARCHAR(10))			AS DateFin
                                    FROM  [siebeldb].[dbo].S_ORG_EXT interv 
                                            INNER JOIN  [siebeldb].[dbo].S_DOC_AGREE lic ON interv.ROW_ID = lic.TARGET_OU_ID AND lic.AGREE_CD = 'Entrepreneur' 
                                            INNER JOIN  [siebeldb].[dbo].S_ENTLMNT suivi ON suivi.ROW_ID = lic.X_PR_ENTLMNT_ID AND (suivi.X_RAISON_FIN is null or suivi.X_RAISON_FIN NOT IN ('Erreur administrative'))
                                            LEFT OUTER JOIN  [siebeldb].[dbo].S_CON_ADDR a1 ON interv.ROW_ID = a1.ACCNT_ID AND a1.ADDR_TYPE_CD = 'Principale' AND a1.END_DT IS NOT NULL 
	                                        LEFT OUTER JOIN  [siebeldb].[dbo].S_CONTACT con on con.ROW_ID = lic.X_REP_MAS_ID
	                                        INNER JOIN  [siebeldb].[dbo].S_ADDR_PER a2 ON a1.ADDR_PER_ID = a2.ROW_ID 
                                            LEFT OUTER JOIN  [siebeldb].[dbo].S_LST_OF_VAL artere ON a2.X_ARTERE = artere.NAME AND artere.TYPE = 'ADDR_ARTERE'  
	                                        LEFT OUTER JOIN  [siebeldb].[dbo].S_LST_OF_VAL prov ON a2.STATE = prov.NAME AND prov.TYPE = 'RBQ_ADR_PROV' 
	                                        LEFT OUTER JOIN  [siebeldb].[dbo].S_LST_OF_VAL juri ON interv.OU_TYPE_CD = juri.NAME AND juri.TYPE = 'ACCOUNT_TYPE' AND juri.LANG_ID = 'FRA' 
								    ORDER BY lic.AGREE_NUM ASC, a1.START_DT ASC  ";

                try
                {
                    nbRowHistoAdresseEntrepreneur = CreerCSV(sqlCmd, "HistoAdresseEntrepreneur_");
                    UpdateCtrl("HistoAdresseEntrepreneur_" + dtTraitementSSIS.ToString("yyyy_MM_dd") + ".csv", "Historique des adresses entrepreneurs", nbRowHistoAdresseEntrepreneur);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "HistoAdresseEntrepreneur()");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Autres noms
            ///
            ///////////////////////////////////////////////////////////////////////
            void AutresNoms()
            {
                string sqlCmd = @"SELECT lic.AGREE_NUM			AS NoLicence 
                                        ,org.X_AUTRE_NOM as AutreNom
										,org.X_TYPE_NOM as TypeNom
										,CASE 
											WHEN interv.PR_SYN_ID = org.ROW_ID THEN 'O'
											ELSE 'N'
										END AS Principal
										,CAST(FORMAT(org.X_DATE_DEBUT,'yyyy-MM-dd') AS VARCHAR(10))			AS DateDebut
	                                    ,CAST(FORMAT(org.X_DATE_FIN,'yyyy-MM-dd') AS VARCHAR(10))			AS DateFin
                                    FROM  [siebeldb].[dbo].S_ORG_EXT interv 
                                            INNER JOIN  [siebeldb].[dbo].S_DOC_AGREE lic ON interv.ROW_ID = lic.TARGET_OU_ID AND lic.AGREE_CD = 'Entrepreneur' 
                                            INNER JOIN  [siebeldb].[dbo].S_ENTLMNT suivi ON suivi.ROW_ID = lic.X_PR_ENTLMNT_ID AND (suivi.X_RAISON_FIN is null or suivi.X_RAISON_FIN NOT IN ('Erreur administrative'))
                                            JOIN  [siebeldb].[dbo].S_ORG_SYN org ON  org.OU_ID = interv.ROW_ID 
								    ORDER BY lic.AGREE_NUM ASC, org.X_DATE_FIN, org.X_DATE_DEBUT  ";

                try
                {
                    nbRowAutresNoms = CreerCSV(sqlCmd, "AutresNoms_");
                    UpdateCtrl("AutresNoms_" + dtTraitementSSIS.ToString("yyyy_MM_dd") + ".csv", "Historique des autres noms", nbRowAutresNoms);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "AutresNoms()");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Catégories et habilitations
            ///
            ///////////////////////////////////////////////////////////////////////
            void CategorieHabilitation()
            {
                string sqlCmd = @"SELECT lic.AGREE_NUM			AS NoLicence
	                                    ,lic.X_CATEGORIE		AS Categorie
	                                    ,prod.NAME				AS SousCatégorie
	                                    ,prod.DESC_TEXT			AS DescriptionSousCatégorie
	                                    ,item.X_STATUS_CD       AS Statut
                                    FROM [siebeldb].[dbo].S_ORG_EXT interv
                                    INNER JOIN [siebeldb].[dbo].S_DOC_AGREE lic ON interv.ROW_ID = lic.TARGET_OU_ID AND lic.AGREE_CD = 'Entrepreneur'
                                    INNER JOIN [siebeldb].[dbo].S_ENTLMNT suivi ON suivi.ROW_ID = lic.X_PR_ENTLMNT_ID  AND (suivi.X_RAISON_FIN IS NULL OR suivi.X_RAISON_FIN NOT IN ('Erreur administrative'))
                                    INNER JOIN [siebeldb].[dbo].S_ENTLMNT_ITEM item ON suivi.ROW_ID = item.DOC_AGREE_ID
                                    INNER JOIN [siebeldb].[dbo].S_PROD_INT prod ON item.PROD_INT_ID = prod.ROW_ID AND prod.NAME NOT IN ('ADM', 'GPC', 'GPCCOP', 'SECCOP',  'SEC')
                                    ORDER BY
	                                    lic.AGREE_NUM ASC,
	                                    prod.NAME ASC   ";

                try
                {
                    nbRowCategorieHabilitation = CreerCSV(sqlCmd, "CategorieHabilitation_");
                    UpdateCtrl("CategorieHabilitation_" + dtTraitementSSIS.ToString("yyyy_MM_dd") + ".csv", "Catégories et Sous-catégories", nbRowCategorieHabilitation);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "CategorieHabilitation()");
                }
            }

