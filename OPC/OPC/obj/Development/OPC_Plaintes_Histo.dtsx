        public string strServerSDEXT01 = " Server=W367I002RPT1,60800;Database=SDEXT01;Integrated Security=True;";
        public string strServerBD = "";
        public string strClientEmpNo = "";
        public DateTime dtTraitementSSIS = DateTime.Now.Date;
        public string fichierArchive = "";

        public const string delLogChargement = "DELETE [SDEXT01].[CFG].[Log_Chargement_Connecteur] where Application = 'TraiteOPC'";
        public const string delLogJobChargement = "DELETE [SDEXT01].[CFG].[Log_Job_Connecteur] where Application = 'TraiteOPC'";
        public const string tblAfficheErreur = "SELECT * FROM [SDEXT01].[CFG].[Log_Job_Connecteur] where Application = 'TraiteOPC'";
        public const string insPlainteOPC = @"insert into [SDEXT01].[OPC].[PLAIN_OPC] ([DOSSR_NO], [CONSO_CT], [COMRC_NO], [COMRC_NM], [RECPT_DT], [NEQ] )
                                                values (@DossrNo, @ConsoCt, @ComrcNo, @ComrcNm, @RecptDt, @NeqNo ) ";
        public const string insDetenteur = @"insert into [SDEXT01].[OPC].[PERMS_COMRC_ITINR] ([PERMS_NO], [COMRC_NM], [COMRC_AD], [COMRC_AUTRE_NM], [REPRS_NB], [SUSPN_ANNUL_IN], [NEQ])
                                                values (@PermsNo, @ComrcNm, @ComrcAd, @ComrcAutreNm, @ReprsNb, @SuspnAnnulIn, @Neq)";
        public const string delDetenteur = @"DELETE [SDEXT01].[OPC].[PERMS_COMRC_ITINR] where SUSPN_ANNUL_IN = 'N'";
        public const string insSuspenduAnnulé = @"insert into [SDEXT01].[OPC].[PERMS_COMRC_ITINR] ([PERMS_NO], [COMRC_NM], [COMRC_AD], [COMRC_AUTRE_NM], [REPRS_NB], [SUSPN_ANNUL_IN], [DECSN_DT], [DECSN_MOTIF_DS], [DECSN_FICHR_NM], [NEQ])
                                                   values (@PermsNo, @ComrcNm, @ComrcAd, @ComrcAutreNm, @ReprsNb, @SuspnAnnulIn, @DecsnDt, @DecsnMotifDs, @DecsnFichrNm, @Neq)";
        public const string insConstInfra = @"insert into [SDEXT01].[OPC].[CONST_INFRA_CULPB] ([CONST_INFRA_NO], [INFRA_DS], [INFRA_LEGAL_RF], [CONST_INFRA_CREAT_DT], [DEFND_NM], [CULPB_MD], [CULPB_DT], [NEQ])
                                                   values (@ConstIndraNo, @InfraDs, @InfraLegalRf, @ConstInfraCreatDt, @DefndNm, @CulpbMd, @CulpbDt, @Neq)";

        public string newLine = Environment.NewLine;
        public bool blErreurExecution = false;
        public DateTime dtDateDebut = DateTime.Now;
        public string dtExecution = "";
        public string strCheminRejet = "";
        public string strNomFichierDate = "";
        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        public void Main()
		{
            try
            {
                TraiteOPC();
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Script Task", ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
                blErreurExecution = true;
                InsertTableLogJob("Main()", ex.Message);
            }
         
            Dts.TaskResult = (int)ScriptResults.Success;
		}

        public void TraiteOPC()
        {
            // Récupère les paramêtres
            string strCheminIn = FindConfigParm("OPC_ETL", "RepertPlaintesIn");
            string strCheminFchArch = FindConfigParm("OPC_ETL", "RepertPlaintesArch");
            strCheminRejet = FindConfigParm("OPC_ETL", "RepertoireRejet");
            strServerBD = FindConfigParm("OPC_ETL", "ServerBD_OPC");

            int intLineCount = 0;
            int intLineEnTraitement = 0;
            int intLineInsere = 0;
            int intLineRejete = 0;
            int intLineModif = 0;
            var encoding = Encoding.Default;
            string[] strGroupeLineImp;
            
            if (blErreurExecution != true)
            {
                ExecuteSQL("OPC", delLogJobChargement);
                InsertTableLogChargement("TraiteOPC", "Début du traitement");

                // Lire le répertoire pour le fichier R01
                intLineCount = 0;
                var fichiers = new DirectoryInfo(strCheminIn).GetFiles("EntreprisePlainte_20240101.csv");

                // Boucle sur le fichier
                foreach (var fichier in fichiers)
                {
                    string cheminComplet = fichier.FullName;
                    strNomFichierDate = "20240101";
                    intLineEnTraitement = 0;
                    intLineCount = 0;
                    intLineInsere = 0;
                    intLineRejete = 0;
                    intLineModif = 0;

                    InsertTableLogChargement("TraiteOPC", "LoadFichierR01()");
                    SqlConnection conn_R01 = new SqlConnection(strServerBD);
                    conn_R01.Open();
                    SqlTransaction tran_R01 = conn_R01.BeginTransaction();
                    SqlCommand cmd = new SqlCommand(insPlainteOPC, conn_R01, tran_R01);
                    cmd.CommandTimeout = 12000;

                    // Définition des paramètres 
                    cmd.Parameters.Add("@DossrNo", SqlDbType.Int);
                    cmd.Parameters.Add("@ConsoCt", SqlDbType.VarChar);
                    cmd.Parameters.Add("@ComrcNo", SqlDbType.Int);
                    cmd.Parameters.Add("@ComrcNm", SqlDbType.VarChar);
                    cmd.Parameters.Add("@RecptDt", SqlDbType.DateTime);
                    cmd.Parameters.Add("@NeqNo", SqlDbType.VarChar);

                    intLineCount = File.ReadLines(fichier.FullName).Count();

                    foreach (var line in File.ReadLines(fichier.FullName, encoding))
                    {
                        intLineEnTraitement++;
                        try
                        {
                            var parser = new TextFieldParser(new StringReader(line));
                            parser.HasFieldsEnclosedInQuotes = true;
                            parser.SetDelimiters(";");
                            strGroupeLineImp = parser.ReadFields();

                            if (strGroupeLineImp.Length < 6)
                            {
                                blErreurExecution = true;
                                InsertTableLogJob("LoadFichierR01() - Ligne :: " + intLineEnTraitement.ToString(), "Le nombre de colonnes requis n'est pas respecté");
                                intLineRejete++;
                            }
                            else
                            {
                                cmd.Parameters["@DossrNo"].Value = strGroupeLineImp[4];
                                cmd.Parameters["@ConsoCt"].Value = strGroupeLineImp[0];
                                cmd.Parameters["@ComrcNo"].Value = strGroupeLineImp[2];
                                cmd.Parameters["@ComrcNm"].Value = strGroupeLineImp[1];
                                cmd.Parameters["@RecptDt"].Value = string.IsNullOrWhiteSpace(strGroupeLineImp[3]) ? (object)DBNull.Value : Convert.ToDateTime(strGroupeLineImp[3]);
                                cmd.Parameters["@NeqNo"].Value = strGroupeLineImp[5];

                                try
                                {
                                    cmd.ExecuteNonQuery();
                                    intLineInsere++;
                                }
                                catch (SqlException ex)
                                {
                                    // Doublon = erreur 2627 (PK) ou 2601 (index unique)
                                    if (ex.Number == 2627 || ex.Number == 2601)
                                    {
                                        try
                                        {
                                            using (SqlCommand cmdDelete = new SqlCommand(
                                                "DELETE FROM [SDEXT01].[OPC].[PLAIN_OPC] WHERE DOSSR_NO = @DossrNo", conn_R01, tran_R01))
                                            {
                                                cmdDelete.Parameters.AddWithValue("@DossrNo", strGroupeLineImp[4]);
                                                cmdDelete.ExecuteNonQuery();
                                            }

                                            // Ré‑insertion
                                            cmd.ExecuteNonQuery();
                                            intLineModif++;
                                        }
                                        catch (Exception ex2)
                                        {
                                            blErreurExecution = true;
                                            intLineRejete++;
                                            InsertTableLogJob("InsertBD_R01()", ex2.Message);
                                        }
                                    }
                                    else
                                    {
                                        blErreurExecution = true;
                                        intLineRejete++;
                                        InsertTableLogJob("InsertBD_R01()", ex.Message);
                                    }
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            intLineRejete++;
                            InsertTableLogJob("LoadFichierR01() - Ligne :: " + intLineEnTraitement.ToString(), ex.Message);
                        }
                    }

                    tran_R01.Commit();

                    InsertBD_CTRL("N/A" + strNomFichierDate, fichier.Name, strNomFichierDate, "R01 - Plainte OPC", intLineCount, intLineEnTraitement, intLineInsere, intLineRejete, intLineModif);
                    ArchiveFichier(@fichier.FullName, strCheminFchArch, fichier.Name, strNomFichierDate, false);
                }
                //////////////////////////////////////////////////////////////////////////////////
                ///
                // Lire le répertoire pour le fichier R03
                intLineCount = 0;
                intLineModif = 0;
                fichiers = new DirectoryInfo(strCheminIn).GetFiles("EntrepriseDecision_20240101.csv");

                // Boucle sur le fichier
                foreach (var fichier in fichiers)
                {
                    string cheminComplet = fichier.FullName;
                    strNomFichierDate = "20240101";
                    intLineEnTraitement = 0;
                    intLineCount = 0;
                    intLineInsere = 0;
                    intLineRejete = 0;

                    InsertTableLogChargement("TraiteOPC", "LoadFichierR03()");
                    SqlConnection conn_R03 = new SqlConnection(strServerBD);
                    conn_R03.Open();
                    SqlTransaction tran_R03 = conn_R03.BeginTransaction();
                    SqlCommand cmd = new SqlCommand(insSuspenduAnnulé, conn_R03, tran_R03);
                    cmd.CommandTimeout = 12000;

                    // Définition des paramètres 
                    cmd.Parameters.Add("@PermsNo", SqlDbType.Int);
                    cmd.Parameters.Add("@ComrcNm", SqlDbType.VarChar);
                    cmd.Parameters.Add("@ComrcAd", SqlDbType.VarChar);
                    cmd.Parameters.Add("@ComrcAutreNm", SqlDbType.VarChar);
                    cmd.Parameters.Add("@ReprsNb", SqlDbType.VarChar);
                    cmd.Parameters.Add("@SuspnAnnulIn", SqlDbType.VarChar);
                    cmd.Parameters.Add("@DecsnDt", SqlDbType.DateTime);
                    cmd.Parameters.Add("@DecsnMotifDs", SqlDbType.VarChar);
                    cmd.Parameters.Add("@DecsnFichrNm", SqlDbType.VarChar);
                    cmd.Parameters.Add("@Neq", SqlDbType.VarChar);

                    intLineCount = File.ReadLines(fichier.FullName).Count();

                    foreach (var line in File.ReadLines(fichier.FullName, encoding))
                    {
                        intLineEnTraitement++;
                        try
                        {
                            var parser = new TextFieldParser(new StringReader(line));
                            parser.HasFieldsEnclosedInQuotes = true;
                            parser.SetDelimiters(";");
                            strGroupeLineImp = parser.ReadFields();

                            if (strGroupeLineImp.Length < 9)
                            {
                                blErreurExecution = true;
                                InsertTableLogJob("LoadFichierR03() - Ligne :: " + intLineEnTraitement.ToString(), "Le nombre de colonnes requis n'est pas respecté");
                                intLineRejete++;
                            }
                            else
                            {
                                var fichiersPdf = new DirectoryInfo(strCheminIn).GetFiles("rbq_rlopc01*" + strGroupeLineImp[4] + "*.pdf");

                                cmd.Parameters["@PermsNo"].Value = strGroupeLineImp[4];
                                cmd.Parameters["@ComrcNm"].Value = strGroupeLineImp[0];
                                cmd.Parameters["@ComrcAd"].Value = strGroupeLineImp[5];
                                cmd.Parameters["@ComrcAutreNm"].Value = strGroupeLineImp[6];
                                cmd.Parameters["@ReprsNb"].Value = strGroupeLineImp[7];
                                cmd.Parameters["@SuspnAnnulIn"].Value = "O";
                                cmd.Parameters["@DecsnDt"].Value = string.IsNullOrWhiteSpace(strGroupeLineImp[1]) ? (object)DBNull.Value : Convert.ToDateTime(strGroupeLineImp[1]);
                                cmd.Parameters["@DecsnMotifDs"].Value = strGroupeLineImp[2];
                                cmd.Parameters["@DecsnFichrNm"].Value = (fichiersPdf.Length == 0 || string.IsNullOrWhiteSpace(fichiersPdf[0].Name)) ? (object)DBNull.Value : fichiersPdf[0].Name;
                                cmd.Parameters["@Neq"].Value = strGroupeLineImp[8];

                                try
                                {
                                    cmd.ExecuteNonQuery();
                                    intLineInsere++;
                                }
                                catch (SqlException ex)
                                {
                                    // Doublon = erreur 2627 (PK) ou 2601 (index unique)
                                    if (ex.Number == 2627 || ex.Number == 2601)
                                    {
                                        try
                                        {
                                            using (SqlCommand cmdDelete = new SqlCommand(
                                                "DELETE FROM [SDEXT01].[OPC].[PERMS_COMRC_ITINR] WHERE PERMS_NO = @PermisNo", conn_R03, tran_R03))
                                            {
                                                cmdDelete.Parameters.AddWithValue("@PermisNo", strGroupeLineImp[4]);
                                                cmdDelete.ExecuteNonQuery();
                                            }

                                            // Ré‑insertion
                                            cmd.ExecuteNonQuery();
                                            intLineModif++;
                                        }
                                        catch (Exception ex2)
                                        {
                                            blErreurExecution = true;
                                            intLineRejete++;
                                            InsertTableLogJob("InsertBD_R03()", ex2.Message);
                                        }
                                    }
                                    else
                                    {
                                        blErreurExecution = true;
                                        intLineRejete++;
                                        InsertTableLogJob("InsertBD_R03()", ex.Message);
                                    }
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            blErreurExecution = true;
                            intLineRejete++;
                            InsertTableLogJob("LoadFichierR03() - Ligne :: " + intLineEnTraitement.ToString(), ex.Message);
                        }
                    }

                    tran_R03.Commit();

                    InsertBD_CTRL("N/A" + strNomFichierDate, fichier.Name, strNomFichierDate, "R03 - Permis de commerçant itinérant (Suspendu/Annulé)", intLineCount, intLineEnTraitement, intLineInsere, intLineRejete, intLineModif);
                    ArchiveFichier(@fichier.FullName, strCheminFchArch, fichier.Name, strNomFichierDate, false);
                }

                //////////////////////////////////////////////////////////////////////////////////
                ///
                // Lire le répertoire pour le fichier R04
                fichiers = new DirectoryInfo(strCheminIn).GetFiles("EntrepriseVerdDecl_20240101.csv");

                // Boucle sur le fichier
                foreach (var fichier in fichiers)
                {
                    string cheminComplet = fichier.FullName;
                    strNomFichierDate = "20240101";
                    intLineEnTraitement = 0;
                    intLineCount = 0;
                    intLineInsere = 0;
                    intLineRejete = 0;
                    intLineModif = 0;

                    InsertTableLogChargement("TraiteOPC", "LoadFichierR04()");
                    SqlConnection conn_R04 = new SqlConnection(strServerBD);
                    conn_R04.Open();

                    // CREATE #Temp
                    new SqlCommand("SELECT TOP 0 [CONST_INFRA_ID], [CONST_INFRA_NO], [INFRA_DS], [INFRA_LEGAL_RF], [CONST_INFRA_CREAT_DT], [DEFND_NM], [CULPB_MD], [CULPB_DT], [NEQ] INTO #Temp_CONST_INFRA_CULPB FROM [SDEXT01].[OPC].[CONST_INFRA_CULPB];", conn_R04).ExecuteNonQuery();
                    // Ajouter la clé primaire
                    new SqlCommand(@"ALTER TABLE #Temp_CONST_INFRA_CULPB ADD CONSTRAINT PK_Temp_CONST_INFRA_NO PRIMARY KEY (CONST_INFRA_ID, CONST_INFRA_NO);", conn_R04).ExecuteNonQuery();

                    SqlTransaction tran_R04 = conn_R04.BeginTransaction();
                    SqlCommand cmd = new SqlCommand("INSERT INTO #Temp_CONST_INFRA_CULPB ([CONST_INFRA_ID], [CONST_INFRA_NO], [INFRA_DS], [INFRA_LEGAL_RF], [CONST_INFRA_CREAT_DT], [DEFND_NM], [CULPB_MD], [CULPB_DT], [NEQ]) VALUES (@ConstInfraId, @ConstInfraNo, @InfraDs, @InfraLegalRf, @ConstInfraCreatDt, @DefndNm, @CulpbMd, @CulpbDt, @Neq)", conn_R04, tran_R04);
                    cmd.CommandTimeout = 12000;

                    // Définition des paramètres 
                    cmd.Parameters.Add("@ConstInfraId", SqlDbType.Int);
                    cmd.Parameters.Add("@ConstInfraNo", SqlDbType.BigInt);
                    cmd.Parameters.Add("@InfraDs", SqlDbType.VarChar);
                    cmd.Parameters.Add("@InfraLegalRf", SqlDbType.VarChar);
                    cmd.Parameters.Add("@ConstInfraCreatDt", SqlDbType.DateTime);
                    cmd.Parameters.Add("@DefndNm", SqlDbType.VarChar);
                    cmd.Parameters.Add("@CulpbMd", SqlDbType.VarChar);
                    cmd.Parameters.Add("@CulpbDt", SqlDbType.DateTime);
                    cmd.Parameters.Add("@Neq", SqlDbType.VarChar);


                    intLineEnTraitement = 0;

                    using (TextFieldParser parser = new TextFieldParser(fichier.FullName, encoding))
                    {
                        parser.TextFieldType = FieldType.Delimited;
                        parser.SetDelimiters(";");
                        parser.HasFieldsEnclosedInQuotes = true;

                        while (!parser.EndOfData)
                        {
                            intLineEnTraitement++;
                            intLineCount++;

                            try
                            {
                                strGroupeLineImp = parser.ReadFields();
                            }
                            catch (Exception ex)
                            {
                                blErreurExecution = true;
                                intLineRejete++;
                                InsertTableLogJob("LoadFichierR04() - Ligne :: " + intLineEnTraitement,
                                                  "Erreur de parsing CSV : " + ex.Message);
                                continue;
                            }

                            // Vérification du nombre de colonnes
                            if (strGroupeLineImp == null || strGroupeLineImp.Length < 8)
                            {
                                blErreurExecution = true;
                                intLineRejete++;
                                InsertTableLogJob("LoadFichierR04() - Ligne :: " + intLineEnTraitement,
                                                  "Le nombre de colonnes requis n'est pas respecté");
                                continue;
                            }

                            // Assignation des paramètres
                            cmd.Parameters["@ConstInfraId"].Value = intLineCount;
                            cmd.Parameters["@ConstInfraNo"].Value = long.TryParse(strGroupeLineImp[5], out long v) ? (object)v : DBNull.Value;

                            cmd.Parameters["@InfraDs"].Value = strGroupeLineImp[3];
                            cmd.Parameters["@InfraLegalRf"].Value = strGroupeLineImp[4];
                            cmd.Parameters["@ConstInfraCreatDt"].Value =
                                string.IsNullOrWhiteSpace(strGroupeLineImp[0]) ? (object)DBNull.Value : Convert.ToDateTime(strGroupeLineImp[0]);
                            cmd.Parameters["@DefndNm"].Value = strGroupeLineImp[2];
                            cmd.Parameters["@CulpbMd"].Value = strGroupeLineImp[6];
                            cmd.Parameters["@CulpbDt"].Value =
                                string.IsNullOrWhiteSpace(strGroupeLineImp[7]) ? (object)DBNull.Value : Convert.ToDateTime(strGroupeLineImp[7]);
                            cmd.Parameters["@Neq"].Value = strGroupeLineImp[1];

                            // Exécution SQL
                            try
                            {
                                cmd.ExecuteNonQuery();
                                intLineInsere++;
                            }
                            catch (Exception ex)
                            {
                                blErreurExecution = true;
                                intLineRejete++;
                                InsertTableLogJob("InsertBD_R04()", ex.Message);
                            }
                        }
                    }

                    cmd = new SqlCommand(@"DELETE a FROM [SDEXT01].[OPC].[CONST_INFRA_CULPB] a WHERE EXISTS (SELECT 1 FROM #Temp_CONST_INFRA_CULPB b WHERE a.CONST_INFRA_NO = b.CONST_INFRA_NO);", conn_R04, tran_R04);
                    cmd.ExecuteNonQuery();

                    cmd = new SqlCommand("INSERT INTO [SDEXT01].[OPC].[CONST_INFRA_CULPB] ([CONST_INFRA_NO], [INFRA_DS], [INFRA_LEGAL_RF], [CONST_INFRA_CREAT_DT], [DEFND_NM], [CULPB_MD], [CULPB_DT], [NEQ]) SELECT [CONST_INFRA_NO], [INFRA_DS], [INFRA_LEGAL_RF], [CONST_INFRA_CREAT_DT], [DEFND_NM], [CULPB_MD], [CULPB_DT], [NEQ] FROM #Temp_CONST_INFRA_CULPB", conn_R04, tran_R04);
                    cmd.ExecuteNonQuery();

                    tran_R04.Commit();

                    InsertBD_CTRL("N/A-" + strNomFichierDate, fichier.Name, strNomFichierDate, "R04 - Constat d’infraction/Coupable", intLineCount, intLineEnTraitement, intLineInsere, intLineRejete, intLineModif);
                    ArchiveFichier(@fichier.FullName, strCheminFchArch, fichier.Name, strNomFichierDate, false);
                }
            }

            InsertTableLogChargement("TraiteOPC", "Fin du traitement");

            if (blErreurExecution)
            {
                CreerFichierRejet();
                Email_Send();
            }
        }

        ////////////////////////////////////////////////////////////////////////
        ///
        //     Insert dans la BD
        ///
        ///////////////////////////////////////////////////////////////////////
        void InsertBD_CTRL(string pFichierZip, string pNomFichier, string pEnvoiDateHeure, string pDescription, int pLineCount, int pLineEnTraitement, int pLineInsere, int pLineRejete, int pLineModif)
        {
            string strcmdSql = @"insert into [SDEXT01].[CFG].[CTRL_FICH_ETL] (CD_ORG, CD_ETL, TYPE_TRAIT, FICH_ZIP_NM, FICHIER_NM, DESCR, TRAIT_DH, LIGNES_NB,  ENREG_INSER_NB, [ENREG_REJET_NB], [ENREG_MODFC_NB]) 
                                                                          values('OPC', 'OPC_Plaintes','R',  @strNomFichierZIP, @strNomFichier, @strDescription, @dtEnvoiDateHeure, @intNombreLignes,  @IntNombreInsere, @intNombreRejet, @IntNombreModif)";

            InsertTableLogChargement("TraiteOPC", "InsertBD_CTRL");
            DateTime dtEnvoiDateHeure;

            using (SqlConnection conn = new SqlConnection(strServerBD))
            {
                conn.Open();
                SqlTransaction tran = conn.BeginTransaction();

                try
                {
                    SqlCommand cmd = new SqlCommand(strcmdSql, conn, tran);
                    cmd.CommandTimeout = 12000;

                    // Définition des paramètres 
                    cmd.Parameters.Add("@strNomFichierZIP", SqlDbType.VarChar);
                    cmd.Parameters.Add("@dtEnvoiDateHeure", SqlDbType.DateTime);
                    cmd.Parameters.Add("@strNomFichier", SqlDbType.VarChar);
                    cmd.Parameters.Add("@strDescription", SqlDbType.VarChar);
                    cmd.Parameters.Add("@intNombreLignes", SqlDbType.Int);
                    cmd.Parameters.Add("@IntNombreInsere", SqlDbType.Int);
                    cmd.Parameters.Add("@intNombreRejet", SqlDbType.Int);
                    cmd.Parameters.Add("@IntNombreModif", SqlDbType.Int);

                    dtEnvoiDateHeure = DateTime.ParseExact(pEnvoiDateHeure + " 00:00:00", "yyyyMMdd HH:mm:ss", CultureInfo.InvariantCulture);

                    cmd.Parameters["@strNomFichierZIP"].Value = pFichierZip;
                    cmd.Parameters["@dtEnvoiDateHeure"].Value = dtEnvoiDateHeure;
                    cmd.Parameters["@strNomFichier"].Value = pNomFichier;
                    cmd.Parameters["@strDescription"].Value = pDescription;
                    cmd.Parameters["@intNombreLignes"].Value = pLineCount;
                    cmd.Parameters["@IntNombreInsere"].Value = pLineInsere;
                    cmd.Parameters["@intNombreRejet"].Value = pLineRejete;
                    cmd.Parameters["@IntNombreModif"].Value = pLineModif;

                    try
                    {
                        cmd.ExecuteNonQuery();
                    }
                    catch (Exception ex)
                    {
                        blErreurExecution = true;
                        InsertTableLogJob("InsertBD_CTRL(" + pNomFichier + ")", ex.Message);
                    }

                    tran.Commit();
                }
                catch (Exception ex)
                {
                    blErreurExecution = true;
                    tran.Rollback();
                    InsertTableLogJob("InsertBD_CTRL(" + pNomFichier + ")", ex.Message);
                }
            }
        }

        ////////////////////////////////////////////////////////////////////////
        ///
        //     Récupère les valeurs de la table config
        ///
        ///////////////////////////////////////////////////////////////////////
        string FindConfigParm(string pCdSystem, string pCdParm)
        {
            string sqlCmd = "SELECT parm.valeur_parm as ValeurParm " +
                            "FROM  [SDEXT01].[CFG].[CFG_CONFIG] co, " +
                                  "[SDEXT01].[CFG].[CFG_CONFIG_PARM] parm " +
                            "where co.[CD_SYSTEM] = '" + pCdSystem + "' " +
                            "and   co.[IND_ACTIF] = 'O' " +
                            "and parm.[CD_SYSTEM] = co.[CD_SYSTEM] " +
                            "and parm.[IND_ACTIF] = 'O' " +
                            "and parm.[CD_PARAM] = '" + pCdParm + "'";

            string valParm = "";

            try
            {
                using (SqlConnection mySQLConnectionParm = new SqlConnection(strServerSDEXT01))
                {
                    mySQLConnectionParm.Open();

                    using (SqlCommand SQLCommandCfg = new SqlCommand(sqlCmd.ToString(), mySQLConnectionParm))
                    {

                        SQLCommandCfg.CommandType = CommandType.Text;
                        SqlDataReader readerCfg = SQLCommandCfg.ExecuteReader();
                        readerCfg.Read();
                        valParm = readerCfg["ValeurParm"].ToString();
                        readerCfg.Close();
                    }
                }
            }
            catch (Exception ex)
            {
                //MessageBox.Show(ex.Message);
                blErreurExecution = true;
                InsertTableLogJob("ERR", "FindConfigParm(" + pCdSystem + "." + pCdParm + ")");
            }
            return valParm;
        }

        //////////////////////////////////////////////////////////////////////
        ///
        //     Exécute une instruction SQL
        ///
        /////////////////////////////////////////////////////////////////////
        void ExecuteSQL(string strCodeTraitement, string strSqlRequete)
        {
            string sqlCmd = strSqlRequete.ToString();

            try
            {
                using (SqlConnection mySQLConnection = new SqlConnection(strServerBD))
                {
                    mySQLConnection.Open();
                    using (var transaction = mySQLConnection.BeginTransaction())
                    {
                        SqlCommand SQLCommandExec = new SqlCommand(sqlCmd.ToString(), mySQLConnection, transaction);
                        SQLCommandExec.CommandTimeout = 12000;
                        SQLCommandExec.ExecuteNonQuery();
                        transaction.Commit();
                    }
                }
            }
            catch (Exception ex)
            {
                //MessageBox.Show(ex.Message);
                InsertTableLogJob("ExecuteSQL(" + strCodeTraitement + ")", ex.Message.ToString());
                blErreurExecution = true;
            }
        }

        //////////////////////////////////////////////////////////////////////
        ///
        //     Archive le fichier
        ///
        /////////////////////////////////////////////////////////////////////
        void ArchiveFichier(string de, string a, string pFichierSource, string pstrNomFichierDate, bool supprimeFichier)
        {
            string strDate = pstrNomFichierDate;
            int annee = int.Parse(strDate.Substring(0, 4));
            int mois = int.Parse(strDate.Substring(4, 2));
            int jour = int.Parse(strDate.Substring(6, 2));
            string strAnneeFical = "";

            if (mois <= 4)
            {
                strAnneeFical = $"{annee - 1}-{annee}";
            }
            else
            {
                strAnneeFical = $"{annee}-{annee + 1}";                
            }

            try
            {
                if (!System.IO.Directory.Exists(a + @"\\ChargementHisto\"))
                {
                    System.IO.Directory.CreateDirectory(a + @"\\ChargementHisto\"   );
                }
                if (System.IO.File.Exists(a + @"\\ChargementHisto\" + pFichierSource))
                {
                    System.IO.File.SetAttributes(a + @"\\ChargementHisto\" + pFichierSource, FileAttributes.Archive);
                    System.IO.File.Delete(a + @"\\ChargementHisto\" + pFichierSource);
                }

                System.IO.File.Copy(de, a + pFichierSource, true);

                if (supprimeFichier)
                {
                    SupprimeFichier(de);
                }
            }

            catch (IOException ex)
            {
                //MessageBox.Show(ex.Message);
                blErreurExecution = true;
                InsertTableLogJob("ArchiveFichier()", ex.Message.ToString());
            }
        }

        //////////////////////////////////////////////////////////////////////
        ///
        //     Supprime le fichier
        ///
        /////////////////////////////////////////////////////////////////////
        void SupprimeFichier(string strFchier)
        {
            try
            {
                if (System.IO.File.Exists(strFchier))
                {
                    System.IO.File.SetAttributes(strFchier, FileAttributes.Archive);
                    System.IO.File.Delete(strFchier);
                }
            }
            catch (Exception ex)
            {
                //MessageBox.Show(ex.Message);
                blErreurExecution = true;
                InsertTableLogJob("SupprimeFichier()", ex.Message.ToString());
            }
        }

        //////////////////////////////////////////////////////////////////////
        ///
        //     insert les informations dant la table Log_Chargement_Connecteur
        ///
        /////////////////////////////////////////////////////////////////////
        void InsertTableLogChargement(string strIndSystem, string strSqlTable)
        {
            string sqlInsCmd = "insert into [SDEXT01].[CFG].[Log_Chargement_Connecteur] values('TraiteOPC', '" + strIndSystem + "', '" + strSqlTable + "', GETDATE(), 'OPC', 'Tâche Automatisée')";

            try
            {
                using (SqlConnection mySQLConnection = new SqlConnection(strServerBD))
                {
                    mySQLConnection.Open();
                    SqlCommand SQLCommandLog = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandLog.CommandType = CommandType.Text;
                    SQLCommandLog.ExecuteNonQuery();
                }
            }
            catch (Exception ex)
            {
                //MessageBox.Show(ex.Message);
                blErreurExecution = true;
                InsertTableLogJob("InsertTableLogChargement()", ex.Message.ToString());
            }
        }

        //////////////////////////////////////////////////////////////////////
        ///
        //     insert les informations dant la table Log_Job_Connecteur
        ///
        /////////////////////////////////////////////////////////////////////
        void InsertTableLogJob(string pFonction, string pErreurMessage)
        {
            int lParametreErreurMessage;
            pErreurMessage = pErreurMessage.Replace("'", "''");
            lParametreErreurMessage = pErreurMessage.Length;

            if (pErreurMessage.Length > 250)
            {
                pErreurMessage = pErreurMessage.Substring(0, 245);
                pErreurMessage = pErreurMessage + "...";
            }

            string sqlInsCmd = "insert into [SDEXT01].[CFG].[Log_Job_Connecteur] values('TraiteOPC', 'OPC', null, '" + pFonction + "', 'Erreur', '" + pErreurMessage + "', 'OPC', GETDATE())";

            try
            {
                using (SqlConnection mySQLConnection = new SqlConnection(strServerBD))
                {
                    mySQLConnection.Open();
                    SqlCommand SQLCommandJob = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandJob.CommandType = CommandType.Text;
                    SQLCommandJob.CommandTimeout = 12000;
                    SQLCommandJob.ExecuteNonQuery();
                    blErreurExecution = true;
                }
            }
            catch (Exception ex)
            {
                //MessageBox.Show(ex.Message);
                blErreurExecution = true;
                InsertTableLogChargement("ERR", "Impossible d'insérer dans Log_Job_Connecteur");
            }
        }
        //////////////////////////////////////////////////////////////////////
        ///
        //     Création du fichier rejet
        ///
        /////////////////////////////////////////////////////////////////////
        void CreerFichierRejet()
        {
            string sqlErreur = @"select JobName + '|' + ErrorMessage + '|' + replace(FORMAT(DateErreur, 'yyyy-MM-dd hh:mi:ss'), 'i', '') as resultat
                                     from   [SDEXT01].[CFG].[Log_Job_Connecteur]
                                     where  application = 'TraiteOPC' 
                                     order by DateErreur ";

            string strpath = strCheminRejet + "Rejets_" + strNomFichierDate + ".csv";

            if (File.Exists(strpath))
            {
                // Si le fichier existe le détruire
                File.Delete(strpath);
            }

            StreamWriter sw = new StreamWriter(strpath, true, Encoding.Unicode);
            sw.WriteLine("Fonction(Code utile)|Erreur|Date exécution");

            // Lire les règles d'affaire
            using (SqlDataAdapter dataAdapterAfficheErreur = new SqlDataAdapter(sqlErreur, strServerBD))
            {
                try
                {
                    DataSet dataSetAfficheErreur = new DataSet();
                    dataAdapterAfficheErreur.SelectCommand.CommandTimeout = 600;
                    dataAdapterAfficheErreur.Fill(dataSetAfficheErreur, "AfficheErreur");

                    foreach (DataRow pRowRegleAfficheErreur in dataSetAfficheErreur.Tables["AfficheErreur"].Rows)
                    {
                        sw.WriteLine(pRowRegleAfficheErreur["resultat"].ToString().Replace(Environment.NewLine, "").Replace("\r", "").Replace("\n", ""));
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJob("CreerFichierRejet()", ex.Message.ToString());
                    blErreurExecution = true;
                }
            }
            sw.Close();
        }
        //////////////////////////////////////////////////////////////////////
        ///
        //     Envois courriel
        ///
        /////////////////////////////////////////////////////////////////////
        void Email_Send()
        {
            String EnvoisCourrielPar = FindConfigParm("COMMUN", "EnvoyePar"); 
            String EnvoisCourrielA = FindConfigParm("OPC_ETL", "EnvoisCourrielA"); ;
            String EnvoisCourrielSuject = "L'application (TraiteOPC) a une ou des erreurs d'exécutions. ";
            String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                         EnvoisCourrielSuject + newLine + newLine +
                                         "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
            String EnvoisCourrielPiedCorps = "..." + newLine +
                                             "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                             "Direction des technologies de l'information" + newLine +
                                             "Régie du bâtiment du Québec";

            string strpath = strCheminRejet + "Rejets_" + strNomFichierDate + ".csv";

            EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();
            System.Net.Mail.Attachment fileAttachment = null;

            String SmtpServer = FindConfigParm("COMMUN", "SmtpServer");

            try
            {
                // Création du courriel et changement du format en HTML
                MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                if (File.Exists(strpath))
                {
                    fileAttachment = new System.Net.Mail.Attachment(strpath);

                    //Ajout de l'attachements
                    FormatCourrielHtml.Attachments.Add(fileAttachment);
                }

                // Créer le SMTP client et envois le courriel
                SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                monSmtpClient.Send(FormatCourrielHtml);
            }
            catch (Exception ex)
            {
                //MessageBox.Show(ex.Message);
                blErreurExecution = true;
                InsertTableLogJob("SendMail()", ex.Message.ToString());
            }
        }
        //////////////////////////

        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion

	}
}]]></ProjectItem>
