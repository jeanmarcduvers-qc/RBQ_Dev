    <msb:Language>msBuild</msb:Language>
    <msb:DisplayName>ST_1e06a8759e72403ea01473531ae9fbc7</msb:DisplayName>
    <msb:ProjectId>{FE1132EF-92DA-4BA5-B847-09009380888C}</msb:ProjectId>
