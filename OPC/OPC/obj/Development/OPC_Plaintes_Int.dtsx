        public string strServerSDEXT01 = " Server=W367I002RPT1,60800;Database=SDEXT01;Integrated Security=True;";
        public string strServerBD = "";
        public string strClientEmpNo = "";
        public DateTime dtTraitementSSIS = DateTime.Now.Date;
        public string fichierArchive = "";

        public const string delLogChargement = "DELETE [SDEXT01].[CFG].[Log_Chargement_Connecteur] where Application = 'TraiteOPC'";
        public const string delLogJobChargement = "DELETE [SDEXT01].[CFG].[Log_Job_Connecteur] where Application = 'TraiteOPC'";
        public const string tblAfficheErreur = "SELECT * FROM [SDEXT01].[CFG].[Log_Job_Connecteur] where Application = 'TraiteOPC'";
        public const string insPlainteOPC = @"insert into [SDEXT01].[OPC].[PLAIN_OPC] ([DOSSR_NO], [CONSO_CT], [COMRC_NO], [COMRC_NM], [RECPT_DT], [NEQ] )
                                                values (@DossrNo, @ConsoCt, @ComrcNo, @ComrcNm, @RecptDt, @NeqNo ) ";
        public const string insDetenteur = @"insert into [SDEXT01].[OPC].[PERMS_COMRC_ITINR] ([PERMS_NO], [COMRC_NM], [COMRC_AD], [COMRC_AUTRE_NM], [REPRS_NB], [SUSPN_ANNUL_IN], [NEQ])
                                                values (@PermsNo, @ComrcNm, @ComrcAd, @ComrcAutreNm, @ReprsNb, @SuspnAnnulIn, @Neq)";
        public const string delDetenteur = @"DELETE [SDEXT01].[OPC].[PERMS_COMRC_ITINR] where SUSPN_ANNUL_IN = 'N'";
        public const string insSuspenduAnnulé = @"insert into [SDEXT01].[OPC].[PERMS_COMRC_ITINR] ([PERMS_NO], [COMRC_NM], [COMRC_AD], [COMRC_AUTRE_NM], [REPRS_NB], [SUSPN_ANNUL_IN], [DECSN_DT], [DECSN_MOTIF_DS], [DECSN_FICHR_NM], [NEQ])
                                                   values (@PermsNo, @ComrcNm, @ComrcAd, @ComrcAutreNm, @ReprsNb, @SuspnAnnulIn, @DecsnDt, @DecsnMotifDs, @DecsnFichrNm, @Neq)";
        public const string insConstInfra = @"insert into [SDEXT01].[OPC].[CONST_INFRA_CULPB] ([CONST_INFRA_NO], [INFRA_DS], [INFRA_LEGAL_RF], [CONST_INFRA_CREAT_DT], [DEFND_NM], [CULPB_MD], [CULPB_DT], [NEQ])
                                                   values (@ConstIndraNo, @InfraDs, @InfraLegalRf, @ConstInfraCreatDt, @DefndNm, @CulpbMd, @CulpbDt, @Neq)";

        public string newLine = Environment.NewLine;
        public bool blErreurExecution = false;
        public DateTime dtDateDebut = DateTime.Now;
        public string dtExecution = "";
        public string strCheminRejet = "";
        public string strNomFichierDate = "";
        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
