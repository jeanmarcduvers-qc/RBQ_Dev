            ////////////////////////////////////////////////////////////////////////
            ///
            //    Création du fichier de sorti CSV
            ///
            ///////////////////////////////////////////////////////////////////////
            int CreerCSV(string psqlCmd, string pfichierOut)
            {
                string strpath = strCheminOut + pfichierOut + dtTraitementSSIS.ToString("yyyy_MM_dd") + ".csv";
                string resultat = "";
                int nbRow = 0;

                if (File.Exists(strpath))
                {
                    // Si le fichier existe le détruire
                    File.Delete(strpath);
                }

                StreamWriter sw = new StreamWriter(strpath, true, Encoding.Unicode);

                try
                {
                    // Lire la requete
                    using (SqlDataAdapter dataAdapterAfficheLicences = new SqlDataAdapter(psqlCmd, strServerBD_SIEBEL))
                    {
                        try
                        {
                            DataSet dataSetAfficheLicences = new DataSet();
                            dataAdapterAfficheLicences.SelectCommand.CommandTimeout = 600;
                            dataAdapterAfficheLicences.Fill(dataSetAfficheLicences, "Licences");

                            nbRow = dataSetAfficheLicences.Tables["Licences"].Rows.Count;
                            var table = dataSetAfficheLicences.Tables["Licences"];

                            // Cré la ligne entête
                            string nomsColonnes = string.Join("|",
                                table.Columns
                                     .Cast<DataColumn>()
                                     .Select(c => c.ColumnName));
                            
                            resultat = string.Join("\n", nomsColonnes);
                            sw.WriteLine(resultat);

                            // Cré les lignes détails
                            foreach (DataRow row in table.Rows)
                            {
                                string ligne = string.Join("|",
                                    row.ItemArray.Select(v => v?.ToString() ?? "")
                                );

                                resultat = string.Join("\n", ligne);
                                sw.WriteLine(resultat);
                            }
                        }
                        catch (Exception ex)
                        {
                            //MessageBox.Show(ex.Message);
                            InsertTableLogJob("CreerCSV()", ex.Message.ToString());
                            blErreurExecution = true;
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "CreerCSV()");
                }
                sw.Close();
                return nbRow;
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //    Création du fichier de sorti Ctrl
            ///
            ///////////////////////////////////////////////////////////////////////
            int CreerCtrl(string psqlCmd, string pfichierOut)
            {
                string strpath = strCheminOut + pfichierOut + dtTraitementSSIS.ToString("yyyy_MM_dd") + ".csv";
                string resultat = "";
                int nbRow = 0;

                if (File.Exists(strpath))
                {
                    // Si le fichier existe le détruire
                    File.Delete(strpath);
                }

                StreamWriter sw = new StreamWriter(strpath, true, Encoding.Unicode);

                try
                {
                    // Lire la requete
                    using (SqlConnection con = new SqlConnection(strServerBD_OPC))
                    using (SqlCommand cmdsSql = new SqlCommand(psqlCmd, con))
                    {

                        cmdsSql.Parameters.AddWithValue("@TRAIT_DH", dtTraitementSSIS);

                        using (SqlDataAdapter dataAdapterAfficheLicences = new SqlDataAdapter(cmdsSql))
                        {
                            try
                            {
                                DataSet dataSetAfficheLicences = new DataSet();
                                dataAdapterAfficheLicences.SelectCommand.CommandTimeout = 600;
                                dataAdapterAfficheLicences.Fill(dataSetAfficheLicences, "Licences");

                                nbRow = dataSetAfficheLicences.Tables["Licences"].Rows.Count;
                                var table = dataSetAfficheLicences.Tables["Licences"];

                                // Cré la ligne entête
                                string nomsColonnes = string.Join("|",
                                    table.Columns
                                         .Cast<DataColumn>()
                                         .Select(c => c.ColumnName));

                                resultat = string.Join("\n", nomsColonnes);
                                sw.WriteLine(resultat);

                                // Cré les lignes détails
                                foreach (DataRow row in table.Rows)
                                {
                                    string ligne = string.Join("|",
                                        row.ItemArray.Select(v => v?.ToString() ?? "")
                                    );

                                    resultat = string.Join("\n", ligne);
                                    sw.WriteLine(resultat);
                                }
                            }
                            catch (Exception ex)
                            {
                                //MessageBox.Show(ex.Message);
                                InsertTableLogJob("CreerCtrl()", ex.Message.ToString());
                                blErreurExecution = true;
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "CreerCtrl()");
                }
                sw.Close();
                return nbRow;
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Récupére les valeurs de la table config
            ///
            ///////////////////////////////////////////////////////////////////////
            string FindConfigParm(string pCdSystem, string pCdParm)
            {
                string sqlCmd = "SELECT parm.valeur_parm as ValeurParm " +
                                "FROM  [SDEXT01].[CFG].[CFG_CONFIG] co, " +
                                      "[SDEXT01].[CFG].[CFG_CONFIG_PARM] parm " +
                                "where co.[CD_SYSTEM] = '" + pCdSystem + "' " +
                                "and   co.[IND_ACTIF] = 'O' " +
                                "and parm.[CD_SYSTEM] = co.[CD_SYSTEM] " +
                                "and parm.[IND_ACTIF] = 'O' " +
                                "and parm.[CD_PARAM] = '" + pCdParm + "'";

                string valParm = "";

                try
                {
                    using (SqlConnection mySQLConnectionParm = new SqlConnection(strServerSDEXT01))
                    {
                        mySQLConnectionParm.Open();

                        using (SqlCommand SQLCommandCfg = new SqlCommand(sqlCmd.ToString(), mySQLConnectionParm))
                        {

                            SQLCommandCfg.CommandType = CommandType.Text;
                            SqlDataReader readerCfg = SQLCommandCfg.ExecuteReader();
                            readerCfg.Read();
                            valParm = readerCfg["ValeurParm"].ToString();
                            readerCfg.Close();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "FindConfigParm(" + pCdSystem + "." + pCdParm + ")");
                }
                return valParm;
            }


            ////////////////////////////////////////////////////////////////////////
            ///
            //     Update le fichier de contrôle
            ///
            ///////////////////////////////////////////////////////////////////////
            void UpdateCtrl(string pNomFichierTxt, string pDescription, int intLigneTraitee)
            {
                int intCmdTrait = 0;

                string sqlcmd = @"INSERT INTO [CFG].[CTRL_FICH_ETL]
                                               ([CD_ORG]
                                               ,[CD_ETL]
                                               ,[TYPE_TRAIT]
                                               ,[FICH_ZIP_NM]
                                               ,[FICHIER_NM]
                                               ,[DESCR]
                                               ,[TRAIT_DH]
                                               ,[LIGNES_NB])
                                         VALUES
                                               (@CD_ORG 
                                               ,@CD_ETL 
                                               ,@TYPE_TRAIT 
                                               ,@FICH_ZIP_NM 
                                               ,@FICHIER_NM 
                                               ,@DESCR 
                                               ,@TRAIT_DH 
                                               ,@LIGNES_NB) ";

                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerBD_OPC))
                    {
                        mySQLConnection.Open();
                        SqlTransaction transaction = mySQLConnection.BeginTransaction();

                        using (SqlCommand SQLCommandExec = new SqlCommand(sqlcmd, mySQLConnection, transaction))
                        {
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.Parameters.Add("@CD_ORG", SqlDbType.VarChar, 10);
                            SQLCommandExec.Parameters.Add("@CD_ETL", SqlDbType.VarChar, 20);
                            SQLCommandExec.Parameters.Add("@TYPE_TRAIT", SqlDbType.VarChar, 1);
                            SQLCommandExec.Parameters.Add("@FICH_ZIP_NM", SqlDbType.VarChar, 100);
                            SQLCommandExec.Parameters.Add("@FICHIER_NM", SqlDbType.VarChar, 100);
                            SQLCommandExec.Parameters.Add("@DESCR", SqlDbType.VarChar, 500);
                            SQLCommandExec.Parameters.Add("@TRAIT_DH", SqlDbType.DateTime);
                            SQLCommandExec.Parameters.Add("@LIGNES_NB", SqlDbType.Int);


                            SQLCommandExec.Parameters["@CD_ORG"].Value = "OPC";
                            SQLCommandExec.Parameters["@CD_ETL"].Value = "OPC_Licences";
                            SQLCommandExec.Parameters["@TYPE_TRAIT"].Value = "E";
                            SQLCommandExec.Parameters["@FICH_ZIP_NM"].Value = strZipFileNameLicences;
                            SQLCommandExec.Parameters["@FICHIER_NM"].Value = pNomFichierTxt;
                            SQLCommandExec.Parameters["@DESCR"].Value = pDescription;
                            SQLCommandExec.Parameters["@TRAIT_DH"].Value = dtTraitementSSIS;
                            SQLCommandExec.Parameters["@LIGNES_NB"].Value = intLigneTraitee;

                            SQLCommandExec.ExecuteNonQuery();
                        }
                        transaction.Commit();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ERR", "UpdateCtrl(" + pNomFichierTxt + ") - " + ex.Message);
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Chargement_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogChargement(string strIndSystem, string strSqlTable)
            {
                string sqlInsCmd = "insert into [SDEXT01].[CFG].[Log_Chargement_Connecteur] values('TraiteOPC', '" + strIndSystem + "', '" + strSqlTable + "', GETDATE(), 'CCQ', 'Tâche Automatisée')";

                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerBD_OPC))
                    {
                        mySQLConnection.Open();
                        SqlCommand SQLCommandLog = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                        SQLCommandLog.CommandType = CommandType.Text;
                        SQLCommandLog.ExecuteNonQuery();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("InsertTableLogChargement()", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Job_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogJob(string pFonction, string pErreurMessage)
            {
                int lParametreErreurMessage;
                pErreurMessage = pErreurMessage.Replace("'", "''");
                lParametreErreurMessage = pErreurMessage.Length;

                if (pErreurMessage.Length > 250)
                {
                    pErreurMessage = pErreurMessage.Substring(0, 245);
                    pErreurMessage = pErreurMessage + "...";
                }

                string sqlInsCmd = "insert into [SDEXT01].[CFG].[Log_Job_Connecteur] values('TraiteOPC', 'CCQ', null, '" + pFonction + "', 'Erreur', '" + pErreurMessage + "', 'CCQ', GETDATE())";

                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerBD_OPC))
                    {
                        mySQLConnection.Open();
                        SqlCommand SQLCommandJob = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                        SQLCommandJob.CommandType = CommandType.Text;
                        SQLCommandJob.ExecuteNonQuery();
                        blErreurExecution = true;
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogChargement("ERR", "Impossible d'insérer dans Log_Job_Connecteur");
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Compresse les fichiers CSV
            ///
            /////////////////////////////////////////////////////////////////////
            void ZipFichier(string dossierSource, string dossierDestination)
            {
                try
                {
                    string zipDestination = dossierDestination + strZipFileNameLicences;

                    if (File.Exists(zipDestination))
                    {
                        // Si le fichier existe le détruire
                        File.Delete(zipDestination);
                    }
                    using (ZipArchive zip = ZipFile.Open(zipDestination, ZipArchiveMode.Create)) 
                    { 
                        foreach (string fichier in Directory.GetFiles(dossierSource, "*.csv")) 
                        { 
                            string nomDansZip = Path.GetFileName(fichier); 
                            zip.CreateEntryFromFile(fichier, nomDansZip); 
                        } 
                    }


                    string folder = dossierSource;

                    foreach (string file in Directory.GetFiles(folder, "*.csv"))
                    {
                        File.Delete(file);
                    }
                }

                catch (IOException ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ZipFichier()", ex.Message.ToString());
                }
            }
            //////////////////////////////////////////////////////////////////////
            ///
            //     Archive le fichier
            ///
            /////////////////////////////////////////////////////////////////////
            void ArchiveFichier(string dossierSource, string dossierDestination, bool supprimeFichier)
            {
                string strdossierSource = dossierSource + strZipFileNameLicences;
                string strdossierDestination = dossierDestination + strZipFileNameLicences;

                try
                {
                    string destinationFolder = Path.GetDirectoryName(strdossierDestination); 
                    if (!Directory.Exists(destinationFolder)) 
                    { 
                        Directory.CreateDirectory(destinationFolder); 
                    }

                    System.IO.File.Copy(strdossierSource, strdossierDestination, true);

                    if (supprimeFichier)
                    {
                        SupprimeFichier(strdossierSource);
                    }
                }

                catch (IOException ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("ArchiveFichier()", ex.Message.ToString());
                }
            }
            //////////////////////////////////////////////////////////////////////
            ///
            //     Supprime le fichier
            ///
            /////////////////////////////////////////////////////////////////////
            void SupprimeFichier(string strFchier)
            {
                try
                {
                    if (System.IO.File.Exists(strFchier))
                    {
                        System.IO.File.SetAttributes(strFchier, FileAttributes.Archive);
                        System.IO.File.Delete(strFchier);
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("SupprimeFichier()", ex.Message.ToString());
                }
            }


            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute une instruction SQL
            ///
            /////////////////////////////////////////////////////////////////////
            void ExecuteSQL(string strCodeTraitement, string strSqlRequete)
            {
                string sqlCmd = strSqlRequete.ToString();

                try
                {
                    using (SqlConnection mySQLConnection = new SqlConnection(strServerBD_OPC))
                    {
                        mySQLConnection.Open();
                        using (var transaction = mySQLConnection.BeginTransaction())
                        {
                            SqlCommand SQLCommandExec = new SqlCommand(sqlCmd.ToString(), mySQLConnection, transaction);
                            SQLCommandExec.CommandTimeout = 12000;
                            SQLCommandExec.ExecuteNonQuery();
                            transaction.Commit();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJob("ExecuteSQL(" + strCodeTraitement + ")", ex.Message.ToString());
                    blErreurExecution = true;
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Envois courriel
            ///
            /////////////////////////////////////////////////////////////////////
            void Email_Send()
            {
                String SQLString = tblAfficheErreur.ToString();
                String EnvoisCourrielPar = EnvoyePar.ToString();
                String EnvoisCourrielA = "yves.mcduff-ext@rbq.gouv.qc.ca"; // strEnvoisCourrielA.ToString();  // "yves.mcduff-ext@rbq.gouv.qc.ca";  //"centre.de.pilotage@rbq.gouv.qc.ca"
                String EnvoisCourrielSuject = "L'application (TraiteOPC) a une ou des erreurs d'exécutions. ";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine +
                                             "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";

                string strpath = ""; // yves strCheminRejet + "Rejets_" + dtTraitementSSIS.ToString("yyyy_MM_dd") + ".csv";

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();
                System.Net.Mail.Attachment fileAttachment = null;

                String SmtpServer = FindConfigParm("COMMUN", "SmtpServer");

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    if (File.Exists(strpath))
                    {
                        fileAttachment = new System.Net.Mail.Attachment(strpath);

                        //Ajout de l'attachements
                        FormatCourrielHtml.Attachments.Add(fileAttachment);
                    }

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJob("SendMail()", ex.Message.ToString());
                }
            }
        }
        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
