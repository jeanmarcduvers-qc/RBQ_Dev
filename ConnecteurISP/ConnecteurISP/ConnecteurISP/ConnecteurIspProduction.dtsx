            //////////////////////////////////////////////////////////////////////
            ///
            //     détermine le rang dans la semaine d'un nom de jour en texte
            //     (inverse de fonction WeekdayName)
            ///
            /////////////////////////////////////////////////////////////////////
            int NoJourSem(string pstrTxt)
            {
                int ReturnNoJourSem = 0;
                switch (pstrTxt)
                {
                    case "dimanche":
                        ReturnNoJourSem = 1;
                        break;
                    case "lundi":
                        ReturnNoJourSem = 2;
                        break;
                    case "mardi":
                        ReturnNoJourSem = 3;
                        break;
                    case "mercredi":
                        ReturnNoJourSem = 4;
                        break;
                    case "jeudi":
                        ReturnNoJourSem = 5;
                        break;
                    case "vendredi":
                        ReturnNoJourSem = 6;
                        break;
                    case "samedi":
                        ReturnNoJourSem = 7;
                        break;
                }
                return ReturnNoJourSem;
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     indique si on doit faire le traitement chaque semaine,
            //     au 2, 3 ou 4 semaines
            ///
            /////////////////////////////////////////////////////////////////////
            int CalculerFacteurFrequence(string pstrFreq)
            {
                int Freq;
                switch (pstrFreq)
                {

                    case "Chaque semaine":
                        Freq = 1;
                        break;
                    case "Toutes les deux semaines":
                        Freq = 2;
                        break;
                    case "Toutes les trois semaines":
                        Freq = 3;
                        break;
                    case "Toutes les quatre semaines":
                        Freq = 4;
                        break;
                    default:
                        Freq = 1;
                        break;
                }
                return Freq;
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Job_Connecteur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogJobConnecteur(string pFonction, string pErreurMessage)
            {
                int lParametreErreurMessage;
                pErreurMessage = pErreurMessage.Replace("'", "''");
                lParametreErreurMessage = pErreurMessage.Length;

                if (pErreurMessage.Length > 250)
                {
                    pErreurMessage = pErreurMessage.Substring(0, 245);
                    pErreurMessage = pErreurMessage + "...";
                }

                string sqlInsCmd = "insert into[SDDMU01].[dbo].[Log_Job_Connecteur] values('ConnecteurISP', '" + "ISP" + "', '" + "Excel vers SharePoint" + "', '" + pFonction + "', 'Erreur', '" + pErreurMessage + "', 'Auto01', GETDATE())";

                try
                {
                    SqlCommand SQLCommandJob = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandJob.CommandType = CommandType.Text;
                    SqlDataReader readerErreur = SQLCommandJob.ExecuteReader();
                    readerErreur.Read();
                    readerErreur.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogChargement("ERR", "Impossible d'insérer dans Log_Job_Connecteur");
                }
            }

