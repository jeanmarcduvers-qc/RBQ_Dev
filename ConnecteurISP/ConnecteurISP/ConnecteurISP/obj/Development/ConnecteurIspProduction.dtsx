        public void TraiteConnecteur()
        {
            SchemasUser = "[MTR\\" + userlogin.ToString() + "].";

            String date = DateTime.Now.ToString("yyyy-MM-dd hh:mm:ss");
            String EnvoyePar = Dts.Variables["User::EnvoyePar"].Value.ToString();
            string ServerNameSql = @Dts.Variables["User::ServerName"].Value.ToString();
            string ConnectStringAccess = @Dts.Variables["User::ConnectStringAccess"].Value.ToString();

            SqlConnection mySQLConnection = Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction) as SqlConnection;
            OleDbConnection connectionAccess = new OleDbConnection(ConnectStringAccess);

            siteUrl = @Dts.Variables["User::URL_SharePoint"].Value.ToString();


            // Connecter à la BD   
            try
            {
                InsertTableLogChargement("ConnecteurISP", "connectionAccess.Open()");
                connectionAccess.Open();
            }
            catch (Exception ex)
            {
                //MessageBox.Show(ex.Message);
                blErreurExecution = true;
                InsertTableLogJobConnecteur("connectionAccess.Open()", ex.Message.ToString());
            }

            if (blErreurExecution != true)
            {
                // delete l'historique du dernier log de chargement
                // DeleteTableLogChargement();
                // DeleteTableLogJobChargement();

                InsertTableLogChargement("ConnecteurISP", "Début du traitement");

                // load la table ChargementFichiersExternes et DossierArchive
                LoadChargementFichiersExternes();
                LoadDossierArchive();

                // Lire le répertoire 
                DirectoryInfo d = new DirectoryInfo(@oRepertoireChargement);
                try
                {

                    FileInfo[] Files = d.GetFiles("*.xlsx");

                    foreach (FileInfo file in Files)
                    {
                        blErreurExecution = false;
                        dtDateDebut = DateTime.Now;
                        try
                        {
                            ReadDataExcel(@oRepertoireChargement + file.Name);
                        }
                        catch (Exception ex)
                        {
                            //MessageBox.Show(ex.Message);
                            blErreurExecution = true;
                            InsertTableLogJobConnecteur("ReadDataExcel()", ex.Message.ToString());
                        }

                        if (blErreurExecution)
                        {
                            DeplacerFichier(@oRepertoireChargement + file.Name, oRepertoireNonConforme + file.Name);
                            InsertTableLogChargement("ConnecteurISP", "Erreur fichier :: " + file.Name.ToString());
                            InsertTableLogJobISP(file.Name.ToString(), "Insuccès");
                            blErreurExecution = true;
                        }
                        else
                        {
                            DeplacerFichier(@oRepertoireChargement + file.Name, @oRepertoireArchive + file.Name);
                            InsertTableLogChargement("ConnecteurISP", "Fin du traitement fichier :: " + file.Name.ToString());
                            InsertTableLogJobISP(file.Name.ToString(), "Succès");
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("TraiteConnecteur()", ex.Message.ToString());
                }
            }

            if (blErreurExecution)
            {
                Email_Send("Erreur système", oRepertoireNonConforme, oAdresseFichierNonConforme);
                blErreurExecution = true;
            }
            connectionAccess.Close();

