                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     déplace le fichier
            ///
            /////////////////////////////////////////////////////////////////////
            void DeplacerFichier(string de, string a)
            {
                try
                {
                    if (System.IO.File.Exists(a))
                    {
                        System.IO.File.Delete(a);
                    }
                    System.IO.File.Move(de, a);
                }
                catch (IOException ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("DeplacerFichier()", ex.Message.ToString());
                }
            }
            //////////////////////////////////////////////////////////////////////
            ///
            //     envois courriel
            ///
            /////////////////////////////////////////////////////////////////////
            void Email_Send(string pnomFichier, string pnomRepertoire, string pAdresseNonConforme)
            {
                String strAfficheErreur = "";
                String EnvoisCourrielPar = Dts.Variables["User::EnvoyePar"].Value.ToString();
                String EnvoisCourrielA = pAdresseNonConforme.ToString();
                String EnvoisCourrielSuject = "L'application (Connecteur ISP) a un Fichier non conforme - Rendez-vous SharePoint ";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine +
                                             "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boîte Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";
                // Lire les règles d'affaire
                strAfficheErreur = strAfficheErreur.ToString() + "Ce fichier de rendez-vous est non conforme : " + pnomFichier + "." + newLine +
                                                 "Ce rendez-vous n'a pas été importé dans l'outil Sharepoint." + newLine +
                                                 "Il a été déposé dans le répertoire suivant : " + pnomRepertoire + newLine;

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + strAfficheErreur.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();

                String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("SendMail()", ex.Message.ToString());
                }
            }
            //////////////////////////////////////////////////////////////////////
            ///
            //     calcul la date du rendez-vous
            ///
            /////////////////////////////////////////////////////////////////////
            List<DateTime> CalculerDatesRDV(int pintNbOcc, DateTime pdtDateDeb, DateTime pdtDateFin, string pstrJours, string pstrFreq)
            {
                List<DateTime> olCol = new List<DateTime>();

                //tableaux
                string[] arrAllJour = new string[0];

                //caractères, numériques et booléens
                DateTime dtDimSemCour;
                DateTime pdtDateTraitePreced;
                int intJourSem;


                //déterminer les jours ou appliquer la récurrence
                arrAllJour = pstrJours.Split(';');
                int[] arrAllJourRang = new int[arrAllJour.Count()];

                //calculer le rang dans la semaine ou se trouvent ces jours si nécessaire
                if (arrAllJour.Count() > 0)
                {
                    for (int columnNum = 0; columnNum <= arrAllJour.Count() - 1; columnNum++)
                    {
                        arrAllJourRang[columnNum] = NoJourSem(arrAllJour[columnNum].ToLower());
                    }
                }

                //----------------
                // CALCUL
                //----------------
                //première date est spécifiée
                olCol.Add(pdtDateDeb);
                pdtDateTraitePreced = pdtDateDeb;


                //retrouver le dimanche de la semaine de début
                intJourSem = (int)pdtDateDeb.DayOfWeek;

                dtDimSemCour = pdtDateDeb.AddDays(-intJourSem);
                // trace de debug Yves InsertTableLogChargement("ConnecteurISP", "La première journée de la semaine est :: " + dtDimSemCour.ToString());

                //ajouter une journée au jour de la semaine pour ne pas traiter la date de début
                intJourSem = intJourSem + 1;

                //boucler tant qu'on n'a pas dépassé le nb d'occurence ou date de fin
                while ((olCol.Count < pintNbOcc) || (dtDimSemCour <= pdtDateFin))
                {
                    // boucler sur les jours de la semaine souhaités
                    for (int columnNum = 0; columnNum <= arrAllJourRang.Count() - 1; columnNum++)
                    {
                        if (arrAllJourRang[columnNum] >= intJourSem)
                        {
                            //si le jour souhaité est à venir, l'ajouter
                            if (pdtDateTraitePreced != dtDimSemCour.AddDays(arrAllJourRang[columnNum] - 1))
                            {
                                olCol.Add(dtDimSemCour.AddDays(arrAllJourRang[columnNum] - 1));
                                //initialiser le jour actuel au jour de la semaine souhaité qu'on vient de traiter
                                pdtDateTraitePreced = dtDimSemCour.AddDays(arrAllJourRang[columnNum] - 1);
                                intJourSem = arrAllJourRang[columnNum] + 1;
                            }
                        }
                    }
                    //réinitialiser le jour de la semaine au dimanche pour traiter une prochaine semaine et calculer le dimanche de départ
                    intJourSem = 1;

                    dtDimSemCour = dtDimSemCour.AddDays(7 * CalculerFacteurFrequence(pstrFreq));
                }

                //gestion spéciale pour si on fonctionne par date de fin, l'ajouter automatiquement
                if (pdtDateFin != null && pdtDateFin.Year.ToString() != "2000")
                {
                    olCol.Add(pdtDateFin);
                }

                return olCol;
            }
            //////////////////////////////////////////////////////////////////////
            ///
            //     Traite les exceptions qui ne sont pas traités pas les
            //     correspondances (champs calculés, les conditions et autres)
            ///
            /////////////////////////////////////////////////////////////////////
            void TraiteException()
            {
                // Variable SharePoint
                InsertTableLogChargement("ConnecteurISP", "TraiteException");

                ClientContext ctx = new ClientContext(siteUrl);
                ctx.ExecutingWebRequest += new EventHandler<WebRequestEventArgs>(ctx_MixedAuthRequest);
                // Initialise l'authentification
                ctx.AuthenticationMode = ClientAuthenticationMode.Default;
                ctx.Credentials = System.Net.CredentialCache.DefaultCredentials;

                List DemandeRv = ctx.Web.Lists.GetByTitle("Liste des demandes de Rendez-vous");
                ListItemCreationInformation itemInfo = new ListItemCreationInformation();

                string strNbOcc = checkExcelColumnInfo.strValeur[checkExcelColumnInfo.strNomColonneExcel.FindIndex(x => x.ToString() == "recurrenceSouhaiteeFinOccurencesNombre")].ToString(); // "U"
                string strOccSouhaitjour = checkExcelColumnInfo.strValeur[checkExcelColumnInfo.strNomColonneExcel.FindIndex(x => x.ToString() == "recurrenceSouhaiteeJour")].ToString(); // "R"
                string strOccSouhaitInterval = checkExcelColumnInfo.strValeur[checkExcelColumnInfo.strNomColonneExcel.FindIndex(x => x.ToString() == "recurrenceSouhaitee")].ToString(); // "Q"
                string strOccSouhaitFinJourDate = checkExcelColumnInfo.strValeur[checkExcelColumnInfo.strNomColonneExcel.FindIndex(x => x.ToString() == "recurrenceSouhaiteeFinJourDate")].ToString(); // "T"
                string strnoConfirmation = checkExcelColumnInfo.strValeur[checkExcelColumnInfo.strNomColonneExcel.FindIndex(x => x.ToString() == "noConfirmation")].ToString(); // "W"

                // Trouver les jours ou appliquer la récurrence
                string[] alJours = strOccSouhaitjour.Split(';');

                // Récupèrer la date de début
                DateTime dlDateDebut = DateTime.ParseExact(checkExcelColumnInfo.strValeur[checkExcelColumnInfo.strNomColonneExcel.FindIndex(x => x.ToString() == "dateSouhaitee")].ToString(), "dd/MM/yyyy", null); // "M"
                string strdureeSouhaitee = checkExcelColumnInfo.strValeur[checkExcelColumnInfo.strNomColonneExcel.FindIndex(x => x.ToString() == "dureeSouhaitee")].ToString(); // "P"

                DateTime dlDateFinValid;
                DateTime dlDateFin;
                DateTime dlOccSouhaitFinJourDate = DateTime.ParseExact("01/01/2000", "dd/MM/yyyy", null);
                DateTime dlDateCour = DateTime.ParseExact("01/01/2000", "dd/MM/yyyy", null);
                List<DateTime> olColDateRDV = new List<DateTime>();
                int intCpt;

                // Si valeur null ou vide inscrire 0
                if (string.IsNullOrEmpty(strNbOcc))
                {
                    strNbOcc = "0";
                }

                // Récupèrer la date de fin
                if (string.IsNullOrEmpty(strOccSouhaitFinJourDate) != true)
                {
                    dlDateFin = DateTime.ParseExact(strOccSouhaitFinJourDate, "dd/MM/yyyy", null);
                    dlDateFinValid = DateTime.ParseExact(strOccSouhaitFinJourDate, "dd/MM/yyyy", null);
                    dlOccSouhaitFinJourDate = DateTime.ParseExact(strOccSouhaitFinJourDate, "dd/MM/yyyy", null);
                }
                else
                {
                    dlDateFin = DateTime.ParseExact("01/01/2000", "dd/MM/yyyy", null);
                    dlDateFinValid = DateTime.ParseExact("01/01/2000", "dd/MM/yyyy", null);
                    dlDateCour = DateTime.ParseExact("01/01/2000", "dd/MM/yyyy", null);
                }

                ////////////////////////////////////////////
                ///
                /// 
                olColDateRDV = CalculerDatesRDV(int.Parse(strNbOcc), dlDateDebut, dlDateFin, strOccSouhaitjour.ToString(), strOccSouhaitInterval.ToString());

                for (int columnNum = 0; columnNum <= olColDateRDV.Count() - 1; columnNum++)
                {

                    intCpt = columnNum + 1;

                    if (string.IsNullOrEmpty(strOccSouhaitFinJourDate) && strNbOcc == "0" && string.IsNullOrEmpty(dlDateDebut.ToString()))
                    {
                        olColDateRDV.RemoveAt(columnNum);
                        break;
                    }

                    if (olColDateRDV[columnNum] > dlDateFinValid && dlDateFinValid.Year.ToString() != "2000")
                    {
                        olColDateRDV.RemoveAt(columnNum);
                        break;

                    }

                    if ((intCpt > int.Parse(strNbOcc) && strNbOcc != "0"))
                    {
                        olColDateRDV.RemoveAt(columnNum);
                        break;
                    }

                    if (((columnNum > int.Parse(strNbOcc) && dlDateFinValid.Year.ToString() == "2000")
                    || ((olColDateRDV[columnNum] > dlDateFinValid && string.IsNullOrEmpty(strOccSouhaitjour))
                    || (olColDateRDV[columnNum] == dlDateCour)
                    || ((dlDateFinValid.Year.ToString() != "2000") && strNbOcc != "0" && olColDateRDV[columnNum] > dlDateFinValid)))
                    && olColDateRDV.Count() > 1)
                    {
                        olColDateRDV.RemoveAt(columnNum);
                    }
                    else
                    {

                        ListItem listItem = DemandeRv.AddItem(itemInfo);

                        for (int ExcelcolumnNum = 0; ExcelcolumnNum <= checkExcelColumnInfo.strNomColonneNameExcel.Count - 1; ExcelcolumnNum++)
                        {

                            if (((checkExcelColumnInfo.strGroupement[ExcelcolumnNum].ToString() != "") && (checkExcelColumnInfo.boolTraite[ExcelcolumnNum] != true) && (checkExcelColumnInfo.boolIndicateurException[ExcelcolumnNum] != true))
                                || (checkExcelColumnInfo.strGroupement[ExcelcolumnNum].ToString() == "") && (checkExcelColumnInfo.boolIndicateurException[ExcelcolumnNum] != true))
                            {
                                if (checkExcelColumnInfo.strGroupement[ExcelcolumnNum].ToString() != "")
                                {
                                    listItem[checkExcelColumnInfo.strNomColonneSharePoint[ExcelcolumnNum].ToString()] = InitColonneValeursTraitees(checkExcelColumnInfo.strGroupement[ExcelcolumnNum].ToString(), checkExcelColumnInfo.strFormatage[ExcelcolumnNum].ToString(), ExcelcolumnNum);
                                    if (blValeurGroupementIsNUll == true)
                                    {
                                        listItem[checkExcelColumnInfo.strNomColonneSharePoint[ExcelcolumnNum].ToString()] = "";
                                    }
                                }
                                else
                                {
                                    if (string.IsNullOrEmpty(checkExcelColumnInfo.strMasque.ToString()) != true)
                                    {
                                        listItem[checkExcelColumnInfo.strNomColonneSharePoint[ExcelcolumnNum].ToString()] = GetText(checkExcelColumnInfo.strValeur[ExcelcolumnNum].ToString(), checkExcelColumnInfo.strType[ExcelcolumnNum].ToString());
                                    }
                                    else
                                    {
                                        listItem[checkExcelColumnInfo.strNomColonneSharePoint[ExcelcolumnNum].ToString()] = InitMasque(checkExcelColumnInfo.strValeur[ExcelcolumnNum].ToString(), checkExcelColumnInfo.strMasque[ExcelcolumnNum].ToString());
                                    }
                                }
                            }
                        }

                        // Initialise traité groupement à false
                        InitTraiteeFalse();
                        dlDateCour = DateTime.Parse(olColDateRDV[columnNum].ToString().Replace("00:00:00", "13:00:00"));

                        // Récupère la Date Souhaitée
                        listItem["Datesouhaite"] = DateTime.Parse(GetText(dlDateCour.ToString(), "D"));

                        // Récupère la date de fin de Rendez-vous
                        if ((strNbOcc.ToString() != "0") || (string.IsNullOrEmpty(strOccSouhaitFinJourDate) != true))
                        {
                            listItem["DateFin"] = DateTime.Parse(GetText(dlOccSouhaitFinJourDate.ToString().Replace("00:00:00", "13:00:00"), "D"));
                        }

                        // Récupère le numéro de confirmation
                        if ((strNbOcc.ToString() == "0") && string.IsNullOrEmpty(strOccSouhaitFinJourDate))
                        {
                            listItem["NumeroCofirmation"] = strnoConfirmation.Substring(12, (strnoConfirmation.Length - 12));
                        }
                        else
                        {
                            listItem["NumeroCofirmation"] = strnoConfirmation.Substring(12, (strnoConfirmation.Length - 12)) + "-" + intCpt.ToString();
                        }

                        // Si c'est le premier Rendez-vous
                        if (intCpt == 1)
                        {
                            listItem["Demandeprincipale"] = "true";
                        }
                        else
                        {
                            listItem["Demandeprincipale"] = "false";
                        }

                        // trace de debug Yves InsertTableLogChargement("ConnecteurISP", "La date souhaitée est :: " + listItem["Datesouhaite"].ToString());

                        listItem.Update();

                        try
                        {
                            ctx.ExecuteQuery();
                        }
                        catch (Exception ex)
                        {
                            //MessageBox.Show(ex.Message);
                            blErreurExecution = true;
                            InsertTableLogJobConnecteur("ctx.ExecuteQuery()", ex.Message.ToString());
                        }
                    }
                }
            }
            void ctx_MixedAuthRequest(object sender, WebRequestEventArgs e)
            {
                try
                {
                    //Add the header that tells SharePoint to use Windows authentication.
                    e.WebRequestExecutor.RequestHeaders.Add(
                    "X-FORMS_BASED_AUTH_ACCEPTED", "f");
                }
                catch (Exception ex)
                {
                    //MessageBox.Show("Error setting authentication header: " + ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("ctx_MixedAuthRequest()", ex.Message.ToString());
                }
            }
        }
        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion

    }
}]]></ProjectItem>
