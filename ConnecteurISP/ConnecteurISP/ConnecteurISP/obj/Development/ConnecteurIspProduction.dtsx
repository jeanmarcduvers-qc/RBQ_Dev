            ////////////////////////////////////////////////////////////////////////
            ///
            //     Lire le fichier Excel
            ///
            ///////////////////////////////////////////////////////////////////////
            void ReadDataExcel(string strNomFichierExcel)
            {
                string sSheetName = null;
                string sConnection = null;
                int position = 0;

                DataTable dtTablesList = default(DataTable);
                OleDbCommand oleExcelCommand = default(OleDbCommand);
                OleDbDataReader oleExcelReader = default(OleDbDataReader);
                OleDbConnection oleExcelConnection = default(OleDbConnection);

                sConnection = "Provider=Microsoft.ACE.OLEDB.12.0;Data Source=" + strNomFichierExcel + "; Extended Properties=\"Excel 12.0;HDR=No;IMEX=1\"";
                //sConnection = "Provider=Microsoft.ACE.OLEDB.16.0;Data Source=" + strNomFichierExcel + "; Extended Properties=\"Excel 12.0;HDR=No;IMEX=1\"";

                oleExcelConnection = new OleDbConnection(sConnection);

                try
                {
                    oleExcelConnection.Open();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("oleExcelConnection.Open()", ex.Message.ToString());
                }

                if (blErreurExecution != true)
                {
                    dtTablesList = oleExcelConnection.GetSchema("Tables");

                    if (dtTablesList.Rows.Count > 0)
                    {
                        sSheetName = dtTablesList.Rows[0]["TABLE_NAME"].ToString();
                    }

                    dtTablesList.Clear();
                    dtTablesList.Dispose();

                    if (!string.IsNullOrEmpty(sSheetName))
                    {
                        oleExcelCommand = oleExcelConnection.CreateCommand();
                        oleExcelCommand.CommandText = "Select * From [" + sSheetName + "]";
                        oleExcelCommand.CommandType = CommandType.Text;
                        InitTraiteeCorrespondance();
                        LoadCorrespondance();
                        firstRow = true;

                        using (oleExcelReader = oleExcelCommand.ExecuteReader())
                        {
                            while (oleExcelReader.Read())
                            {
                                if (firstRow)
                                {
                                    for (int columnNum = 0; columnNum <= oleExcelReader.FieldCount - 1; columnNum++)
                                    {
                                        if (checkMesCorrespondances.strNomColonneExcel.Contains(oleExcelReader[columnNum].ToString()))
                                        {
                                            position = checkMesCorrespondances.strNomColonneExcel.FindIndex(x => x.ToString() == oleExcelReader[columnNum].ToString());

                                            checkExcelColumnInfo.strNomColonneNameExcel.Add(oleExcelReader.GetName(columnNum).ToString());

                                            checkExcelColumnInfo.strNomColonneExcel.Add(checkMesCorrespondances.strNomColonneExcel[position].ToString());
                                            checkExcelColumnInfo.strNomColonneSharePoint.Add(checkMesCorrespondances.strNomColonneSharePoint[position].ToString());
                                            checkExcelColumnInfo.strGroupement.Add(checkMesCorrespondances.strGroupement[position].ToString());
                                            checkExcelColumnInfo.intOrdreGroupement.Add((int)checkMesCorrespondances.intOrdreGroupement[position]);
                                            checkExcelColumnInfo.strFormatage.Add(checkMesCorrespondances.strFormatage[position].ToString());
                                            checkExcelColumnInfo.strType.Add(checkMesCorrespondances.strType[position].ToString());
                                            checkExcelColumnInfo.boolIndicateurException.Add(checkMesCorrespondances.boolIndicateurException[position]);
                                            checkExcelColumnInfo.strValeur.Add("");
                                            checkExcelColumnInfo.boolTraite.Add(false);
                                            checkExcelColumnInfo.strMasque.Add(checkMesCorrespondances.strMasque[position].ToString());

                                            if (((checkMesCorrespondances.strGroupement[position].ToString() != "") && (checkMesCorrespondances.boolTraite[position] != true) && (checkMesCorrespondances.boolIndicateurException[position] != true))
                                                || (checkMesCorrespondances.strGroupement[position].ToString() == "") && (checkMesCorrespondances.boolIndicateurException[position] != true))
                                            {
                                                InitColonneTraitee(checkMesCorrespondances.strGroupement[position].ToString(), columnNum);
                                            }
                                        }
                                    }
                                    firstRow = false;
                                }
                                else
                                {
                                    InitTraiteeFalse();
                                    for (int columnNum = 0; columnNum <= oleExcelReader.FieldCount - 1; columnNum++)
                                    {
                                        if ((checkExcelColumnInfo.strNomColonneNameExcel.Contains(oleExcelReader.GetName(columnNum).ToString())))
                                        {
                                            position = checkExcelColumnInfo.strNomColonneNameExcel.FindIndex(x => x.ToString() == oleExcelReader.GetName(columnNum).ToString());
                                            checkExcelColumnInfo.strValeur[position] = oleExcelReader[columnNum].ToString();
                                        }
                                    }

                                    // Traite les exceptions champs calculés, les conditions, autres et les dates récurentes et insert dans SharePoint  la demande de rendez-vous
                                    TraiteException();
                                }
                            }
                        }

                        oleExcelReader.Close();
                    }
                    oleExcelConnection.Close();
                }
                else
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("Traite Erreur Excel", strNomFichierExcel.ToString());
                }

            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Initialise les valeurs des structures de correspondances
            ///
            ///////////////////////////////////////////////////////////////////////
            void InitTraiteeCorrespondance()
            {
                checkMesCorrespondances = new MesCorrespondances()
                {
                    strNomColonneExcel = new List<string>(),
                    strNomColonneSharePoint = new List<string>(),
                    intOrdreUtilisation = new List<int>(),
                    strGroupement = new List<String>(),
                    intOrdreGroupement = new List<int>(),
                    strFormatage = new List<String>(),
                    strType = new List<String>(),
                    boolIndicateurException = new List<bool>(),
                    boolTraite = new List<bool>(),
                    strMasque = new List<String>()
                };

                checkExcelColumnInfo = new excelColumnsInfo()
                {
                    strNomColonneExcel = new List<string>(),
                    strNomColonneSharePoint = new List<string>(),
                    strNomColonneNameExcel = new List<string>(),
                    strGroupement = new List<string>(),
                    strFormatage = new List<String>(),
                    intOrdreGroupement = new List<int>(),
                    strValeur = new List<string>(),
                    strType = new List<String>(),
                    boolIndicateurException = new List<bool>(),
                    boolTraite = new List<bool>(),
                    strMasque = new List<String>()
                };

                Collection = new List<string>();
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Initialise les colonnes groupées et à traiter
            ///
            ///////////////////////////////////////////////////////////////////////
            void InitColonneTraitee(string strGroupeName, int pcolumnNum)
            {
                for (int columnNum = pcolumnNum; columnNum <= checkMesCorrespondances.strNomColonneExcel.Count - 1; columnNum++)
                {
                    if (checkMesCorrespondances.strGroupement[columnNum].ToString() == strGroupeName.ToString())
                    {
                        checkMesCorrespondances.boolTraite[columnNum] = true;
                    }

                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Initialise les valeurs des colonnes groupées et à traiter
            ///
            ///////////////////////////////////////////////////////////////////////
            string InitColonneValeursTraitees(string strGroupeName, string pstrFormatage, int pcolumnNum)
            {
                string strMessage = "";
                string strValeur = "";


                for (int columnNum = pcolumnNum; columnNum <= checkExcelColumnInfo.strNomColonneNameExcel.Count - 1; columnNum++)
                {
                    if (checkExcelColumnInfo.strGroupement[columnNum].ToString() == strGroupeName.ToString())
                    {
                        strValeur = InitMasque(checkExcelColumnInfo.strValeur[columnNum].ToString(), checkExcelColumnInfo.strMasque[columnNum].ToString());
                        if (string.IsNullOrEmpty(strValeur) == true)
                        {
                            blValeurGroupementIsNUll = true;
                        }
                        else
                        {
                            blValeurGroupementIsNUll = false;
                        }
                        strValeur = strValeur.Replace("'", "''").ToString();
                        pstrFormatage = pstrFormatage.Replace("%" + checkExcelColumnInfo.intOrdreGroupement[columnNum].ToString(), strValeur.ToString());
                        strMessage = pstrFormatage.ToString();
                        checkExcelColumnInfo.boolTraite[columnNum] = true;
                    }
                }
                return GetText(pstrFormatage.ToString(), "C");
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Initialise les valeurs selon le masque d'affichage à traiter
            ///
            ///////////////////////////////////////////////////////////////////////
            string InitMasque(string pstrValeur, string pstrMasque)
            {
                string strValeur = "";

                if (string.IsNullOrEmpty(pstrMasque) != true)
                {
                    strValeur = int.Parse(pstrValeur).ToString(pstrMasque.ToString());
                }
                else
                {
                    strValeur = pstrValeur;
                }

                return GetText(strValeur.ToString(), "C");
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Initialise les valeurs de la colonne groupée à traiter
            ///
            ///////////////////////////////////////////////////////////////////////
            void InitTraiteeFalse()
            {

                for (int columnNum = 0; columnNum <= checkExcelColumnInfo.strNomColonneNameExcel.Count - 1; columnNum++)
                {
                    checkExcelColumnInfo.boolTraite[columnNum] = false;
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Load correspondance
            ///
            ///////////////////////////////////////////////////////////////////////
            void LoadCorrespondance()
            {
                string sqlCorrCmd = tblCorrespondance.ToString();
                OleDbCommand commandDataReader = new OleDbCommand(sqlCorrCmd, connectionAccess);
                string varOrderUtilisation;

                try
                {
                    using (OleDbDataReader readerCorr = commandDataReader.ExecuteReader())
                    {
                        // Lire les occurrences de la table LoadTable
                        while (readerCorr.Read())
                        {
                            varOrderUtilisation = readerCorr["OrdreUtilisation"].ToString();
                            checkMesCorrespondances.strNomColonneExcel.Add(readerCorr["NomColonneExcel"].ToString());
                            checkMesCorrespondances.strNomColonneSharePoint.Add(readerCorr["NomColonneSharePoint"].ToString());
                            checkMesCorrespondances.intOrdreUtilisation.Add((int)readerCorr["OrdreUtilisation"]);
                            checkMesCorrespondances.strFormatage.Add(readerCorr["Formatage"].ToString());
                            checkMesCorrespondances.strGroupement.Add(readerCorr["Groupement"].ToString());
                            checkMesCorrespondances.intOrdreGroupement.Add((int)readerCorr["OrdreGroupement"]);
                            checkMesCorrespondances.strType.Add(readerCorr["TypeChamp"].ToString());
                            checkMesCorrespondances.boolIndicateurException.Add((bool)readerCorr["IndicateurException"]);
                            checkMesCorrespondances.boolTraite.Add(false);
                            checkMesCorrespondances.strMasque.Add(readerCorr["Masque"].ToString());
                        }
                        readerCorr.Close();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    blErreurExecution = true;
                    InsertTableLogJobConnecteur("LoadCorrespondance()", ex.Message.ToString());
                }

            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Retourne la valeur formatée selon le type
            ///
            ///////////////////////////////////////////////////////////////////////
            string GetText(string strValeur, string strType)
            {
                string text;
                switch (strType)
                {
                    case "C":
                        text = strValeur.ToString();
                        break;
                    case "D":
                        text = strValeur.ToString().Replace("00:00:00", "13:00:00");
                        break;
                    case "N":
                        text = strValeur.ToString();
                        break;
                    default:
                        text = strValeur.ToString();
                        break;
                }

                if (text == "''") { text = "NULL"; }
                return text;
            }

