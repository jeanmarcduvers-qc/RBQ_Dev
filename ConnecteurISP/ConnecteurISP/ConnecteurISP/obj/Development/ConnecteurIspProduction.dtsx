                string sqlInsCmd = "insert into Log_Jobs values('Auto01', 'ConnecteurISP', '" + dtDateDebut + "', '" + DateTime.Now + "', '" + pAction.ToString() + "', '" + pNomFichierCharger.ToString() + "', null, null)";

                try
