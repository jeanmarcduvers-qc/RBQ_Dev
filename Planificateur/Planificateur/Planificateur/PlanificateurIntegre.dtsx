        #endregion

        public const string tblPlanificateur = "SELECT  [IndSystem], " +
                                                    "[CodeTraitement], " +
                                                    "[TableFichierIn], " +
                                                    "[TableFichierOut], " +
                                                    "[LigneIntruction], " +
                                                    "[TypeTraitement], " +
                                                    "[FormatFichier], " +
                                                    "[NomColonneEntrée], " +
