        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        public void Main()
        {
            TraitePlanificateur();
            Dts.TaskResult = (int)ScriptResults.Success;
        }


        public void TraitePlanificateur()
        {
            bool succesLoadTable = true;
            bool LoadTableErreur = false;
            bool TraiteTache = false;
            string strMessageSql = "";
            string Etape = "TraitePlanificateur()";
            SchemasUser = "MTR.";

            string date = DateTime.Now.ToString("yyyy-MM-dd hh:mm:ss");
            string EnvoyePar = Dts.Variables["User::EnvoyePar"].Value.ToString();

            SqlConnection mySQLConnection =
                Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                as SqlConnection;

            SqlConnection mySQLConnectionPlanificateur =
                Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                as SqlConnection;

            // delete l'historique du dernier log de chargement
            DeleteTableLogJobChargement();
            InsertTableLogPlanificateur("Planificateur", "Début du traitement");

            // Creation de la commande
            SqlCommand commandPlanificateur = new SqlCommand(tblPlanificateur.ToString(), mySQLConnectionPlanificateur);

            // Exécute la requete
            try
            {

                // Exécute la commande  
                using (SqlDataReader reader = commandPlanificateur.ExecuteReader())
                {
                    // Lire les occurrences de la table LoadTable
                    while (reader.Read())
                    {
                        succesLoadTable = true;

                        strIndSystem = reader["IndSystem"].ToString();
                        strCodeTraitement = reader["CodeTraitement"].ToString();
                        strTableFichierIn = reader["TableFichierIn"].ToString();
                        strTableFichierOut = reader["TableFichierOut"].ToString();
                        strTypeTraitement = reader["TypeTraitement"].ToString();
                        strFormatFichier = reader["FormatFichier"].ToString();
                        strNomColonneEntrée = reader["NomColonneEntrée"].ToString();
                        strNomColonneSortie = reader["NomColonneSortie"].ToString();
                        strConnectCheminEntrée = reader["ConnectCheminEntrée"].ToString();
                        strConnectCheminSortie = reader["ConnectCheminSortie"].ToString();
                        strLigneIntruction = reader["LigneIntruction"].ToString();
                        strCourrielA = reader["CourrielA"].ToString();
                        strCourrielCC = reader["CourrielCC"].ToString();
                        strObjetCourriel = reader["ObjetCourriel"].ToString();
                        strContenuCourriel = reader["ContenuCourriel"].ToString();
                        blJoindreFichier = (bool)reader["JoindreFichier"];
                        blTraiteLundi = (bool)reader["TraiteLundi"];
                        blTraiteMardi = (bool)reader["TraiteMardi"];
                        blTraiteMercredi = (bool)reader["TraiteMercredi"];
                        blTraiteJeudi = (bool)reader["TraiteJeudi"];
                        blTraiteVendredi = (bool)reader["TraiteVendredi"];
                        blTraiteSamedi = (bool)reader["TraiteSamedi"];
                        blTraiteDimanche = (bool)reader["TraiteDimanche"];
                        blTraiteSemaine = (bool)reader["TraiteSemaine"];
                        intTraiteLaJournée = (int)reader["TraiteLaJournée"];
                        arrTraiteHeureDeLaJournée = reader["TraiteHeureDeLaJournée"].ToString().Split(';');
                        blStatutActif = (bool)reader["StatutActif"];
                        intLoadSort = (int)reader["LoadSort"];
                        DtDerniereExecution = reader["DtDerniereExecution"].ToString();

                        TraiteTache = false;

                        if (arrTraiteHeureDeLaJournée[0] == "")
                        {
                            TraiteTache = true;
                        }
                        else
                        {

                            if ((DtDerniereExecution.ToString() == "") || (Int32.Parse(oStartJob.Substring(0, 10).Replace("-", "")) > Int32.Parse(DtDerniereExecution.Substring(0, 10).Replace("-", ""))))
                            {
                                for (int columnNum = 0; columnNum <= arrTraiteHeureDeLaJournée.Count() - 1; columnNum++)
                                {
                                    if ((arrTraiteHeureDeLaJournée[columnNum].ToString() != "") && (Int32.Parse(arrTraiteHeureDeLaJournée[columnNum].ToString().Replace(":", "")) <= Int32.Parse(oStartJob.Substring(11, 5).Replace(":", ""))) &&
                                        TraiteTache != true)
                                    {
                                        TraiteTache = true;
                                        columnNum = arrTraiteHeureDeLaJournée.Count();
                                    }
                                }
                            }
                            else
                            {
                                for (int columnNum = 0; columnNum <= arrTraiteHeureDeLaJournée.Count() - 1; columnNum++)
                                {
                                    if ((arrTraiteHeureDeLaJournée[columnNum].ToString() != "") &&
                                        (Int32.Parse(arrTraiteHeureDeLaJournée[columnNum].ToString().Replace(":", "")) <= Int32.Parse(oStartJob.Substring(11, 5).Replace(":", "")) &&
                                        Int32.Parse(arrTraiteHeureDeLaJournée[columnNum].ToString().Replace(":", "")) > Int32.Parse(DtDerniereExecution.Substring(11, 5).Replace(":", "")) &&
                                        TraiteTache != true))
                                    {
                                        TraiteTache = true;
                                        columnNum = arrTraiteHeureDeLaJournée.Count();
                                    }
                                }
                            }
                        }

                        if (blStatutActif && TraiteTache)
                        {
                            Etape = "TraitePlanificateur()";

                            switch (strTypeTraitement.ToString())
                            {
                                case "Access":
                                case "SqlServer":
                                case "Excel":
                                    TransferTableToSqlServer(strTableFichierIn.ToString(), strTableFichierOut.ToString(), strNomColonneEntrée.ToString(), strNomColonneSortie.ToString());
                                    break;
                                case "SharePoint":
                                    TransferTableSharePointToSqlServer(strTableFichierIn.ToString(), strTableFichierOut.ToString(), strNomColonneEntrée.ToString(), strNomColonneSortie.ToString());
                                    break;
                                case "SQLtoCSV":
                                    SQLtoCSV(strCodeTraitement.ToString(), strTableFichierOut.ToString(), strLigneIntruction.ToString());
                                    break;
                                case "SharePointToCSV":
                                    SharePointToCSV(strTableFichierIn.ToString(), strTableFichierOut.ToString(), strNomColonneEntrée.ToString(), strNomColonneSortie.ToString());
                                    break;
                                //case "MacroAccess":
                                //    CallStoredProcedure(oCheminFichier.ToString(), oAccesFonction.ToString());
                                //    TraiteLaSuite = false;
                                //    break;
                                case "Requête":
                                    ExecuteSQL(strCodeTraitement.ToString(), strTableFichierOut.ToString(), strLigneIntruction.ToString());
                                    break;
                                case "StoreProc":
                                    ExecuteStoreProc(strCodeTraitement.ToString(), strLigneIntruction.ToString());
                                    break;
                                case "SupprimerTable":
                                    DestructionTable(strCodeTraitement.ToString(), strTableFichierIn.ToString());
                                    break;
                                case "Renommer":
                                    TransferTableSqlVersDBO(strCodeTraitement.ToString(), strTableFichierIn.ToString(), strTableFichierOut.ToString());
                                    break;
                                case "CopieFichier":
                                    CopieFichier(strCodeTraitement.ToString(), strTableFichierIn.ToString(), strTableFichierOut.ToString());
                                    break;
                                case "SupprimeFichier":
                                    SupprimeFichier(strCodeTraitement.ToString(), strTableFichierIn.ToString());
                                    break;
                                case "DecompresseFichier":
                                    DecompresseFichier(strCodeTraitement.ToString(), strTableFichierIn.ToString(), strTableFichierOut.ToString());
                                    break;
                                case "MoveFichier":
                                    MoveFichier(strCodeTraitement.ToString(), strTableFichierIn.ToString(), strTableFichierOut.ToString());
                                    break;
                                case "ExecSSIS":
                                    ExecSSIS(strCodeTraitement.ToString(), strConnectCheminEntrée.ToString());
                                    break;
                                case "ExecReport":
                                    ExecReport(strTableFichierIn, strTableFichierOut, strFormatFichier);
                                    break;
                                default:
                                    InsertTableLogJobPlanificateur("TraitePlanificateur(default)", "Ce type de fichier " + strCodeTraitement.ToString() + " n'est pas traité par le Planificateur (SSIS).");
                                    succesLoadTable = false;
                                    break;
                            }

                            if (succesLoadTable == false)
                            {
                                LoadTableErreur = true;
                            }
                            else
                            {
                                if (strCourrielA != "")
                                {
                                    SendMailMessage(strCodeTraitement, EnvoyePar, strCourrielA, strCourrielCC, strObjetCourriel, strContenuCourriel, blJoindreFichier, strTableFichierOut);
                                }

                                if (LoadTableErreur == false)
                                {
                                    InsertTableLogPlanificateur(strIndSystem, strCodeTraitement);
                                    UdpatePlanificateur(strCodeTraitement);
                                }
                            }
                        }
                    }
                    reader.Close();
                }
            }
            catch (Exception ex)
            {
                //MessageBox.Show(ex.Message);
                InsertTableLogJobPlanificateur(Etape, ex.Message.ToString());
                succesLoadTable = false;
                LoadTableErreur = true;
            }

            if (LoadTableErreur == true)
            {
                // Envois un courriel si erreur de programmation (SQL ou autre)
                SendMailMessageError(EnvoyePar);
            }

            InsertTableLogPlanificateur("Planificateur", "Fin du traitement");
            mySQLConnection.Close();

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Planificateur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogPlanificateur(string strIndSystem, string strCodeTraitement)
            {
                string sqlInsCmd = "insert into[SDDMU01].[dbo].[Log_Planificateur] values('" + strIndSystem + "', '" + strCodeTraitement + "', GETDATE(), 'Auto01', 'Tâche Automatisée')";

                try
                {
                    SqlCommand SQLCommandLog = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandLog.CommandType = CommandType.Text;

                    SqlDataReader readerLog = SQLCommandLog.ExecuteReader();
                    readerLog.Read();
                    readerLog.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobPlanificateur("InsertTableLogPlanificateur()", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Job_Planificateur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogJobPlanificateur(string pfonction, string pErreurMessage)
            {
                int lParametreErreurMessage;
                pErreurMessage = pfonction + " - " + pErreurMessage;
                pErreurMessage = pErreurMessage.Replace("'", "''");
                lParametreErreurMessage = pErreurMessage.Length;

                string sqlInsCmd = "insert into [SDDMU01].[dbo].[Log_Job_Planificateur] values('Planificateur', '" + strCodeTraitement + "', '" + strTypeTraitement + "', '" + pErreurMessage + "', 'Auto01', GETDATE())";

                try
                {
                    SqlCommand SQLCommandJobErr = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandJobErr.CommandType = CommandType.Text;
                    SqlDataReader readerErreur = SQLCommandJobErr.ExecuteReader();
                    readerErreur.Read();
                    readerErreur.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogPlanificateur("ERR", "Impossible d'insérer dans Log_Job_Planificateur");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     détruit les informations dant la table Log_Job_Planificateur
            ///
            ///////////////////////////////////////////////////////////////////////
            void DeleteTableLogJobChargement()
            {
                string sqlDelCmdCharg = delLogJobChargement.ToString();

                try
                {
                    SqlCommand DelCmdCharg = new SqlCommand(sqlDelCmdCharg.ToString(), mySQLConnection);
                    DelCmdCharg.CommandType = CommandType.Text;
                    SqlDataReader readerCharg = DelCmdCharg.ExecuteReader();
                    readerCharg.Read();
                    readerCharg.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogPlanificateur("ERR", "DeleteTableLogJobChargement()");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Drop table en parametre
            ///
            ///////////////////////////////////////////////////////////////////////
            void DestructionTable(string strCodeTraitement, string pNomTableUtilise)
            {

                if (strConnectCheminEntrée != "")
                {
                    // Connecter à la BD In
                    connectionIn = new OleDbConnection(strConnectCheminEntrée.ToString());
                    connectionIn.Open();
                }

                // Valide si la table existe
                OleDbCommand checkTableIfExistsCommand = new OleDbCommand("IF OBJECT_ID('" + pNomTableUtilise.ToString() + "', 'U') IS NOT NULL drop table " + pNomTableUtilise.ToString(), connectionIn);
                checkTableIfExistsCommand.CommandType = CommandType.Text;
                OleDbDataReader readerIfExists = checkTableIfExistsCommand.ExecuteReader();
                readerIfExists.Read();
                readerIfExists.Close();
            }


            ////////////////////////////////////////////////////////////////////////
            ///
            //     Transfert la table access dans la table temporaire de SQL Server
            ///
            ///////////////////////////////////////////////////////////////////////
            void TransferTableToSqlServer(string pTableFichierIn, string pTableFichierOut, string pNomColonneEntrée, string pNomColonneSortie)
            {

                SQLColumnsInfo = new sql_ColumnsInfo()
                {
                    strInternalName = new List<string>(),
                    strFieldType = new List<string>(),
                    intMaxLength = new List<int>(),
                    strSqlFieldName = new List<string>()
                };

                string newLine = Environment.NewLine;
                string strSeparateur = "";
                string sqlCmd = "";
                string strsqlInsert = "";
                string strsqlValue = "(";
                string strGetValeur = "";
                string sqlInsCmd = "";

                if (strConnectCheminEntrée != "")
                {
                    // Connecter à la BD In
                    Etape = "TraitePlanificateur(connectionIn.Open())";
                    connectionIn = new OleDbConnection(strConnectCheminEntrée.ToString());
                    connectionIn.Open();
                }

                if (strConnectCheminSortie != "")
                {
                    // Connecter à la BD Out
                    Etape = "TraitePlanificateur(connectionOut.Open())";
                    connectionOut = new OleDbConnection(strConnectCheminSortie.ToString());
                    connectionOut.Open();
                }

                if (pNomColonneEntrée.ToString() == "" || pNomColonneEntrée.ToString() == "*")
                {
                    sqlCmd = "SELECT * FROM " + pTableFichierIn.ToString();
                }
                else
                {
                    sqlCmd = "SELECT " + pNomColonneEntrée.Replace(";", ",") + " FROM " + pTableFichierIn.ToString();
                }

                OleDbConnection OleDbConnections = new OleDbConnection();
                try
                {

                    OleDbCommand commandSourceData = new OleDbCommand(@sqlCmd, connectionIn);
                    OleDbCommand commandDataReader = new OleDbCommand(@sqlCmd, connectionIn);

                    DataTable dataReader = new DataTable();
                    Etape = "dataReader.Load";
                    dataReader.Load(commandDataReader.ExecuteReader());
                    DataColumn ttest = new DataColumn();

                    if (pNomColonneEntrée.ToString() == "" || pNomColonneEntrée.ToString() == "*")
                    {
                        pNomColonneEntrée = "";

                        foreach (DataColumn dc in dataReader.Columns)
                        {
                            pNomColonneEntrée = pNomColonneEntrée + strSeparateur + dc.ColumnName;
                            strSeparateur = ";";
                        }

                        pNomColonneSortie = pNomColonneEntrée;
                    }

                    // Information sur les colonnes et leurs définitions
                    arrNomColonneEntrée = pNomColonneEntrée.Split(';');
                    arrNomColonneSortie = pNomColonneSortie.Split(';');

                    // Valide si le nombre de colonnes en entrée et en sortie sont identiques
                    if (arrNomColonneEntrée.Count() != arrNomColonneSortie.Count())
                    {
                        InsertTableLogJobPlanificateur("TransferTableToSqlServer(Valide si le nombre de colonnes est identique)", String.Format("{0} :: Nb en entrée {1} - Nb en sortie {2}",
                                                  "Le nombre de colonnes en entrée est différent du nombre de colonnes en sortie",
                                                  arrNomColonneEntrée.Count().ToString(),
                                                  arrNomColonneSortie.Count().ToString()));
                        succesLoadTable = false;
                        return;
                    }

                    if (CreationTable(pTableFichierOut, arrNomColonneSortie, dataReader))
                    {

                        strsqlInsert = "Insert into " + pTableFichierOut.ToString() + " (" + pNomColonneSortie.Replace(";", ",") + ") Values ";
                        using (OleDbDataReader ValueReader = commandSourceData.ExecuteReader())
                        {
                            while (ValueReader.Read())
                            {
                                strSeparateur = "";

                                for (int columnNum = 0; columnNum <= SQLColumnsInfo.strInternalName.Count() - 1; columnNum++)
                                {
                                    if (SQLColumnsInfo.strFieldType[columnNum].ToString() != "" && SQLColumnsInfo.strInternalName[columnNum].ToString() != "")
                                    {
                                        try
                                        {

                                            strGetValeur = getColonneValueSQL(SQLColumnsInfo.strFieldType[columnNum], SQLColumnsInfo.strInternalName[columnNum], ValueReader);

                                            // Initialise la variable SQL
                                            strsqlValue = strsqlValue.ToString() + strSeparateur.ToString() + strGetValeur.ToString();
                                            strSeparateur = ", ";
                                        }
                                        catch (Exception ex)
                                        {
                                            //MessageBox.Show(ex.Message + " :: " + SharePointColumnsInfo.strInternalName[columnNum].ToString());f
                                            InsertTableLogJobPlanificateur("TransferTableToSqlServer(Création Body) :: " + SharePointColumnsInfo.strInternalName[columnNum].ToString(), ex.Message.ToString());
                                        }
                                    }
                                }

                                strsqlValue = strsqlValue.ToString() + ")";
                                sqlInsCmd = strsqlInsert + strsqlValue.Replace("&#39;", "''");
                                sqlInsCmd = sqlInsCmd.Replace("\r\n", "").Replace("\n", "").Replace("\r", "");
                                ExecuteInsertInto(strIndSystem, sqlInsCmd);

                                strsqlValue = "(";
                            }
                        }
                    }
                    else
                    {
                        succesLoadTable = false;
                    }

                    connectionIn.Close();
                    connectionOut.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobPlanificateur("TransferTableToSqlServer()", ex.Message.ToString());
                    succesLoadTable = false;
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Transfert la table vers un fichier csv
            ///
            ///////////////////////////////////////////////////////////////////////
            void SQLtoCSV(string strCodeTraitement, string strTableFichierOut, string strSqlRequete)
            {

                string strSeparateur = "";
                string strNomColonneSortie = "";

                if (strConnectCheminEntrée != "")
                {
                    // Connecter à la BD In
                    Etape = "TraitePlanificateur(connectionIn.Open())";
                    connectionIn = new OleDbConnection(strConnectCheminEntrée.ToString());
                    connectionIn.Open();
                }

                OleDbConnection OleDbConnections = new OleDbConnection();
                try
                {
                    OleDbCommand commandSourceData = new OleDbCommand(strSqlRequete, connectionIn);
                    OleDbCommand commandDataReader = new OleDbCommand(strSqlRequete, connectionIn);

                    DataTable dataReader = new DataTable();
                    Etape = "dataReader.Load";
                    dataReader.Load(commandDataReader.ExecuteReader());
                    DataColumn ttest = new DataColumn();

                    foreach (DataColumn dc in dataReader.Columns)
                    {
                        strNomColonneSortie = strNomColonneSortie + strSeparateur + dc.ColumnName;
                        strSeparateur = ";";
                    }


                    OleDbDataReader ValueReader = commandSourceData.ExecuteReader();
                    CreationCSV(strCodeTraitement, strTableFichierOut, strNomColonneSortie, ValueReader);
                    connectionIn.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show("ex.Message ::  " + ex.Message);
                    InsertTableLogJobPlanificateur("SQLtoCSV(" + strCodeTraitement + ")", strConnectCheminEntrée);
                    InsertTableLogJobPlanificateur("SQLtoCSV(" + strCodeTraitement + ")", ex.Message.ToString());
                    succesLoadTable = false;
                    LoadTableErreur = true;
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Création du fichier CSV
            ///
            ///////////////////////////////////////////////////////////////////////
            void CreationCSV(string strCodeTraitement, string pTableFichierOut, string pNomColonneSortie, OleDbDataReader pdataReader)
            {
                string strSeparateur = "";
                string strGetValeur = "";
                string strValue = "";

                try
                {
                    arrNomColonneSortie = pNomColonneSortie.Split(';');

                    if (System.IO.File.Exists(pTableFichierOut))
                    {
                        // Si le fichier existe le détruire
                        System.IO.File.Delete(pTableFichierOut);
                    }

                    StreamWriter sw = new StreamWriter(pTableFichierOut, true, Encoding.Unicode);
                    sw.WriteLine(pNomColonneSortie.ToString());

                    if (pdataReader.HasRows == false)
                    {
                        sw.WriteLine("Aucune valeur de disponible");
                    }
                    else
                    {
                        while (pdataReader.Read())
                        {

                            strSeparateur = "";
                            strValue = "";

                            for (int columnNum = 0; columnNum <= arrNomColonneSortie.Count() - 1; columnNum++)
                            {
                                try
                                {

                                    //strGetValeur = getColonneValueSQL(pdataReader[columnNum].GetType().Name, arrNomColonneSortie[0], pdataReader);
                                    strGetValeur = pdataReader[arrNomColonneSortie[columnNum].ToString()].ToString();

                                    // Initialise la variable SQL
                                    strValue = strValue.ToString() + strSeparateur.ToString() + strGetValeur.ToString();
                                    strSeparateur = ";";
                                }
                                catch (Exception ex)
                                {
                                    //MessageBox.Show(ex.Message + " :: " + arrNomColonneSortie[0].ToString());
                                    InsertTableLogJobPlanificateur("CreationCSV(Création Détail) :: " + arrNomColonneSortie[0].ToString(), ex.Message.ToString());
                                }
                            }

                            sw.WriteLine(strValue);
                        }
                    }

                    sw.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show("ex.Message ::  " + ex.Message);
                    InsertTableLogJobPlanificateur("CreationCSV(" + strCodeTraitement + ")", ex.Message.ToString());
                    succesLoadTable = false;
                    LoadTableErreur = true;
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Création de la table
            ///
            ///////////////////////////////////////////////////////////////////////
            bool CreationTable(string pTableFichierOut, string[] pArrNomColonneSortie, DataTable pdataReader)
            {
                int nbColonne = 0;
                var tmp = new StringBuilder("");
                var createTableBuilder = new StringBuilder("CREATE TABLE " + pTableFichierOut.ToString());
                createTableBuilder.AppendLine("(");

                // Sélectionner chacune des colonnes de la table source pour créer la table destination
                foreach (DataColumn dc in pdataReader.Columns)
                {
                    switch (dc.DataType.Name)
                    {
                        case "String":
                            if ((dc.MaxLength > 4000) || (dc.MaxLength == -1))
                            {
                                createTableBuilder.AppendLine(String.Format("[{0}] VARCHAR(MAX),",
                                  pArrNomColonneSortie[nbColonne]));
                                SQLColumnsInfo.strInternalName.Add(dc.ColumnName);
                                SQLColumnsInfo.strSqlFieldName.Add(pArrNomColonneSortie[nbColonne]);
                                SQLColumnsInfo.strFieldType.Add("TEXT");
                                SQLColumnsInfo.intMaxLength.Add(4000);

                            }
                            else
                            {
                                createTableBuilder.AppendLine(String.Format("[{0}] varchar(4000),",
                                  pArrNomColonneSortie[nbColonne]));
                                SQLColumnsInfo.strInternalName.Add(dc.ColumnName);
                                SQLColumnsInfo.strSqlFieldName.Add(pArrNomColonneSortie[nbColonne]);
                                SQLColumnsInfo.strFieldType.Add("TEXT");
                                SQLColumnsInfo.intMaxLength.Add(4000);
                            }
                            break;
                        case "Money":
                        case "Decimal":
                            createTableBuilder.AppendLine(String.Format("[{0}] decimal(19,10),",
                                 pArrNomColonneSortie[nbColonne]));
                            SQLColumnsInfo.strInternalName.Add(dc.ColumnName);
                            SQLColumnsInfo.strSqlFieldName.Add(pArrNomColonneSortie[nbColonne]);
                            SQLColumnsInfo.strFieldType.Add("NUMBER");
                            SQLColumnsInfo.intMaxLength.Add(0);
                            break;
                        case "DateTime":
                            createTableBuilder.AppendLine(String.Format("[{0}] datetime,",
                                 pArrNomColonneSortie[nbColonne]));
                            SQLColumnsInfo.strInternalName.Add(dc.ColumnName);
                            SQLColumnsInfo.strSqlFieldName.Add(pArrNomColonneSortie[nbColonne]);
                            SQLColumnsInfo.strFieldType.Add("DATETIME");
                            SQLColumnsInfo.intMaxLength.Add(0);
                            break;
                        case "Int32":
                            createTableBuilder.AppendLine(String.Format("[{0}] int,",
                                 pArrNomColonneSortie[nbColonne]));
                            SQLColumnsInfo.strInternalName.Add(dc.ColumnName);
                            SQLColumnsInfo.strSqlFieldName.Add(pArrNomColonneSortie[nbColonne]);
                            SQLColumnsInfo.strFieldType.Add("NUMBER");
                            SQLColumnsInfo.intMaxLength.Add(0);
                            break;
                        case "Boolean":
                            createTableBuilder.AppendLine(String.Format("[{0}] bit,",
                                 pArrNomColonneSortie[nbColonne]));
                            SQLColumnsInfo.strInternalName.Add(dc.ColumnName);
                            SQLColumnsInfo.strSqlFieldName.Add(pArrNomColonneSortie[nbColonne]);
                            SQLColumnsInfo.strFieldType.Add("Boolean");
                            SQLColumnsInfo.intMaxLength.Add(0);
                            break;
                        case "Single":
                            createTableBuilder.AppendLine(String.Format("[{0}] real,",
                                 pArrNomColonneSortie[nbColonne]));
                            SQLColumnsInfo.strInternalName.Add(dc.ColumnName);
                            SQLColumnsInfo.strSqlFieldName.Add(pArrNomColonneSortie[nbColonne]);
                            SQLColumnsInfo.strFieldType.Add("NUMBER");
                            SQLColumnsInfo.intMaxLength.Add(0);
                            break;
                        case "Byte":
                            createTableBuilder.AppendLine(String.Format("[{0}] tinyint,",
                                 pArrNomColonneSortie[nbColonne]));
                            SQLColumnsInfo.strInternalName.Add(dc.ColumnName);
                            SQLColumnsInfo.strSqlFieldName.Add(pArrNomColonneSortie[nbColonne]);
                            SQLColumnsInfo.strFieldType.Add("NUMBER");
                            SQLColumnsInfo.intMaxLength.Add(0);
                            break;
                        case "Int16":
                            createTableBuilder.AppendLine(String.Format("[{0}] smallint,",
                                 pArrNomColonneSortie[nbColonne]));
                            SQLColumnsInfo.strInternalName.Add(dc.ColumnName);
                            SQLColumnsInfo.strSqlFieldName.Add(pArrNomColonneSortie[nbColonne]);
                            SQLColumnsInfo.strFieldType.Add("NUMBER");
                            SQLColumnsInfo.intMaxLength.Add(0);
                            break;
                        case "Double":
                            createTableBuilder.AppendLine(String.Format("[{0}] float,",
                                 pArrNomColonneSortie[nbColonne]));
                            SQLColumnsInfo.strInternalName.Add(dc.ColumnName);
                            SQLColumnsInfo.strSqlFieldName.Add(pArrNomColonneSortie[nbColonne]);
                            SQLColumnsInfo.strFieldType.Add("NUMBER");
                            SQLColumnsInfo.intMaxLength.Add(0);
                            break;
                        default:
                            //MessageBox.Show(String.Format("{0}.[{1}] {2}",
                            //  pNomTableAccessUtilise,
                            //  dc.ColumnName,
                            //  dc.DataType.Name
                            //));
                            InsertTableLogJobPlanificateur("TransferTableToSqlServer(AppendLine)", String.Format("{0}.[{1}] {2}",
                              strTableFichierIn,
                              dc.ColumnName,
                              dc.DataType.Name));
                            succesLoadTable = false;
                            break;
                    }

                    nbColonne = nbColonne + 1;
                }

                if (succesLoadTable)
                {
                    // Valide si la table existe
                    OleDbCommand checkTableIfExistsCommand = new OleDbCommand("IF OBJECT_ID('" + pTableFichierOut.ToString() + "', 'U') IS NOT NULL drop table " + pTableFichierOut.ToString(), connectionOut);
                    checkTableIfExistsCommand.CommandType = CommandType.Text;
                    OleDbDataReader readerIfExists = checkTableIfExistsCommand.ExecuteReader();
                    readerIfExists.Read();
                    readerIfExists.Close();

                    tmp.Append(createTableBuilder.ToString().Substring(0, createTableBuilder.Length - 3));
                    createTableBuilder.Remove(0, createTableBuilder.Length);
                    createTableBuilder.Append(tmp.ToString());
                    createTableBuilder.AppendLine(")");
                    try
                    {
                        var createTableCommand = new OleDbCommand(createTableBuilder.ToString(), connectionOut);
                        createTableCommand.ExecuteNonQuery();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show("ex.Message ::  " + ex.Message);
                        InsertTableLogJobPlanificateur("CreationTable", ex.Message.ToString());
                        succesLoadTable = false;
                        return false;
                    }
                }
                else
                {
                    return false;
                }

                return true;
            }


            ////////////////////////////////////////////////////////////////////////
            ///
            //     Transfert la table temporaire dans la table maitre de SQL Server
            ///
            ///////////////////////////////////////////////////////////////////////
            void TransferTableSqlVersDBO(string strCodeTraitement, string pNomTableSource, string pNomTableDestination)
            {
                string sqlCmd = "SELECT * INTO " + pNomTableDestination.ToString() + " FROM " + pNomTableSource.ToString();

                if (strConnectCheminEntrée != "")
                {
                    // Connecter à la BD In
                    connectionIn = new OleDbConnection(strConnectCheminEntrée.ToString());
                    connectionIn.Open();
                }

                // Valide si la table existe
                OleDbCommand checkTableIfExistsCommand = new OleDbCommand("IF OBJECT_ID('" + pNomTableDestination.ToString() + "', 'U') IS NOT NULL drop table " + pNomTableDestination.ToString(), connectionIn);
                checkTableIfExistsCommand.CommandType = CommandType.Text;
                OleDbDataReader readerIfExists = checkTableIfExistsCommand.ExecuteReader();
                readerIfExists.Read();
                readerIfExists.Close();

                try
                {
                    // Copy la table dans le bon sh�ma
                    OleDbCommand SQLCommandVers = new OleDbCommand(sqlCmd.ToString(), connectionIn);
                    SQLCommandVers.CommandType = CommandType.Text;
                    OleDbDataReader readerVers = SQLCommandVers.ExecuteReader();
                    readerVers.Read();
                    readerVers.Close();

                    // Détruire la table source
                    DestructionTable(strCodeTraitement, pNomTableSource.ToString());
                }
                catch (Exception ex)
                {
                    //MessageBox.Show("ex.Message ::  " + ex.Message);
                    InsertTableLogJobPlanificateur("TransferTableSqlVersDBO(" + strCodeTraitement + ")", ex.Message.ToString());
                    succesLoadTable = false;
                    LoadTableErreur = true;
                }
            }

