                //////////////////////////////////////////////////////////////////////
                ///
                //     Exécute une instruction SQL
                ///
                /////////////////////////////////////////////////////////////////////
                void ExecuteSQL(string strCodeTraitement, string strTableFichierOut, string strSqlRequete)
                {
                    string sqlInsCmd = strSqlRequete.ToString();

                    if (strConnectCheminEntrée != "")
                    {
                        // Connecter à la BD In
                        connectionIn = new OleDbConnection(strConnectCheminEntrée.ToString());
                        connectionIn.Open();
                    }

                    // Valide si la table existe
                    OleDbCommand checkTableIfExistsCommand = new OleDbCommand("IF OBJECT_ID('" + strTableFichierOut.ToString() + "', 'U') IS NOT NULL drop table " + strTableFichierOut.ToString(), connectionIn);
                    checkTableIfExistsCommand.CommandType = CommandType.Text;
                    OleDbDataReader readerIfExists = checkTableIfExistsCommand.ExecuteReader();
                    readerIfExists.Read();
                    readerIfExists.Close();

                    try
                    {
                        OleDbCommand SQLCommandExec = new OleDbCommand(sqlInsCmd.ToString(), connectionIn);
                        SQLCommandExec.CommandType = CommandType.Text;
                        SQLCommandExec.CommandTimeout = 12000;
                        OleDbDataReader readerExec = SQLCommandExec.ExecuteReader();
                        readerExec.Read();
                        readerExec.Close();
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("ExecuteSQL(" + strCodeTraitement + ")", ex.Message.ToString());
                        LoadTableErreur = true;
                    }

                    connectionIn.Close();
                }

