                ////////////////////////////////////////////////////////////////////////
                ///
                //     Envois le courriel s'il y a une ou des erreurs
                ///
                ///////////////////////////////////////////////////////////////////////
                void SendMailMessageError(string EnvoisCourrielPar)
                {
                    int recCount = 0;
                    String strAfficheErreur = "";
                    String SQLString = tblAfficheErreur.ToString();
                    String EnvoisCourrielA = "centre.de.pilotage@rbq.gouv.qc.ca";
                    String EnvoisCourrielSuject = "L'application (Planificateur) a une ou plusieurs erreurs d'exécutions ";
                    String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                                 EnvoisCourrielSuject + newLine + newLine +
                                                 "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
                    String EnvoisCourrielPiedCorps = "..." + newLine +
                                                     "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                     "Direction des technologies de l'information" + newLine +
                                                     "Régie du bâtiment du Québec";


                    // Lire les erreurs
                    using (SqlDataAdapter dataAdapterAfficheErreur = new SqlDataAdapter(SQLString, mySQLConnection))
                    {
                        // create the DataSet 
                        try
                        {
                            DataSet dataSetAfficheErreur = new DataSet();
                            dataAdapterAfficheErreur.SelectCommand.CommandTimeout = 180;
                            dataAdapterAfficheErreur.Fill(dataSetAfficheErreur, "AfficheErreur");
                            recCount = 0;

                            foreach (DataRow pRowRegleAfficheErreur in dataSetAfficheErreur.Tables["AfficheErreur"].Rows)
                            {

                                if (recCount < 16)
                                {
                                    strAfficheErreur = strAfficheErreur.ToString() + newLine + pRowRegleAfficheErreur["IndSystem"].ToString() + " - " +
                                                                                               pRowRegleAfficheErreur["CodeTraitement"].ToString() + " - " +
                                                                                               pRowRegleAfficheErreur["TypeTraitement"].ToString() + " - " +
                                                                                               pRowRegleAfficheErreur["ErrorMessage"].ToString() + newLine;
                                }

                                recCount++;

                            }
                        }
                        catch (System.Web.Services.Protocols.SoapException soapEx)
                        {
                            string detailText = soapEx.Detail?.InnerText ?? "(aucun détail)";
                            string detailXml = soapEx.Detail?.OuterXml ?? "(aucun XML)";
                            string inner = soapEx.InnerException?.Message ?? "(aucune inner exception)";

                            if (soapEx.Detail != null)
                            {
                                detailText = soapEx.Detail.InnerText;
                                detailXml = soapEx.Detail.InnerXml;
                            }

                            // Empêche SafeLinks de modifier le XML
                            string encodedXml = System.Security.SecurityElement.Escape(detailXml);

                            string msg =
                                "SOAP ERROR: " + soapEx.Message + "\n\n" +
                                "DETAIL TEXT: " + detailText + "\n\n" +
                                "DETAIL XML: " + detailXml + "\n\n" +
                                "ENCODE XML: " + encodedXml + "\n\n" +
                                "INNER: " + inner + "\n\n" +
                                "CODE: " + soapEx.Code + "\n" +
                                "ACTOR: " + soapEx.Actor;

                            InsertTableLogJobPlanificateur("SendMailMessageError(" + strCodeTraitement + ")", "SOAP ERROR: " + soapEx.Message);
                            InsertTableLogJobPlanificateur("SendMailMessageError(" + strCodeTraitement + ")", "DETAIL TEXT: " + detailText);
                            InsertTableLogJobPlanificateur("SendMailMessageError(" + strCodeTraitement + ")", "DETAIL XML: " + detailXml);
                            InsertTableLogJobPlanificateur("SendMailMessageError(" + strCodeTraitement + ")", "ENCODE XML: " + encodedXml);
                            InsertTableLogJobPlanificateur("SendMailMessageError(" + strCodeTraitement + ")", "INNER: " + inner);
                            InsertTableLogJobPlanificateur("SendMailMessageError(" + strCodeTraitement + ")", "CODE: " + soapEx.Code);
                            InsertTableLogJobPlanificateur("SendMailMessageError(" + strCodeTraitement + ")", "ACTOR: " + soapEx.Actor);
                            InsertTableLogJobPlanificateur("SendMailMessageError(" + strCodeTraitement + ")", msg);
                            succesLoadTable = false;
                        }
                        catch (WebException webEx)
                        {
                            var httpResponse = webEx.Response as HttpWebResponse;

                            string statusCode = httpResponse?.StatusCode.ToString() ?? "N/A";
                            string statusDesc = httpResponse?.StatusDescription ?? "N/A";

                            string responseText = "";

                            try
                            {
                                using (var stream = httpResponse?.GetResponseStream())
                                using (var reader = new StreamReader(stream ?? Stream.Null))
                                {
                                    responseText = reader.ReadToEnd();
                                }
                            }
                            catch
                            {
                                responseText = "(Impossible de lire le flux)";
                            }

                            string msg =
                                $"WEB ERROR: {webEx.Message}\n" +
                                $"STATUS: {statusCode} - {statusDesc}\n" +
                                $"RESPONSE: {responseText}";

                            InsertTableLogJobPlanificateur("SendMailMessageError(" + strCodeTraitement + ")", msg);

                            Exception current = webEx;
                            while (current != null)
                            {
                                InsertTableLogJobPlanificateur("SendMailMessageError(" + strCodeTraitement + ") - 1",
                                    $"TYPE: {current.GetType().FullName} | MSG: {current.Message}");

                                current = current.InnerException;
                            }

                            if (httpResponse != null)
                            {
                                foreach (string key in httpResponse.Headers.AllKeys)
                                {
                                    InsertTableLogJobPlanificateur("SendMailMessageError(" + strCodeTraitement + ") - 2",
                                        $"HEADER {key}: {httpResponse.Headers[key]}");
                                }
                            }

                        }
                        catch (Exception ex)
                        {
                            ///
                            strMessageSql = "Fonction SendMailMessageError (dataSetAfficheErreur) Erreur SQL ";
                            InsertTableLogJobPlanificateur("MAIL", strMessageSql.ToString());
                            succesLoadTable = false;
                            LoadTableErreur = true;
                        }
                    }

                    EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + strAfficheErreur.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();

                    String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                    try
                    {
                        // Création du courriel et changement du format en HTML
                        MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                        // Créer le SMTP client et envois le courriel
                        SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                        monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                        monSmtpClient.Send(FormatCourrielHtml);
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message.ToString();
                        strMessageSql = "Fonction SendMailMessageError (SmtpClient) :: " + ex.Message.ToString();
                        InsertTableLogJobPlanificateur("MAIL", strMessageSql.ToString());
                        succesLoadTable = false;
                    }
                    InsertTableLogPlanificateur("Mail", "Mail erreur envoyé");
                }

                ////////////////////////////////////////////////////////////////////////
                ///
                //     Envois le courriel s'il y a une ou des erreurs
                ///
                ///////////////////////////////////////////////////////////////////////
                void SendMailMessage(string strCodeTraitement, string EnvoisCourrielPar, string strA, string strCC, string strSujet, string strMessage, bool pJoindreFichier, string pTableFichierOut)
                {

                    String SQLString = tblAfficheErreur.ToString();
                    String EnvoisCourrielA = strA;
                    String EnvoisCourrielCC = strCC;
                    string file_attachment = pTableFichierOut.ToString();
                    String EnvoisCourrielSuject = strSujet;
                    String EnvoisCourrielCorps = strMessage + newLine + newLine;
                    String EnvoisCourrielPiedCorps = "..." + newLine +
                                                     "Ce courriel a été envoyé par le lanceur de tâches 'Planificateur'." + newLine +
                                                     "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                     "Direction des technologies de l'information" + newLine +
                                                     "Régie du bâtiment du Québec";

                    EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();

                    String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                    try
                    {

                        // Création du courriel et changement du format en HTML
                        MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                        if (EnvoisCourrielCC.ToString() != "")
                        {
                            FormatCourrielHtml.CC.Add(EnvoisCourrielCC.ToString());
                        }

                        // Création de l'attachement
                        if (pJoindreFichier)
                        {
                            System.Net.Mail.Attachment fileAttachment;
                            fileAttachment = new System.Net.Mail.Attachment(file_attachment);
                            FormatCourrielHtml.Attachments.Add(fileAttachment);
                        }

                        // Créer le SMTP client et envois le courriel
                        SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                        monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                        monSmtpClient.Send(FormatCourrielHtml);
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message.ToString();
                        strMessageSql = "Fonction SendMailMessage (SmtpClient) :: " + ex.Message.ToString();
                        InsertTableLogJobPlanificateur("MAIL", strMessageSql.ToString());
                        succesLoadTable = false;
                        LoadTableErreur = true;
                    }

                    if (LoadTableErreur == false)
                    {
                        InsertTableLogPlanificateur(strCodeTraitement, "Mail confirmation envoyé");
                    }
                }

                ////////////////////////////////////////////////////////////////////////
                ///
                //     Transfert la table SharePoint dans la table de SQL Server 
                ///
                ///////////////////////////////////////////////////////////////////////
                void TransferTableSharePointToSqlServer(string pTableFichierIn, string pTableFichierOut, string pNomColonneEntrée, string pNomColonneSortie)
                {
                    string sqlInsCmd = "";
                    string strEnteSql = "INSERT INTO " + pTableFichierOut.ToString() + " values(";
                    string strBodySql = "";
                    string strDelimit = "";
                    string strGetValeur = "";
                    int position = 0;
                    int intLongueur = 0;

                    // Information sur les colonnes et leurs définitions
                    string[] arrfieldInternalName = new string[0];
                    string[] arrfieldSqlServer = new string[0];
                    arrfieldInternalName = pNomColonneEntrée.Split(';');
                    arrfieldSqlServer = pNomColonneSortie.Split(';');

                    SharePointColumnsInfo = new share_pointColumnsInfo()
                    {
                        strTitle = new List<string>(),
                        strInternalName = new List<string>(),
                        strFieldType = new List<string>(),
                        intMaxLength = new List<int>(),
                        strPropriete = new List<string>(),
                        strSqlFieldName = new List<string>(),
                        strSqlColone = new List<string>(),
                        strValeur = new List<string>()
                    };

                    string newLine = Environment.NewLine;

                    // Valide si le nombre de colonnes de InternalName est identique au nombre de champs SQL Server à créer
                    if (arrfieldInternalName.Count() != arrfieldSqlServer.Count())
                    {
                        InsertTableLogJobPlanificateur("TransferTableSharePointToSqlServer(Valide si le nombre de colonnes est identique)", String.Format("{0} :: Nb SharePoint[{1}] - Nb création de la table{2}",
                                                  "Le nombre de colonnes SharePoint est différent de la création de la table",
                                                  arrfieldInternalName.Count().ToString(),
                                                  arrfieldSqlServer.Count().ToString()));
                        succesLoadTable = false;
                        return;
                    }

                    if (strConnectCheminSortie != "")
                    {
                        // Connecter à la BD Out
                        Etape = "TransferTableSharePointToSqlServer(connectionOut.Open())";
                        connectionOut = new OleDbConnection(strConnectCheminSortie.ToString());
                        connectionOut.Open();
                    }

                    try
                    {
                        Etape = "TransferTableSharePointToSqlServer.ClientContext";

                        ClientContext ctx = new ClientContext(strConnectCheminEntrée);
                        var timeout = -1;

                        ctx.ExecutingWebRequest += new EventHandler<WebRequestEventArgs>(ctx_MixedAuthRequest);
                        // Initialise l'authentification
                        ctx.AuthenticationMode = ClientAuthenticationMode.Default;
                        ctx.Credentials = System.Net.CredentialCache.DefaultCredentials;

                        List DemandeRv = ctx.Web.Lists.GetByTitle(pTableFichierIn.ToString());

                        ctx.RequestTimeout = timeout;
                        ctx.PendingRequest.RequestExecutor.RequestKeepAlive = false;
                        ctx.PendingRequest.RequestExecutor.WebRequest.KeepAlive = false;
                        ctx.PendingRequest.RequestExecutor.WebRequest.Timeout = timeout;
                        ctx.PendingRequest.RequestExecutor.WebRequest.ReadWriteTimeout = timeout;
                        //////////////////////////
                        ///
                        ctx.Load(DemandeRv);
                        ctx.ExecuteQuery();

                        if (DemandeRv != null && DemandeRv.ItemCount > 0)
                        {

                            Etape = "ctx.Load(listItems)";

                            Microsoft.SharePoint.Client.CamlQuery camlQuery = new CamlQuery();
                            camlQuery.ViewXml = @"<View Scope='RecursiveAll'> " +
                                                  "</View>";

                            ListItemCollection listItems = DemandeRv.GetItems(camlQuery);
                            ctx.RequestTimeout = timeout;
                            ctx.PendingRequest.RequestExecutor.RequestKeepAlive = false;
                            ctx.PendingRequest.RequestExecutor.WebRequest.KeepAlive = false;
                            ctx.PendingRequest.RequestExecutor.WebRequest.Timeout = timeout;
                            ctx.PendingRequest.RequestExecutor.WebRequest.ReadWriteTimeout = timeout;
                            ctx.Load(listItems);
                            ctx.ExecuteQuery();

                            Etape = "ctx.Load(web)";
                            var web = ctx.Web;
                            ctx.Load(web);
                            List listEventSource = web.Lists.GetByTitle(pTableFichierIn);
                            FieldCollection fields = listEventSource.Fields;
                            IEnumerable<Field> fieldsColl = ctx.LoadQuery(fields);
                            ctx.ExecuteQuery();


                            if (arrfieldInternalName.Count() > 0)
                            {
                                // Récupère les colonnes à utiliser
                                for (int columnNum = 0; columnNum <= arrfieldInternalName.Count() - 1; columnNum++)
                                {
                                    SharePointColumnsInfo.strTitle.Add("");
                                    SharePointColumnsInfo.strInternalName.Add(arrfieldInternalName[columnNum].ToString());
                                    SharePointColumnsInfo.strFieldType.Add("");
                                    SharePointColumnsInfo.intMaxLength.Add(0);
                                    SharePointColumnsInfo.strPropriete.Add("");
                                    SharePointColumnsInfo.strSqlFieldName.Add(arrfieldSqlServer[columnNum].ToString());
                                    SharePointColumnsInfo.strSqlColone.Add("");
                                    SharePointColumnsInfo.strValeur.Add("");
                                }

                                // Créer la requete de la structure de la table
                                foreach (Field itemCol in fieldsColl)
                                {

                                    if (arrfieldInternalName.Contains(itemCol.InternalName.ToString()))
                                    {
                                        position = SharePointColumnsInfo.strInternalName.FindIndex(x => x.ToString() == itemCol.InternalName.ToString());

                                        SharePointColumnsInfo.strTitle[position] = itemCol.Title.ToString();
                                        SharePointColumnsInfo.strFieldType[position] = itemCol.FieldTypeKind.ToString();
                                        SharePointColumnsInfo.strPropriete[position] = itemCol.ToString();

                                        if (itemCol.FieldTypeKind.ToString().ToUpper() == "TEXT")
                                        {
                                            intLongueur = ((Microsoft.SharePoint.Client.FieldText)itemCol.TypedObject.TypedObject).MaxLength;
                                        }
                                        else
                                        {
                                            intLongueur = 0;
                                        }

                                        resultSQL returnDefiniColonneSQL = DefiniColonneSQL(itemCol.FieldTypeKind.ToString(), intLongueur, SharePointColumnsInfo.strSqlFieldName[position].ToString(), pTableFichierOut);

                                        SharePointColumnsInfo.strSqlColone[position] = returnDefiniColonneSQL.definition.ToString();
                                        SharePointColumnsInfo.intMaxLength[position] = returnDefiniColonneSQL.longueur;
                                    }
                                }

                                // Valide si la table existe
                                Etape = "checkTableIfExistsCommand :: " + pTableFichierOut.ToString();

                                SqlCommand checkTableIfExistsCommand = new SqlCommand("IF OBJECT_ID('" + pTableFichierOut.ToString() + "', 'U') IS NOT NULL drop table " + pTableFichierOut.ToString(), mySQLConnection);
                                checkTableIfExistsCommand.CommandType = CommandType.Text;
                                SqlDataReader readerIfExists = checkTableIfExistsCommand.ExecuteReader();
                                readerIfExists.Read();
                                readerIfExists.Close();

                                // Création de la table SQL Server
                                var createTableBuilder = new StringBuilder("CREATE TABLE " + pTableFichierOut.ToString());
                                createTableBuilder.AppendLine("(");
                                // Récupère les colonnes à utiliser

                                for (int columnNum = 0; columnNum <= SharePointColumnsInfo.strTitle.Count() - 1; columnNum++)
                                {
                                    if (SharePointColumnsInfo.strSqlColone[columnNum].ToString() == "" && SharePointColumnsInfo.strInternalName[columnNum].ToString() != "")
                                    {
                                        SharePointColumnsInfo.strTitle[columnNum] = SharePointColumnsInfo.strInternalName[columnNum].ToString();
                                        SharePointColumnsInfo.strSqlColone[columnNum] = String.Format("[{0}] VARCHAR(8),", SharePointColumnsInfo.strSqlFieldName[columnNum].ToString());
                                        SharePointColumnsInfo.strFieldType[columnNum] = "_Id";
                                    }

                                    if (SharePointColumnsInfo.strSqlColone[columnNum].ToString() != "")
                                    {
                                        createTableBuilder.AppendLine(SharePointColumnsInfo.strSqlColone[columnNum].ToString());
                                    }
                                }

                                createTableBuilder.AppendLine(")");
                                try
                                {
                                    var createTableCommand = new SqlCommand(createTableBuilder.ToString(), mySQLConnection);
                                    createTableCommand.ExecuteNonQuery();
                                }
                                catch (Exception ex)
                                {
                                    //MessageBox.Show("ex.Message ::  " + ex.Message);
                                    InsertTableLogJobPlanificateur("TransferTableSharePointToSqlServer(createTableBuilder)", ex.Message.ToString());
                                    succesLoadTable = false;
                                }
                            }

                            Etape = "Insert into";
                            foreach (ListItem item in listItems)
                            {
                                strBodySql = "";
                                strDelimit = "";

                                for (int columnNum = 0; columnNum <= SharePointColumnsInfo.strTitle.Count() - 1; columnNum++)
                                {
                                    if (SharePointColumnsInfo.strSqlColone[columnNum].ToString() != "" && SharePointColumnsInfo.strInternalName[columnNum].ToString() != "")
                                    {
                                        try
                                        {

                                            strGetValeur = getColonneValueSharePoint(SharePointColumnsInfo.strFieldType[columnNum], SharePointColumnsInfo.strInternalName[columnNum], item, "SQL");

                                            // Initialise la variable SQL
                                            strBodySql = strBodySql.ToString() + strDelimit.ToString() + strGetValeur.ToString();
                                            strDelimit = ", ";
                                        }
                                        catch (Exception ex)
                                        {
                                            //MessageBox.Show(ex.Message + " :: " + SharePointColumnsInfo.strInternalName[columnNum].ToString());f
                                            InsertTableLogJobPlanificateur("TransferTableSharePointToSqlServer(Création Body) :: " + SharePointColumnsInfo.strInternalName[columnNum].ToString(), ex.Message.ToString());
                                        }
                                    }
                                }
                                try
                                {
                                    sqlInsCmd = strEnteSql + strBodySql.Replace("&#39;", "''") + ")";
                                    sqlInsCmd = sqlInsCmd.Replace("\r\n", "").Replace("\n", "").Replace("\r", "");
                                    ExecuteInsertInto(strIndSystem, sqlInsCmd);
                                }
                                catch (Exception ex)
                                {
                                    //MessageBox.Show(ex.Message);
                                    InsertTableLogJobPlanificateur("TransferTableSharePointToSqlServer(Insert into))", ex.Message.ToString());
                                    LoadTableErreur = true;
                                }
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("TransferTableSharePointToSqlServer(" + Etape.ToString() + ")", ex.Message.ToString());
                        succesLoadTable = false;
                    }
                    connectionOut.Close();
                }

                ////////////////////////////////////////////////////////////////////////
                ///
                //     Transfert la table SharePoint vers un fichier csv
                ///
                ///////////////////////////////////////////////////////////////////////
                void SharePointToCSV(string pTableFichierIn, string pTableFichierOut, string pNomColonneEntrée, string pNomColonneSortie)
                {
                    string strSeparateur = "";
                    string strGetValeur = "";
                    string strValue = "";
                    int position = 0;

                    // Information sur les colonnes et leurs définitions
                    string[] arrfieldInternalName = new string[0];
                    string[] arrfieldExternalName = new string[0];
                    string[] arrFieldTypeKind = new string[0];
                    arrfieldInternalName = pNomColonneEntrée.Split(';');
                    arrfieldExternalName = pNomColonneSortie.Split(';');
                    arrFieldTypeKind = pNomColonneEntrée.Split(';');
                    string newLine = Environment.NewLine;

                    // Valide si le nombre de colonnes de InternalName est identique au nombre de champs SQL Server à créer
                    if (arrfieldInternalName.Count() != arrfieldExternalName.Count())
                    {
                        InsertTableLogJobPlanificateur("SharePointToCSV(Valide si le nombre de colonnes est identique)", String.Format("{0} :: Nb SharePoint[{1}] - Nb création de la table{2}",
                                                  "Le nombre de colonnes SharePoint est différent de la création de la table",
                                                  arrfieldInternalName.Count().ToString(),
                                                  arrfieldExternalName.Count().ToString()));
                        succesLoadTable = false;
                        return;
                    }

                    try
                    {
                        Etape = "SharePointToCSV.ClientContext";

                        ClientContext ctx = new ClientContext(strConnectCheminEntrée);
                        var timeout = -1;

                        ctx.ExecutingWebRequest += new EventHandler<WebRequestEventArgs>(ctx_MixedAuthRequest);
                        // Initialise l'authentification
                        ctx.AuthenticationMode = ClientAuthenticationMode.Default;
                        ctx.Credentials = System.Net.CredentialCache.DefaultCredentials;

                        List DemandeRv = ctx.Web.Lists.GetByTitle(pTableFichierIn.ToString());

                        ctx.RequestTimeout = timeout;
                        ctx.PendingRequest.RequestExecutor.RequestKeepAlive = false;
                        ctx.PendingRequest.RequestExecutor.WebRequest.KeepAlive = false;
                        ctx.PendingRequest.RequestExecutor.WebRequest.Timeout = timeout;
                        ctx.PendingRequest.RequestExecutor.WebRequest.ReadWriteTimeout = timeout;
                        //////////////////////////
                        ///
                        ctx.Load(DemandeRv);
                        ctx.ExecuteQuery();

                        if (DemandeRv != null && DemandeRv.ItemCount > 0)
                        {

                            Etape = "ctx.Load(listItems)";

                            Microsoft.SharePoint.Client.CamlQuery camlQuery = new CamlQuery();
                            camlQuery.ViewXml = @"<View Scope='RecursiveAll'> " +
                                                  "</View>";

                            ListItemCollection listItems = DemandeRv.GetItems(camlQuery);
                            ctx.RequestTimeout = timeout;
                            ctx.PendingRequest.RequestExecutor.RequestKeepAlive = false;
                            ctx.PendingRequest.RequestExecutor.WebRequest.KeepAlive = false;
                            ctx.PendingRequest.RequestExecutor.WebRequest.Timeout = timeout;
                            ctx.PendingRequest.RequestExecutor.WebRequest.ReadWriteTimeout = timeout;
                            ctx.Load(listItems);
                            ctx.ExecuteQuery();

                            Etape = "ctx.Load(web)";
                            var web = ctx.Web;
                            ctx.Load(web);
                            List listEventSource = web.Lists.GetByTitle(pTableFichierIn);
                            FieldCollection fields = listEventSource.Fields;
                            IEnumerable<Field> fieldsColl = ctx.LoadQuery(fields);
                            ctx.ExecuteQuery();


                            // Créer la requete de la structure de la table
                            foreach (Field itemCol in fieldsColl)
                            {
                                position = Array.IndexOf(arrFieldTypeKind, itemCol.InternalName.ToString());

                                if (position != -1)
                                {
                                    arrFieldTypeKind[position] = itemCol.FieldTypeKind.ToString();
                                }
                            }

                            Etape = "Insert CSV";
                            arrNomColonneSortie = pNomColonneSortie.Split(';');

                            if (System.IO.File.Exists(pTableFichierOut))
                            {
                                // Si le fichier existe le détruire
                                System.IO.File.Delete(pTableFichierOut);
                            }

                            StreamWriter sw = new StreamWriter(pTableFichierOut, true, Encoding.Unicode);
                            sw.WriteLine(pNomColonneSortie.ToString());

                            if (listItems.Count() == 0)
                            {
                                sw.WriteLine("Aucune valeur de disponible");
                            }
                            else
                            {
                                foreach (ListItem item in listItems)
                                {
                                    strSeparateur = "";
                                    strValue = "";

                                    for (int columnNum = 0; columnNum <= arrNomColonneSortie.Count() - 1; columnNum++)
                                    {
                                        try
                                        {

                                            strGetValeur = getColonneValueSharePoint(arrFieldTypeKind[columnNum], arrfieldInternalName[columnNum], item, "CSV");

                                            // Initialise la variable 
                                            strValue = strValue.ToString() + strSeparateur.ToString() + strGetValeur.Replace("&#39;", "''").Replace("\r\n", "").Replace("\n", "").Replace("\r", "").Replace(";", " - ");
                                            strSeparateur = ";";
                                        }
                                        catch (Exception ex)
                                        {
                                            //MessageBox.Show(ex.Message + " :: " + arrNomColonneSortie[0].ToString());
                                            InsertTableLogJobPlanificateur("SharePointToCSV(Création Détail) :: " + arrfieldInternalName[columnNum].ToString(), ex.Message.ToString());
                                        }
                                    }

                                    sw.WriteLine(strValue);
                                }
                            }

                            sw.Close();
                        }
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("SharePointToCSV(" + Etape.ToString() + ")", ex.Message.ToString());
                        succesLoadTable = false;
                    }
                }

                ////////////////////////////////////////////////////////////////////////
                ///
                //     Retourne la définition de colonne pour la table temporaire de SQL Server
                ///
                ///////////////////////////////////////////////////////////////////////
                resultSQL DefiniColonneSQL(string pstrFieldType, int pintLongueur, string pstrSqlFieldName, string pNomTableSharePointUtilise)
                {
                    resultSQL resValue = new resultSQL();

                    switch (pstrFieldType.ToString().ToUpper())
                    {
                        case "STRING":
                        case "TEXT":
                            resValue.longueur = pintLongueur;
                            if (resValue.longueur > 4000)
                            {
                                resValue.definition = String.Format("[{0}] nvarchar(MAX),", pstrSqlFieldName.ToString());
                            }
                            else
                            {
                                resValue.definition = String.Format("[{0}] nvarchar({1}),", pstrSqlFieldName.ToString(), resValue.longueur.ToString());
                            }
                            break;
                        case "ATTACHMENTS":
                            resValue.definition = String.Format("[{0}] ntext,", pstrSqlFieldName.ToString());
                            break;
                        case "LOOKUP":
                        case "USER":
                        case "CHOICE":
                        case "COMPUTED":
                        case "GUID":
                            resValue.definition = String.Format("[{0}] nvarchar(255),", pstrSqlFieldName.ToString());
                            break;
                        case "INVALID":
                        case "CALCULATED":
                        case "NOTE":
                            resValue.definition = String.Format("[{0}] nvarchar(MAX),", pstrSqlFieldName.ToString());
                            break;
                        case "MONEY":
                        case "DECIMAL":
                        case "NUMBER":
                            resValue.definition = String.Format("[{0}] decimal(19,10),", pstrSqlFieldName.ToString());
                            break;
                        case "DATETIME":
                            resValue.definition = String.Format("[{0}] datetime,", pstrSqlFieldName.ToString());
                            break;
                        case "INT32":
                        case "INTEGER":
                        case "COUNTER":
                            resValue.definition = String.Format("[{0}] int,", pstrSqlFieldName.ToString());
                            break;
                        case "BOOLEAN":
                            resValue.definition = String.Format("[{0}]  VARCHAR(1),", pstrSqlFieldName.ToString());
                            break;
                        case "SINGLE":
                            resValue.definition = String.Format("[{0}] real,", pstrSqlFieldName.ToString());
                            break;
                        case "BYTE":
                            resValue.definition = String.Format("[{0}] tinyint,", pstrSqlFieldName.ToString());
                            break;
                        case "INT16":
                            resValue.definition = String.Format("[{0}] smallint,", pstrSqlFieldName.ToString());
                            break;
                        case "DOUBLE":
                            resValue.definition = String.Format("[{0}] float,", pstrSqlFieldName.ToString());
                            break;
                        default:
                            //MessageBox.Show(String.Format("{0}.[{1}] {2}",
                            //  pNomTableSharePointUtilise,
                            //  SharePointColumnsInfo.strTitle[position].ToString(),
                            //  SharePointColumnsInfo.strFieldType[position].ToString()));
                            InsertTableLogJobPlanificateur("DefiniColonneSQL(AppendLine)", String.Format("{0}.[{1}] {2}",
                              pNomTableSharePointUtilise,
                              pstrSqlFieldName.ToString(),
                              pstrFieldType.ToString()));
                            succesLoadTable = false;
                            break;
                    }

                    return resValue;
                }

                ////////////////////////////////////////////////////////////////////////
                ///
                //     Retourne la valeur de la colonne pour la table temporaire de SQL Server
                ///
                ///////////////////////////////////////////////////////////////////////
                string getColonneValueSharePoint(string pstrFieldType, string pstrInternalName, ListItem pItem, string pType)
                {
                    string strGetValeur = "";
                    string strValue = "";

                    if (pstrFieldType != "_Id")
                    {
                        if (pItem[pstrInternalName.ToString()] != null)
                        {

                            switch (pItem[pstrInternalName.ToString()].ToString())
                            {
                                case "System.Collections.Generic.Dictionary`2[System.String,System.Object]":
                                    var listValeur = (((System.Collections.Generic.Dictionary<string, object>)pItem[pstrInternalName.ToString()]));
                                    if (listValeur.Count() != 4)
                                    {
                                        strGetValeur = "NULL";
                                    }
                                    else
                                    {
                                        if (pType == "SQL")
                                        {
                                            strGetValeur = "'" + listValeur["WssId"].ToString() + ";" + listValeur["Label"].ToString().Replace("'", "`") + "'";
                                        }
                                        else
                                        {
                                            strGetValeur = listValeur["WssId"].ToString() + ";" + listValeur["Label"].ToString().Replace("'", "`");
                                        }
                                    }
                                    break;
                                case "Microsoft.SharePoint.Client.FieldLookup":
                                case "Microsoft.SharePoint.Client.FieldLookupValue":
                                    if ((pItem[pstrInternalName.ToString()] as FieldLookupValue).LookupValue != null)
                                    {
                                        if (pType == "SQL")
                                        {
                                            strGetValeur = "'" + (pItem[pstrInternalName.ToString()] as FieldLookupValue).LookupValue.ToString().Replace("'", "`") + "'";
                                        }
                                        else
                                        {
                                            strGetValeur = (pItem[pstrInternalName.ToString()] as FieldLookupValue).LookupValue.ToString().Replace("'", "`");
                                        }
                                    }
                                    else
                                    {
                                        strGetValeur = "NULL";
                                    }
                                    break;
                                case "Microsoft.SharePoint.Client.FieldUser":
                                    if (pType == "SQL")
                                    {
                                        strGetValeur = "'" + ((Microsoft.SharePoint.Client.FieldUser)pItem[pstrInternalName.ToString()]).ToString().Replace("'", "`") + "'";
                                    }
                                    else
                                    {
                                        strGetValeur = ((Microsoft.SharePoint.Client.FieldUser)pItem[pstrInternalName.ToString()]).ToString().Replace("'", "`");
                                    }
                                    break;
                                case "Microsoft.SharePoint.Client.FieldUserValue":
                                    if ((FieldUserValue)pItem[pstrInternalName.ToString()] != null)
                                    {
                                        FieldUserValue fuv = (FieldUserValue)pItem[pstrInternalName.ToString()];
                                        if (pType == "SQL")
                                        {
                                            strGetValeur = "'" + fuv.LookupValue.ToString().Replace("'", "`") + "'";
                                        }
                                        else
                                        {
                                            strGetValeur = fuv.LookupValue.ToString().Replace("'", "`");
                                        }
                                    }
                                    else
                                    {
                                        strGetValeur = "NULL";
                                    }
                                    break;
                                case "Microsoft.SharePoint.Client.FieldUserValue[]":
                                    if ((FieldUserValue[])pItem[pstrInternalName.ToString()] != null)
                                    {
                                        FieldUserValue[] multValue = (FieldUserValue[])pItem[pstrInternalName.ToString()];
                                        foreach (FieldUserValue fieldUserValue in multValue)
                                        {
                                            if (pType == "SQL")
                                            {
                                                strGetValeur = "'" + fieldUserValue.LookupValue.ToString().Replace("'", "`") + "'";
                                            }
                                            else
                                            {
                                                strGetValeur = fieldUserValue.LookupValue.ToString().Replace("'", "`");
                                            }
                                        }
                                    }
                                    else
                                    {
                                        strGetValeur = "NULL";
                                    }
                                    break;
                                case "Microsoft.SharePoint.Client.FieldChoice":
                                    if (pType == "SQL")
                                    {
                                        strGetValeur = "'" + pItem[pstrInternalName.ToString()].ToString().Replace("'", "`") + "'";
                                    }
                                    else
                                    {
                                        strGetValeur = pItem[pstrInternalName.ToString()].ToString().Replace("'", "`");
                                    }
                                    break;
                                case "Microsoft.SharePoint.Client.FieldDateTime":
                                    if (pType == "SQL")
                                    {
                                        strGetValeur = "convert(datetime, convert(datetime, '" + pItem[pstrInternalName.ToString()].ToString() + "', 120) at time zone 'UTC' at time zone 'Eastern Standard Time')";
                                    }
                                    else
                                    {
                                        strGetValeur = pItem[pstrInternalName.ToString()].ToString();
                                    }
                                    break;
                                case "Microsoft.SharePoint.Client.FieldMultiLineText":
                                case "Microsoft.SharePoint.Client.FieldText":
                                case "Microsoft.SharePoint.Client.Field":
                                    if (pType == "SQL")
                                    {
                                        strGetValeur = "'" + pItem[pstrInternalName].ToString().Replace("'", "`") + "'";
                                    }
                                    else
                                    {
                                        strGetValeur = pItem[pstrInternalName].ToString().Replace("'", "`");
                                    }
                                    break;
                                default:
                                    if (pstrFieldType.ToString() != "Boolean")
                                    {
                                        switch (pstrFieldType.ToString().ToUpper())
                                        {
                                            case "DATETIME":
                                                if (pType == "SQL")
                                                {
                                                    strGetValeur = "convert(datetime, convert(datetime, '" + pItem[pstrInternalName.ToString()].ToString() + "', 120) at time zone 'UTC' at time zone 'Eastern Standard Time')";
                                                }
                                                else
                                                {
                                                    strGetValeur = pItem[pstrInternalName.ToString()].ToString();
                                                }
                                                break;
                                            case "NUMBER":
                                                if (pType == "SQL")
                                                {
                                                    strGetValeur = "'" + pItem[pstrInternalName].ToString().Replace(",", ".") + "'";
                                                }
                                                else
                                                {
                                                    strGetValeur = pItem[pstrInternalName].ToString().Replace(",", ".");
                                                }
                                                break;
                                            default:
                                                if (pType == "SQL")
                                                {
                                                    strGetValeur = "'" + pItem[pstrInternalName].ToString().Replace("'", "`") + "'";
                                                }
                                                else
                                                {
                                                    strGetValeur = pItem[pstrInternalName].ToString().Replace("'", "`");
                                                }
                                                break;
                                        }
                                    }
                                    else
                                    {
                                        if (pItem[pstrInternalName.ToString()].ToString().ToUpper() != "FALSE")
                                        {
                                            if (pType == "SQL")
                                            {
                                                strGetValeur = "'O'";
                                            }
                                            else
                                            {
                                                strGetValeur = "O";
                                            }
                                        }
                                        else
                                        {
                                            if (pType == "SQL")
                                            {
                                                strGetValeur = "'N'";
                                            }
                                            else
                                            {
                                                strGetValeur = "N";
                                            }
                                        }
                                    }
                                    break;
                            }
                        }
                        else
                        {
                            if (pstrFieldType.ToString() != "Boolean")
                            {
                                strGetValeur = "NULL";
                            }
                            else
                            {
                                if (pType == "SQL")
                                {
                                    strGetValeur = "'N'";
                                }
                                else
                                {
                                    strGetValeur = "N";
                                }
                            }
                        }
                    }
                    else
                    {
                        // Récupère la valeur du id
                        strValue = pstrInternalName.Substring(0, (pstrInternalName.Length - 2)).ToString();

                        if (pItem[strValue.ToString()] != null)
                        {
                            switch (pItem[strValue.ToString()].ToString())
                            {
                                case "Microsoft.SharePoint.Client.FieldLookup":
                                case "Microsoft.SharePoint.Client.FieldLookupValue":
                                    if (pstrFieldType.ToString() != "Boolean")
                                    {
                                        strGetValeur = "'" + (pItem[strValue.ToString()] as FieldLookupValue).LookupId.ToString().Replace("'", "`") + "'";
                                    }
                                    else
                                    {
                                        strGetValeur = (pItem[strValue.ToString()] as FieldLookupValue).LookupId.ToString().Replace("'", "`");
                                    }
                                    break;
                                case "Microsoft.SharePoint.Client.FieldUserValue":
                                    FieldUserValue fuv = (FieldUserValue)pItem[strValue.ToString()];
                                    if (pstrFieldType.ToString() != "Boolean")
                                    {
                                        strGetValeur = "'" + fuv.LookupId.ToString().Replace("'", "`") + "'";
                                    }
                                    else
                                    {
                                        strGetValeur = fuv.LookupId.ToString().Replace("'", "`");
                                    }
                                    break;
                                case "Microsoft.SharePoint.Client.FieldUserValue[]":
                                    FieldUserValue[] multValue = (FieldUserValue[])pItem[strValue.ToString()];
                                    foreach (FieldUserValue fieldUserValue in multValue)
                                    {
                                        if (pstrFieldType.ToString() != "Boolean")
                                        {
                                            strGetValeur = "'" + fieldUserValue.LookupId.ToString().Replace("'", "`") + "'";
                                        }
                                        else
                                        {
                                            strGetValeur = fieldUserValue.LookupId.ToString().Replace("'", "`");
                                        }
                                    }
                                    break;
                                default:
                                    //MessageBox.Show("Non Defini :: " + strGetValeur.ToString() + " -- " + item[strValue.ToString()].ToString()); 
                                    InsertTableLogJobPlanificateur("TransferTableSharePointToSqlServer(Non Defini) ", strGetValeur.ToString() + " -- " + pItem[strValue.ToString()].ToString());
                                    break;
                            }
                        }
                        else
                        {
                            if (pstrFieldType.ToString() != "Boolean")
                            {
                                strGetValeur = "NULL";
                            }
                            else
                            {
                                if (pType == "SQL")
                                {
                                    strGetValeur = "'N'";
                                }
                                else
                                {
                                    strGetValeur = "N";
                                }
                            }

                        }
                    }
                    return strGetValeur;
                }

                ////////////////////////////////////////////////////////////////////////
                ///
                //     Retourne la valeur de la colonne pour la table temporaire de SQL Server
                ///
                ///////////////////////////////////////////////////////////////////////
                string getColonneValueSQL(string pstrFieldType, string pstrInternalName, OleDbDataReader pItem)
                {
                    string strGetValeur = "";

                    if (pstrFieldType.ToString() != "Boolean")
                    {
                        switch (pstrFieldType.ToString().ToUpper())
                        {
                            case "DATETIME":
                                strGetValeur = "convert(datetime, convert(datetime, '" + pItem[pstrInternalName.ToString()].ToString() + "', 120) at time zone 'UTC' at time zone 'Eastern Standard Time')";
                                break;
                            case "NUMBER":
                                strGetValeur = pItem[pstrInternalName].ToString().Replace(",", ".");
                                break;
                            default:
                                strGetValeur = "'" + pItem[pstrInternalName].ToString().Replace("'", "`") + "'";
                                break;
                        }
                    }
                    else
                    {
                        if (pItem[pstrInternalName.ToString()].ToString().ToUpper() != "FALSE")
                        {
                            //strGetValeur = "'O'";
                            strGetValeur = "'1'";
                        }
                        else
                        {
                            //strGetValeur = "'N'";
                            strGetValeur = "'0'";
                        }
                    }

                    if (strGetValeur == "")
                    {
                        strGetValeur = "NULL";
                    }

                    return strGetValeur;
                }

                //////////////////////////////////////////////////////////////////////
                ///
                //     Copie un fichier
                ///
                /////////////////////////////////////////////////////////////////////
                void CopieFichier(string pstrCodeTraitement, string de, string a)
                {
                    try
                    {
                        if (!System.IO.Directory.Exists(a.Substring(0, a.LastIndexOf("\\"))))
                        {
                            System.IO.Directory.CreateDirectory(a.Substring(0, a.LastIndexOf("\\")));
                        }
                        if (System.IO.File.Exists(a))
                        {
                            System.IO.File.SetAttributes(a, FileAttributes.Archive);
                            System.IO.File.Delete(a);
                        }

                        System.IO.File.Copy(de, a, true);

                    }

                    catch (IOException ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("CopieFichier(" + pstrCodeTraitement + ")", ex.Message.ToString());
                        succesLoadTable = false;
                    }
                }

                //////////////////////////////////////////////////////////////////////
                ///
                //     Déplace un fichier
                ///
                /////////////////////////////////////////////////////////////////////
                void MoveFichier(string pstrCodeTraitement, string de, string a)
                {
                    try
                    {
                        if (!System.IO.Directory.Exists(a.Substring(0, a.LastIndexOf("\\"))))
                        {
                            System.IO.Directory.CreateDirectory(a.Substring(0, a.LastIndexOf("\\")));
                        }
                        if (System.IO.File.Exists(a))
                        {
                            System.IO.File.SetAttributes(a, FileAttributes.Archive);
                            System.IO.File.Delete(a);
                        }

                        System.IO.File.Move(de, a);

                    }

                    catch (IOException ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("MoveFichier(" + pstrCodeTraitement + ")", ex.Message.ToString());
                        succesLoadTable = false;
                    }
                }

                //////////////////////////////////////////////////////////////////////
                ///
                //     Exécute un service SSIS
                ///
                /////////////////////////////////////////////////////////////////////
                void ExecSSIS(string pstrCodeTraitement, string pathEntree)
                {
                    string SSISPackagePath = @pathEntree;

                    try
                    {

                        Microsoft.SqlServer.Dts.Runtime.Application app = new Microsoft.SqlServer.Dts.Runtime.Application();
                        DTSExecResult result;
                        Package pckg = (Package)app.LoadPackage(SSISPackagePath, null);
                        result = pckg.Execute();

                        if (result == Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure)
                        {
                            InsertTableLogJobPlanificateur("ExecSSIS(" + pstrCodeTraitement + ")", "Erreur exécution du package SSIS");
                            succesLoadTable = false;
                        }

                    }

                    catch (IOException ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("ExecSSIS(" + pstrCodeTraitement + ")", ex.Message.ToString());
                        succesLoadTable = false;
                    }
                }

                //////////////////////////////////////////////////////////////////////
                ///
                //     Imprime Microsoft Repport
                ///
                /////////////////////////////////////////////////////////////////////
                void ExecReport(string strReportPath, string strPathOut, string strFormatFichier)
                {
                    try
                    {
                        // Exécuter un rapport spécifique et récupérer le rendu en format 
                        byte[] result = null;
                        string encoding, mimeType, extension;
                        string[] streamIds;
                        string historyId = null;
                        string strFormat = strFormatFichier;

                        ST_5f920016aab846abb71f46279a8235bf.w367p002rpt1.ReportExecutionService rs = new ST_5f920016aab846abb71f46279a8235bf.w367p002rpt1.ReportExecutionService();

                        rs.Url = "https://rbqinfosgest.mtr.intra/ReportServer/ReportExecution2005.asmx?wsdl";
                        rs.Credentials = CredentialCache.DefaultNetworkCredentials;

                        // Timeout de 5 minutes
                        rs.Timeout = 300000;
                        rs.LoadReport(strReportPath, historyId);
                        ST_5f920016aab846abb71f46279a8235bf.w367p002rpt1.Warning[] warnings = null;

                        result = rs.Render(strFormat.ToUpper(), null, out extension, out mimeType, out encoding, out warnings, out streamIds);

                        // Sauvegarder le fichier sur le disque
                        System.IO.File.WriteAllBytes(@strPathOut, result);

                    }
                    catch (System.Web.Services.Protocols.SoapException soapEx)
                    {
                        string detailText = soapEx.Detail?.InnerText ?? "(aucun détail)";
                        string detailXml = soapEx.Detail?.OuterXml ?? "(aucun XML)";
                        string inner = soapEx.InnerException?.Message ?? "(aucune inner exception)";

                        if (soapEx.Detail != null)
                        {
                            detailText = soapEx.Detail.InnerText;
                            detailXml = soapEx.Detail.InnerXml;
                        }

                        // Empêche SafeLinks de modifier le XML
                        string encodedXml = System.Security.SecurityElement.Escape(detailXml);

                        InsertTableLogJobPlanificateur("ExecReport(" + strCodeTraitement + ")", "SOAP ERROR: " + soapEx.Message);
                        InsertTableLogJobPlanificateur("ExecReport(" + strCodeTraitement + ")", "DETAIL TEXT: " + detailText);
                        InsertTableLogJobPlanificateur("ExecReport(" + strCodeTraitement + ")", "DETAIL XML: " + detailXml);
                        InsertTableLogJobPlanificateur("ExecReport(" + strCodeTraitement + ")", "ENCODE XML: " + encodedXml);
                        InsertTableLogJobPlanificateur("ExecReport(" + strCodeTraitement + ")", "INNER: " + inner);
                        InsertTableLogJobPlanificateur("ExecReport(" + strCodeTraitement + ")", "CODE: " + soapEx.Code);
                        InsertTableLogJobPlanificateur("ExecReport(" + strCodeTraitement + ")", "ACTOR: " + soapEx.Actor);
                        succesLoadTable = false;
                    }
                    catch (WebException webEx)
                    {


                        var httpResponse = webEx.Response as HttpWebResponse;

                        string statusCode = httpResponse?.StatusCode.ToString() ?? "N/A";
                        string statusDesc = httpResponse?.StatusDescription ?? "N/A";

                        InsertTableLogJobPlanificateur("ExecReport - statusCode", statusCode);
                        InsertTableLogJobPlanificateur("ExecReport - statusDesc", statusDesc);

                        string responseText = "";

                        try
                        {
                            using (var stream = httpResponse?.GetResponseStream())
                            using (var reader = new StreamReader(stream ?? Stream.Null))
                            {
                                responseText = reader.ReadToEnd();
                            }
                        }
                        catch
                        {
                            responseText = "(Impossible de lire le flux)";
                        }

                        string msg =
                            $"WEB ERROR: {webEx.Message}\n" +
                            $"STATUS: {statusCode} - {statusDesc}\n" +
                            $"RESPONSE: {responseText}";

                        InsertTableLogJobPlanificateur("ExecReport", msg);

                        Exception current = webEx;
                        while (current != null)
                        {
                            InsertTableLogJobPlanificateur("ExecReport - 1",
                                $"TYPE: {current.GetType().FullName} | MSG: {current.Message}");

                            current = current.InnerException;
                        }

                        if (httpResponse != null)
                        {
                            foreach (string key in httpResponse.Headers.AllKeys)
                            {
                                InsertTableLogJobPlanificateur("ExecReport - 2",
                                    $"HEADER {key}: {httpResponse.Headers[key]}");
                            }
                        }
                        succesLoadTable = false;
                    }
                    catch (Exception ex)
                    {
                        InsertTableLogJobPlanificateur("ExecReport(" + strCodeTraitement + ")", "GENERAL ERROR: " + ex.Message);
                        succesLoadTable = false;
                    }
                }
                //////////////////////////////////////////////////////////////////////
                ///
                //     Supprime le fichier
                ///
                /////////////////////////////////////////////////////////////////////
                void SupprimeFichier(string pstrCodeTraitement, string strFchier)
                {
                    try
                    {
                        if (System.IO.File.Exists(strFchier))
                        {
                            System.IO.File.SetAttributes(strFchier, FileAttributes.Archive);
                            System.IO.File.Delete(strFchier);
                        }
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("SupprimeFichier(" + pstrCodeTraitement + ")", ex.Message.ToString());
                        succesLoadTable = false;
                    }
                }

                //////////////////////////////////////////////////////////////////////
                ///
                //     Décompresser les fichiers
                ///
                /////////////////////////////////////////////////////////////////////
                void DecompresseFichier(string pstrCodeTraitement, string strpCheminFchIn, string strpCheminFchOut)
                {
                    try
                    {
                        ZipFile.ExtractToDirectory(strpCheminFchIn, strpCheminFchOut);
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show(ex.Message);
                        InsertTableLogJobPlanificateur("DecompresseFichier(" + pstrCodeTraitement + ")", ex.Message.ToString());
                        succesLoadTable = false;
                    }
                }

                ////////////////////////////////////////////////////////////////////////
                ///
                //     Authentification
                ///
                ///////////////////////////////////////////////////////////////////////
                void ctx_MixedAuthRequest(object sender, WebRequestEventArgs e)
                {
                    try
                    {
                        //Add the header that tells SharePoint to use Windows authentication.
                        e.WebRequestExecutor.RequestHeaders.Add(
                        "X-FORMS_BASED_AUTH_ACCEPTED", "f");
                    }
                    catch (Exception ex)
                    {
                        //MessageBox.Show("Error setting authentication header: " + ex.Message);
                        succesLoadTable = false;
                        InsertTableLogJobPlanificateur("ctx_MixedAuthRequest()", ex.Message.ToString());
                    }
                }
            }

