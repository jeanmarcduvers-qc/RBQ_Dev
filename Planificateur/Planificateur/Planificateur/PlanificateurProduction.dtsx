            public const string tblPlanificateur = "SELECT  [IndSystem], " +
                                                        "[CodeTraitement], " +
                                                        "[TableFichierIn], " +
                                                        "[TableFichierOut], " +
                                                        "[LigneIntruction], " +
                                                        "[TypeTraitement], " +
                                                        "[FormatFichier], " +
                                                        "[NomColonneEntrée], " +
                                                        "[NomColonneSortie], " +
                                                        "[ConnectCheminEntrée], " +
                                                        "[ConnectCheminSortie], " +
                                                        "[LigneIntruction], " +
                                                        "[CourrielA], " +
                                                        "[CourrielCC], " +
                                                        "[ObjetCourriel], " +
                                                        "[ContenuCourriel], " +
                                                        "ISNULL(JoindreFichier, 0) [JoindreFichier], " +
                                                        "ISNULL(TraiteLundi, 0) [TraiteLundi], " +
                                                        "ISNULL(TraiteMardi, 0) [TraiteMardi], " +
                                                        "ISNULL(TraiteMercredi, 0) [TraiteMercredi], " +
                                                        "ISNULL(TraiteJeudi, 0) [TraiteJeudi], " +
                                                        "ISNULL(TraiteVendredi, 0) [TraiteVendredi], " +
                                                        "ISNULL(TraiteSamedi, 0) [TraiteSamedi], " +
                                                        "ISNULL(TraiteDimanche, 0) [TraiteDimanche], " +
                                                        "ISNULL(TraiteSemaine, 0) [TraiteSemaine], " +
                                                        "ISNULL(TraiteLaJournée, 0) [TraiteLaJournée], " +
                                                        "[TraiteHeureDeLaJournée], " +
                                                        "ISNULL(StatutActif, 0) [StatutActif], " +
                                                        "ISNULL(LoadSort, 0) [LoadSort], " +
                                                        "format(DtDerniereExecution, 'yyyy-MM-dd HH:mm:ss') [DtDerniereExecution] " +
                                                "FROM   [SDDMU01].[dbo].[Planificateur] " +
                                                "WHERE StatutActif = 1 " +
                                                "AND   ((datepart(dw,GETDATE()) = 1 " +
                                                "AND   TraiteLundi = 1) " +
                                                "OR    (datepart(dw,GETDATE()) = 2 " +
                                                "AND   TraiteMardi = 1) " +
                                                "OR    (datepart(dw,GETDATE()) = 3 " +
                                                "AND   TraiteMercredi = 1) " +
                                                "OR    (datepart(dw,GETDATE()) = 4 " +
                                                "AND   TraiteJeudi = 1) " +
                                                "OR    (datepart(dw,GETDATE()) = 5 " +
                                                "AND   TraiteVendredi = 1) " +
                                                "OR    (datepart(dw,GETDATE()) = 6 " +
                                                "AND   TraiteSamedi = 1) " +
                                                "OR    (datepart(dw,GETDATE()) = 7 " +
                                                "AND   TraiteDimanche = 1) " +
                                                "OR    (TraiteSemaine = 1) " +
                                                "OR    ([TraiteLaJournée] = day(GETDATE())))  " +
                                                "ORDER BY LoadSort ";


            public const string uptPlanificateur = "update [SDDMU01].[dbo].[Planificateur] set DtDerniereExecution = GETDATE() where CodeTraitement = '";
            public const string delLogJobChargement = "DELETE [SDDMU01].[dbo].[Log_Job_Planificateur] WHERE IndSystem = 'Planificateur'";

            public const string tblAfficheErreur = "SELECT [IndSystem], " +
                                                          "[CodeTraitement], " +
                                                          "[TypeTraitement], " +
                                                          "[ErrorMessage] " +
                                                     "FROM [SDDMU01].[dbo].[Log_Job_Planificateur] " +
                                                     "WHERE IndSystem = 'Planificateur'";

            public string newLine = Environment.NewLine;
            public string oUserCode = "auto01";
            public string userlogin = Environment.UserName.ToString();
            public string UserName = "Tâche Automatisée";
            public string SchemasUser;
            public string oStartJob = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            public string oSql;
            public string Sql2;
            public string SqlTrace;
            public string xChemin;
