    <DTS:Executable
      DTS:refId="Package\Gérer les périodes de paie pour historisation"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tâche d'exécution de requêtes SQL"
      DTS:DTSID="{10F4C8F1-4B58-4A58-AE6E-43B4D636E4C5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Gérer les périodes de paie pour historisation"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DDD0DD1B-E4C0-461C-87A0-EAE1A4EF71EF}"
          SQLTask:SqlStatementSource="BEGIN TRANSACTION;&#xA;declare @v_annee as integer;&#xA;declare @v_periode as integer;&#xA;declare @v_periode_max as integer;&#xA;declare @v_annee_fin_cour as varchar(9);&#xA;declare @v_annee_fin_prec as varchar(9);&#xA;&#xA;select @v_annee = an_financiere_asd, @v_periode = periode from sdsap1.TCONTRL;&#xA;set @v_annee_fin_cour = cast(@v_annee as varchar(4)) + '-' + cast(@v_annee + 1 as varchar(4));&#xA;&#xA;if (@v_periode &lt;= 3)&#xA;begin&#xA;   --deux années peuvent se chevaucher&#xA;   --déterminer année courante et précédente&#xA;   if (@v_annee = year(getdate()))&#xA;   begin&#xA;      set @v_annee_fin_prec = cast(@v_annee-1 as varchar(4)) + '-' + cast(@v_annee as varchar(4));&#xA;&#x9;  select @v_periode_max = max(PERIODE_PAYE) from sdsap1.TPERIODE_PAYE where AN_FINANCIERE_ASD = @v_annee-1;&#xA;   end&#xA;   else&#xA;   begin&#xA;      set @v_annee_fin_prec =@v_annee_fin_cour;&#xA;      set @v_annee_fin_cour = cast(@v_annee + 1 as varchar(4)) + '-' + cast(@v_annee + 2 as varchar(4));&#xA;&#x9;  select @v_periode_max = max(PERIODE_PAYE) from sdsap1.TPERIODE_PAYE where AN_FINANCIERE_ASD = @v_annee;&#xA;   end&#xA;   if (isnull(@v_periode_max,-1) &lt;&gt; -1)&#xA;   begin&#xA;      --année financière précédente&#xA;      insert into sdsap1.TPERIODE_PAYE (ANNEE_FINANCIERE, PERIODE_PAYE, AN_FINANCIERE_ASD, PERIODE) values (@v_annee_fin_prec , @v_periode_max + 1, @v_annee, @v_periode);&#xA;   end&#xA;   --année financière courante&#xA;   insert into sdsap1.TPERIODE_PAYE (ANNEE_FINANCIERE, PERIODE_PAYE, AN_FINANCIERE_ASD, PERIODE) values (@v_annee_fin_cour , @v_periode, @v_annee, @v_periode);&#xA;end&#xA;else&#xA;   begin&#xA;   --année financière courante seulement&#xA;   insert into sdsap1.TPERIODE_PAYE (ANNEE_FINANCIERE, PERIODE_PAYE, AN_FINANCIERE_ASD, PERIODE) values (@v_annee_fin_cour , @v_periode, @v_annee, @v_periode);&#xA;end&#xA;COMMIT;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
