            //////////////////////////////////////////////////////////////////////
            ///
            //     Insert dans la table tbaNctT03O04VielEnCours
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertIntotbaNctT03O04VielEnCours()
            {
                string sqlSqlCmd = "SELECT tbaDatSRCCumul.IdEnqueteur, 'Pénale' AS Nature, tbaDatSRCCumul.Service, Date()-[DateReception] AS DelaisJours, tbaDatSRCCumul.NoGPP, tbaDatSRCCumul.NoPL, tbaDatSRCCumul.Bureau, tbaDatSRCCumul.RespDossier, tbaDatSRCCumul.Source, tbaDatSRCCumul.DateReception, tbaDatSRCCumul.DateCorrectionTech, tbaDatSRCCumul.DateDemCompl, tbaDatSRCCumul.DateRecepCompl, tbaDatSRCCumul.DateFinale, tbaDatSRCCumul.DateEnvBIA, tbaDatSRCCumul.Defendeur, tbaDatSRCCumul.Enqueteur, tbaDatSRCCumul.Commentaire, DateDiff('d', DateReception, Date()) as NbJour " +
                                   "FROM tbaDatSRCCumul WHERE(((tbaDatSRCCumul.DateReception)Is Not Null) AND((tbaDatSRCCumul.DateEnvBIA)Is Null) AND((tbaDatSRCCumul.DateAnnulationComple)Is Null))";
                string sqlUpdCmd = "INSERT INTO tbaNctT03O04VielEnCours ( IdEnqueteur, Nature, Service, NoGPP, NoPL, Bureau, RespDossier, Source, DateReception, DateCorrectionTech, DateDemCompl, DateRecepCompl, DateFinale, DateEnvBIA, Defendeur, Enqueteur, SuiviENQ, DelaisJours, IdPoursuite ) " +
                                                             "Values(%1%, '%2%', '%3%', '%4%', '%5%', '%6%', '%7%', '%8%', CDate(IIf(IsDate('%9%'), '%9%', '')), CDate(IIf(IsDate('%10%'), '%10%', '')) , CDate(IIf(IsDate('%11%'), '%11%', '')) , CDate(IIf(IsDate('%12%'), '%12%', '')), CDate(IIf(IsDate('%13%'), '%13%', '')), CDate(IIf(IsDate('%14%'), '%14%', '')), '%15%', '%16%', '%17%', %18%, %19% )";
                string sqlCmdUpdt = "";
                int StatutPoursuite;
                int seque = 1;

                if (strConnectBdAccess != "")
                {
                    // Connecter à la BD In
                    connectionIn = new OleDbConnection(strConnectBdAccess.ToString());
                    connectionIn.Open();
                }

                try
                {
                    OleDbCommand SQLCommandExec = new OleDbCommand(sqlSqlCmd.ToString(), connectionIn);
                    SQLCommandExec.CommandType = CommandType.Text;
                    SQLCommandExec.CommandTimeout = 12000;


                    using (OleDbDataReader readerExec = SQLCommandExec.ExecuteReader())
                    {
                        // Lire les occurrences de la table Correspondance
                        while (readerExec.Read())
                        {
                            if (readerExec["DateCorrectionTech"].ToString() == "")
                            {
                                StatutPoursuite = 1;
                            }
                            else if (readerExec["DateDemCompl"].ToString() == "")
                            {
                                if (readerExec["DateFinale"].ToString() == "")
                                {
                                    StatutPoursuite = 2;
                                }
                                else
                                {
                                    StatutPoursuite = 4;
                                }
                            }
                            else if (readerExec["DateRecepCompl"].ToString() == "")
                            {
                                StatutPoursuite = 3;
                            }
                            else if (readerExec["DateFinale"].ToString() == "")
                            {
                                StatutPoursuite = 2;
                            }
                            else
                            {
                                StatutPoursuite = 4;
                            }

                            sqlCmdUpdt = sqlUpdCmd.Replace("%1%", readerExec["IdEnqueteur"].ToString().Replace("'", "''"))
                                                  .Replace("%2%", readerExec["Nature"].ToString().Replace("'", "''"))
                                                  .Replace("%3%", readerExec["Service"].ToString().Replace("'", "''"))
                                                  .Replace("%4%", readerExec["NoGPP"].ToString().Replace("'", "''"))
                                                  .Replace("%5%", readerExec["NoPL"].ToString().Replace("'", "''"))
                                                  .Replace("%6%", readerExec["Bureau"].ToString().Replace("'", "''"))
                                                  .Replace("%7%", readerExec["RespDossier"].ToString().Replace("'", "''"))
                                                  .Replace("%8%", readerExec["Source"].ToString().Replace("'", "''"))
                                                  .Replace("%9%", readerExec["DateReception"].ToString().Replace("'", "''"))
                                                  .Replace("%10%", readerExec["DateCorrectionTech"].ToString().Replace("'", "''"))
                                                  .Replace("%11%", readerExec["DateDemCompl"].ToString().Replace("'", "''"))
                                                  .Replace("%12%", readerExec["DateRecepCompl"].ToString().Replace("'", "''"))
                                                  .Replace("%13%", readerExec["DateFinale"].ToString().Replace("'", "''"))
                                                  .Replace("%14%", readerExec["DateEnvBIA"].ToString().Replace("'", "''"))
                                                  .Replace("%15%", readerExec["Defendeur"].ToString().Replace("'", "''"))
                                                  .Replace("%16%", readerExec["Enqueteur"].ToString().Replace("'", "''"))
                                                  .Replace("%17%", readerExec["Commentaire"].ToString().Replace("'", "''").Replace("\r\n", "").Trim())
                                                  .Replace("%18%", readerExec["NbJour"].ToString())
                                                  .Replace("%19%", StatutPoursuite.ToString());

                            sqlCmdUpdt = sqlCmdUpdt.Replace("CDate(IIf(IsDate(''), '', ''))", "NULL").Replace("(,", "(NULL, ");

                            OleDbCommand CmdUpdt = new OleDbCommand(sqlCmdUpdt.ToString(), connectionIn);
                            CmdUpdt.CommandType = CommandType.Text;
                            OleDbDataReader readerCmdUpdt = CmdUpdt.ExecuteReader();
                            readerCmdUpdt.Read();
                            readerCmdUpdt.Close();
                            seque++;
                        }
                        readerExec.Close();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobPlanificateur("InsertIntotbaNctT03O04VielEnCours()", ex.Message.ToString());
                    InsertTableLogJobPlanificateur("InsertIntotbaNctT03O04VielEnCours()", sqlCmdUpdt.ToString());
                    LoadTableErreur = true;
                }

                connectionIn.Close();
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     update la table tbaNctT03O04VielEnCours
            ///
            /////////////////////////////////////////////////////////////////////
            void qryCalT03O04VielEnCoursUpdate1()
            {
                string sqlSqlCmd = "SELECT Id, Service, IdPoursuite, IIf(IsNull(DelaisJours), -1, DelaisJours) as DelaisJour, IIf(IsNull(Score), -1, Score) as Scores FROM tbaNctT03O04VielEnCours";
                string sqlUpdCmd = "UPDATE tbaNctT03O04VielEnCours SET tbaNctT03O04VielEnCours.IdSeg7Groups = %1, " +
                                                                      "tbaNctT03O04VielEnCours.IdSeg3Groups = %2, " +
                                                                       "tbaNctT03O04VielEnCours.IdScore = %3 " +
                                    "WHERE id = %4";
                string sqlCmdUpdt = "";
                string id = "";

                if (strConnectBdAccess != "")
                {
                    // Connecter à la BD In
                    connectionIn = new OleDbConnection(strConnectBdAccess.ToString());
                    connectionIn.Open();
                }

                try
                {
                    OleDbCommand SQLCommandExec = new OleDbCommand(sqlSqlCmd.ToString(), connectionIn);
                    SQLCommandExec.CommandType = CommandType.Text;
                    SQLCommandExec.CommandTimeout = 12000;

                    using (OleDbDataReader readerExec = SQLCommandExec.ExecuteReader())
                    {
                        // Lire les occurrences de la table Correspondance
                        while (readerExec.Read())
                        {
                            id = readerExec["Id"].ToString();

                            sqlCmdUpdt = sqlUpdCmd.Replace("%1", ClassSegDelais(1, readerExec["Service"].ToString().Replace("'", "''"), Convert.ToInt64(readerExec["IdPoursuite"].ToString()), Convert.ToInt64(readerExec["DelaisJour"].ToString())))
                                                  .Replace("%2", ClassSegDelais(2, readerExec["Service"].ToString().Replace("'", "''"), Convert.ToInt64(readerExec["IdPoursuite"].ToString()), Convert.ToInt64(readerExec["DelaisJour"].ToString())))
                                                  .Replace("%3", ClassSegScore(readerExec["Service"].ToString().Replace("'", "''"), Convert.ToDouble(readerExec["Scores"].ToString())))
                                                  .Replace("%4", readerExec["Id"].ToString());

                            OleDbCommand CmdUpdt = new OleDbCommand(sqlCmdUpdt.ToString(), connectionIn);
                            CmdUpdt.CommandType = CommandType.Text;
                            OleDbDataReader readerCmdUpdt = CmdUpdt.ExecuteReader();
                            readerCmdUpdt.Read();
                            readerCmdUpdt.Close();
                        }
                        readerExec.Close();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobPlanificateur("qryCalT03O04VielEnCoursUpdate1( id = " + id + ")", ex.Message.ToString());
                    LoadTableErreur = true;
                }

                connectionIn.Close();
            }


            //////////////////////////////////////////////////////////////////////
            ///
            //     Retourne le seg delais
            ///
            /////////////////////////////////////////////////////////////////////
            string ClassSegDelais(int intSegmentClass, string strService, long lngIdPoursuite, long lngNbJours)
            {
                string sqlSqlCmdMax = "SELECT Max(IdSeg) AS MaxIdSeg, Max(RefMin) AS MaxRefMin FROM tbaPrmSegmentation WHERE ClassSeg = %1";
                string sqlSqlCmd = "SELECT IdSeg, RefMin, RefMax FROM tbaPrmSegmentation WHERE ClassSeg = %1 ORDER BY IdSeg";
                long lngClassSeg = 0;
                string retClassSegDelais = "";

                // Validate si la valeur est positive
                if (lngNbJours < 0)
                {
                    retClassSegDelais = "NULL";
                }
                else
                {
                    if (intSegmentClass == 1)
                    {
                        if ((strService == "SA") || (lngIdPoursuite != 0))
                        {
                            lngClassSeg = 2;
                        }
                        else if ((strService == "EP") || (strService == "EA"))
                        {
                            lngClassSeg = 1;
                        }
                        else
                        {
                            lngClassSeg = 4;
                        }
                    }
                    else if (intSegmentClass == 2)
                    {
                        if ((strService == "SA") || (lngIdPoursuite != 0))
                        {
                            lngClassSeg = 2;
                        }

                        else
                        {
                            lngClassSeg = 3;
                        }
                    }

                    sqlSqlCmdMax = sqlSqlCmdMax.Replace("%1", lngClassSeg.ToString());
                    OleDbCommand SQLCommandExec = new OleDbCommand(sqlSqlCmdMax.ToString(), connectionIn);
                    SQLCommandExec.CommandType = CommandType.Text;
                    SQLCommandExec.CommandTimeout = 12000;
                    OleDbDataReader readerExec3 = SQLCommandExec.ExecuteReader();

                    // Lire l'occurrence de la table Correspondance
                    while (readerExec3.Read())
                    {
                        if (lngNbJours >= Convert.ToInt64(readerExec3["MaxRefMin"].ToString()))
                        {
                            retClassSegDelais = readerExec3["MaxIdSeg"].ToString();
                            break;
                        }
                    }

                    readerExec3.Close();

                    if (retClassSegDelais.ToString() == "")
                    {
                        sqlSqlCmd = sqlSqlCmd.Replace("%1", lngClassSeg.ToString());
                        OleDbCommand SQLCommandExec2 = new OleDbCommand(sqlSqlCmd.ToString(), connectionIn);
                        SQLCommandExec2.CommandType = CommandType.Text;
                        SQLCommandExec2.CommandTimeout = 12000;
                        OleDbDataReader readerExec2 = SQLCommandExec2.ExecuteReader();

                        // Lire les occurrences de la table Correspondance
                        while (readerExec2.Read())
                        {
                            if (lngNbJours >= Convert.ToInt64(readerExec2["RefMin"].ToString()) && lngNbJours <= Convert.ToInt64(readerExec2["RefMax"].ToString()))
                            {
                                retClassSegDelais = readerExec2["Idseg"].ToString();
                                break;
                            }
                        }

                        readerExec2.Close();
                    }
                }
                return retClassSegDelais;
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Retourne le seg delais
            ///
            /////////////////////////////////////////////////////////////////////
            string ClassSegScore(string strService, double lngScore)
            {
                string sqlSqlCmdMax = "SELECT Max(IdScore) AS MaxIdScore, Max(RefMin) AS MaxRefMin FROM tbaPrmScore";
                string sqlSqlCmd = "SELECT IdScore, RefMin, RefMax FROM tbaPrmScore ORDER BY IdScore";
                string retClassSegScore = "";

                // Validate si la valeur est positive
                if (lngScore < 0)
                {
                    retClassSegScore = "Null";
                }
                else
                {
                    OleDbCommand SQLCommandExec = new OleDbCommand(sqlSqlCmdMax.ToString(), connectionIn);
                    SQLCommandExec.CommandType = CommandType.Text;
                    SQLCommandExec.CommandTimeout = 12000;
                    OleDbDataReader readerExec3 = SQLCommandExec.ExecuteReader();

                    // Lire l'occurrence de la table Correspondance
                    while (readerExec3.Read())
                    {
                        if (Convert.ToInt64(lngScore) >= Convert.ToInt64(readerExec3["MaxRefMin"].ToString()))
                        {
                            retClassSegScore = readerExec3["MaxIdScore"].ToString();
                            break;
                        }
                    }

                    readerExec3.Close();

                    if (retClassSegScore == "")
                    {
                        OleDbCommand SQLCommandExec2 = new OleDbCommand(sqlSqlCmd.ToString(), connectionIn);
                        SQLCommandExec2.CommandType = CommandType.Text;
                        SQLCommandExec2.CommandTimeout = 12000;
                        OleDbDataReader readerExec2 = SQLCommandExec2.ExecuteReader();

                        // Lire les occurrences de la table Correspondance
                        while (readerExec2.Read())
                        {

                            if (Convert.ToInt64(lngScore) >= Convert.ToInt64(readerExec2["RefMin"].ToString()) && Convert.ToInt64(lngScore) <= Convert.ToInt64(readerExec2["RefMax"].ToString()))
                            {
                                retClassSegScore = readerExec2["IdScore"].ToString();
                                break;
                            }
                        }

                        readerExec2.Close();
                    }
                }

                return retClassSegScore;
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Envois le courriel s'il y a une ou des erreurs
            ///
            ///////////////////////////////////////////////////////////////////////
            void SendMailMessageError(string EnvoisCourrielPar)
            {
                int recCount = 0;
                String strAfficheErreur = "";
                String SQLString = tblAfficheErreur.ToString();
                String EnvoisCourrielA = "yves.mcduff-ext@rbq.gouv.qc.ca"; //  "centre.de.pilotage@rbq.gouv.qc.ca";
                String EnvoisCourrielSuject = "L'application (GestionPerformance) a une ou plusieurs erreurs d'ex�cutions ";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine +
                                             "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";


                // Lire les erreurs
                using (SqlDataAdapter dataAdapterAfficheErreur = new SqlDataAdapter(SQLString, mySQLConnection))
                {
                    // create the DataSet 
                    try
                    {
                        DataSet dataSetAfficheErreur = new DataSet();
                        dataAdapterAfficheErreur.SelectCommand.CommandTimeout = 180;
                        dataAdapterAfficheErreur.Fill(dataSetAfficheErreur, "AfficheErreur");
                        recCount = 0;

                        foreach (DataRow pRowRegleAfficheErreur in dataSetAfficheErreur.Tables["AfficheErreur"].Rows)
                        {

                            if (recCount < 16)
                            {
                                strAfficheErreur = strAfficheErreur.ToString() + newLine + pRowRegleAfficheErreur["IndSystem"].ToString() + " - " +
                                                                                           pRowRegleAfficheErreur["CodeTraitement"].ToString() + " - " +
                                                                                           pRowRegleAfficheErreur["TypeTraitement"].ToString() + " - " +
                                                                                           pRowRegleAfficheErreur["ErrorMessage"].ToString() + newLine;
                            }

                            recCount++;

                        }
                    }
                    catch (Exception ex)
                    {
                        ///
                        strMessageSql = "Fonction SendMailMessageError (dataSetAfficheErreur) Erreur SQL ";
                        InsertTableLogJobPlanificateur("MAIL", strMessageSql.ToString());
                        succesLoadTable = false;
                    }
                }

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + strAfficheErreur.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();

                String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message.ToString();
                    strMessageSql = "Fonction SendMailMessageError (SmtpClient) Erreur SQL ";
                    InsertTableLogJobPlanificateur("MAIL", strMessageSql.ToString());
                    succesLoadTable = false;
                }
                InsertTableLogPlanificateur("Mail", "Mail erreur envoyé");
            }

            Dts.TaskResult = (int)ScriptResults.Success;
        }

        private bool defined()
        {
            throw new NotImplementedException();
        }
        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = DTSExecResult.Success,
            Failure = DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
