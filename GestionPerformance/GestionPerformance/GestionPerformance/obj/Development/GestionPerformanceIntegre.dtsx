         *  string filePath = (string)rawConnection;
         *  //Use the connection in some code here, then release the connection
         *  Dts.Connections["Prices.zip"].ReleaseConnection(rawConnection);
         * */
        #endregion


        public const string uptPlanificateur = "update [SDDMU01].[dbo].[Planificateur] set DtDerniereExecution = GETDATE() where CodeTraitement = '";
        public const string delLogJobChargement = "DELETE [SDDMU01].[dbo].[Log_Job_Planificateur]";

        public const string tblAfficheErreur = "SELECT [IndSystem], " +
                                                      "[CodeTraitement], " +
                                                      "[TypeTraitement], " +
                                                      "[ErrorMessage] " +
                                                 "FROM [SDDMU01].[dbo].[Log_Job_Planificateur] " +
                                                 "WHERE [IndSystem] = 'GestionPerformance'";

        public string newLine = Environment.NewLine;
        public string oUserCode = "auto01";
        public string userlogin = Environment.UserName.ToString();
        public string UserName = "Tâche Automatisée";
        public string SchemasUser;

        public string strConnectBdAccess;
        public string strLigneIntruction;
        public string strIndSystem = "GestionPerformance";
        public string strTypeTraitement = "TraitEnLot";
        public string strCodeTraitement = "QryAccess";

        public OleDbConnection connectionIn;

        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        public void Main()
        {
            GestionPerformance();
            Dts.TaskResult = (int)ScriptResults.Success;
        }


        public void GestionPerformance()
        {
            bool succesLoadTable = true;
            bool LoadTableErreur = false;
            string strMessageSql = "";
            SchemasUser = "MTR.";

            string date = DateTime.Now.ToString("yyyy-MM-dd hh:mm:ss");
            DateTime dtJour = DateTime.Now;
            string EnvoyePar = Dts.Variables["User::EnvoyePar"].Value.ToString();
            string strConnectBdAccess = Dts.Variables["User::bdAccess"].Value.ToString();

            SqlConnection mySQLConnection =
                Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                as SqlConnection;

            SqlConnection mySQLConnectionPlanificateur =
                Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                as SqlConnection;

            // delete l'historique du dernier log de chargement
            DeleteTableLogJobChargement();
            InsertTableLogPlanificateur("GestionPerformance", "Début du traitement");

            // Début du traitement
            strCodeTraitement = "tbaSysBDParameter";
            InsertTableLogPlanificateur("GestionPerformance", strCodeTraitement);
            strLigneIntruction = "UPDATE tbaSysBDParameter SET tbaSysBDParameter.PrmValueNumber = 5, tbaSysBDParameter.PrmValueDate = Now(), tbaSysBDParameter.PrmValueText = 'Planificateur' WHERE (((tbaSysBDParameter.[CodePrm])='LastBDUpdateStatut'))";
            ExecuteSQL(strCodeTraitement.ToString(), strLigneIntruction.ToString());

            InsertTableLogPlanificateur("GestionPerformance", "Début du traitement");
            //Delete<SRC_Cumul> table content
            strCodeTraitement = "tbaDatSRCCumul";
            strLigneIntruction = "DELETE tbaDatSRCCumul.* FROM tbaDatSRCCumul";
            if (LoadTableErreur == false && succesLoadTable == true)
            {
                InsertTableLogPlanificateur("GestionPerformance", strCodeTraitement);
                ExecuteSQL(strCodeTraitement.ToString(), strLigneIntruction.ToString());
            }

            // Update Cumul
            strCodeTraitement = "qryUdsCumul";
            if (LoadTableErreur == false && succesLoadTable == true)
            {
                InsertTableLogPlanificateur("GestionPerformance", strCodeTraitement);
                ExecuteQryAccess(strCodeTraitement.ToString(), "qryUdsCumul");
            }

            // Delete <SRC_SRPE> table content 
            strCodeTraitement = "qryUdsSRC_SRPE";
            if (LoadTableErreur == false && succesLoadTable == true)
            {
                InsertTableLogPlanificateur("GestionPerformance", strCodeTraitement);
                ExecuteQryAccess(strCodeTraitement.ToString(), "qryUdsSRC_SRPE");
            }

            // Build the table <tbaDatSRCSRPE>
            strCodeTraitement = "qryUdsSRPE";
            if (LoadTableErreur == false && succesLoadTable == true)
            {
                InsertTableLogPlanificateur("GestionPerformance", strCodeTraitement);
                ExecuteQryAccess(strCodeTraitement.ToString(), "qryUdsSRPE");
            }

            // Update <Admin_Penal> field in <tbaDatSRCSRPE> table with <ltbAcuBGPPlaintes>
            strCodeTraitement = "qryUdsPlaintes_Update";
            if (LoadTableErreur == false && succesLoadTable == true)
            {
                InsertTableLogPlanificateur("GestionPerformance", strCodeTraitement);
                ExecuteQryAccess(strCodeTraitement.ToString(), "qryUdsPlaintes_Update");
            }

            // Update <Admin_Penal> field in <tbaDatSRCSRPE> table with <ltbTopTopo>
            strCodeTraitement = "qryUdsTopo_Update";
            if (LoadTableErreur == false && succesLoadTable == true)
            {
                InsertTableLogPlanificateur("GestionPerformance", strCodeTraitement);
                ExecuteQryAccess(strCodeTraitement.ToString(), "qryUdsTopo_Update");
            }

            // Delete <SRC_SRPE> table content
            strCodeTraitement = "qryUdsSRC_ComplementEA";
            if (LoadTableErreur == false && succesLoadTable == true)
            {
                InsertTableLogPlanificateur("GestionPerformance", strCodeTraitement);
                ExecuteQryAccess(strCodeTraitement.ToString(), "qryUdsSRC_ComplementEA");
            }

            // Delete table content
            strCodeTraitement = "qryUdsPrmResChefDelete";
            if (LoadTableErreur == false && succesLoadTable == true)
            {
                InsertTableLogPlanificateur("GestionPerformance", strCodeTraitement);
                ExecuteQryAccess(strCodeTraitement.ToString(), "qryUdsPrmResChefDelete");
            }

            // Delete table content
            strCodeTraitement = "qryUdsPrmResRessourceDelete";
            if (LoadTableErreur == false && succesLoadTable == true)
            {
                InsertTableLogPlanificateur("GestionPerformance", strCodeTraitement);
                ExecuteQryAccess(strCodeTraitement.ToString(), "qryUdsPrmResRessourceDelete");
            }

            // Copier le "Chef équipe" de la table liée <ltbAcuEnqueteur> vers la table paramètre <tbaPrmChef>
            strCodeTraitement = "qryUdsPrmResChef";
            if (LoadTableErreur == false && succesLoadTable == true)
            {
                InsertTableLogPlanificateur("GestionPerformance", strCodeTraitement);
                ExecuteQryAccess(strCodeTraitement.ToString(), "qryUdsPrmResChef");
            }

