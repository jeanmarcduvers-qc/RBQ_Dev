            {
                string sqlInsCmd = strSqlRequete.ToString();

                if (strConnectBdAccess != "")
                {
                    // Connecter à la BD In
                    connectionIn = new OleDbConnection(strConnectBdAccess.ToString());
                    connectionIn.Open();
                }

                try
                {
                    OleDbCommand SQLCommandExec = new OleDbCommand(sqlInsCmd.ToString(), connectionIn);
                    SQLCommandExec.CommandType = CommandType.Text;
                    SQLCommandExec.CommandTimeout = 12000;
                    OleDbDataReader readerExec = SQLCommandExec.ExecuteReader();
                    readerExec.Read();
                    readerExec.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobPlanificateur("ExecuteSQL(" + strCodeTraitement + ")", ex.Message.ToString());
                    LoadTableErreur = true;
                }

                connectionIn.Close();
            }

