            /////////////////////////////////////////////////////////////////////
            void UpdateIdRessource(int intSequence)
            {
                string sqlInsCmd = "SELECT * FROM tbaPrmResRessource";
                string sqlUpdCmd = "UPDATE tbaPrmResRessource set IdRessource = %1 WHERE id = %2";
                string sqlCmdUpdt = "";

                if (strConnectBdAccess != "")
                {
                    // Connecter à la BD In
                    connectionIn = new OleDbConnection(strConnectBdAccess.ToString());
                    connectionIn.Open();
                }

                try
                {
                    OleDbCommand SQLCommandExec = new OleDbCommand(sqlInsCmd.ToString(), connectionIn);
                    SQLCommandExec.CommandType = CommandType.Text;
                    SQLCommandExec.CommandTimeout = 12000;

                    using (OleDbDataReader readerExec = SQLCommandExec.ExecuteReader())
                    {
                        // Lire les occurrences de la table Correspondance
                        while (readerExec.Read())
                        {
                            sqlCmdUpdt = sqlUpdCmd.Replace("%1", intSequence.ToString()).Replace("%2", readerExec["ID"].ToString());

                            OleDbCommand CmdUpdt = new OleDbCommand(sqlCmdUpdt.ToString(), connectionIn);
                            CmdUpdt.CommandType = CommandType.Text;
                            OleDbDataReader readerCmdUpdt = CmdUpdt.ExecuteReader();
                            readerCmdUpdt.Read();
                            readerCmdUpdt.Close();
                            intSequence++;
                        }
                        readerExec.Close();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobPlanificateur("UpdateIdRessource()", ex.Message.ToString());
                    LoadTableErreur = true;
                }

                connectionIn.Close();
            }

