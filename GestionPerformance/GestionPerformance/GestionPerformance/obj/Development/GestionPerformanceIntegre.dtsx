            //////////////////////////////////////////////////////////////////////
            ///
            //     Valide si résultat soumis exist
            ///
            /////////////////////////////////////////////////////////////////////
            void ValideSoumis()
            {
                string sqlCmd = "SELECT count(*) as nbRecord FROM tbaTmpResultat WHERE Type='ENQ' AND Resultat='Soumis'";
                string sqlUpdCmd = "UPDATE tbaTmpResultat SET Id = 100 WHERE Resultat = 'Soumis'";
                string sqlInsCmd = "INSERT INTO [tbaTmpResultat] ([Id], [Type], [Resultat])VALUES (100, 'ENQ', 'Soumis')";

                if (strConnectBdAccess != "")
                {
                    // Connecter à la BD In
                    connectionIn = new OleDbConnection(strConnectBdAccess.ToString());
                    connectionIn.Open();
                }

                try
                {
                    OleDbCommand SQLCommandExec = new OleDbCommand(sqlCmd.ToString(), connectionIn);
                    SQLCommandExec.CommandType = CommandType.Text;
                    SQLCommandExec.CommandTimeout = 12000;

                    using (OleDbDataReader readerExec = SQLCommandExec.ExecuteReader())
                    {
                        // Lire les occurrences de la table Correspondance
                        while (readerExec.Read())
                        {
                            if (readerExec["nbRecord"].ToString() == "0")
                            {
                                sqlCmd = sqlInsCmd;
                            }
                            else
                            {
                                sqlCmd = sqlUpdCmd;
                            }

                            OleDbCommand CmdUpdt = new OleDbCommand(sqlCmd.ToString(), connectionIn);
                            CmdUpdt.CommandType = CommandType.Text;
                            OleDbDataReader readerCmdUpdt = CmdUpdt.ExecuteReader();
                            readerCmdUpdt.Read();
                            readerCmdUpdt.Close();
                        }
                        readerExec.Close();
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobPlanificateur("ValideSoumis()", ex.Message.ToString());
                    LoadTableErreur = true;
                }

                connectionIn.Close();
            }

