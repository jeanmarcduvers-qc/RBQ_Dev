        public const string updtACSUN_TbStatutGIC = "UPDATE ACSUN_TbStatutGIC_MAJ SET date_StatutGIC_MAJ = Now()";

        public const string updtTOPO_TbStatutGIC = "UPDATE TOPO_TbStatutGIC_MAJ SET date_StatutGIC_MAJ = Now()";

        public const string tblStatutGIC_DroitExerciceTOPO = "SELECT Left([GI3_C_LICN],9) AS NoGIC, [GI3_S_DROT_EXER] FROM [SDGIC01].[dbo].[GI3_DROIT_EXERCICE] inner join [SDDMU01].[SDDMUVPE].[VPE_TOPO_Verification] on DossierGICN =  Left([GI3_C_LICN],9) and STATUT <> 'Terminé'";

        public const string tblStatutGIC_DroitExerciceACSUM = "SELECT Left([GI3_C_LICN],9) AS NoGIC, [GI3_S_DROT_EXER] FROM [SDGIC01].[dbo].[GI3_DROIT_EXERCICE] inner join [SDDMU01].[dbo].[BGP_Plaintes] on DossierGIC =  Left([GI3_C_LICN],9) and STATUT <> 'Terminé'";

        public const string updtACSUN_StatutGIC_DroitExercice = "UPDATE BGP_tbPlaintes " +
                                                                "SET STATUT_GIC = '%2' " +
                                                                "WHERE DossierGIC = '%1' " +
                                                                "AND STATUT<> 'Terminé' ";
        public const string updtTOPO_StatutGIC_DroitExercice  = "UPDATE tbVerification " +
                                                                "SET STATUT_GIC = '%2' " +
                                                                "WHERE DossierGICN = '%1' " +
                                                                "AND STATUT<> 'Terminé'";

        public const string delLogJobChargement = "DELETE [SDDMU01].[dbo].[Log_Job_Planificateur] " +
                                                  "WHERE [IndSystem] = 'GIC_Statut_DroitExercice'";

        public const string tblAfficheErreur = "SELECT [IndSystem], " +
                                                      "[CodeTraitement], " +
                                                      "[TypeTraitement], " +
                                                      "[ErrorMessage] " +
                                                 "FROM [SDDMU01].[dbo].[Log_Job_Planificateur] " +
                                                 "WHERE [IndSystem] = 'GIC_Statut_DroitExercice'";

        public string newLine = Environment.NewLine;
        public string oUserCode = "auto01";
        public string userlogin = Environment.UserName.ToString();
        public string UserName = "Tâche Automatisée";
        public string SchemasUser;

        public string strConnectBdAccess;
        public string strLigneIntruction;
        public string strIndSystem = "GIC_Statut_DroitExercice";
        public string strTypeTraitement = "TraitEnLot";
        public string strCodeTraitement = "QryAccess";

        public OleDbConnection connectionIn;

        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        public void Main()
        {
            GIC_Statut_DroitExercice();
            Dts.TaskResult = (int)ScriptResults.Success;
        }


        public void GIC_Statut_DroitExercice()
        {
            bool succesLoadTable = true;
            bool LoadTableErreur = false;
            string strMessageSql = "";
            SchemasUser = "MTR.";

            string date = DateTime.Now.ToString("yyyy-MM-dd hh:mm:ss");
            DateTime dtJour = DateTime.Now;
            string EnvoyePar = Dts.Variables["User::EnvoyePar"].Value.ToString();
            string strConnectBdAccess = Dts.Variables["User::bdAccess"].Value.ToString();

            SqlConnection mySQLConnection =
                Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                as SqlConnection;

            SqlConnection mySQLConnectionPlanificateur =
                Dts.Connections["ConnectBD_SQL"].AcquireConnection(Dts.Transaction)
                as SqlConnection;

            // delete l'historique du dernier log de chargement
            DeleteTableLogJobChargement();
            InsertTableLogPlanificateur("GIC_Statut_DroitExercice", "Début du traitement");

            // Update Statut GIC
            strCodeTraitement = "updtStatutGIC";
            updtStatutGIC();

            // Fin du traitement
            strCodeTraitement = "updtACSUN_TbStatutGIC";
            strLigneIntruction = updtACSUN_TbStatutGIC.ToString();
            if (LoadTableErreur == false && succesLoadTable == true)
            { ExecuteSQL(strCodeTraitement.ToString(), strLigneIntruction.ToString()); }

            strCodeTraitement = "updtTOPO_TbStatutGIC";
            strLigneIntruction = updtTOPO_TbStatutGIC.ToString();
            if (LoadTableErreur == false && succesLoadTable == true)
            { ExecuteSQL(strCodeTraitement.ToString(), strLigneIntruction.ToString()); }


            if (succesLoadTable == false)
            {
                LoadTableErreur = true;
            }


            if (LoadTableErreur == true)
            {
                // Envois un courriel si erreur de programmation (SQL ou autre)
                SendMailMessageError(EnvoyePar);
            }

            InsertTableLogPlanificateur("GIC_Statut_DroitExercice", "Fin du traitement");
            mySQLConnection.Close();

            //////////////////////////////////////////////////////////////////////
            ///
            //     Traite Statut GIC
            ///
            /////////////////////////////////////////////////////////////////////
            void updtStatutGIC()
            {
                string sqlCmd = "";
                string sqlUpdACSUM = updtACSUN_StatutGIC_DroitExercice.ToString();
                string sqlUpdTOPO = updtTOPO_StatutGIC_DroitExercice.ToString();
                string sqlCmdUpdt = "";
                string Etape = "SQL";

                if (strConnectBdAccess != "")
                {
                    // Connecter à la BD In
                    connectionIn = new OleDbConnection(strConnectBdAccess.ToString());
                    connectionIn.Open();
                }

                // Acsum
                try
                {
                    Etape = "SQL_ACSUM";
                    sqlCmd = tblStatutGIC_DroitExerciceACSUM.ToString();

                    using (SqlDataAdapter dataAdapterACSUM = new SqlDataAdapter(sqlCmd.ToString(), mySQLConnection))
                    {
                        DataSet dataSetACSUM = new DataSet();
                        dataAdapterACSUM.SelectCommand.CommandTimeout = 12000;
                        dataAdapterACSUM.Fill(dataSetACSUM, "ACSUM");

                        foreach (DataRow pRowACSUM in dataSetACSUM.Tables["ACSUM"].Rows)
                        {
                            Etape = "ACSUM";
                            sqlCmdUpdt = sqlUpdACSUM.Replace("%1", pRowACSUM["NoGIC"].ToString()).Replace("%2", pRowACSUM["GI3_S_DROT_EXER"].ToString());

                            OleDbCommand CmdUpdtACSUM = new OleDbCommand(sqlCmdUpdt.ToString(), connectionIn);
                            CmdUpdtACSUM.CommandType = CommandType.Text;
                            CmdUpdtACSUM.ExecuteNonQuery();

                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobPlanificateur("updtStatutGIC(" + Etape.ToString() + ")", ex.Message.ToString());
                    LoadTableErreur = true;
                }

                // Topo
                try
                {
                    Etape = "SQL_TOPO";
                    sqlCmd = tblStatutGIC_DroitExerciceTOPO.ToString();
                    using (SqlDataAdapter dataAdapterTOPO = new SqlDataAdapter(sqlCmd.ToString(), mySQLConnection))
                    {
                        DataSet dataSetTOPO = new DataSet();
                        dataAdapterTOPO.SelectCommand.CommandTimeout = 12000;
                        dataAdapterTOPO.Fill(dataSetTOPO, "TOPO");

                        foreach (DataRow pRowACSUM in dataSetTOPO.Tables["TOPO"].Rows)
                        {
                            Etape = "TOPO";
                            sqlCmdUpdt = sqlUpdTOPO.Replace("%1", pRowACSUM["NoGIC"].ToString()).Replace("%2", pRowACSUM["GI3_S_DROT_EXER"].ToString());

                            OleDbCommand CmdUpdtTOPO = new OleDbCommand(sqlCmdUpdt.ToString(), connectionIn);
                            CmdUpdtTOPO.CommandType = CommandType.Text;
                            CmdUpdtTOPO.ExecuteNonQuery();
                        }
                    }
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobPlanificateur("updtStatutGIC(" + Etape.ToString() + ")", ex.Message.ToString());
                    LoadTableErreur = true;
                }

                connectionIn.Close();
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Planificateur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogPlanificateur(string strIndSystem, string strCodeTraitement)
            {
                string sqlInsCmd = "insert into[SDDMU01].[dbo].[Log_Planificateur] values('" + strIndSystem + "', '" + strCodeTraitement + "', GETDATE(), 'Auto01', 'Tâche Automatisée')";

                try
                {
                    SqlCommand SQLCommandLog = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandLog.CommandType = CommandType.Text;

                    SqlDataReader readerLog = SQLCommandLog.ExecuteReader();
                    readerLog.Read();
                    readerLog.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobPlanificateur("InsertTableLogPlanificateur()", ex.Message.ToString());
                }
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     insert les informations dant la table Log_Job_Planificateur
            ///
            /////////////////////////////////////////////////////////////////////
            void InsertTableLogJobPlanificateur(string pfonction, string pErreurMessage)
            {
                int lParametreErreurMessage;
                pErreurMessage = pfonction + " - " + pErreurMessage;
                pErreurMessage = pErreurMessage.Replace("'", "''");
                lParametreErreurMessage = pErreurMessage.Length;

                if (pErreurMessage.Length > 250)
                {
                    pErreurMessage = pErreurMessage.Substring(0, 245);
                    pErreurMessage = pErreurMessage + "...";
                }

                string sqlInsCmd = "insert into[SDDMU01].[dbo].[Log_Job_Planificateur] values('" + strIndSystem + "', '" + strCodeTraitement + "', '" + strTypeTraitement + "', '" + pErreurMessage + "', 'Auto01', GETDATE())";

                try
                {
                    SqlCommand SQLCommandJobErr = new SqlCommand(sqlInsCmd.ToString(), mySQLConnection);
                    SQLCommandJobErr.CommandType = CommandType.Text;
                    SqlDataReader readerErreur = SQLCommandJobErr.ExecuteReader();
                    readerErreur.Read();
                    readerErreur.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogPlanificateur("ERR", "Impossible d'insérer dans Log_Job_Planificateur");
                }
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     détruit les informations dant la table Log_Job_Planificateur
            ///
            ///////////////////////////////////////////////////////////////////////
            void DeleteTableLogJobChargement()
            {
                string sqlDelCmdCharg = delLogJobChargement.ToString();

                try
                {
                    SqlCommand DelCmdCharg = new SqlCommand(sqlDelCmdCharg.ToString(), mySQLConnection);
                    DelCmdCharg.CommandType = CommandType.Text;
                    SqlDataReader readerCharg = DelCmdCharg.ExecuteReader();
                    readerCharg.Read();
                    readerCharg.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogPlanificateur("ERR", "DeleteTableLogJobChargement()");
                }
            }


            //////////////////////////////////////////////////////////////////////
            ///
            //     Exécute une instruction SQL
            ///
            /////////////////////////////////////////////////////////////////////
            void ExecuteSQL(string strCodeTraitement, string strSqlRequete)
            {
                string sqlInsCmd = strSqlRequete.ToString();

                if (strConnectBdAccess != "")
                {
                    // Connecter à la BD In
                    connectionIn = new OleDbConnection(strConnectBdAccess.ToString());
                    connectionIn.Open();
                }

                try
                {
                    OleDbCommand SQLCommandExec = new OleDbCommand(sqlInsCmd.ToString(), connectionIn);
                    SQLCommandExec.CommandType = CommandType.Text;
                    SQLCommandExec.CommandTimeout = 12000;
                    OleDbDataReader readerExec = SQLCommandExec.ExecuteReader();
                    readerExec.Read();
                    readerExec.Close();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobPlanificateur("ExecuteSQL(" + strCodeTraitement + ")", ex.Message.ToString());
                    LoadTableErreur = true;
                }

                connectionIn.Close();
            }

            //////////////////////////////////////////////////////////////////////
            ///
            //     Traite un requête Access
            ///
            /////////////////////////////////////////////////////////////////////
            void ExecuteQryAccess(string strCodeTraitement, string strSqlRequete)
            {
                string sqlInsCmd = strSqlRequete.ToString();

                if (strConnectBdAccess != "")
                {
                    // Connecter à la BD In
                    connectionIn = new OleDbConnection(strConnectBdAccess.ToString());
                    connectionIn.Open();
                }

                try
                {
                    OleDbCommand SQLCommandExec = new OleDbCommand(sqlInsCmd.ToString(), connectionIn);
                    SQLCommandExec.CommandType = CommandType.StoredProcedure;
                    SQLCommandExec.CommandTimeout = 12000;
                    SQLCommandExec.ExecuteNonQuery();
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message);
                    InsertTableLogJobPlanificateur("ExecuteQryAccess(" + strCodeTraitement + ")", ex.Message.ToString());
                    LoadTableErreur = true;
                }

                connectionIn.Close();
            }

            ////////////////////////////////////////////////////////////////////////
            ///
            //     Envois le courriel s'il y a une ou des erreurs
            ///
            ///////////////////////////////////////////////////////////////////////
            void SendMailMessageError(string EnvoisCourrielPar)
            {
                int recCount = 0;
                String strAfficheErreur = "";
                String SQLString = tblAfficheErreur.ToString();
                String EnvoisCourrielA = "yves.mcduff-ext@rbq.gouv.qc.ca"; //  "centre.de.pilotage@rbq.gouv.qc.ca";
                String EnvoisCourrielSuject = "L'application (GIC_Statut_DroitExercice) a une ou plusieurs erreurs d'exécutions ";
                String EnvoisCourrielCorps = "Bonjour," + newLine + newLine +
                                             EnvoisCourrielSuject + newLine + newLine +
                                             "Merci d'appliquer les correctifs si c'est le cas." + newLine + newLine;
                String EnvoisCourrielPiedCorps = "..." + newLine +
                                                 "Pour toutes questions, veuillez communiquer avec la _Boite Centre de pilotage RBQ centre.de.pilotage@rbq.gouv.qc.ca." + newLine + newLine +
                                                 "Direction des technologies de l'information" + newLine +
                                                 "Régie du bâtiment du Québec";


                // Lire les erreurs
                using (SqlDataAdapter dataAdapterAfficheErreur = new SqlDataAdapter(SQLString, mySQLConnection))
                {
                    // create the DataSet 
                    try
                    {
                        DataSet dataSetAfficheErreur = new DataSet();
                        dataAdapterAfficheErreur.SelectCommand.CommandTimeout = 180;
                        dataAdapterAfficheErreur.Fill(dataSetAfficheErreur, "AfficheErreur");
                        recCount = 0;

                        foreach (DataRow pRowRegleAfficheErreur in dataSetAfficheErreur.Tables["AfficheErreur"].Rows)
                        {

                            if (recCount < 16)
                            {
                                strAfficheErreur = strAfficheErreur.ToString() + newLine + pRowRegleAfficheErreur["IndSystem"].ToString() + " - " +
                                                                                           pRowRegleAfficheErreur["CodeTraitement"].ToString() + " - " +
                                                                                           pRowRegleAfficheErreur["TypeTraitement"].ToString() + " - " +
                                                                                           pRowRegleAfficheErreur["ErrorMessage"].ToString() + newLine;
                            }

                            recCount++;

                        }
                    }
                    catch (Exception ex)
                    {
                        ///
                        strMessageSql = "Fonction SendMailMessageError (dataSetAfficheErreur) Erreur SQL ";
                        InsertTableLogJobPlanificateur("MAIL", strMessageSql.ToString());
                        succesLoadTable = false;
                    }
                }

                EnvoisCourrielCorps = EnvoisCourrielCorps.ToString() + strAfficheErreur.ToString() + newLine + EnvoisCourrielPiedCorps.ToString();

                String SmtpServer = Dts.Variables["User::SmtpServer"].Value.ToString();

                try
                {
                    // Création du courriel et changement du format en HTML
                    MailMessage FormatCourrielHtml = new MailMessage(EnvoisCourrielPar, EnvoisCourrielA, EnvoisCourrielSuject, EnvoisCourrielCorps);

                    // Créer le SMTP client et envois le courriel
                    SmtpClient monSmtpClient = new SmtpClient(SmtpServer);
                    monSmtpClient.Credentials = System.Net.CredentialCache.DefaultNetworkCredentials;
                    monSmtpClient.Send(FormatCourrielHtml);
                }
                catch (Exception ex)
                {
                    //MessageBox.Show(ex.Message.ToString();
                    strMessageSql = "Fonction SendMailMessageError (SmtpClient) Erreur SQL ";
                    InsertTableLogJobPlanificateur("MAIL", strMessageSql.ToString());
                    succesLoadTable = false;
                }
                InsertTableLogPlanificateur("Mail", "Mail erreur envoyé");
            }

        }

        private bool defined()
        {
            throw new NotImplementedException();
        }
        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = DTSExecResult.Success,
            Failure = DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
